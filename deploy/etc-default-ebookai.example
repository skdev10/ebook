# Copy to /etc/default/ebookai on the server (chmod 600).
# Loaded by deploy/start-nohup.sh and deploy/ebookai.service

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5000

# Required — Python upstream X-API-Key
ExternalApi__ApiKey=PASTE_YOUR_KEY_HERE

# MySQL on this VM (fixed password Root@1234)
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=ebookpublications;User=root;Password=Root@1234;SslMode=None;AllowPublicKeyRetrieval=True;

# Optional: force Unix socket on Linux (auto-detected if file exists)
# Database__UnixSocket=/var/run/mysqld/mysqld.sock

# Allow login over plain HTTP during testing
Authentication__CookieSecurePolicy=SameAsRequest
