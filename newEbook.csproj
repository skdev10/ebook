<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>a1b2c3d4-e5f6-4789-a012-3456789abcde</UserSecretsId>
    <TargetFramework>net8.0</TargetFramework>
    <RazorLangVersion>8.0</RazorLangVersion>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <NoWarn>$(NoWarn);NU1603;NU1605;CS8618;CS8604;CS8601;CS8600;CS8602;CS8603;CS8605;CS8629;CS8619;CS0168;CS1998;CS0472;CS0169;CS0649</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EBookDashboard</RootNamespace>
    <AssemblyName>EBookDashboard</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Features" Version="5.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.0" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.47.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.8" />
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.4" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenAI" Version="2.3.0" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.0" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="PuppeteerSharp" Version="20.2.4" />
    <PackageReference Include="Rotativa.AspNetCore" Version="1.4.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="Stripe.net" Version="49.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.1" />
    <PackageReference Include="UglyToad.PdfPig" Version="0.1.8-alpha001-patch1" />
  </ItemGroup>

  <!--
    Exclude accidental nested full-project copies from compilation.
    - newEbook/: duplicate tree caused CS8802 (two entry points).
    - EbookAI/: same codebase cloned/copied under ./EbookAI/ on Linux deploys (/root/latest/EbookAI/EbookAI/...) causes CS0111 duplicate members.
  -->
  <ItemGroup>
    <Compile Remove="newEbook\**\*.cs" />
    <Compile Remove="EbookAI\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="publish\**\*" />
    <Compile Remove="publish/**" />
    <Content Remove="EbookAI\**\*.cshtml" />
    <Content Remove="publish\**\*" />
    <Content Remove="publish/**" />
    <!-- Scoped CSS must pair with a view in the same tree; nested duplicate folders often keep *.css without *.cshtml → BLAZOR102. -->
    <Content Remove="newEbook\**\*.cshtml.css" />
    <Content Remove="EbookAI\**\*.cshtml.css" />
    <None Remove="publish\**\*" />
    <None Remove="publish/**" />
    <None Remove="newEbook\**\*.cshtml.css" />
    <None Remove="EbookAI\**\*.cshtml.css" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Certificates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Ensure Razor views exist on disk for Production (no runtime compilation); fixes view lookup under dotnet exec/publish. -->
    <Content Update="Views\**\*.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- If appsettings.Local.json exists on the build machine (gitignored), include it in publish for VM deploy. -->
    <None Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties appsettings_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>

</Project>
