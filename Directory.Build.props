<Project>
  <!--
    Build intermediate/output under the user profile so MSBuild can always create/write folders.
    Fixes UnauthorizedAccessException on Desktop copies where obj/bin inherited restrictive ACLs (Users: RX only).
    When BaseIntermediateOutputPath moves, SDK default globs no longer exclude ./obj and ./bin next to the
    project — stale generated *.cs there would compile twice (CS0579). Exclude them explicitly.
  -->
  <PropertyGroup>
    <!-- Main web app keeps the EBookDashboard folder; every other project gets its own to avoid GenerateDepsFile duplicate-key crashes. -->
    <_EBookOutName Condition="'$(MSBuildProjectName)' == 'newEbook' or '$(MSBuildProjectName)' == 'EBookDashboard'">EBookDashboard</_EBookOutName>
    <_EBookOutName Condition="'$(_EBookOutName)' == '' and '$(MSBuildProjectName)' == 'Tests'">EBookDashboard.Tests</_EBookOutName>
    <_EBookOutName Condition="'$(_EBookOutName)' == ''">$(MSBuildProjectName)</_EBookOutName>
    <BaseIntermediateOutputPath>$(USERPROFILE)\.msbuild-out\$(_EBookOutName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(USERPROFILE)\.msbuild-out\$(_EBookOutName)\bin\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
