@{
    ViewData["Title"] = "Audit Logs";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --white: #FFFFFF;
        --light-gray: #F5F5F5;
        --cream-bg: #FAF8F3;
        --cream-accent: #E8DCC6;
        --text-primary: #2C2C2C;
        --text-secondary: #6B6B6B;
        --border-light: #E5E5E5;
        --primary: #8B7355;
        --success: #10b981;
        --danger: #ef4444;
    }

    .audit-container {
        padding: 0;
    }

    .page-header {
        background: var(--white);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        border: 1px solid var(--border-light);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .filters-section {
        background: var(--white);
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        border: 1px solid var(--border-light);
    }

    .filters-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid var(--border-light);
        border-radius: 10px;
        font-size: 14px;
    }

    .table-container {
        background: var(--white);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        border: 1px solid var(--border-light);
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid var(--border-light);
    }

    th {
        font-weight: 600;
        color: var(--text-primary);
        background: var(--light-gray);
        font-size: 12px;
        text-transform: uppercase;
    }

    td {
        font-size: 14px;
        color: var(--text-primary);
    }

    .action-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
    }

    .action-create {
        background: rgba(16, 185, 129, 0.1);
        color: var(--success);
    }

    .action-update {
        background: rgba(139, 115, 85, 0.1);
        color: var(--primary);
    }

    .action-delete {
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
    }

    .btn {
        padding: 8px 16px;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-primary {
        background: var(--primary);
        color: white;
    }

    .btn-primary:hover {
        background: var(--primary-dark);
    }
</style>

<div class="audit-container">
    <div class="page-header">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">Audit Logs</h1>
            <p style="color: var(--text-secondary);">View system-wide logs of all user and admin actions</p>
        </div>
        <button class="btn btn-primary" onclick="exportLogs()">
            <i class="fas fa-download"></i> Export Logs
        </button>
    </div>

    <div class="filters-section">
        <div class="filters-row">
            <div>
                <label style="display: block; font-size: 12px; font-weight: 500; color: var(--text-secondary); margin-bottom: 6px;">Filter by User</label>
                <input type="text" class="form-control" id="auditUserFilter" placeholder="Search user..." />
            </div>
            <div>
                <label style="display: block; font-size: 12px; font-weight: 500; color: var(--text-secondary); margin-bottom: 6px;">Filter by Module</label>
                <select class="form-control" id="auditEntityFilter">
                    <option value="">All Modules</option>
                    <option value="User">Users</option>
                    <option value="Book">Books</option>
                    <option value="Plan">Plans</option>
                    <option value="Settings">Settings</option>
                    <option value="Notification">Notifications</option>
                    <option value="Cms">CMS</option>
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 12px; font-weight: 500; color: var(--text-secondary); margin-bottom: 6px;">Filter by Action</label>
                <select class="form-control" id="auditActionFilter">
                    <option value="">All Actions</option>
                    <option value="Create">Create</option>
                    <option value="Update">Update</option>
                    <option value="Delete">Delete</option>
                    <option value="Suspend">Suspend</option>
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 12px; font-weight: 500; color: var(--text-secondary); margin-bottom: 6px;">Date Range</label>
                <input type="date" class="form-control" id="auditDateFilter" />
            </div>
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>User</th>
                    <th>Module</th>
                    <th>Action</th>
                    <th>Details</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody id="auditLogsBody">
                <tr><td colspan="6" style="padding:24px;text-align:center;color:#9B9B9B;">Loading logs…</td></tr>
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function exportLogs() {
        window.location.href = '@Url.Action("ExportAuditLogs", "Admin")?format=csv';
    }

    function loadAuditLogs() {
        const action = document.getElementById('auditActionFilter')?.value || '';
        const entity = document.getElementById('auditEntityFilter')?.value || '';
        const qs = new URLSearchParams({ actionFilter: action, entityTypeFilter: entity });
        fetch('@Url.Action("GetAuditLogs", "Admin")?' + qs.toString(), { credentials: 'same-origin' })
            .then(r => r.json())
            .then(data => {
                const body = document.getElementById('auditLogsBody');
                if (!body) return;
                const logs = data.logs || [];
                const userQ = (document.getElementById('auditUserFilter')?.value || '').toLowerCase();
                const filtered = userQ ? logs.filter(l => (l.userName || '').toLowerCase().includes(userQ)) : logs;
                if (!filtered.length) {
                    body.innerHTML = '<tr><td colspan="6" style="padding:24px;text-align:center;color:#9B9B9B;">No audit logs yet.</td></tr>';
                    return;
                }
                body.innerHTML = filtered.map(l => `
                    <tr>
                        <td>${l.createdAt || ''}</td>
                        <td>${l.userName || 'System'}</td>
                        <td>${l.entityType || ''}</td>
                        <td><span class="action-badge action-${(l.action || '').toLowerCase()}">${l.action || ''}</span></td>
                        <td>${l.description || ''}</td>
                        <td>${l.ipAddress || ''}</td>
                    </tr>`).join('');
            }).catch(() => {
                const body = document.getElementById('auditLogsBody');
                if (body) body.innerHTML = '<tr><td colspan="6" style="padding:24px;text-align:center;">Failed to load logs.</td></tr>';
            });
    }
    document.getElementById('auditActionFilter')?.addEventListener('change', loadAuditLogs);
    document.getElementById('auditEntityFilter')?.addEventListener('change', loadAuditLogs);
    document.getElementById('auditUserFilter')?.addEventListener('input', loadAuditLogs);
    loadAuditLogs();
</script>

