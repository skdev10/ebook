@{
    ViewData["Title"] = "Product Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/admin-animations.js"></script>

<style>
    :root {
        --white: #FFFFFF;
        --light-gray: #F5F5F5;
        --warm-gray: #E8E8E8;
        --soft-beige: #F5F1EB;
        --cream-bg: #FAF8F3;
        --cream-accent: #E8DCC6;
        --gold-accent: #D4AF37;
        --bronze-accent: #CD7F32;
        --text-primary: #2C2C2C;
        --text-secondary: #6B6B6B;
        --text-muted: #9B9B9B;
        --border-light: #E5E5E5;
        --shadow-soft: rgba(0, 0, 0, 0.05);
        --primary: #8B7355;
        --primary-light: #A68B6B;
        --primary-dark: #6B5A47;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
    }

    .product-container {
        padding: 0;
    }

    .page-header {
        background: var(--white);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px var(--shadow-soft);
        border: 1px solid var(--border-light);
        position: relative;
    }

    .page-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, var(--primary) 0%, var(--gold-accent) 100%);
    }

    .page-header h1 {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 4px;
        padding-left: 16px;
    }

    .page-header p {
        color: var(--text-secondary);
        padding-left: 16px;
        font-size: 14px;
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 24px;
        margin-bottom: 24px;
    }

    .product-card {
        background: var(--white);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 8px var(--shadow-soft);
        border: 1px solid var(--border-light);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .product-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: var(--primary);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 4px 12px var(--shadow-soft);
    }

    .product-card:hover::before {
        opacity: 1;
    }

    .product-card.profitable {
        border-left: 4px solid var(--success);
    }

    .product-card.profitable::before {
        background: var(--success);
        opacity: 1;
    }

    .product-card.loss {
        border-left: 4px solid var(--danger);
    }

    .product-card.loss::before {
        background: var(--danger);
        opacity: 1;
    }

    .product-card.warning {
        border-left: 4px solid var(--warning);
    }

    .product-card.warning::before {
        background: var(--warning);
        opacity: 1;
    }

    .product-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }

    .product-title {
        font-size: 20px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .product-subtitle {
        font-size: 14px;
        color: var(--text-secondary);
    }

    .product-status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-profitable {
        background: rgba(16, 185, 129, 0.1);
        color: var(--success);
    }

    .status-loss {
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
    }

    .status-warning {
        background: rgba(245, 158, 11, 0.1);
        color: var(--warning);
    }

    .product-metrics {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }

    .metric-item {
        text-align: center;
        padding: 16px;
        background: var(--cream-bg);
        border-radius: 12px;
    }

    .metric-value {
        font-size: 24px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 4px;
    }

    .metric-label {
        font-size: 12px;
        color: var(--text-secondary);
    }

    .product-chart {
        height: 200px;
        margin-bottom: 20px;
    }

    .product-insights {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid var(--border-light);
    }

    .insight-item {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .insight-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .insight-icon.success {
        background: rgba(16, 185, 129, 0.1);
        color: var(--success);
    }

    .insight-icon.danger {
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
    }

    .insight-icon.warning {
        background: rgba(245, 158, 11, 0.1);
        color: var(--warning);
    }

    .insight-icon.info {
        background: rgba(59, 130, 246, 0.1);
        color: var(--info);
    }

    .insight-text {
        flex: 1;
        color: var(--text-primary);
    }

    .strategy-section {
        background: var(--white);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px var(--shadow-soft);
        border: 1px solid var(--border-light);
    }

    .strategy-section h3 {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--cream-accent);
    }

    .strategy-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
    }

    .strategy-card {
        padding: 20px;
        background: var(--cream-bg);
        border-radius: 12px;
        border-left: 4px solid var(--primary);
    }

    .strategy-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 12px;
    }

    .strategy-description {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 16px;
    }

    .strategy-action {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: var(--primary);
        color: white;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .strategy-action:hover {
        background: var(--primary-dark);
        transform: translateY(-2px);
    }

    .investment-recommendation {
        background: linear-gradient(135deg, rgba(139, 115, 85, 0.1) 0%, rgba(212, 175, 55, 0.1) 100%);
        border: 2px solid var(--primary);
        border-radius: 12px;
        padding: 20px;
        margin-top: 20px;
    }

    .recommendation-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .recommendation-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .recommendation-list li {
        padding: 8px 0;
        color: var(--text-secondary);
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .recommendation-list li::before {
        content: '→';
        color: var(--primary);
        font-weight: bold;
    }
</style>

