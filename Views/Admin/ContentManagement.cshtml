                console.error('switchView function not properly defined');
            }
            if (typeof window.showNotifications !== 'function') {
                console.error('showNotifications function not properly defined');
            }
            if (typeof window.showSearch !== 'function') {
                console.error('showSearch function not properly defined');
            }
            if (typeof window.toggleTheme !== 'function') {
