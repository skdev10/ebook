@model List<EBookDashboard.Models.AdminUserPlanRow>
@{
    ViewData["Title"] = "User plans";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var rows = Model ?? new List<EBookDashboard.Models.AdminUserPlanRow>();
}

<div class="page-header" style="background:#fff;border-radius:16px;padding:24px;margin-bottom:24px;border:1px solid #E5E5E5;">
    <h1 style="margin:0;font-size:24px;">User plans (Subscriptions screen)</h1>
    <p style="margin:8px 0 0;color:#6B6B6B;">Same AuthorPlans records the user panel shows under Subscriptions / Billing.</p>
</div>

<div style="background:#fff;border-radius:16px;border:1px solid #E5E5E5;overflow:hidden;">
    <div style="padding:16px 20px;display:flex;gap:12px;flex-wrap:wrap;">
        <input type="text" id="planSearch" placeholder="Search name or email…" style="flex:1;min-width:220px;padding:10px 14px;border:1px solid #E5E5E5;border-radius:10px;" />
        <select id="planStatusFilter" style="padding:10px 14px;border:1px solid #E5E5E5;border-radius:10px;">
            <option value="">All plan status</option>
            <option value="active">Active</option>
            <option value="expired">Expired</option>
            <option value="cancelled">Cancelled</option>
            <option value="none">None</option>
        </select>
    </div>
    <table style="width:100%;border-collapse:collapse;font-size:14px;">
        <thead>
            <tr style="background:#fafafa;text-align:left;color:#64748b;font-size:11px;text-transform:uppercase;">
                <th style="padding:12px 18px;">User</th>
                <th style="padding:12px;">Email</th>
                <th style="padding:12px;">Plan</th>
                <th style="padding:12px;">Status</th>
                <th style="padding:12px;">Dates</th>
                <th style="padding:12px;"></th>
            </tr>
        </thead>
        <tbody>
        @if (!rows.Any())
        {
            <tr><td colspan="6" style="padding:40px;text-align:center;color:#94a3b8;">No users.</td></tr>
        }
        else
        {
            foreach (var r in rows)
            {
                <tr class="plan-row" data-status="@r.PlanStatus.ToLowerInvariant()">
                    <td style="padding:14px 18px;font-weight:600;">@r.FullName</td>
                    <td style="padding:14px;color:#64748b;">@r.UserEmail</td>
                    <td style="padding:14px;">@r.PlanName @(r.PlanRate > 0 ? $"({r.PlanRate:N2})" : "")</td>
                    <td style="padding:14px;">@r.PlanStatus</td>
                    <td style="padding:14px;color:#64748b;white-space:nowrap;">
                        @(r.StartDate?.ToString("yyyy-MM-dd") ?? "—")
                        @(r.EndDate.HasValue ? " → " + r.EndDate.Value.ToString("yyyy-MM-dd") : "")
                    </td>
                    <td style="padding:14px;">
                        <a href="@Url.Action("UserDetail", "Admin", new { id = r.UserId })" style="color:#6d28d9;font-weight:600;">Workspace</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

<script>
    function filterPlans() {
        var q = (document.getElementById('planSearch').value || '').toLowerCase();
        var st = (document.getElementById('planStatusFilter').value || '').toLowerCase();
        document.querySelectorAll('.plan-row').forEach(function (row) {
            var hay = (row.getAttribute('data-search') || '') + ' ' + row.textContent.toLowerCase();
            var okQ = !q || hay.indexOf(q) !== -1;
            var okS = !st || (row.getAttribute('data-status') || '') === st;
            row.style.display = (okQ && okS) ? '' : 'none';
        });
    }
    document.getElementById('planSearch')?.addEventListener('input', filterPlans);
    document.getElementById('planStatusFilter')?.addEventListener('change', filterPlans);
</script>
