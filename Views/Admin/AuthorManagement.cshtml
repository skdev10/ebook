@model IEnumerable<EBookDashboard.Models.Authors>

@{
    ViewData["Title"] = "Author Management - Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="author-management">
    <!-- Header Section -->
    <div class="page-header" data-aos="fade-down">
        <div class="header-content">
            <h1><i class="fas fa-users"></i> Author Management</h1>
            <p>Manage all authors and their accounts</p>
        </div>
        
        <div class="header-actions">
            <button class="btn btn-primary" onclick="addNewAuthor()" data-aos="fade-left" data-aos-delay="200">
                <i class="fas fa-plus"></i>
                Add New Author
            </button>
        </div>
    </div>

    <!-- Filter and Search Section -->
    <div class="filter-section" data-aos="fade-up" data-aos-delay="100">
        <div class="search-bar">
            <div class="input-wrapper">
                <i class="fas fa-search"></i>
                <input type="text" id="searchAuthors" placeholder="Search authors by name, email, or specialization..." class="form-control">
            </div>
        </div>
        
        <div class="filter-options">
            <select class="form-control" id="statusFilter">
                <option value="">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
            
            <select class="form-control" id="specializationFilter">
                <option value="">All Specializations</option>
                <option value="Fiction">Fiction</option>
                <option value="Non-Fiction">Non-Fiction</option>
                <option value="Romance">Romance</option>
                <option value="Thriller">Thriller</option>
                <option value="Biography">Biography</option>
            </select>
        </div>
    </div>

    <!-- Authors Table -->
    <div class="authors-table-container" data-aos="fade-up" data-aos-delay="200">
        <table class="authors-table">
            <thead>
                <tr>
                    <th>Author</th>
                    <th>Email</th>
                    <th>Specialization</th>
                    <th>Books</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var author in Model)
                {
                    <tr>
                        <td>
                            <div class="author-info">
                                <div class="author-avatar">@(string.IsNullOrWhiteSpace(author.FullName) ? "?" : author.FullName.Trim()[0].ToString())</div>
                                <span>@author.FullName</span>
                            </div>
                        </td>
                        <td>@author.AuthorEmail</td>
                        <td><span class="specialization-badge">@author.Specialization</span></td>
                        <td>@(author.Books?.Count ?? 0)</td>
                        <td><span class="status-badge @(author.IsActive ? "active" : "inactive")">@(author.IsActive ? "Active" : "Inactive")</span></td>
                        <td>@author.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <button class="btn-action" onclick="viewAuthor(@author.AuthorId)" title="View Details"><i class="fas fa-eye"></i></button>
                            <button class="btn-action" onclick="editAuthor(@author.AuthorId)" title="Edit"><i class="fas fa-edit"></i></button>
                            <button class="btn-action delete" onclick="deleteAuthor(@author.AuthorId)" title="Delete"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state" data-aos="fade-up">
            <i class="fas fa-users"></i>
            <h3>No Authors Found</h3>
            <p>There are no authors in the system yet.</p>
            <button class="btn btn-primary" onclick="addNewAuthor()">
                <i class="fas fa-plus"></i>
                Add First Author
            </button>
        </div>
    }
</div>

<!-- Add/Edit Author Modal -->
<div class="modal fade" id="authorModal" tabindex="-1" aria-labelledby="authorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="authorModalLabel">Add New Author</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="authorForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="authorName" class="form-label">Full Name</label>
                                <input type="text" class="form-control" id="authorName" placeholder="Enter author's full name">
                            </div>
                            
                            <div class="mb-3">
                                <label for="authorEmail" class="form-label">Email</label>
                                <input type="email" class="form-control" id="authorEmail" placeholder="Enter author's email">
                            </div>
                            
                            <div class="mb-3">
                                <label for="authorSpecialization" class="form-label">Specialization</label>
                                <select class="form-control" id="authorSpecialization">
                                    <option value="">Select Specialization</option>
                                    <option value="Fiction">Fiction</option>
                                    <option value="Non-Fiction">Non-Fiction</option>
                                    <option value="Romance">Romance</option>
                                    <option value="Thriller">Thriller</option>
                                    <option value="Biography">Biography</option>
                                    <option value="Sci-Fi">Sci-Fi</option>
                                    <option value="Fantasy">Fantasy</option>
                                </select>
                            </div>
                            
                            <div class="mb-3">
                                <label for="authorCountry" class="form-label">Country</label>
                                <input type="text" class="form-control" id="authorCountry" placeholder="Enter author's country">
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="authorCode" class="form-label">Author Code</label>
                                <input type="text" class="form-control" id="authorCode" placeholder="Enter unique author code">
                            </div>
                            
                            <div class="mb-3">
                                <label for="authorPhone" class="form-label">Phone</label>
                                <input type="text" class="form-control" id="authorPhone" placeholder="Enter author's phone number">
                            </div>
                            
                            <div class="mb-3">
                                <label for="authorAddress" class="form-label">Address</label>
                                <textarea class="form-control" id="authorAddress" rows="3" placeholder="Enter author's address"></textarea>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">Status</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="authorStatus" checked>
                                    <label class="form-check-label" for="authorStatus">Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveAuthor()">Save Author</button>
            </div>
        </div>
    </div>
</div>

<style>
    .author-management {
        padding: 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding: 20px;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.85));
        backdrop-filter: blur(20px);
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    :root {
        --white: #FFFFFF;
        --light-gray: #F5F5F5;
        --warm-gray: #E8E8E8;
        --text-primary: #2C2C2C;
        --text-secondary: #6B6B6B;
        --text-muted: #9B9B9B;
        --border-light: #E5E5E5;
        --shadow-soft: rgba(0, 0, 0, 0.05);
        --primary: #7c3aed;
        --primary-light: #a78bfa;
        --primary-dark: #6d28d9;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
    }

    .header-content h1 {
        margin: 0;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 2rem;
        font-weight: 700;
    }

    .header-content p {
        margin: 5px 0 0;
        color: #666;
        font-size: 1rem;
    }

    .filter-section {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
        flex-wrap: wrap;
        align-items: center;
    }

    .search-bar {
        flex: 1;
        min-width: 300px;
    }

    .input-wrapper {
        position: relative;
    }

    .input-wrapper i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--primary);
        z-index: 2;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px 12px 45px;
        border: 2px solid rgba(0, 0, 0, 0.1);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.9);
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
    }

    .filter-options {
        display: flex;
        gap: 15px;
    }

    .filter-options .form-control {
        padding: 12px 15px;
        min-width: 150px;
    }

    .authors-table-container {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .authors-table {
        width: 100%;
        border-collapse: collapse;
    }

    .authors-table th {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
        color: white;
        padding: 20px;
        text-align: left;
        font-weight: 600;
    }

    .authors-table td {
        padding: 20px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .author-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .author-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
    }

    .specialization-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 500;
        background: rgba(102, 126, 234, 0.1);
        color: var(--primary);
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .status-badge.active {
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
    }

    .status-badge.inactive {
        background: rgba(108, 117, 125, 0.1);
        color: #6c757d;
    }

    .btn-action {
        padding: 8px;
        border: none;
        border-radius: 6px;
        margin: 0 2px;
        cursor: pointer;
        background: rgba(102, 126, 234, 0.1);
        color: var(--primary);
    }

    .btn-action.delete {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }

    .btn-action:hover {
        opacity: 0.8;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #666;
    }

    .empty-state i {
        font-size: 4rem;
        margin-bottom: 20px;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .empty-state h3 {
        margin-bottom: 10px;
        font-size: 1.5rem;
    }

    /* Modal Styles */
    .modal-content {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .modal-header {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
        color: white;
        border: none;
    }

    .modal-body {
        padding: 30px;
    }

    .modal-footer {
        padding: 20px;
        border: none;
    }

    /* Responsive Design */
    @@media (max-width: 1024px) {
        .authors-table-container {
            overflow-x: auto;
        }

        .authors-table {
            min-width: 800px;
        }
    }

    @@media (max-width: 768px) {
        .author-management {
            padding: 10px;
        }

        .page-header {
            flex-direction: column;
            gap: 15px;
            text-align: center;
            padding: 16px;
        }

        .header-content h1 {
            font-size: 1.5rem;
        }

        .filter-section {
            flex-direction: column;
            gap: 12px;
        }

        .search-bar {
            min-width: auto;
            width: 100%;
        }

        .filter-options {
            width: 100%;
            justify-content: stretch;
            flex-direction: column;
        }

        .filter-options .form-control {
            width: 100%;
        }

        .authors-table-container {
            overflow-x: auto;
        }

        .authors-table {
            min-width: 700px;
        }

        .authors-table th, .authors-table td {
            padding: 12px 8px;
            font-size: 0.85rem;
        }

        .author-info {
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }

        .author-avatar {
            width: 32px;
            height: 32px;
            font-size: 14px;
        }

        .btn-action {
            padding: 6px 10px;
            font-size: 12px;
        }

        .modal-dialog {
            margin: 10px;
            max-width: calc(100% - 20px);
        }

        .modal-content {
            padding: 16px;
        }

        .row {
            margin: 0;
        }

        .col-md-6 {
            width: 100%;
            padding: 0;
            margin-bottom: 16px;
        }
    }

    @@media (max-width: 480px) {
        .author-management {
            padding: 8px;
        }

        .page-header {
            padding: 12px;
        }

        .header-content h1 {
            font-size: 1.25rem;
        }

        .authors-table th, .authors-table td {
            padding: 10px 6px;
            font-size: 0.8rem;
        }

        .btn {
            padding: 8px 16px;
            font-size: 13px;
        }

        .modal-dialog {
            margin: 5px;
        }

        .modal-content {
            padding: 12px;
        }
    }
</style>

<script>
    // Search functionality
    document.getElementById('searchAuthors').addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase();
        filterAuthors();
    });

    // Status filter
    document.getElementById('statusFilter').addEventListener('change', function() {
        filterAuthors();
    });

    // Specialization filter
    document.getElementById('specializationFilter').addEventListener('change', function() {
        filterAuthors();
    });

    function filterAuthors() {
        const searchTerm = document.getElementById('searchAuthors').value.toLowerCase();
        const statusFilter = document.getElementById('statusFilter').value.toLowerCase();
        const specializationFilter = document.getElementById('specializationFilter').value.toLowerCase();
        const authorRows = document.querySelectorAll('.authors-table tbody tr');

        authorRows.forEach(row => {
            const name = row.querySelector('.author-info span').textContent.toLowerCase();
            const email = row.cells[1].textContent.toLowerCase();
            const specialization = row.cells[2].textContent.toLowerCase();
            const status = row.cells[4].textContent.toLowerCase();

            const matchesSearch = name.includes(searchTerm) || email.includes(searchTerm);
            const matchesStatus = !statusFilter || status.includes(statusFilter);
            const matchesSpecialization = !specializationFilter || specialization.includes(specializationFilter);

            if (matchesSearch && matchesStatus && matchesSpecialization) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // Modal functions
    function addNewAuthor() {
        window._editingAuthorId = 0;
        document.getElementById('authorModalLabel').textContent = 'Add New Author';
        document.getElementById('authorForm').reset();
        document.getElementById('authorStatus').checked = true;
        new bootstrap.Modal(document.getElementById('authorModal')).show();
    }

    function editAuthor(id) {
        window._editingAuthorId = id;
        document.getElementById('authorModalLabel').textContent = 'Edit Author';
        fetch('@Url.Action("GetAuthorDetails", "Admin")?authorId=' + encodeURIComponent(id), { credentials: 'same-origin' })
            .then(r => r.json())
            .then(data => {
                if (!data.success || !data.author) {
                    Swal.fire('Error', data.message || 'Author not found', 'error');
                    return;
                }
                const a = data.author;
                document.getElementById('authorName').value = a.fullName || '';
                document.getElementById('authorEmail').value = a.authorEmail || '';
                document.getElementById('authorSpecialization').value = a.specialization || '';
                document.getElementById('authorCountry').value = a.country || '';
                document.getElementById('authorCode').value = a.authorCode || '';
                document.getElementById('authorPhone').value = a.phone || '';
                document.getElementById('authorAddress').value = a.address || '';
                document.getElementById('authorStatus').checked = !!a.isActive;
                new bootstrap.Modal(document.getElementById('authorModal')).show();
            }).catch(() => Swal.fire('Error', 'Failed to load author', 'error'));
    }

    function viewAuthor(id) {
        fetch('@Url.Action("GetAuthorDetails", "Admin")?authorId=' + encodeURIComponent(id), { credentials: 'same-origin' })
            .then(r => r.json())
            .then(data => {
                if (!data.success || !data.author) {
                    Swal.fire('Error', data.message || 'Author not found', 'error');
                    return;
                }
                const a = data.author;
                Swal.fire({
                    title: a.fullName || 'Author',
                    html: `<div style="text-align:left;">
                        <p><strong>Email:</strong> ${a.authorEmail || '—'}</p>
                        <p><strong>Specialization:</strong> ${a.specialization || '—'}</p>
                        <p><strong>Country:</strong> ${a.country || '—'}</p>
                        <p><strong>Books:</strong> ${a.bookCount || 0}</p>
                        <p><strong>Status:</strong> ${a.isActive ? 'Active' : 'Inactive'}</p>
                    </div>`,
                    showCancelButton: !!a.workspaceUrl,
                    confirmButtonText: a.workspaceUrl ? 'Open user workspace' : 'Close',
                    cancelButtonText: 'Close',
                    confirmButtonColor: '#7c3aed'
                }).then(res => {
                    if (res.isConfirmed && a.workspaceUrl) window.location.href = a.workspaceUrl;
                });
            }).catch(() => Swal.fire('Error', 'Failed to load author', 'error'));
    }

    function saveAuthor() {
        const payload = {
            authorId: window._editingAuthorId || 0,
            fullName: document.getElementById('authorName').value,
            authorEmail: document.getElementById('authorEmail').value,
            specialization: document.getElementById('authorSpecialization').value,
            country: document.getElementById('authorCountry').value,
            phone: document.getElementById('authorPhone').value,
            address: document.getElementById('authorAddress').value,
            authorCode: document.getElementById('authorCode').value,
            isActive: document.getElementById('authorStatus').checked
        };
        fetch('@Url.Action("SaveAuthor", "Admin")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(payload)
        }).then(r => r.json()).then(data => {
            if (data.success) {
                Swal.fire('Saved', 'Author saved.', 'success').then(() => location.reload());
            } else {
                Swal.fire('Error', data.message || 'Save failed', 'error');
            }
        }).catch(() => Swal.fire('Error', 'Save failed', 'error'));
    }

    function deleteAuthor(id) {
        Swal.fire({
            title: 'Delete Author?',
            text: 'Authors with books cannot be deleted.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Yes, delete'
        }).then((result) => {
            if (!result.isConfirmed) return;
            fetch('@Url.Action("DeleteAuthor", "Admin")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'authorId=' + encodeURIComponent(id)
            }).then(r => r.json()).then(data => {
                if (data.success) location.reload();
                else Swal.fire('Error', data.message || 'Delete failed', 'error');
            });
        });
    }

    // Initialize AOS
    AOS.init({
        duration: 600,
        easing: 'ease-out',
        once: true
    });
</script>