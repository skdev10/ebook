@model IEnumerable<EBookDashboard.Models.Roles>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Roles Management";
    var roles = Model?.ToList() ?? new List<EBookDashboard.Models.Roles>();
    var totalUsers = roles.Sum(r => r.Users?.Count ?? 0);
}

<style>
    .roles-management-container { padding: 8px 4px 24px; }
    .roles-management-header {
        background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
        border-radius: 16px; padding: 28px; color: #fff; margin-bottom: 24px;
    }
    .roles-management-header h1 { margin: 0 0 6px; font-size: 24px; }
    .roles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
    .role-card { background: #fff; border: 1px solid #E5E5E5; border-radius: 14px; padding: 20px; }
    .role-card h3 { margin: 0 0 4px; font-size: 18px; }
    .role-description { color: #6B6B6B; font-size: 13px; min-height: 40px; }
    .permission-badge { display: inline-block; background: #f3e8ff; color: #6d28d9; border-radius: 999px; padding: 4px 10px; font-size: 11px; margin: 4px 4px 0 0; }
    .role-card-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; gap: 8px; }
    .permissions-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 12px; overflow: hidden; }
    .permissions-table th, .permissions-table td { padding: 10px 12px; border-bottom: 1px solid #eee; font-size: 13px; text-align: center; }
    .permissions-table th:first-child, .permissions-table td:first-child { text-align: left; }
    .permission-check { color: #10b981; }
    .permission-denied { color: #cbd5e1; }
</style>

<div class="roles-management-container">
    <div class="roles-management-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1><i class="fas fa-user-tag me-2"></i>Roles &amp; Permissions</h1>
            <p class="mb-0" style="opacity:.9;">Same <code>roles</code> table used when assigning users in User Management.</p>
        </div>
        <button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#roleModal" onclick="resetRoleForm()">
            <i class="fas fa-plus-circle me-2"></i>Create New Role
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="role-card"><div style="color:#64748b;font-size:12px;">Roles</div><div style="font-size:28px;font-weight:700;">@roles.Count</div></div>
        </div>
        <div class="col-md-4">
            <div class="role-card"><div style="color:#64748b;font-size:12px;">Users assigned</div><div style="font-size:28px;font-weight:700;">@totalUsers</div></div>
        </div>
        <div class="col-md-4">
            <div class="role-card"><div style="color:#64748b;font-size:12px;">Permission flags</div><div style="font-size:28px;font-weight:700;">6</div></div>
        </div>
    </div>

    <div class="roles-grid mb-4">
        @if (!roles.Any())
        {
            <p style="color:#94a3b8;">No roles in the database yet.</p>
        }
        @foreach (var role in roles)
        {
            var userCount = role.Users?.Count ?? 0;
            <div class="role-card"
                 data-role-id="@role.RoleId"
                 data-role-name="@role.RoleName"
                 data-description="@role.Description"
                 data-allow-downloads="@role.AllowDownloads.ToString().ToLowerInvariant()"
                 data-allow-dashboard="@role.AllowFullDashboard.ToString().ToLowerInvariant()"
                 data-allow-analytics="@role.AllowAnalytics.ToString().ToLowerInvariant()"
                 data-allow-publishing="@role.AllowPublishing.ToString().ToLowerInvariant()"
                 data-allow-edit="@role.AllowEdit.ToString().ToLowerInvariant()"
                 data-allow-delete="@role.AllowDelete.ToString().ToLowerInvariant()">
                <h3>@role.RoleName</h3>
                <p class="role-description">@(string.IsNullOrWhiteSpace(role.Description) ? "No description" : role.Description)</p>
                <div>
                    @if (role.AllowFullDashboard) { <span class="permission-badge">Dashboard</span> }
                    @if (role.AllowEdit) { <span class="permission-badge">Edit</span> }
                    @if (role.AllowPublishing) { <span class="permission-badge">Publish</span> }
                    @if (role.AllowDelete) { <span class="permission-badge">Delete</span> }
                    @if (role.AllowAnalytics) { <span class="permission-badge">Analytics</span> }
                    @if (role.AllowDownloads) { <span class="permission-badge">Downloads</span> }
                </div>
                <div class="role-card-footer">
                    <span style="color:#64748b;font-size:13px;"><i class="fas fa-users"></i> @userCount users</span>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="editRoleFromCard(this)">Edit</button>
                        <button type="button" class="btn btn-sm btn-primary" onclick="viewRoleFromCard(this)">View</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <h3 style="font-size:16px;margin-bottom:12px;">Permissions matrix</h3>
    <div style="overflow:auto;border:1px solid #E5E5E5;border-radius:12px;">
        <table class="permissions-table">
            <thead>
                <tr>
                    <th>Permission</th>
                    @foreach (var role in roles)
                    {
                        <th>@role.RoleName</th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Full dashboard</strong></td>
                    @foreach (var role in roles) { <td>@(role.AllowFullDashboard ? Html.Raw("<span class=\"permission-check\"><i class=\"fas fa-check\"></i></span>") : Html.Raw("<span class=\"permission-denied\"><i class=\"fas fa-times\"></i></span>"))</td> }
                </tr>
                <tr>
                    <td><strong>Edit</strong></td>
                    @foreach (var role in roles) { <td>@(role.AllowEdit ? Html.Raw("<span class=\"permission-check\"><i class=\"fas fa-check\"></i></span>") : Html.Raw("<span class=\"permission-denied\"><i class=\"fas fa-times\"></i></span>"))</td> }
                </tr>
                <tr>
                    <td><strong>Publishing</strong></td>
                    @foreach (var role in roles) { <td>@(role.AllowPublishing ? Html.Raw("<span class=\"permission-check\"><i class=\"fas fa-check\"></i></span>") : Html.Raw("<span class=\"permission-denied\"><i class=\"fas fa-times\"></i></span>"))</td> }
                </tr>
                <tr>
                    <td><strong>Delete</strong></td>
                    @foreach (var role in roles) { <td>@(role.AllowDelete ? Html.Raw("<span class=\"permission-check\"><i class=\"fas fa-check\"></i></span>") : Html.Raw("<span class=\"permission-denied\"><i class=\"fas fa-times\"></i></span>"))</td> }
                </tr>
                <tr>
                    <td><strong>Analytics</strong></td>
                    @foreach (var role in roles) { <td>@(role.AllowAnalytics ? Html.Raw("<span class=\"permission-check\"><i class=\"fas fa-check\"></i></span>") : Html.Raw("<span class=\"permission-denied\"><i class=\"fas fa-times\"></i></span>"))</td> }
                </tr>
                <tr>
                    <td><strong>Downloads</strong></td>
                    @foreach (var role in roles) { <td>@(role.AllowDownloads ? Html.Raw("<span class=\"permission-check\"><i class=\"fas fa-check\"></i></span>") : Html.Raw("<span class=\"permission-denied\"><i class=\"fas fa-times\"></i></span>"))</td> }
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="roleModal" tabindex="-1" aria-labelledby="roleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="roleModalLabel">Create New Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="roleForm">
                    <input type="hidden" id="roleId" value="0" />
                    <div class="mb-3">
                        <label for="roleName" class="form-label">Role Name</label>
                        <input type="text" class="form-control" id="roleName" required placeholder="Enter role name">
                    </div>
                    <div class="mb-3">
                        <label for="roleDescription" class="form-label">Description</label>
                        <input type="text" class="form-control" id="roleDescription" placeholder="Enter role description">
                    </div>
                    <label class="form-label">Permissions</label>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="permUserManagement"><label class="form-check-label" for="permUserManagement">Full dashboard</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="permContentCreate"><label class="form-check-label" for="permContentCreate">Edit</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="permContentPublish"><label class="form-check-label" for="permContentPublish">Publishing</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="permContentModerate"><label class="form-check-label" for="permContentModerate">Delete</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="permSystemSettings"><label class="form-check-label" for="permSystemSettings">Downloads</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="permAnalytics"><label class="form-check-label" for="permAnalytics">Analytics</label></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveRoleBtn">Create Role</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function resetRoleForm() {
            document.getElementById('roleModalLabel').textContent = 'Create New Role';
            document.getElementById('saveRoleBtn').textContent = 'Create Role';
            document.getElementById('roleForm').reset();
            document.getElementById('roleId').value = '0';
        }

        function cardData(btn) {
            return btn.closest('.role-card');
        }

        function editRoleFromCard(btn) {
            const c = cardData(btn);
            document.getElementById('roleModalLabel').textContent = 'Edit Role';
            document.getElementById('saveRoleBtn').textContent = 'Update Role';
            document.getElementById('roleId').value = c.getAttribute('data-role-id') || '0';
            document.getElementById('roleName').value = c.getAttribute('data-role-name') || '';
            document.getElementById('roleDescription').value = c.getAttribute('data-description') || '';
            document.getElementById('permUserManagement').checked = c.getAttribute('data-allow-dashboard') === 'true';
            document.getElementById('permContentCreate').checked = c.getAttribute('data-allow-edit') === 'true';
            document.getElementById('permContentPublish').checked = c.getAttribute('data-allow-publishing') === 'true';
            document.getElementById('permContentModerate').checked = c.getAttribute('data-allow-delete') === 'true';
            document.getElementById('permSystemSettings').checked = c.getAttribute('data-allow-downloads') === 'true';
            document.getElementById('permAnalytics').checked = c.getAttribute('data-allow-analytics') === 'true';
            new bootstrap.Modal(document.getElementById('roleModal')).show();
        }

        function viewRoleFromCard(btn) {
            const c = cardData(btn);
            Swal.fire({
                title: c.getAttribute('data-role-name') || 'Role',
                html: '<div class="text-start"><p>' + (c.getAttribute('data-description') || '') + '</p></div>',
                confirmButtonColor: '#7c3aed'
            });
        }

        document.getElementById('saveRoleBtn').addEventListener('click', function () {
            const roleName = document.getElementById('roleName').value;
            if (!roleName) {
                Swal.fire({ title: 'Role Name Required', icon: 'warning', confirmButtonColor: '#7c3aed' });
                return;
            }
            const saveBtn = this;
            saveBtn.disabled = true;
            fetch('@Url.Action("CreateRole", "Admin")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({
                    roleId: parseInt(document.getElementById('roleId').value || '0', 10),
                    roleName: roleName,
                    description: document.getElementById('roleDescription').value,
                    allowFullDashboard: document.getElementById('permUserManagement').checked,
                    allowEdit: document.getElementById('permContentCreate').checked,
                    allowPublishing: document.getElementById('permContentPublish').checked,
                    allowDelete: document.getElementById('permContentModerate').checked,
                    allowDownloads: document.getElementById('permSystemSettings').checked,
                    allowAnalytics: document.getElementById('permAnalytics').checked
                })
            }).then(r => r.json()).then(data => {
                saveBtn.disabled = false;
                if (data.success) {
                    Swal.fire({ title: 'Saved', icon: 'success', confirmButtonColor: '#7c3aed' }).then(() => location.reload());
                } else {
                    Swal.fire({ title: 'Error', text: data.message || 'Save failed', icon: 'error' });
                }
            }).catch(() => {
                saveBtn.disabled = false;
                Swal.fire({ title: 'Error', text: 'Save failed', icon: 'error' });
            });
        });
    </script>
}
