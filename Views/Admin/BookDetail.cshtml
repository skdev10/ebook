@model EBookDashboard.Models.ViewModels.AdminBookWorkspaceViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .ws-card { background: var(--white); border: 1px solid var(--border-light); border-radius: 16px; padding: 20px; box-shadow: 0 2px 8px var(--shadow-soft); margin-bottom: 16px; }
    .ws-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
    .ws-bar { height: 10px; background: #eee; border-radius: 99px; overflow: hidden; margin-top: 8px; }
    .ws-bar > span { display: block; height: 100%; background: linear-gradient(90deg, #7c3aed, #a78bfa); }
    .ws-chip { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; background: #f5f3ff; color: #6d28d9; }
    .ws-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .ws-table th { text-align: left; padding: 10px 12px; color: var(--text-muted); font-size: 11px; text-transform: uppercase; border-bottom: 1px solid var(--border-light); }
    .ws-table td { padding: 12px; border-bottom: 1px solid var(--border-light); }
    .flow-steps { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
    .flow-step { flex: 1; min-width: 120px; padding: 12px; border-radius: 12px; border: 1px solid var(--border-light); text-align: center; font-size: 13px; font-weight: 600; color: var(--text-muted); }
    .flow-step.on { background: #f5f3ff; border-color: #c4b5fd; color: #6d28d9; }
</style>

<div class="page-header" style="background:var(--white);border-radius:16px;padding:24px;margin-bottom:24px;border:1px solid var(--border-light);">
    <a href="@Url.Action("ContentManagement", "Admin")" style="font-size:13px;color:var(--primary);text-decoration:none;">← Books</a>
    ·
    <a href="@Url.Action("UserDetail", "Admin", new { id = Model.UserId })" style="font-size:13px;color:var(--primary);text-decoration:none;">Owner workspace</a>
    <h1 style="margin:8px 0 4px;font-size:24px;">@Model.Title</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
    {
        <p style="margin:0 0 8px;color:var(--text-secondary);">@Model.Subtitle</p>
    }
    <p style="margin:0;color:var(--text-muted);">@Model.OwnerName (@Model.OwnerEmail) · @Model.Genre · <span class="ws-chip">@Model.Status</span></p>
</div>

<div class="ws-card">
    <div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;">
        <div>
            <div style="font-size:12px;color:var(--text-muted);text-transform:uppercase;">User-panel flow</div>
            <strong>@Model.FlowLabel</strong> · @Model.FlowPath
        </div>
        <div>@Model.FlowPercent%</div>
    </div>
    <div class="ws-bar"><span style="width:@Model.FlowPercent%"></span></div>
    @{
        var rank = EBookDashboard.Services.BookFlowStateService.StepRank(Model.FlowStep);
        var published = EBookDashboard.Services.BookFlowStateService.IsPublishedStatus(Model.Status);
    }
    <div class="flow-steps">
        <div class="flow-step @(rank >= 1 || published ? "on" : "")">1. AI Writer</div>
        <div class="flow-step @(rank >= 2 || published ? "on" : "")">2. Formatting</div>
        <div class="flow-step @(rank >= 3 || published ? "on" : "")">3. Cover</div>
        <div class="flow-step @(rank >= 4 || published ? "on" : "")">4. Publish</div>
    </div>
</div>

<div class="ws-grid">
    <div class="ws-card">
        <h3 style="margin:0 0 12px;">Writer</h3>
        <p>@Model.Chapters.Count chapters · @Model.WordCount.ToString("N0") words</p>
        @if (Model.Chapters.Count == 0)
        {
            <p style="color:var(--text-muted);">No chapters saved yet.</p>
        }
        else
        {
            <table class="ws-table">
                <thead><tr><th>#</th><th>Title</th><th>Words</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var c in Model.Chapters)
                {
                    <tr>
                        <td>@c.ChapterNumber</td>
                        <td>@c.Title</td>
                        <td>@c.WordCount.ToString("N0")</td>
                        <td>@(string.IsNullOrWhiteSpace(c.Status) ? (c.IsPublished ? "Published" : "Draft") : c.Status)</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
    <div class="ws-card">
        <h3 style="margin:0 0 12px;">Formatting</h3>
        @if (string.IsNullOrWhiteSpace(Model.Format) && string.IsNullOrWhiteSpace(Model.InteriorStyle))
        {
            <p style="color:var(--text-muted);">Formatting not started.</p>
        }
        else
        {
            <p>Format: <strong>@(Model.Format ?? "—")</strong></p>
            <p>Style: <strong>@(Model.InteriorStyle ?? "—")</strong></p>
            <p>Text size: @(Model.TextSize ?? "—") · Line spacing: @(Model.LineSpacing ?? "—")</p>
            <p>Platforms: @(Model.PublishingPlatforms ?? "—")</p>
        }
    </div>
    <div class="ws-card">
        <h3 style="margin:0 0 12px;">Cover Design</h3>
        @if (!Model.Covers.Any())
        {
            <p style="color:var(--text-muted);">No cover projects.</p>
        }
        else
        {
            <table class="ws-table">
                <thead><tr><th>Type</th><th>Name</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var c in Model.Covers)
                {
                    <tr>
                        <td>@c.CoverType @(c.IsActive ? "(active)" : "")</td>
                        <td>@c.DisplayName</td>
                        <td>@c.Status</td>
                        <td>@c.UpdatedAt.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
    <div class="ws-card">
        <h3 style="margin:0 0 12px;">Publish</h3>
        <p>Status: <strong>@Model.Status</strong></p>
        <p>List price: @(Model.ListPrice.HasValue ? $"{Model.ListPrice.Value:N2} {Model.Currency}" : "—")</p>
        <p>Created @Model.CreatedAt.ToString("yyyy-MM-dd") · Updated @(Model.UpdatedAt?.ToString("yyyy-MM-dd") ?? "—")</p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p style="color:var(--text-secondary);">@Model.Description</p>
        }
    </div>
</div>

<div class="ws-card">
    <h3 style="margin:0 0 12px;">Lifecycle (same events as Progress Tracker)</h3>
    @if (!Model.Transitions.Any())
    {
        <p style="color:var(--text-muted);">No recorded transitions.</p>
    }
    else
    {
        <table class="ws-table">
            <thead><tr><th>When</th><th>Kind</th><th>From</th><th>To</th></tr></thead>
            <tbody>
            @foreach (var t in Model.Transitions)
            {
                <tr>
                    <td>@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@t.Kind</td>
                    <td>@(t.FromStatus ?? "—")</td>
                    <td>@t.ToStatus</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
