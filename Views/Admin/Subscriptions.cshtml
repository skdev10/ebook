<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous"></script>
            <script>
    // Ensure content is visible
    function ensureContentVisible() {
        const plansGrid = document.getElementById('plansGrid');
        const plansLoading = document.getElementById('plansLoading');
        const plansEmpty = document.getElementById('plansEmpty');
        
        if (plansGrid) {
            plansGrid.style.display = 'grid';
            plansGrid.style.visibility = 'visible';
            plansGrid.style.opacity = '1';
        }
        
        const sections = document.querySelectorAll('.stats-grid, .subscription-header, .plans-grid, .subscription-tabs, .tab-content');
        sections.forEach(section => {
            if (section) {
                section.style.display = '';
                section.style.visibility = 'visible';
                section.style.opacity = '1';
            }
        });
    }
    
    // Load subscription stats from database
    async function loadSubscriptionStats() {
        try {
            const response = await fetch('@Url.Action("GetSubscriptionStats", "Admin")');
            if (response.ok) {
                const data = await response.json();
                if (data.success && data.stats) {
                    const stats = data.stats;
                    
                    // Update stats cards with real data
                    const statsCards = document.querySelectorAll('.stats-card');
                    if (statsCards.length >= 4) {
                        // Total Subscribers
                        const subscribersValue = statsCards[0].querySelector('.stats-value');
                        if (subscribersValue) subscribersValue.textContent = stats.totalSubscribers || '0';
                        
                        // Monthly Revenue
                        const revenueValue = statsCards[1].querySelector('.stats-value');
                        if (revenueValue) revenueValue.textContent = `$${parseFloat(stats.monthlyRevenue || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                        
                        // Retention Rate
                        const retentionValue = statsCards[2].querySelector('.stats-value');
                        if (retentionValue) retentionValue.textContent = `${stats.retentionRate || 0}%`;
                        
                        // Expiring Soon
                        const expiringValue = statsCards[3].querySelector('.stats-value');
                        if (expiringValue) expiringValue.textContent = stats.expiringSoon || '0';
                    }
                }
            }
        } catch (error) {
            console.error('Error loading subscription stats:', error);
        }
    }

    // Load plans from database
    async function loadPlans() {
        const plansGrid = document.getElementById('plansGrid');
        const plansLoading = document.getElementById('plansLoading');
        const plansEmpty = document.getElementById('plansEmpty');
        
        try {
            if (plansLoading) plansLoading.style.display = 'block';
            if (plansGrid) plansGrid.style.display = 'none';
            if (plansEmpty) plansEmpty.style.display = 'none';
            
            const response = await fetch('@Url.Action("GetPlans", "Admin")');
            if (response.ok) {
                const data = await response.json();
                const plans = data?.plans || [];
                
                if (plansLoading) plansLoading.style.display = 'none';
                
                if (plans && plans.length > 0) {
                    if (plansGrid) {
                        plansGrid.innerHTML = plans.map((plan, index) => {
                            let planType = 'basic';
                            if (plan.planName?.toLowerCase().includes('professional') || plan.planName?.toLowerCase().includes('pro')) planType = 'professional';
                            else if (plan.planName?.toLowerCase().includes('premium')) planType = 'premium';
                            else if (plan.planName?.toLowerCase().includes('enterprise')) planType = 'enterprise';
                            
                            const features = [];
                            if (plan.allowDownloads) features.push({ name: 'Downloads Allowed', included: true });
                            if (plan.allowFullDashboard) features.push({ name: 'Full Dashboard Access', included: true });
                            if (plan.allowAnalytics) features.push({ name: 'Analytics Access', included: true });
                            if (plan.allowPublishing) features.push({ name: 'Publishing Access', included: true });
                            if (plan.maxEBooks) features.push({ name: `Max ${plan.maxEBooks} eBooks`, included: true });
                            if (plan.maxPages) features.push({ name: `Max ${plan.maxPages} Pages`, included: true });
                            if (plan.maxChapters) features.push({ name: `Max ${plan.maxChapters} Chapters`, included: true });
                            
                            return `
                                <div class="plan-card ${planType}">
                                    ${index === 1 && plan.isActive ? '<div class="popular-badge">MOST POPULAR</div>' : ''}
                                    <div class="plan-header">
                                        <h4>${plan.planName || 'Plan'}</h4>
                                        <p>${plan.planDescription || 'Subscription plan'}</p>
                                    </div>
                                    <div class="plan-body">
                                        <div class="plan-price-section">
                                            <div class="plan-price">$${parseFloat(plan.planRate || 0).toFixed(2)}</div>
                                            <div class="plan-period">per ${plan.planDays ? Math.floor(plan.planDays / 30) + ' month(s)' : 'month'}</div>
                                        </div>
                                        <ul class="plan-features">
                                            ${features.length > 0 ? features.map(feature => `
                                                <li>
                                                    <i class="fas fa-check feature-icon feature-included"></i>
                                                    <span>${feature.name}</span>
                                                </li>
                                            `).join('') : '<li style="color: var(--text-muted);">No features specified</li>'}
                                        </ul>
                                        <div class="plan-actions">
                                            <button class="btn btn-outline edit-plan-btn" data-plan-id="${plan.planId}">
                                                <i class="fas fa-edit"></i>
                                                Edit
                                            </button>
                                            <button class="btn btn-primary view-plan-btn" data-plan-id="${plan.planId}">
                                                <i class="fas fa-eye"></i>
                                                View
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            `;
                        }).join('');
                        plansGrid.style.display = 'grid';
                    }
                } else {
                    if (plansEmpty) plansEmpty.style.display = 'block';
                }
            } else {
                if (plansLoading) plansLoading.style.display = 'none';
                if (plansEmpty) plansEmpty.style.display = 'block';
            }
        } catch (error) {
            console.error('Error loading plans:', error);
            if (plansLoading) plansLoading.style.display = 'none';
            if (plansEmpty) plansEmpty.style.display = 'block';
        }
    }

    // Load subscribers from database
    async function loadSubscribers() {
        try {
            const response = await fetch('@Url.Action("GetSubscribers", "Admin")');
            if (response.ok) {
                const data = await response.json();
                const subscribers = data?.subscribers || [];
                
                const subscribersTable = document.querySelector('#subscribers .data-table tbody');
                if (subscribersTable) {
                    if (subscribers.length > 0) {
                        subscribersTable.innerHTML = subscribers.map(sub => `
                            <tr>
                                <td>${sub.userName || 'Unknown'}</td>
                                <td>${sub.userEmail || ''}</td>
                                <td>${sub.planName || 'N/A'}</td>
                                <td>${sub.startDate || ''}</td>
                                <td><span class="badge ${sub.status === 'Active' ? 'badge-active' : sub.status === 'Expired' ? 'badge-expired' : 'badge-cancelled'}">${sub.status || 'Unknown'}</span></td>
                                <td>
                                    <button class="btn btn-outline" style="padding: 8px 16px; font-size: 13px;" onclick="viewSubscriber(${sub.subscriptionId})">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </td>
                            </tr>
                        `).join('');
                    } else {
                        subscribersTable.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 40px; color: var(--text-muted);">No subscribers found</td></tr>';
                    }
                }
            }
        } catch (error) {
            console.error('Error loading subscribers:', error);
        }
    }

    // Load payments from database
    async function loadPayments() {
        try {
            const response = await fetch('@Url.Action("GetPayments", "Admin")');
            if (response.ok) {
                const data = await response.json();
                const payments = data?.payments || [];
                
                const paymentsTable = document.querySelector('#payments .data-table tbody');
                if (paymentsTable) {
                    if (payments.length > 0) {
                        paymentsTable.innerHTML = payments.map(payment => `
                            <tr>
                                <td>#TXN-${String(payment.transactionId).padStart(6, '0')}</td>
                                <td>${payment.userName || 'Unknown'}</td>
                                <td>${payment.currency === 'usd' ? '$' : payment.currency?.toUpperCase() || '$'}${parseFloat(payment.amount || 0).toFixed(2)}</td>
                                <td>${payment.createdAt ? new Date(payment.createdAt).toLocaleDateString() : ''}</td>
                                <td><span class="badge ${payment.status === 'Paid' ? 'badge-active' : payment.status === 'Pending' ? 'badge-pending' : 'badge-expired'}">${payment.status || 'Unknown'}</span></td>
                                <td>
                                    <button class="btn btn-outline" style="padding: 8px 16px; font-size: 13px;" onclick="viewPayment(${payment.transactionId})">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        `).join('');
                    } else {
                        paymentsTable.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 40px; color: var(--text-muted);">No payments found</td></tr>';
                    }
                }
            }
        } catch (error) {
            console.error('Error loading payments:', error);
        }
    }

    // View subscriber details
    function viewSubscriber(subscriptionId) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'info',
                title: 'Subscriber Details',
                text: 'Subscriber details view will be implemented soon',
                confirmButtonColor: '#7c3aed'
            });
        }
    }

    // View payment details
    function viewPayment(transactionId) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'info',
                title: 'Payment Details',
                text: 'Payment details view will be implemented soon',
                confirmButtonColor: '#7c3aed'
            });
        }
    }
    
    // Save plan (Create or Update)
    document.getElementById('savePlanBtn')?.addEventListener('click', async function() {
        const planName = document.getElementById('planName')?.value?.trim();
        const planPrice = document.getElementById('planPrice')?.value;
        const planInterval = document.getElementById('planInterval')?.value;
        const planDescription = document.getElementById('planDescription')?.value?.trim() || '';
        const editPlanIdEl = document.getElementById('editPlanId');
        const isEdit = editPlanIdEl && editPlanIdEl.value;
        
        if (!planName || !planPrice) {
            if (typeof Swal !== 'undefined') {
                Swal.fire('Validation Error', 'Please fill in all required fields', 'warning');
            } else {
                alert('Please fill in all required fields');
            }
            return;
        }
        
        const planDays = planInterval === 'yearly' ? 365 : 30;
        const features = [];
        if (document.getElementById('featureFormatting')?.checked) features.push('Ebook Formatting');
        if (document.getElementById('featureCoverDesign')?.checked) features.push('Cover Design');
        if (document.getElementById('featureAudiobook')?.checked) features.push('Audiobook Conversion');
        if (document.getElementById('featureMarketing')?.checked) features.push('Marketing Tools');
        if (document.getElementById('featurePrioritySupport')?.checked) features.push('Priority Support');
        if (document.getElementById('featureAnalytics')?.checked) features.push('Advanced Analytics');
        
        const planPayload = {
            PlanName: planName,
            PlanRate: parseFloat(planPrice),
            PlanDays: planDays,
            PlanDescription: planDescription,
            Currency: 'usd',
            MaxEBooks: features.includes('Ebook Formatting') ? 10 : 0,
            MaxPages: 1000,
            MaxChapters: 50,
            AllowDownloads: features.includes('Marketing Tools'),
            AllowFullDashboard: true,
            AllowAnalytics: features.includes('Advanced Analytics'),
            AllowPublishing: true,
            IsActive: 1
        };
        
        try {
            const url = isEdit
                ? '@Url.Action("UpdatePlan", "Admin")?planId=' + encodeURIComponent(editPlanIdEl.value)
                : '@Url.Action("CreatePlan", "Admin")';
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(planPayload)
            });
            
            const responseData = response.ok ? await response.json().catch(() => ({})) : null;
            const success = response.ok && (responseData?.success !== false);
            
            if (success) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: isEdit ? 'Plan updated successfully' : 'Plan created successfully',
                        timer: 2000,
                        showConfirmButton: false,
                        confirmButtonColor: '#7c3aed'
                    });
                }
                const modal = bootstrap.Modal.getInstance(document.getElementById('addPlanModal'));
                if (modal) modal.hide();
                document.getElementById('editPlanId').value = '';
                document.getElementById('addPlanForm')?.reset();
                document.getElementById('addPlanModalLabel').innerHTML = '<i class="fas fa-plus-circle me-2"></i>Create New Subscription Plan';
                document.getElementById('savePlanBtnText').textContent = 'Create Plan';
                await loadPlans();
            } else {
                const error = responseData?.message || await response.text() || (isEdit ? 'Failed to update plan' : 'Failed to create plan');
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Error', error, 'error');
                } else {
                    alert(error);
                }
            }
        } catch (error) {
            console.error(isEdit ? 'Error updating plan:' : 'Error creating plan:', error);
            if (typeof Swal !== 'undefined') {
                Swal.fire('Error', isEdit ? 'Failed to update plan' : 'Failed to create plan', 'error');
            } else {
                alert(isEdit ? 'Failed to update plan' : 'Failed to create plan');
            }
        }
    });
    
    // Export reports
    document.getElementById('exportReportsBtn')?.addEventListener('click', function() {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                        icon: 'info',
                title: 'Export Reports',
                text: 'Report export functionality will be implemented soon',
                confirmButtonColor: '#7c3aed'
            });
        } else {
            alert('Report export functionality will be implemented soon');
        }
    });
    
    // View Plan button - event delegation (plans are loaded dynamically)
    document.addEventListener('click', async function(e) {
        const viewBtn = e.target.closest('.view-plan-btn');
        if (!viewBtn) return;
        e.preventDefault();
        const planId = viewBtn.getAttribute('data-plan-id');
        if (!planId) return;
        try {
            const response = await fetch('@Url.Action("GetPlanDetails", "Admin")?planId=' + encodeURIComponent(planId));
            if (!response.ok) {
                if (typeof Swal !== 'undefined') Swal.fire('Error', 'Could not load plan details', 'error');
                return;
            }
            const data = await response.json();
            if (!data.success || !data.plan) {
                if (typeof Swal !== 'undefined') Swal.fire('Error', data.message || 'Plan not found', 'error');
                return;
            }
            const plan = data.plan;
            const period = plan.planDays === 365 ? 'yearly' : (plan.planDays ? Math.floor(plan.planDays / 30) + ' month(s)' : 'month');
            const features = [];
            if (plan.allowDownloads) features.push('Downloads Allowed');
            if (plan.allowFullDashboard) features.push('Full Dashboard Access');
            if (plan.allowAnalytics) features.push('Analytics Access');
            if (plan.allowPublishing) features.push('Publishing Access');
            if (plan.maxEBooks) features.push('Max ' + plan.maxEBooks + ' eBooks');
            if (plan.maxPages) features.push('Max ' + plan.maxPages + ' Pages');
            if (plan.maxChapters) features.push('Max ' + plan.maxChapters + ' Chapters');
            const html = `
                <div style="text-align: left;">
                    <p><strong>Name:</strong> ${(plan.planName || '—')}</p>
                    <p><strong>Price:</strong> $${parseFloat(plan.planRate || 0).toFixed(2)} per ${period}</p>
                    <p><strong>Description:</strong> ${(plan.planDescription || '—')}</p>
                    <p><strong>Features:</strong></p>
                    <ul style="margin: 0 0 0 1em; padding: 0;">${features.length ? features.map(f => '<li>' + f + '</li>').join('') : '<li style="color: #888;">None specified</li>'}</ul>
                    <p style="margin-top: 12px;"><strong>Status:</strong> ${plan.isActive ? 'Active' : 'Inactive'}</p>
                </div>
            `;
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Plan Details',
                    html: html,
                    icon: 'info',
                    confirmButtonColor: '#7c3aed',
                    width: '480px'
                });
            } else {
                alert('Plan: ' + (plan.planName || '') + '\n$' + parseFloat(plan.planRate || 0).toFixed(2) + ' per ' + period);
            }
        } catch (err) {
            console.error('Error loading plan for view:', err);
            if (typeof Swal !== 'undefined') Swal.fire('Error', 'Failed to load plan details', 'error');
        }
    });

    // Edit Plan button - event delegation (plans are loaded dynamically)
    document.addEventListener('click', async function(e) {
        const editBtn = e.target.closest('.edit-plan-btn');
        if (!editBtn) return;
        e.preventDefault();
        const planId = editBtn.getAttribute('data-plan-id');
        if (!planId) return;
        try {
            const response = await fetch('@Url.Action("GetPlanDetails", "Admin")?planId=' + encodeURIComponent(planId));
            if (!response.ok) {
                if (typeof Swal !== 'undefined') Swal.fire('Error', 'Could not load plan details', 'error');
                return;
            }
            const data = await response.json();
            if (!data.success || !data.plan) {
                if (typeof Swal !== 'undefined') Swal.fire('Error', data.message || 'Plan not found', 'error');
                return;
            }
            const plan = data.plan;
            document.getElementById('editPlanId').value = planId;
            document.getElementById('planName').value = plan.planName || '';
            document.getElementById('planPrice').value = plan.planRate != null ? plan.planRate : '';
            document.getElementById('planInterval').value = (plan.planDays === 365) ? 'yearly' : 'monthly';
            document.getElementById('planDescription').value = plan.planDescription || '';
            document.getElementById('featureFormatting').checked = (plan.maxEBooks || 0) > 0;
            document.getElementById('featureCoverDesign').checked = true;
            document.getElementById('featureAudiobook').checked = false;
            document.getElementById('featureMarketing').checked = plan.allowDownloads || false;
            document.getElementById('featurePrioritySupport').checked = false;
            document.getElementById('featureAnalytics').checked = plan.allowAnalytics || false;
            document.getElementById('addPlanModalLabel').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Plan';
            document.getElementById('savePlanBtnText').textContent = 'Save Changes';
            const modal = new bootstrap.Modal(document.getElementById('addPlanModal'));
            modal.show();
        } catch (err) {
            console.error('Error loading plan for edit:', err);
            if (typeof Swal !== 'undefined') Swal.fire('Error', 'Failed to load plan details', 'error');
        }
    });

    // Reset modal to "Create" mode when hidden
    document.getElementById('addPlanModal')?.addEventListener('hidden.bs.modal', function() {
        document.getElementById('editPlanId').value = '';
        document.getElementById('addPlanForm')?.reset();
        document.getElementById('addPlanModalLabel').innerHTML = '<i class="fas fa-plus-circle me-2"></i>Create New Subscription Plan';
        document.getElementById('savePlanBtnText').textContent = 'Create Plan';
    });

    // Tab change handlers to load data
    document.addEventListener('DOMContentLoaded', function() {
        ensureContentVisible();
        loadSubscriptionStats();
        loadPlans();
        
        setTimeout(ensureContentVisible, 100);
        setTimeout(ensureContentVisible, 500);
        setTimeout(ensureContentVisible, 1000);
        
        // Load data when tabs are clicked
        const tabButtons = document.querySelectorAll('#subscriptionTabs button[data-bs-toggle="tab"]');
        tabButtons.forEach(button => {
            button.addEventListener('shown.bs.tab', function(event) {
                const targetId = event.target.getAttribute('data-bs-target');
                
                if (targetId === '#subscribers') {
                    loadSubscribers();
                } else if (targetId === '#payments') {
                    loadPayments();
                } else if (targetId === '#analytics') {
                    // Load analytics data if needed
                }
            });
        });
    });
</script>
