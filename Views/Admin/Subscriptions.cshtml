@{
    ViewData["Title"] = "Subscription Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
 <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
     <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
    /* Outstanding Theme Colors */
        :root {
        --white: #FFFFFF;
        --light-gray: #F5F5F5;
        --warm-gray: #E8E8E8;
        --text-primary: #2C2C2C;
        --text-secondary: #6B6B6B;
        --text-muted: #9B9B9B;
        --border-light: #E5E5E5;
        --shadow-soft: rgba(0, 0, 0, 0.05);
        --primary: #7c3aed;
        --primary-light: #a78bfa;
        --primary-dark: #6d28d9;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --gradient-primary: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
        --gradient-success: linear-gradient(135deg, var(--success) 0%, #34d399 100%);
        --gradient-warning: linear-gradient(135deg, var(--warning) 0%, #fbbf24 100%);
        --gradient-danger: linear-gradient(135deg, var(--danger) 0%, #f87171 100%);
    }

    /* Best Font Family - Same as all other screens */
    * {
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }

    body {
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }

    .subscriptions-container {
        padding: 0;
        animation: fadeIn 0.6s ease-out;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Outstanding Page Header */
    .page-header {
            background: var(--white);
        border-radius: 20px;
        padding: 32px;
        margin-bottom: 32px;
        box-shadow: 0 4px 20px var(--shadow-soft);
            border: 1px solid var(--border-light);
            position: relative;
            overflow: hidden;
        }

    .page-header::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
        width: 5px;
                height: 100%;
        background: var(--gradient-primary);
    }

    .page-header::after {
        content: "";
        position: absolute;
        top: -50%;
        right: -50%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(124, 58, 237, 0.1) 0%, transparent 70%);
        border-radius: 50%;
            }

        .header-content {
            position: relative;
            z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 24px;
    }

    .page-title {
        font-size: 32px;
        font-weight: 800;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 0;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        letter-spacing: -0.5px;
    }

    .page-title i {
        font-size: 36px;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .page-subtitle {
        font-size: 15px;
        color: var(--text-secondary);
        margin-top: 8px;
        font-weight: 500;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .header-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* Outstanding Stats Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 24px;
        margin-bottom: 32px;
    }

        .stats-card {
            background: var(--white);
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 4px 20px var(--shadow-soft);
            border: 1px solid var(--border-light);
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            position: relative;
            overflow: hidden;
        }

            .stats-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
        width: 5px;
                height: 100%;
        background: var(--gradient-primary);
                opacity: 0;
        transition: opacity 0.4s ease;
            }

            .stats-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 40px rgba(124, 58, 237, 0.15);
            }

                .stats-card:hover::before {
                    opacity: 1;
                }

    .stats-icon-wrapper {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        background: var(--gradient-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.2);
                }

        .stats-icon {
        font-size: 28px;
        color: white;
        }

    .stats-value {
        font-size: 36px;
        font-weight: 800;
        color: var(--text-primary);
        margin-bottom: 8px;
        line-height: 1;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        letter-spacing: -1px;
    }

    .stats-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 12px;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .stats-trend {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 20px;
        width: fit-content;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

        .trend-up {
        background: rgba(16, 185, 129, 0.1);
        color: var(--success);
        }

        .trend-down {
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
    }

    /* Outstanding Tabs */
        .subscription-tabs {
        background: var(--white);
        border-radius: 20px;
        box-shadow: 0 4px 20px var(--shadow-soft);
        border: 1px solid var(--border-light);
        margin-bottom: 32px;
            overflow: hidden;
        }

        .nav-tabs-grid {
        display: flex;
        background: var(--light-gray);
        border-bottom: 2px solid var(--border-light);
        overflow-x: auto;
        }

            .nav-tabs-grid .nav-item {
        flex: 1;
        min-width: 200px;
            }

            .nav-tabs-grid .nav-link {
                border: none;
        padding: 20px 24px;
                font-weight: 600;
        color: var(--text-secondary);
                background: transparent;
        transition: all 0.3s ease;
        font-size: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        white-space: nowrap;
        position: relative;
            }

                .nav-tabs-grid .nav-link:hover {
        color: var(--primary);
        background: rgba(124, 58, 237, 0.05);
                }

                .nav-tabs-grid .nav-link.active {
        color: var(--primary);
        background: var(--white);
                    font-weight: 700;
                }

                    .nav-tabs-grid .nav-link.active::after {
                        content: "";
                        position: absolute;
                        bottom: 0;
                        left: 0;
                        width: 100%;
                        height: 3px;
                        background: var(--gradient-primary);
                    }

        .tab-content {
        padding: 32px;
    }

    /* Outstanding Plan Cards */
    .plans-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 28px;
    }

    .plan-card {
        background: var(--white);
        border-radius: 24px;
            overflow: hidden;
        box-shadow: 0 4px 20px var(--shadow-soft);
        border: 3px solid var(--border-light);
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .plan-card:hover {
        transform: translateY(-12px) scale(1.02);
        box-shadow: 0 16px 48px rgba(124, 58, 237, 0.2);
    }

    .plan-card.basic {
        border-color: var(--primary);
    }

    .plan-card.professional {
        border-color: var(--success);
    }

    .plan-card.premium {
        border-color: var(--primary-light);
    }

    .plan-card.enterprise {
        border-color: var(--primary);
    }

    .plan-header {
            background: var(--gradient-primary);
            color: white;
        padding: 32px;
                text-align: center;
        position: relative;
        overflow: hidden;
    }

    .plan-header::before {
        content: "";
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
    }

    .plan-card.professional .plan-header {
        background: var(--gradient-success);
    }

    .plan-card.premium .plan-header {
        background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
    }

    .plan-card.enterprise .plan-header {
        background: linear-gradient(135deg, var(--primary) 0%, var(--danger) 100%);
    }

    .plan-header h4 {
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 10px;
        color: white;
        position: relative;
        z-index: 1;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        letter-spacing: -0.3px;
    }

    .plan-header p {
        font-size: 14px;
        opacity: 0.95;
        margin: 0;
        color: white;
        position: relative;
        z-index: 1;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .plan-body {
        padding: 32px;
        flex: 1;
            display: flex;
            flex-direction: column;
        }

    .plan-price-section {
            text-align: center;
        padding: 24px 0;
        border-bottom: 2px solid var(--border-light);
        margin-bottom: 24px;
    }

    .plan-price {
        font-size: 56px;
        font-weight: 900;
        color: var(--text-primary);
        margin-bottom: 8px;
        line-height: 1;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        letter-spacing: -2px;
    }

    .plan-period {
        color: var(--text-secondary);
        font-size: 15px;
        font-weight: 600;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .plan-features {
        list-style: none;
        padding: 0;
        margin: 0 0 28px 0;
        flex: 1;
    }

    .plan-features li {
        padding: 14px 0;
        border-bottom: 1px solid var(--border-light);
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 15px;
        color: var(--text-primary);
        font-weight: 500;
        transition: all 0.3s ease;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .plan-features li:hover {
        background: rgba(124, 58, 237, 0.05);
        padding-left: 12px;
        border-radius: 10px;
        margin: 0 -12px;
        padding-right: 12px;
    }

    .plan-features li:last-child {
        border-bottom: none;
    }

    .feature-icon {
                font-size: 18px;
                width: 24px;
                text-align: center;
        flex-shrink: 0;
    }

    .feature-included {
        color: var(--success);
    }

    .feature-excluded {
                color: var(--text-muted);
        opacity: 0.6;
            }

    .plan-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
            gap: 12px;
        margin-top: auto;
    }

    .popular-badge {
        position: absolute;
        top: 24px;
        right: -35px;
        background: var(--gradient-warning);
        color: white;
        padding: 8px 50px;
        font-size: 12px;
        font-weight: 800;
        transform: rotate(45deg);
        box-shadow: 0 6px 20px rgba(245, 158, 11, 0.4);
        z-index: 10;
        letter-spacing: 1px;
    }

    /* Outstanding Buttons */
    .btn {
        padding: 14px 24px;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        position: relative;
        overflow: hidden;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        letter-spacing: 0.2px;
    }

            .btn::before {
        content: "";
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
                transition: left 0.5s;
            }

            .btn:hover::before {
                left: 100%;
            }

        .btn-primary {
        background: var(--gradient-primary);
            color: white;
            box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(124, 58, 237, 0.4);
    }

    .btn-outline {
        background: transparent;
        border: 2px solid var(--primary);
        color: var(--primary);
    }

    .btn-outline:hover {
        background: var(--primary);
        color: white;
                transform: translateY(-2px);
    }

    .btn-success {
        background: var(--gradient-success);
            color: white;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(16, 185, 129, 0.4);
    }

    /* Outstanding Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .badge-active {
        background: var(--gradient-success);
        color: white;
    }

    .badge-expired {
        background: linear-gradient(135deg, #6b7280 0%, #9ca3af 100%);
        color: white;
    }

    .badge-pending {
        background: var(--gradient-warning);
        color: white;
    }

    .badge-cancelled {
        background: var(--gradient-danger);
        color: white;
    }

    .badge-active {
        background: rgba(16, 185, 129, 0.15);
        color: var(--success);
    }

    .badge-pending {
        background: rgba(245, 158, 11, 0.15);
        color: var(--warning);
    }

    .badge-expired {
        background: rgba(239, 68, 68, 0.15);
        color: var(--danger);
    }

    .badge-cancelled {
        background: rgba(107, 114, 128, 0.15);
        color: var(--text-secondary);
    }

    /* Outstanding Tables */
    .table-container {
        background: var(--white);
        border-radius: 20px;
        padding: 32px;
        box-shadow: 0 4px 20px var(--shadow-soft);
        border: 1px solid var(--border-light);
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table thead {
        background: var(--gradient-primary);
    }

    .data-table thead th {
        padding: 18px 20px;
        text-align: left;
        font-size: 13px;
        font-weight: 700;
        color: white;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .data-table tbody td {
        padding: 18px 20px;
        font-size: 14px;
        color: var(--text-primary);
        border-bottom: 1px solid var(--border-light);
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .data-table tbody tr {
        transition: all 0.3s ease;
    }

    .data-table tbody tr:hover {
        background: var(--light-gray);
        transform: scale(1.01);
    }

    /* Loading & Empty States */
    .loading-state,
    .empty-state {
                text-align: center;
        padding: 80px 32px;
        background: var(--white);
        border-radius: 20px;
        box-shadow: 0 4px 20px var(--shadow-soft);
        border: 1px solid var(--border-light);
    }

    .loading-state i,
    .empty-state i {
        font-size: 72px;
        color: var(--text-muted);
        margin-bottom: 24px;
        opacity: 0.5;
    }

    .loading-state h3,
    .empty-state h3 {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 12px;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        letter-spacing: -0.3px;
    }

    .loading-state p,
    .empty-state p {
        font-size: 15px;
        color: var(--text-secondary);
        margin-bottom: 32px;
        font-family: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    /* Responsive Design */
    @@media (max-width: 1024px) {
        .page-header {
            padding: 24px;
        }

        .page-title {
            font-size: 28px;
        }

        .stats-grid {
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        }

        .plans-grid {
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .subscriptions-container {
            padding: 0;
        }

        .page-header {
            padding: 20px;
        }

        .page-title {
            font-size: 24px;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .plans-grid {
            grid-template-columns: 1fr;
        }

        .nav-tabs-grid {
            flex-direction: column;
        }

        .nav-tabs-grid .nav-item {
            min-width: 100%;
        }

        .tab-content {
            padding: 20px;
        }

        .plan-card {
            margin-bottom: 20px;
        }

        .plan-actions {
            grid-template-columns: 1fr;
        }

        .table-container {
            padding: 20px;
        }

        .data-table {
            min-width: 800px;
        }
    }

    @@media (max-width: 480px) {
        .page-header {
            padding: 16px;
        }

        .page-title {
            font-size: 20px;
        }

        .header-actions {
            flex-direction: column;
            width: 100%;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }

        .stats-card {
            padding: 20px;
        }

        .stats-value {
            font-size: 28px;
        }

        .plan-body {
            padding: 24px;
        }

        .plan-price {
            font-size: 42px;
        }

        .tab-content {
            padding: 16px;
        }

        .modal-dialog {
            margin: 10px;
        }

        .modal-content {
            padding: 16px;
        }
            }
    </style>

<div class="subscriptions-container">
    <!-- Outstanding Page Header -->
    <div class="page-header">
        <div class="header-content">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-crown"></i>
                    Subscription Management
                    </h1>
                <div class="page-subtitle">Manage subscription plans, monitor revenue, and analyze customer growth with advanced analytics</div>
                </div>
                    <div class="header-actions">
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPlanModal">
                    <i class="fas fa-plus"></i>
                    Create New Plan
                        </button>
                <button class="btn btn-outline" id="exportReportsBtn">
                    <i class="fas fa-download"></i>
                    Export Reports
                        </button>
            </div>
        </div>
    </div>

    <!-- Outstanding Stats Overview -->
    <div class="stats-grid">
        <div class="stats-card">
            <div class="stats-icon-wrapper">
                <i class="fas fa-users stats-icon"></i>
            </div>
            <div class="stats-value">1,248</div>
            <div class="stats-label">Total Subscribers</div>
            <div class="stats-trend trend-up">
                <i class="fas fa-arrow-up"></i>
                <span>12.5% growth</span>
            </div>
        </div>

        <div class="stats-card">
            <div class="stats-icon-wrapper">
                <i class="fas fa-money-bill-wave stats-icon"></i>
            </div>
            <div class="stats-value">$24,580</div>
            <div class="stats-label">Monthly Revenue</div>
            <div class="stats-trend trend-up">
                <i class="fas fa-arrow-up"></i>
                <span>8.3% increase</span>
            </div>
        </div>

        <div class="stats-card">
            <div class="stats-icon-wrapper">
                <i class="fas fa-chart-line stats-icon"></i>
            </div>
            <div class="stats-value">94.2%</div>
            <div class="stats-label">Retention Rate</div>
            <div class="stats-trend trend-up">
                <i class="fas fa-arrow-up"></i>
                <span>2.1% improvement</span>
            </div>
        </div>

        <div class="stats-card">
            <div class="stats-icon-wrapper">
                <i class="fas fa-exclamation-triangle stats-icon"></i>
            </div>
            <div class="stats-value">18</div>
            <div class="stats-label">Expiring Soon</div>
            <div class="stats-trend trend-down">
                <i class="fas fa-arrow-down"></i>
                <span>Requires attention</span>
            </div>
        </div>
    </div>

    <!-- Outstanding Subscription Tabs -->
    <div class="subscription-tabs">
        <ul class="nav nav-tabs-grid" id="subscriptionTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="plans-tab" data-bs-toggle="tab" data-bs-target="#plans" type="button" role="tab">
                    <i class="fas fa-cube"></i>
                    <span>Subscription Plans</span>
                </button>
