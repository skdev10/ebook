                    var createRes = await fetch('/Books/CreateBook', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token, Accept: 'application/json' },
                        body: JSON.stringify({
