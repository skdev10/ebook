    async function runPrintReadyModalAutoGenerate() {
        if (!printReadyPendingBookId) return;
        var spec = recalcPrintReadyModalMetrics();
        var pages = getFormatterPreviewPageCount() || parseInt(spec.pageCount || '0', 10);
        if (!Number.isFinite(pages) || pages <= 0) {
            setPrModalStatus('Page count unknown. Load the book preview first.', true);
            return;
        }
        pages = Math.min(828, pages);
        recalcPrintReadyModalMetrics({ pageCount: pages });
        spec = recalcPrintReadyModalMetrics();
        var trim = spec.trimValue || '6x9';
        printReadyGenerationIteration += 1;
        var selectedStyle = selectDesignDirection(printReadyPendingBookId, bookPreviewContext.genre || '', printReadyGenerationIteration);
        var coverStyle = buildSmartCoverPrompt(spec, selectedStyle, printReadyGenerationIteration);
        var autoBtn = document.getElementById('prModalAutoGenerate');
        if (autoBtn) autoBtn.disabled = true;
        if (prModalWrapStage) prModalWrapStage.classList.add('loading');
        setPrModalStatus('Generating ' + selectedStyle.tone + ' direction (' + selectedStyle.category + ') with unique structure…');
        try {
            var response = await fetch('/Dashboard/GeneratePrintReadyCover', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                    bookId: printReadyPendingBookId,
                    pageCount: pages,
                    trimSize: trim,
                    coverStyle: coverStyle
                })
            });
            var data = await response.json();
            if (!response.ok || !data || data.success === false) {
                throw new Error((data && data.message) ? data.message : ('HTTP ' + response.status));
            }
            var frontUrl = (data.cover && data.cover.front) ? data.cover.front : '';
            var spineUrl = (data.cover && data.cover.spine) ? data.cover.spine : '';
            var backUrl = (data.cover && data.cover.back) ? data.cover.back : '';
            var pagesForCompose = getFormatterPreviewPageCount() || pages;
            if (data.pageCount && getFormatterPreviewPageCount() <= 0) pagesForCompose = data.pageCount;
            var wrapImg = document.getElementById('prModalWrapImg');
            var wrapPlaceholder = document.getElementById('prModalWrapPlaceholder');
            setPartImage('prModalBackImg', 'prModalBackLabel', backUrl);
            setPartImage('prModalSpineImg', 'prModalSpineLabel', spineUrl);
            setPartImage('prModalFrontImg', 'prModalFrontLabel', frontUrl);

            var displayWrapUrl = (data.cover && data.cover.wrap) ? data.cover.wrap : '';
            var kdpExport = window.CoverKdpExport;
            if (frontUrl && kdpExport && typeof kdpExport.composePrintWrapFromParts === 'function') {
                setPrModalStatus('Calibrating spine to ' + pagesForCompose + ' pages (KDP)…');
                var composed = await kdpExport.composePrintWrapFromParts(frontUrl, spineUrl, backUrl, {
                    pageCount: pagesForCompose,
                    trimKey: trim,
                    paperType: spec.paperType === 'cream' ? 'Cream paper' : 'White paper',
                    title: bookPreviewContext.bookTitle || '',
                    author: bookPreviewContext.authorName || '',
                    synopsis: bookPreviewContext.description || '',
                    dpi: 300,
                    useApiSpineArt: false,
                    useApiBackArt: false
                });
                if (composed && composed.dataUrl) {
                    displayWrapUrl = composed.dataUrl;
                    if (kdpExport.persistComposedWrap) {
                        await kdpExport.persistComposedWrap(printReadyPendingBookId, composed.dataUrl, {
                            pageCount: composed.pageCount,
                            spineInches: composed.spineInches
                        });
                    }
                    if (data.kdp && composed.spineInches) {
                        data.kdp.spineInches = composed.spineInches;
                    }
                }
            }
            if (wrapImg && displayWrapUrl) {
                wrapImg.src = displayWrapUrl;
                wrapImg.style.opacity = '0';
                wrapImg.classList.remove('hidden');
                if (wrapPlaceholder) wrapPlaceholder.classList.add('hidden');
                requestAnimationFrame(function() { wrapImg.style.opacity = '1'; });
            } else if (wrapPlaceholder) {
                wrapPlaceholder.classList.remove('hidden');
            }
            if (data.cover) data.cover.wrap = displayWrapUrl || data.cover.wrap;

            if (data.pageCount) recalcPrintReadyModalMetrics({ pageCount: pagesForCompose });
            printReadyGenerated = data;
            if (prModalConfirmBtn) prModalConfirmBtn.disabled = false;
            setPrModalStatus('Cover set ready in ' + selectedStyle.tone + ' direction. Confirm to continue.');
            showToast('Print-ready cover set generated');
        } catch (err) {
            setPrModalStatus((err && err.message) ? err.message : 'Cover generation failed.', true);
            showToast((err && err.message) ? err.message : 'Cover generation failed');
        } finally {
            if (autoBtn) autoBtn.disabled = false;
            if (prModalWrapStage) prModalWrapStage.classList.remove('loading');
        }
    }

