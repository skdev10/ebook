                            sel.appendChild(opt);
                        }
                        sel.value = String(newBid);
                    }
                    bookPreviewContext.bookTitle = bookTitle || '';
                    formatterBookTitle = bookTitle || '';
                    syncFmtSelectedBookLabel(bookTitle);
                    syncFormatterSwitchBookLink(newBid);
                    try {
