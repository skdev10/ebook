        (function wireFmtModuleExports() {
            function readExportPayload() {
                var bid = resolveFormatterBookId();
                var fmtEl = document.getElementById('format-select');
                var sz = document.getElementById('text-size-select');
                var ls = document.getElementById('line-spacing-select');
                var style = document.getElementById('style-select');
                var accentEl = document.getElementById('fmt-preview-accent');
                var pageBg = '';
                try {
                    var shell = document.getElementById('paginatedReaderShell');
                    if (shell) {
                        var bg = getComputedStyle(shell).getPropertyValue('--page-bg') || '';
                        pageBg = String(bg).trim();
                    }
                } catch (_) { /* optional */ }
                return {
                    bookId: bid,
                    displayTitle: (bookPreviewContext && bookPreviewContext.bookTitle) || '',
                    displayAuthor: (bookPreviewContext && bookPreviewContext.authorName) || '',
                    bookFormat: (fmtEl && fmtEl.value) || 'Paperback',
                    publishingPlatform: 'Amazon KDP',
                    textSize: (sz && sz.value) || 'Medium',
                    lineSpacing: (ls && ls.value) || '1.6',
                    interiorStyle: (style && style.value) || 'Novel',
                    previewAccent: (accentEl && accentEl.value) || undefined,
                    pageBackgroundColor: pageBg || undefined
                };
            }
            async function runFmtExport(fmt, btn) {
                var bid = resolveFormatterBookId();
                if (!bid) { showToast('Select a book first.'); return; }
                if (!bookChapters.length) { showToast('Add manuscript or chapters before export.'); return; }
                if (btn) btn.disabled = true;
                setFormatterSaveStatus('Exporting…', false);
                try {
                    if (typeof window.fmtFlushFormattingForExport === 'function') {
                        await window.fmtFlushFormattingForExport();
                    }
                    if (!window.ModuleExport || typeof window.ModuleExport.postExport !== 'function') {
                        showToast('Export module not loaded.');
                        return;
                    }
                    var result = await window.ModuleExport.postExport(
                        '/Books/Export/' + bid + '?format=' + encodeURIComponent(fmt),
                        readExportPayload(),
                        'book-' + bid + (String(fmt).toLowerCase() === 'epub' ? '.epub' : '-print.pdf'));
                    if (!result.ok) {
                        setFormatterSaveStatus(result.message || 'Export failed.', true);
                        showToast(result.message || 'Export failed.');
                    } else {
                        setFormatterSaveStatus('Download started.', false);
                        showToast('Download started.');
                        if (window.EbookUnsavedGuard) window.EbookUnsavedGuard.markSaved();
                    }
                } catch (err) {
                    setFormatterSaveStatus('Export failed.', true);
                    showToast('Export failed.');
                } finally {
                    if (btn) btn.disabled = false;
                }
            }
            var pdfBtn = document.getElementById('fmt-btn-export-print-pdf');
            var epubBtn = document.getElementById('fmt-btn-export-epub');
            if (pdfBtn) pdfBtn.addEventListener('click', function () { runFmtExport('PrintPdf', pdfBtn); });
            if (epubBtn) epubBtn.addEventListener('click', function () { runFmtExport('Epub', epubBtn); });
        })();

        document.getElementById('fmt-btn-rename-chapter')?.addEventListener('click', function () { saveFormatterChapterName(); });

        document.getElementById('prModalAutoGenerate')?.addEventListener('click', function() { runPrintReadyModalAutoGenerate(); });
        document.getElementById('prModalCancel')?.addEventListener('click', function() { closePrintReadyModal(); });
        document.getElementById('prModalClose')?.addEventListener('click', function() { closePrintReadyModal(); });
        document.getElementById('prModalConfirm')?.addEventListener('click', function() {
            if (!printReadyPendingBookId) return;
            if (!printReadyGenerated) {
                showToast('Generate cover set first.');
                return;
            }
            window.location.href = printReadyNextUrl || ('/Dashboard/Publish?bookId=' + printReadyPendingBookId + '&flow=printready');
        });
        prModal?.addEventListener('click', function(e) {
            if (e.target === prModal) closePrintReadyModal();
        });

        document.getElementById('fmt-btn-studio-fix')?.addEventListener('click', function() {
            var panel = document.getElementById('fmt-actions-panel');
            var el = panel;
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        document.getElementById('fmt-btn-studio-preview')?.addEventListener('click', function() {
            var hid = document.getElementById('selected-book-id');
            var bid = parseInt((hid && hid.value) || '0', 10);
            if (bookChapters.length) {
                ensureReaderPages(true);
                currentPageIdx = Math.min(currentPageIdx, Math.max(0, readerPages.length - 1));
            }
            var fmtEl = document.getElementById('format-select');
            var fmt = (fmtEl && fmtEl.value) || 'Ebook';
            if (fmt === 'Both') renderBothPreviews(0); else renderPreviewContent(0);
            setFmtExportPreviewVisible(true);
            scheduleFmtExportPreviewReload(true);
            showToast('Export preview refreshed');
        });
        document.getElementById('fmt-btn-studio-next')?.addEventListener('click', function() {
            document.getElementById('btn-next-cover')?.click();
        });
        document.getElementById('text-size-select')?.addEventListener('change', function() {
            if (bookChapters.length) fmtScheduleRepaginateAfterLayout();
            persistFormatterDraftLocal(getFormatterStateFromUi());
            queueAutosave(250);
            scheduleFmtExportPreviewReload(false);
        });
        document.getElementById('line-spacing-select')?.addEventListener('change', function() {
            if (bookChapters.length) fmtScheduleRepaginateAfterLayout();
            persistFormatterDraftLocal(getFormatterStateFromUi());
            queueAutosave(250);
            scheduleFmtExportPreviewReload(false);
        });

        // Explicit reset only — back/normal navigation never shows this prompt.
        document.getElementById('fmt-btn-reset-formatting')?.addEventListener('click', function() {
            var doReset = function() {
                var styleSel = document.getElementById('style-select');
                var sizeSel = document.getElementById('text-size-select');
                var lineSel = document.getElementById('line-spacing-select');
                if (styleSel) { styleSel.value = 'ElegantTrade'; styleSel.dispatchEvent(new Event('change', { bubbles: true })); }
                if (sizeSel) { sizeSel.value = 'Medium'; sizeSel.dispatchEvent(new Event('change', { bubbles: true })); }
                if (lineSel) { lineSel.value = '1.6'; lineSel.dispatchEvent(new Event('change', { bubbles: true })); }
                syncFmtInteriorCardsFromSelect();
                syncFmtTypographyPillsFromSelects();
                showToast('Formatting reset to defaults.');
            };
            if (window.Swal) {
                Swal.fire({
                    title: 'Keep writing or reset your work?',
                    text: 'Reset returns Interior style, Text size, and Line spacing to their defaults. Your chapters are not touched.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Reset my work',
                    cancelButtonText: 'Keep writing',
                    confirmButtonColor: '#7c3aed',
                    focusCancel: true
                }).then(function(r) { if (r.isConfirmed) doReset(); });
            } else if (window.confirm('Keep writing or reset your work? OK resets formatting options to their defaults.')) {
                doReset();
            }
        });

        window.addEventListener('beforeunload', function() {
            persistFormatterDraftLocal(getFormatterStateFromUi());
        });

        if (window.EbookUnsavedGuard) {
            window.EbookUnsavedGuard.setContext('Book Formatting');
            window.EbookUnsavedGuard.setPendingSaveHandler(function () {
                return new Promise(function (resolve) {
                    saveFormatting(function (ok) { resolve(!!ok); }, { silent: true });
                });
            });
        }

        (function bindFmtStudioChrome() {
            var cards = document.getElementById('fmt-interior-cards');
            var styleSel = document.getElementById('style-select');
            if (cards && styleSel) {
                cards.addEventListener('click', function(e) {
                    var btn = e.target && e.target.closest ? e.target.closest('.fmt-int-card') : null;
                    if (!btn) return;
                    var v = btn.getAttribute('data-style');
                    if (!v) return;
                    styleSel.value = v;
                    syncFmtInteriorCardsFromSelect();
                    styleSel.dispatchEvent(new Event('change', { bubbles: true }));
                });
            }
            var rowS = document.getElementById('fmt-text-size-pills');
            var selS = document.getElementById('text-size-select');
            if (rowS && selS) {
                rowS.addEventListener('click', function(e) {
                    var p = e.target && e.target.closest ? e.target.closest('.fmt-pill[data-size]') : null;
                    if (!p) return;
                    selS.value = p.getAttribute('data-size') || 'Medium';
                    syncFmtTypographyPillsFromSelects();
                    selS.dispatchEvent(new Event('change', { bubbles: true }));
                });
            }
            var rowL = document.getElementById('fmt-line-pills');
            var selL = document.getElementById('line-spacing-select');
            if (rowL && selL) {
                rowL.addEventListener('click', function(e) {
                    var p = e.target && e.target.closest ? e.target.closest('.fmt-pill[data-line]') : null;
                    if (!p) return;
                    selL.value = p.getAttribute('data-line') || '1.6';
                    syncFmtTypographyPillsFromSelects();
                    selL.dispatchEvent(new Event('change', { bubbles: true }));
                });
            }
            var accent = document.getElementById('fmt-preview-accent');
            if (accent) {
                accent.addEventListener('input', function() {
                    applyFmtStudioAccent();
                    persistFormatterDraftLocal(getFormatterStateFromUi());
                    queueAutosave(250);
                });
            }
            syncFmtInteriorCardsFromSelect();
            syncFmtTypographyPillsFromSelects();
            applyFmtStudioAccent();
            applyInteriorStyleClasses((styleSel && styleSel.value) || 'Novel');
        })();

        var fmtResizeTimer = null;
        window.addEventListener('resize', function() {
            if (fmtResizeTimer) clearTimeout(fmtResizeTimer);
            fmtResizeTimer = setTimeout(function() {
                fmtResizeTimer = null;
                syncFmtPreviewLayout();
                if (bookChapters.length) fmtScheduleRepaginate();
            }, 180);
        });

        FmtBookStageReader.ensureDom();
        wireFormatterTocLinks();
        wireFormatterBookSelect();
        syncInteriorTokenVars();
        window.addEventListener('load', function onFormatterBoot() {
            window.removeEventListener('load', onFormatterBoot);
            requestAnimationFrame(function() {
                syncInteriorTokenVars();
                syncFmtPreviewLayout();
                initBookInteriorPreviewShell();
                initFormatterBook().then(function() {
                    syncFmtPreviewLayout();
                    if (bookChapters.length) {
                        ensureReaderPages(true);
                        renderPreviewContent(0);
                    }
                }).catch(function(err) {
                    console.warn('[Book Formatter] initFormatterBook failed:', err);
                });
            });
        });
    });
})();
