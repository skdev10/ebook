        margin-top: 0.35rem;
    }
    .pr-cover-wrap {
        border: 1px solid #e2e8f0;
        border-radius: 0.82rem;
        overflow: hidden;
        min-height: 280px;
        background:
            radial-gradient(circle at 12% 22%, rgba(99, 102, 241, 0.16), transparent 48%),
            radial-gradient(circle at 88% 24%, rgba(16, 185, 129, 0.12), transparent 46%),
            linear-gradient(160deg, #f8fafc 0%, #eef2ff 52%, #f8fafc 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        perspective: 1200px;
    }
    .pr-cover-wrap::before {
        content: "";
        position: absolute;
        width: 78%;
        height: 76%;
        border-radius: 0.85rem;
        box-shadow: 0 36px 44px -28px rgba(15, 23, 42, 0.45);
        transform: translateY(14px) rotateX(16deg);
        background: rgba(15, 23, 42, 0.15);
        filter: blur(10px);
        pointer-events: none;
    }
    .pr-cover-wrap.loading::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.66) 48%, rgba(255,255,255,0) 100%);
        animation: prShimmer 1.2s ease-in-out infinite;
        pointer-events: none;
    }
    .pr-cover-wrap img {
        width: 88%;
        height: 84%;
        object-fit: contain;
        display: block;
        border-radius: 0.72rem;
        box-shadow: 0 26px 46px -24px rgba(15, 23, 42, 0.55);
        transform: rotateY(-8deg) rotateX(2deg);
        transition: transform 0.25s ease, opacity 0.2s ease;
    }
    .pr-cover-wrap img:hover {
        transform: rotateY(-4deg) rotateX(1deg) translateY(-1px);
    }
    .pr-cover-parts {
        margin-top: 0.6rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.45rem;
    }
    .pr-cover-part {
        border: 1px solid #e2e8f0;
        border-radius: 0.6rem;
        min-height: 102px;
        background: linear-gradient(170deg, #ffffff 0%, #f8fafc 100%);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        color: #64748b;
    }
    .pr-cover-part img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pr-modal-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.85rem 1rem;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
    }
    @@keyframes prShimmer {
        from { transform: translateX(-100%); }
        to { transform: translateX(100%); }
    }
    @@media (max-width: 1024px) {
        .pr-modal-body { grid-template-columns: 1fr; }
        .pr-cover-parts { grid-template-columns: 1fr; }
        .pr-modal-shell { width: min(1200px, 96vw); }
        .pr-cover-wrap { min-height: 240px; }
    }
    .formatter-loading-spinner {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        padding: 12px 20px; color: #6b21a8; font-size: 14px; font-weight: 500;
    }
    .formatter-loading-spinner .spinner {
        width: 24px; height: 24px; border: 2px solid #e9d5ff; border-top-color: #7c3aed;
        border-radius: 50%; animation: formatter-spin 0.8s linear infinite;
    }
    @@keyframes formatter-spin { to { transform: rotate(360deg); } }
    .preview-state-message { padding: 1.5rem; text-align: center; color: #6b7280; }
    .preview-state-error { color: #b91c1c; }
    .preview-panel-single { display: block !important; }
    .preview-panel-single.hidden { display: none !important; }
    .preview-panel-both .preview-split { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; min-height: 0; height: 100%; }
    .preview-panel-both .preview-split .preview-half { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; background: #fff; }
    .config-card {
        border: 1px solid #e9d5ff;
