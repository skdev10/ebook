        display: none !important;
    }
    #preview-both .reader-nav-bar.fmt-reader-nav-dock.fmt-reader-nav-dock-show {
        position: relative;
        bottom: auto;
        z-index: 8;
        padding-top: 0.75rem;
        background: linear-gradient(to top, #fafaf9 72%, rgba(250, 250, 249, 0.94) 90%, transparent);
        border-top: 1px solid rgba(196, 181, 253, 0.5);
        box-shadow: 0 -8px 24px -14px rgba(91, 33, 182, 0.12);
    }
    .reader-nav-bar.reader-dark { border-top-color: #374151; }
    .reader-nav-btn {
        min-width: 100px;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.15s ease;
    }
    .reader-nav-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .reader-nav-btn:not(:disabled):hover { transform: translateY(-1px); }
    .reader-page-indicator { font-size: 0.8125rem; color: #6b7280; }
    .reader-page-indicator.reader-dark { color: #9ca3af; }
    .reader-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 0;
        margin-bottom: 0.5rem;
        flex-shrink: 0;
    }
    .reader-toolbar.reader-dark { border-bottom: 1px solid #374151; }
    /* Dual preview: fill fixed studio column (no arbitrary 360px jump vs single mode) */
    .preview-panel-both .preview-split {
        height: 100%;
        min-height: 0;
        max-height: 100%;
    }
    .preview-panel-both .preview-half {
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    .reader-retry-btn { margin-top: 0.75rem; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.875rem; background: #7c3aed; color: #fff; border: none; cursor: pointer; }
    .reader-retry-btn:hover { background: #6d28d9; }

    /* ----- Book content protection: no copy, no selection ----- */
    #fmt-preview-scroll-host .chapter-preview-viewport,
    #fmt-preview-scroll-host #preview-content,
    #fmt-preview-scroll-host #preview-content-ebook,
    #fmt-preview-scroll-host #preview-content-paperback,
    #fmt-preview-scroll-host .reader-page-body {
        box-sizing: border-box;
        width: 100%;
        max-width: 100%;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
    }
    #fmt-preview-scroll-host .book-page-content .reader-page-body {
        padding: 0;
        margin: 0;
        pointer-events: none;
    }
    #fmt-preview-scroll-host .reader-nav-btn,
    #fmt-preview-scroll-host .ai-writer-preview-side-nav {
        pointer-events: auto;
    }

    #fmt-preview-scroll-host .premium-format-ui-only { display: none !important; }
    .format-premium-banner {
        display: none;
        align-items: center;
        gap: 10px;
        margin-top: 10px;
        padding: 10px 14px;
