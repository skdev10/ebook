        (function initManuscriptUpload() {
            var dropzone = document.getElementById('fmt-ms-dropzone');
            var fileInput = document.getElementById('fmt-ms-file');
            var uploadBtn = document.getElementById('fmt-ms-upload-btn');
            var statusEl = document.getElementById('fmt-ms-status');
            var lastEl = document.getElementById('fmt-ms-last');
            if (!fileInput || !uploadBtn) return;

            function setMsStatus(msg, ok) {
                if (!statusEl) return;
                statusEl.textContent = msg || '';
                statusEl.className = 'text-xs min-h-[1.1rem] mt-0.5 mb-0 leading-snug truncate ' +
                    (msg ? (ok ? 'text-emerald-600' : 'text-red-600') : 'text-gray-400');
            }

            function currentBookId() {
                var root = document.getElementById('book-formatter-root');
                var fromRoot = root ? parseInt(root.getAttribute('data-book-id') || '0', 10) : 0;
                if (fromRoot > 0) return fromRoot;
                var hid = document.getElementById('selected-book-id');
                var fromHid = hid ? parseInt(hid.value || '0', 10) : 0;
                if (fromHid > 0) return fromHid;
                return typeof bookId !== 'undefined' ? (parseInt(bookId, 10) || 0) : 0;
            }

            async function uploadManuscriptFile(file) {
                var bid = currentBookId();
                if (!file) {
                    setMsStatus('Select a file to upload.', false);
                    return;
                }
                if (!/\.(docx|pdf|txt|md|markdown)$/i.test(file.name || '')) {
                    setMsStatus('Allowed: DOCX or PDF (also TXT/MD).', false);
                    return;
                }
                setMsStatus(bid <= 0 ? 'Creating book and importing…' : 'Uploading and parsing…', true);
                uploadBtn.disabled = true;
                try {
                    var fd = new FormData();
                    fd.append('file', file);
                    fd.append('bookId', String(bid > 0 ? bid : 0));
                    var res = await fetch('/Books/UploadManuscript' + (bid > 0 ? ('/' + bid) : ''), {
                        method: 'POST',
                        body: fd,
                        credentials: 'same-origin'
                    });
                    var data = await res.json().catch(function () { return null; });
                    if (!res.ok || !data || !data.success) {
                        setMsStatus((data && data.message) || 'Upload failed.', false);
                        return;
                    }
                    var newBid = parseInt(data.bookId, 10) || bid;
                    if (newBid > 0 && newBid !== bid) {
                        try {
                            var url = new URL(window.location.href);
                            url.searchParams.set('bookId', String(newBid));
                            window.location.href = url.toString();
