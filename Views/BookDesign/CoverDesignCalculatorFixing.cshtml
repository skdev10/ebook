        if (Math.abs(w - 5.5) < 0.11 && Math.abs(h - 8.5) < 0.11) return '5.5x8.5';
        if (Math.abs(w - 8.5) < 0.11 && Math.abs(h - 11) < 0.11) return '8.5x11';
        return '6x9';
    }

    function trimValueToDims(v) {
        if (v === '6x9') return { w: 6.0, h: 9.0 };
        if (v === '5.5x8.5') return { w: 5.5, h: 8.5 };
        if (v === '8.5x11') return { w: 8.5, h: 11.0 };
        return { w: printReadyConfig.defaultTrimW, h: printReadyConfig.defaultTrimH };
    }

