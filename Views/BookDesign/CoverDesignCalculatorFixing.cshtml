        font-family: 'Lato', sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        color: #94a3b8;
    }
    #book-formatter-root .book-page-footer-elegant {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: 0.78rem;
        font-style: italic;
        color: #6b5b4f;
    }
    #book-formatter-root .book-page-footer-novel {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 0.78rem;
        color: #78716c;
    }
    #book-formatter-root .book-page-background.interior-traditional-novel {
        background: linear-gradient(180deg, #fffef9 0%, #faf8f2 100%);
    }
    #book-formatter-root .book-page-background.interior-contemporary-modern {
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        border-left: 3px solid #e2e8f0;
    }
    #book-formatter-root .book-page-background.interior-finebook-classic {
        background: #fdfcf8 url("data:image/svg+xml,%3Csvg width='40' height='40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 40L40 0' stroke='%23ebe6dc' stroke-width='0.5' fill='none'/%3E%3C/svg%3E");
    }
    #book-formatter-root .book-page-background.interior-minimalist-clean {
        background: #ffffff;
        box-shadow: inset 0 0 0 1px #f1f5f9;
    }
    #book-formatter-root .book-page-background.interior-pod-elegant {
        background: linear-gradient(165deg, #fffef8 0%, #f9f5ee 55%, #fffef8 100%);
        box-shadow: inset 0 0 0 1px rgba(201, 184, 160, 0.25);
    }
    @@media (max-width: 640px) {
        #book-formatter-root .book-page-content-wrap {
            padding: 6px 12px 10px;
        }
        #book-formatter-root .fmt-float-nav {
            width: 36px;
            height: 36px;
        }
    }
    #fmt-preview-measure-host.preview-measure-host {
        position: absolute;
        left: -9999px;
        top: 0;
        visibility: hidden;
        pointer-events: none;
        overflow: visible;
        box-sizing: border-box;
        padding: 0;
    }
    /* Measurement must be content-driven: drop the 6/9 box + fixed height so a short
       page is not pinned to the full box height (which caused ~1 paragraph per page). */
    #fmt-preview-measure-host .paginated-reader-shell {
        aspect-ratio: auto !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        max-width: none !important;
        width: 100% !important;
        display: block !important;
        border: 0 !important;
        box-shadow: none !important;
        padding: 0 !important;
    }
    #fmt-preview-measure-host .chapter-preview-viewport.book-page-preview-content {
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        overflow: visible !important;
    }
    .fmt-chapter-nav-below {
        border-top: 1px solid rgba(196, 181, 253, 0.35);
        padding-top: 0.5rem;
    }
    /* Full-book read strip: fixed footprint (shrink-0), does not change .fmt-studio-stage outer height */
    .fmt-fullbook-read-bar {
        flex-shrink: 0;
        display: none;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        padding: 0.45rem 0.65rem;
        margin-bottom: 0.5rem;
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid rgba(196, 181, 253, 0.7);
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(91, 33, 182, 0.08);
    }
    .fmt-fullbook-read-bar.is-visible { display: flex; }
    /* Keep full-book Previous/Next dock at the bottom of preview card */
    #fmt-book-result #fmt-fullbook-read-bar {
        order: 3;
        margin-top: auto;
        margin-bottom: 0;
        align-self: stretch;
    }
    #fmt-book-result #fmt-preview-scroll-host { order: 2; }
    .fmt-fullbook-read-bar .fmt-read-page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.55rem 1rem;
        border-radius: 0.75rem;
        font-size: 0.875rem;
        font-weight: 600;
        border: 2px solid #e2e8f0;
        background: #fff;
        color: #334155;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
    }
    .fmt-fullbook-read-bar .fmt-read-page-btn:hover:not(:disabled) {
        background: #faf5ff;
        border-color: #c4b5fd;
        color: #5b21b6;
    }
    .fmt-fullbook-read-bar .fmt-read-page-btn:disabled {
        opacity: 0.4;
        pointer-events: none;
    }
    .fmt-fullbook-read-bar #fmt-read-page-summary {
        font-size: 0.8125rem;
        font-weight: 600;
        color: #475569;
        text-align: center;
        min-width: 10rem;
        max-width: min(100%, 22rem);
        line-height: 1.35;
    }
    #preview-both .reader-nav-bar {
        position: relative;
        z-index: 6;
        background: #fff;
    }
    /* AI Writer `#bookResult` lavender card */
    .fmt-book-result {
        box-sizing: border-box;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    }
    /*
     * Preview card height floor: without this, flex-1 + min-h-0 ancestors can shrink the reader to a strip
     * and chapter text looks "compressed" or clipped. Single-mode scroll: `#preview-content`; dual: `#reader-wrap-ebook` / `#reader-wrap-paperback`.
     */
    #fmt-book-result.fmt-book-result {
        flex: 1 1 0%;
        min-height: clamp(20rem, 42dvh, 36rem);
        height: auto;
        width: 100%;
        max-width: 100%;
        display: flex;
        flex-direction: column;
    }
    @@media (min-width: 640px) {
        #fmt-book-result.fmt-book-result { min-height: clamp(32rem, 60dvh, 46rem); }
    }
    @@media (min-width: 1024px) {
        #fmt-book-result.fmt-book-result { min-height: 0; height: 100%; }
    }
    @@media (min-width: 1280px) {
        #fmt-book-result.fmt-book-result { min-height: 0; height: 100%; }
    }
    /* AI Writer `.chapter-preview-scroll-host` */
    .fmt-chapter-preview-scroll-host {
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
    }
    #fmt-book-result .fmt-chapter-preview-scroll-host {
        flex: 1 1 0%;
        min-height: 0;
        height: 100%;
    }
    /* Flex column between chrome + preview-wrapper; min height guarantees space for inner scroll region */
    #fmt-preview-scroll-host {
        flex: 1 1 0%;
        min-width: 0;
        min-height: 0;
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    /*
     * Manuscript strip: grows with chapter HTML (no nested scroll). Matches AI Writer leaving scroll on the outer viewport.
     */
    /* AI Writer `.chapter-read-progress` in bottom dock */
    .fmt-chapter-read-progress {
        height: 6px;
        border-radius: 9999px;
        background: rgba(148, 163, 184, 0.35);
        overflow: hidden;
        margin: 0 auto 0.15rem auto;
    }
    .fmt-chapter-read-progress-fill {
        height: 100%;
        width: 0%;
        border-radius: inherit;
        background: linear-gradient(90deg, #7c3aed, #a78bfa);
        transition: width 0.35s ease;
    }
    /* AI Writer `#chapterPreviewNav.chapter-reader-nav-dock` */
    #preview-both .reader-nav-bar.fmt-reader-nav-dock {
        flex-shrink: 0;
    }
    #reader-chapter-jump {
        flex: 1;
        min-width: 160px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 8px 2.25rem 8px 10px;
        font-size: 13px;
        background-color: #fff;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='%239CA3AF' stroke-width='2'%3e%3cpath stroke-linecap='round' stroke-linejoin='round' d='M19 9l-7 7-7-7'/%3e%3c/svg%3e");
        background-position: right 0.6rem center;
        background-repeat: no-repeat;
        background-size: 1rem;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
    }
    #reader-bookmark-btn {
        border: 1px solid #c4b5fd;
        background: #fff;
        color: #5b21b6;
        font-size: 12px;
        font-weight: 600;
        padding: 8px 14px;
        border-radius: 10px;
        cursor: pointer;
        transition: background 0.15s ease, transform 0.15s ease;
    }
    #reader-bookmark-btn:hover { background: #f5f3ff; transform: translateY(-1px); }
    .reader-page-inner.reader-anim-out { opacity: 0; transform: translateX(12px); }
    .reader-page-inner.reader-anim-in { opacity: 1; transform: translateX(0); transition: opacity 0.28s ease, transform 0.32s ease; }
    .chapter-preview-nav {
        flex: 0 0 auto;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    /* ===== Match AI Book Writer preview exactly ===== */
    #fmt-right-preview-column .fmt-preview-stack {
        max-width: min(100%, 42rem) !important;
        width: 100% !important;
        margin-inline: 0 !important;
        margin-right: auto !important;
    }

    @@media (min-width: 1024px) {
        #book-formatter-root #fmt-right-preview-column #fmt-studio-stage.fmt-studio-stage {
            max-width: min(100%, 42rem) !important;
        }
    }

    #fmt-studio-stage.fmt-studio-stage {
        max-width: min(100%, 42rem) !important;
    }

    #fmt-book-result.fmt-book-result {
        width: min(100%, 42rem) !important;
        max-width: 100% !important;
    }
    @@media (min-width: 1024px) {
        #fmt-book-result.fmt-book-result { min-height: 0 !important; height: 100% !important; }
    }

    #fmt-book-result .paginated-reader-shell {
        width: 100% !important;
        max-width: min(100%, 36rem) !important;
        margin-left: auto !important;
        margin-right: auto !important;
        aspect-ratio: 6 / 9 !important;
        min-height: 0 !important;
        height: auto !important;
    }

    #fmt-book-result #preview-content.chapter-preview-viewport,
    #fmt-book-result #preview-content-ebook.chapter-preview-viewport,
    #fmt-book-result #preview-content-paperback.chapter-preview-viewport {
        padding: 1.5rem !important;
    }
</style>

@{
    var formatFromUrl = Model?.Format ?? "Ebook";
    if (formatFromUrl == "Print") { formatFromUrl = "Paperback"; }
    var uid = (Model?.UserId ?? 0) != 0 ? Model.UserId : (ViewBag.UserId ?? 0);
    var prWhite = ViewBag.PrintReadyWhitePaperMultiplier as double? ?? 0.002252;
    var prCream = ViewBag.PrintReadyCreamPaperMultiplier as double? ?? 0.002500;
    var prColor = ViewBag.PrintReadyColorPaperMultiplier as double? ?? 0.002347;
    var prBleed = ViewBag.PrintReadyBleedInches as double? ?? 0.125;
    var prTrimW = ViewBag.PrintReadyDefaultTrimWidthInches as double? ?? 6.0;
    var prTrimH = ViewBag.PrintReadyDefaultTrimHeightInches as double? ?? 9.0;
}
<div class="bg-[#f5f7f9] min-h-full flex text-slate-900 flex-1 antialiased" id="book-formatter-root" data-user-id="@uid" data-book-id="@bookId" data-format="@formatFromUrl" data-pr-white="@prWhite.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pr-cream="@prCream.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pr-color="@prColor.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pr-bleed="@prBleed.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pr-trim-w="@prTrimW.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pr-trim-h="@prTrimH.ToString(System.Globalization.CultureInfo.InvariantCulture)">
@Html.AntiForgeryToken()
    <main class="flex-1 overflow-y-auto p-8 lg:p-12 pb-16 lg:pb-24">
        <div class="max-w-[1600px] mx-auto w-full">
            <div class="fmt-main-layout flex flex-col lg:flex-row gap-8 lg:gap-10">
                <!-- Left: AI Book Formatter (your design) -->
                <div id="fmt-left-config-column" class="w-full lg:w-[480px] flex-shrink-0 flex flex-col">
                    <h1 class="font-serif text-3xl font-medium text-gray-900 mb-3 tracking-tight">AI Book Formatter</h1>
                    <div class="mb-8">
                        <label for="formatter-display-author" class="block text-xs font-semibold text-gray-500 mb-2.5">Author (matches your account &amp; export)</label>
                        <div id="formatter-display-author" class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3.5 text-sm font-medium text-gray-900 min-h-[2.75rem] flex items-center" role="status">@((ViewBag.DisplayAuthorName as string) ?? "")</div>
                    </div>
                    <p class="text-sm text-gray-500 mb-8">Select or generate a book in <a href="/Books/AIGenerateBook" class="text-violet-700 hover:underline font-medium">AI Writer</a>, then click <strong>Book formatting</strong> — your manuscript preview loads on the right.</p>
                    <div class="space-y-6 flex-1 overflow-y-auto pr-2 pb-20">
                        <input type="hidden" id="selected-book-id" value="@bookId" />

                        <div class="group">
                            <label class="block text-xs font-semibold text-gray-500 mb-2.5" id="format-field-label">What format will your book be?</label>
                            <div class="relative format-select-wrap" id="format-select-wrap">
                                <select id="format-select" class="sr-only" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;" aria-labelledby="format-field-label" title="Book format">
                                    @if (formatFromUrl == "Ebook") { <option value="Ebook" selected>Ebook</option> } else { <option value="Ebook">Ebook</option> }
                                    @if (formatFromUrl == "Paperback") { <option value="Paperback" selected>Paperback</option> } else { <option value="Paperback">Paperback</option> }
                                    @if (formatFromUrl == "Both") { <option value="Both" selected>Both (Ebook + Paperback)</option> } else { <option value="Both">Both (Ebook + Paperback)</option> }
                                </select>
                                <button type="button" id="format-picker-trigger" class="format-picker-trigger w-full bg-white border border-gray-100 hover:border-gray-200 text-gray-700 rounded-xl py-3.5 pl-4 pr-4 text-sm cursor-pointer shadow-sm text-left flex items-center justify-between gap-2" aria-expanded="false" aria-haspopup="listbox" title="Choose format — Both is a premium dual-layout option">
                                    <span id="format-picker-label" class="truncate font-medium">Ebook</span>
                                    <i class="fas fa-chevron-down text-gray-400 text-xs shrink-0 transition-transform" id="format-picker-chevron" aria-hidden="true"></i>
                                </button>
                                <div id="format-picker-menu" class="format-picker-menu hidden absolute left-0 right-0 z-50 mt-1 bg-white border border-gray-200 rounded-xl shadow-xl py-1" role="listbox" aria-label="Format options">
                                    <button type="button" class="format-picker-item w-full px-4 py-3 text-left text-sm text-gray-700 hover:bg-violet-50" role="option" data-value="Ebook">Ebook</button>
                                    <button type="button" class="format-picker-item w-full px-4 py-3 text-left text-sm text-gray-700 hover:bg-violet-50" role="option" data-value="Paperback">Paperback</button>
                                    <button type="button" class="format-picker-item format-picker-item-premium w-full px-4 py-3 text-left text-sm hover:bg-amber-50/90 border-t border-amber-100 flex items-center gap-2 flex-wrap" role="option" data-value="Both">
                                        <span class="text-lg leading-none" aria-hidden="true">&#x1F451;</span>
                                        <span class="font-semibold text-gray-800">Both (Ebook + Paperback)</span>
                                        <span class="text-[10px] font-extrabold uppercase tracking-wider text-amber-950 bg-amber-300 px-2.5 py-1 rounded-lg">Premium</span>
                                    </button>
                                </div>
                            </div>
                            <input type="hidden" id="hiddenCoverFormat" name="CoverFormat" value="@(string.Equals(Model?.Format, "Paperback", StringComparison.OrdinalIgnoreCase) ? "printready" : string.Equals(Model?.Format, "Both", StringComparison.OrdinalIgnoreCase) ? "ebook_paperback" : "ebook")" />
                            <div class="format-premium-banner premium-format-ui-only" id="format-premium-banner" role="status">
                                <span class="premium-crown" aria-hidden="true">&#x1F451;</span>
                                <span><strong>Premium format selected.</strong> Dual ebook + print workspace is active. Your preview below stays a normal reader view (no premium badges there). This is saved with your book.</span>
                            </div>
                        </div>

                        <div class="group" data-guided-tour="fmt-style">
                            <label class="block text-xs font-semibold text-gray-500 mb-2.5">Interior style</label>
                            <select id="style-select" class="sr-only" tabindex="-1" aria-hidden="true" title="Interior style">
                                @if ((Model?.InteriorStyle ?? "Novel") == "Novel") { <option value="Novel" selected>Novel</option> } else { <option value="Novel">Novel</option> }
                                @if ((Model?.InteriorStyle ?? "") == "Modern") { <option value="Modern" selected>Modern</option> } else { <option value="Modern">Modern</option> }
                                @if ((Model?.InteriorStyle ?? "") == "Classic") { <option value="Classic" selected>Classic</option> } else { <option value="Classic">Classic</option> }
                                @if ((Model?.InteriorStyle ?? "") == "Minimalist") { <option value="Minimalist" selected>Minimalist</option> } else { <option value="Minimalist">Minimalist</option> }
                                @if ((Model?.InteriorStyle ?? "") == "ElegantTrade") { <option value="ElegantTrade" selected>Elegant trade (POD)</option> } else { <option value="ElegantTrade">Elegant trade (POD)</option> }
                            </select>
                            <div id="fmt-interior-cards" class="grid grid-cols-2 sm:grid-cols-3 gap-2" role="group" aria-label="Interior style">
                                <button type="button" class="fmt-int-card" data-style="Novel"><span class="fmt-int-card__badge">Traditional</span><span class="fmt-int-card__name">Novel</span></button>
                                <button type="button" class="fmt-int-card" data-style="Modern"><span class="fmt-int-card__badge">Contemporary</span><span class="fmt-int-card__name">Modern</span></button>
                                <button type="button" class="fmt-int-card" data-style="Classic"><span class="fmt-int-card__badge">Fine book</span><span class="fmt-int-card__name">Classic</span></button>
                                <button type="button" class="fmt-int-card" data-style="Minimalist"><span class="fmt-int-card__badge">Clean</span><span class="fmt-int-card__name">Minimalist</span></button>
                                <button type="button" class="fmt-int-card" data-style="ElegantTrade"><span class="fmt-int-card__badge">POD</span><span class="fmt-int-card__name">Elegant trade</span></button>
                            </div>
                        </div>

                        <div class="group">
                            <label class="block text-xs font-semibold text-gray-500 mb-2.5">Text size</label>
                            <select id="text-size-select" class="sr-only" tabindex="-1" aria-hidden="true">
                                @if ((Model?.TextSize ?? "Medium") == "Small") { <option value="Small" selected>Small</option> } else { <option value="Small">Small</option> }
                                @if ((Model?.TextSize ?? "Medium") == "Medium") { <option value="Medium" selected>Medium</option> } else { <option value="Medium">Medium</option> }
                                @if ((Model?.TextSize ?? "") == "Large") { <option value="Large" selected>Large</option> } else { <option value="Large">Large</option> }
                            </select>
                            <div id="fmt-text-size-pills" class="fmt-pill-row" role="group" aria-label="Text size">
                                <button type="button" class="fmt-pill" data-size="Small">Small</button>
                                <button type="button" class="fmt-pill" data-size="Medium">Medium</button>
                                <button type="button" class="fmt-pill" data-size="Large">Large</button>
                            </div>
                        </div>

                        <div class="group">
                            <label class="block text-xs font-semibold text-gray-500 mb-2.5">Line spacing</label>
                            <select id="line-spacing-select" class="sr-only" tabindex="-1" aria-hidden="true">
                                @{ var ls = Model?.LineSpacing ?? "1.6"; }
                                @if (ls == "1.4") { <option value="1.4" selected>1.4</option> } else { <option value="1.4">1.4</option> }
                                @if (ls == "1.6") { <option value="1.6" selected>1.6</option> } else { <option value="1.6">1.6</option> }
                                @if (ls == "1.8") { <option value="1.8" selected>1.8</option> } else { <option value="1.8">1.8</option> }
                                @if (ls == "2") { <option value="2" selected>2</option> } else { <option value="2">2</option> }
                            </select>
                            <div id="fmt-line-pills" class="fmt-pill-row" role="group" aria-label="Line spacing">
                                <button type="button" class="fmt-pill" data-line="1.4">Tight 1.4</button>
                                <button type="button" class="fmt-pill" data-line="1.6">Normal 1.6</button>
                                <button type="button" class="fmt-pill" data-line="1.8">Relaxed 1.8</button>
                                <button type="button" class="fmt-pill" data-line="2">Loose 2</button>
                            </div>
                        </div>

                        @* <div class="group">
                            <label for="fmt-preview-accent" class="block text-xs font-semibold text-gray-500 mb-2.5">Preview accent</label>
                            <p class="text-xs text-gray-400 mb-2">Tints the studio cover mock and borders (saved in your formatting draft).</p>
                            <div class="fmt-accent-wrap">
                                <input type="color" id="fmt-preview-accent" value="#5b21b6" title="Accent color" />
                                <span class="text-xs text-gray-500">Violet theme default — pick any hue for your mock cover.</span>
                            </div>
                        </div> *@

                        <div>
                            <label class="block text-xs font-semibold text-gray-500 mb-2.5">Publishing Platforms</label>
                            <p class="text-xs text-gray-400 mb-2">Select where you plan to publish.</p>
                            <div class="bg-white border border-gray-100 rounded-xl overflow-hidden shadow-sm" id="platforms-container">
                                <div class="platform-block border-b border-gray-50">
                                    <label class="platform-row flex items-start gap-3 p-4 cursor-pointer hover:bg-gray-50 transition-colors">
                                        <input type="checkbox" class="platform-check mt-1 rounded border-gray-300 text-purple-600 focus:ring-purple-500 shrink-0" data-platform="Amazon KDP" />
                                        <span class="text-sm flex-1">Amazon Kindle Publishing (KDP)</span>
                                    </label>
                                </div>
                                <div class="platform-block border-b border-gray-50">
                                    <label class="platform-row flex items-start gap-3 p-4 cursor-pointer hover:bg-gray-50 transition-colors">
                                        <input type="checkbox" class="platform-check mt-1 rounded border-gray-300 text-purple-600 focus:ring-purple-500 shrink-0" data-platform="IngramSpark" />
                                        <span class="text-sm flex-1">IngramSpark</span>
                                    </label>
                                </div>
                                <div class="platform-block border-b border-gray-50">
                                    <label class="platform-row flex items-start gap-3 p-4 cursor-pointer hover:bg-gray-50 transition-colors">
                                        <input type="checkbox" class="platform-check mt-1 rounded border-gray-300 text-purple-600 focus:ring-purple-500 shrink-0" data-platform="Barnes & Noble" />
                                        <span class="text-sm flex-1">Barnes &amp; Noble Press</span>
                                    </label>
                                </div>
                                <div class="platform-block">
                                    <label class="platform-row flex items-start gap-3 p-4 cursor-pointer hover:bg-gray-50 transition-colors">
                                        <input type="checkbox" class="platform-check mt-1 rounded border-gray-300 text-purple-600 focus:ring-purple-500 shrink-0" data-platform="Just Print Ready File" />
                                        <span class="text-sm flex-1">Just print-ready file</span>
                                    </label>
                                </div>
                            </div>
