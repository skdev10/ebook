    function setReaderNavDisabled(prevDisabled, nextDisabled) {
        const prevSide = document.getElementById('btnAiWriterPrevSide');
        const nextSide = document.getElementById('btnAiWriterNextSide');
        var prevRead = document.getElementById('fmt-btn-read-prev-page');
        var nextRead = document.getElementById('fmt-btn-read-next-page');
        [prevSide, prevRead].forEach(function(btn) { if (btn) btn.disabled = prevDisabled; });
        [nextSide, nextRead].forEach(function(btn) { if (btn) btn.disabled = nextDisabled; });
    }

    function showErrorState(msg, userFriendly, retryBookId) {
        const text = userFriendly != null ? userFriendly : (msg || PREVIEW_ERROR_MSG);
        let html = '<p class="preview-state-message preview-state-error">' + escapeHtml(text) + '</p>';
        if (retryBookId) html += '<p class="preview-state-message"><button type="button" class="reader-retry-btn" data-retry-id="' + retryBookId + '">Try again</button></p>';
        const inner = document.getElementById('preview-content');
        const ebook = document.getElementById('preview-content-ebook');
        const paperback = document.getElementById('preview-content-paperback');
        if (inner) inner.innerHTML = html;
        if (ebook) ebook.innerHTML = html;
        if (paperback) paperback.innerHTML = html;
        setPageIndicatorsToZero();
        document.querySelectorAll('.reader-retry-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const id = parseInt(this.getAttribute('data-retry-id') || '0', 10);
                if (id) loadBookContent(id);
            });
        });
    }

    function showNoDataState() {
        const html = '<p class="preview-state-message">' + escapeHtml(PREVIEW_NO_DATA_MSG) + '</p>';
        const inner = document.getElementById('preview-content');
        const ebook = document.getElementById('preview-content-ebook');
        const paperback = document.getElementById('preview-content-paperback');
        if (inner) inner.innerHTML = html;
        if (ebook) ebook.innerHTML = html;
        if (paperback) paperback.innerHTML = html;
        setPageIndicatorsToZero();
    }

    function showEmptyState() {
        var viewport = document.getElementById('preview-content');
        var shell = document.getElementById('paginatedReaderShell');
        var root = document.getElementById('book-formatter-root');
        // Keep bookChapters empty so a later loadBookContent is never confused by sample data.
        bookChapters = [];
        try { window.__fmtBookChapters = bookChapters; } catch (e) {}
        // Always show open-book chrome (match AI Writer) even before content loads.
        if (isFmtPrintSpread() && viewport) {
            if (shell) shell.classList.add('is-open-spread');
            if (root) root.setAttribute('data-spread', '1');
            syncFmtPreviewLayout();
            var sampleL =
                '<h2 style="text-align:center;letter-spacing:.06em;margin:0.4em 0 0.75em;font-size:1.05em;">YOUR CHAPTER TITLE</h2>' +
                '<p>Upload a manuscript or open a book to fill these pages. Your formatted paperback appears here as a two-page spread — running heads, body text, and page numbers — just like print.</p>' +
                '<p>Choose Paperback (or Both) for this open-book view. Ebook uses a single paper page.</p>';
            var sampleR =
                '<h2 style="text-align:center;letter-spacing:.06em;margin:0.4em 0 0.75em;font-size:1.05em;">NEXT SPREAD</h2>' +
                '<p>Page turns move two pages at a time. Side arrows flip the spread. Total page count updates from your manuscript length.</p>' +
                '<p><strong>Tip:</strong> Keep important text inside the safe zone — away from the trim edge and spine.</p>';
            readerPages = [sampleL, sampleR];
            readerPageChapterIdx = [-1, -1];
            currentPageIdx = 0;
            formatterBookTitle = formatterBookTitle || 'YOUR BOOK TITLE';
            renderFmtPrintSpread(viewport);
            // Paint running heads for the sample spread.
            var heads = viewport.querySelectorAll('.book-open-running-head');
            if (heads[0]) { heads[0].textContent = 'YOUR BOOK TITLE'; heads[0].classList.remove('is-muted', 'is-empty'); }
            if (heads[1]) { heads[1].textContent = 'CHAPTER ONE'; heads[1].classList.remove('is-muted', 'is-empty'); }
            var ebook = document.getElementById('preview-content-ebook');
            var paperback = document.getElementById('preview-content-paperback');
            if (ebook) ebook.innerHTML = '';
            if (paperback) paperback.innerHTML = '';
            updatePageIndicator();
            syncFormatterSideNavVisibility();
            requestAnimationFrame(function () {
                try { syncFmtPreviewLayout(); } catch (e) { /* ignore */ }
            });
            return;
        }
        const html = '<p class="preview-state-message">' + escapeHtml(PREVIEW_EMPTY_MSG) + '</p>';
        const inner = document.getElementById('preview-content');
        const ebook2 = document.getElementById('preview-content-ebook');
        const paperback2 = document.getElementById('preview-content-paperback');
        if (inner) inner.innerHTML = html;
        if (ebook2) ebook2.innerHTML = html;
        if (paperback2) paperback2.innerHTML = html;
        setPageIndicatorsToZero();
    }

    function styleFmtFolioEl(foot, pageNum) {
        if (!foot) return;
        var styleEl = document.getElementById('style-select');
        var interior = styleEl ? styleEl.value : 'Novel';
        foot.classList.add('book-page-footer');
        if (interior === 'Classic') foot.classList.add('book-page-footer-classic');
        else if (interior === 'Modern') foot.classList.add('book-page-footer-modern');
        else if (interior === 'Minimalist') foot.classList.add('book-page-footer-minimalist');
        else if (interior === 'ElegantTrade') foot.classList.add('book-page-footer-elegant');
        else foot.classList.add('book-page-footer-novel');
        foot.setAttribute('data-page-parity', (pageNum % 2) === 1 ? 'odd' : 'even');
    }

    function resolveFmtRunningHead(pageIdx) {
        if (pageIdx < 0 || pageIdx >= readerPages.length) return '';
        var html = readerPages[pageIdx] || '';
        if (html.indexOf('data-chapter-start') >= 0 || html.indexOf('writer-cover-page') >= 0) return '';
        var ci = readerPageChapterIdx.length > pageIdx ? readerPageChapterIdx[pageIdx] : -1;
        if (ci < 0) return '';
        var bookTitle = String((bookPreviewContext && bookPreviewContext.bookTitle) || formatterBookTitle || '').trim();
        var chapterTitle = '';
        try {
            var ch = bookChapters && bookChapters[ci] ? bookChapters[ci] : null;
            if (ch) chapterTitle = String(ch.chapterTitle || ch.title || '').trim();
        } catch (e) { /* ignore */ }
        var pageNo = pageIdx + 1;
        var isRecto = (pageNo % 2) === 1;
        var text = isRecto ? (chapterTitle || bookTitle) : (bookTitle || chapterTitle);
        if (!text) return '';
        return text.length > 52 ? text.substring(0, 49) + '\u2026' : text;
    }

    function buildFmtSpreadFaceHtml(pageIdx, side) {
        var sideClass = side === 'recto' ? 'book-open-page--recto' : 'book-open-page--verso';
        if (pageIdx < 0 || pageIdx >= readerPages.length) {
            return '<div class="book-open-page ' + sideClass + '" aria-hidden="true">' +
                '<div class="book-open-running-head is-empty">&nbsp;</div>' +
                '<div class="book-open-page-inner book-open-blank"></div>' +
                '<div class="book-open-folio">&nbsp;</div></div>';
        }
        var pageNum = pageIdx + 1;
        var body = stripEmbeddedPageFooters(readerPages[pageIdx] || '');
        var head = resolveFmtRunningHead(pageIdx);
        var headClass = head ? 'book-open-running-head' : 'book-open-running-head is-muted';
        return '<div class="book-open-page ' + sideClass + '">' +
            '<div class="' + headClass + '">' + (head ? escapeHtml(head) : '&nbsp;') + '</div>' +
            '<div class="book-open-page-inner">' + body + '</div>' +
            '<div class="book-open-folio book-page-footer-inline" aria-label="Page ' + pageNum + '">' + formatBookPageNumber(pageNum) + '</div>' +
            '</div>';
    }

    function renderFmtPrintSpread(viewportEl) {
        if (!viewportEl) return;
        var left = getFmtSpreadLeftIndex(currentPageIdx);
        currentPageIdx = left;
        var right = left + 1;
        var shell = document.getElementById('paginatedReaderShell');
        if (shell) shell.classList.add('is-open-spread');
        var root = document.getElementById('book-formatter-root');
        if (root) root.setAttribute('data-spread', '1');
        viewportEl.innerHTML =
            '<div class="book-open-spread fmt-live-spread" role="group" aria-label="Open book spread" data-kdp-bleed="' + (isFmtBleedFormat() ? '1' : '0') + '">' +
                buildFmtSpreadFaceHtml(left, 'verso') +
                '<div class="book-open-spine fmt-live-spine" aria-hidden="true"></div>' +
                buildFmtSpreadFaceHtml(right, 'recto') +
            '</div>';
        applyPreviewStyles(viewportEl);
        // Apply body styles to each face so font size matches pagination measure.
        viewportEl.querySelectorAll('.book-open-page-inner').forEach(function (face) {
            applyPreviewStyles(face);
        });
        var faces = viewportEl.querySelectorAll('.book-open-folio.book-page-footer-inline');
        if (faces[0]) styleFmtFolioEl(faces[0], left + 1);
        if (faces[1] && right < readerPages.length) styleFmtFolioEl(faces[1], right + 1);
        viewportEl.scrollTop = 0;
        // Ensure shell fills host after DOM swap (prevents clipped last lines).
        requestAnimationFrame(function () {
            try { syncFmtPreviewLayout(); } catch (e) { /* ignore */ }
        });
    }

    function renderReaderPage(viewportEl, pageHtml, animDir) {
        if (!viewportEl) return;
        var shell = document.getElementById('paginatedReaderShell');
        var root = document.getElementById('book-formatter-root');
        if (isFmtPrintSpread()) {
            renderFmtPrintSpread(viewportEl);
            return;
        }
        if (shell) shell.classList.remove('is-open-spread');
        if (root) root.setAttribute('data-spread', '0');
        var pageNum = currentPageIdx + 1;
        var body = stripEmbeddedPageFooters(pageHtml || '');
        var head = resolveFmtRunningHead(currentPageIdx);
        var headHtml = '<div class="fmt-ebook-running-head' + (head ? '' : ' is-muted') + '">' +
            (head ? escapeHtml(head) : '&nbsp;') + '</div>';
        var folio = '<div class="book-page-footer book-page-footer-inline" aria-label="Page ' + pageNum + '">' + formatBookPageNumber(pageNum) + '</div>';
        viewportEl.innerHTML =
            '<div class="fmt-page-sheet fmt-ebook-sheet" role="article" aria-label="Ebook page ' + pageNum + '">' +
                headHtml +
                '<div class="fmt-ebook-body">' + body + '</div>' +
                folio +
            '</div>';
        applyPreviewStyles(viewportEl);
        var bodyEl = viewportEl.querySelector('.fmt-ebook-body');
        if (bodyEl) applyPreviewStyles(bodyEl);
        styleFmtFolioEl(viewportEl.querySelector('.book-page-footer-inline'), pageNum);
        viewportEl.scrollTop = 0;
        requestAnimationFrame(function () {
            try { syncFmtPreviewLayout(); } catch (e) { /* ignore */ }
        });
    }

    var FmtBookStageReader = (function() {
        var pages = [];
        var currentIndex = 0;
        var isAnimating = false;
        var SLIDE_DURATION = 350;
        var contentA = null, footerA = null, headA = null, contentB = null, footerB = null, headB = null;
        var layerA = null, layerB = null;
        var stage = null;
        function syncPageFooterStyle(footerEl) {
            if (!footerEl) return;
            var styleEl = document.getElementById('style-select');
            var interior = styleEl ? styleEl.value : 'Novel';
            footerEl.className = 'book-page-footer';
            if (interior === 'Classic') footerEl.classList.add('book-page-footer-classic');
            else if (interior === 'Modern') footerEl.classList.add('book-page-footer-modern');
            else if (interior === 'Minimalist') footerEl.classList.add('book-page-footer-minimalist');
            else if (interior === 'ElegantTrade') footerEl.classList.add('book-page-footer-elegant');
            else footerEl.classList.add('book-page-footer-novel');
        }
        function fillLayer(contentEl, footerEl, headEl, pageIdx) {
            if (!contentEl) return;
            var html = pages[pageIdx] || '<div class="reader-chapter-block"><p class="preview-state-message">No content.</p></div>';
            contentEl.innerHTML = stripEmbeddedPageFooters(html);
            syncPageRunningHead(headEl, pageIdx);
            // Real-book convention: the chapter-opening page carries no running head.
            if (headEl && html.indexOf('data-chapter-start') >= 0) {
                headEl.textContent = '';
                headEl.classList.add('is-empty');
                headEl.setAttribute('aria-hidden', 'true');
            }
            // Real-book parity: recto (odd page numbers) vs verso (even) — drives mirrored gutter + outer folio.
            var parity = ((pageIdx + 1) % 2) === 1 ? 'odd' : 'even';
            var wrapEl = contentEl.closest('.book-page-content-wrap');
            if (wrapEl) wrapEl.setAttribute('data-page-parity', parity);
            if (footerEl) {
                footerEl.innerHTML = formatBookPageNumber(pageIdx + 1);
                syncPageFooterStyle(footerEl);
                footerEl.setAttribute('data-page-parity', parity);
            }
            applyPreviewStyles(contentEl);
            wireFormatterTocLinks();
            contentEl.scrollTop = 0;
        }
        function ensureDom() {
            stage = document.getElementById('bookStage');
            contentA = document.getElementById('bookPageContentA');
            footerA = document.getElementById('bookPageFooterA');
            headA = document.getElementById('bookPageRunningHeadA');
            contentB = document.getElementById('bookPageContentB');
            footerB = document.getElementById('bookPageFooterB');
            headB = document.getElementById('bookPageRunningHeadB');
            layerA = document.getElementById('pageLayerA');
            layerB = document.getElementById('pageLayerB');
            if (layerB) { layerB.classList.add('book-page-layer-off'); }
        }
        function show() {
            if (!stage) ensureDom();
            if (stage) {
                stage.classList.add('is-visible');
                stage.style.removeProperty('display');
            }
        }
        function hide() {
            if (!stage) ensureDom();
            if (stage) {
                stage.classList.remove('is-visible');
                stage.style.display = 'none';
            }
        }
        function setPages(nextPages) {
            if (!stage) ensureDom();
            pages = (Array.isArray(nextPages) && nextPages.length) ? nextPages.slice() : ['<div class="reader-chapter-block"><p class="preview-state-message">No content.</p></div>'];
            currentIndex = Math.min(currentIndex, Math.max(0, pages.length - 1));
            fillLayer(contentA, footerA, headA, currentIndex);
            var ind = document.getElementById('bookPageIndicator');
            if (ind) ind.textContent = (currentIndex + 1) + ' / ' + pages.length;
        }
        function goToPage(nextIndex) {
            if (!stage) ensureDom();
            if (!pages.length) return;
            nextIndex = Math.max(0, Math.min(nextIndex, pages.length - 1));
            currentIndex = nextIndex;
            fillLayer(contentA, footerA, headA, currentIndex);
            var ind = document.getElementById('bookPageIndicator');
            if (ind) ind.textContent = (currentIndex + 1) + ' / ' + pages.length;
            if (window.BookInteriorPreview && typeof window.BookInteriorPreview.preloadAdjacentPage === 'function') {
                window.BookInteriorPreview.preloadAdjacentPage({
                    pages: pages,
                    currentIndex: currentIndex,
                    hiddenTarget: contentB,
                    fill: function (idx, target) {
                        if (!target) return;
                        var html = pages[idx] || '';
                        target.innerHTML = stripEmbeddedPageFooters(html);
                        syncPageRunningHead(headB, idx);
                        applyPreviewStyles(target);
                    }
                });
            }
        }
        return {
            ensureDom: ensureDom,
            show: show,
            hide: hide,
            setPages: setPages,
            goToPage: goToPage,
            getCurrentIndex: function() { return currentIndex; }
        };
    })();

    function firstPageForChapter(chIdx) {
        for (let i = 0; i < readerPageChapterIdx.length; i++) {
            if (readerPageChapterIdx[i] === chIdx) return i;
        }
        return FMT_FRONT_MATTER_PAGE_COUNT;
    }

    function populateChapterJump() {
        const sel = document.getElementById('reader-chapter-jump');
        const chrome = document.getElementById('reader-chrome-main');
        if (!sel) return;
        sel.innerHTML = '';
        if (!bookChapters.length) {
            if (chrome) chrome.classList.add('hidden');
            syncFormatterChromeWidth();
            return;
        }
        if (chrome) chrome.classList.remove('hidden');
        syncFormatterChromeWidth();
        bookChapters.forEach(function(ch, idx) {
            const t = (ch && ch.chapterTitle) || ('Chapter ' + (idx + 1));
            const opt = document.createElement('option');
            opt.value = String(idx);
            opt.textContent = (idx + 1) + '. ' + t.substring(0, 80) + (t.length > 80 ? '…' : '');
            sel.appendChild(opt);
        });
    }

    function updateReaderProgressUi() {
        const fill = document.getElementById('reader-progress-fill');
        const dockProg = document.getElementById('fmt-preview-nav-progress');
        const total = readerPages.length;
        const pct = total ? Math.round(((currentPageIdx + 1) / total) * 100) : 0;
        if (fill) fill.style.width = pct + '%';
        if (dockProg) dockProg.style.width = pct + '%';
        const sel = document.getElementById('reader-chapter-jump');
        if (sel && readerPageChapterIdx.length > currentPageIdx) {
            sel.value = String(readerPageChapterIdx[currentPageIdx]);
        }
        const indF = document.getElementById('page-indicator-format');
        if (indF && total) {
            const ch = readerPageChapterIdx[currentPageIdx] != null ? readerPageChapterIdx[currentPageIdx] + 1 : 1;
            indF.setAttribute('title', 'Chapter ' + ch + ' — page ' + (currentPageIdx + 1) + ' of ' + total);
        }
    }

    /** AI Writer–style chapter title + hint under progress (single preview mode only). */
    function updateFmtPreviewChapterChrome() {
        var h = document.getElementById('fmt-preview-chapter-header');
        var hint = document.getElementById('fmt-preview-read-hint');
        var singleEl = document.getElementById('preview-single');
        var singleMode = singleEl && !singleEl.classList.contains('hidden') && singleEl.style.display !== 'none';
        var total = readerPages.length;
        if (h) {
            if (!singleMode || !total || !bookChapters.length) {
                h.classList.add('hidden');
            } else {
                h.classList.remove('hidden');
                var ci = readerPageChapterIdx.length > currentPageIdx ? readerPageChapterIdx[currentPageIdx] : 0;
                if (ci < 0) {
                    h.textContent = currentPageIdx === 0 ? 'Title page' : (currentPageIdx === 1 ? 'Copyright' : 'Contents');
                    return;
                }
                var ch = bookChapters[ci];
                var chNum = ch && ch.chapterNo != null ? parseInt(String(ch.chapterNo), 10) : (ci + 1);
                if (!Number.isFinite(chNum)) chNum = ci + 1;
                var title = (ch && ch.chapterTitle) ? String(ch.chapterTitle) : ('Chapter ' + chNum);
                h.textContent = title;
            }
        }
        if (hint) {
            if (!total) {
                hint.textContent = 'Page 0 of 0';
            } else if (readerPageChapterIdx.length > currentPageIdx && readerPageChapterIdx[currentPageIdx] < 0) {
                var fmLabel = currentPageIdx === 0 ? 'Title' : (currentPageIdx === 1 ? 'Copyright' : 'Contents');
                hint.textContent = fmLabel + ' · Page ' + (currentPageIdx + 1) + ' of ' + total;
            } else {
                var ci2 = readerPageChapterIdx.length > currentPageIdx ? readerPageChapterIdx[currentPageIdx] : 0;
                var ch2 = bookChapters[ci2];
                var cn = ch2 && ch2.chapterNo != null ? parseInt(String(ch2.chapterNo), 10) : (ci2 + 1);
                if (!Number.isFinite(cn)) cn = ci2 + 1;
                hint.textContent = 'Chapter ' + cn + ' · Page ' + (currentPageIdx + 1) + ' of ' + total;
            }
        }
    }

    function updatePageIndicator() {
        const total = readerPages.length;
        const indF = document.getElementById('page-indicator-format');
        const indB = document.getElementById('page-indicator-both');
        const indE = document.getElementById('page-indicator-ebook');
        const indP = document.getElementById('page-indicator-paperback');
        const indStage = document.getElementById('bookPageIndicator');
        const fmtPageInd = document.getElementById('fmt-page-indicator');
        const spread = isFmtPrintSpread() && total > 0;
        const left = spread ? getFmtSpreadLeftIndex(currentPageIdx) : currentPageIdx;
        const right = left + 1;
        const text = !total
            ? 'Page 0 of 0'
            : (spread
                ? (right < total
                    ? ('Pages ' + (left + 1) + '–' + (right + 1) + ' of ' + total)
                    : ('Page ' + (left + 1) + ' of ' + total))
                : ('Page ' + (currentPageIdx + 1) + ' of ' + total));
        const short = !total
            ? '0 / 0'
            : (spread
                ? (right < total ? ((left + 1) + '–' + (right + 1) + ' / ' + total) : ((left + 1) + ' / ' + total))
                : ((currentPageIdx + 1) + ' / ' + total));
        if (indF) indF.textContent = text;
        if (indB) indB.textContent = text;
        if (indE) indE.textContent = short;
        if (indP) indP.textContent = short;
        if (indStage) indStage.textContent = short;
        // Single source of truth for the "Page X of Y" / "Total pages: Y" pair.
        // When the on-screen real-template (IPV) reader is active it owns the top
        // indicator (see its renderPage); we must NOT overwrite it here with the
        // secondary readerPages count, or top (e.g. 24) and bottom (e.g. 20) diverge.
        if (fmtPageInd && !window.__ipvActive) {
            fmtPageInd.textContent = text;
            fmtPageInd.classList.remove('hidden');
            fmtPageInd.style.display = '';
            fmtPageInd.classList.toggle('hidden', !total);
        }
        var totalWrap = document.getElementById('fmt-total-page-count');
        if (totalWrap) {
            totalWrap.classList.toggle('hidden', !total);
            if (total) totalWrap.style.display = '';
        }
        var footerBar = document.getElementById('fmt-preview-footer');
        if (footerBar) {
            footerBar.style.display = 'flex';
            footerBar.style.visibility = 'visible';
            footerBar.setAttribute('aria-hidden', total ? 'false' : 'true');
        }
        var atEnd = !total || currentPageIdx >= total - 1 || (spread && left + 1 >= total);
        setReaderNavDisabled(currentPageIdx <= 0, atEnd);
        updateReaderProgressUi();
        updateFmtPreviewChapterChrome();
        updateFmtFullBookReadBar();
        syncFormatterSideNavVisibility();
        // Keep the "Total pages" readout in sync even when the full-book read bar
        // (and its early-return) skips syncFormatterPageCountUi.
        syncFormatterPageCountUi();
    }

    function initBookInteriorPreviewShell() {
        if (!window.BookInteriorPreview) return;
        var scrollHost = document.getElementById('fmt-preview-scroll-host');
        var shell = document.getElementById('paginatedReaderShell');
        if (!scrollHost || !shell) return;
        if (fmtPreviewShellInitialized) {
            syncFmtPreviewLayout();
            return;
        }
        fmtPreviewShellInitialized = true;
        syncFmtPreviewLayout();
        var remPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        var maxShellH = Math.max(560, Math.floor(window.innerHeight - 3.25 * remPx));
        window.BookInteriorPreview.init(scrollHost, {
            bookTitle: (bookPreviewContext && bookPreviewContext.bookTitle) || '',
            mode: 'web',
            shell: shell,
            host: document.getElementById('preview-single') || scrollHost,
            fitOptions: {
                aspectRatio: isFmtPrintSpread() ? (12 / 9) : (6 / 9),
                widthFactor: 1,
                preferHeight: window.innerWidth >= 1024,
                maxHeightPx: window.innerWidth >= 1024 ? maxShellH : 0,
                minHostHeightPx: window.innerWidth >= 1024
                    ? Math.max(640, Math.floor(window.innerHeight * 0.9))
                    : Math.max(400, Math.floor(window.innerHeight * 0.62)),
                measureHost: document.getElementById('fmt-preview-measure-host'),
                viewport: document.getElementById('preview-content'),
                syncMeasureTypography: true
            },
            onLayoutChange: function(changed) {
                if (changed && bookChapters.length) fmtScheduleRepaginate();
            }
        });
    }

    function navigateToReaderPage(pageIdx) {
        if (!readerPages.length) return;
        var target = Math.max(0, Math.min(pageIdx, readerPages.length - 1));
        if (isFmtPrintSpread()) target = getFmtSpreadLeftIndex(target);
        currentPageIdx = target;
        var viewport = document.getElementById('preview-content');
        if (viewport) {
            viewport.classList.remove('hidden');
            renderReaderPage(viewport, readerPages[currentPageIdx]);
            wireFormatterTocLinks();
        }
        if (typeof FmtBookStageReader !== 'undefined') FmtBookStageReader.hide();
        updatePageIndicator();
    }

    function renderPreviewContent(animDir) {
        const viewport = document.getElementById('preview-content');
        const stage = document.getElementById('bookStage');
        if (!viewport) return;
        if (bookChapters.length === 0) {
            if (typeof FmtBookStageReader !== 'undefined') FmtBookStageReader.hide();
            if (stage) { stage.classList.add('hidden'); stage.style.display = 'none'; }
            viewport.classList.remove('hidden');
            var activeBid = resolveFormatterBookId();
            if (activeBid > 0) showNoDataState();
            else showEmptyState();
            setPageIndicatorsToZero();
            return;
        }
        if (readerPages.length === 0) ensureReaderPages(false);
        currentPageIdx = Math.min(currentPageIdx, Math.max(0, readerPages.length - 1));
        if (isFmtPrintSpread()) currentPageIdx = getFmtSpreadLeftIndex(currentPageIdx);
        if (stage) { stage.classList.add('hidden'); stage.style.display = 'none'; }
        viewport.classList.remove('hidden');
        renderReaderPage(viewport, readerPages[currentPageIdx], animDir);
        wireFormatterTocLinks();
        if (typeof FmtBookStageReader !== 'undefined') FmtBookStageReader.hide();
        syncFmtPreviewLayout();
        updatePageIndicator();
        scrollReaderPanelsToTop();
    }

    function renderBothPreviews(animDir) {
        renderPreviewContent(animDir);
    }

    function goToPrevPage() {
        if (currentPageIdx <= 0) return;
        var step = isFmtPrintSpread() ? 2 : 1;
        navigateToReaderPage(currentPageIdx - step);
        persistReaderPosition();
    }

    function goToNextPage() {
        if (readerPages.length === 0) return;
        var step = isFmtPrintSpread() ? 2 : 1;
        if (currentPageIdx + step >= readerPages.length && currentPageIdx >= readerPages.length - 1) return;
        if (isFmtPrintSpread() && currentPageIdx >= readerPages.length - 1) return;
        // Last odd page alone: still allow leaving a complete prior spread.
        if (isFmtPrintSpread() && currentPageIdx + 1 >= readerPages.length) return;
        navigateToReaderPage(currentPageIdx + step);
        persistReaderPosition();
    }

    function getCurrentChapterIndexFromPage() {
        if (!readerPageChapterIdx.length || currentPageIdx < 0 || currentPageIdx >= readerPageChapterIdx.length) return 0;
        return readerPageChapterIdx[currentPageIdx];
    }

    function goToPrevChapter() {
        var ci = getCurrentChapterIndexFromPage();
        if (ci <= 0 || !bookChapters.length) return;
        currentPageIdx = firstPageForChapter(ci - 1);
        const fmtEl = document.getElementById('format-select');
        const fmt = (fmtEl && fmtEl.value) || 'Ebook';
        if (fmt === 'Both') renderBothPreviews(-1); else renderPreviewContent(-1);
        if (typeof window.FmtIpvJumpToChapter === 'function') window.FmtIpvJumpToChapter(ci - 1);
        persistReaderPosition();
    }

    function goToNextChapter() {
        var ci = getCurrentChapterIndexFromPage();
        if (!bookChapters.length || ci >= bookChapters.length - 1) return;
        currentPageIdx = firstPageForChapter(ci + 1);
        const fmtEl = document.getElementById('format-select');
        const fmt = (fmtEl && fmtEl.value) || 'Ebook';
        if (fmt === 'Both') renderBothPreviews(1); else renderPreviewContent(1);
        if (typeof window.FmtIpvJumpToChapter === 'function') window.FmtIpvJumpToChapter(ci + 1);
        persistReaderPosition();
    }

    function updateFmtFullBookReadBar() {
        var bar = document.getElementById('fmt-fullbook-read-bar');
        var prev = document.getElementById('fmt-btn-read-prev-page');
        var next = document.getElementById('fmt-btn-read-next-page');
        var sum = document.getElementById('fmt-read-page-summary');
        if (!bar || !prev || !next) return;
        var total = readerPages.length;
        if (!total || !bookChapters.length) {
            bar.classList.remove('is-visible');
            return;
        }
        bar.classList.add('is-visible');
        var ci = readerPageChapterIdx.length > currentPageIdx ? readerPageChapterIdx[currentPageIdx] : 0;
        var nCh = bookChapters.length;
        var ch = bookChapters[ci];
        var chNum = ch && ch.chapterNo != null ? parseInt(String(ch.chapterNo), 10) : (ci + 1);
        if (!Number.isFinite(chNum)) chNum = ci + 1;
        var chTit = (ch && ch.chapterTitle) ? String(ch.chapterTitle) : ('Chapter ' + chNum);
        if (sum) {
            sum.textContent = 'Chapter ' + (ci + 1) + ' / ' + nCh + (chTit ? ' — ' + chTit : '') + ' · Page ' + (currentPageIdx + 1) + ' / ' + total;
        }
        prev.disabled = currentPageIdx <= 0;
        next.disabled = currentPageIdx >= total - 1 || (isFmtPrintSpread() && getFmtSpreadLeftIndex(currentPageIdx) + 1 >= total);
        syncFormatterPageCountUi();
    }

    function resolveFormatterBookId() {
        var bid = getBookIdFromUrl();
        if (!bid || bid <= 0) bid = initialBookId;
        if (!bid || bid <= 0) {
            try { bid = parseInt((document.getElementById('selected-book-id') && document.getElementById('selected-book-id').value) || '0', 10); } catch (e) { bid = 0; }
        }
        if (!bid || bid <= 0) {
            try { bid = parseInt(sessionStorage.getItem(FORMATTER_BOOK_KEY) || '0', 10); } catch (e) { bid = 0; }
        }
        return Number.isFinite(bid) && bid > 0 ? bid : 0;
    }

    function syncFmtSelectedBookLabel(title) {
        var titleEl = document.getElementById('formatting-preview-title');
        if (!titleEl) return;
        var t = (title || formatterBookTitle || '').trim();
        if (t) titleEl.textContent = t;
    }

    function syncFmtPreviewByline(authorName) {
        var byline = document.getElementById('fmt-preview-byline');
        if (!byline) return;
        var authorLine = (authorName && String(authorName).trim()) ? String(authorName).trim() : '';
        if (authorLine) {
            byline.textContent = 'by ' + authorLine;
            byline.classList.remove('hidden');
            byline.removeAttribute('aria-hidden');
        } else {
            byline.textContent = '';
            byline.classList.add('hidden');
            byline.setAttribute('aria-hidden', 'true');
        }
    }

    function syncFormatterSwitchBookLink(bid) {
        var a = document.getElementById('fmt-link-switch-book');
        if (!a) return;
        var id = parseInt(String(bid || '0'), 10);
        a.href = id > 0 ? ('/Books/AIGenerateBook?bookId=' + encodeURIComponent(id)) : '/Dashboard';
    }

    function wireFormatterBookSelect() {
        var sel = document.getElementById('fmt-book-select');
        if (!sel) return;
        sel.addEventListener('change', function() {
            var id = parseInt(sel.value || '0', 10) || 0;
            var currentId = resolveFormatterBookId();
            if (id === currentId) {
                if (typeof window.syncFmtImageUploadAvailability === 'function') window.syncFmtImageUploadAvailability();
                return;
            }
            var fmtEl = document.getElementById('format-select');
            var fmt = (fmtEl && fmtEl.value) || formatFromUrl || 'Paperback';
            if (id > 0) {
                window.location.assign('/BookDesign/CoverDesignCalculatorFixing?bookId=' + encodeURIComponent(id) + '&format=' + encodeURIComponent(fmt));
            } else {
                window.location.assign('/BookDesign/CoverDesignCalculatorFixing?format=' + encodeURIComponent(fmt));
            }
        });
    }

    function togglePreviewMode() {
        const single = document.getElementById('preview-single');
        const both = document.getElementById('preview-both');
        updatePremiumFormatUi();
        if (single) { single.classList.remove('hidden'); single.style.display = 'flex'; }
        if (both) { both.classList.add('hidden'); both.style.display = 'none'; }
        var label = document.getElementById('fmt-preview-mode-label');
        if (label) {
            if (isFmtPrintSpread())
                label.textContent = 'Print book preview (two pages)';
            else
                label.textContent = 'Ebook preview (paper page)';
        }
        var root = document.getElementById('book-formatter-root');
        if (root) root.setAttribute('data-spread', isFmtPrintSpread() ? '1' : '0');
        var shell = document.getElementById('paginatedReaderShell');
        if (shell) {
            if (isFmtPrintSpread()) shell.classList.add('is-open-spread');
            else shell.classList.remove('is-open-spread');
        }
        // Keep interactive book pages visible (export iframe is opt-in).
        if (typeof setFmtExportPreviewVisible === 'function') setFmtExportPreviewVisible(false);
        syncFmtPreviewLayout();
        // Always rebuild pages when spread/single mode changes so face width matches.
        if (bookChapters.length) ensureReaderPages(true);
        renderPreviewContent(0);
    }

    function refreshFormattingPrefsForBook(bid) {
        const numId = parseInt(bid, 10);
        if (isNaN(numId) || numId <= 0) return Promise.resolve();
        return fetch('/BookDesign/GetBookFormatting?bookId=' + numId)
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res && res.success && res.data) {
                    const d = res.data;
                    const fmt = document.getElementById('format-select');
                    const style = document.getElementById('style-select');
                    const sz = document.getElementById('text-size-select');
                    const ls = document.getElementById('line-spacing-select');
                    if (fmt && d.format) {
                        fmt.value = (d.format === 'Print' ? 'Paperback' : d.format);
                    }
                    if (style && d.interiorStyle) style.value = d.interiorStyle;
                    if (sz && d.textSize) sz.value = d.textSize;
                    if (ls && d.lineSpacing) ls.value = d.lineSpacing;
                    if (d.publishingPlatforms) setSelectedPlatforms(d.publishingPlatforms);
                    if (d.draftStateJson) {
                        try {
                            applyFormatterStateToUi(JSON.parse(d.draftStateJson), { skipPreviewToggle: true });
                        } catch (e) { /* ignore */ }
                    } else {
                        const localDraft = loadFormatterDraftLocal(numId);
                        if (localDraft) applyFormatterStateToUi(localDraft, { skipPreviewToggle: true });
                    }
                }
                if (formatLockedByQuery) {
                    var fmtQ = document.getElementById('format-select');
                    if (fmtQ && ['Ebook', 'Paperback', 'Both'].indexOf(formatLockedByQuery) >= 0) {
                        fmtQ.value = formatLockedByQuery;
                    }
                }
                updatePremiumFormatUi();
                syncFmtInteriorCardsFromSelect();
                syncFmtTypographyPillsFromSelects();
                applyFmtStudioAccent();
                ensureReaderPages(true);
                currentPageIdx = Math.min(currentPageIdx, Math.max(0, readerPages.length - 1));
                togglePreviewMode();
                syncFormatPickerButton();
            })
            .catch(function(e) { console.warn('[Book Formatter] GetBookFormatting failed:', e); });
    }

    async function initFormatterBook() {
        const bid = resolveFormatterBookId();
        const hid = document.getElementById('selected-book-id');
        if (hid && bid > 0) hid.value = String(bid);
        if (root && bid > 0) root.setAttribute('data-book-id', String(bid));

        if (!bid || bid <= 0) {
            syncFormatterSwitchBookLink(0);
            showEmptyState();
            showToast('Open your book from the Dashboard under Continue Editing.');
            return;
        }

        try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(bid)); } catch (e) {}

        if (serverBookPayload && serverBookPayload.success) {
            writeCachedBookPayload(bid, serverBookPayload);
            hydrateBookFromPayload(serverBookPayload, bid, { force: true, resetPage: true });
        }

        await loadBookContent(bid);
        await refreshFormattingPrefsForBook(bid);
    }

    function readCachedBookPayload(bookId) {
        try {
            var raw = sessionStorage.getItem(formatterBookPayloadKey(bookId));
            if (!raw) return null;
            var parsed = JSON.parse(raw);
            if (!parsed || !parsed.fetchedAt || !parsed.data) return null;
            var age = Date.now() - Number(parsed.fetchedAt);
            if (!Number.isFinite(age) || age < 0 || age > FORMATTER_BOOK_PAYLOAD_MAX_AGE_MS) return null;
            return parsed.data;
        } catch (_) {
            return null;
        }
    }

    function writeCachedBookPayload(bookId, data) {
        try {
            sessionStorage.setItem(formatterBookPayloadKey(bookId), JSON.stringify({
                fetchedAt: Date.now(),
                data: data
            }));
        } catch (_) { /* ignore quota */ }
    }

    function hydrateBookFromPayload(data, numId, options) {
        var opts = options || {};
        if (!data || !data.success) return false;
        if (data.bookId && parseInt(data.bookId, 10) !== numId) {
            console.error('[Book Formatter] bookId mismatch — refusing stale payload', data.bookId, numId);
            return false;
        }
        var nextSignature = JSON.stringify({
            id: numId,
            t: data.bookTitle || '',
            a: data.authorName || '',
            chapters: (data.chapters || []).map(function(c) {
                return [c.chapterNo, c.chapterTitle || '', (c.content || '').length].join(':');
            })
        });
        if (!opts.force && nextSignature === lastLoadedBookPayloadSignature) return true;

        bookPreviewContext = {
            bookTitle: (data.bookTitle && String(data.bookTitle)) || '',
            subtitle: (data.subtitle && String(data.subtitle)) || '',
            description: (data.description && String(data.description)) || '',
            genre: (data.genre && String(data.genre)) || '',
            authorName: (data.authorName && String(data.authorName)) || ''
        };
        var sortedChapters = Array.isArray(data.chapters) ? data.chapters.slice().sort(function(a, b) {
            return (parseInt(a.chapterNo, 10) || 0) - (parseInt(b.chapterNo, 10) || 0);
        }) : [];
        function narrativeDisplayNum(list, idx) {
            var chNo = parseInt(list[idx].chapterNo, 10);
            if (!Number.isFinite(chNo) || chNo <= 0) return null;
            var n = 0;
            for (var i = 0; i <= idx; i++) {
                var cn = parseInt(list[i].chapterNo, 10);
                if (Number.isFinite(cn) && cn > 0) n++;
            }
            return n;
        }
        bookChapters = sortedChapters.map(function(c, idx) {
            var titleRaw = (c && (c.chapterTitle || c.title || c.Title)) || '';
            var contentRaw = getContentFromPossibleJson((c && (c.content || c.Content || c.chapterContent || c.chapterHtml || c.previewHtml || c.formattedContent || c.text)) || '');
            var chapterNoDb = parseInt(c.chapterNo, 10);
            if (!Number.isFinite(chapterNoDb)) chapterNoDb = idx + 1;
            var narrativeNum = narrativeDisplayNum(sortedChapters, idx);
            var phCtx = Object.assign({}, bookPreviewContext, {
                chapterTitle: titleRaw,
                chapterNumber: chapterNoDb,
                displayChapterNumber: narrativeNum != null ? narrativeNum : ''
            });
            return {
                chapterNo: chapterNoDb,
                chapterTitle: applyTemplatePlaceholders(titleRaw, phCtx),
                content: normalizeManuscriptEscapes(applyTemplatePlaceholders(contentRaw, phCtx))
            };
        });
        currentChapterIdx = 0;
        // Publish live data for the embedded "Book Interior Preview" overlay (separate script scope).
        try { window.__fmtBookChapters = bookChapters; window.__fmtPreviewContext = bookPreviewContext; } catch (e) {}

        const titleEl = document.getElementById('formatting-preview-title');
        var displayBookTitle = applyTemplatePlaceholders(bookPreviewContext.bookTitle, Object.assign({}, bookPreviewContext, {
            chapterTitle: '',
            chapterNumber: '',
            displayChapterNumber: ''
        }));
        if (displayBookTitle && titleEl) titleEl.textContent = displayBookTitle;
        formatterBookTitle = (displayBookTitle && String(displayBookTitle).trim()) ? String(displayBookTitle).trim() : '';
        syncFmtSelectedBookLabel(formatterBookTitle);

        var authEl = document.getElementById('formatter-display-author');
        if (authEl && bookPreviewContext.authorName) authEl.textContent = bookPreviewContext.authorName;
        syncFmtPreviewByline(bookPreviewContext.authorName);

        const hid = document.getElementById('selected-book-id');
        if (hid) hid.value = String(numId);
        try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(numId)); } catch (e) {}
        if (root) root.setAttribute('data-book-id', String(numId));
        syncFormatterSwitchBookLink(numId);

        if (bookChapters.length === 0) {
            showNoDataState();
        } else {
            if (opts.resetPage !== false) currentPageIdx = 0;
            // Apply open-spread chrome BEFORE measuring pages (otherwise pagination uses single-page width).
            var shellEarly = document.getElementById('paginatedReaderShell');
            var rootEarly = document.getElementById('book-formatter-root');
            if (isFmtPrintSpread()) {
                if (shellEarly) shellEarly.classList.add('is-open-spread');
                if (rootEarly) rootEarly.setAttribute('data-spread', '1');
            } else {
                if (shellEarly) shellEarly.classList.remove('is-open-spread');
                if (rootEarly) rootEarly.setAttribute('data-spread', '0');
            }
            syncFmtPreviewLayout();
            ensureReaderPages(true);
            populateChapterJump();
            if (!opts.skipRestorePosition) restoreReaderPosition(numId);
            togglePreviewMode();
            if (!opts.skipRepaginateAfterLayout) fmtScheduleRepaginateAfterLayout();
            syncFormatterPageCountUi();
            var deferHeavy = function(fn) {
                if (typeof requestIdleCallback === 'function') requestIdleCallback(fn, { timeout: 1200 });
                else setTimeout(fn, 0);
            };
            deferHeavy(function() {
                saveFormatting(function () {}, { silent: true });
                if (fmtExportPreviewVisible) scheduleFmtExportPreviewReload(false);
            });
        }
        lastLoadedBookPayloadSignature = nextSignature;
        return true;
    }

    async function loadBookContent(bid) {
        const numId = parseInt(bid, 10);
        if (isNaN(numId) || numId <= 0) {
            bookChapters = [];
            try { window.__fmtBookChapters = bookChapters; } catch (e) {}
            syncFormatterSwitchBookLink(0);
            showEmptyState();
            return;
        }

        if (!userId) {
            console.warn('[Book Formatter] data-user-id missing on page; loading via session.');
        }

        console.log('[Book Formatter] Selected Book ID:', numId);

        showLoadingState(true);

        var hadWarmCache = false;
        var cached = readCachedBookPayload(numId);
        if (cached && cached.success && Array.isArray(cached.chapters) && cached.chapters.some(function(c) {
            return c && String((c.content || c.Content || '')).trim().length > 0;
        })) {
            hadWarmCache = hydrateBookFromPayload(cached, numId, {
                force: false,
                resetPage: false,
                skipRepaginateAfterLayout: true
            });
            if (hadWarmCache) showLoadingState(false);
        }

        try {
            const url = '/BookDesign/GetFormatterBookContent?bookId=' + encodeURIComponent(numId);
            const response = await fetch(url, {
                credentials: 'same-origin',
                headers: { Accept: 'application/json' }
            });

            if (response.status === 401) {
                console.warn('[Book Formatter] Session expired');
                showErrorState(null, 'Please sign in again to load your book.');
                showToast('Session expired. Please sign in.');
                return;
            }

            if (response.status === 404) {
                console.warn('[Book Formatter] GetFullBookContent 404');
                showErrorState(null, 'No data available for this book.');
                showToast('No data available.');
                return;
            }

            if (response.status >= 500) {
                console.error('[Book Formatter] GetFullBookContent server error:', response.status);
                showErrorState(null, 'Server error. Please try again later.');
                showToast('Server error. Please try again.');
                return;
            }

            let data = null;
            const contentType = response.headers.get('content-type') || '';
            if (contentType.indexOf('application/json') !== -1) {
                data = await response.json();
            } else {
                const text = await response.text();
                console.warn('[Book Formatter] GetFullBookContent non-JSON response:', text ? text.substring(0, 200) : '');
                showErrorState(null, PREVIEW_ERROR_MSG);
                showToast('Invalid response from server.');
                return;
            }

            console.log('[Book Formatter] API response:', { success: data && data.success, totalChapters: (data && data.chapters) ? data.chapters.length : 0, data: data });

            if (!data) {
                showErrorState(null, PREVIEW_ERROR_MSG);
                showToast('No response data.');
                return;
            }

            if (!data.success) {
                const msg = (data.message && String(data.message).trim()) || 'No data available for this book.';
                showErrorState(null, msg, numId);
                showToast(msg);
                return;
            }
            if (!data.chapters || !data.chapters.length) {
                try { sessionStorage.removeItem(formatterBookPayloadKey(numId)); } catch (_) { /* ignore */ }
            } else {
                writeCachedBookPayload(numId, data);
            }
            var hydrated = hydrateBookFromPayload(data, numId, {
                force: true,
                resetPage: !hadWarmCache
            });
            if (!hydrated && !hadWarmCache) {
                showErrorState(null, PREVIEW_ERROR_MSG);
                showToast('Could not prepare preview.');
                return;
            }
            if (!bookChapters.length) {
                showToast('No chapters yet.');
            } else if (!hadWarmCache) {
                queueAutosave(400);
                showToast('Book loaded');
            }
        } catch (err) {
            console.error('[Book Formatter] loadBookContent error:', err);
            const bid = parseInt(document.getElementById('selected-book-id')?.value || '0', 10);
            if (!hadWarmCache) {
                showErrorState(null, PREVIEW_ERROR_MSG, bid > 0 ? bid : null);
                showToast('Could not load book.');
            }
        } finally {
            showLoadingState(false);
        }
    }

    function saveFormatting(callback, opts) {
        const options = opts || {};
        const hid = document.getElementById('selected-book-id');
        const bid = parseInt((hid && hid.value) || '0', 10);
        if (!bid) {
            // Empty studio: keep draft on this device only — not a server error.
            const state = getFormatterStateFromUi();
            persistFormatterDraftLocal(state, 0);
            if (window.EbookUnsavedGuard) window.EbookUnsavedGuard.markSaved();
            if (!options.silent) showToast('Saved on this device. Select a book to sync to the server.');
            if (callback) callback(true, { localOnly: true });
            return;
        }
        const state = getFormatterStateFromUi();
        persistFormatterDraftLocal(state, bid);
        const fmt = state.format;
        var titleForSave = (formatterBookTitle || bookPreviewContext.bookTitle || '').trim();
        fetch('/BookDesign/SaveBookFormatting', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
                bookId: bid,
                bookTitle: titleForSave || null,
                format: fmt === 'Both' ? 'Both'
                    : (fmt === 'Hardcover' ? 'Hardcover'
                    : (fmt === 'Paperback' ? 'Paperback' : 'Ebook')),
                interiorStyle: state.interiorStyle,
                textSize: state.textSize,
                lineSpacing: state.lineSpacing,
                publishingPlatforms: state.publishingPlatforms,
                publishingPlatform: state.publishingPlatform || (state.publishingPlatforms ? state.publishingPlatforms.split(',')[0].trim() : ''),
                previewPageCount: getFormatterPreviewPageCount() || null,
                draftStateJson: JSON.stringify(state)
            })
        })
        .then(function(r) {
            if (r.status === 401 || r.status === 403) {
                return { success: false, message: 'Please sign in again.', auth: true };
            }
            return r.json().catch(function () {
                return { success: false, message: 'Server returned an unexpected response.' };
            });
        })
        .then(function(res) {
            if (res && res.success) {
                if (window.EbookUnsavedGuard) window.EbookUnsavedGuard.markSaved();
                try {
                    sessionStorage.setItem('formatter_format_premium', fmt === 'Both' ? '1' : '0');
                } catch (e) { /* ignore */ }
                if (!options.silent) showToast('Formatting saved.');
                if (callback) callback(true, res);
            }
            else {
                if (!options.silent) showToast(res && res.message ? res.message : 'Save failed.');
                if (callback) callback(false, res || {});
            }
        })
        .catch(function() {
            if (!options.silent) showToast('Network error while saving.');
            if (callback) callback(false, { network: true });
        });
    }

    /** Called from Publish before export — ensures paginated preview + settings are on the server. */
    window.fmtFlushFormattingForExport = function () {
        return new Promise(function (resolve) {
            var bid = parseInt((document.getElementById('selected-book-id') || {}).value || '0', 10);
            if (!bid || !bookChapters.length) {
                saveFormatting(function (ok) { resolve(!!ok); }, { silent: true });
                return;
            }
            ensureReaderPages(true);
            syncFmtPreviewLayout();
            syncFormatterPageCountUi();
            saveFormatting(function (ok) {
                if (ok) scheduleFmtExportPreviewReload(true);
                resolve(!!ok);
            }, { silent: true });
        });
    };

    var fmtExportPreviewTimer = null;
    // Interactive book preview is the default — export iframe overlay is opt-in only.
    var fmtExportPreviewVisible = false;

    function setFmtExportPreviewVisible(show) {
        fmtExportPreviewVisible = !!show;
        var wrap = document.getElementById('fmt-export-preview-wrap');
        var stage = document.getElementById('bookStage');
        var shell = document.getElementById('paginatedReaderShell');
        if (wrap) wrap.classList.toggle('hidden', !fmtExportPreviewVisible);
        if (shell) shell.classList.toggle('fmt-show-export-preview', fmtExportPreviewVisible);
        if (stage && fmtExportPreviewVisible) stage.style.display = 'none';
        else if (stage && bookChapters.length) stage.style.display = '';
    }

    function scheduleFmtExportPreviewReload(immediate) {
        if (!fmtExportPreviewVisible) return;
        if (fmtExportPreviewTimer) clearTimeout(fmtExportPreviewTimer);
        fmtExportPreviewTimer = setTimeout(function () {
            fmtExportPreviewTimer = null;
            reloadFmtExportPreview();
        }, immediate ? 0 : 600);
    }

    function reloadFmtExportPreview() {
        var bid = parseInt((document.getElementById('selected-book-id') || {}).value || '0', 10);
        var iframe = document.getElementById('fmt-export-preview-iframe');
        if (!bid || !iframe || !bookChapters.length) return;
        saveFormatting(function (ok) {
            if (!ok) return;
            iframe.src = '/BookDesign/PreviewBookHtml?bookId=' + encodeURIComponent(bid) + '&_=' + Date.now();
        }, { silent: true });
    }

    function setFormatterSaveStatus(text, isError) {
        var el = document.getElementById('formatter-save-status');
        if (!el) return;
        el.textContent = text || '';
        el.classList.toggle('text-red-600', !!isError);
        el.classList.toggle('text-gray-400', !isError);
    }

    var autosaveRetryCount = 0;
    function queueAutosave(delayMs) {
        if (window.EbookUnsavedGuard) window.EbookUnsavedGuard.setDirty();
        if (autosaveTimer) clearTimeout(autosaveTimer);
        autosaveTimer = setTimeout(function() {
            if (autosaveInFlight) {
                autosaveQueued = true;
                return;
            }
            autosaveInFlight = true;
            var bid = parseInt((document.getElementById('selected-book-id') || {}).value || '0', 10);
            setFormatterSaveStatus(bid > 0 ? 'Saving…' : 'Saving on this device…', false);
            saveFormatting(function(ok, info) {
                autosaveInFlight = false;
                info = info || {};
                if (ok) {
                    autosaveRetryCount = 0;
                    if (info.localOnly) {
                        setFormatterSaveStatus('Saved on this device', false);
                    } else {
                        setFormatterSaveStatus('Saved', false);
                    }
                    setTimeout(function () { setFormatterSaveStatus('', false); }, 1600);
                } else {
                    var msg = (info && info.message) ? String(info.message) : 'Could not save right now.';
                    if (info.auth) {
                        setFormatterSaveStatus('Please sign in again.', true);
                        autosaveRetryCount = 0;
                    } else if (info.network && autosaveRetryCount < 3) {
                        autosaveRetryCount++;
                        setFormatterSaveStatus('Could not reach server. Retrying…', true);
                        queueAutosave(1200 * autosaveRetryCount);
                    } else {
                        autosaveRetryCount = 0;
                        setFormatterSaveStatus(msg + ' Your changes stay on this page.', true);
                    }
                }
                if (autosaveQueued) {
                    autosaveQueued = false;
                    queueAutosave(250);
                }
            }, { silent: true });
        }, typeof delayMs === 'number' ? delayMs : 200);
    }

    document.addEventListener('DOMContentLoaded', function() {
