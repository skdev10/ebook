    /** Match AI Book Writer: hide side chevrons when there is nothing to paginate. */
    function syncFormatterSideNavVisibility() {
        var hide = readerPages.length === 0;
        ['btnAiWriterPrevSide', 'btnAiWriterNextSide'].forEach(function(id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.style.visibility = hide ? 'hidden' : '';
        });
