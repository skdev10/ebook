@{
    var formatFromUrl = Model?.Format ?? "Paperback";
    if (formatFromUrl == "Print") { formatFromUrl = "Paperback"; }
    // Formatting studio: Ebook / Paperback / Both only (no Hardcover option here).
    if (string.Equals(formatFromUrl, "Hardcover", StringComparison.OrdinalIgnoreCase)) { formatFromUrl = "Paperback"; }
    if (string.IsNullOrWhiteSpace(formatFromUrl)) { formatFromUrl = "Paperback"; }
    var uid = (Model?.UserId ?? 0) != 0 ? Model.UserId : (ViewBag.UserId ?? 0);
    var __kdpPaper = EBookDashboard.Configuration.KdpSpecsAccessor.Current.PaperThicknessInPerPage;
    var prWhite = ViewBag.PrintReadyWhitePaperMultiplier as double? ?? __kdpPaper.White;
    var prCream = ViewBag.PrintReadyCreamPaperMultiplier as double? ?? __kdpPaper.Cream;
    var prColor = ViewBag.PrintReadyColorPaperMultiplier as double? ?? __kdpPaper.PremiumColor;
    var prBleed = ViewBag.PrintReadyBleedInches as double? ?? 0.125;
    var prTrimW = ViewBag.PrintReadyDefaultTrimWidthInches as double? ?? 6.0;
    var prTrimH = ViewBag.PrintReadyDefaultTrimHeightInches as double? ?? 9.0;
    var initialBookPayloadJson = ViewBag.InitialBookPayloadJson as string ?? "null";
}
<div class="dash-flow-page antialiased" id="book-formatter-root" data-user-id="@uid" data-book-id="@bookId" data-format="@formatFromUrl" data-pr-white="@prWhite.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pr-cream="@prCream.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pr-color="@prColor.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pr-bleed="@prBleed.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pr-trim-w="@prTrimW.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pr-trim-h="@prTrimH.ToString(System.Globalization.CultureInfo.InvariantCulture)">
@Html.AntiForgeryToken()
    <main class="dash-flow-main pb-16 lg:pb-24">
        <div class="dash-flow-inner">
            <div class="mb-4 flex flex-wrap items-center gap-3">
                <button type="button" data-flow-back="@(ViewBag.FlowBackUrl ?? $"/Books/Writer?bookId={bookId}")" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors"><i class="fas fa-arrow-left text-xs"></i> Back</button>
            </div>
            <div class="mb-4" data-guided-flow-only hidden style="display:none">@await Html.PartialAsync("_FlowStepper", 2)</div>
            <div class="fmt-main-layout dash-flow-grid flex flex-col lg:flex-row">
                <!-- Left: AI Book Formatter (your design) -->
                <div id="fmt-left-config-column" class="w-full min-w-0 flex flex-col">
                    <div class="fmt-left-scroll space-y-6 flex-1 pr-1 pb-4">
                        <input type="hidden" id="selected-book-id" value="@bookId" />
                        <div id="formatter-display-author" class="hidden" aria-hidden="true">@((ViewBag.DisplayAuthorName as string) ?? "")</div>

                        @if (Model?.UserBooks != null && Model.UserBooks.Count > 0)
                        {
                            <div class="group" data-guided-tour="fmt-book">
                                <label for="fmt-book-select" class="block text-xs font-semibold text-gray-500 mb-2.5">Change book <span class="font-normal text-gray-400">(optional)</span></label>
                                <div class="relative">
                                    <select id="fmt-book-select" class="fmt-book-select w-full bg-white border border-gray-100 hover:border-gray-200 text-gray-700 rounded-xl py-3.5 pl-4 pr-10 text-sm cursor-pointer shadow-sm appearance-none focus:border-violet-300 focus:ring-2 focus:ring-violet-100 outline-none" aria-label="Select book to format">
                                        @if (bookId <= 0)
                                        {
                                            <option value="0" selected>No book — start blank</option>
                                        }
                                        else
                                        {
                                            <option value="0">No book — start blank</option>
                                        }
                                        @foreach (var b in Model.UserBooks)
                                        {
                                            if (b.BookId == bookId)
                                            {
                                                <option value="@b.BookId" selected>@((b.Title ?? "Untitled").Trim())</option>
                                            }
                                            else
                                            {
                                                <option value="@b.BookId">@((b.Title ?? "Untitled").Trim())</option>
                                            }
                                        }
                                    </select>
                                    <i class="fas fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none" aria-hidden="true"></i>
                                </div>
                            </div>
                        }

                        <div class="group" data-guided-tour="fmt-manuscript">
                            <label class="block text-xs font-semibold text-gray-500 mb-2.5">Manuscript</label>
                            <p class="text-xs text-gray-400 mb-2 leading-snug">Upload your existing manuscript to start formatting. No need to write a new book. DOCX / PDF (TXT, MD also ok).</p>
                            <div class="fmt-ms-row">
                                <input type="file" id="fmt-ms-file" accept=".docx,.pdf,.txt,.md,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="hidden" />
                                <input type="file" id="fmt-ms-image-file" accept=".png,.jpg,.jpeg,.webp,.tif,.tiff,image/png,image/jpeg,image/webp,image/tiff" class="hidden" multiple aria-label="Select one or more book page images" />
                                <button type="button" id="fmt-ms-upload-btn" class="fmt-ms-icon-btn" title="Browse manuscript (DOCX / PDF)" aria-label="Browse manuscript">
                                    <i class="fas fa-file-arrow-up" aria-hidden="true"></i>
                                </button>
                                <button type="button" id="fmt-ms-image-btn" class="fmt-ms-icon-btn fmt-ms-icon-btn--images" title="Select one or more book page images — text is extracted into the preview" aria-label="Upload book page images">
                                    <i class="fas fa-images" aria-hidden="true"></i>
                                </button>
                                <div id="fmt-ms-dropzone" class="fmt-ms-drop-hint" tabindex="0" role="button" aria-label="Drop manuscript file here" title="Drop DOCX or PDF here">
                                    <span class="fmt-ms-drop-hint__icon" aria-hidden="true"><i class="fas fa-cloud-arrow-up"></i></span>
                                    <span class="fmt-ms-drop-hint__text">Drop or Browse</span>
                                </div>
                                <div class="fmt-ms-meta min-w-0 flex-1">
                                    <p id="fmt-ms-last" class="text-xs text-gray-500 mt-0 mb-0 leading-snug truncate">
                                        @{
                                            var msLabel = ViewBag.LastManuscriptUploadedLabel as string ?? "";
                                            var msName = ViewBag.LastManuscriptFileName as string ?? "";
                                            var hasMs = ViewBag.HasManuscriptOnFile as bool? ?? false;
                                        }
                                        @if (!string.IsNullOrEmpty(msLabel))
                                        {
                                            <text>@msLabel@(string.IsNullOrEmpty(msName) ? "" : $" · {msName}")</text>
                                        }
                                        else if (hasMs)
                                        {
                                            <text>On file — tap icon to refresh</text>
                                        }
                                        else
                                        {
                                            <text>No file yet</text>
                                        }
                                    </p>
                                    <p id="fmt-ms-status" class="text-xs min-h-[1.1rem] mt-0.5 mb-0 leading-snug truncate" aria-live="polite"></p>
                                </div>
                            </div>
                        </div>

                        <div class="group" data-guided-tour="fmt-format">
                            <label class="block text-xs font-semibold text-gray-500 mb-2.5" id="format-field-label">Book format</label>
                            <div class="format-select-wrap" id="format-select-wrap">
                                <select id="format-select" class="sr-only" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;" aria-labelledby="format-field-label" title="Book format">
                                    @if (formatFromUrl == "Ebook") { <option value="Ebook" selected>Ebook</option> } else { <option value="Ebook">Ebook</option> }
                                    @if (formatFromUrl == "Paperback") { <option value="Paperback" selected>Paperback</option> } else { <option value="Paperback">Paperback</option> }
                                    @if (formatFromUrl == "Both") { <option value="Both" selected>Both (Ebook + Paperback)</option> } else { <option value="Both">Both (Ebook + Paperback)</option> }
                                </select>
                                <div class="fmt-format-seg" role="radiogroup" aria-labelledby="format-field-label" id="fmt-format-seg">
                                    <button type="button" class="fmt-format-seg__btn@(formatFromUrl == "Ebook" ? " is-active" : "")" role="radio" aria-checked="@(formatFromUrl == "Ebook" ? "true" : "false")" data-value="Ebook">Ebook</button>
                                    <button type="button" class="fmt-format-seg__btn@(formatFromUrl == "Paperback" ? " is-active" : "")" role="radio" aria-checked="@(formatFromUrl == "Paperback" ? "true" : "false")" data-value="Paperback">Paperback</button>
                                    <button type="button" class="fmt-format-seg__btn fmt-format-seg__btn--premium@(formatFromUrl == "Both" ? " is-active" : "")" role="radio" aria-checked="@(formatFromUrl == "Both" ? "true" : "false")" data-value="Both" title="Ebook + Paperback">Both</button>
                                </div>
                            </div>
                            <input type="hidden" id="hiddenCoverFormat" name="CoverFormat" value="@(string.Equals(Model?.Format, "Paperback", StringComparison.OrdinalIgnoreCase) ? "printready" : string.Equals(Model?.Format, "Both", StringComparison.OrdinalIgnoreCase) ? "ebook_paperback" : "ebook")" />
                            <div class="format-premium-banner premium-format-ui-only" id="format-premium-banner" role="status">
                                <span class="premium-crown" aria-hidden="true">&#x1F451;</span>
                                <span><strong>Premium:</strong> Ebook + print workspace.</span>
                            </div>
                        </div>

                        <div class="group" data-guided-tour="fmt-style">
                            <label class="block text-xs font-semibold text-gray-500 mb-2.5">Interior style</label>
                            @{ var curStyle = EBookDashboard.Services.InteriorExportTheme.NormalizeInteriorStyle(Model?.InteriorStyle ?? "Novel"); }
                            <select id="style-select" class="sr-only" tabindex="-1" aria-hidden="true" title="Interior style">
                                <option value="ElegantTradePOD" selected="@(curStyle == "ElegantTradePOD")">Elegant trade (POD)</option>
                                <option value="Traditional" selected="@(curStyle == "Traditional")">Traditional</option>
                                <option value="Novel" selected="@(curStyle == "Novel")">Novel</option>
                                <option value="Contemporary" selected="@(curStyle == "Contemporary")">Contemporary</option>
                                <option value="Modern" selected="@(curStyle == "Modern")">Modern</option>
                                <option value="FineBook" selected="@(curStyle == "FineBook")">Fine book</option>
                                <option value="Classic" selected="@(curStyle == "Classic")">Classic</option>
                                <option value="Clean" selected="@(curStyle == "Clean")">Clean</option>
                                <option value="Minimalist" selected="@(curStyle == "Minimalist")">Minimalist</option>
                                <option value="POD" selected="@(curStyle == "POD")">POD</option>
                                <option value="ElegantTrade" selected="@(curStyle == "ElegantTrade")">Elegant trade</option>
                            </select>
                            <div id="fmt-interior-cards" class="grid grid-cols-2 sm:grid-cols-3 gap-2" role="group" aria-label="Interior style">
                                <button type="button" class="fmt-int-card" data-style="ElegantTradePOD"><span class="fmt-int-card__preview"><span class="fmt-int-card__ch">CHAPTER ONE</span><span class="fmt-int-card__rule"></span><span class="fmt-int-card__body">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do.</span></span><span class="fmt-int-card__name">Elegant trade (POD)</span></button>
                                <button type="button" class="fmt-int-card" data-style="Traditional"><span class="fmt-int-card__preview"><span class="fmt-int-card__ch">Chapter One</span><span class="fmt-int-card__rule"></span><span class="fmt-int-card__body">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do.</span></span><span class="fmt-int-card__name">Traditional</span></button>
                                <button type="button" class="fmt-int-card" data-style="Novel"><span class="fmt-int-card__preview"><span class="fmt-int-card__ch">Chapter One</span><span class="fmt-int-card__rule"></span><span class="fmt-int-card__body">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do.</span></span><span class="fmt-int-card__name">Novel</span></button>
                                <button type="button" class="fmt-int-card" data-style="Contemporary"><span class="fmt-int-card__preview"><span class="fmt-int-card__ch">CHAPTER ONE</span><span class="fmt-int-card__rule"></span><span class="fmt-int-card__body">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do.</span></span><span class="fmt-int-card__name">Contemporary</span></button>
                                <button type="button" class="fmt-int-card" data-style="Modern"><span class="fmt-int-card__preview"><span class="fmt-int-card__ch">Chapter One</span><span class="fmt-int-card__rule"></span><span class="fmt-int-card__body">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do.</span></span><span class="fmt-int-card__name">Modern</span></button>
                                <button type="button" class="fmt-int-card" data-style="FineBook"><span class="fmt-int-card__preview"><span class="fmt-int-card__ch">Chapter One</span><span class="fmt-int-card__rule"></span><span class="fmt-int-card__body">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do.</span></span><span class="fmt-int-card__name">Fine book</span></button>
                                <button type="button" class="fmt-int-card" data-style="Classic"><span class="fmt-int-card__preview"><span class="fmt-int-card__ch">Chapter One</span><span class="fmt-int-card__rule"></span><span class="fmt-int-card__body">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do.</span></span><span class="fmt-int-card__name">Classic</span></button>
                                <button type="button" class="fmt-int-card" data-style="Clean"><span class="fmt-int-card__preview"><span class="fmt-int-card__ch">Chapter One</span><span class="fmt-int-card__rule"></span><span class="fmt-int-card__body">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do.</span></span><span class="fmt-int-card__name">Clean</span></button>
                                <button type="button" class="fmt-int-card" data-style="Minimalist"><span class="fmt-int-card__preview"><span class="fmt-int-card__ch">Chapter One</span><span class="fmt-int-card__rule"></span><span class="fmt-int-card__body">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do.</span></span><span class="fmt-int-card__name">Minimalist</span></button>
                                <button type="button" class="fmt-int-card" data-style="POD"><span class="fmt-int-card__preview"><span class="fmt-int-card__ch">Chapter One</span><span class="fmt-int-card__rule"></span><span class="fmt-int-card__body">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do.</span></span><span class="fmt-int-card__name">POD</span></button>
                                <button type="button" class="fmt-int-card" data-style="ElegantTrade"><span class="fmt-int-card__preview"><span class="fmt-int-card__ch">CHAPTER ONE</span><span class="fmt-int-card__rule"></span><span class="fmt-int-card__body">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do.</span></span><span class="fmt-int-card__name">Elegant trade</span></button>
                            </div>
                        </div>

                        <div class="group">
                            <label class="block text-xs font-semibold text-gray-500 mb-2.5">Text size</label>
                            <select id="text-size-select" class="sr-only" tabindex="-1" aria-hidden="true">
                                @if ((Model?.TextSize ?? "Medium") == "Small") { <option value="Small" selected>Small</option> } else { <option value="Small">Small</option> }
                                @if ((Model?.TextSize ?? "Medium") == "Medium") { <option value="Medium" selected>Medium</option> } else { <option value="Medium">Medium</option> }
                                @if ((Model?.TextSize ?? "") == "Large") { <option value="Large" selected>Large</option> } else { <option value="Large">Large</option> }
                            </select>
                            <div id="fmt-text-size-pills" class="fmt-pill-row" role="group" aria-label="Text size">
                                <button type="button" class="fmt-pill" data-size="Small">Small</button>
                                <button type="button" class="fmt-pill" data-size="Medium">Medium</button>
                                <button type="button" class="fmt-pill" data-size="Large">Large</button>
                            </div>
                        </div>

                        <div class="group">
                            <label class="block text-xs font-semibold text-gray-500 mb-2.5">Line spacing</label>
                            <select id="line-spacing-select" class="sr-only" tabindex="-1" aria-hidden="true">
                                @{ var ls = Model?.LineSpacing ?? "1.6"; }
                                @if (ls == "1.4") { <option value="1.4" selected>1.4</option> } else { <option value="1.4">1.4</option> }
                                @if (ls == "1.6") { <option value="1.6" selected>1.6</option> } else { <option value="1.6">1.6</option> }
                                @if (ls == "1.8") { <option value="1.8" selected>1.8</option> } else { <option value="1.8">1.8</option> }
                                @if (ls == "2") { <option value="2" selected>2</option> } else { <option value="2">2</option> }
                            </select>
                            <div id="fmt-line-pills" class="fmt-pill-row" role="group" aria-label="Line spacing">
                                <button type="button" class="fmt-pill" data-line="1.4">Tight 1.4</button>
                                <button type="button" class="fmt-pill" data-line="1.6">Normal 1.6</button>
                                <button type="button" class="fmt-pill" data-line="1.8">Relaxed 1.8</button>
                                <button type="button" class="fmt-pill" data-line="2">Loose 2</button>
                            </div>
                        </div>

                        @* <div class="group">
                            <label for="fmt-preview-accent" class="block text-xs font-semibold text-gray-500 mb-2.5">Preview accent</label>
                            <p class="text-xs text-gray-400 mb-2">Tints the studio cover mock and borders (saved in your formatting draft).</p>
                            <div class="fmt-accent-wrap">
                                <input type="color" id="fmt-preview-accent" value="#5b21b6" title="Accent color" />
                                <span class="text-xs text-gray-500">Violet theme default — pick any hue for your mock cover.</span>
                            </div>
                        </div> *@

                        <div>
                            <label class="block text-xs font-semibold text-gray-500 mb-2.5">Publishing Platforms</label>
                            <div class="bg-white border border-gray-100 rounded-xl overflow-hidden shadow-sm" id="platforms-container">
                                <div class="platform-block border-b border-gray-50">
                                    <label class="platform-row flex items-start gap-3 p-4 cursor-pointer hover:bg-gray-50 transition-colors">
                                        <input type="checkbox" class="platform-check mt-1 rounded border-gray-300 text-purple-600 focus:ring-purple-500 shrink-0" data-platform="Amazon KDP" />
                                        <span class="text-sm flex-1">Amazon Kindle Publishing (KDP)</span>
                                    </label>
                                </div>
                                <div class="platform-block border-b border-gray-50">
                                    <label class="platform-row flex items-start gap-3 p-4 cursor-pointer hover:bg-gray-50 transition-colors">
                                        <input type="checkbox" class="platform-check mt-1 rounded border-gray-300 text-purple-600 focus:ring-purple-500 shrink-0" data-platform="IngramSpark" />
                                        <span class="text-sm flex-1">IngramSpark</span>
                                    </label>
                                </div>
                                <div class="platform-block border-b border-gray-50">
                                    <label class="platform-row flex items-start gap-3 p-4 cursor-pointer hover:bg-gray-50 transition-colors">
                                        <input type="checkbox" class="platform-check mt-1 rounded border-gray-300 text-purple-600 focus:ring-purple-500 shrink-0" data-platform="Barnes &amp; Noble" />
                                        <span class="text-sm flex-1">Barnes &amp; Noble Press</span>
                                    </label>
                                </div>
                                <div class="platform-block">
                                    <label class="platform-row flex items-start gap-3 p-4 cursor-pointer hover:bg-gray-50 transition-colors">
                                        <input type="checkbox" class="platform-check mt-1 rounded border-gray-300 text-purple-600 focus:ring-purple-500 shrink-0" data-platform="Other stores" />
                                        <span class="text-sm flex-1">Other ebook &amp; print stores</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="mt-4 flex flex-col gap-3" data-guided-tour="fmt-actions" id="fmt-actions-panel">
                        @{ ViewData["ExportPanelId"] = "fmt-inline-exports"; }
                        @await Html.PartialAsync("_ModuleInlineExports")
                        <button type="button" id="btn-next-cover" data-guided-flow-only hidden style="display:none" class="formatter-ui-radius w-full border-2 border-violet-300 text-violet-800 hover:bg-violet-50 font-medium py-2.5 px-6 transition-all inline-flex items-center justify-center gap-2">
                            Next: AI Cover Design <i class="fas fa-arrow-right"></i>
                        </button>
                        <button type="button" id="fmt-btn-reset-formatting" class="formatter-ui-radius w-full border border-slate-200 bg-white text-slate-500 hover:text-slate-700 hover:bg-slate-50 text-sm font-medium py-2 px-6 transition-all inline-flex items-center justify-center gap-2" title="Reset Interior style, Text size, and Line spacing to defaults">
                            <i class="fas fa-rotate-left text-xs" aria-hidden="true"></i> Reset formatting
                        </button>
                        <p id="formatter-save-status" class="text-xs text-gray-400 min-h-[1.25rem] leading-relaxed" aria-live="polite"></p>
                    </div>
                </div>

                <!-- Right: studio preview — aligned with AI Book Writer preview column -->
                <div id="fmt-right-preview-column" class="flex-1 flex flex-col min-w-[300px] min-h-0 overflow-hidden items-stretch">
                    <div class="fmt-preview-stack flex-1 flex flex-col min-h-0 w-full">
                    <div class="fmt-preview-pane dash-flow-preview-pane">
                    <div class="fmt-preview-header shrink-0" id="fmt-preview-accent-host">
                        <div class="flex items-center gap-1.5 mb-0.5">
                            <div class="w-2.5 h-[2px] bg-purple-600"></div>
                            <span id="fmt-preview-mode-label" class="text-purple-700 font-bold text-[10px] uppercase tracking-wide">Book preview · 6×9</span>
                        </div>
                        <h2 id="formatting-preview-title" class="font-serif text-lg sm:text-xl text-gray-900 mb-0 tracking-tight leading-tight">@(bookId > 0 && !string.IsNullOrWhiteSpace(displayTitle) && !displayTitle.Equals("No Book Selected", StringComparison.OrdinalIgnoreCase) ? displayTitle : "Formatting studio")</h2>
                        <p id="fmt-preview-byline" class="hidden text-xs text-slate-600 mb-0" aria-hidden="true"></p>
                    </div>

                    <div id="fmt-studio-stage" class="fmt-studio-stage flex flex-col flex-1 min-h-0">
                            <div class="fmt-interior-canvas flex flex-col min-h-0 min-w-0 flex-1 w-full">
                                <div id="reader-chrome-main" class="reader-chrome-bar w-full hidden mb-2">
                                    <div class="reader-progress-track" aria-hidden="true"><div class="reader-progress-fill" id="reader-progress-fill"></div></div>
                                    <div class="reader-chrome-row">
                                        <label for="reader-chapter-jump">Chapter</label>
                                        <select id="reader-chapter-jump" aria-label="Jump to chapter"></select>
                                    </div>
                                </div>
                                <div id="fmt-studio-preview-toolbar" class="fmt-studio-preview-toolbar mb-2 flex flex-wrap items-center justify-between gap-2 shrink-0 w-full" aria-hidden="true">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <button type="button" id="fmt-btn-studio-preview" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-white shadow-md hover:shadow-lg transition-all duration-200 border-0 cursor-pointer hover:opacity-95 shrink-0" style="background-color:#6d28d9;" title="Refresh interior & cover preview from current settings">
                                            <i class="fas fa-book-open" aria-hidden="true"></i> Preview
                                        </button>
                                        <button type="button" id="fmt-btn-studio-fix" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold bg-white border-2 border-slate-200 text-slate-700 hover:bg-violet-50 hover:border-violet-300 transition-colors shrink-0" title="Jump to formatting settings">
                                            <i class="fas fa-sliders-h" aria-hidden="true"></i> Fix
                                        </button>
                                    </div>
                                    <button type="button" id="fmt-btn-studio-next" data-guided-flow-only hidden style="display:none" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold bg-white border-2 border-slate-200 text-slate-700 hover:bg-violet-50 hover:border-violet-300 transition-colors shrink-0" title="Continue to AI Cover Design">
                                        Next <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <!-- Match AI Book Writer `#bookResult` — book mat + page pills below -->
                                <div id="fmt-book-result" class="fmt-book-result fmt-mat-novel relative flex flex-col flex-1 min-h-0">
                                    <div id="fmt-preview-scroll-host" class="chapter-preview-scroll-host book-preview-stage book-interior-scroll-host flex-1 min-h-0 flex flex-col w-full" data-guided-tour="fmt-preview" data-book-interior-root="1">
                                        <div id="preview-single" class="preview-panel-single flex flex-1 flex-col min-h-0 w-full" tabindex="0">
                                            <div id="paginatedReaderShell" class="paginated-reader-shell book-page-preview-shell reader-content-wrap interior-novel interior-preview-novel relative w-full flex-shrink-0 flex flex-col">
                                                <div id="bookStage" class="book-stage hidden" style="display:none;" aria-hidden="true">
                                                    <div id="bookContainer" class="book-container">
                                                        <div id="pageLayerA" class="book-page-layer" aria-hidden="false">
                                                            <div class="book-page-background"></div>
                                                            <div class="book-page-content-wrap">
                                                                <div id="bookPageRunningHeadA" class="book-page-running-head is-empty" aria-hidden="true"></div>
                                                                <div id="bookPageContentA" class="book-page-content" role="article"></div>
                                                                <div id="bookPageFooterA" class="book-page-footer"></div>
                                                            </div>
                                                        </div>
                                                        <div id="pageLayerB" class="book-page-layer book-page-layer-off" aria-hidden="true">
                                                            <div class="book-page-background"></div>
                                                            <div class="book-page-content-wrap">
                                                                <div id="bookPageRunningHeadB" class="book-page-running-head is-empty" aria-hidden="true"></div>
                                                                <div id="bookPageContentB" class="book-page-content" role="article"></div>
                                                                <div id="bookPageFooterB" class="book-page-footer"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div id="bookPageIndicator" class="book-page-indicator" aria-live="polite">1 / 1</div>
