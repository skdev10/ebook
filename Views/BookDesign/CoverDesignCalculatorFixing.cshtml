@model EBookDashboard.Models.ViewModels.CoverDesignCalculatorVM
@{
    ViewData["Title"] = "Book Formatter";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var bookId = Model?.BookId ?? 0;
    var userId = Model?.UserId ?? 0;
    var displayTitle = (Model?.Title ?? "").Trim();
    if (string.IsNullOrEmpty(displayTitle) || displayTitle.Equals("No Book Selected", StringComparison.OrdinalIgnoreCase))
        displayTitle = bookId > 0 ? ("Book #" + bookId) : "";
    var displayAuthor = (ViewBag.DisplayAuthorName as string ?? "").Trim();
    var bylineText = string.IsNullOrWhiteSpace(displayAuthor) ? "" : ("by " + displayAuthor);
}
