                currentPageIdx = o.page;
            }
        } catch (e) { /* ignore */ }
    }

    function splitLongText(text, maxChunk) {
        const out = [];
        let s = (text || '').trim();
        if (!s) return out;
        while (s.length > maxChunk) {
            var cut = s.lastIndexOf(' ', maxChunk);
            if (cut < Math.floor(maxChunk * 0.45)) cut = maxChunk;
            out.push(s.substring(0, cut).trim());
            s = s.substring(cut).trim();
        }
        if (s) out.push(s);
        return out;
    }

    /** Split oversized HTML on closing </p> boundaries so tags stay intact. */
    function splitHtmlByApproxSize(html, maxChars) {
        var s = String(html);
        var pieces = [];
        var curStart = 0;
        var re = /<\/p\s*>/gi;
        var m;
        while ((m = re.exec(s)) !== null) {
            var end = m.index + m[0].length;
            var piece = s.substring(curStart, end).trim();
            curStart = end;
            if (piece) pieces.push(piece);
        }
        if (curStart < s.length) {
            var tail = s.substring(curStart).trim();
            if (tail) pieces.push(tail);
        }
        if (!pieces.length) {
            if (s.length <= maxChars) return [s];
            var st = s.replace(/<[^>]+>/g, ' ');
            return splitLongText(st, maxChars);
        }
        var out = [];
        var buf = '';
        for (var i = 0; i < pieces.length; i++) {
            if (!buf.length) {
                buf = pieces[i];
            } else if (buf.length + pieces[i].length + 2 <= maxChars) {
                buf += '\n\n' + pieces[i];
            } else {
                out.push(buf);
                buf = pieces[i];
            }
        }
        if (buf) out.push(buf);
        for (var j = 0; j < out.length; j++) {
            if (out[j].length > maxChars) {
                var stripped = out[j].replace(/<[^>]+>/g, ' ');
                out[j] = splitLongText(stripped, maxChars).join('\n\n');
            }
        }
        return out.length ? out : [s];
    }

    /** Top-level block nodes from parsed HTML (avoids breaking tags mid-chapter). */
    function splitHtmlChapterIntoBlocks(html) {
        var s = String(html || '').trim();
        if (!s) return [];
        try {
            var doc = new DOMParser().parseFromString(s, 'text/html');
            var body = doc.body;
            if (!body) return [s];
            var blocks = [];
            for (var i = 0; i < body.childNodes.length; i++) {
                var n = body.childNodes[i];
                if (n.nodeType === 1) blocks.push(n.outerHTML);
            }
            if (!blocks.length && body.innerHTML && body.innerHTML.trim()) {
                return [body.innerHTML.trim()];
            }
            if (blocks.length === 1) {
                var el = body.firstElementChild;
                if (el && el.tagName === 'DIV' && el.children && el.children.length > 1) {
                    var inner = [];
                    for (var k = 0; k < el.children.length; k++) {
                        inner.push(el.children[k].outerHTML);
                    }
                    if (inner.length > 1) return inner;
                }
            }
            return blocks.length ? blocks : [s];
        } catch (e) {
            return [s];
        }
    }

    /** Split chapter body into logical blocks for pagination (handles single \\n manuscripts and long HTML). */
    function splitChapterIntoParas(raw) {
        const content = (raw || '').toString().trim();
        if (!content) return [];
        const looksLikeHtml = /<\s*(p|h1|h2|h3|h4|blockquote|ul|ol|li|br|div)\b/i.test(content);
        var paras;
        if (looksLikeHtml) {
            paras = splitHtmlChapterIntoBlocks(content);
            if (!paras.length) paras = [content];
            if (paras.length === 1) {
                var one = paras[0];
                if (one.length > CONTENT_CHARS_SOFT_LIMIT) {
                    var brPieces = one.split(/<br\s*\/?>/i).map(function(x) { return x.trim(); }).filter(Boolean);
                    if (brPieces.length > 8) {
                        paras = brPieces;
                    } else {
                        paras = splitHtmlByApproxSize(one, Math.max(CONTENT_CHARS_SOFT_LIMIT * 2, 8000));
                    }
                }
            }
        } else {
            paras = content.split(/\n\n+/).filter(Boolean);
            if (paras.length === 1 && paras[0].length > CONTENT_CHARS_SOFT_LIMIT) {
                paras = splitLongText(paras[0], CONTENT_CHARS_SOFT_LIMIT);
            } else if (paras.length === 1 && /\n/.test(paras[0])) {
                paras = [paras[0].replace(/\n+/g, ' ').replace(/\s{2,}/g, ' ').trim()];
            }
        }
        // Keep headings attached to following text block so preview never shows heading-only pages.
        paras = mergeHeadingOnlyBlocks(paras);
        return paras;
    }

    function mergeHeadingOnlyBlocks(paras) {
        var list = Array.isArray(paras) ? paras.slice() : [];
        if (!list.length) return list;
        var out = [];
        for (var i = 0; i < list.length; i++) {
            var block = String(list[i] || '').trim();
            if (!block) continue;
            if (!out.length) {
                out.push(block);
                continue;
            }
            var isMarkdownHeading = /^#{1,6}\s+/.test(block);
            var isHtmlHeading = /^<h[1-6]\b[^>]*>[\s\S]*<\/h[1-6]>$/i.test(block);
            var isHeadingOnly = isMarkdownHeading || isHtmlHeading;
            if (isHeadingOnly && i < list.length - 1) {
                var next = String(list[i + 1] || '').trim();
                if (next) {
                    out.push(block + '\n\n' + next);
                    i++;
                    continue;
                }
            }
            out.push(block);
        }
        return out;
    }

    function getFmtTrimLabel() {
        var w = printReadyConfig.defaultTrimW || 6;
        var h = printReadyConfig.defaultTrimH || 9;
        return fmtNumber(w, 1) + ' × ' + fmtNumber(h, 1) + ' in';
    }

    /** Character budget per 6×9 page from trim size + typography (formatter preview). */
    function getFmtPageCharBudgets() {
        var sizeEl = document.getElementById('text-size-select');
        var size = sizeEl ? sizeEl.value : 'Medium';
        var mult = size === 'Small' ? 1.1 : (size === 'Large' ? 0.84 : 1);
        var trimW = printReadyConfig.defaultTrimW || 6;
        var trimH = printReadyConfig.defaultTrimH || 9;
        var areaFactor = (trimW * trimH) / 54;
        return {
            cont: Math.max(600, Math.round(1350 * areaFactor * mult)),
            first: Math.max(450, Math.round(900 * areaFactor * mult)),
            trimLabel: getFmtTrimLabel()
        };
    }

    /** Group paragraphs into page-sized chunks for 6×9 paginated preview. */
    function chunkParasIntoPages(paras, firstBudget, contBudget) {
        var budgets = getFmtPageCharBudgets();
        firstBudget = firstBudget != null ? firstBudget : budgets.first;
        contBudget = contBudget != null ? contBudget : budgets.cont;
        var chunks = [];
        var current = [];
        var size = 0;
        var budget = firstBudget;
        (paras || []).forEach(function(p) {
            var block = (p || '').trim();
            if (!block) return;
            var plen = block.length;
            if (current.length && size + plen + 2 > budget) {
                chunks.push(current);
                current = [];
                size = 0;
                budget = contBudget;
            }
            current.push(block);
            size += plen + (current.length > 1 ? 2 : 0);
        });
        if (current.length) chunks.push(current);
        return chunks.length ? chunks : [[]];
    }

    /** Split any oversized blocks so Next/Previous always has meaningful steps. */
    function expandParasForPaging(paras) {
        var maxPlain = 50000;
        var maxHtml = 100000;
        var out = [];
        (paras || []).forEach(function(p) {
            var s = (p || '').trim();
            if (!s) return;
            var isHtml = /<\s*[a-z]/i.test(s);
            if (isHtml) {
                if (s.length <= maxHtml) out.push(s);
                else Array.prototype.push.apply(out, splitHtmlByApproxSize(s, maxHtml));
            } else {
                if (s.length <= maxPlain) out.push(s);
                else Array.prototype.push.apply(out, splitLongText(s, maxPlain));
            }
        });
        return out;
    }

    var fmtRepaginateTimer = null;

    function getFmtMeasureShellWidth() {
        var shell = document.getElementById('paginatedReaderShell');
        if (shell && shell.clientWidth > 48) return shell.clientWidth;
        shell = document.getElementById('paginatedReaderShellEbook');
        return (shell && shell.clientWidth > 48) ? shell.clientWidth : 0;
    }

    /** Available scroll height inside the live `.book-page-content` slot (matches on-screen reader). */
    function getFmtContentAreaHeightPx() {
        var contentEl = document.getElementById('bookPageContentA');
        if (contentEl && contentEl.clientHeight >= 80) return contentEl.clientHeight;
        var shell = document.getElementById('paginatedReaderShell');
        if (shell && shell.clientHeight >= 80) {
            var wrapPad = 20;
            var footerReserve = 34;
            return Math.max(160, shell.clientHeight - wrapPad - footerReserve);
        }
        var w = getFmtMeasureShellWidth();
        if (w >= 48) {
            var shellH = Math.floor(w * (9 / 6));
            return Math.max(160, Math.floor(shellH * 0.88) - 20);
        }
        return 520;
    }

    function getFmtPageMaxHeightPx() {
        return getFmtContentAreaHeightPx();
    }

    function fmtCanMeasurePages() {
        return getFmtMeasureShellWidth() > 48 && getFmtPageMaxHeightPx() > 80;
    }

    function getFmtPaginatedShells() {
        return [
            document.getElementById('paginatedReaderShell'),
            document.getElementById('paginatedReaderShellEbook'),
            document.getElementById('paginatedReaderShellPaperback')
        ].filter(Boolean);
    }

    function getFmtMeasureInteriorClass() {
        var shell = document.getElementById('paginatedReaderShell');
        if (!shell) return 'paginated-reader-shell reader-content-wrap interior-novel';
        var interiorCls = 'interior-novel';
        shell.classList.forEach(function(c) {
            if (c.indexOf('interior-') === 0) interiorCls = c;
        });
        return 'paginated-reader-shell reader-content-wrap ' + interiorCls;
    }

    function syncFmtMeasureTypography(viewportEl) {
        if (!viewportEl) return;
        var vp = document.getElementById('preview-content');
        if (!vp) return;
        applyPreviewStyles(vp);
        var rs = window.getComputedStyle(vp);
        viewportEl.style.fontSize = vp.style.fontSize || rs.fontSize;
        viewportEl.style.lineHeight = vp.style.lineHeight || rs.lineHeight;
        viewportEl.style.textAlign = vp.style.textAlign || rs.textAlign;
        viewportEl.style.fontFamily = rs.fontFamily;
    }

    /** Measure block height using the same DOM/CSS as the paginated book stage (not the legacy viewport). */
    function renderFmtMeasureSandbox(blockInnerHtml) {
        var mh = document.getElementById('fmt-preview-measure-host');
        if (!mh) return null;
        var w = getFmtMeasureShellWidth();
        if (w < 48) return null;

        var styleEl = document.getElementById('style-select');
        var interior = styleEl ? String(styleEl.value || 'Novel') : 'Novel';
        var contentCls = interiorStyleClassMap[interior] || interiorStyleClassMap['Novel'];
        var shellCls = interiorPreviewShellMap[interior] || interiorPreviewShellMap['Novel'];
        var stage = document.getElementById('bookStage');
        var maxH = getFmtPageMaxHeightPx();
        var footerH = 28;
        var wrapH = maxH + footerH + 20;

        mh.style.width = w + 'px';
        mh.style.padding = '0';
        mh.style.boxSizing = 'border-box';
        mh.innerHTML =
            '<div class="paginated-reader-shell reader-content-wrap ' + shellCls + '" style="width:' + w + 'px;padding:0;border:0;box-shadow:none;aspect-ratio:auto;height:' + wrapH + 'px;min-height:0;display:flex;flex-direction:column">' +
            '<div class="book-container" style="width:100%;height:100%;display:flex;flex-direction:column">' +
            '<div class="book-page-content-wrap" style="padding:8px 18px 12px;box-sizing:border-box;flex:1;min-height:0;display:flex;flex-direction:column">' +
            '<div class="book-page-content ' + contentCls + '" style="overflow:hidden;flex:1;min-height:0">' +
            (blockInnerHtml || '') +
            '</div><div class="book-page-footer" style="flex-shrink:0;height:' + footerH + 'px"></div></div></div></div>';

        var contentEl = mh.querySelector('.book-page-content');
        if (!contentEl) return null;
        if (stage) {
            var fs = stage.style.getPropertyValue('--fmt-font-size') || window.getComputedStyle(stage).getPropertyValue('--fmt-font-size');
            var lh = stage.style.getPropertyValue('--fmt-line-height') || window.getComputedStyle(stage).getPropertyValue('--fmt-line-height');
            if (fs && fs.trim()) contentEl.style.setProperty('--fmt-font-size', fs.trim());
            if (lh && lh.trim()) contentEl.style.setProperty('--fmt-line-height', lh.trim());
        }
        applyPreviewStyles(contentEl);
        return contentEl;
    }

    function measureFmtPageBlock(blockInnerHtml) {
        var contentEl = renderFmtMeasureSandbox(blockInnerHtml);
        return contentEl ? contentEl.scrollHeight : 999999;
    }

    function fmtPageContentFits(blockInnerHtml) {
        var contentEl = renderFmtMeasureSandbox(blockInnerHtml);
        if (!contentEl) return false;
        return contentEl.scrollHeight <= contentEl.clientHeight + 2;
    }

    function measureFmtArticleInner(articleInnerHtml) {
        return measureFmtPageBlock('<div class="reader-chapter-block">' + articleInnerHtml + '</div>');
    }

    function stripEmbeddedPageFooters(pageHtml) {
        return String(pageHtml || '').replace(/<footer[^>]*>[\s\S]*?<\/footer>/gi, '');
    }

    function splitOversizedFmtBodyHtml(bodyHtml, measureFn) {
        var mh = document.getElementById('fmt-preview-measure-host');
        if (!mh || !bodyHtml) return [bodyHtml || ''];
        var tmp = document.createElement('div');
        tmp.innerHTML = bodyHtml;
        var nodes = Array.prototype.slice.call(tmp.childNodes).filter(function(n) {
            return n.nodeType === 1 || (n.nodeType === 3 && (n.textContent || '').trim());
        });
        if (!nodes.length) return [bodyHtml];
        if (nodes.length === 1 && nodes[0].nodeType === 1) {
            var el = nodes[0];
            var text = (el.textContent || '').trim();
            var words = text.split(/\s+/).filter(Boolean);
            if (words.length > 1 && measureFn(bodyHtml) > getFmtPageMaxHeightPx()) {
                var tag = el.tagName ? el.tagName.toLowerCase() : 'p';
                var openTag = '<' + tag + (el.className ? ' class="' + el.className + '"' : '') + '>';
                var closeTag = '</' + tag + '>';
                var out = [];
                var start = 0;
                while (start < words.length) {
                    var lo = start + 1;
                    var hi = words.length;
                    var best = start;
                    while (lo <= hi) {
                        var mid = (lo + hi) >> 1;
                        var chunk = words.slice(start, mid).join(' ');
                        var trial = openTag + escapeHtml(chunk) + closeTag;
                        if (measureFn(trial) <= getFmtPageMaxHeightPx()) {
                            best = mid;
                            lo = mid + 1;
                        } else hi = mid - 1;
                    }
                    if (best <= start) best = start + 1;
                    out.push(openTag + escapeHtml(words.slice(start, best).join(' ')) + closeTag);
                    start = best;
                }
                return out.length ? out : [bodyHtml];
            }
        }
        var segments = [];
        nodes.forEach(function(n) {
            if (n.nodeType === 1) segments.push(n.outerHTML);
            else segments.push('<p>' + escapeHtml((n.textContent || '').trim()) + '</p>');
        });
        var pages = [];
        var acc = '';
        for (var i = 0; i < segments.length; i++) {
            var seg = segments[i];
            var combined = acc ? (acc + seg) : seg;
            if (measureFn(combined) > getFmtPageMaxHeightPx() && acc) {
                pages.push(acc);
                acc = seg;
                if (measureFn(acc) > getFmtPageMaxHeightPx()) {
                    var subs = splitOversizedFmtBodyHtml(seg, measureFn);
                    for (var s = 0; s < subs.length; s++) pages.push(subs[s]);
                    acc = '';
                }
            } else {
                acc = combined;
            }
        }
        if (acc) pages.push(acc);
        return pages.length ? pages : [bodyHtml];
    }

    function packFmtBodySegments(segments, measureFn) {
        if (!segments.length) return [''];
        var pages = [];
        var acc = '';
        for (var i = 0; i < segments.length; i++) {
            var seg = segments[i];
            if (!seg) continue;
            var combined = acc ? (acc + seg) : seg;
            if (measureFn(combined) > getFmtPageMaxHeightPx() && acc) {
                pages.push(acc);
                acc = seg;
                if (measureFn(acc) > getFmtPageMaxHeightPx()) {
                    var subs = splitOversizedFmtBodyHtml(seg, measureFn);
                    for (var s = 0; s < subs.length; s++) pages.push(subs[s]);
                    acc = '';
                }
            } else {
                acc = combined;
            }
        }
        if (acc) pages.push(acc);
        return pages.length ? pages : [''];
    }

    function getFmtPageFillRatio(bodyHtml, measureFn) {
        var maxH = getFmtPageMaxHeightPx();
        if (maxH <= 0) return 0;
        return Math.max(0, Math.min(1, measureFn(bodyHtml) / maxH));
    }

    function pullTrailingHeadingBlock(bodyHtml) {
        var html = String(bodyHtml || '').trim();
        if (!html) return null;
        var tmp = document.createElement('div');
        tmp.innerHTML = html;
        var children = Array.prototype.slice.call(tmp.children || []);
        if (!children.length) return null;
        var last = children[children.length - 1];
        if (!last || !/^h[1-6]$/i.test(last.tagName || '')) return null;
        if (children.length <= 1) return null;
        var moved = last.outerHTML;
        children.pop();
        var remain = children.map(function(n) { return n.outerHTML; }).join('');
        if (!remain.trim()) return null;
        return { bodyWithoutHeading: remain, headingHtml: moved };
    }

    function splitSegmentForRemainingSpace(segmentHtml, currentBodyHtml, measureFn) {
        var seg = String(segmentHtml || '').trim();
        if (!seg) return null;
        var tmp = document.createElement('div');
        tmp.innerHTML = seg;
        if (!tmp.firstElementChild || tmp.children.length !== 1) return null;
        var el = tmp.firstElementChild;
        var tag = (el.tagName || '').toLowerCase();
        if (!/^p$/.test(tag)) return null;
        var words = (el.textContent || '').split(/\s+/).filter(Boolean);
        if (words.length < 2) return null;

        var attrs = '';
        if (el.className) attrs += ' class="' + escapeHtml(el.className) + '"';
        var openTag = '<' + tag + attrs + '>';
        var closeTag = '</' + tag + '>';
        var base = String(currentBodyHtml || '');
        var lo = 1;
        var hi = words.length - 1;
        var best = 0;
        while (lo <= hi) {
            var mid = (lo + hi) >> 1;
            var candidate = openTag + escapeHtml(words.slice(0, mid).join(' ')) + closeTag;
            if (measureFn(base + candidate) <= getFmtPageMaxHeightPx()) {
                best = mid;
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        if (best <= 0) return null;
        var fit = openTag + escapeHtml(words.slice(0, best).join(' ')) + closeTag;
        var restWords = words.slice(best);
        var rest = restWords.length ? (openTag + escapeHtml(restWords.join(' ')) + closeTag) : '';
        return { fitHtml: fit, restHtml: rest };
    }

    function classicParaToBodySegment(para, dropCap) {
        var block = (para || '').trim();
        if (!block) return '';
        var looksLikeHtml = /<\s*(p|h1|h2|h3|h4|blockquote|ul|ol|li|br)\b/i.test(block);
        if (looksLikeHtml || chunkNeedsManuscriptRender(block)) {
            var html = formatChapterContent(block);
            if (dropCap) html = html.replace('<p class="manuscript-p">', '<p class="manuscript-p classic-first-para">').replace('<p>', '<p class="classic-first-para">');
            return html;
        }
        return '<p' + (dropCap ? ' class="classic-first-para"' : '') + '>' + escapeHtml(block).replace(/\n/g, '<br>') + '</p>';
    }

    function novelParaToBodySegment(para) {
        var block = (para || '').trim();
        if (!block) return '';
        return formatChapterContent(block);
    }

    function flattenToFlowSegments(htmlSegments) {
        var out = [];
        (htmlSegments || []).forEach(function(seg) {
            var s = String(seg || '').trim();
            if (!s) return;
            var tmp = document.createElement('div');
            tmp.innerHTML = s;
            if (!tmp.children.length) {
                out.push(s);
                return;
            }
            for (var i = 0; i < tmp.children.length; i++) {
                out.push(tmp.children[i].outerHTML);
            }
        });
        return out;
    }

    function buildReaderPageBlockHtml(bodyHtml, opts) {
        opts = opts || {};
        var titleBlock = (opts.includeTitle && !opts.hasBodyLeadingHeading)
            ? ('<article class="reader-page-title">' + escapeHtml(opts.title || '') + '</article>')
            : '';
        var bodyClass = opts.isClassic ? 'reader-page-body classic-body' : 'reader-page-body';
        var chapterAttr = opts.chapterStart ? ' data-chapter-start="1"' : '';
        return '<div class="reader-chapter-block"' + chapterAttr + '>' + titleBlock +
            '<section class="' + bodyClass + '">' + bodyHtml + '</section></div>';
    }

    function splitFlowSegmentByWords(segHtml, opts, prefixBody) {
        var seg = String(segHtml || '').trim();
        if (!seg) return [];
        var tmp = document.createElement('div');
        tmp.innerHTML = seg;
        var el = tmp.firstElementChild;
        if (!el) return [seg];
        var tag = (el.tagName || 'p').toLowerCase();
        if (!/^p$/.test(tag)) return [seg];
        var words = (el.textContent || '').split(/\s+/).filter(Boolean);
        if (words.length < 2) return [seg];
        var cls = el.className ? (' class="' + escapeHtml(el.className) + '"') : '';
        var openTag = '<' + tag + cls + '>';
        var closeTag = '</' + tag + '>';
        var parts = [];
        var start = 0;
        var base = String(prefixBody || '');
        while (start < words.length) {
            var lo = start + 1;
            var hi = words.length;
            var best = start;
            while (lo <= hi) {
                var mid = (lo + hi) >> 1;
                var chunk = openTag + escapeHtml(words.slice(start, mid).join(' ')) + closeTag;
                var block = buildReaderPageBlockHtml(base + chunk, opts);
                if (fmtPageContentFits(block)) {
                    best = mid;
                    lo = mid + 1;
                } else {
                    hi = mid - 1;
                }
            }
            if (best <= start) best = start + 1;
            parts.push(openTag + escapeHtml(words.slice(start, best).join(' ')) + closeTag);
            start = best;
            base = '';
            opts = Object.assign({}, opts, { includeTitle: false, chapterStart: false });
        }
        return parts.length ? parts : [seg];
    }

    /** Greedy height-based pagination — packs flow segments until the page is full. */
    function paginateChapterFlow(rawSegments, opts) {
        opts = opts || {};
        var flat = flattenToFlowSegments(rawSegments);
        var pages = [];
        if (!flat.length) return pages;

        var acc = '';
        var includeTitle = true;
        var chapterStart = !!opts.chapterStart;

        function pageOpts() {
            return {
                includeTitle: includeTitle,
                hasBodyLeadingHeading: opts.hasBodyLeadingHeading,
                title: opts.title,
                isClassic: opts.isClassic,
                chapterStart: chapterStart
            };
        }

        function pushPage(bodyHtml, po) {
            pages.push(buildReaderPageBlockHtml(bodyHtml, po));
            includeTitle = false;
            chapterStart = false;
        }

        for (var i = 0; i < flat.length; i++) {
            var seg = flat[i];
            var trial = acc ? (acc + seg) : seg;
            if (fmtPageContentFits(buildReaderPageBlockHtml(trial, pageOpts()))) {
                acc = trial;
                continue;
            }
            if (acc) {
                pushPage(acc, pageOpts());
                acc = '';
                i--;
                continue;
            }
            var wordParts = splitFlowSegmentByWords(seg, pageOpts(), '');
            for (var wi = 0; wi < wordParts.length; wi++) {
                var part = wordParts[wi];
                var po = pageOpts();
                if (fmtPageContentFits(buildReaderPageBlockHtml(part, po))) {
                    pushPage(part, po);
                } else {
                    pushPage(part, po);
                }
            }
        }
        if (acc) pushPage(acc, pageOpts());
        return pages;
    }

    function finalizeReaderPages(pages, chapterIdxs) {
        if (!pages.length) return { pages: pages, chapterIdxs: chapterIdxs };
        var merged = mergeUnderfilledReaderPages(pages, chapterIdxs);
        merged = pullOrphansToFillPages(merged.pages, merged.chapterIdxs);
        return merged;
    }

    function pullOrphansToFillPages(pages, chapterIdxs) {
        if (!Array.isArray(pages) || pages.length < 2 || !fmtCanMeasurePages()) {
            return { pages: pages, chapterIdxs: chapterIdxs };
        }
        var maxH = getFmtPageMaxHeightPx();
        var outP = pages.slice();
        var outC = chapterIdxs.slice();

        for (var pass = 0; pass < 4; pass++) {
            var moved = false;
            for (var i = 0; i < outP.length - 1; i++) {
                if (outC[i] !== outC[i + 1]) continue;
                if (outP[i + 1].indexOf('data-chapter-start') >= 0) continue;
                var h = measureFmtPageBlock(stripEmbeddedPageFooters(outP[i]));
                if (h / maxH >= 0.72) continue;

                var nextBody = outP[i + 1].match(/(<section class="reader-page-body[^"]*">)([\s\S]*?)(<\/section>)/);
                if (!nextBody || !nextBody[2].trim()) continue;
                var firstBlockMatch = nextBody[2].match(/^(\s*<(?:p|h[1-6]|li|blockquote)[^>]*>[\s\S]*?<\/(?:p|h[1-6]|li|blockquote)>)/i);
                if (!firstBlockMatch) continue;
                var block = firstBlockMatch[1];
                if (wordCountInHtml(block) > 12) continue;

                var curBody = outP[i].match(/(<section class="reader-page-body[^"]*">)([\s\S]*?)(<\/section>)/);
                if (!curBody) continue;
                var mergedBody = curBody[2] + block;
                var mergedPage = outP[i].replace(curBody[0], curBody[1] + mergedBody + curBody[3]);
                if (!fmtPageContentFits(stripEmbeddedPageFooters(mergedPage))) continue;

                outP[i] = mergedPage;
                var remain = nextBody[2].slice(block.length).trim();
                if (!remain && outP[i + 1].indexOf('reader-page-title') < 0) {
                    outP.splice(i + 1, 1);
                    outC.splice(i + 1, 1);
                } else {
                    outP[i + 1] = outP[i + 1].replace(nextBody[0], nextBody[1] + remain + nextBody[3]);
                }
                moved = true;
            }
            if (!moved) break;
        }

        var filtered = [];
        var filteredC = [];
        for (var j = 0; j < outP.length; j++) {
            var bm = outP[j].match(/<section class="reader-page-body[^"]*">([\s\S]*?)<\/section>/);
            if (bm && !stripHtmlTags(bm[1]).length && outP[j].indexOf('reader-page-title') < 0) continue;
            filtered.push(outP[j]);
            filteredC.push(outC[j]);
        }
        return { pages: filtered.length ? filtered : outP, chapterIdxs: filtered.length ? filteredC : outC };
    }

    function estimateBodyLeadLines(bodyHtml) {
        var html = String(bodyHtml || '');
        if (!html) return 0;
        var paraCount = (html.match(/<(p|li)\b/gi) || []).length;
        if (paraCount > 0) return paraCount;
        var text = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
        if (!text) return 0;
        var sentenceCount = text.split(/[.!?]+/).map(function(s) { return s.trim(); }).filter(Boolean).length;
        if (sentenceCount > 0) return sentenceCount;
        return Math.max(1, Math.ceil(text.split(/\s+/).filter(Boolean).length / 14));
    }

