                imageInput.addEventListener('change', async function () {
                    var selected = imageInput.files ? Array.prototype.slice.call(imageInput.files) : [];
                    imageInput.value = '';
                    if (currentBookId() > 0) {
                        setMsStatus('Image import works only when no book is selected.', false);
                        syncFmtImageUploadAvailability();
                        return;
                    }
                    var images = selected.filter(function (file) {
                        return file && (/^image\//i.test(file.type || '') || /\.(png|jpe?g|webp|tiff?|bmp)$/i.test(file.name || ''));
                    });
                    if (!images.length) {
                        setMsStatus('Select PNG or JPG book page images.', false);
                        return;
                    }

                    imageBtn.disabled = true;
                    uploadBtn.disabled = true;
                    var extractedPages = [];
                    var failed = 0;
                    try {
                        for (var i = 0; i < images.length; i++) {
                            setMsStatus('Reading image ' + (i + 1) + ' of ' + images.length + '…', true);
                            try {
                                var fd = new FormData();
                                fd.append('file', images[i]);
                                var response = await fetch('/Books/OcrChapterImage', {
                                    method: 'POST',
                                    body: fd,
                                    credentials: 'same-origin'
                                });
                                var result = await response.json().catch(function () { return null; });
                                if (!response.ok || !result || !result.success || !String(result.text || '').trim()) {
                                    failed++;
                                    continue;
                                }
                                extractedPages.push(String(result.text).trim());
                            } catch (ocrError) {
                                failed++;
                                console.warn('Formatting OCR image failed', images[i] && images[i].name, ocrError);
                            }
                        }

                        if (!extractedPages.length) {
