    function storageReaderKey(bid) {
        return 'ebook_reader_pos_' + bid;
    }

    function persistReaderPosition() {
        const hid = document.getElementById('selected-book-id');
        const bid = parseInt((hid && hid.value) || '0', 10);
        if (!bid || readerPages.length === 0) return;
        try {
