    function normPlaceholderKey(k) {
        return String(k || '').trim().toLowerCase().replace(/\s+/g, '');
    }

    function applyTemplatePlaceholders(raw, ctx) {
        if (raw == null) return '';
        var s = String(raw);
        if (!s || !ctx) return s;
        function lookup(key) {
            var nk = normPlaceholderKey(key);
            switch (nk) {
                case 'title':
                case 'booktitle':
                    return ctx.bookTitle != null ? String(ctx.bookTitle) : '';
                case 'subtitle':
                    return ctx.subtitle != null ? String(ctx.subtitle) : '';
                case 'description':
                    return ctx.description != null ? String(ctx.description) : '';
                case 'genre':
                    return ctx.genre != null ? String(ctx.genre) : '';
                case 'author':
                case 'authorname':
                    return ctx.authorName != null ? String(ctx.authorName) : '';
                case 'chaptertitle':
                case 'chapter':
                    return ctx.chapterTitle != null ? String(ctx.chapterTitle) : '';
                case 'chapternumber':
                case 'chapterno':
                    return ctx.chapterNumber != null && ctx.chapterNumber !== '' ? String(ctx.chapterNumber) : '';
                case 'displaychapternumber':
                    return ctx.displayChapterNumber != null && ctx.displayChapterNumber !== '' ? String(ctx.displayChapterNumber) : '';
                default:
                    return null;
            }
        }
        s = s.replace(/\[\s*([^\]]+?)\s*\]/g, function(full, key) {
            var v = lookup(key);
            return v !== null ? v : full;
        });
        s = s.replace(/\{\{\s*([^}]+?)\s*\}\}/g, function(full, key) {
            var v = lookup(key);
            return v !== null ? v : full;
        });
        return s;
    }

    function normalizeManuscriptEscapes(str) {
        if (str == null || str === '') return '';
        var t = String(str);
        t = t.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
        var prev;
        do {
            prev = t;
            t = t.replace(/\\r\\n/g, '\n').replace(/\\n/g, '\n').replace(/\\r/g, '\n');
        } while (t !== prev);
        return t;
    }

    function getContentFromPossibleJson(value) {
        if (value == null || value === '') return '';
        var s = (typeof value === 'string') ? value : JSON.stringify(value);
        var t = s.trim();
        if (!t) return '';
        if (t.charAt(0) !== '{' && t.charAt(0) !== '[') return s;
        try {
            var o = typeof value === 'object' ? value : JSON.parse(s);
            if (o && typeof o === 'object') {
                if (o.data && o.data.content != null && (o.data.content + '').trim()) return (o.data.content + '').trim();
                if (o.content != null && (o.content + '').trim()) return (o.content + '').trim();
                if (o.data && o.data.chapters && Array.isArray(o.data.chapters) && o.data.chapters.length > 0) {
                    var first = o.data.chapters[0];
                    var c = (first.content != null ? first.content : first.Content) + '';
                    if (c.trim()) return c.trim();
                }
                if (o.chapters && Array.isArray(o.chapters) && o.chapters.length > 0) {
                    var first2 = o.chapters[0];
                    var c2 = (first2.content != null ? first2.content : first2.Content) + '';
                    if (c2.trim()) return c2.trim();
                }
                if (o.data && typeof o.data === 'string' && o.data.trim()) return o.data.trim();
            }
            return s;
        } catch (e) { return s; }
    }

    function stripDuplicateLeadingHeading(title, contentHtml) {
        var titleText = String(title || '').trim().toLowerCase();
        var html = String(contentHtml || '').trim();
        if (!titleText || !html) return html;
        try {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var first = doc.body && doc.body.firstElementChild ? doc.body.firstElementChild : null;
            if (!first || !/^h[1-6]$/i.test(first.tagName || '')) return html;
            var headText = String(first.textContent || '').trim().toLowerCase().replace(/\s+/g, ' ');
            var titleCompact = titleText.replace(/\s+/g, ' ');
            if (headText && (headText === titleCompact || (/^chapter\s+\d+\b/.test(headText) && /^chapter\s+\d+\b/.test(titleCompact) && headText === titleCompact))) {
                first.remove();
                return (doc.body.innerHTML || '').trim();
            }
        } catch (e) { /* ignore */ }
        return html;
    }

    function stripRedundantChapterOpenings(title, contentHtml) {
        var html = stripDuplicateLeadingHeading(title, contentHtml);
        if (!html) return html;
        var displayKey = String(title || '').trim().toLowerCase().replace(/\s+/g, ' ');
        var chapterBannerRe = /^\s*(chapter|ch\.?)\s*\d+/i;
        try {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var body = doc.body;
            if (!body) return html;
            while (body.firstElementChild) {
                var node = body.firstElementChild;
                if ((node.tagName || '').toLowerCase() === 'hr') {
                    node.remove();
                    continue;
                }
                if (!/^h[1-6]$/i.test(node.tagName || '')) break;
                var cls = String(node.className || '');
                var textKey = String(node.textContent || '').trim().toLowerCase().replace(/\s+/g, ' ');
                var isBanner = cls.indexOf('manuscript-chapter-heading') >= 0 || chapterBannerRe.test(textKey);
                var dupTitle = displayKey && textKey && textKey === displayKey;
                if (!isBanner && !dupTitle) break;
                node.remove();
            }
            return (body.innerHTML || '').trim();
        } catch (e) { /* ignore */ }
        return html;
    }

    function sanitizeManuscriptHtml(unsafeHtml) {
        try {
            var allowedTags = new Set(['p', 'br', 'hr', 'ul', 'ol', 'li', 'strong', 'b', 'em', 'i', 'u', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'blockquote', 'code', 'pre', 'span', 'div']);
            var allowedAttrs = new Set(['class', 'style']);
            var parser = new DOMParser();
            var doc = parser.parseFromString(String(unsafeHtml), 'text/html');
            var walker = document.createTreeWalker(doc.body, NodeFilter.SHOW_ELEMENT, null);
            var toRemove = [];
            while (walker.nextNode()) {
                var el = walker.currentNode;
                if (!allowedTags.has(el.tagName.toLowerCase())) {
                    toRemove.push(el);
                    continue;
                }
                [].forEach.call(el.attributes, function(attr) {
                    var name = attr.name.toLowerCase();
                    var value = attr.value || '';
                    if (!allowedAttrs.has(name)) {
                        el.removeAttribute(name);
                        return;
                    }
                    if (name === 'style' && /expression\(|javascript:|url\(/i.test(value)) {
                        el.removeAttribute(name);
                    }
                });
            }
            toRemove.forEach(function(n) { n.replaceWith(n.textContent || ''); });
            return doc.body.innerHTML;
        } catch (e) {
            return escapeHtml(String(unsafeHtml));
        }
    }

    function formatManuscriptPlainToHtml(s) {
        var lines = s.split('\n');
        var out = [];
        var para = [];
        function flushPara() {
            if (!para.length) return;
            out.push('<p class="manuscript-p">' + para.map(function(l) { return escapeHtml(l); }).join('<br/>') + '</p>');
            para = [];
        }
        for (var i = 0; i < lines.length; i++) {
            var line = lines[i];
            var t = line.trim();
            if (!t) { flushPara(); continue; }
            var hm = t.match(/^(#{1,6})\s+(.+)$/);
            if (hm) {
                flushPara();
                var level = hm[1].length;
                out.push('<h' + level + ' class="manuscript-heading manuscript-h' + level + '">' + escapeHtml(hm[2].trim()) + '</h' + level + '>');
                continue;
            }
            if (/^(?:\-{3,}|\*{3,}|_{3,})$/.test(t)) {
                flushPara();
                out.push('<hr class="manuscript-hr" />');
                continue;
            }
            para.push(line);
        }
        flushPara();
        return out.length ? out.join('') : '<p class="text-gray-500">No content.</p>';
    }

    function formatChapterContent(raw) {
        var src = normalizeManuscriptEscapes((raw || '').toString()).trim();
        if (!src) return '<p class="text-gray-500">No content.</p>';
        var looksLikeHtml = /<\s*(p|h1|h2|h3|h4|h5|h6|blockquote|ul|ol|li|br|div|hr)\b/i.test(src);
        if (looksLikeHtml) {
            return sanitizeManuscriptHtml(src);
        }
        return formatManuscriptPlainToHtml(src);
    }

    function buildReaderPages() {
        syncInteriorTokenVars();
        const styleEl = document.getElementById('style-select');
        const interior = styleEl ? styleEl.value : 'Novel';
        const isClassic = interior === 'Classic';
        const pages = [];
        readerPageChapterIdx = [];
        const useMeasure = fmtCanMeasurePages();

        for (let ci = 0; ci < bookChapters.length; ci++) {
            const ch = bookChapters[ci];
            const title = (ch && ch.chapterTitle) || ('Chapter ' + (ci + 1));
            const content = (ch && ch.content && String(ch.content).trim()) || '';
            const normalizedContent = expandMonolithicChapterHtml(stripRedundantChapterOpenings(title, content));
            const paras = expandParasForPaging(splitChapterIntoParas(normalizedContent));
            const hasBodyLeadingHeading = /^\s*(<h[1-6]\b|#{1,6}\s+)/i.test(normalizedContent);
            const chapterNo = (ch && ch.chapterNo != null) ? ch.chapterNo : (ci + 1);
            const chapterHeadingHtml = buildFmtChapterHeading(chapterNo, title);

            if (paras.length === 0) {
                var emptyBody = isClassic
                    ? '<section class="reader-page-body classic-body"><p class="text-gray-500">No content.</p></section>'
                    : '<section class="reader-page-body"><p class="text-gray-500">No content.</p></section>';
                pages.push('<div class="reader-chapter-block" data-chapter-start="1">' + chapterHeadingHtml + emptyBody + '</div>');
                readerPageChapterIdx.push(ci);
                continue;
            }

            if (useMeasure) {
                var segments = [];
                for (var si = 0; si < paras.length; si++) {
                    segments.push(isClassic
                        ? classicParaToBodySegment(paras[si], si === 0)
                        : novelParaToBodySegment(paras[si]));
                }
                var chapterPages = paginateChapterFlow(segments, {
                    title: title,
                    chapterHeadingHtml: chapterHeadingHtml,
                    hasBodyLeadingHeading: hasBodyLeadingHeading,
                    isClassic: isClassic,
                    chapterStart: true
                });
                chapterPages.forEach(function(p) {
                    pages.push(p);
                    readerPageChapterIdx.push(ci);
                });
            } else {
                var pageChunks = chunkParasIntoPages(paras);
                for (let pi = 0; pi < pageChunks.length; pi++) {
                    const chunk = pageChunks[pi];
                    const titleBlock = (pi === 0 && !hasBodyLeadingHeading)
                        ? chapterHeadingHtml
                        : '';
                    const chunkText = chunk.join('\n\n');
                    const body = isClassic
                        ? (pi === 0 && !chunkNeedsManuscriptRender(chunkText) && !/<\s*p/i.test(chunkText)
                            ? formatClassicParas(chunk, true)
                            : formatChapterContent(chunkText))
                        : formatChapterContent(chunkText);
                    const bodyClass = isClassic ? 'reader-page-body classic-body' : 'reader-page-body';
                    var chAttr = (pi === 0) ? ' data-chapter-start="1"' : '';
                    pages.push('<div class="reader-chapter-block"' + chAttr + '>' + titleBlock +
                        '<section class="' + bodyClass + '">' + body + '</section></div>');
                    readerPageChapterIdx.push(ci);
                }
            }
        }

        var finalized = finalizeReaderPages(pages, readerPageChapterIdx);
        var withFrontMatter = prependFrontMatterToReaderPages(finalized.pages, finalized.chapterIdxs);
        readerPageChapterIdx = withFrontMatter.chapterIdxs;
        return withFrontMatter.pages;
    }

    function buildClassicReaderPages() {
        return buildReaderPages();
    }

    function computeBookContentSignature(chapters) {
        if (!Array.isArray(chapters) || !chapters.length) return 'empty';
        var totalLen = 0;
        var sig = chapters.map(function(ch, idx) {
            var title = (ch && ch.chapterTitle) ? String(ch.chapterTitle) : '';
            var body = (ch && ch.content) ? String(ch.content) : '';
            totalLen += body.length;
            return (ch && ch.chapterNo != null ? ch.chapterNo : (idx + 1)) + ':' + title.length + ':' + body.length;
        }).join('|');
        return chapters.length + '::' + totalLen + '::' + sig;
    }

    function computeReaderBuildKey() {
        var st = (document.getElementById('style-select') || {}).value || 'Novel';
        var sz = (document.getElementById('text-size-select') || {}).value || 'Medium';
        var ln = (document.getElementById('line-spacing-select') || {}).value || '1.6';
        var mw = getFmtMeasureShellWidth();
        var mh = getFmtContentAreaHeightPx();
        var meta = (bookPreviewContext.bookTitle || '') + '|' + (bookPreviewContext.authorName || '');
        return [st, sz, ln, mw, mh, meta, computeBookContentSignature(bookChapters)].join('||');
    }

    function ensureReaderPages(force) {
        if (!Array.isArray(bookChapters) || !bookChapters.length) {
            readerPages = [];
            readerPageChapterIdx = [];
            lastReaderBuildKey = '';
            return;
        }
        syncInteriorTokenVars();
        syncFmtPreviewLayout();
        var key = computeReaderBuildKey();
        if (!force && readerPages.length && key === lastReaderBuildKey) return;
        readerPages = buildReaderPages();
        lastReaderBuildKey = key;
    }

    function getChapterHtml(ch) {
        const title = (ch && ch.chapterTitle) || ('Chapter ' + (currentChapterIdx + 1));
        const content = (ch && ch.content && String(ch.content).trim()) || '';
        let html = '<article class="reader-page-title">' + escapeHtml(title) + '</article><section class="reader-page-body">';
        html += formatChapterContent(content);
        html += '</section>';
        return html;
    }

    function stripHtmlTags(html) {
        if (!html) return '';
        var d = document.createElement('div');
        d.innerHTML = html;
        return (d.textContent || d.innerText || '').trim();
    }

    function wordCountInHtml(html) {
        var t = stripHtmlTags(html);
        if (!t) return 0;
        return t.split(/\s+/).filter(Boolean).length;
    }

    function trailingParagraphWordCount(bodyHtml) {
        if (!bodyHtml) return 999;
        var matches = bodyHtml.match(/<p[^>]*>[\s\S]*?<\/p>/gi);
        if (!matches || !matches.length) return 999;
        return wordCountInHtml(matches[matches.length - 1]);
    }

    function fixOrphanWidowPages(pages) {
        if (!Array.isArray(pages) || pages.length < 2) return pages;
        var out = pages.slice();
        for (var pass = 0; pass < 3; pass++) {
            var moved = false;
            for (var i = 0; i < out.length - 1; i++) {
                var page = out[i];
                var bodyMatch = page.match(/(<section class="reader-page-body">)([\s\S]*?)(<\/section>)/);
                if (!bodyMatch) continue;
                var bodyInner = bodyMatch[2];
                if (trailingParagraphWordCount(bodyInner) >= 3) continue;
                var lastParaMatch = bodyInner.match(/([\s\S]*)(<p[^>]*>[\s\S]*?<\/p>)\s*$/);
                if (!lastParaMatch) continue;
                var bodyWithoutLast = lastParaMatch[1];
                var lastPara = lastParaMatch[2];
                if (!stripHtmlTags(bodyWithoutLast) && !page.match(/reader-page-title/)) continue;
                out[i] = page.replace(bodyMatch[0], bodyMatch[1] + bodyWithoutLast + bodyMatch[3]);
                var nextBody = out[i + 1].match(/(<section class="reader-page-body">)([\s\S]*?)(<\/section>)/);
                if (!nextBody) continue;
                out[i + 1] = out[i + 1].replace(nextBody[0], nextBody[1] + lastPara + nextBody[2] + nextBody[3]);
                moved = true;
            }
            if (!moved) break;
        }
        return out.filter(function(p) {
            var bm = p.match(/<section class="reader-page-body">([\s\S]*?)<\/section>/);
            if (!bm) return true;
            return stripHtmlTags(bm[1]).length > 0 || p.indexOf('reader-page-title') >= 0;
        });
    }

    /** Merge consecutive pages when under-filled — never across chapter boundaries. */
    function mergeUnderfilledReaderPages(pages, chapterIdxs) {
        if (!Array.isArray(pages) || pages.length < 2 || !fmtCanMeasurePages()) {
            return { pages: pages, chapterIdxs: chapterIdxs || [] };
        }
        var outP = pages.slice();
        var outC = (chapterIdxs && chapterIdxs.length === pages.length) ? chapterIdxs.slice() : pages.map(function() { return 0; });
        var changed = true;
        var passes = 0;

        while (changed && passes < 6) {
            changed = false;
            passes++;
            var nextP = [];
            var nextC = [];
            var maxH = getFmtPageMaxHeightPx();
            for (var i = 0; i < outP.length; i++) {
                if (i < outP.length - 1
                    && outC[i] === outC[i + 1]
                    && outP[i + 1].indexOf('data-chapter-start') < 0
                    && outP[i].indexOf('reader-page-title') < 0) {
                    var hCur = measureFmtPageBlock(stripEmbeddedPageFooters(outP[i]));
                    if (hCur / maxH < 0.72) {
                        var merged = mergeReaderPageBodies(outP[i], outP[i + 1]);
                        if (merged && fmtPageContentFits(stripEmbeddedPageFooters(merged))) {
                            nextP.push(merged);
                            nextC.push(outC[i]);
                            i++;
                            changed = true;
                            continue;
                        }
                    }
                }
                nextP.push(outP[i]);
                nextC.push(outC[i]);
            }
            outP = nextP;
            outC = nextC;
        }
        return { pages: outP.length ? outP : pages, chapterIdxs: outC.length ? outC : chapterIdxs };
    }

    function mergeReaderPageBodies(a, b) {
        var ma = String(a || '').match(/(<section class="reader-page-body[^"]*">)([\s\S]*?)(<\/section>)/);
        var mb = String(b || '').match(/(<section class="reader-page-body[^"]*">)([\s\S]*?)(<\/section>)/);
        if (!ma || !mb) return null;
        var titleA = (a.indexOf('reader-page-title') >= 0) ? (a.match(/<article class="reader-page-title">[\s\S]*?<\/article>/) || [''])[0] : '';
        var chAttr = a.indexOf('data-chapter-start') >= 0 ? ' data-chapter-start="1"' : '';
        return '<div class="reader-chapter-block"' + chAttr + '>' + titleA +
            ma[1] + ma[2] + mb[2] + ma[3] + '</div>';
    }

    function applyInteriorStyleClasses(interior) {
        var shellCls = interiorPreviewShellMap[interior] || interiorPreviewShellMap['Novel'];
        var wrapCls = interiorWrapClassMap[interior] || interiorWrapClassMap['Novel'];
        var matCls = fmtMatClassMap[interior] || fmtMatClassMap['Novel'];
        [document.getElementById('bookPageContentA'), document.getElementById('bookPageContentB')].filter(Boolean).forEach(function(el) {
            fmtRemoveClasses(el, allInteriorStyleClasses);
        });
        document.querySelectorAll('#book-formatter-root .book-page-content').forEach(function(el) {
            fmtRemoveClasses(el, allInteriorStyleClasses);
        });
        var shells = getFmtPaginatedShells();
        if (!shells.length) {
            var mainShell = document.getElementById('paginatedReaderShell');
            if (mainShell) shells = [mainShell];
        }
        shells.forEach(function(shell) {
            fmtRemoveClasses(shell, allInteriorShellClasses.concat(allInteriorWrapClasses));
            if (shellCls) shell.classList.add(shellCls);
            if (wrapCls) shell.classList.add(wrapCls);
        });
        var stage = document.getElementById('bookStage');
        if (stage) {
            fmtRemoveClasses(stage, allInteriorShellClasses.concat(allInteriorWrapClasses));
            if (shellCls) stage.classList.add(shellCls);
            if (wrapCls) stage.classList.add(wrapCls);
        }
        var container = document.getElementById('bookContainer');
        if (container) {
            fmtRemoveClasses(container, allInteriorWrapClasses);
            if (wrapCls) container.classList.add(wrapCls);
        }
        document.querySelectorAll('#book-formatter-root .book-page-background').forEach(function(bg) {
            fmtRemoveClasses(bg, allInteriorWrapClasses.concat(allInteriorStyleClasses));
            if (wrapCls) bg.classList.add(wrapCls);
        });
        var matHost = document.getElementById('fmt-book-result');
        if (matHost) {
            fmtRemoveClasses(matHost, allFmtMatClasses);
            if (matCls) matHost.classList.add(matCls);
        }
        var scrollHost = document.getElementById('fmt-preview-scroll-host');
        if (scrollHost) {
            fmtRemoveClasses(scrollHost, allInteriorWrapClasses);
            if (wrapCls) scrollHost.classList.add(wrapCls);
        }
        syncInteriorTokenVars();
    }

    function applyPreviewStyles(el) {
        if (!el) return;
        const sizeEl = document.getElementById('text-size-select');
        const lineEl = document.getElementById('line-spacing-select');
        const styleEl = document.getElementById('style-select');
        const size = sizeEl ? sizeEl.value : 'Medium';
        const lineSp = lineEl ? lineEl.value : '1.6';
        var previewLineSp = String(lineSp);
        const interior = styleEl ? styleEl.value : 'Novel';

        var fontSize;
        var ptSmall = 10, ptMed = 11, ptLarge = 12;
        function fmtPxFromPt(pt) { return (pt * 96 / 72).toFixed(2) + 'px'; }
        if (interior === 'Classic') {
            if (size === 'Small') fontSize = '14px';
            else if (size === 'Large') fontSize = '19px';
            else fontSize = '17px';
        } else {
            if (size === 'Small') fontSize = fmtPxFromPt(ptSmall);
            else if (size === 'Large') fontSize = fmtPxFromPt(ptLarge);
            else fontSize = fmtPxFromPt(ptMed);
        }
        var textAlign = (interior === 'Classic' || interior === 'ElegantTrade' || interior === 'Novel') ? 'justify' : '';

        el.style.fontSize = '';
        el.style.lineHeight = '';
        el.style.textAlign = textAlign || '';

        var stage = document.getElementById('bookStage');
        var shell = document.getElementById('paginatedReaderShell');
        if (stage) {
            stage.style.setProperty('--fmt-font-size', fontSize);
            stage.style.setProperty('--fmt-line-height', previewLineSp);
            stage.style.setProperty('--ilt-body-lh', previewLineSp);
            stage.style.setProperty('--ilt-body-px', fontSize);
            stage.classList.remove('fmt-style-traditional', 'fmt-style-modern', 'fmt-style-classic', 'fmt-style-clean-minimalist', 'fmt-style-minimalist', 'fmt-style-elegant-trade');
            var stageClass = 'fmt-style-traditional';
            if (interior === 'Modern') stageClass = 'fmt-style-modern';
            else if (interior === 'Classic') stageClass = 'fmt-style-classic';
            else if (interior === 'Minimalist') stageClass = 'fmt-style-clean-minimalist';
            else if (interior === 'ElegantTrade') stageClass = 'fmt-style-elegant-trade';
            stage.classList.add(stageClass);
        }
        if (shell) {
            shell.style.setProperty('--fmt-font-size', fontSize);
            shell.style.setProperty('--fmt-line-height', previewLineSp);
            shell.style.setProperty('--ilt-body-lh', previewLineSp);
            shell.style.setProperty('--ilt-body-px', fontSize);
        }
        document.documentElement.style.setProperty('--fmt-font-size', fontSize);
        document.documentElement.style.setProperty('--fmt-line-height', previewLineSp);
        document.documentElement.style.setProperty('--ilt-body-lh', previewLineSp);
        document.documentElement.style.setProperty('--ilt-body-px', fontSize);

        var bodies = el.querySelectorAll('.reader-page-body');
        bodies.forEach(function(body) {
            body.style.fontSize = '';
            body.style.lineHeight = '';
            body.style.textAlign = textAlign || '';
        });

        var paragraphs = el.querySelectorAll('.reader-page-body p');
        paragraphs.forEach(function(p) {
            p.style.fontSize = '';
            p.style.lineHeight = '';
        });

        applyInteriorStyleClasses(interior);
        syncInteriorTokenVars();
    }

