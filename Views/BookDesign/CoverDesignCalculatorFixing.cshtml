                function adoptCreatedBook(newBid, bookTitle) {
                    var hid = document.getElementById('selected-book-id');
                    if (hid) hid.value = String(newBid);
                    var root = document.getElementById('book-formatter-root');
                    if (root) root.setAttribute('data-book-id', String(newBid));
                    try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(newBid)); } catch (e) {}
                    var sel = document.getElementById('fmt-book-select');
                    if (sel) {
                        var found = false;
                        for (var i = 0; i < sel.options.length; i++) {
                            if (sel.options[i].value === String(newBid)) { found = true; break; }
                        }
                        if (!found) {
                            var opt = document.createElement('option');
