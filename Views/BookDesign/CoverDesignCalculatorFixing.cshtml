        return String(n);
    }

    function fmtScheduleRepaginate() {
        if (fmtRepaginateTimer) clearTimeout(fmtRepaginateTimer);
        fmtRepaginateTimer = setTimeout(function() {
            fmtRepaginateTimer = null;
            if (!bookChapters.length) return;
            var keep = currentPageIdx;
            ensureReaderPages(true);
            currentPageIdx = Math.min(keep, Math.max(0, readerPages.length - 1));
            var fmtEl = document.getElementById('format-select');
            var fmt = (fmtEl && fmtEl.value) || 'Ebook';
            if (fmt === 'Both') renderBothPreviews(0);
            else renderPreviewContent(0);
            updatePageIndicator();
        }, 120);
    }

