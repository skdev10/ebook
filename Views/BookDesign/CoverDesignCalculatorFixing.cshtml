    function recalcPrintReadyModalMetrics(overrides) {
        if (overrides && typeof overrides === 'object') {
            printReadyComputed = Object.assign({}, printReadyComputed, overrides);
        }
        var pages = parseInt(printReadyComputed.pageCount || '0', 10);
        if (!Number.isFinite(pages) || pages <= 0) {
            pages = getFormatterPreviewPageCount();
        }
        if (!Number.isFinite(pages) || pages <= 0) {
            if (prModalPageValue) prModalPageValue.textContent = '—';
            return printReadyComputed;
        }
        var maxP = (window.__kdpSpecs && window.__kdpSpecs.paperback && window.__kdpSpecs.paperback.max) || 828;
        pages = Math.min(maxP, pages);
        var paper = normalizePaperType(printReadyComputed.paperType || inferPaperTypeFromGenre(bookPreviewContext.genre));
        var trimValue = normalizeTrimValue(printReadyComputed.trimValue || inferTrimValueFromConfig());

        var trim = trimValueToDims(trimValue);
        var mul = paperMultiplier(paper);
        var bleed = printReadyConfig.bleedInches;
        var spineIn = pages * mul;
        var wrapWIn = (trim.w * 2) + spineIn + (bleed * 2);
        var wrapHIn = trim.h + (bleed * 2);
        var toMm = function(v) { return v * 25.4; };

        printReadyComputed = {
            pageCount: pages,
            paperType: paper,
            trimValue: trimValue,
            spineIn: spineIn,
            wrapWIn: wrapWIn,
            wrapHIn: wrapHIn
        };

        if (prModalPageValue) prModalPageValue.textContent = String(pages);
        if (prModalPaperValue) prModalPaperValue.textContent = paperLabel(paper);
        if (prModalTrimValue) prModalTrimValue.textContent = trimLabel(trimValue);

        if (prModalSpineIn) prModalSpineIn.textContent = fmtNumber(spineIn, 3) + ' in';
        if (prModalSpineMm) prModalSpineMm.textContent = fmtNumber(toMm(spineIn), 2) + ' mm';
        if (prModalWrapIn) prModalWrapIn.textContent = fmtNumber(wrapWIn, 3) + ' × ' + fmtNumber(wrapHIn, 3) + ' in';
        if (prModalWrapMm) prModalWrapMm.textContent = fmtNumber(toMm(wrapWIn), 2) + ' × ' + fmtNumber(toMm(wrapHIn), 2) + ' mm';
        return printReadyComputed;
    }

    function hashStringToInt(input) {
        var s = String(input || '');
        var h = 2166136261;
        for (var i = 0; i < s.length; i++) {
            h ^= s.charCodeAt(i);
            h = Math.imul(h, 16777619);
        }
        return Math.abs(h >>> 0);
    }

    function pickDeterministicIndex(seed, mod) {
        if (!mod || mod <= 0) return 0;
        return hashStringToInt(seed) % mod;
    }

    function getRecentStyleHistory(bookId) {
        if (!bookId) return [];
        try {
            var raw = sessionStorage.getItem(PRINT_READY_STYLE_STORE_KEY);
            if (!raw) return [];
            var all = JSON.parse(raw);
            var arr = all && all[String(bookId)];
            return Array.isArray(arr) ? arr.slice(0, 8) : [];
        } catch (e) {
            return [];
        }
    }

    function saveRecentStyleHistory(bookId, arr) {
        if (!bookId) return;
        try {
            var raw = sessionStorage.getItem(PRINT_READY_STYLE_STORE_KEY);
            var all = raw ? JSON.parse(raw) : {};
            all[String(bookId)] = (arr || []).slice(0, 8);
            sessionStorage.setItem(PRINT_READY_STYLE_STORE_KEY, JSON.stringify(all));
        } catch (e) { /* ignore */ }
    }

    function selectDesignDirection(bookId, genre, iterationSeed) {
        var g = String(genre || '').toLowerCase();
        var recent = getRecentStyleHistory(bookId);
        var score = function(style) {
            var s = 1;
            if (style && Array.isArray(style.tags)) {
                for (var i = 0; i < style.tags.length; i++) {
                    if (g.indexOf(style.tags[i]) >= 0) s += 3;
                }
            }
            if (recent.indexOf(style.id) >= 0) s -= 5;
            return s;
        };
        var ranked = PRINT_READY_STYLE_LIBRARY
            .map(function(style) { return { style: style, score: score(style) }; })
            .sort(function(a, b) { return b.score - a.score; })
            .map(function(item) { return item.style; });
        var candidatePool = ranked.slice(0, Math.min(5, ranked.length));
        var seed = String(iterationSeed || Date.now()) + '|' + String(bookId || '') + '|' + String(genre || '');
        var idx = pickDeterministicIndex(seed, candidatePool.length || 1);
        var selected = candidatePool[idx] || ranked[0] || PRINT_READY_STYLE_LIBRARY[0];
        var nextRecent = [selected.id].concat(recent.filter(function(id) { return id !== selected.id; })).slice(0, 5);
        saveRecentStyleHistory(bookId, nextRecent);
        return selected;
    }

