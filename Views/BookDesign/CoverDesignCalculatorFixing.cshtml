<script>
/* ============================================================================
   EMBEDDED BOOK INTERIOR PREVIEW ENGINE (real templates)
   Renders the REAL book (bookChapters) using the prototype's measurement-based
   pagination, driven by the existing controls (#style-select / #text-size-select
   / #line-spacing-select). Pure visual overlay — the production formatter's
   pagination, page-count, save and export logic keep running underneath.
   ============================================================================ */
(function () {
    'use strict';

    // Fallback content for the very first paint (before the main loader publishes live data).
    var IPV_INITIAL = @Html.Raw(ViewBag.InitialBookPayloadJson as string ?? "null");

    function getChapters() {
        try {
            if (Array.isArray(window.__fmtBookChapters) && window.__fmtBookChapters.length)
                return window.__fmtBookChapters;
        } catch (e) {}
        if (IPV_INITIAL && Array.isArray(IPV_INITIAL.chapters) && IPV_INITIAL.chapters.length) {
            return IPV_INITIAL.chapters.map(function (c, i) {
                return {
                    chapterNo: (c.chapterNo != null ? c.chapterNo : (i + 1)),
                    chapterTitle: c.chapterTitle || c.title || '',
                    content: c.content || c.Content || ''
                };
            });
        }
        return [];
    }

    // 11 visually-distinct interior themes (preview parity with the PDF interior CSS).
    // Each: paper/ink/margins + body/head fonts + alignment, drop cap, ornament, accent.
    var THEMES = {
        // 1 — Elegant Trade: warm ivory, Cormorant, centered small-caps + gold rule, drop cap.
        elegant: { surface:'linear-gradient(135deg,#b49a70 0%,#876c4a 100%)', paper:'#FDFBF7', paperGrad:'none', ink:'#1C1C1C', margins:{t:0.875,b:0.875,inside:1.0,outside:0.75}, dropPct:30,
            bodyFont:"'Cormorant Garamond', serif", headFont:"'Cormorant SC', 'Cormorant Garamond', serif", indent:'1.5em', align:'justify', headAlign:'center', headTransform:'uppercase', headLs:'.22em', headWeight:'600', accent:'#C9A84C', dropCap:true, dropSize:'3.4em', headRule:true, ornament:'\u2726' },
        // 2 — Traditional: white, EB Garamond, centered bold, drop cap.
        traditional: { surface:'linear-gradient(135deg,#3f463c 0%,#2a302a 100%)', paper:'#FFFFFF', paperGrad:'none', ink:'#222222', margins:{t:0.875,b:0.875,inside:1.0,outside:0.75}, dropPct:25,
            bodyFont:"'EB Garamond', serif", headFont:"'EB Garamond', serif", indent:'1.25em', align:'justify', headAlign:'center', headWeight:'700', accent:'#555555', dropCap:true, dropSize:'3em', ornament:'* * *' },
        // 3 — Novel: white, Lora, left bold heading, mass-market.
        novel: { surface:'linear-gradient(135deg,#3f463c 0%,#2a302a 100%)', paper:'#FFFFFF', paperGrad:'none', ink:'#1A1A1A', margins:{t:0.75,b:0.75,inside:0.875,outside:0.625}, dropPct:20,
            bodyFont:"'Lora', serif", headFont:"'Lora', serif", indent:'1em', align:'justify', headAlign:'left', headWeight:'700', accent:'#888888', dropCap:false, ornament:'\u2014' },
        // 4 — Contemporary: Lora body / Raleway uppercase heading + blue accent line, no indent.
        contemporary: { surface:'linear-gradient(135deg,#1e3a5f 0%,#0f2238 100%)', paper:'#FFFFFF', paperGrad:'none', ink:'#1F2937', margins:{t:0.875,b:0.875,inside:1.0,outside:0.75}, dropPct:22,
            bodyFont:"'Lora', serif", headFont:"'Raleway', sans-serif", indent:'0', paraGap:'10px', align:'justify', headAlign:'left', headTransform:'uppercase', headLs:'.25em', headWeight:'700', accent:'#3B82F6', dropCap:false, headRule:true, ruleMx:'0', ornament:'\u2014' },
        // 5 — Modern: DM Sans / Outfit, left, ragged-right, gap, business/non-fiction.
        modern: { surface:'linear-gradient(135deg,#111827 0%,#030712 100%)', paper:'#FFFFFF', paperGrad:'none', ink:'#111827', margins:{t:1.0,b:1.0,inside:1.125,outside:0.875}, dropPct:18,
            bodyFont:"'DM Sans', sans-serif", headFont:"'Outfit', sans-serif", indent:'0', paraGap:'12px', align:'left', headAlign:'left', headWeight:'700', accent:'#6366f1', dropCap:false, ornament:'\u2042' },
        // 6 — Fine Book: cream, Spectral / Playfair italic, centered, gold ornament, premium.
        finebook: { surface:'linear-gradient(135deg,#7c6a4a 0%,#4a3c26 100%)', paper:'#FDF8F2', paperGrad:'radial-gradient(120% 90% at 50% 0%, #fffaf2 0%, #f6ecdb 100%)', ink:'#1A120B', margins:{t:1.0,b:1.125,inside:1.25,outside:1.125}, dropPct:30,
            bodyFont:"'Spectral', serif", headFont:"'Playfair Display', serif", indent:'1.5em', align:'justify', headAlign:'center', headStyle:'italic', headWeight:'400', accent:'#C9A84C', dropCap:false, ornTop:true, ornament:'\u2767' },
        // 7 — Classic: white, Libre Baskerville, centered bold underlined.
        classic: { surface:'linear-gradient(135deg,#4f2126 0%,#2c1316 100%)', paper:'#FFFFFF', paperGrad:'none', ink:'#000000', margins:{t:0.875,b:0.875,inside:1.0,outside:0.75}, dropPct:25,
            bodyFont:"'Libre Baskerville', serif", headFont:"'Libre Baskerville', serif", indent:'1.25em', align:'justify', headAlign:'center', headWeight:'700', headDecoration:'underline', accent:'#000000', dropCap:false, ornament:'* * *' },
        // 8 — Clean: white, Source Serif / Inter, left semibold, minimal.
        clean: { surface:'linear-gradient(135deg,#374151 0%,#1f2937 100%)', paper:'#FFFFFF', paperGrad:'none', ink:'#374151', margins:{t:0.875,b:0.875,inside:1.0,outside:0.875}, dropPct:15,
            bodyFont:"'Source Serif 4', serif", headFont:"'Inter', sans-serif", indent:'0', paraGap:'8px', align:'justify', headAlign:'left', headWeight:'600', accent:'#9CA3AF', dropCap:false, ornament:'\u2014' },
        // 9 — Minimalist: white, Libre Baskerville / Jost light uppercase, huge whitespace.
        minimalist: { surface:'linear-gradient(135deg,#edeff2 0%,#dce0e6 100%)', paper:'#FFFFFF', paperGrad:'none', ink:'#4B5563', margins:{t:1.25,b:1.25,inside:1.25,outside:1.25}, dropPct:24,
            bodyFont:"'Libre Baskerville', serif", headFont:"'Jost', sans-serif", indent:'0', paraGap:'16px', align:'left', headAlign:'center', headTransform:'uppercase', headLs:'.5em', headWeight:'300', accent:'#9CA3AF', dropCap:false, ornament:'\u00b7' },
        // 10 — POD: white, Crimson Pro / Nunito Sans, left bold + thin rule, KDP-ready.
        pod: { surface:'linear-gradient(135deg,#374151 0%,#111827 100%)', paper:'#FFFFFF', paperGrad:'none', ink:'#111111', margins:{t:0.875,b:0.75,inside:0.875,outside:0.625}, dropPct:20,
            bodyFont:"'Crimson Pro', serif", headFont:"'Nunito Sans', sans-serif", indent:'1em', align:'justify', headAlign:'left', headWeight:'700', accent:'#CCCCCC', dropCap:false, headRule:true, ruleMx:'0', ornament:'* * *' },
        // 11 — Elegant Trade (POD): same elegance, POD trim.
        elegantpod: { surface:'linear-gradient(135deg,#b49a70 0%,#876c4a 100%)', paper:'#FDFBF7', paperGrad:'none', ink:'#1C1C1C', margins:{t:0.875,b:0.875,inside:1.0,outside:0.75}, dropPct:30,
            bodyFont:"'Cormorant Garamond', serif", headFont:"'Cormorant SC', 'Cormorant Garamond', serif", indent:'1.5em', align:'justify', headAlign:'center', headTransform:'uppercase', headLs:'.22em', headWeight:'600', accent:'#C9A84C', dropCap:true, dropSize:'3.4em', headRule:true, ornament:'\u2726' }
    };
    var PT = { Small:10, Medium:11.5, Large:13 };
    var TRIMS = { '6x9':[6,9] };
    var STYLE_MAP = { Novel:'novel', Traditional:'traditional', POD:'pod', Modern:'modern', Contemporary:'contemporary', Clean:'clean', Minimalist:'minimalist', Classic:'classic', FineBook:'finebook', ElegantTrade:'elegant', ElegantTradePOD:'elegantpod' };

    var ipvState = { theme:'novel', size:'Medium', lh:'1.6', trim:'6x9' };
    var geo = {};
    var PAGES = [];
    var currentPage = 0;
    var lastSig = '';
    var renderTimer = null;

    function el(id) { return document.getElementById(id); }
    function overlay() { return el('ipvOverlay'); }

    function readControls() {
        var s = (el('style-select') || {}).value || 'Novel';
        ipvState.theme = STYLE_MAP[s] || 'novel';
        ipvState.size = (el('text-size-select') || {}).value || 'Medium';
        if (!PT[ipvState.size]) ipvState.size = 'Medium';
        var lh = (el('line-spacing-select') || {}).value || '1.6';
        ipvState.lh = lh === '2' ? '2.0' : lh;
        ipvState.trim = '6x9';
    }

    function bookTitle() {
        try {
            if (window.__fmtPreviewContext && window.__fmtPreviewContext.bookTitle)
                return String(window.__fmtPreviewContext.bookTitle).trim();
        } catch (e) {}
        if (IPV_INITIAL && IPV_INITIAL.bookTitle) return String(IPV_INITIAL.bookTitle).trim();
        return '';
    }
    function bookTitleOrDefault() { return bookTitle() || 'Untitled'; }

    /* ---- real content -> manuscript blocks ---- */
    function parseChapterContent(html, title) {
        var res = [];
        var src = html || '';
        try { if (typeof stripRedundantChapterOpenings === 'function') src = stripRedundantChapterOpenings(title, src); } catch (e) {}
        try { if (typeof expandMonolithicChapterHtml === 'function') src = expandMonolithicChapterHtml(src); } catch (e) {}
        if (typeof src !== 'string') src = String(src || '');
        var looksHtml = /<\s*(p|h[1-6]|div|hr|ul|ol|li|blockquote|br)\b/i.test(src);
        if (!looksHtml) {
            src.split(/\n{2,}/).forEach(function (t) {
                var x = (t || '').replace(/\s+/g, ' ').trim();
                if (x) res.push({ type:'para', text:x });
            });
            return res;
        }
        var doc;
        try { doc = new DOMParser().parseFromString(src, 'text/html'); } catch (e) { return res; }
        var body = doc && doc.body ? doc.body : null;
        if (!body) return res;
        // Unwrap a single wrapper (div/section/article) so paragraphs inside split correctly.
        var scope = body;
        while (scope.children.length === 1 && /^(div|section|article)$/i.test(scope.children[0].tagName)) {
            scope = scope.children[0];
        }
        var kids = scope.children;
        for (var i = 0; i < kids.length; i++) {
            var node = kids[i];
            var tag = node.tagName ? node.tagName.toLowerCase() : '';
            if (tag === 'hr') { res.push({ type:'scene' }); continue; }
            if (/^h[1-6]$/.test(tag)) {
                // #2: keep in-chapter subsection headings and start each on a new page.
                // Skip only the chapter's own opening heading (handled by the chapter opener).
                var htext = (node.textContent || '').replace(/\s+/g, ' ').trim();
                if (!htext) continue;
                var low = htext.toLowerCase();
                var titleLow = (title || '').toLowerCase().trim();
                if (low === titleLow || /^chapter\s+\d+\b/i.test(htext)) continue;
                res.push({ type:'section', text:htext });
                continue;
            }
            // Inline images (e.g. extracted from an uploaded .docx) render as centered blocks.
            var imgEls = node.querySelectorAll ? node.querySelectorAll('img') : [];
            if (imgEls && imgEls.length) {
                for (var im = 0; im < imgEls.length; im++) {
                    var isrc = imgEls[im].getAttribute('src') || '';
                    if (isrc) res.push({ type:'image', src:isrc });
                }
                var withText = (node.textContent || '').replace(/\s+/g, ' ').trim();
                if (withText) res.push({ type:'para', text:withText });
                continue;
            }
            var txt = (node.textContent || '').replace(/\s+/g, ' ').trim();
            if (txt) res.push({ type:'para', text:txt });
        }
        if (!res.length) {
            var all = (scope.textContent || body.textContent || '').replace(/\s+/g, ' ').trim();
            if (all) res.push({ type:'para', text:all });
        }
        return res;
    }

    function buildManuscript() {
        var out = [];
        var chs = getChapters();
        for (var i = 0; i < chs.length; i++) {
            var ch = chs[i] || {};
            var no = (ch.chapterNo != null) ? ch.chapterNo : (i + 1);
            var title = (ch.chapterTitle && String(ch.chapterTitle).trim()) || ('Chapter ' + no);
            out.push({ type:'chapter', num:'Chapter ' + no, title:title, chapterIndex:i });
            var blocks = parseChapterContent(ch.content || '', title);
            for (var j = 0; j < blocks.length; j++) out.push(blocks[j]);
        }
        return out;
    }

    /* ---- geometry: fit a real page rectangle into the available pane ---- */
    function computeGeometry() {
        // Per-style trim size so page SHAPE differs between styles (5×8 / 5.5×8.5 / 6×9).
        var TRIM_BY_THEME = {
            elegant:[5.5,8.5], traditional:[5.5,8.5], novel:[5,8], contemporary:[5.5,8.5],
            modern:[6,9], finebook:[6,9], classic:[5.5,8.5], clean:[6,9],
            minimalist:[5.5,8.5], pod:[6,9], elegantpod:[5.5,8.5]
        };
        var trim = TRIM_BY_THEME[ipvState.theme] || TRIMS[ipvState.trim] || TRIMS['6x9'];
        var trimW = trim[0], trimH = trim[1];
        var ratio = trimW / trimH;
        var scroll = overlay().querySelector('.ipv-scroll');
        var availW = (scroll ? scroll.clientWidth : 0) - 28;
        var availH = (scroll ? scroll.clientHeight : 0) - 24;
        if (!(availW > 160)) availW = 320;
        if (!(availH > 200)) availH = 460;
        var pageH = Math.min(availH, availW / ratio);
        var pageW = pageH * ratio;
        if (pageW > availW) { pageW = availW; pageH = pageW / ratio; }
        var pxPerInch = pageH / trimH;
        var m = THEMES[ipvState.theme].margins;
        geo = {
            pageW: Math.round(pageW), pageH: Math.round(pageH),
            marginTop: m.t * pxPerInch, marginBottom: m.b * pxPerInch,
            marginInside: m.inside * pxPerInch, marginOutside: m.outside * pxPerInch,
            contentW: pageW - (m.inside + m.outside) * pxPerInch,
            contentH: pageH - (m.t + m.b) * pxPerInch,
            bodyPx: (PT[ipvState.size] / 72) * pxPerInch
        };
    }

    function applyTypo(node) {
        node.style.setProperty('--ipv-body-size', geo.bodyPx + 'px');
        node.style.setProperty('--ipv-lh', ipvState.lh);
    }

    /** Push all per-style CSS variables onto a holder so the 11 themes render distinctly
     *  (and measurement uses the same fonts as the rendered page). */
    function applyThemeVars(node) {
        if (!node) return;
        var t = THEMES[ipvState.theme] || THEMES.novel;
        var s = node.style;
        s.setProperty('--ipv-paper', t.paper);
        s.setProperty('--ipv-paper-grad', t.paperGrad || 'none');
        s.setProperty('--ipv-ink', t.ink);
        s.setProperty('--ipv-body-font', t.bodyFont);
        s.setProperty('--ipv-head-font', t.headFont);
        s.setProperty('--ipv-indent', t.indent != null ? t.indent : '1.4em');
        s.setProperty('--ipv-align', t.align || 'justify');
        s.setProperty('--ipv-para-gap', t.paraGap || '0px');
        s.setProperty('--ipv-head-align', t.headAlign || 'center');
        s.setProperty('--ipv-head-transform', t.headTransform || 'none');
        s.setProperty('--ipv-head-variant', t.headVariant || 'normal');
        s.setProperty('--ipv-head-ls', t.headLs || 'normal');
        s.setProperty('--ipv-head-style', t.headStyle || 'normal');
        s.setProperty('--ipv-head-weight', t.headWeight || '600');
        s.setProperty('--ipv-head-decoration', t.headDecoration || 'none');
        s.setProperty('--ipv-accent', t.accent || t.ink);
        s.setProperty('--ipv-dropcap-size', t.dropSize || '3.2em');
        s.setProperty('--ipv-rule-mx', t.ruleMx || 'auto');
        if (node.classList) node.classList.toggle('ipv-dropcap', !!t.dropCap);
    }

    function makeHost() {
        var c = document.createElement('div');
        c.className = 'ipv-content';
        c.style.position = 'static';
        c.style.width = geo.contentW + 'px';
        return c;
    }

    function renderBlock(b) {
        if (b.type === 'chapter') {
            var th = THEMES[ipvState.theme] || THEMES.novel;
            var ch = document.createElement('div');
            ch.className = 'ipv-chapter';
            ch.style.paddingTop = Math.round(geo.contentH * th.dropPct / 100) + 'px';
            ch.style.paddingBottom = '1.6em';
            var inner = '';
            // Ornament above the heading (Fine Book / Elegant gold mark).
            if (th.ornTop) inner += '<div class="ipv-flourish">' + (th.ornTopChar || th.ornament) + '</div>';
            inner += '<div class="ipv-chnum"></div><div class="ipv-chtitle"></div>';
            // Accent rule under the heading (Elegant gold, Contemporary/POD line).
            if (th.headRule) inner += '<div class="ipv-chrule"></div>';
            ch.innerHTML = inner;
            ch.querySelector('.ipv-chnum').textContent = b.num || '';
            ch.querySelector('.ipv-chtitle').textContent = b.title || '';
            return ch;
        }
        if (b.type === 'scene') {
            var s = document.createElement('div');
            s.className = 'ipv-scene';
            s.textContent = THEMES[ipvState.theme].ornament;
            return s;
        }
        if (b.type === 'section') {
            var sec = document.createElement('div');
            sec.className = 'ipv-section';
            sec.textContent = b.text || '';
            return sec;
        }
        if (b.type === 'image') {
            var fig = document.createElement('div');
            fig.className = 'ipv-figure';
            var img = document.createElement('img');
            img.src = b.src || '';
            img.alt = '';
            fig.appendChild(img);
            return fig;
        }
        var p = document.createElement('p');
        p.className = 'ipv-para' + (b.first ? ' first' : '') + (b.cont ? ' cont' : '');
        p.textContent = b.text;
        return p;
    }

    function lineHeightPx() {
        var probe = el('ipvLh');
        probe.className = 'ipv-para';
        probe.style.width = geo.contentW + 'px';
        applyTypo(probe);
        probe.textContent = 'Mg';
        return probe.offsetHeight || 1;
    }

    function splitParagraph(text, available, first, cont) {
        var lm = el('ipvLine');
        lm.className = 'ipv-para' + (first ? ' first' : '') + (cont ? ' cont' : '');
        lm.style.width = geo.contentW + 'px';
        applyTypo(lm);
        lm.textContent = text;
        var lh = lineHeightPx();
        if (lm.offsetHeight <= available) return { fits:text, rest:'' };
        var words = text.split(' ');
        var lo = 1, hi = words.length, best = 0;
        while (lo <= hi) {
            var mid = (lo + hi) >> 1;
            lm.textContent = words.slice(0, mid).join(' ');
            if (lm.offsetHeight <= available) { best = mid; lo = mid + 1; } else hi = mid - 1;
        }
        lm.textContent = words.slice(0, best).join(' ');
        var fitsLines = Math.round(lm.offsetHeight / lh);
        if (best === 0 || fitsLines < 2) return { fits:'', rest:text };
        var restWords = words.length - best;
        while (restWords > 0) {
            lm.textContent = words.slice(best).join(' ');
            var restLines = Math.round(lm.offsetHeight / lh);
            if (restLines >= 2 || restLines === 0) break;
            best--; restWords++;
            lm.textContent = words.slice(0, best).join(' ');
            if (Math.round(lm.offsetHeight / lh) < 2) { best++; break; }
        }
        return { fits:words.slice(0, best).join(' '), rest:words.slice(best).join(' ') };
    }

    function paginate() {
        computeGeometry();
        var measure = el('ipvMeasure');
        measure.innerHTML = '';
        measure.setAttribute('data-ipv-theme', ipvState.theme);
        el('ipvLineWrap').setAttribute('data-ipv-theme', ipvState.theme);
        applyTypo(measure);
        // Measurement must use the SAME fonts/indent/drop-cap as the rendered page,
        // otherwise top "Page X of Y" (measured) and the visible pages disagree.
        applyThemeVars(measure);
        applyThemeVars(el('ipvLineWrap'));
        var host = makeHost();
        measure.appendChild(host);

        var raw = buildManuscript();
        var blocks = [];
        for (var i = 0; i < raw.length; i++) {
            var b = raw[i];
            if (b.type === 'para') {
                var prev = raw[i - 1];
                var first = prev && (prev.type === 'chapter' || prev.type === 'scene' || prev.type === 'section');
                blocks.push({ type:'para', text:b.text, first:!!first });
            } else blocks.push(Object.assign({}, b));
        }

        var pages = [];
        var pageBlocks = [];
        var currentChapter = bookTitleOrDefault();
        var currentChapterIdx = -1;

        function reset() { measure.innerHTML = ''; host = makeHost(); measure.appendChild(host); }
        function commit() { pages.push({ blocks:pageBlocks, chapter:currentChapter, chapterIndex:currentChapterIdx }); pageBlocks = []; reset(); }

        for (var k = 0; k < blocks.length; k++) {
            var blk = blocks[k];
            if (blk.type === 'chapter') {
                if (pageBlocks.length) commit();
                currentChapter = blk.title;
                currentChapterIdx = (blk.chapterIndex != null && Number.isFinite(blk.chapterIndex)) ? blk.chapterIndex : currentChapterIdx;
                host.appendChild(renderBlock(blk));
                pageBlocks.push(blk);
                continue;
            }
            if (blk.type === 'section') {
                // #2: a major subsection always opens at the top of a fresh page, unless the
                // current page only holds the chapter opener (avoid a near-empty page right after it).
                var onlyChapterOpener = pageBlocks.length === 1 && pageBlocks[0].type === 'chapter';
                if (pageBlocks.length && !onlyChapterOpener) commit();
                host.appendChild(renderBlock(blk));
                pageBlocks.push(blk);
                continue;
            }
            var node = renderBlock(blk);
            host.appendChild(node);
            if (host.scrollHeight <= geo.contentH + 0.5) { pageBlocks.push(blk); continue; }
            host.removeChild(node);
            if (blk.type === 'scene' || blk.type === 'image') {
                commit();
                host.appendChild(renderBlock(blk));
                pageBlocks.push(blk);
                continue;
            }
            var available = geo.contentH - host.scrollHeight;
            var sp = splitParagraph(blk.text, available, blk.first, blk.cont);
            if (sp.fits && pageBlocks.length) {
                pageBlocks.push({ type:'para', text:sp.fits, first:blk.first, cont:blk.cont });
                host.appendChild(renderBlock({ type:'para', text:sp.fits, first:blk.first, cont:blk.cont }));
                commit();
                blocks.splice(k + 1, 0, { type:'para', text:sp.rest, cont:true });
            } else {
                if (pageBlocks.length) commit();
                var fn = renderBlock(blk);
                host.appendChild(fn);
                if (host.scrollHeight > geo.contentH + 0.5) {
                    host.removeChild(fn);
                    var r = splitParagraph(blk.text, geo.contentH, blk.first, blk.cont);
                    pageBlocks.push({ type:'para', text:r.fits, first:blk.first, cont:blk.cont });
                    host.appendChild(renderBlock({ type:'para', text:r.fits, first:blk.first, cont:blk.cont }));
                    commit();
                    if (r.rest) blocks.splice(k + 1, 0, { type:'para', text:r.rest, cont:true });
                } else pageBlocks.push(blk);
            }
        }
        if (pageBlocks.length) pages.push({ blocks:pageBlocks, chapter:currentChapter, chapterIndex:currentChapterIdx });
        return pages;
    }

    /** Jump the on-screen IPV tablet to the first page of chapter index (0-based). */
    window.FmtIpvJumpToChapter = function (chIdx) {
        chIdx = parseInt(chIdx, 10);
        if (!Number.isFinite(chIdx) || chIdx < 0) return false;
        if (!PAGES.length) doRender();
        for (var i = 0; i < PAGES.length; i++) {
            var p = PAGES[i];
            if (!p) continue;
            if (p.chapterIndex === chIdx) {
                currentPage = i;
                renderPage(currentPage);
                return true;
            }
            var b0 = p.blocks && p.blocks[0];
            if (b0 && b0.type === 'chapter' && b0.chapterIndex === chIdx) {
                currentPage = i;
                renderPage(currentPage);
                return true;
            }
        }
        return false;
    };

    function renderPage(idx) {
        var page = el('ipvPage');
        page.setAttribute('data-ipv-theme', ipvState.theme);
        page.style.width = geo.pageW + 'px';
        page.style.height = geo.pageH + 'px';
        applyThemeVars(page);
        applyTypo(page);
        page.innerHTML = '';

        if (!PAGES.length) { el('ipvCounter').textContent = 'Page 0 / 0'; el('ipvPrev').disabled = true; el('ipvNext').disabled = true; return; }
        if (idx < 0) idx = 0; if (idx > PAGES.length - 1) idx = PAGES.length - 1;
        var data = PAGES[idx];
        var pageNo = idx + 1;
        var isRecto = (pageNo % 2) === 1;
        var leftMargin = isRecto ? geo.marginInside : geo.marginOutside;
        var rightMargin = isRecto ? geo.marginOutside : geo.marginInside;
        var startsWithChapter = data.blocks[0] && data.blocks[0].type === 'chapter';

        var rh = document.createElement('div');
        rh.className = 'ipv-running-head';
        rh.style.top = (geo.marginTop * 0.42) + 'px';
        rh.style.left = leftMargin + 'px';
        rh.style.width = (geo.pageW - leftMargin - rightMargin) + 'px';
        rh.textContent = isRecto ? data.chapter : bookTitleOrDefault();
        if (!startsWithChapter) page.appendChild(rh);

        var content = document.createElement('div');
        content.className = 'ipv-content';
        content.style.top = geo.marginTop + 'px';
        content.style.left = leftMargin + 'px';
        content.style.width = geo.contentW + 'px';
        content.style.height = geo.contentH + 'px';
        data.blocks.forEach(function (b) { content.appendChild(renderBlock(b)); });
        page.appendChild(content);

        var pn = document.createElement('div');
        pn.className = 'ipv-folio';
        pn.style.bottom = (geo.marginBottom * 0.4) + 'px';
        // Outer-corner folios (Traditional / Novel / Modern / Classic) vs centered (rest).
        var outerFolio = (ipvState.theme === 'traditional' || ipvState.theme === 'novel' ||
                          ipvState.theme === 'modern' || ipvState.theme === 'classic');
        if (outerFolio) {
            if (isRecto) pn.style.right = rightMargin + 'px'; else pn.style.left = leftMargin + 'px';
        } else { pn.style.left = '0'; pn.style.right = '0'; pn.style.textAlign = 'center'; }
        pn.textContent = pageNo;
        // Folio is hidden on chapter-opener pages, except Minimalist (shown on every page).
        if (!startsWithChapter || ipvState.theme === 'minimalist') page.appendChild(pn);

        el('ipvCounter').textContent = 'Page ' + pageNo + ' / ' + PAGES.length;
        // Keep the top "Page X of Y" indicator on the SAME count as the bottom
        // "Total pages: Y" badge (both driven by this IPV reader = source of truth).
        try {
            window.__ipvCurrentPage = idx;
            var fpiTop = document.getElementById('fmt-page-indicator');
            if (fpiTop) {
                fpiTop.textContent = 'Page ' + (idx + 1) + ' of ' + PAGES.length;
                fpiTop.classList.toggle('hidden', PAGES.length === 0);
            }
            // Keep CHAPTER dropdown in sync when flipping IPV pages.
            var jumpSel = document.getElementById('reader-chapter-jump');
            if (jumpSel && data && data.chapterIndex != null && data.chapterIndex >= 0) {
                var want = String(data.chapterIndex);
                if (jumpSel.value !== want) jumpSel.value = want;
            }
        } catch (eTop) {}
        el('ipvPrev').disabled = idx === 0;
        el('ipvNext').disabled = idx === PAGES.length - 1;
    }

    function exportPreviewVisible() {
        var w = el('fmt-export-preview-wrap');
        return !!(w && !w.classList.contains('hidden') && w.offsetParent !== null);
    }

    function shouldBeActive() {
        // Keep ipv overlay OFF — open-spread / production formatter preview is the live UI.
        // Enabling ipv here stacked a second chrome ("Page 0 / 0") over the studio and spilled into the left column.
        return false;
    }

    function doRender() {
        var ov = overlay();
        if (!ov) return;
        readControls();
        ov.style.setProperty('--ipv-surface', THEMES[ipvState.theme].surface);
        PAGES = paginate();
        if (currentPage >= PAGES.length) currentPage = 0;
        if (currentPage < 0) currentPage = 0;
        renderPage(currentPage);
        // Publish the on-screen count as the source of truth and refresh the shared
        // "Total pages" label + autosave so Publish/spine match what the user sees.
        try {
            window.__ipvPageCount = PAGES.length;
            if (typeof window.syncFormatterPageCountUi === 'function') window.syncFormatterPageCountUi();
        } catch (e) {}
    }

    function scheduleRender() {
        clearTimeout(renderTimer);
        renderTimer = setTimeout(doRender, 120);
    }

    function signature() {
        readControls();
        var chs = getChapters();
        var firstLen = chs.length ? String(chs[0].content || '').length : 0;
        var ov = overlay();
        var scroll = ov ? ov.querySelector('.ipv-scroll') : null;
        var w = scroll ? scroll.clientWidth : 0;
        var h = scroll ? scroll.clientHeight : 0;
        return [ipvState.theme, ipvState.size, ipvState.lh, chs.length, firstLen,
            Math.round(w / 6), Math.round(h / 6), bookTitle(), shouldBeActive() ? 1 : 0].join('|');
    }

    function tick() {
        var ov = overlay();
        if (!ov) return;
        var active = shouldBeActive();
        ov.classList.toggle('ipv-active', active);
        try { window.__ipvActive = active; } catch (e) {}
        if (!active) return;
        var sig = signature();
        if (sig !== lastSig) { lastSig = sig; scheduleRender(); }
    }

    function init() {
        var ov = overlay();
        if (!ov) return;
        el('ipvPrev').addEventListener('click', function () { if (currentPage > 0) { currentPage--; renderPage(currentPage); } });
        el('ipvNext').addEventListener('click', function () { if (currentPage < PAGES.length - 1) { currentPage++; renderPage(currentPage); } });
        ['style-select', 'text-size-select', 'line-spacing-select'].forEach(function (id) {
            var c = el(id);
            if (c) c.addEventListener('change', function () { currentPage = 0; lastSig = ''; });
        });
        setInterval(tick, 450);
        if (document.fonts && document.fonts.ready) { document.fonts.ready.then(function () { lastSig = ''; }); }
        setTimeout(function () { lastSig = ''; tick(); }, 400);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
})();
</script>
