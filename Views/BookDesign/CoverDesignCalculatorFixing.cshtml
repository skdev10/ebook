            var imageInput = document.getElementById('fmt-ms-image-file');
            var imageBtn = document.getElementById('fmt-ms-image-btn');
            if (imageInput && imageBtn) {
                imageInput.setAttribute('multiple', 'multiple');

                function firstMeaningfulLine(text) {
