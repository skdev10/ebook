                        } catch (eNav) {
                            window.location.href = '/Books/Formatting/' + newBid;
                            return;
                        }
                    }
                    if (lastEl) {
                        var label = data.lastUploadedLabel || '';
                        var name = data.fileName || '';
                        lastEl.textContent = label
                            ? ('Last uploaded on ' + label + (name ? ' · ' + name : ''))
                            : 'Manuscript uploaded.';
                    }
                    setMsStatus('Imported ' + (data.chapterCount || 0) + ' chapter(s). Preview updating…', true);
                    try {
                        if (typeof formatterBookPayloadKey === 'function') {
                            sessionStorage.removeItem(formatterBookPayloadKey(newBid || bid));
                        }
                    } catch (e0) { /* optional */ }
                    lastLoadedBookPayloadSignature = '';
                    if (typeof loadBookContent === 'function' && (newBid || bid) > 0) {
                        await loadBookContent(newBid || bid);
                        try {
                            syncFmtPreviewLayout();
                            if (bookChapters.length) {
                                ensureReaderPages(true);
                                togglePreviewMode();
                                fmtScheduleRepaginateAfterLayout();
                            }
                        } catch (ePrev) { console.warn('[Book Formatter] preview refresh after upload', ePrev); }
                    }
                    setMsStatus('Imported ' + (data.chapterCount || 0) + ' chapter(s). TOC / preview updated.', true);
                    if (typeof showToast === 'function') showToast('Manuscript imported');
                } catch (err) {
                    setMsStatus('Network error during upload.', false);
                } finally {
                    uploadBtn.disabled = false;
                    fileInput.value = '';
                }
            }

            uploadBtn.addEventListener('click', function () { fileInput.click(); });
            fileInput.addEventListener('change', function () {
                if (fileInput.files && fileInput.files[0]) uploadManuscriptFile(fileInput.files[0]);
            });
            if (dropzone) {
                dropzone.addEventListener('click', function () { fileInput.click(); });
                dropzone.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
                });
                ['dragenter', 'dragover'].forEach(function (ev) {
