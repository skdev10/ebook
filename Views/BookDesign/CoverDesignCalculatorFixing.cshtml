<script src="~/js/cover-kdp-export.js" asp-append-version="true"></script>
<script src="~/js/module-export.js" asp-append-version="true"></script>
<script>
(function() {
    'use strict';

    /* No client timeout: let the server finish loading from DB so the book always completes */
    const FORMATTER_BOOK_KEY = typeof window.EBOOK_FORMATTER_BOOK_KEY === 'string' ? window.EBOOK_FORMATTER_BOOK_KEY : 'ebook_formatter_book_id';
    const PREVIEW_EMPTY_MSG = 'Open your book from the Dashboard (Continue Editing), then return to Book Formatting to see your preview.';
    const PREVIEW_NO_DATA_MSG = 'No chapters yet. Open AI Writer from the Dashboard, add chapters, then come back here.';
    const PREVIEW_ERROR_MSG = 'Something went wrong. Please try again or select another book.';

    const root = document.getElementById('book-formatter-root');
    /* Read from data-* only (no Razor tokens in this script; user/book ids come from #book-formatter-root). */
    const userId = parseInt((root && root.getAttribute('data-user-id')) || '0', 10);
    const serverBookPayload = @Html.Raw(initialBookPayloadJson);
    let initialBookId = parseInt((root && root.getAttribute('data-book-id')) || '0', 10);
    let formatFromUrl = (root && root.getAttribute('data-format')) || 'Paperback';
    if (/^print$/i.test(formatFromUrl)) formatFromUrl = 'Paperback';
    if (!formatFromUrl) formatFromUrl = 'Paperback';
    function parseRootFloat(name, fallback) {
        var raw = root ? root.getAttribute(name) : '';
        var n = parseFloat(raw || '');
        return Number.isFinite(n) ? n : fallback;
    }
    var kdpPaper = (window.__kdpSpecs && window.__kdpSpecs.paper) || {};
    const printReadyConfig = {
        whiteMultiplier: parseRootFloat('data-pr-white', kdpPaper.white ?? 0.002252),
        creamMultiplier: parseRootFloat('data-pr-cream', kdpPaper.cream ?? 0.0025),
        colorMultiplier: parseRootFloat('data-pr-color', kdpPaper.premiumColor ?? kdpPaper.standardColor ?? 0.002347),
        bleedInches: parseRootFloat('data-pr-bleed', (window.__kdpSpecs && window.__kdpSpecs.bleedIn) ?? 0.125),
        defaultTrimW: parseRootFloat('data-pr-trim-w', 6.0),
        defaultTrimH: parseRootFloat('data-pr-trim-h', 9.0)
    };

    /** When present on the URL (?format=Ebook etc.), keep preview mode in sync after GetBookFormatting / local draft (matches AI Writer deep links). */
    function getBookIdFromUrl() {
        try {
            var v = parseInt(new URLSearchParams(window.location.search || '').get('bookId') || '0', 10);
            return Number.isFinite(v) && v > 0 ? v : 0;
        } catch (e) { return 0; }
    }
    function getFormatQueryParam() {
        try {
            var v = new URLSearchParams(window.location.search || '').get('format');
            if (!v) return null;
            v = String(v).trim();
            if (/^print$/i.test(v)) return 'Paperback';
            if (/^paperback$/i.test(v)) return 'Paperback';
            if (/^hardcover$/i.test(v)) return 'Paperback';
            if (/^ebook$/i.test(v)) return 'Ebook';
            if (/^both$/i.test(v)) return 'Both';
        } catch (e) { /* ignore */ }
        return null;
    }
    var formatLockedByQuery = getFormatQueryParam();

    if (initialBookId <= 0) initialBookId = getBookIdFromUrl();

    // Soft mid-entry: opening Formatting with no bookId stays blank (no session auto-attach).
    // Start-to-finish flow always passes bookId in the URL from Writer / Dashboard.
    if (initialBookId > 0) {
        try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(initialBookId)); } catch (e) {}
    }

    let bookChapters = [];
    let formatterBookTitle = '';
    /** Book-level fields for template placeholders ([Title], etc.) */
    let bookPreviewContext = { bookTitle: '', subtitle: '', description: '', genre: '', authorName: '' };
    let currentChapterIdx = 0;
    let readerPages = [];
    /** Parallel to readerPages: source chapter index (0-based) for each page. */
    let readerPageChapterIdx = [];
    let currentPageIdx = 0;

    /* Typography comes from InteriorExportTheme.BuildFormatterInteriorCss on #paginatedReaderShell.interior-* */
    function fmtValidClassTokens(list) {
        return (list || []).filter(function(c) { return typeof c === 'string' && c.trim().length > 0; });
    }
    function fmtRemoveClasses(el, tokens) {
        if (!el || !el.classList) return;
        fmtValidClassTokens(tokens).forEach(function(c) { el.classList.remove(c); });
    }
    var interiorStyleClassMap = {
        'Minimalist': '',
        'Novel': '',
        'Modern': '',
        'Classic': '',
        'ElegantTrade': '',
        'Traditional': '',
        'Contemporary': '',
        'FineBook': '',
        'Clean': '',
        'POD': '',
        'ElegantTradePOD': ''
    };
    var interiorPreviewShellMap = {
        'Minimalist': 'interior-preview-minimalist',
        'Novel': 'interior-preview-novel',
        'Modern': 'interior-preview-modern',
        'Classic': 'interior-preview-classic',
        'ElegantTrade': 'interior-preview-elegant',
        'Traditional': 'interior-preview-novel',
        'Contemporary': 'interior-preview-modern',
        'FineBook': 'interior-preview-classic',
        'Clean': 'interior-preview-minimalist',
        'POD': 'interior-preview-novel',
        'ElegantTradePOD': 'interior-preview-elegant'
    };
    var interiorWrapClassMap = {
        'Minimalist': 'interior-minimalist',
        'Novel': 'interior-novel',
        'Modern': 'interior-modern',
        'Classic': 'interior-classic',
        'ElegantTrade': 'interior-elegant-trade',
        'Traditional': 'interior-traditional',
        'Contemporary': 'interior-contemporary',
        'FineBook': 'interior-fine-book',
        'Clean': 'interior-clean',
        'POD': 'interior-pod',
        'ElegantTradePOD': 'interior-elegant-trade-pod'
    };
    var fmtMatClassMap = {
        'Minimalist': 'fmt-mat-minimalist',
        'Novel': 'fmt-mat-novel',
        'Modern': 'fmt-mat-modern',
        'Classic': 'fmt-mat-classic',
        'ElegantTrade': 'fmt-mat-elegant-trade',
        'Traditional': 'fmt-mat-traditional',
        'Contemporary': 'fmt-mat-contemporary',
        'FineBook': 'fmt-mat-fine-book',
        'Clean': 'fmt-mat-clean',
        'POD': 'fmt-mat-pod',
        'ElegantTradePOD': 'fmt-mat-elegant-trade-pod'
    };
    var allInteriorStyleClasses = fmtValidClassTokens(Object.values(interiorStyleClassMap));
    var allInteriorShellClasses = fmtValidClassTokens(Object.values(interiorPreviewShellMap));
    var allInteriorWrapClasses = fmtValidClassTokens(Object.values(interiorWrapClassMap));
    var allFmtMatClasses = fmtValidClassTokens(Object.values(fmtMatClassMap));

    /** 6×9 trim pagination: chars per preview page (not PARAS count). */
    const CONTENT_CHARS_SOFT_LIMIT = 5500;
    const FORMATTER_DRAFT_PREFIX = 'formatter_draft_v2_';
    const FORMATTER_BOOK_PAYLOAD_PREFIX = 'formatter_book_payload_v1_';
    const FORMATTER_BOOK_PAYLOAD_MAX_AGE_MS = 30 * 60 * 1000;
    let autosaveTimer = null;
    let autosaveInFlight = false;
    let autosaveQueued = false;
    let fmtPreviewShellInitialized = false;
    let lastSyncedPreviewPageCount = 0;
    let lastReaderBuildKey = '';
    let lastLoadedBookPayloadSignature = '';

    function formatterDraftKey(bid) {
        return FORMATTER_DRAFT_PREFIX + String(bid || 0);
    }

    function formatterBookPayloadKey(bid) {
        return FORMATTER_BOOK_PAYLOAD_PREFIX + String(bid || 0);
    }

    /** Page count shown in preview — source of truth for KDP spine on export. */
    function getFormatterPreviewPageCount() {
        var maxP = (window.__kdpSpecs && window.__kdpSpecs.paperback && window.__kdpSpecs.paperback.max) || 828;
        // Single source of truth: when the on-screen real-template preview (overlay) is active,
        // its page count is exactly what the user sees on the Book Formatting screen. Use it so
        // the "Total pages" label, the autosaved count, Publish, and the cover spine all agree.
        var ipv = parseInt(window.__ipvPageCount, 10);
        if (window.__ipvActive && Number.isFinite(ipv) && ipv > 0) return Math.min(maxP, ipv);
        var total = Array.isArray(readerPages) ? readerPages.length : 0;
        if (!Number.isFinite(total) || total <= 0) return 0;
        return Math.min(maxP, total);
    }
    window.getFormatterPreviewPageCount = getFormatterPreviewPageCount;

    function syncFormatterPageCountUi() {
        var pages = getFormatterPreviewPageCount();
        var totalVal = document.getElementById('fmt-total-page-count-value');
        var totalWrap = document.getElementById('fmt-total-page-count');
        var noteEl = document.getElementById('fmt-spine-page-note');
        if (totalVal) {
            totalVal.textContent = pages > 0 ? String(pages) : '—';
        }
        if (totalWrap) {
            totalWrap.classList.toggle('hidden', pages <= 0);
        }
        if (noteEl) {
            if (pages > 0) noteEl.classList.remove('hidden');
            else noteEl.classList.add('hidden');
        }
        if (pages > 0) {
            recalcPrintReadyModalMetrics({ pageCount: pages });
            if (pages !== lastSyncedPreviewPageCount) {
                lastSyncedPreviewPageCount = pages;
                queueAutosave(800);
            }
        }
    }
    window.syncFormatterPageCountUi = syncFormatterPageCountUi;

    function getFormatterPageBackgroundColor() {
        var root = document.getElementById('book-formatter-root');
        if (root) {
            var v = window.getComputedStyle(root).getPropertyValue('--ilt-page-bg').trim();
            if (/^#[0-9A-Fa-f]{6}$/.test(v)) return v;
        }
        var pageBgInput = document.getElementById('fmt-page-background');
        if (pageBgInput && /^#[0-9A-Fa-f]{6}$/.test(String(pageBgInput.value || '').trim())) {
            return String(pageBgInput.value).trim();
        }
        return null;
    }

    function getFormatterStateFromUi() {
        var accentEl = document.getElementById('fmt-preview-accent');
        var fmt = (document.getElementById('format-select') && document.getElementById('format-select').value) || 'Paperback';
        return {
            format: fmt,
            interiorStyle: (document.getElementById('style-select') && document.getElementById('style-select').value) || 'Novel',
            textSize: (document.getElementById('text-size-select') && document.getElementById('text-size-select').value) || 'Medium',
            lineSpacing: (document.getElementById('line-spacing-select') && document.getElementById('line-spacing-select').value) || '1.6',
            publishingPlatforms: getSelectedPlatforms(),
            publishingPlatform: (getSelectedPlatformsArray()[0] || ''),
            previewAccent: (accentEl && accentEl.value) ? accentEl.value : '#5b21b6',
            pageBackgroundColor: getFormatterPageBackgroundColor(),
            previewPageCount: getFormatterPreviewPageCount(),
            savedAtUtc: new Date().toISOString()
        };
    }
    window.getFormatterStateFromUi = getFormatterStateFromUi;

    function persistFormatterDraftLocal(state, bid) {
        const numId = parseInt(bid || (document.getElementById('selected-book-id') && document.getElementById('selected-book-id').value) || '0', 10);
        if (!numId || !state) return;
        try {
            localStorage.setItem(formatterDraftKey(numId), JSON.stringify(state));
        } catch (e) { /* ignore quota issues */ }
    }

    function applyFormatterStateToUi(state, opts) {
        opts = opts || {};
        if (!state) return;
        const fmtEl = document.getElementById('format-select');
        const styleEl = document.getElementById('style-select');
        const sizeEl = document.getElementById('text-size-select');
        const lineEl = document.getElementById('line-spacing-select');
            if (fmtEl && state.format && ['Ebook', 'Paperback', 'Both'].indexOf(state.format) >= 0) fmtEl.value = state.format;
            else if (fmtEl && state.format === 'Hardcover') fmtEl.value = 'Paperback';
        if (styleEl && state.interiorStyle) {
            var styleVal = state.interiorStyle === 'Modern' ? 'Novel' : state.interiorStyle;
            styleEl.value = styleVal;
        }
        if (sizeEl && state.textSize) sizeEl.value = state.textSize;
        if (lineEl && state.lineSpacing) lineEl.value = state.lineSpacing;
        if (state.publishingPlatforms) setSelectedPlatforms(state.publishingPlatforms);
        selectedFormat = (fmtEl && fmtEl.value) || selectedFormat;
        var accentIn = document.getElementById('fmt-preview-accent');
        if (accentIn && state.previewAccent && /^#[0-9A-Fa-f]{6}$/.test(String(state.previewAccent).trim())) {
            accentIn.value = String(state.previewAccent).trim();
        }
        updatePremiumFormatUi();
        if (!opts.skipPreviewToggle) togglePreviewMode();
        syncFmtInteriorCardsFromSelect();
        syncFmtTypographyPillsFromSelects();
        applyFmtStudioAccent();
        syncInteriorTokenVars();
        syncFormatterNextActionUi();
    }

    function loadFormatterDraftLocal(bid) {
        const numId = parseInt(bid || '0', 10);
        if (!numId) return null;
        try {
            const raw = localStorage.getItem(formatterDraftKey(numId));
            return raw ? JSON.parse(raw) : null;
        } catch (e) {
            return null;
        }
    }

    function applyFmtStudioAccent() {
        var host = document.getElementById('fmt-preview-accent-host');
        var input = document.getElementById('fmt-preview-accent');
        if (!host) return;
        var hex = (input && input.value) ? input.value.trim() : '#5b21b6';
        if (!/^#[0-9A-Fa-f]{6}$/.test(hex)) hex = '#5b21b6';
        host.style.setProperty('--fmt-preview-accent', hex);
        document.documentElement.style.setProperty('--fmt-accent', hex);
    }

    /** Keep preview CSS vars in sync with InteriorLayoutTokens (same values as PDF export). */
    function syncInteriorTokenVars() {
        var specsEl = document.getElementById('ilt-specs');
        if (!specsEl) return;
        var specs;
        try { specs = JSON.parse(specsEl.textContent || '{}'); } catch (e) { return; }
        var styleEl = document.getElementById('style-select');
        var interior = styleEl ? (styleEl.value || 'Novel') : 'Novel';
        var interiors = specs.interiors || specs;
        var spec = interiors[interior] || interiors['Novel'];
        if (!spec) return;
        var targets = [
            document.documentElement,
            document.getElementById('paginatedReaderShell'),
            document.getElementById('bookStage'),
            document.getElementById('bookContainer')
        ].filter(Boolean);
        targets.forEach(function(root) {
        var sp = specs.spacing;
        if (sp) {
            if (sp.chapterDrop) root.style.setProperty('--ilt-chapter-drop', sp.chapterDrop);
            if (sp.textMax) root.style.setProperty('--ilt-text-max', sp.textMax);
            if (sp.runningHeadGapBelow) root.style.setProperty('--ilt-running-head-gap', sp.runningHeadGapBelow);
            if (sp.folioGapAbove) root.style.setProperty('--ilt-folio-gap', sp.folioGapAbove);
            if (sp.frontPadTop) root.style.setProperty('--ilt-front-pad-top', sp.frontPadTop);
            if (sp.titlePagePadTop) root.style.setProperty('--ilt-title-page-pad-top', sp.titlePagePadTop);
        }
        root.style.setProperty('--ilt-sheet-bg', spec.sheetBg || '');
        root.style.setProperty('--ilt-page-bg', spec.pageBg || spec.sheetBg || '');
        root.style.setProperty('--ilt-pad-top', spec.padTop || '');
        root.style.setProperty('--ilt-pad-right', spec.padRight || '');
        root.style.setProperty('--ilt-pad-bottom', spec.padBottom || '');
        root.style.setProperty('--ilt-pad-left', spec.padLeft || '');
        if (spec.pageBg) root.style.setProperty('--ilt-page-surface', spec.pageBg);
        if (spec.matBg) root.style.setProperty('--ilt-mat-bg', spec.matBg);
        if (spec.matBorder) root.style.setProperty('--ilt-mat-border', spec.matBorder);
        if (spec.sheetBorder) root.style.setProperty('--ilt-sheet-border', spec.sheetBorder);
        if (spec.sheetShadow) root.style.setProperty('--ilt-sheet-shadow', spec.sheetShadow);
        if (spec.containerShadow) root.style.setProperty('--ilt-container-shadow', spec.containerShadow);
        });
        var pageBgInput = document.getElementById('fmt-page-background');
        if (pageBgInput && /^#[0-9A-Fa-f]{6}$/.test(String(pageBgInput.value || '').trim())) {
            var pageBg = String(pageBgInput.value).trim();
            targets.forEach(function(root) { root.style.setProperty('--ilt-page-bg', pageBg); });
        }
    }

    var FMT_FRONT_MATTER_PAGE_COUNT = 3;

    function isFrontMatterChapter(ch) {
        var n = ch && ch.chapterNo != null ? parseInt(String(ch.chapterNo), 10) : NaN;
        return Number.isFinite(n) && n <= 0;
    }

    function getPreviewStyleHeading(title, chapterNo, narrativeOrd) {
        var chNo = chapterNo != null ? parseInt(String(chapterNo), 10) : NaN;
        if (!Number.isFinite(chNo)) chNo = narrativeOrd;
        var t = (title || '').trim();
        if (chNo <= 0) return t || 'Front matter';
        if (!t || /^\s*Chapter\s*0\s*:?\s*$/i.test(t)) return 'Chapter ' + narrativeOrd;
        if (/^\s*Chapter\s+\d+/i.test(t)) return t;
        return 'Chapter ' + narrativeOrd + ': ' + t;
    }

    function extractHeadingsFromBodyHtml(html) {
        var out = [];
        if (!html) return out;
        try {
            var d = document.createElement('div');
            d.innerHTML = html;
            d.querySelectorAll('h1,h2,h3,h4,h5,h6').forEach(function(h) {
                var text = (h.textContent || '').replace(/\s+/g, ' ').trim();
                if (text) out.push(text);
            });
        } catch (e) { /* ignore */ }
        return out;
    }

    function firstReaderPageForChapter(chapterIdxs, ci) {
        for (var i = 0; i < chapterIdxs.length; i++) {
            if (chapterIdxs[i] === ci) return i;
        }
        return 0;
    }

    function buildTocPageHtml(chapterIdxs, frontMatterOffset) {
        var items = [];
        var narrative = 0;
        for (var i = 0; i < bookChapters.length; i++) {
            var ch = bookChapters[i];
            if (!isFrontMatterChapter(ch)) narrative++;
            var phNum = isFrontMatterChapter(ch) ? 1 : narrative;
            var title = (ch && ch.chapterTitle) || ('Chapter ' + (i + 1));
            var line = getPreviewStyleHeading(title, ch && ch.chapterNo, phNum);
            var bodyHtml = formatChapterContent((ch && ch.content) || '');
            var subs = extractHeadingsFromBodyHtml(bodyHtml);
            var pageNo = firstReaderPageForChapter(chapterIdxs, i) + frontMatterOffset + 1;
            var subHtml = '';
            if (subs.length) {
                subHtml = '<ul class="toc-subheadings">' + subs.map(function(h) {
                    return '<li class="toc-subheading-item"><span class="toc-sub-text">' + escapeHtml(h) + '</span></li>';
                }).join('') + '</ul>';
            }
            items.push(
                '<li class="toc-item"><div class="toc-chapter-line">' +
                '<span class="toc-entry-text"><a href="#" class="toc-link" data-goto-page="' + pageNo + '">' + escapeHtml(line) + '</a></span>' +
                '<span class="toc-leader" aria-hidden="true"></span>' +
                '<span class="toc-page-ref">' + pageNo + '</span></div>' + subHtml + '</li>'
            );
        }
        if (!items.length) items.push('<li class="toc-item toc-item-empty">No chapters yet.</li>');
        return '<div class="front-matter-page toc-page book-preview-sheet"><div class="toc-block">' +
            '<h1 class="toc-title">Contents</h1><nav class="toc-nav" aria-label="Table of contents">' +
            '<ol class="toc-list">' + items.join('') + '</ol></nav></div></div>';
    }

    function buildTitlePageHtml() {
        var ctx = bookPreviewContext || {};
        var title = (ctx.bookTitle || '').trim() || 'Untitled';
        var author = (ctx.authorName || '').trim();
        var genre = (ctx.genre || '').trim();
        var subtitle = (ctx.subtitle || '').trim();
        return '<div class="front-matter-page title-page"><h1>' + escapeHtml(title) + '</h1>' +
            (subtitle ? '<p class="subtitle">' + escapeHtml(subtitle) + '</p>' : '') +
            (author ? '<p class="title-page-author">' + escapeHtml(author) + '</p>' : '') +
            (genre ? '<p class="title-page-genre">' + escapeHtml(genre) + '</p>' : '') +
            '</div>';
    }

    function buildCopyrightPageHtml() {
        var ctx = bookPreviewContext || {};
        var title = (ctx.bookTitle || '').trim() || 'Untitled';
        var author = (ctx.authorName || '').trim() || 'Author';
        var year = new Date().getFullYear();
        return '<div class="front-matter-page copyright-page book-preview-sheet"><div class="copyright-block">' +
            '<p class="cr-meta"><strong>' + escapeHtml(title) + '</strong></p>' +
            (ctx.authorName ? '<p class="cr-meta">' + escapeHtml(ctx.authorName) + '</p>' : '') +
            '<p class="cr-legal">Copyright &copy; ' + year + ' ' + escapeHtml(author) + '. All rights reserved.</p>' +
            '</div></div>';
    }

    function prependFrontMatterToReaderPages(pages, chapterIdxs) {
        if (!pages.length) return { pages: pages, chapterIdxs: chapterIdxs };
        var fmOffset = FMT_FRONT_MATTER_PAGE_COUNT;
        var toc = buildTocPageHtml(chapterIdxs, fmOffset);
        var fmPages = [buildTitlePageHtml(), buildCopyrightPageHtml(), toc];
        var fmIdxs = [-1, -1, -1];
        return {
            pages: fmPages.concat(pages),
            chapterIdxs: fmIdxs.concat(chapterIdxs)
        };
    }

    var fmtTocNavWired = false;
    function wireFormatterTocLinks() {
        if (fmtTocNavWired) return;
        var root = document.getElementById('preview-content') || document.getElementById('bookStage');
        if (!root) return;
        fmtTocNavWired = true;
        root.addEventListener('click', function(e) {
            var anchor = e.target && e.target.closest ? e.target.closest('.toc-link[data-goto-page]') : null;
            if (!anchor) return;
            e.preventDefault();
            var p = parseInt(anchor.getAttribute('data-goto-page') || '', 10);
            if (!Number.isFinite(p) || p < 1) return;
            navigateToReaderPage(p - 1);
            persistReaderPageBookmark();
        });
    }

    function syncFmtInteriorCardsFromSelect() {
        var sel = document.getElementById('style-select');
        var wrap = document.getElementById('fmt-interior-cards');
        if (!sel || !wrap) return;
        var v = sel.value || 'Novel';
        wrap.querySelectorAll('.fmt-int-card').forEach(function(btn) {
            btn.classList.toggle('is-selected', btn.getAttribute('data-style') === v);
        });
    }

    function syncFmtTypographyPillsFromSelects() {
        var sz = document.getElementById('text-size-select');
        var ln = document.getElementById('line-spacing-select');
        var rowS = document.getElementById('fmt-text-size-pills');
        var rowL = document.getElementById('fmt-line-pills');
        if (rowS && sz) {
            var sv = sz.value || 'Medium';
            rowS.querySelectorAll('.fmt-pill').forEach(function(p) {
                p.classList.toggle('is-on', p.getAttribute('data-size') === sv);
            });
        }
        if (rowL && ln) {
            var lv = ln.value || '1.6';
            rowL.querySelectorAll('.fmt-pill').forEach(function(p) {
                p.classList.toggle('is-on', p.getAttribute('data-line') === lv);
            });
        }
    }

    function storageReaderKey(bid) {
        return 'ebook_reader_pos_' + bid;
    }

    function persistReaderPosition() {
        const hid = document.getElementById('selected-book-id');
        const bid = parseInt((hid && hid.value) || '0', 10);
        if (!bid || readerPages.length === 0) return;
        try {
            localStorage.setItem(storageReaderKey(bid), JSON.stringify({
                page: currentPageIdx,
                chapter: readerPageChapterIdx[currentPageIdx] || 0,
                at: Date.now()
            }));
        } catch (e) { /* quota / private mode */ }
    }

    function restoreReaderPosition(bid) {
        if (!bid || readerPages.length === 0) return;
        try {
            const raw = localStorage.getItem(storageReaderKey(bid));
            if (!raw) return;
            const o = JSON.parse(raw);
            if (o && typeof o.page === 'number' && o.page >= 0 && o.page < readerPages.length) {
                currentPageIdx = o.page;
            }
        } catch (e) { /* ignore */ }
    }

    function splitLongText(text, maxChunk) {
        const out = [];
        let s = (text || '').trim();
        if (!s) return out;
        while (s.length > maxChunk) {
            var cut = s.lastIndexOf(' ', maxChunk);
            if (cut < Math.floor(maxChunk * 0.45)) cut = maxChunk;
            out.push(s.substring(0, cut).trim());
            s = s.substring(cut).trim();
        }
        if (s) out.push(s);
        return out;
    }

    /** Split oversized HTML on closing </p> boundaries so tags stay intact. */
    function splitHtmlByApproxSize(html, maxChars) {
        var s = String(html);
        var pieces = [];
        var curStart = 0;
        var re = /<\/p\s*>/gi;
        var m;
        while ((m = re.exec(s)) !== null) {
            var end = m.index + m[0].length;
            var piece = s.substring(curStart, end).trim();
            curStart = end;
            if (piece) pieces.push(piece);
        }
        if (curStart < s.length) {
            var tail = s.substring(curStart).trim();
            if (tail) pieces.push(tail);
        }
        if (!pieces.length) {
            if (s.length <= maxChars) return [s];
            var st = s.replace(/<[^>]+>/g, ' ');
            return splitLongText(st, maxChars);
        }
        var out = [];
        var buf = '';
        for (var i = 0; i < pieces.length; i++) {
            if (!buf.length) {
                buf = pieces[i];
            } else if (buf.length + pieces[i].length + 2 <= maxChars) {
                buf += '\n\n' + pieces[i];
            } else {
                out.push(buf);
                buf = pieces[i];
            }
        }
        if (buf) out.push(buf);
        for (var j = 0; j < out.length; j++) {
            if (out[j].length > maxChars) {
                var stripped = out[j].replace(/<[^>]+>/g, ' ');
                out[j] = splitLongText(stripped, maxChars).join('\n\n');
            }
        }
        return out.length ? out : [s];
    }

    /** Split plain text on blank lines (same rules as AI Book Writer preview). */
    function splitPlainTextIntoParagraphs(text) {
        var lines = String(text || '').split('\n');
        var out = [];
        var buf = [];
        function flush() {
            if (!buf.length) return;
            out.push(buf.join('\n').trim());
            buf = [];
        }
        for (var i = 0; i < lines.length; i++) {
            var t = lines[i].trim();
            if (!t) { flush(); continue; }
            buf.push(lines[i]);
        }
        flush();
        return out.length ? out : (String(text || '').trim() ? [String(text).trim()] : []);
    }

    /** Unwrap a single &lt;p&gt; that contains multiple logical paragraphs. */
    function expandMonolithicChapterHtml(html) {
        var s = String(html || '').trim();
        if (!s) return s;
        try {
            var doc = new DOMParser().parseFromString(s, 'text/html');
            var body = doc.body;
            if (!body) return s;
            var ps = body.querySelectorAll('p');
            if (ps.length === 1) {
                var lone = ps[0];
                var inner = (lone.innerHTML || '').trim();
                var text = (lone.textContent || '').trim();
                if (/\n\s*\n/.test(text)) {
                    return formatManuscriptPlainToHtml(text);
                }
                if (/<br\s*\/?>/i.test(inner)) {
                    var parts = inner.split(/<br\s*\/?>/i).map(function(x) {
                        return x.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
                    }).filter(Boolean);
                    if (parts.length > 1) {
                        return parts.map(function(t) {
                            return '<p class="manuscript-p">' + escapeHtml(t) + '</p>';
                        }).join('');
                    }
                }
            }
            if (ps.length === 0 && textLooksPlainWithBreaks(s)) {
                return formatManuscriptPlainToHtml(s.replace(/<[^>]+>/g, '\n'));
            }
        } catch (e) { /* ignore */ }
        return s;
    }

    function textLooksPlainWithBreaks(s) {
        return !/<\s*(p|div|h[1-6]|ul|ol|blockquote)\b/i.test(s) && /\n/.test(s);
    }

    function buildFmtChapterHeading(chapterNo, chapterTitle) {
        var n = parseInt(chapterNo, 10);
        if (!Number.isFinite(n) || n <= 0) n = 1;
        var eyebrow = 'Chapter ' + n;
        var title = String(chapterTitle == null ? '' : chapterTitle).trim();
        // Drop the title line when it is empty or just repeats "Chapter N".
        var showTitle = title && !/^chapter\s+\d+$/i.test(title) && title.toLowerCase() !== eyebrow.toLowerCase();
        var titleHtml = showTitle ? ('<span class="fmt-ch-title">' + escapeHtml(title) + '</span>') : '';
        // Structured opener (flourish / eyebrow / title / rule). Each theme shows
        // only the parts it wants via CSS, so the chapter opening reads like a
        // real book — different per interior style.
        return '<header class="fmt-chapter-opener manuscript-chapter-heading">' +
            '<span class="fmt-ch-flourish" aria-hidden="true">\u2766</span>' +
            '<span class="fmt-ch-eyebrow">' + escapeHtml(eyebrow) + '</span>' +
            titleHtml +
            '<span class="fmt-ch-rule" aria-hidden="true"></span>' +
            '</header>';
    }

    /** Top-level block nodes from parsed HTML (avoids breaking tags mid-chapter). */
    function splitHtmlChapterIntoBlocks(html) {
        var s = String(html || '').trim();
        if (!s) return [];
        try {
            var doc = new DOMParser().parseFromString(s, 'text/html');
            var body = doc.body;
            if (!body) return [s];
            var blocks = [];
            for (var i = 0; i < body.childNodes.length; i++) {
                var n = body.childNodes[i];
                if (n.nodeType === 1) blocks.push(n.outerHTML);
            }
            if (!blocks.length && body.innerHTML && body.innerHTML.trim()) {
                return [body.innerHTML.trim()];
            }
            if (blocks.length === 1) {
                var el = body.firstElementChild;
                if (el && el.tagName === 'DIV' && el.children && el.children.length > 1) {
                    var inner = [];
                    for (var k = 0; k < el.children.length; k++) {
                        inner.push(el.children[k].outerHTML);
                    }
                    if (inner.length > 1) return inner;
                }
            }
            return blocks.length ? blocks : [s];
        } catch (e) {
            return [s];
        }
    }

    /** Split chapter body into logical blocks for pagination (handles single \\n manuscripts and long HTML). */
    function splitChapterIntoParas(raw) {
        const content = (raw || '').toString().trim();
        if (!content) return [];
        const looksLikeHtml = /<\s*(p|h1|h2|h3|h4|blockquote|ul|ol|li|br|div)\b/i.test(content);
        var paras;
        if (looksLikeHtml) {
            paras = splitHtmlChapterIntoBlocks(content);
            if (!paras.length) paras = [content];
            if (paras.length === 1) {
                var one = paras[0];
                if (one.length > CONTENT_CHARS_SOFT_LIMIT) {
                    var brPieces = one.split(/<br\s*\/?>/i).map(function(x) { return x.trim(); }).filter(Boolean);
                    if (brPieces.length > 8) {
                        paras = brPieces;
                    } else {
                        paras = splitHtmlByApproxSize(one, Math.max(CONTENT_CHARS_SOFT_LIMIT * 2, 8000));
                    }
                }
            }
        } else {
            paras = splitPlainTextIntoParagraphs(content);
            if (paras.length === 1 && paras[0].length > CONTENT_CHARS_SOFT_LIMIT) {
                paras = splitLongText(paras[0], CONTENT_CHARS_SOFT_LIMIT);
            }
        }
        // Keep headings attached to following text block so preview never shows heading-only pages.
        paras = mergeHeadingOnlyBlocks(paras);
        return paras;
    }

    function mergeHeadingOnlyBlocks(paras) {
        var list = Array.isArray(paras) ? paras.slice() : [];
        if (!list.length) return list;
        var out = [];
        for (var i = 0; i < list.length; i++) {
            var block = String(list[i] || '').trim();
            if (!block) continue;
            if (!out.length) {
                out.push(block);
                continue;
            }
            var isMarkdownHeading = /^#{1,6}\s+/.test(block);
            var isHtmlHeading = /^<h[1-6]\b[^>]*>[\s\S]*<\/h[1-6]>$/i.test(block);
            var isHeadingOnly = isMarkdownHeading || isHtmlHeading;
            if (isHeadingOnly && i < list.length - 1) {
                var next = String(list[i + 1] || '').trim();
                if (next) {
                    out.push(block + '\n\n' + next);
                    i++;
                    continue;
                }
            }
            out.push(block);
        }
        return out;
    }

    function getFmtTrimLabel() {
        var w = printReadyConfig.defaultTrimW || 6;
        var h = printReadyConfig.defaultTrimH || 9;
        return fmtNumber(w, 1) + ' × ' + fmtNumber(h, 1) + ' in';
    }

    /** Character budget per 6×9 page from trim size + typography (formatter preview). */
    function getFmtPageCharBudgets() {
        var sizeEl = document.getElementById('text-size-select');
        var size = sizeEl ? sizeEl.value : 'Medium';
        var mult = size === 'Small' ? 1.1 : (size === 'Large' ? 0.84 : 1);
        var trimW = printReadyConfig.defaultTrimW || 6;
        var trimH = printReadyConfig.defaultTrimH || 9;
        var areaFactor = (trimW * trimH) / 54;
        return {
            cont: Math.max(600, Math.round(1350 * areaFactor * mult)),
            first: Math.max(450, Math.round(900 * areaFactor * mult)),
            trimLabel: getFmtTrimLabel()
        };
    }

    /** Group paragraphs into page-sized chunks for 6×9 paginated preview. */
    function chunkParasIntoPages(paras, firstBudget, contBudget) {
        var budgets = getFmtPageCharBudgets();
        firstBudget = firstBudget != null ? firstBudget : budgets.first;
        contBudget = contBudget != null ? contBudget : budgets.cont;
        var chunks = [];
        var current = [];
        var size = 0;
        var budget = firstBudget;
        (paras || []).forEach(function(p) {
            var block = (p || '').trim();
            if (!block) return;
            var plen = block.length;
            if (current.length && size + plen + 2 > budget) {
                chunks.push(current);
                current = [];
                size = 0;
                budget = contBudget;
            }
            current.push(block);
            size += plen + (current.length > 1 ? 2 : 0);
        });
        if (current.length) chunks.push(current);
        return chunks.length ? chunks : [[]];
    }

    /** Split any oversized blocks so Next/Previous always has meaningful steps. */
    function expandParasForPaging(paras) {
        var maxPlain = 50000;
        var maxHtml = 100000;
        var out = [];
        (paras || []).forEach(function(p) {
            var s = (p || '').trim();
            if (!s) return;
            var isHtml = /<\s*[a-z]/i.test(s);
            if (isHtml) {
                if (s.length <= maxHtml) out.push(s);
                else Array.prototype.push.apply(out, splitHtmlByApproxSize(s, maxHtml));
            } else {
                if (s.length <= maxPlain) out.push(s);
                else Array.prototype.push.apply(out, splitLongText(s, maxPlain));
            }
        });
        return out;
    }

    var fmtRepaginateTimer = null;

    function getFmtMeasureShellWidth() {
        var shell = document.getElementById('paginatedReaderShell');
        if (!shell || shell.clientWidth <= 48) {
            shell = document.getElementById('paginatedReaderShellEbook');
        }
        var root = document.getElementById('book-formatter-root');
        var isSpread = (shell && shell.classList.contains('is-open-spread'))
            || (root && root.getAttribute('data-spread') === '1');
        if (shell && shell.clientWidth > 48) {
            // Open-book spread is two faces + spine — measure one face only.
            if (isSpread) return Math.max(48, Math.floor((shell.clientWidth - 10) / 2));
            return shell.clientWidth;
        }
        var host = document.getElementById('fmt-preview-scroll-host');
        if (host && host.clientWidth > 48) {
            return isSpread ? Math.max(48, Math.floor((host.clientWidth - 10) / 2)) : host.clientWidth;
        }
        var pane = document.querySelector('.fmt-preview-pane');
        if (pane && pane.clientWidth > 48) {
            return isSpread ? Math.max(48, Math.floor((pane.clientWidth - 10) / 2)) : pane.clientWidth;
        }
        return Math.floor(window.innerWidth * (isSpread ? 0.34 : 0.68));
    }

    function getFmtReaderPageChromeY() {
        var rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        // .book-open-running-head + .book-open-folio + page-inner vertical padding
        return Math.ceil(2.55 * rem) + 1 + Math.ceil(1.35 * rem) + Math.ceil(0.7 * rem);
    }

    function syncPageRunningHead(headEl, pageIdx) {
        if (!headEl) return;
        var ci = readerPageChapterIdx.length > pageIdx ? readerPageChapterIdx[pageIdx] : -1;
        if (ci < 0) {
            headEl.textContent = '';
            headEl.classList.add('is-empty');
            headEl.setAttribute('aria-hidden', 'true');
            return;
        }
        var bookTitle = String((bookPreviewContext && bookPreviewContext.bookTitle) || '').trim();
        // Real-book running heads: book title on verso (even pages), chapter title on recto (odd pages).
        var chapterTitle = '';
        try {
            var ch = (typeof bookChapters !== 'undefined' && bookChapters && bookChapters[ci]) ? bookChapters[ci] : null;
            if (ch) chapterTitle = String(ch.chapterTitle || ch.title || '').trim();
        } catch (e) { /* ignore */ }
        var pageNo = pageIdx + 1;
        var isRecto = (pageNo % 2) === 1;
        var text = isRecto ? (chapterTitle || bookTitle) : (bookTitle || chapterTitle);
        if (!text) {
            headEl.textContent = '';
            headEl.classList.add('is-empty');
            headEl.setAttribute('aria-hidden', 'true');
            return;
        }
        headEl.textContent = text.length > 52 ? text.substring(0, 49) + '\u2026' : text;
        headEl.classList.remove('is-empty');
        headEl.setAttribute('aria-hidden', 'false');
    }

    /** Usable inner height for one 6×9 page (content box — no scroll). */
    function ensureFmtStageVisibleForMeasure() {
        syncFmtPreviewLayout();
    }

    function getFmtContentAreaHeightPx() {
        ensureFmtStageVisibleForMeasure();
        var contentEl = document.getElementById('bookPageContentA');
        if (contentEl && contentEl.clientHeight >= 48) return contentEl.clientHeight;

        var wrap = contentEl ? contentEl.closest('.book-page-content-wrap') : null;
        var shell = document.getElementById('paginatedReaderShell');
        var shellH = shell ? (parseInt(shell.style.height || '0', 10) || shell.clientHeight) : 0;
        if (wrap && shellH >= 200) {
            var cs = window.getComputedStyle(wrap);
            var padY = (parseFloat(cs.paddingTop) || 0) + (parseFloat(cs.paddingBottom) || 0);
            var head = wrap.querySelector('.book-page-running-head');
            var foot = wrap.querySelector('.book-page-footer');
            var headH = head && !head.classList.contains('is-empty') ? head.offsetHeight : 0;
            var footH = foot ? foot.offsetHeight : 0;
            var inner = shellH - padY - headH - footH - 2;
            if (inner >= 48) return Math.floor(inner);
        }

        var viewport = document.getElementById('preview-content')
            || document.getElementById('preview-content-ebook')
            || document.getElementById('preview-content-paperback');
        var shell = document.getElementById('paginatedReaderShell')
            || document.getElementById('paginatedReaderShellEbook')
            || document.getElementById('paginatedReaderShellPaperback');
        if (viewport && viewport.clientHeight >= 48) {
            var vs = window.getComputedStyle(viewport);
            var padY = (parseFloat(vs.paddingTop) || 0) + (parseFloat(vs.paddingBottom) || 0);
            var blockPad = 0;
            var sample = viewport.querySelector('.reader-chapter-block, .book-preview-sheet');
            if (sample) {
                var bs = window.getComputedStyle(sample);
                blockPad = (parseFloat(bs.paddingTop) || 0) + (parseFloat(bs.paddingBottom) || 0);
            }
            var usable = Math.max(0, viewport.clientHeight - padY - blockPad - 8);
            if (usable >= 48) return usable;
        }
        if (shell && shell.clientHeight >= 80) {
            var padY2 = 20;
            var footerReserve = 34;
            return Math.max(160, shell.clientHeight - padY2 - footerReserve - 8);
        }
        var w = getFmtMeasureShellWidth();
        if (w >= 48) {
            var shellH = Math.floor(w * (9 / 6));
            return Math.max(160, Math.floor(shellH * 0.88) - 28);
        }
        return 520;
    }

    /** Match AI Book Writer `getReaderPageMaxHeight` — usable height inside one open-book face. */
    function getFmtReaderPageMaxHeight() {
        var shell = document.getElementById('paginatedReaderShell');
        var viewport = document.getElementById('preview-content')
            || document.getElementById('preview-content-ebook')
            || document.getElementById('preview-content-paperback');
        if (!viewport) return getFmtContentAreaHeightPx();
        var root = document.getElementById('book-formatter-root');
        var isSpread = (shell && shell.classList.contains('is-open-spread'))
            || (root && root.getAttribute('data-spread') === '1')
            || isFmtPrintSpread();

        // Preferred path for two-page spread: shell height minus running head + folio.
        if (isSpread && shell) {
            var shellH = parseInt(shell.style.height || '0', 10) || shell.clientHeight || 0;
            if (shellH >= 160) {
                var chromeY = getFmtReaderPageChromeY();
                var liveInner = viewport.querySelector('.book-open-page-inner');
                var padY = 0;
                if (liveInner) {
                    var is = window.getComputedStyle(liveInner);
                    padY = (parseFloat(is.paddingTop) || 0) + (parseFloat(is.paddingBottom) || 0);
                } else {
                    // Approximate face padding before first render (~0.9rem total).
                    var rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
                    padY = Math.ceil(0.9 * rem);
                }
                var usableFace = Math.floor(shellH - chromeY - padY - 6);
                if (usableFace >= 96) return usableFace;
            }
        }

        var vs = window.getComputedStyle(viewport);
        var padY2 = (parseFloat(vs.paddingTop) || 0) + (parseFloat(vs.paddingBottom) || 0);
        var blockPad = 0;
        var sample = viewport.querySelector('.reader-chapter-block, .book-preview-sheet, .book-open-page-inner');
        if (sample) {
            var bs = window.getComputedStyle(sample);
            blockPad = (parseFloat(bs.paddingTop) || 0) + (parseFloat(bs.paddingBottom) || 0);
        }
        var chromeY2 = isSpread ? getFmtReaderPageChromeY() : 0;
        if (isSpread) {
            var liveInner2 = viewport.querySelector('.book-open-page-inner');
            if (liveInner2) {
                var is2 = window.getComputedStyle(liveInner2);
                padY2 = (parseFloat(is2.paddingTop) || 0) + (parseFloat(is2.paddingBottom) || 0);
            }
        }
        var usable = Math.max(0, viewport.clientHeight - padY2 - blockPad - chromeY2 - 8);
        if (usable >= 32) return usable;
        if (!shell || shell.clientHeight < 48) return getFmtContentAreaHeightPx();
        return Math.max(120, shell.clientHeight - (isSpread ? getFmtReaderPageChromeY() : 40) - 8);
    }

    function getFmtPageMaxHeightPx() {
        var h = getFmtReaderPageMaxHeight();
        return h >= 32 ? h : getFmtContentAreaHeightPx();
    }

    function fmtCanMeasurePages() {
        return getFmtMeasureShellWidth() > 48 && getFmtPageMaxHeightPx() > 80;
    }

    function getFmtPaginatedShells() {
        return [
            document.getElementById('paginatedReaderShell'),
            document.getElementById('paginatedReaderShellEbook'),
            document.getElementById('paginatedReaderShellPaperback')
        ].filter(Boolean);
    }

    function getFmtMeasureInteriorClass() {
        var shell = document.getElementById('paginatedReaderShell');
        if (!shell) return 'paginated-reader-shell reader-content-wrap interior-novel';
        var interiorCls = 'interior-novel';
        shell.classList.forEach(function(c) {
            if (c.indexOf('interior-') === 0) interiorCls = c;
        });
        return 'paginated-reader-shell reader-content-wrap ' + interiorCls;
    }

    function syncFmtMeasureTypography(viewportEl) {
        if (!viewportEl) return;
        var vp = document.getElementById('preview-content');
        if (!vp) return;
        applyPreviewStyles(vp);
        var rs = window.getComputedStyle(vp);
        viewportEl.style.fontSize = vp.style.fontSize || rs.fontSize;
        viewportEl.style.lineHeight = vp.style.lineHeight || rs.lineHeight;
        viewportEl.style.textAlign = vp.style.textAlign || rs.textAlign;
        viewportEl.style.fontFamily = rs.fontFamily;
    }

    /** Measure block height using the same flat `#preview-content` viewport as AI Book Writer. */
    function renderFmtMeasureSandbox(blockInnerHtml) {
        var mh = document.getElementById('fmt-preview-measure-host');
        if (!mh) return null;
        var w = getFmtMeasureShellWidth();
        if (w < 48) return null;

        var viewport = document.getElementById('preview-content')
            || document.getElementById('preview-content-ebook')
            || document.getElementById('preview-content-paperback');
        var maxH = getFmtReaderPageMaxHeight();
        if (!maxH || maxH < 48) maxH = getFmtPageMaxHeightPx();
        if (!maxH || maxH < 48) return null;

        if (viewport) {
            var vpStyles = window.getComputedStyle(viewport);
            mh.style.width = w + 'px';
            mh.style.padding = vpStyles.padding;
            mh.style.fontSize = vpStyles.fontSize;
            mh.style.lineHeight = vpStyles.lineHeight;
            mh.style.boxSizing = 'border-box';
            var inner = blockInnerHtml || '';
            if (inner.indexOf('reader-chapter-block') < 0) {
                inner = '<div class="reader-chapter-block">' + inner + '</div>';
            }
            mh.innerHTML = inner;
            var block = mh.querySelector('.reader-chapter-block');
            if (!block) return null;
            applyPreviewStyles(block);
            syncFmtMeasureTypography(block);
            return block;
        }

        return null;
    }

    function measureFmtPageBlock(blockInnerHtml) {
        var contentEl = renderFmtMeasureSandbox(blockInnerHtml);
        return contentEl ? contentEl.scrollHeight : 999999;
    }

    function fmtPageContentFits(blockInnerHtml) {
        var contentEl = renderFmtMeasureSandbox(blockInnerHtml);
        if (!contentEl) return true;
        var maxH = getFmtReaderPageMaxHeight() || getFmtPageMaxHeightPx();
        if (!maxH || maxH < 24) return true;
        return contentEl.scrollHeight <= maxH + 1;
    }

    function measureFmtArticleInner(articleInnerHtml) {
        return measureFmtPageBlock('<div class="reader-chapter-block">' + articleInnerHtml + '</div>');
    }

    function stripEmbeddedPageFooters(pageHtml) {
        return String(pageHtml || '')
            .replace(/<footer[^>]*>[\s\S]*?<\/footer>/gi, '')
            .replace(/<div[^>]*class="[^"]*book-page-footer[^"]*"[^>]*>[\s\S]*?<\/div>/gi, '');
    }

    function splitOversizedFmtBodyHtml(bodyHtml, measureFn) {
        var mh = document.getElementById('fmt-preview-measure-host');
        if (!mh || !bodyHtml) return [bodyHtml || ''];
        var tmp = document.createElement('div');
        tmp.innerHTML = bodyHtml;
        var nodes = Array.prototype.slice.call(tmp.childNodes).filter(function(n) {
            return n.nodeType === 1 || (n.nodeType === 3 && (n.textContent || '').trim());
        });
        if (!nodes.length) return [bodyHtml];
        if (nodes.length === 1 && nodes[0].nodeType === 1) {
            var el = nodes[0];
            var text = (el.textContent || '').trim();
            var words = text.split(/\s+/).filter(Boolean);
            if (words.length > 1 && measureFn(bodyHtml) > getFmtPageMaxHeightPx()) {
                var tag = el.tagName ? el.tagName.toLowerCase() : 'p';
                var openTag = '<' + tag + (el.className ? ' class="' + el.className + '"' : '') + '>';
                var closeTag = '</' + tag + '>';
                var out = [];
                var start = 0;
                while (start < words.length) {
                    var lo = start + 1;
                    var hi = words.length;
                    var best = start;
                    while (lo <= hi) {
                        var mid = (lo + hi) >> 1;
                        var chunk = words.slice(start, mid).join(' ');
                        var trial = openTag + escapeHtml(chunk) + closeTag;
                        if (measureFn(trial) <= getFmtPageMaxHeightPx()) {
                            best = mid;
                            lo = mid + 1;
                        } else hi = mid - 1;
                    }
                    if (best <= start) best = start + 1;
                    out.push(openTag + escapeHtml(words.slice(start, best).join(' ')) + closeTag);
                    start = best;
                }
                return out.length ? out : [bodyHtml];
            }
        }
        var segments = [];
        nodes.forEach(function(n) {
            if (n.nodeType === 1) segments.push(n.outerHTML);
            else segments.push('<p>' + escapeHtml((n.textContent || '').trim()) + '</p>');
        });
        var pages = [];
        var acc = '';
        for (var i = 0; i < segments.length; i++) {
            var seg = segments[i];
            var combined = acc ? (acc + seg) : seg;
            if (measureFn(combined) > getFmtPageMaxHeightPx() && acc) {
                pages.push(acc);
                acc = seg;
                if (measureFn(acc) > getFmtPageMaxHeightPx()) {
                    var subs = splitOversizedFmtBodyHtml(seg, measureFn);
                    for (var s = 0; s < subs.length; s++) pages.push(subs[s]);
                    acc = '';
                }
            } else {
                acc = combined;
            }
        }
        if (acc) pages.push(acc);
        return pages.length ? pages : [bodyHtml];
    }

    function packFmtBodySegments(segments, measureFn) {
        if (!segments.length) return [''];
        var pages = [];
        var acc = '';
        for (var i = 0; i < segments.length; i++) {
            var seg = segments[i];
            if (!seg) continue;
            var combined = acc ? (acc + seg) : seg;
            if (measureFn(combined) > getFmtPageMaxHeightPx() && acc) {
                pages.push(acc);
                acc = seg;
                if (measureFn(acc) > getFmtPageMaxHeightPx()) {
                    var subs = splitOversizedFmtBodyHtml(seg, measureFn);
                    for (var s = 0; s < subs.length; s++) pages.push(subs[s]);
                    acc = '';
                }
            } else {
                acc = combined;
            }
        }
        if (acc) pages.push(acc);
        return pages.length ? pages : [''];
    }

    function getFmtPageFillRatio(bodyHtml, measureFn) {
        var maxH = getFmtPageMaxHeightPx();
        if (maxH <= 0) return 0;
        return Math.max(0, Math.min(1, measureFn(bodyHtml) / maxH));
    }

    function pullTrailingHeadingBlock(bodyHtml) {
        if (window.BookReaderPagination && typeof window.BookReaderPagination.pullTrailingHeadingFromInnerHtml === 'function') {
            return window.BookReaderPagination.pullTrailingHeadingFromInnerHtml(bodyHtml);
        }
        var html = String(bodyHtml || '').trim();
        if (!html) return null;
        var tmp = document.createElement('div');
        tmp.innerHTML = html;
        var children = Array.prototype.slice.call(tmp.children || []);
        if (!children.length) return null;
        var last = children[children.length - 1];
        if (!last || !/^h[1-6]$/i.test(last.tagName || '')) return null;
        if (children.length === 1) {
            return { bodyWithoutHeading: '', headingHtml: last.outerHTML };
        }
        if (children.length <= 1) return null;
        var moved = last.outerHTML;
        children.pop();
        var remain = children.map(function(n) { return n.outerHTML; }).join('');
        if (!remain.trim()) return null;
        return { bodyWithoutHeading: remain, headingHtml: moved };
    }

    function splitSegmentForRemainingSpace(segmentHtml, currentBodyHtml, measureFn) {
        var seg = String(segmentHtml || '').trim();
        if (!seg) return null;
        var tmp = document.createElement('div');
        tmp.innerHTML = seg;
        if (!tmp.firstElementChild || tmp.children.length !== 1) return null;
        var el = tmp.firstElementChild;
        var tag = (el.tagName || '').toLowerCase();
        if (!/^p$/.test(tag)) return null;
        var words = (el.textContent || '').split(/\s+/).filter(Boolean);
        if (words.length < 2) return null;

        var attrs = '';
        if (el.className) attrs += ' class="' + escapeHtml(el.className) + '"';
        var openTag = '<' + tag + attrs + '>';
        var closeTag = '</' + tag + '>';
        var base = String(currentBodyHtml || '');
        var lo = 1;
        var hi = words.length - 1;
        var best = 0;
        while (lo <= hi) {
            var mid = (lo + hi) >> 1;
            var candidate = openTag + escapeHtml(words.slice(0, mid).join(' ')) + closeTag;
            if (measureFn(base + candidate) <= getFmtPageMaxHeightPx()) {
                best = mid;
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        if (best <= 0) return null;
        var fit = openTag + escapeHtml(words.slice(0, best).join(' ')) + closeTag;
        var restWords = words.slice(best);
        var rest = restWords.length ? (openTag + escapeHtml(restWords.join(' ')) + closeTag) : '';
        return { fitHtml: fit, restHtml: rest };
    }

    function classicParaToBodySegment(para, dropCap) {
        var block = (para || '').trim();
        if (!block) return '';
        var looksLikeHtml = /<\s*(p|h1|h2|h3|h4|blockquote|ul|ol|li|br)\b/i.test(block);
        if (looksLikeHtml || chunkNeedsManuscriptRender(block)) {
            var html = formatChapterContent(block);
            if (dropCap) html = html.replace('<p class="manuscript-p">', '<p class="manuscript-p classic-first-para">').replace('<p>', '<p class="classic-first-para">');
            return html;
        }
        return '<p' + (dropCap ? ' class="classic-first-para"' : '') + '>' + escapeHtml(block).replace(/\n/g, '<br>') + '</p>';
    }

    function novelParaToBodySegment(para) {
        var block = (para || '').trim();
        if (!block) return '';
        return formatChapterContent(block);
    }

    function flattenToFlowSegments(htmlSegments) {
        var out = [];
        (htmlSegments || []).forEach(function(seg) {
            var s = String(seg || '').trim();
            if (!s) return;
            var tmp = document.createElement('div');
            tmp.innerHTML = s;
            if (!tmp.children.length) {
                out.push(s);
                return;
            }
            var elements = [];
            for (var i = 0; i < tmp.children.length; i++) {
                elements.push(tmp.children[i].outerHTML);
            }
            for (var j = 0; j < elements.length; j++) {
                var block = elements[j];
                var isHeading = /^<h[1-6]\b/i.test(String(block || '').trim());
                if (isHeading && j < elements.length - 1) {
                    out.push(block + elements[j + 1]);
                    j++;
                } else {
                    out.push(block);
                }
            }
        });
        return out;
    }

    function isFlowHeadingSegment(html) {
        var s = String(html || '').trim();
        if (!s) return false;
        if (/^<h[1-6]\b[^>]*>[\s\S]*<\/h[1-6]>$/i.test(s)) return true;
        var tmp = document.createElement('div');
        tmp.innerHTML = s;
        if (tmp.children.length === 1 && /^h[1-6]$/i.test(tmp.firstElementChild.tagName || '')) return true;
        return false;
    }

    function buildReaderPageBlockHtml(bodyHtml, opts) {
        opts = opts || {};
        var titleBlock = '';
        if (opts.includeTitle && !opts.hasBodyLeadingHeading) {
            titleBlock = opts.chapterHeadingHtml
                ? String(opts.chapterHeadingHtml)
                : ('<article class="reader-page-title">' + escapeHtml(opts.title || '') + '</article>');
        }
        var bodyClass = opts.isClassic ? 'reader-page-body classic-body' : 'reader-page-body';
        var chapterAttr = opts.chapterStart ? ' data-chapter-start="1"' : '';
        return '<div class="reader-chapter-block"' + chapterAttr + '>' + titleBlock +
            '<section class="' + bodyClass + '">' + bodyHtml + '</section></div>';
    }

    function splitFlowSegmentByWords(segHtml, opts, prefixBody) {
        var seg = String(segHtml || '').trim();
        if (!seg) return [];
        var tmp = document.createElement('div');
        tmp.innerHTML = seg;
        var el = tmp.firstElementChild;
        if (!el) return [seg];
        var tag = (el.tagName || 'p').toLowerCase();
        // #4: split text-bearing blocks (not just <p>) so long content flows to the next
        // page instead of being clipped. Skip blocks with media/nested lists/tables that
        // cannot be word-split safely.
        var hasComplexChild = el.querySelector && el.querySelector('img,table,ul,ol,figure,pre,svg,iframe,video');
        if (!/^(p|blockquote|div|li|figcaption)$/.test(tag) || hasComplexChild) return [seg];
        var words = (el.textContent || '').split(/\s+/).filter(Boolean);
        if (words.length < 2) return [seg];
        var cls = el.className ? (' class="' + escapeHtml(el.className) + '"') : '';
        var openTag = '<' + tag + cls + '>';
        var closeTag = '</' + tag + '>';
        var parts = [];
        var start = 0;
        var base = String(prefixBody || '');
        while (start < words.length) {
            var lo = start + 1;
            var hi = words.length;
            var best = start;
            while (lo <= hi) {
                var mid = (lo + hi) >> 1;
                var chunk = openTag + escapeHtml(words.slice(start, mid).join(' ')) + closeTag;
                var block = buildReaderPageBlockHtml(base + chunk, opts);
                if (fmtPageContentFits(block)) {
                    best = mid;
                    lo = mid + 1;
                } else {
                    hi = mid - 1;
                }
            }
            if (best <= start) best = start + 1;
            parts.push(openTag + escapeHtml(words.slice(start, best).join(' ')) + closeTag);
            start = best;
            base = '';
            opts = Object.assign({}, opts, { includeTitle: false, chapterStart: false });
        }
        return parts.length ? parts : [seg];
    }

    /** Greedy height-based pagination — packs flow segments until the page is full. */
    function paginateChapterFlow(rawSegments, opts) {
        opts = opts || {};
        var flat = flattenToFlowSegments(rawSegments);
        var pages = [];
        if (!flat.length) return pages;

        var acc = '';
        var includeTitle = true;
        var chapterStart = !!opts.chapterStart;

        function pageOpts() {
            return {
                includeTitle: includeTitle,
                hasBodyLeadingHeading: opts.hasBodyLeadingHeading,
                title: opts.title,
                chapterHeadingHtml: opts.chapterHeadingHtml,
                isClassic: opts.isClassic,
                chapterStart: chapterStart
            };
        }

        function pushPage(bodyHtml, po) {
            var pulled = pullTrailingHeadingBlock(bodyHtml);
            if (pulled) {
                pages.push(buildReaderPageBlockHtml(pulled.bodyWithoutHeading, po));
                includeTitle = false;
                chapterStart = false;
                return pulled.headingHtml;
            }
            pages.push(buildReaderPageBlockHtml(bodyHtml, po));
            includeTitle = false;
            chapterStart = false;
            return '';
        }

        for (var i = 0; i < flat.length; i++) {
            var seg = flat[i];
            var segIsHeading = isFlowHeadingSegment(seg);
            if (segIsHeading && i + 1 < flat.length && !isFlowHeadingSegment(flat[i + 1])) {
                seg = seg + flat[i + 1];
                i++;
            }
            // #2: a major subsection heading consistently starts at the top of a new page.
            // Flush whatever is already accumulated so the heading opens a fresh page.
            // (acc is empty right after a chapter opener, so this won't strand the title page.)
            if (segIsHeading && acc) {
                var headingOrphan = pushPage(acc, pageOpts());
                acc = headingOrphan || '';
            }
            var trial = acc ? (acc + seg) : seg;
            if (fmtPageContentFits(buildReaderPageBlockHtml(trial, pageOpts()))) {
                acc = trial;
                continue;
            }
            if (acc) {
                var orphanHeading = pushPage(acc, pageOpts());
                acc = orphanHeading || '';
                if (orphanHeading) {
                    if (fmtPageContentFits(buildReaderPageBlockHtml(orphanHeading + seg, pageOpts()))) {
                        acc = orphanHeading + seg;
                    } else {
                        acc = orphanHeading;
                        i--;
                    }
                } else {
                    i--;
                }
                continue;
            }
            var wordParts = splitFlowSegmentByWords(seg, pageOpts(), '');
            for (var wi = 0; wi < wordParts.length; wi++) {
                var part = wordParts[wi];
                var po = pageOpts();
                if (fmtPageContentFits(buildReaderPageBlockHtml(part, po))) {
                    pushPage(part, po);
                } else {
                    pushPage(part, po);
                }
            }
        }
        if (acc) {
            var trailingOrphan = pushPage(acc, pageOpts());
            if (trailingOrphan) pushPage(trailingOrphan, pageOpts());
        }
        return pages;
    }

    function finalizeReaderPages(pages, chapterIdxs) {
        if (!pages.length) return { pages: pages, chapterIdxs: chapterIdxs };
        pages = stripTrailingHeadingsFromReaderPages(pages);
        var merged = mergeUnderfilledReaderPages(pages, chapterIdxs);
        merged = pullOrphansToFillPages(merged.pages, merged.chapterIdxs);
        return merged;
    }

    function stripTrailingHeadingsFromReaderPages(pages) {
        if (!Array.isArray(pages) || pages.length < 2) return pages;
        var out = pages.slice();
        for (var i = 0; i < out.length - 1; i++) {
            var bodyMatch = out[i].match(/(<section class="reader-page-body[^"]*">)([\s\S]*?)(<\/section>)/);
            if (!bodyMatch) continue;
            var pulled = pullTrailingHeadingBlock(bodyMatch[2]);
            if (!pulled) continue;
            out[i] = out[i].replace(bodyMatch[0], bodyMatch[1] + pulled.bodyWithoutHeading + bodyMatch[3]);
            var nextBody = out[i + 1].match(/(<section class="reader-page-body[^"]*">)([\s\S]*?)(<\/section>)/);
            if (nextBody) {
                out[i + 1] = out[i + 1].replace(nextBody[0], nextBody[1] + pulled.headingHtml + nextBody[2] + nextBody[3]);
            }
        }
        return out;
    }

    function pullOrphansToFillPages(pages, chapterIdxs) {
        if (!Array.isArray(pages) || pages.length < 2 || !fmtCanMeasurePages()) {
            return { pages: pages, chapterIdxs: chapterIdxs };
        }
        var maxH = getFmtPageMaxHeightPx();
        var outP = pages.slice();
        var outC = chapterIdxs.slice();

        for (var pass = 0; pass < 4; pass++) {
            var moved = false;
            for (var i = 0; i < outP.length - 1; i++) {
                if (outC[i] !== outC[i + 1]) continue;
                if (outP[i + 1].indexOf('data-chapter-start') >= 0) continue;
                var h = measureFmtPageBlock(stripEmbeddedPageFooters(outP[i]));
                if (h / maxH >= 0.72) continue;

                var nextBody = outP[i + 1].match(/(<section class="reader-page-body[^"]*">)([\s\S]*?)(<\/section>)/);
                if (!nextBody || !nextBody[2].trim()) continue;
                var firstBlockMatch = nextBody[2].match(/^(\s*<(?:p|h[1-6]|li|blockquote)[^>]*>[\s\S]*?<\/(?:p|h[1-6]|li|blockquote)>)/i);
                if (!firstBlockMatch) continue;
                var block = firstBlockMatch[1];
                if (wordCountInHtml(block) > 12) continue;

                var curBody = outP[i].match(/(<section class="reader-page-body[^"]*">)([\s\S]*?)(<\/section>)/);
                if (!curBody) continue;
                var mergedBody = curBody[2] + block;
                var mergedPage = outP[i].replace(curBody[0], curBody[1] + mergedBody + curBody[3]);
                if (!fmtPageContentFits(stripEmbeddedPageFooters(mergedPage))) continue;

                outP[i] = mergedPage;
                var remain = nextBody[2].slice(block.length).trim();
                if (!remain && outP[i + 1].indexOf('reader-page-title') < 0) {
                    outP.splice(i + 1, 1);
                    outC.splice(i + 1, 1);
                } else {
                    outP[i + 1] = outP[i + 1].replace(nextBody[0], nextBody[1] + remain + nextBody[3]);
                }
                moved = true;
            }
            if (!moved) break;
        }

        var filtered = [];
        var filteredC = [];
        for (var j = 0; j < outP.length; j++) {
            var bm = outP[j].match(/<section class="reader-page-body[^"]*">([\s\S]*?)<\/section>/);
            if (bm && !stripHtmlTags(bm[1]).length && outP[j].indexOf('reader-page-title') < 0) continue;
            filtered.push(outP[j]);
            filteredC.push(outC[j]);
        }
        return { pages: filtered.length ? filtered : outP, chapterIdxs: filtered.length ? filteredC : outC };
    }

    function estimateBodyLeadLines(bodyHtml) {
        var html = String(bodyHtml || '');
        if (!html) return 0;
        var paraCount = (html.match(/<(p|li)\b/gi) || []).length;
        if (paraCount > 0) return paraCount;
        var text = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
        if (!text) return 0;
        var sentenceCount = text.split(/[.!?]+/).map(function(s) { return s.trim(); }).filter(Boolean).length;
        if (sentenceCount > 0) return sentenceCount;
        return Math.max(1, Math.ceil(text.split(/\s+/).filter(Boolean).length / 14));
    }

    function formatBookPageNumber(pageNum) {
        var n = parseInt(String(pageNum || '0'), 10);
        if (!Number.isFinite(n) || n <= 0) n = 1;
