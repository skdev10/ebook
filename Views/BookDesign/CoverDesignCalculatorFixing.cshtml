                        }

                        var firstLine = firstMeaningfulLine(extractedPages[0]);
                        var fromFile = String((images[0] && images[0].name) || '').replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' ').trim();
                        var bookTitle = firstLine || fromFile || (extractedPages.length > 1 ? ('Scanned book (' + extractedPages.length + ' pages)') : 'Scanned book');
                        if (bookTitle.length > 80) bookTitle = bookTitle.slice(0, 77).trim() + '…';
                        var chapterTitle = extractedPages.length > 1 ? 'Chapter 1' : (firstLine || 'Chapter 1');
                        if (chapterTitle.length > 120) chapterTitle = chapterTitle.slice(0, 117).trim() + '…';
                        var content = extractedPages.map(function (text, index) {
                            return extractedPages.length > 1
                                ? ('Page ' + (index + 1) + '\n\n' + text)
                                : text;
                        }).join('\n\n');

                        setMsStatus('Creating book and filling fields…', true);
                        var newBid = await createBookForScannedImages(bookTitle);
                        if (!newBid) throw new Error('Book was not created.');
                        adoptCreatedBook(newBid, bookTitle);

                        bookChapters = [{
                            chapterNo: 1,
                            chapterTitle: chapterTitle,
                            content: content
                        }];
                        try { window.__fmtBookChapters = bookChapters; window.__fmtPreviewContext = bookPreviewContext; } catch (e0) {}
                        currentChapterIdx = 0;
                        currentPageIdx = 0;
                        readerPages = [];
                        readerPageChapterIdx = [];
                        ensureReaderPages(true);
                        populateChapterJump();
                        renderPreviewContent(0);
                        syncFormatterPageCountUi();

                        if (userId > 0) {
                            var saveResponse = await fetch('/Books/SaveChapterContent', {
                                method: 'POST',
                                credentials: 'same-origin',
                                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                                body: JSON.stringify({
                                    userId: String(userId),
                                    bookId: String(newBid),
                                    chapter: '1',
                                    chapterTitle: chapterTitle,
                                    newContent: content,
                                    topic: 'Imported from scanned book page images',
                                    bookTitle: bookTitle,
                                    recordVersion: true
                                })
                            });
                            var saveResult = await saveResponse.json().catch(function () { return null; });
                            if (!saveResponse.ok || !saveResult || !saveResult.success) {
                                setMsStatus('Text is in preview, but could not be saved.', false);
                                return;
                            }
                            try {
                                if (typeof formatterBookPayloadKey === 'function') {
                                    sessionStorage.removeItem(formatterBookPayloadKey(newBid));
                                }
                            } catch (cacheError) { /* optional */ }
                        }

                        var message = extractedPages.length + ' of ' + images.length + ' image(s) imported · title/chapter filled';
                        if (failed) message += ' · ' + failed + ' skipped';
                        setMsStatus(message + '.', true);
                        if (typeof showToast === 'function') showToast('Images imported — fields filled');
                        if (lastEl) lastEl.textContent = 'Imported from ' + extractedPages.length + ' scanned page image(s)';
                    } catch (err) {
                        console.error('Formatting OCR import failed', err);
                        setMsStatus((err && err.message) || 'Could not import images.', false);
                    } finally {
                        uploadBtn.disabled = false;
                        syncFmtImageUploadAvailability();
                    }
                });

                syncFmtImageUploadAvailability();
            }
        })();

        var platformsStr = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.PublishingPlatforms ?? string.Empty));
