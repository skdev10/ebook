    /** Force shell dimensions when flex host height is not yet measurable. */
    function applyFmtPreviewShellFallback(shell, scrollHost) {
        if (!shell || !scrollHost) return false;
        var remPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        var maxShellH = Math.max(560, Math.floor(window.innerHeight - 3.25 * remPx));
        var pane = scrollHost.closest('.fmt-preview-pane');
        var availW = scrollHost.clientWidth || (pane ? pane.clientWidth : 0);
        if (availW < 48) availW = Math.floor(window.innerWidth * 0.8);
        var availH = scrollHost.clientHeight;
        if (availH < 120) {
            availH = Math.min(maxShellH, Math.max(640, Math.floor(window.innerHeight * 0.9)));
            scrollHost.style.minHeight = availH + 'px';
        }
        availH = Math.min(availH, maxShellH);
        var ratio = isFmtPrintSpread() ? (12 / 9) : (6 / 9);
        var shellH = Math.floor(availH);
        var shellW = Math.floor(shellH * ratio);
        if (shellW > availW) {
            shellW = Math.floor(availW);
            shellH = Math.floor(shellW / ratio);
        }
        shellW = Math.max(280, shellW);
        shellH = Math.max(420, shellH);
        shell.style.width = shellW + 'px';
        shell.style.height = shellH + 'px';
        shell.style.maxWidth = '100%';
        shell.style.maxHeight = shellH + 'px';
        shell.style.flexShrink = '0';
        shell.style.aspectRatio = String(ratio);
        shell.dataset.layoutKey = shellW + 'x' + shellH;
        var mh = document.getElementById('fmt-preview-measure-host');
        if (mh) mh.style.width = shellW + 'px';
        return true;
    }

    /** Fit the 6×9 preview shell to the studio column (matches AI Writer layout sync). */
    function isFmtPrintSpread() {
        var fmtEl = document.getElementById('format-select');
        var fmt = ((fmtEl && fmtEl.value) || (window.formatFromUrl) || '').toString().trim().toLowerCase();
        if (!fmt) {
            var root = document.getElementById('book-formatter-root');
            fmt = ((root && root.getAttribute('data-format')) || '').toLowerCase();
        }
        // Ebook = single reflowable page. Everything else (default Paperback) = open two-page book.
        if (fmt === 'ebook') return false;
        return true;
    }

    /** Amazon KDP paperback bleed = 0.125" — show guide on Paperback / Both (not ebook / hardcover wrap). */
    function isFmtBleedFormat() {
        var fmtEl = document.getElementById('format-select');
        var fmt = ((fmtEl && fmtEl.value) || (window.formatFromUrl) || '').toString().trim().toLowerCase();
        if (!fmt) {
            var root = document.getElementById('book-formatter-root');
            fmt = ((root && root.getAttribute('data-format')) || '').toLowerCase();
        }
        return fmt === 'paperback' || fmt === 'print' || fmt === 'both';
    }

    function getFmtSpreadLeftIndex(idx) {
        var i = Math.max(0, idx | 0);
        return (i % 2 === 0) ? i : (i - 1);
    }

    function syncFmtPreviewLayout() {
        var scrollHost = document.getElementById('fmt-preview-scroll-host');
        var shell = document.getElementById('paginatedReaderShell');
        var viewport = document.getElementById('preview-content');
        var root = document.getElementById('book-formatter-root');
        if (!scrollHost || !shell) return false;

        // Size against the page panel; footer pills sit below and stay visible.
        var sizeHost = document.getElementById('preview-single') || scrollHost;

        var remPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        // Large 6×9 paper (or 12×9 open spread): use almost the full viewport height.
        var maxShellH = Math.max(560, Math.floor(window.innerHeight - 3.25 * remPx));
        var isDesktop = window.innerWidth >= 1024;
        var spread = isFmtPrintSpread();
        var changed = false;
        if (root) root.setAttribute('data-spread', spread ? '1' : '0');

        if (window.BookInteriorPreview && typeof window.BookInteriorPreview.syncPreviewLayout === 'function') {
            var chrome = document.getElementById('reader-chrome-main');
            var chromeReserve = 0;
            if (chrome && !chrome.classList.contains('hidden')) chromeReserve = chrome.offsetHeight + 8;
            changed = window.BookInteriorPreview.syncPreviewLayout({
                host: sizeHost,
                shell: shell,
                measureHost: document.getElementById('fmt-preview-measure-host'),
                viewport: viewport,
                minHostHeightPx: isDesktop
                    ? Math.max(640, Math.floor(window.innerHeight * 0.9))
                    : Math.max(400, Math.floor(window.innerHeight * 0.62)),
                preferHeight: isDesktop,
                maxHeightPx: isDesktop ? maxShellH : 0,
                // Single leaf = 6×9; open book = two leaves side-by-side (~12×9).
                aspectRatio: spread ? (12 / 9) : (6 / 9),
                widthFactor: 1,
                syncMeasureTypography: true,
                chromeReservePx: chromeReserve,
                onLayoutChange: function (c) {
                    if (c && bookChapters.length) {
                        requestAnimationFrame(function() {
                            fmtScheduleRepaginate();
                        });
                    }
                }
            });
        } else {
            changed = applyFmtPreviewShellFallback(shell, sizeHost);
        }
        syncFormatterChromeWidth();
        return changed;
    }

    /** Align optional reader chrome with the book preview card width. */
    function syncFormatterChromeWidth() {
        var shell = document.getElementById('paginatedReaderShell');
        var shellW = shell ? parseInt(shell.style.width || '0', 10) : 0;
        var bar = document.getElementById('reader-chrome-main');
        if (!bar) return;
        if (bar.classList.contains('hidden')) {
            bar.style.width = '';
            bar.style.maxWidth = '';
            bar.style.marginLeft = '';
            bar.style.marginRight = '';
            return;
        }
        if (shellW > 0) {
            bar.style.width = shellW + 'px';
            bar.style.maxWidth = '100%';
            bar.style.marginLeft = 'auto';
            bar.style.marginRight = 'auto';
        } else {
            bar.style.width = '100%';
            bar.style.maxWidth = '100%';
            bar.style.marginLeft = 'auto';
            bar.style.marginRight = 'auto';
        }
    }

