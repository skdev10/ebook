        box-shadow: 0 12px 28px -20px rgba(124, 58, 237, 0.35);
        transition: box-shadow 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }
    .config-card:hover {
        border-color: #ddd6fe;
        box-shadow: var(--fmt-card-shadow);
    }

    /* ----- Reader: default block (config column / elsewhere). Live preview uses fixed shell below — no vh-based min-height (avoids resize/flicker). ----- */
    .reader-content-wrap {
        min-height: min(88vh, 1180px);
        height: auto;
        max-height: none;
        overflow: auto;
        display: flex;
        flex-direction: column;
        padding: 1.25rem 1.5rem 3.25rem 1.5rem;
        transition: background 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
        border: 1px solid #f3e8ff;
