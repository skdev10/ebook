        text-align: center;
    }

    /* ---------- PRINT REALISM: surface, shadow, mirrored gutter ---------- */
    /* Brown desk mat is owned by .book-preview-stage below — theme classes
       only tint page chrome, not the desk surface behind the open book. */
    #book-formatter-root #fmt-preview-scroll-host {
        transition: background 0.45s ease;
    }
    /* Soft drop shadow under the page sheet — "book on a surface". */
    #book-formatter-root #bookContainer,
    #book-formatter-root #fmt-preview-scroll-host .book-preview-sheet {
        box-shadow:
            0 1px 0 rgba(255, 255, 255, 0.6) inset,
            0 22px 48px -20px rgba(28, 22, 16, 0.5),
            0 6px 16px -8px rgba(28, 22, 16, 0.32) !important;
    }
    /* Mirrored inside/outside (gutter) margins: verso pages swap left/right padding.
       Total horizontal padding is unchanged, so the text block width and page count stay stable.
       High specificity + !important to win over the token padding shorthand. */
    #book-formatter-root #paginatedReaderShell.reader-content-wrap .book-page-content-wrap[data-page-parity="even"] {
        padding-left: var(--ilt-pad-right, 2rem) !important;
        padding-right: var(--ilt-pad-left, 2rem) !important;
    }
    /* Minimalist folio sits on the OUTER edge (recto right / verso left). */
    #book-formatter-root .reader-content-wrap.interior-minimalist .book-page-footer[data-page-parity="even"] { text-align: left; }
    #book-formatter-root .reader-content-wrap.interior-minimalist .book-page-footer[data-page-parity="odd"] { text-align: right; }

    .reader-nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 0.5rem 0.5rem;
        border-top: 1px solid #e5e7eb;
        margin-top: auto;
        flex-shrink: 0;
