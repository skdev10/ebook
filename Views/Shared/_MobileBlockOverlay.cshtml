@using Microsoft.Extensions.Options
@inject IOptions<EBookDashboard.Models.MobileAccessOptions> MobileAccessOptions
@{
    var mobileAccess = MobileAccessOptions.Value;
}
@if (mobileAccess.BlockMobile)
{
    <div id="mobile-block-config"
         hidden
         data-max-width="@mobileAccess.ClientOverlayMaxWidthPx"
         data-title="@mobileAccess.Title"
         data-message="@mobileAccess.Message"
         data-submessage="@mobileAccess.SubMessage"></div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="~/css/mobile-block.css" asp-append-version="true" />
    <script src="~/js/mobile-block.js" asp-append-version="true"></script>
}
