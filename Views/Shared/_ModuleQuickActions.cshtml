@{
    // Shared header toolbar — Writer / Formatting / Cover: Export PDF + EPUB only.
    var qaBookId = 0;
    if (ViewBag.FlowBookId is int fb) qaBookId = fb;
    else if (ViewBag.SelectedBookId is int sb) qaBookId = sb;
    else if (ViewBag.BookId is int bb) qaBookId = bb;
    else if (ViewBag.SelectedBookId != null) int.TryParse(ViewBag.SelectedBookId.ToString(), out qaBookId);
    else if (ViewBag.BookId != null) int.TryParse(ViewBag.BookId.ToString(), out qaBookId);
    var action = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var isModulePage = action is "AIGenerateBook" or "Writer" or "CoverDesignCalculatorFixing" or "Formatting" or "CoverDesign"
        || (controller == "Dashboard" && action == "CoverDesign")
        || (controller == "Books" && action == "Cover");
    if (!isModulePage) { return; }
}
<div id="module-quick-actions" class="module-quick-actions" data-book-id="@qaBookId" role="region" aria-label="Export">
    <button type="button" class="mqa-btn mqa-btn--book" id="layout-export-book-pdf" data-book-export="PrintPdf" title="Download print-ready PDF">
        <i class="fas fa-file-pdf" aria-hidden="true"></i>
        <span>Export PDF</span>
    </button>
    <button type="button" class="mqa-btn mqa-btn--book mqa-btn--primary" id="layout-export-book-epub" data-book-export="Epub" title="Download EPUB">
        <i class="fas fa-tablet-alt" aria-hidden="true"></i>
        <span>Export EPUB</span>
    </button>
    <span id="layout-ms-status" class="mqa-status" aria-live="polite"></span>
</div>
<style>
/* Sticky top-right export dock — high contrast so it never “disappears” into the page */
.module-quick-actions {
    position: sticky;
    top: 0.65rem;
    z-index: 60;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem 0.45rem;
    margin: 0 0 0.85rem auto;
    margin-left: auto;
    max-width: fit-content;
    padding: 0.45rem 0.55rem;
    border-radius: 999px;
    background: #1e1b4b;
    border: 1px solid #312e81;
    box-shadow:
        0 10px 28px -12px rgba(30, 27, 75, 0.65),
        0 0 0 1px rgba(255, 255, 255, 0.06) inset;
}
.mqa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.08);
    color: #ede9fe;
    font-size: 0.75rem;
    font-weight: 650;
    padding: 0.4rem 0.72rem;
    cursor: pointer;
    transition: background .15s, border-color .15s, color .15s, transform .12s;
    white-space: nowrap;
}
.mqa-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(196, 181, 253, 0.55);
    color: #fff;
    transform: translateY(-1px);
}
.mqa-btn:disabled { opacity: .45; cursor: not-allowed; }
.mqa-btn--book {
    background: #5b21b6;
    border-color: #8b5cf6;
    color: #fff;
}
.mqa-btn--book:hover:not(:disabled) {
    background: #6d28d9;
}
.mqa-btn--primary {
    background: #7c3aed;
    border-color: #a78bfa;
}
.mqa-btn--primary:hover:not(:disabled) {
    background: #8b5cf6;
}
.mqa-status {
    font-size: 0.72rem;
    color: #c4b5fd;
    min-height: 1em;
    max-width: 11rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
@@media (max-width: 900px) {
    .module-quick-actions {
        max-width: 100%;
        justify-content: flex-start;
        border-radius: 14px;
        position: sticky;
        top: 0.35rem;
    }
    .mqa-btn span { display: none; }
    .mqa-btn { padding: 0.48rem 0.62rem; }
    .mqa-status { display: none; }
}
</style>
<script src="~/js/module-export.js" asp-append-version="true"></script>
<script>
(function () {
    var root = document.getElementById('module-quick-actions');
    if (!root || root.dataset.wired === '1') return;
    root.dataset.wired = '1';
    var statusEl = document.getElementById('layout-ms-status');
    var exportBtns = root.querySelectorAll('[data-book-export]');

    function currentBookId() {
        var fromRoot = parseInt(root.getAttribute('data-book-id') || '0', 10) || 0;
        if (fromRoot > 0) return fromRoot;
        var hid = document.getElementById('BookId') || document.getElementById('selected-book-id');
        if (hid) {
            var v = parseInt(hid.value || '0', 10) || 0;
            if (v > 0) return v;
        }
        try {
            var q = new URLSearchParams(window.location.search).get('bookId');
            if (q) return parseInt(q, 10) || 0;
        } catch (e) { /* ignore */ }
        var m = /\/(?:Formatting|CoverDesignCalculatorFixing|Writer|AIGenerateBook|CoverDesign)\/?(\d+)?/i.exec(window.location.pathname);
        return m && m[1] ? (parseInt(m[1], 10) || 0) : 0;
    }

    function setStatus(msg, ok) {
        if (!statusEl) return;
        statusEl.textContent = msg || '';
        statusEl.style.color = ok === false ? '#fda4af' : (ok === true ? '#86efac' : '#c4b5fd');
    }

    function syncExportEnabled() {
        var bid = currentBookId();
        root.setAttribute('data-book-id', String(bid));
        exportBtns.forEach(function (b) { b.disabled = false; });
    }

    async function runExport(btn) {
        var bid = currentBookId();
        if (bid <= 0) {
            setStatus('Open or create a book first — Export stays available.', false);
            return;
        }
        var bookFmt = btn.getAttribute('data-book-export');
        setStatus('Preparing download…', null);
        try {
            if (window.ModuleExport && typeof window.ModuleExport.run === 'function') {
                await window.ModuleExport.run({
                    bookId: bid,
                    bookExport: bookFmt,
                    draftFormat: null,
                    status: setStatus
                });
            } else {
                setStatus('Export module not loaded. Refresh the page.', false);
            }
        } catch (e) {
            setStatus('Export failed. Try again.', false);
        }
    }

    exportBtns.forEach(function (btn) {
        btn.addEventListener('click', function () { runExport(btn); });
    });
    syncExportEnabled();
    setInterval(syncExportEnabled, 2000);
})();
</script>
