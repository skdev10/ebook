@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Microsoft.AspNetCore.Http
@using EBookDashboard.Services
@inject EBookDashboard.Models.ApplicationDbContext DbContext
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
    var sidebarProfilePicturePath = "";
    var sidebarUserName = User.Identity?.Name ?? "Reader";
    var sidebarUserRole = "Reader";
    
    if (!string.IsNullOrEmpty(userEmail))
    {
        try
        {
            var user = DbContext.Users
                .AsNoTracking()
                .Where(u => u.UserEmail == userEmail)
                .Select(u => new
                {
                    u.ProfilePicturePath,
                    u.FullName,
                    RoleName = u.Role != null ? u.Role.RoleName : "Reader"
                })
                .FirstOrDefault();
            
            if (user != null)
            {  
                sidebarProfilePicturePath = user.ProfilePicturePath ?? "";
                sidebarUserName = user.FullName;
                sidebarUserRole = user.RoleName ?? "Reader";
            }
        }
        catch
        {
            // If database error, use defaults
        }
    }
    bool hasGeneratedBook = false;
    bool hasAnyBooks = false;
    bool formattingDone = false;
    bool coverFinalized = false;
    int? resolvedUserId = null;
    try
    {
        var session = HttpContextAccessor.HttpContext?.Session;
        var idClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(idClaim, out var claimUserId) && claimUserId > 0)
            resolvedUserId = claimUserId;
        else if (session != null)
            resolvedUserId = session.GetInt32("UserId");

        if (session != null && resolvedUserId.HasValue)
        {
            try
            {
                var sessionUserId = session.GetInt32("UserId");
                if (!sessionUserId.HasValue || sessionUserId.Value != resolvedUserId.Value)
                    session.SetInt32("UserId", resolvedUserId.Value);
            }
            catch { }

            if (session.GetString("HasGeneratedBook") == "1")
            {
                hasGeneratedBook = true;
                hasAnyBooks = true;
            }
            else
            {
                hasAnyBooks = DbContext.Books.AsNoTracking().Any(b => b.UserId == resolvedUserId.Value);
                if (hasAnyBooks)
                {
                    session.SetString("HasGeneratedBook", "1");
                    hasGeneratedBook = true;
                }
            }
            formattingDone = session.GetString("FormattingDone") == "1";
            coverFinalized = session.GetString("CoverFinalized") == "1";
        }
    }
    catch { }
    hasGeneratedBook = hasGeneratedBook || hasAnyBooks;
    // Soft modules: Writer / Formatting / Cover always reachable from sidebar.
    bool formattingUnlocked = true;
    bool coverUnlocked = true;
    bool publishUnlocked = true; // Never gate Publish / My Books on AI writing or step order.

    int flowBookId = 0;
    string flowStep = "";
    string flowBackUrl = "";
    if (ViewBag.FlowBookId is int flowBid) { flowBookId = flowBid; }
    else if (ViewBag.FlowBookId != null) { int.TryParse(ViewBag.FlowBookId.ToString(), out flowBookId); }
    if (ViewBag.FlowStep is string flowStepRaw) flowStep = flowStepRaw;
    if (ViewBag.FlowBackUrl is string flowBackRaw) flowBackUrl = flowBackRaw;
    // Soft modules: Writer / Formatting / Cover stay in the sidebar (no forced funnel).
    // First-run (no books): still show the three tools; Publish / My Books stay quieter until a book exists.
    bool flowSidebarMinimal = !hasAnyBooks;

    int sidebarActiveBookId = flowBookId;
    if (sidebarActiveBookId <= 0 && ViewBag.SelectedBookId != null)
        int.TryParse(ViewBag.SelectedBookId.ToString(), out sidebarActiveBookId);
    if (sidebarActiveBookId <= 0 && ViewBag.BookId != null)
        int.TryParse(ViewBag.BookId.ToString(), out sidebarActiveBookId);
    // Soft modules: never pull LastSelectedBookId into the sidebar.
    // Book attaches only via explicit URL (Dashboard Continue Editing) or in-page create.
    var sidebarFlowEntryUrl = "/Dashboard";
    var sidebarAiWriterUrl = "/Books/Writer?entry=direct";
    var sidebarFormatUrl = "/BookDesign/CoverDesignCalculatorFixing?bookId=0";
    var sidebarCoverUrl = "/Books/Cover";
    var sidebarPublishUrl = sidebarFlowEntryUrl;
    var bookFlowNav = new BookFlowStateService(DbContext);
    if (sidebarActiveBookId > 0)
    {
        try
        {
            var flowStepKey = $"book:{sidebarActiveBookId}:flowStep";
            var flowPathKey = $"book:{sidebarActiveBookId}:flowPath";
            var flowMaxKey = $"book:{sidebarActiveBookId}:flowMaxStep";
            var flowRows = DbContext.Settings.AsNoTracking()
                .Where(s => s.Key == flowStepKey || s.Key == flowPathKey || s.Key == flowMaxKey)
                .ToDictionary(s => s.Key, s => s.Value ?? "");
            var activeStep = flowRows.GetValueOrDefault(flowStepKey, "").Trim();
            if (string.IsNullOrEmpty(activeStep)) activeStep = BookFlowStateService.StepGenerate;
            var activeMaxStep = flowRows.GetValueOrDefault(flowMaxKey, "").Trim();
            var resumeStep = BookFlowStateService.StepRank(activeMaxStep) > BookFlowStateService.StepRank(activeStep)
                ? activeMaxStep : activeStep;
            var activePath = flowRows.GetValueOrDefault(flowPathKey, "").Trim();
            if (string.IsNullOrEmpty(activePath)) activePath = "ebook";
            var selectBookEntry = $"/Dashboard/SelectBook?bookId={sidebarActiveBookId}";
            sidebarAiWriterUrl = $"/Books/Writer?bookId={sidebarActiveBookId}&entry=direct";
            sidebarFormatUrl = $"/BookDesign/CoverDesignCalculatorFixing?bookId={sidebarActiveBookId}";
            sidebarCoverUrl = $"/Books/Cover/{sidebarActiveBookId}";
            sidebarPublishUrl = selectBookEntry;
            if (BookFlowStateService.IsStepAtLeast(resumeStep, BookFlowStateService.StepPublish))
            {
                sidebarPublishUrl = activePath.Equals("print", StringComparison.OrdinalIgnoreCase)
                    ? $"/Dashboard/Publish?bookId={sidebarActiveBookId}&flow=printready"
                    : $"/Dashboard/Publish?bookId={sidebarActiveBookId}";
            }
        }
        catch { }
    }

    // Cover / Formatting: soft entry without a book is allowed (empty studio).
    bool coverNavUnlocked = true;
    if (sidebarActiveBookId <= 0)
    {
        sidebarCoverUrl = "/Books/Cover";
        sidebarFormatUrl = "/BookDesign/CoverDesignCalculatorFixing?bookId=0";
        sidebarAiWriterUrl = "/Books/Writer?entry=direct";
    }
    else
    {
        // Book is open on this page — Publish / My Books must not show the "select a book" lock.
        hasGeneratedBook = true;
        publishUnlocked = true;
        if (string.IsNullOrWhiteSpace(sidebarPublishUrl) || sidebarPublishUrl == "/Dashboard")
            sidebarPublishUrl = $"/Dashboard/Publish?bookId={sidebarActiveBookId}";
    }

    // Direct module entry (sidebar) must not carry the Writerâ†’Publish "Next/Continue" guided flow.
    string WithDirectEntry(string url)
    {
        if (string.IsNullOrWhiteSpace(url) || url == "#" || url.StartsWith("/Dashboard/SelectBook", StringComparison.OrdinalIgnoreCase))
            return url;
        if (url.Equals("/Dashboard", StringComparison.OrdinalIgnoreCase) || url.StartsWith("/Dashboard?", StringComparison.OrdinalIgnoreCase))
            return url;
        if (url.Contains("entry=direct", StringComparison.OrdinalIgnoreCase))
            return url;
        return url + (url.Contains('?') ? "&" : "?") + "entry=direct";
    }
    sidebarFormatUrl = WithDirectEntry(sidebarFormatUrl);
    sidebarCoverUrl = WithDirectEntry(sidebarCoverUrl);
    if (!string.IsNullOrWhiteSpace(sidebarPublishUrl)
        && sidebarPublishUrl.Contains("/Publish", StringComparison.OrdinalIgnoreCase))
    {
        sidebarPublishUrl = WithDirectEntry(sidebarPublishUrl);
    }

    // Dashboard home: sidebar stays fully open. Other screens use the hover-collapse rail.
    var sidebarRouteController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var sidebarRouteAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    bool sidebarPinnedOpen = string.Equals(sidebarRouteController, "Dashboard", StringComparison.OrdinalIgnoreCase)
        && (string.IsNullOrEmpty(sidebarRouteAction) || string.Equals(sidebarRouteAction, "Index", StringComparison.OrdinalIgnoreCase));
}

