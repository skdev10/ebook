            if (menuToggle) {
                menuToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    toggleSidebar();
                });
            }

            const sbBackdrop = document.getElementById('sidebarBackdrop');
            if (sbBackdrop) {
                sbBackdrop.addEventListener('click', function () {
                    const sidebar = document.getElementById('sidebar');
                    if (sidebar && sidebar.classList.contains('active')) toggleSidebar();
                });
            }

            if (viewPlansBtn) {
                viewPlansBtn.addEventListener('click', () => openModal(viewPlansModal));
            }

            if (scheduleCallBtn) {
                scheduleCallBtn.addEventListener('click', () => {
                    alert('Call scheduling feature would open here. In a real application, this would show a calendar interface.');
                });
