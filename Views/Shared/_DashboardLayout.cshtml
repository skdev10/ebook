        // Logout: use currentTarget (the <a>) — clicks on inner <i>/<span> make event.target.href undefined.
        function handleLogout(event) {
            event.preventDefault();
            var anchor = event.currentTarget || (event.target && event.target.closest ? event.target.closest('a') : null);
            var logoutUrl = (anchor && anchor.href) ? anchor.href : '/Account/Logout';

            if (typeof Swal === 'undefined') {
                if (confirm('Are you sure you want to logout?')) {
                    window.location.assign(logoutUrl);
                }
                return;
            }

            Swal.fire({
                title: 'Confirm Logout',
                text: 'Are you sure you want to logout?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#4a6cf7',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, logout',
                cancelButtonText: 'Cancel'
            }).then(function (result) {
                if (result.isConfirmed) {
                    window.location.assign(logoutUrl);
                }
            });
        }
        
        // Dark Mode Functionality
        function initializeDarkMode() {
            const themeToggle = document.getElementById('themeToggle');
            const isDarkMode = localStorage.getItem('darkMode') === 'true';
            
            if (isDarkMode) {
                document.body.classList.add('dark-mode');
                if (themeToggle) themeToggle.textContent = '☀️';
            }
            
            if (themeToggle) {
                themeToggle.addEventListener('click', toggleDarkMode);
            }
        }
        
        function toggleDarkMode() {
            const body = document.body;
            const themeToggle = document.getElementById('themeToggle');
            
            body.classList.toggle('dark-mode');
            const isDarkMode = body.classList.contains('dark-mode');
            
            localStorage.setItem('darkMode', isDarkMode);
            
            if (themeToggle) {
                themeToggle.textContent = isDarkMode ? '☀️' : '🌙';
            }
            
            // Show feedback
            const mode = isDarkMode ? 'Dark' : 'Light';
            Swal.fire({
                title: `${mode} Mode Activated`,
                text: `Switched to ${mode.toLowerCase()} mode successfully!`,
                icon: 'success',
                timer: 1500,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        }
    </script>

    <!-- Render any additional scripts from individual pages -->
    @RenderSection("Scripts", required: false)
</body>
</html>