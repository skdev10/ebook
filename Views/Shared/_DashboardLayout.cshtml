<body>
    <div id="sidebarBackdrop" class="sidebar-backdrop" aria-hidden="true"></div>
    <!-- Mobile Menu Toggle -->
    <button type="button" class="menu-toggle" id="menuToggle" aria-label="Open menu">
        <i class="fas fa-bars"></i>
    </button>
    <!-- Add this hidden field for JavaScript to access userId -->
    @* style="display:none;" > *@
    <div class="form-group" style="display:none;">
        <div class="d-flex flex-wrap gap-3 align-items-end">
            <div class="flex-fill" style="min-width: 80px;">
                <label class="form-label" for="UserId">User ID</label>
                <input type="text" id="UserId" class="form-control" value="@ViewBag.UserId">
            </div>

            <div class="flex-fill" style="min-width: 80px;">
                <label class="form-label" for="BookId">Book ID</label>
                <input type="text" id="BookId" class="form-control" value="@ViewBag.SelectedBookId">
            </div>
        </div>
    </div>
    <div class="dashboard-container">
        <!-- Sidebar: collapsed = icons only; hover = expand to show labels -->
        <nav class="sidebar @(sidebarPinnedOpen ? "sidebar-pinned-open" : "")" id="sidebar">
            <div class="sidebar-header">
                <a href="/Dashboard" class="logo-link">
                    <i data-lucide="sparkles" class="sidebar-logo-icon sidebar-lucide-icon" stroke-width="1.5"></i>
                    <img src="@Url.Content("~/images/logo/ebook-ai-logo.png")" alt="ebook Ai" class="sidebar-logo-img" />
                </a>
            </div>
            <ul class="sidebar-menu">
                <li>
                    <a href="/Dashboard" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" || (ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["Action"]?.ToString() == null) ? "active" : "")">
                        <i data-lucide="layout-grid" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="@sidebarAiWriterUrl" data-entry-direct="true" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "AIGenerateBook" || ViewContext.RouteData.Values["Action"]?.ToString() == "Writer" ? "active" : "")">
                        <i data-lucide="pen-line" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">AI Writer</span>
                    </a>
                </li>
                <li>
                    <a href="@sidebarFormatUrl" data-entry-direct="true" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "CoverDesignCalculatorFixing" || ViewContext.RouteData.Values["Action"]?.ToString() == "Formatting" ? "active" : "")">
                        <i data-lucide="file-text" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Book Formatting</span>
                    </a>
                </li>
                <li>
                    <a href="@sidebarCoverUrl" data-entry-direct="true" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "CoverDesign" || ViewContext.RouteData.Values["Action"]?.ToString() == "Cover" ? "active" : "")">
                        <i data-lucide="image" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Cover Design</span>
                    </a>
                </li>
                @if (!flowSidebarMinimal)
                {
                <li>
                    @if (hasGeneratedBook) {
                        <a href="@sidebarPublishUrl" data-entry-direct="true" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Publish" ? "active" : "")">
                            <i data-lucide="rocket" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Publish</span>
                        </a>
                    } else {
                        <a href="#" class="sidebar-locked-feature" data-locked="Publish" title="Select a book from the Dashboard first" data-goto="@sidebarAiWriterUrl">
                            <i data-lucide="rocket" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Publish</span>
                        </a>
                    }
                </li>
                <li>
                    @if (publishUnlocked) {
                        <a href="/Dashboard/MyBooks" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "MyBooks" ? "active" : "")">
                            <i data-lucide="book-open" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">My Books</span>
                        </a>
                    } else {
                        <a href="#" class="sidebar-locked-feature" data-locked="My Books / Publish" data-unlock-step="3" data-goto="/Dashboard" title="Select a book from the Dashboard first">
                            <i data-lucide="book-open" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">My Books</span>
                        </a>
                    }
                </li>
                @* Support nav â€” temporarily disabled
