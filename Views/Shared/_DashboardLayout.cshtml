            text-align: center;
            max-width: 600px;
            padding: 30px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .welcome-animation {
            margin-bottom: 30px;
        }

        .book-flip {
            position: relative;
            width: 120px;
            height: 160px;
            margin: 0 auto;
            perspective: 1000px;
        }

        .book-cover, .book-page {
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #4a6cf7, #667eea);
            border-radius: 4px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            transform-style: preserve-3d;
            animation: flip 3s infinite;
        }

        .book-page {
            background: linear-gradient(135deg, #667eea, #4a6cf7);
            animation-delay: 1s;
        }

        @@keyframes flip {
            0%, 80% {
                transform: rotateY(0);
            }
            85% {
                transform: rotateY(180deg);
            }
            90%, 100% {
                transform: rotateY(180deg);
            }
        }

