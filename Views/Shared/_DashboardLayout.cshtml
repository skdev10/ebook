        }

        /* Labels: flyout to the right â€” sidebar width never changes, main margin never changes */
        .sidebar .nav-text {
            position: absolute;
            left: calc(100% + 10px);
            top: 50%;
            transform: translateY(-50%) translateX(-4px);
            margin: 0;
