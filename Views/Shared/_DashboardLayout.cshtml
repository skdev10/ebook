                </li>
                <li>
                    <a href="/Dashboard/Profile" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")">
                        <i data-lucide="user" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Profile</span>
                    </a>
                </li>
                @* <li>
                    @if (hasGeneratedBook) {
                        <a href="/Dashboard/Support" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Support" ? "active" : "")">
                            <i data-lucide="headphones" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Support</span>
                        </a>
                    } else {
                        <a href="#" class="sidebar-locked-feature" data-locked="Support" title="Generate a book first from AI Writer">
                            <i data-lucide="headphones" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Support</span>
                        </a>
                    }
                </li> *@
                <li style="margin-top: 8px;"><div style="height: 1px; background: #e5e7eb; margin: 0 16px;"></div></li>
                @* AUDIOBOOK — Temporarily disabled (preserve for re-enable)
                <li>
                    @if (hasGeneratedBook) {
                        <a href="/Dashboard/AudioBook" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "AudioBook" ? "active" : "")">
                            <i data-lucide="volume-2" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Audio Book</span>
                        </a>
                    } else {
                        <a href="#" class="sidebar-locked-feature" data-locked="Audio Book" title="Generate a book first from AI Writer">
                            <i data-lucide="volume-2" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Audio Book</span>
                        </a>
                    }
                </li>
                *@
                <li>
                    <a href="/Books/EBookHub" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Books" && ViewContext.RouteData.Values["Action"]?.ToString() == "EBookHub" ? "active" : "")">
                        <i data-lucide="users-round" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Ebook Hub</span>
                    </a>
                </li>
            </ul>

            <!-- ✅ Lucide Icons (same as AI Book Writer design) -->
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();
                });
            </script>
            <!-- ✅ SweetAlert Script -->
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const sidebarLocked = document.querySelectorAll(".sidebar-locked-feature");
                    sidebarLocked.forEach(link => {
                        link.addEventListener("click", function (e) {
                            e.preventDefault();
                            const name = this.getAttribute("data-locked") || "This feature";
                            const goto = this.getAttribute("data-goto") || "/Books/AIGenerateBook";
                            const step = this.getAttribute("data-unlock-step") || "1";
                            let msg = "Please complete the previous step before accessing this section.<br><br><b>" + name + "</b> will unlock when you finish the required step.";
                            let btn = "Go to AI Writer";
                            if (step === "2") { msg = "Complete <b>Book Formatting</b> first, then <b>AI Cover Design</b> will unlock."; btn = "Go to Formatting"; }
                            else if (step === "3") { msg = "Finalize your <b>Cover Design</b> first, then <b>My Books / Publish</b> will unlock."; btn = "Go to Cover Design"; }
                            else { msg = "Please generate your AI book first before accessing this section.<br><br>Go to <b>AI Writer</b> to unlock formatting and more."; }
                            Swal.fire({
                                title: "Complete Previous Step",
                                html: msg,
                                icon: "info",
                                confirmButtonText: btn,
                                confirmButtonColor: "#7c3aed"
                            }).then((result) => {
                                if (result.isConfirmed) window.location.href = goto;
                            });
                        });
                    });
                    const lockedLinks = document.querySelectorAll(".locked-feature");

                    lockedLinks.forEach(link => {
                        link.addEventListener("click", function (e) {
                            if (this.getAttribute("href") && this.getAttribute("href").indexOf("showUpgrade=1") !== -1) return;
                            e.preventDefault();
                            Swal.fire({
                                title: "Upgrade Required 🚀",
                                html: "<b>This feature is available only for premium users.</b><br><br>Please upgrade your plan to access it.",
                                icon: "info",
                                confirmButtonText: "Upgrade Now",
                                confirmButtonColor: "#007bff",
                                showCancelButton: true,
                                cancelButtonText: "Maybe Later",
                                cancelButtonColor: "#6c757d",
                                backdrop: `rgba(0,0,0,0.4)`
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location.href = '/Payments/FeaturesSelection';
                                }
                            });
                        });
                    });
                });
            </script>

            <script>
                async function showPricingPlans(){
                    window.location.href = '/Payments/FeaturesSelection';
                };
                               // Show plan features modal
                function showPlanFeaturesModal() {
                    if (typeof Swal === 'undefined') {
                        const s = document.createElement('script');
                        s.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11';
                        document.head.appendChild(s);
                    }

                    (async function(){
                        try {
                            const res = await fetch('/Plans/GetPlanFeatures');
                            if (!res.ok) throw new Error('Failed to load features');
                            const features = await res.json();
                            let list = (features || []).map(f => `
                                <label style="display:block;border:1px solid #e5e7eb;border-radius:14px;padding:14px;background:#fff;box-shadow:0 6px 18px rgba(0,0,0,.04)">
                                    <div style="display:flex;gap:12px;align-items:flex-start">
                                        <input type="checkbox" class="feat-check" value="${f.featureId}" data-name="${(f.featureName||'').replace(/"/g,'&quot;')}" data-price="${f.featureRate||0}" />
                                        <div style="flex:1">
                                            <div style="display:flex;justify-content:space-between;align-items:center">
                                                <strong>${f.featureName}</strong>
                                                <span style="font-weight:800">$${Number(f.featureRate||0).toFixed(2)}</span>
                                            </div>
                                            <div style="color:#6b7280;font-size:.9rem;margin-top:4px">${f.description || ''}</div>
                                        </div>
                                    </div>
                                </label>`).join('');
                            const html = `
                                <div style="max-height:60vh;overflow:auto">
                                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px">${list}</div>
                                </div>
                                <div style="margin-top:12px;display:flex;justify-content:space-between;align-items:center;border-top:1px solid #eee;padding-top:12px">
                                    <div><strong>Selected:</strong> <span id="featCount">0</span> · <strong>Total:</strong> $<span id="featTotal">0.00</span></div>
                                    <div style="display:flex;gap:8px">
                                        <button class="btn btn-primary btn-sm" id="btnGoSummaryDash">Go to Summary</button>
                                    </div>
                                </div>`;
                            Swal.fire({
                                title: 'Select Features',
                                html,
                                width: '1000px',
                                showConfirmButton: false,
                                showCloseButton: true,
                                didOpen: () => {
                                    function recalc(){
                                        const checks = document.querySelectorAll('.feat-check:checked');
                                        let total = 0;
                                        checks.forEach(ch => total += Number(ch.dataset.price||0));
                                        document.getElementById('featCount').textContent = checks.length;
                                        document.getElementById('featTotal').textContent = total.toFixed(2);
                                    }
                                    document.querySelectorAll('.feat-check').forEach(ch => ch.addEventListener('change', recalc));
                                    recalc();

                                    document.getElementById('btnGoSummaryDash').addEventListener('click', async ()=>{
                                        const checks = Array.from(document.querySelectorAll('.feat-check:checked'));
                                        if(checks.length === 0){
                                            Swal.fire('Info','Please select at least one feature.','info');
                                            return;
                                        }
                                        const ids = checks.map(ch => Number(ch.value));

                                        if (window.CartManager && typeof CartManager.addItems === 'function') {
                                            const items = checks.map(ch => ({
                                                id: Number(ch.value),
                                                type:'feature',
                                                name: ch.dataset.name||'Feature',
                                                price: Number(ch.dataset.price||0)
                                            }));
                                            CartManager.addItems(items);
                                        }

                                        try {
                                            Swal.fire({
                                                title:'Creating bill...',
                                                didOpen:()=>Swal.showLoading(),
                                                allowOutsideClick:false,
                                                allowEscapeKey:false,
                                                showConfirmButton:false
                                            });
                                            const billId = await CartManager.createBillFromFeatures(ids);
                                            Swal.close();
                                            window.location.href = `/Payments/PaymentSummary?billId=${billId}`;
                                        } catch(e){
                                            Swal.close();
                                            window.location.href = `/Payments/PaymentSummaryFromFeatures?featureIds=${ids.join(',')}`;
                                        }
                                    });
                                }
                            });
                        } catch(e){
                            if (typeof Swal !== 'undefined')
                                Swal.fire('Error', e.message || 'Could not load features.', 'error');
                        }
                    })();
                }

                // Cart helpers (shared)
                function getCart() {
                    try {
                        return JSON.parse(localStorage.getItem('cart') || '{"items":[]}');
                    } catch {
                        return { items: [] };
                    }
                }

                function setCart(cart) {
                    localStorage.setItem('cart', JSON.stringify(cart));
                }

             
            </script>

            <!-- 💄 Just small inline styling for lock spacing -->
            <style>
                .lock-icon {
                    margin-left: 8px; /* thoda gap text ke baad */
                    color: #999; /* halka grey look for lock */
                    font-size: 0.9em; /* thoda chhota lock */
                }
            </style>


            <div class="sidebar-footer">
                <a href="/Account/Logout" class="logout-btn">
                    <i data-lucide="log-out" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Logout</span>
                </a>
            </div>
        </nav>

        <!-- Cart removed per project requirement -->

        <!-- Main Content -->
        <main class="main-content @(ViewBag.LockMessage != null ? "locked-blur" : "")">
            @Html.AntiForgeryToken()
            @if (ViewBag.LockMessage != null)
            {
                <div class="locked-page-overlay" id="lockedPageOverlay">
                    <div class="locked-modal">
                        <h3>Complete Previous Step</h3>
                        <p>@ViewBag.LockMessage</p>
                        <a href="@(ViewBag.LockGoto ?? "/Books/AIGenerateBook")" class="btn-goto">@(ViewBag.LockButtonText ?? "Go to AI Writer")</a>
                    </div>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script>
        document.querySelectorAll('.has-sub > .menu-link').forEach(item => {
            item.addEventListener('click', function () {
                this.parentElement.classList.toggle('open');
            });
        });
    
        // Global cart manager for consistent UX
        window.CartManager = (function(){
            function resolveUserId(){
                try {
                    const el1 = document.getElementById('UserId');
                    if (el1 && el1.value) return parseInt(el1.value);
                    const el2 = document.getElementById('userId');
                    if (el2 && el2.value) return parseInt(el2.value);
                    const ls = localStorage.getItem('UserId') || localStorage.getItem('userId');
                    if (ls) return parseInt(ls);
                    const ss = sessionStorage.getItem('UserId') || sessionStorage.getItem('userId');
                    if (ss) return parseInt(ss);
                } catch {}
                return null;
            }
            async function createBillFromFeatures(featureIds){
                const ids = (featureIds||[]).map(x=> parseInt(x)).filter(x=> Number.isFinite(x));
                if (ids.length===0) throw new Error('No features to checkout');
                let userId = resolveUserId();
                if (!Number.isFinite(userId)) userId = 1;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    || document.querySelector('meta[name="RequestVerificationToken"]')?.getAttribute('content');
                async function callApi(body){
                    const res = await fetch('/api/AuthorPlanFeatures/save-features', {
                        method:'POST',
                        headers: { 'Content-Type':'application/json', ...(token?{ 'RequestVerificationToken': token }: {}) },
                        credentials: 'same-origin',
                        body: JSON.stringify(body)
                    });
                    const text = await res.text().catch(()=> '');
                    let jsonResp = null; try { jsonResp = text ? JSON.parse(text) : null; } catch {}
                    if(!res.ok){
                        const msg = jsonResp?.message || text || `HTTP ${res.status}`;
                        throw new Error(msg);
                    }
                    return jsonResp;
                }
                // Try without wrapper first (most common)
                try {
                    const json = await callApi({ authorId: userId, userId: userId, featureIds: ids });
                    if (json && json.success && json.billId) return json.billId;
                    throw new Error(json?.message || 'Failed to create bill');
                } catch (e1) {
                    // Fallback: try with { request: { ... } } wrapper if API expects it
                    try {
                        const json2 = await callApi({ request: { authorId: userId, userId: userId, featureIds: ids } });
                        if (json2 && json2.success && json2.billId) return json2.billId;
                        throw new Error(json2?.message || e1.message || 'Failed to create bill');
                    } catch (e2) {
                        throw e2;
                    }
                }
            }
            function getCart(){ try { return JSON.parse(localStorage.getItem('cart') || '{"items":[]}'); } catch { return { items: [] }; } }
            function setCart(cart){ localStorage.setItem('cart', JSON.stringify(cart)); updateUI(); }
            function updateUI(){
                const cart = getCart();
                const badge = document.getElementById('cartBadge');
                const icon = document.getElementById('floatingCartIcon');
                const drawerItems = document.getElementById('cartItems');
                const totalEl = document.getElementById('cartTotal');
                const count = cart.items.length;
                const total = cart.items.reduce((s, it) => s + (Number(it.price) || 0), 0);
                if (badge) badge.textContent = String(count);
                if (icon) icon.style.display = count > 0 ? 'block' : 'none';
                if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;
                if (drawerItems) {
                    drawerItems.innerHTML = count === 0 ? '<div class="empty-cart-message">Your cart is empty</div>' : cart.items.map(it => `
                        <div class=\"cart-item\" style=\"display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #eee\">
                            <div>
                                <div style=\"font-weight:600\">${it.name}</div>
                                <div style=\"color:#6b7280;font-size:.85rem\">$${Number(it.price).toFixed(2)}</div>
                            </div>
                            <button class=\"btn btn-sm btn-outline-secondary\" onclick=\"CartManager.remove(${it.id})\">Remove</button>
                        </div>`).join('');
                }
            }
            function addItems(items){
                const cart = getCart();
                items.forEach(it => { if(!cart.items.some(x => x.id === it.id)) cart.items.push(it); });
                setCart(cart);
            }
            // function remove(id){ const cart=getCart(); cart.items = cart.items.filter(x => x.id !== id); setCart(cart); }
                    // Update the remove function in your CartManager
        function remove(id) {
            // Show confirmation dialog
            Swal.fire({
                title: 'Remove Feature?',
                text: 'Are you sure you want to remove this feature from your cart?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, remove it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Show loading state
                    Swal.fire({
                        title: 'Removing...',
                        text: 'Please wait',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    // Get the anti-forgery token
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        || document.querySelector('meta[name="RequestVerificationToken"]')?.getAttribute('content');

                    // Call the server to remove from database
                    fetch('/Features/RemoveFromCart', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ featureId: id })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Remove from local cart
                            const cart = getCart();
                            cart.items = cart.items.filter(x => x.id !== id);
                            setCart(cart);

                            // Close the loading alert
                            Swal.close();

                            // Show success message
                            Swal.fire({
                                title: 'Removed!',
                                text: 'Feature has been removed from your cart.',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false,
                                toast: true,
                                position: 'top-end'
                            });

                            // Dispatch event for other components to update
                            document.dispatchEvent(new CustomEvent('cartServerUpdated', {
                                detail: { featureId: id }
                            }));
                        } else {
                            Swal.fire({
                                title: 'Error!',
                                text: data.message || 'Failed to remove feature. Please try again.',
                                icon: 'error'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire({
                            title: 'Error!',
                            text: 'An error occurred while removing the feature.',
                            icon: 'error'
                        });
                    });
                }
            });
        }

            function open(){ const d=document.getElementById('cartDrawer'); if(d) d.classList.add('open'); }
            function close(){ const d=document.getElementById('cartDrawer'); if(d) d.classList.remove('open'); }
            async function goToSummary(){
                const cart = getCart();
                const featureIds = cart.items.filter(x => x.type==='feature').map(x => x.id);
                if (featureIds.length === 0) { if (typeof Swal!=='undefined') Swal.fire('Cart Empty','Please add features to cart first.','info'); return; }
                try {
                    if (typeof Swal!=='undefined') Swal.fire({title:'Creating bill...', didOpen:()=>Swal.showLoading(), allowOutsideClick:false, allowEscapeKey:false, showConfirmButton:false});
                    const billId = await createBillFromFeatures(featureIds);
                    if (typeof Swal!=='undefined') Swal.close();
                    window.location.href = `/Payments/PaymentSummary?billId=${billId}`;
                } catch(e){
                    if (typeof Swal!=='undefined') Swal.close();
                    window.location.href = `/Payments/PaymentSummaryFromFeatures?featureIds=${featureIds.join(',')}`;
                }
            }
            return { getCart, setCart, updateUI, addItems, remove, open, close, goToSummary, createBillFromFeatures };
        })();

        // Wire cart UI
        document.addEventListener('DOMContentLoaded', function(){
            CartManager.updateUI();
            const icon = document.getElementById('floatingCartIcon');
            const closeBtn = document.getElementById('closeCart');
            const checkoutBtn = document.getElementById('checkoutBtn');
            if (icon) icon.addEventListener('click', CartManager.open);
            if (closeBtn) closeBtn.addEventListener('click', CartManager.close);
            if (checkoutBtn) checkoutBtn.addEventListener('click', function(){ CartManager.goToSummary(); });
        });

        // Expose helpers globally for other pages
        window.getCart = CartManager.getCart;
        window.setCart = CartManager.setCart;
        window.updateCartUI = CartManager.updateUI;
    </script>

