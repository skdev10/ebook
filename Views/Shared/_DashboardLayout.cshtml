                        </a>
                    } else {
                        <a href="#" class="sidebar-locked-feature" data-locked="Publish" title="Generate a book first from AI Writer" data-goto="/Books/AIGenerateBook">
                            <i data-lucide="rocket" class="sidebar-lucide-icon" stroke-width="1.5"></i><span class="nav-text">Publish</span>
