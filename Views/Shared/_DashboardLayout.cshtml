        /* Guided tour: violet spotlight + popover */
        #guidedTourBackdrop {
            position: fixed;
            inset: 0;
            z-index: 100000;
            background: rgba(15, 23, 42, 0.58);
            backdrop-filter: blur(1px);
            -webkit-backdrop-filter: blur(1px);
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s ease;
        }
        #guidedTourBackdrop.is-visible {
            opacity: 1;
        }
        .tour-highlight {
            position: relative;
            outline: none;
            border-radius: 16px;
            z-index: 100003 !important;
            transition: box-shadow 0.35s ease, transform 0.3s ease;
            box-shadow:
                0 0 0 1px rgba(255, 255, 255, 0.92),
                0 0 0 3px rgba(124, 58, 237, 0.28),
                0 0 0 6px rgba(124, 58, 237, 0.08),
                0 18px 40px -14px rgba(91, 33, 182, 0.35) !important;
            transform: translateY(-1px);
        }
        #guidedTourPopover {
            position: fixed;
            z-index: 100002;
            max-width: min(360px, calc(100vw - 32px));
            background: #fff;
            color: #0f172a;
            border-radius: 16px;
            padding: 20px 20px 15px;
            border: 1px solid rgba(124, 58, 237, 0.16);
            box-shadow: 0 24px 56px -16px rgba(124, 58, 237, 0.38), 0 0 0 1px rgba(124, 58, 237, 0.12);
            font-size: 14px;
            line-height: 1.45;
        }
        #guidedTourPopover .gt-title { font-weight: 700; font-size: 15px; color: #5b21b6; margin-bottom: 6px; }
        #guidedTourPopover .gt-body { color: #475569; margin-bottom: 14px; }
        #guidedTourPopover .gt-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
        #guidedTourPopover button {
            border: none;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            padding: 8px 14px;
            border-radius: 10px;
            transition: background 0.2s, color 0.2s;
        }
        #guidedTourPopover .gt-skip { background: #f1f5f9; color: #64748b; }
        #guidedTourPopover .gt-skip:hover { background: #e2e8f0; }
        #guidedTourPopover .gt-next { background: #7c3aed; color: #fff; }
        #guidedTourPopover .gt-next:hover { background: #6d28d9; }
        #guidedTourPopover .gt-stepcount { font-size: 12px; color: #94a3b8; margin-right: auto; align-self: center; }
        #guidedTourFab {
            position: fixed;
            right: 22px;
            bottom: 22px;
            z-index: 9980;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 999px;
