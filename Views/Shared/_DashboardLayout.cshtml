            'publish': [
                { sel: '[data-guided-tour="pub-hero"]', title: 'Publish', body: 'Last step. Download the files you need for stores like KDP.' },
                { sel: '[data-guided-tour="pub-status"]', title: 'Book status', body: 'You need chapters and a cover before downloads unlock.' },
                { sel: '[data-guided-tour="pub-export"]', title: 'Downloads', body: 'Get your front cover, EPUB, full wrap, or interior PDF — based on your format.' }
            ],
            'my-books': [
                { sel: '[data-guided-tour="mb-books"]', title: 'Your books', body: 'All your books are here. Tap a card to see details.' },
                { sel: '[data-guided-tour="mb-actions"]', title: 'Quick actions', body: 'Start a new book or export finished files.' },
                { sel: '[data-guided-tour="mb-detail"]', title: 'Book details', body: 'Preview, edit, or manage the selected book.' }
            ],
            'profile': [
                { sel: '.profile-header, .user-profile-header, main h1', title: 'Your profile', body: 'Update your name and photo here.' },
                { sel: 'form, .profile-form, #profileForm', title: 'Save', body: 'Edit your details, then tap Save.' }
            ],
            'default': [
                { sel: '#sidebar', title: 'Menu', body: 'Use the sidebar anytime for AI Writer, Book Formatting, and Cover Design. Basic tools stay free; you pay only when you export premium extras.' },
                { sel: '#guidedTourFab', title: 'Need help?', body: 'Tap Tour anytime for a short guide of this screen.' }
            ]
        };

        let __guidedTourActive = null;

        function __clearGuidedTourHighlight() {
            document.querySelectorAll('.tour-highlight').forEach(function (el) { el.classList.remove('tour-highlight'); });
        }

        function __ensureGuidedTourBackdrop() {
            var existing = document.getElementById('guidedTourBackdrop');
            if (existing) return existing;
            var el = document.createElement('div');
            el.id = 'guidedTourBackdrop';
            document.body.appendChild(el);
            return el;
        }

        function __showGuidedTourBackdrop() {
            var bd = __ensureGuidedTourBackdrop();
            requestAnimationFrame(function () { bd.classList.add('is-visible'); });
        }

        function __hideGuidedTourBackdrop() {
            var bd = document.getElementById('guidedTourBackdrop');
            if (!bd) return;
            bd.classList.remove('is-visible');
            setTimeout(function () {
                var still = document.getElementById('guidedTourBackdrop');
                if (still && !still.classList.contains('is-visible')) still.remove();
            }, 220);
        }

        function __positionGuidedPopover(popover, target) {
            if (!popover || !target) return;
            var rect = target.getBoundingClientRect();
            var margin = 16;
            var gap = 20;
            var pw = popover.offsetWidth || 320;
            var ph = popover.offsetHeight || 160;
            var left;
            var top;
            var isSidebar = target.id === 'sidebar' || (target.classList && target.classList.contains('sidebar'));
            if (isSidebar) {
                left = rect.right + gap;
                top = Math.max(margin, rect.top + margin);
                if (left + pw > window.innerWidth - margin) {
                    left = rect.left + gap;
                    top = rect.bottom + gap;
                }
            } else {
                left = rect.left + rect.width / 2 - pw / 2;
                top = rect.bottom + gap;
                if (top + ph > window.innerHeight - margin) top = rect.top - ph - gap;
            }
            left = Math.max(margin, Math.min(left, window.innerWidth - pw - margin));
            top = Math.max(margin, Math.min(top, window.innerHeight - ph - margin));
            popover.style.left = left + 'px';
            popover.style.top = top + 'px';
        }

        function endGuidedTour(showToast) {
            teardownGuidedTourListeners();
            __clearGuidedTourHighlight();
            __hideGuidedTourBackdrop();
            var pop = document.getElementById('guidedTourPopover');
            if (pop) pop.remove();
            __guidedTourActive = null;
            if (showToast && typeof Swal !== 'undefined') {
                Swal.fire({ title: 'Tour done!', text: 'Tap Tour anytime if you want to see this guide again.', icon: 'success', timer: 2200, showConfirmButton: false, toast: true, position: 'bottom-end' });
            }
        }

        function persistGuidedTourCompletion() {
            if (__tourCompletionPersisted) return;
            __tourCompletionPersisted = true;
            fetch('/Dashboard/CompleteTour', {
                method: 'POST',
                credentials: 'same-origin'
            }).catch(function () {
                __tourCompletionPersisted = false;
            });
        }

        function startGuidedTourForRoute(routeKey, opts) {
            opts = opts || {};
            teardownGuidedTourListeners();
            endGuidedTour(false);
            __showGuidedTourBackdrop();
            var rawSteps = GUIDED_TOUR_ROUTES[routeKey] || GUIDED_TOUR_ROUTES['default'];
            // Only keep steps whose targets exist on this page (accurate count + no blank skips).
            var steps = rawSteps.filter(function (step) {
                try { return !!document.querySelector(step.sel); } catch (e) { return false; }
            });
            if (!steps.length) {
                steps = GUIDED_TOUR_ROUTES['default'].filter(function (step) {
                    try { return !!document.querySelector(step.sel); } catch (e) { return false; }
                });
            }
            var i = 0;
            var anyStepShown = false;
            var shouldPersistCompletion = !!opts.persistCompletion;

            function persistDone() {
                if (shouldPersistCompletion && anyStepShown) persistGuidedTourCompletion();
            }

            function scrollTourTargetIntoView(target) {
                if (!target) return;
                try {
                    var scrollParent = target.closest('.fmt-left-scroll, .ai-writer-sidebar, .dash-flow-main, .main-content');
                    if (scrollParent && scrollParent !== document.body) {
                        var parentRect = scrollParent.getBoundingClientRect();
                        var rect = target.getBoundingClientRect();
                        var delta = (rect.top + rect.height / 2) - (parentRect.top + parentRect.height / 2);
                        scrollParent.scrollTop = Math.max(0, scrollParent.scrollTop + delta);
                    }
                    target.scrollIntoView({ block: 'center', behavior: 'smooth', inline: 'nearest' });
                } catch (e) {
                    try { target.scrollIntoView(true); } catch (e2) { /* ignore */ }
                }
            }

            function nextStep() {
                __clearGuidedTourHighlight();
                if (i >= steps.length) {
                    if (anyStepShown) persistDone();
                    endGuidedTour(!opts.silent && anyStepShown);
                    return;
                }
                var target = document.querySelector(steps[i].sel);
                if (!target) { i++; return nextStep(); }
                anyStepShown = true;
                scrollTourTargetIntoView(target);

                var delay = opts.silent ? 50 : 320;
                setTimeout(function () {
                    target.classList.add('tour-highlight');
                    var pop = document.getElementById('guidedTourPopover');
                    if (!pop) {
                        pop = document.createElement('div');
                        pop.id = 'guidedTourPopover';
                        document.body.appendChild(pop);
                    }
                    var isLast = (i >= steps.length - 1);
                    pop.innerHTML =
                        '<div class="gt-title"></div><div class="gt-body"></div><div class="gt-actions">' +
                        '<span class="gt-stepcount"></span>' +
                        '<button type="button" class="gt-skip" data-gt="skip">Skip</button>' +
                        '<button type="button" class="gt-next" data-gt="next">' + (isLast ? 'Done' : 'Next') + '</button></div>';
                    pop.querySelector('.gt-title').textContent = steps[i].title;
                    pop.querySelector('.gt-body').textContent = steps[i].body;
                    pop.querySelector('.gt-stepcount').textContent = (i + 1) + ' / ' + steps.length;
                    __positionGuidedPopover(pop, target);

                    pop.querySelector('[data-gt="skip"]').onclick = function () {
                        persistDone();
                        endGuidedTour(false);
                    };
                    pop.querySelector('[data-gt="next"]').onclick = function () {
                        i++;
                        nextStep();
                    };
                }, delay);
            }

            __guidedTourActive = routeKey;
            var onResize = function () {
                var pop = document.getElementById('guidedTourPopover');
                var hi = document.querySelector('.tour-highlight');
                if (pop && hi) __positionGuidedPopover(pop, hi);
            };
            window.addEventListener('resize', onResize);
            __guidedTourActiveResize = onResize;

            nextStep();
        }  
         


        var __guidedTourActiveResize = null;

        function teardownGuidedTourListeners() {
            if (__guidedTourActiveResize) {
                window.removeEventListener('resize', __guidedTourActiveResize);
                __guidedTourActiveResize = null;
            }
        }

        function startGuidedTourForCurrentPage(options) {
            var route = guidedTourRouteKey();
            startGuidedTourForRoute(route, options || {});
        }

        function maybeAutoStartGuidedTour() {
            fetch('/Dashboard/TourStatus', {
                method: 'GET',
                credentials: 'same-origin'
            })
            .then(function (r) { return r.ok ? r.json() : { success: false, hasCompletedTour: true }; })
            .then(function (data) {
                if (!data || data.success === false) return;
                if (data.hasCompletedTour === true) {
                    __tourCompletionPersisted = true;
                    return;
                }
                setTimeout(function () {
                    startGuidedTourForCurrentPage({ persistCompletion: true });
                }, 700);
            })
            .catch(function () { /* do not block app startup */ });
        }

        function ensureGuidedTourFab() {
            if (document.getElementById('guidedTourFab')) return;
            var fab = document.createElement('button');
            fab.type = 'button';
            fab.id = 'guidedTourFab';
            fab.setAttribute('aria-label', 'Start guided tour');
            fab.innerHTML = '<i class="fas fa-map-signs"></i> Tour';
            document.body.appendChild(fab);
            fab.addEventListener('click', function () {
                startGuidedTourForCurrentPage({ silent: false, persistCompletion: true });
            });
        }

        // Legacy name: "How to start" modal â†’ dashboard-style steps
        function startDashboardTour() {
            startGuidedTourForRoute('dashboard', { silent: false, persistCompletion: true });
        }

        function endDashboardTour() {
            endGuidedTour(false);
        }

        function updateOrderSummary() {
            // Safely update order summary stats
            const pageViews = document.getElementById('pageViews');
            const clicksOnLink = document.getElementById('clicksOnLink');
            const booksSold = document.getElementById('booksSold');
            const costSoFar = document.getElementById('costSoFar');

            if (pageViews) pageViews.textContent = '2442';
            if (clicksOnLink) clicksOnLink.textContent = '5442';
            if (booksSold) booksSold.textContent = '1200';  
            if (costSoFar) costSoFar.textContent = '$2442';
        }

        // Placeholder function for charts (to fix the ReferenceError)
        function initializeCharts() {
            // This function would initialize charts if needed
            console.log('Charts initialized');
        }

        // Initialize the app when DOM is fully loaded
        document.addEventListener('DOMContentLoaded', function() {
            initializeApp();
            initializeCharts(); // Call the function that was causing ReferenceError
            
            // Welcome message removed per user request
            // showWelcomeMessage();
            
            // Logout goes directly to /Account/Logout (no confirmation dialog).
            
            // AOS only on main content (sidebar has no data-aos - no shake, no weird icons)
            if (typeof AOS !== 'undefined') {
                document.querySelectorAll('#sidebar [data-aos]').forEach(function(el) { el.removeAttribute('data-aos'); });
                AOS.init({
                    duration: 600,
                    easing: 'ease-out',
                    once: true,
                    offset: 80,
                    disable: 'mobile'
                });
            }
                    
            // Initialize dark mode
            initializeDarkMode();

            // Update sidebar profile picture when page loads or after upload
            updateSidebarProfilePicture();

            ensureGuidedTourFab();
            maybeAutoStartGuidedTour();
        });

        // Function to update sidebar profile picture
        function updateSidebarProfilePicture() {
            // Check if profile picture was just uploaded (stored in sessionStorage)
            const newProfilePic = sessionStorage.getItem('newProfilePicture');
            if (newProfilePic) {
                const sidebarAvatar = document.getElementById('sidebarUserAvatar');
                const sidebarImg = document.getElementById('sidebarProfileImg');
                
                if (sidebarAvatar && newProfilePic) {
                    // If image doesn't exist, create it
                    if (!sidebarImg) {
                        const img = document.createElement('img');
                        img.src = newProfilePic + '?t=' + new Date().getTime();
                        img.alt = '@sidebarUserName';
                        img.className = 'sidebar-profile-img';
                        img.id = 'sidebarProfileImg';
                        
                        // Remove initial if exists
                        const initial = sidebarAvatar.querySelector('.sidebar-avatar-initial');
                        if (initial) {
                            initial.remove();
                        }
                        
                        sidebarAvatar.appendChild(img);
                        
                        // Add overlay
                        const overlay = document.createElement('div');
                        overlay.className = 'sidebar-avatar-overlay';
                        overlay.innerHTML = '<i class="fas fa-camera"></i>';
                        sidebarAvatar.appendChild(overlay);
                    } else {
                        // Update existing image
                        sidebarImg.src = newProfilePic + '?t=' + new Date().getTime();
                    }
                }

                window.dispatchEvent(new CustomEvent('profilePictureUpdated'));
                sessionStorage.removeItem('newProfilePicture');
            }
        }

        // Listen for profile picture updates from Profile page
        window.addEventListener('storage', function(e) {
            if (e.key === 'profilePictureUpdated') {
                updateSidebarProfilePicture();
            }
        });

        // Also update on focus (when user comes back to page)
        window.addEventListener('focus', function() {
            updateSidebarProfilePicture();
        });
        
        // Welcome message function
        function showWelcomeMessage() {
            const userName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.Identity?.Name ?? "Reader"));
            if (userName && userName !== 'Reader') {
                // Only show welcome message if we're on the main dashboard page
                if (window.location.pathname === '/Dashboard' || window.location.pathname === '/Dashboard/Index') {
                    Swal.fire({
                        title: 'Welcome Back!',
                        text: `Hello ${userName}, ready to explore amazing books?`,
                        icon: 'success',
                        timer: 3000,
                        timerProgressBar: true,
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        background: 'linear-gradient(135deg, #4a6cf7, #667eea)',
                        color: 'white'
                    });
                }
            }
        }
        
        
        // Dark Mode Functionality
        function initializeDarkMode() {
            const themeToggle = document.getElementById('themeToggle');
            const isDarkMode = localStorage.getItem('darkMode') === 'true';
            
            if (isDarkMode) {
                document.body.classList.add('dark-mode');
                if (themeToggle) themeToggle.textContent = 'â˜€ï¸';
            }
            
            if (themeToggle) {
                themeToggle.addEventListener('click', toggleDarkMode);
            }
        }
        
        function toggleDarkMode() {
            const body = document.body;
            const themeToggle = document.getElementById('themeToggle');
            
            body.classList.toggle('dark-mode');
            const isDarkMode = body.classList.contains('dark-mode');
            
            localStorage.setItem('darkMode', isDarkMode);
            
            if (themeToggle) {
                themeToggle.textContent = isDarkMode ? 'â˜€ï¸' : 'ðŸŒ™';
            }
            
            // Show feedback
            const mode = isDarkMode ? 'Dark' : 'Light';
            Swal.fire({
                title: `${mode} Mode Activated`,
                text: `Switched to ${mode.toLowerCase()} mode successfully!`,
                icon: 'success',
                timer: 1500,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        }
    </script>

    <!-- Soft modules: free navigation between Writer / Formatting / Cover / Publish when a book is open.
         Only keep a light Back-button helper â€” do NOT block sidebar clicks. -->
    @if (flowBookId > 0 && !string.IsNullOrWhiteSpace(flowStep))
    {
        <script>
            (function () {
                var flowBackUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.IsNullOrWhiteSpace(flowBackUrl) ? "/Dashboard" : flowBackUrl));

                function confirmFlowLeave(targetUrl) {
                    var target = targetUrl || flowBackUrl || '/Dashboard';
                    if (window.EbookUnsavedGuard && typeof window.EbookUnsavedGuard.confirmLeave === 'function') {
                        return window.EbookUnsavedGuard.confirmLeave(target).then(function () {
                            window.location.href = target;
                            return true;
                        });
                    }
                    window.location.href = target;
                    return Promise.resolve(true);
                }

                window.confirmLeaveToAiWriter = function (targetUrl) { return confirmFlowLeave(targetUrl); };
                window.confirmFlowBack = function (targetUrl) { return confirmFlowLeave(targetUrl || flowBackUrl); };

                document.addEventListener('DOMContentLoaded', function () {
                    document.querySelectorAll('[data-flow-back]').forEach(function (btn) {
                        btn.addEventListener('click', function (e) {
                            e.preventDefault();
                            window.confirmFlowBack(btn.getAttribute('data-flow-back') || flowBackUrl);
                        });
                    });
                });
            })();
        </script>
    }
    <partial name="_MobileBlockOverlay" />
    @RenderSection("Scripts", required: false)
