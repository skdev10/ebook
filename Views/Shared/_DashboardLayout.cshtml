            font-size: 0.9rem;
            color: #7f8c8d;
        }

        .quick-actions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px;
        }

        .action-card {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 1px solid #eee;
        }

            .action-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
                border-color: #4a6cf7;
                background: white;
            }

        .action-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: linear-gradient(135deg, #4a6cf7, #667eea);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            margin: 0 auto 15px;
        }

        .action-card h3 {
            font-size: 1.1rem;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .action-card p {
            font-size: 0.9rem;
            color: #7f8c8d;
            margin: 0;
        }

        .projects-section {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
        }

        .project-card {
            border: 1px solid #eee;
            border-radius: 12px;
            padding: 20px;
            transition: all 0.3s ease;
        }

            .project-card:hover {
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
            }

        .project-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

            .project-header h3 {
                font-size: 1.2rem;
                color: #2c3e50;
                margin: 0;
            }

        .project-status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

            .project-status.active {
                background: rgba(76, 175, 80, 0.15);
                color: #2E7D32;
            }

            .project-status.review {
                background: rgba(255, 152, 0, 0.15);
                color: #FF9800;
            }

        .project-progress {
            margin-bottom: 20px;
        }

        .progress-bar {
            height: 8px;
            background: #eee;
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 10px;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #4a6cf7, #667eea);
            border-radius: 4px;
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            font-size: 0.9rem;
            color: #7f8c8d;
        }

        .project-actions {
            text-align: center;
        }
        /* My Books sub menu */
        .menu-item {
            list-style: none;
        }

        .menu-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 15px;
            cursor: pointer;
        }

        .menu-item .submenu {
            display: none;
            padding-left: 25px;
        }

        .menu-item.open .submenu {
            display: block;
        }

        .submenu li a {
            display: block;
            padding: 8px 0;
            color: #555;
            text-decoration: none;
        }

            .submenu li a.active {
                color: #0d6efd;
                font-weight: bold;
            }

        .arrow {
            transition: transform 0.3s;
        }

        .menu-item.open .arrow {
            transform: rotate(180deg);
        }

    </style>
