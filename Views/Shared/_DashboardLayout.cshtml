    @{
        var __kdp = EBookDashboard.Configuration.KdpSpecsAccessor.Current;
        var __kdpJson = System.Text.Json.JsonSerializer.Serialize(new {
            dpi = __kdp.Dpi,
            bleedIn = __kdp.BleedIn,
            safeFromTrimIn = __kdp.SafeFromTrimIn,
            spineTextMinWidthIn = __kdp.SpineTextMinWidthIn,
            barcodeWidthIn = __kdp.BarcodeWidthIn,
            barcodeHeightIn = __kdp.BarcodeHeightIn,
            barcodeMarginFromTrimIn = __kdp.BarcodeMarginFromTrimIn,
            paper = new {
                white = __kdp.PaperThicknessInPerPage.White,
                cream = __kdp.PaperThicknessInPerPage.Cream,
                premiumColor = __kdp.PaperThicknessInPerPage.PremiumColor,
                standardColor = __kdp.PaperThicknessInPerPage.StandardColor
            },
            paperback = new { min = __kdp.Paperback.MinPages, max = __kdp.Paperback.MaxPages },
            hardcover = new {
                min = __kdp.Hardcover.MinPages,
                max = __kdp.Hardcover.MaxPages,
                spineCaseExtraIn = __kdp.Hardcover.SpineCaseExtraIn,
                wrapAllowancePerEdgeIn = __kdp.Hardcover.WrapAllowancePerEdgeIn
            },
            alternateCaseLayout = new {
                minSpineInches = __kdp.AlternateCaseLayout.MinSpineInches,
                wrapMarginInches = __kdp.AlternateCaseLayout.WrapMarginInches,
                hingeGapInches = __kdp.AlternateCaseLayout.HingeGapInches
            },
            margins = new {
                recommendedOuterNoBleedIn = __kdp.InteriorMargins.RecommendedOuterNoBleedIn,
                recommendedOuterWithBleedIn = __kdp.InteriorMargins.RecommendedOuterWithBleedIn,
                gutterTiers = __kdp.InteriorMargins.GutterTiers,
                fallbackInsideIn = __kdp.InteriorMargins.FallbackInsideIn
            },
            trimPresets = __kdp.TrimPresets
        });
    }
    <script>window.__kdpSpecs = @Html.Raw(__kdpJson);</script>
    <partial name="_BookInteriorPreviewAssets" />
    <link rel="stylesheet" href="~/css/dashboard-flow.css" asp-append-version="true" />
    <style>
        @Html.Raw(EBookDashboard.Services.DashboardLayoutTokens.BuildCssCustomProperties())
        /* All your CSS styles remain exactly the same */
        /* Prevent layout shift and page shake */
        html {
            overflow-y: auto;
            overflow-x: hidden;
        }
        /* Base styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        :root {
            --app-page-bg: var(--dash-page-bg, #f5f3ff);
            --dash-sidebar-w: 72px;
            --dash-sidebar-w-expanded: 252px;
            --dash-sidebar-ease: cubic-bezier(0.22, 1, 0.36, 1);
            --dash-sidebar-dur: 0.42s;
        }
        html {
            scrollbar-gutter: stable;
        }
        body {
            background-color: var(--app-page-bg);
            color: #333;
            line-height: 1.6;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        /* Stronger typography for headings - professional readability */
        .main-content h1, .main-content h2, .main-content h3, .main-content .font-semibold {
            font-weight: 600;
        }

        /* Dashboard layout */
        .dashboard-container {
            display: flex;
            flex: 1;
            min-height: 100vh;
        }

        /* Left rail: narrow by default; desktop hover expands width over the page (main margin stays 72px â€” no reflow/shake). */
        .sidebar {
            width: var(--dash-sidebar-w);
            background: #fff;
            border-right: 1px solid #f3f4f6;
            color: #374151;
            padding: 16px 0;
            display: flex;
            flex-direction: column;
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
            height: 100dvh;
            overflow-x: hidden;
            overflow-y: auto;
            z-index: 1000;
            box-shadow: 1px 0 0 rgba(0,0,0,0.05);
            transform: translateZ(0);
            backface-visibility: hidden;
            transition: width 0.22s ease, box-shadow 0.22s ease;
        }

        /* Desktop: mouse on sidebar opens full labels + wider rail (overlays content). */
        @@media (min-width: 769px) {
            .sidebar:hover {
                width: var(--dash-sidebar-w-expanded);
                box-shadow: 8px 0 28px rgba(15, 23, 42, 0.1);
            }

            .sidebar:hover .sidebar-header {
                justify-content: flex-start;
                padding-left: 14px;
                padding-right: 14px;
            }

            .sidebar:hover .sidebar-header .logo-link {
                justify-content: flex-start;
                width: 100%;
            }

            .sidebar:hover .sidebar-header .logo-link .sidebar-logo-icon {
                display: none;
            }

            .sidebar:hover .sidebar-header .logo-link .sidebar-logo-img {
                display: block;
            }

            .sidebar:hover .sidebar-menu a,
            .sidebar:hover .sidebar-footer a {
                justify-content: flex-start;
            }

            /* Inline labels while expanded (overrides tooltip flyout). */
            .sidebar:hover .nav-text,
            .sidebar:hover .sidebar-menu a:hover .nav-text,
            .sidebar:hover .sidebar-menu a:focus-visible .nav-text,
            .sidebar:hover .sidebar-footer a:hover .nav-text,
            .sidebar:hover .sidebar-footer a:focus-visible .nav-text {
                position: static;
                opacity: 1;
                visibility: visible;
                transform: none;
                left: auto;
                top: auto;
                margin-left: 12px;
                max-width: min(200px, 36vw);
                padding: 0;
                background: transparent;
                color: inherit;
                font-size: 0.9375rem;
                font-weight: 500;
                box-shadow: none;
                pointer-events: auto;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                transition:
                    opacity 0.26s ease 0.05s,
                    visibility 0.26s ease 0.05s,
                    margin-left var(--dash-sidebar-dur) var(--dash-sidebar-ease),
                    color 0.2s ease;
            }

        }

        /* Dashboard home: sidebar pinned fully open by default (no auto-collapse; main content shifts to fit). */
        @@media (min-width: 769px) {
            .sidebar.sidebar-pinned-open {
                width: var(--dash-sidebar-w-expanded);
            }

            .sidebar.sidebar-pinned-open .sidebar-header {
                justify-content: flex-start;
                padding-left: 14px;
                padding-right: 14px;
            }

            .sidebar.sidebar-pinned-open .sidebar-header .logo-link {
                justify-content: flex-start;
                width: 100%;
            }

            .sidebar.sidebar-pinned-open .sidebar-header .logo-link .sidebar-logo-icon {
                display: none;
            }

            .sidebar.sidebar-pinned-open .sidebar-header .logo-link .sidebar-logo-img {
                display: block;
            }

            .sidebar.sidebar-pinned-open .sidebar-menu a,
            .sidebar.sidebar-pinned-open .sidebar-footer a {
                justify-content: flex-start;
            }

            .sidebar.sidebar-pinned-open .nav-text,
            .sidebar.sidebar-pinned-open .sidebar-menu a:hover .nav-text,
            .sidebar.sidebar-pinned-open .sidebar-menu a:focus-visible .nav-text,
            .sidebar.sidebar-pinned-open .sidebar-footer a:hover .nav-text,
            .sidebar.sidebar-pinned-open .sidebar-footer a:focus-visible .nav-text {
                position: static;
                opacity: 1;
                visibility: visible;
                transform: none;
                left: auto;
                top: auto;
                margin-left: 12px;
                max-width: min(200px, 36vw);
                padding: 0;
                background: transparent;
                color: inherit;
                font-size: 0.9375rem;
                font-weight: 500;
                box-shadow: none;
                pointer-events: auto;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .main-content.main-content-pinned {
                margin-left: var(--dash-sidebar-w-expanded);
                width: calc(100% - var(--dash-sidebar-w-expanded));
                /* Fixed viewport height so the dashboard scrolls inside its own column â€”
                   no document scroll, so no empty space above the header while scrolling. */
                height: 100vh;
                height: 100dvh;
                overflow: hidden;
            }
        }

        /* Book Formatting nav: hide "No Book Selected" / "Format: Ebook" subtext (details remain on formatter screen) */
        .sidebar-formatter-state {
            display: none !important;
        }

        .sidebar-header {
