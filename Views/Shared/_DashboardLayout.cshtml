    <script>
        // Smooth, no-shake scroll lock manager
        const ScrollLock = (() => {
            let lockCount = 0;
            let originalPaddingRight = '';
            let originalOverflow = '';

            const getScrollbarWidth = () => {
                const width = window.innerWidth - document.documentElement.clientWidth;
                return width > 0 ? width : 0;
            };

            const apply = () => {
                const sbw = getScrollbarWidth();
                if (lockCount === 1) {
                    originalOverflow = document.body.style.overflow;
                    originalPaddingRight = document.body.style.paddingRight;
                    if (sbw > 0) {
                        document.body.style.paddingRight = sbw + 'px';
                    }
                    document.body.style.overflow = 'hidden';
                }
            };

            const remove = () => {
                if (lockCount === 0) {
                    document.body.style.overflow = originalOverflow || '';
                    document.body.style.paddingRight = originalPaddingRight || '';
                    originalOverflow = '';
                    originalPaddingRight = '';
                }
            };

            const recalc = () => {
                if (lockCount > 0) {
                    const sbw = getScrollbarWidth();
                    if (sbw > 0) {
                        document.body.style.paddingRight = sbw + 'px';
                    } else {
                        document.body.style.paddingRight = '';
                    }
                }
            };

            return {
                lock() { lockCount++; apply(); },
                unlock() { if (lockCount > 0) lockCount--; remove(); },
                recalc,
                isLocked() { return lockCount > 0; }
            };
        })();

        // Cart functionality
        const Cart = (() => {
            let items = [];
            let cartIcon = null;
            let cartDrawer = null;
            let cartBadge = null;
            let cartItemsContainer = null;
            let cartTotalElement = null;

            // Initialize cart
            function init() {
                cartIcon = document.getElementById('floatingCartIcon');
                cartDrawer = document.getElementById('cartDrawer');
                cartBadge = document.getElementById('cartBadge');
                cartItemsContainer = document.getElementById('cartItems');
                cartTotalElement = document.getElementById('cartTotal');

                // Load cart from localStorage
                loadCart();

                // Event listeners
                if (cartIcon) {
                    cartIcon.addEventListener('click', openCart);
                }

                const closeCartBtn = document.getElementById('closeCart');
                if (closeCartBtn) {
                    closeCartBtn.addEventListener('click', closeCart);
                }

                const checkoutBtn = document.getElementById('checkoutBtn');
                if (checkoutBtn) {
                    checkoutBtn.addEventListener('click', checkout);
                }

                // Close cart when clicking outside
                document.addEventListener('click', (e) => {
                    if (cartDrawer && cartDrawer.classList.contains('open') && 
                        !cartDrawer.contains(e.target) && 
                        e.target !== cartIcon) {
                        closeCart();
                    }
                });

                // Refresh cart from server when another page adds/removes/clears (e.g. FeaturesSelection)
                document.addEventListener('cartServerUpdated', function() {
                    loadCart();
                });
            }

            // Load cart from localStorage
            async function loadCart() {
                try {
                    // Load server-side temp cart for authenticated users
                    const res = await fetch('/Features/CartPreview');
                    if (res.ok) {
                        const data = await res.json();
                        if (data.success) {
                            items = (data.items || []).map(i => ({ id: i.id, name: i.name, type: i.type || 'Feature', price: i.price || 0, quantity: 1 }));
                            updateCartUI();
                            return;
                        }
                    }
                } catch (e) {}

                // Fallback to client cart storage
                const savedCart = localStorage.getItem('cartItems');
                if (savedCart) {
                    items = JSON.parse(savedCart);
                    updateCartUI();
                }
            }

            // Save cart to localStorage
            function saveCart() {
                localStorage.setItem('cartItems', JSON.stringify(items));
            }

            // Add item to cart
            function addItem(item) {
                // Check if item already exists
                const existingItem = items.find(i => i.id === item.id);
                if (existingItem) {
                    existingItem.quantity += 1;
                } else {
                    items.push({ ...item, quantity: 1 });
                }
                saveCart();
                updateCartUI();
                animateCartIcon();
                
                // Show success notification
                showAddToCartNotification(item.name);
            }

            // Remove item from cart (server + local, then notify so FeaturesSelection can refresh)
            async function removeItem(itemId) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    || document.querySelector('meta[name="RequestVerificationToken"]')?.getAttribute('content') || '';
                try {
                    const res = await fetch('/Features/RemoveFromCart', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify({ featureId: parseInt(itemId, 10) })
                    });
                    const data = await res.json().catch(() => ({}));
                    if (data.success) {
                        items = items.filter(item => item.id !== itemId);
                        saveCart();
                        updateCartUI();
                        document.dispatchEvent(new CustomEvent('cartServerUpdated'));
                    }
                } catch (e) {
                    // Keep local state unchanged on error so user can retry
                }
            }

            // Update cart UI
            function updateCartUI() {
                updateCartBadge();
                updateCartItems();
                updateCartTotal();
            }

            // Update cart badge
            function updateCartBadge() {
                const totalItems = items.reduce((total, item) => total + item.quantity, 0);
                if (cartBadge) {
                    cartBadge.textContent = totalItems;
                    cartBadge.style.display = totalItems > 0 ? 'flex' : 'none';
                }
            }

            // Update cart items display
            function updateCartItems() {
                if (!cartItemsContainer) return;

                if (items.length === 0) {
                    cartItemsContainer.innerHTML = '<div class="empty-cart-message">Your cart is empty</div>';
                    return;
                }

                cartItemsContainer.innerHTML = items.map(item => `
                    <div class="cart-item">
                        <div class="item-info">
                            <div class="item-name">${item.name}</div>
                            <div class="item-type">${item.type}</div>
                        </div>
                        <div class="item-price">$${(item.price * item.quantity).toFixed(2)}</div>
                        <button class="remove-item" data-id="${item.id}">Ã—</button>
                    </div>
                `).join('');

                // Add event listeners to remove buttons
                cartItemsContainer.querySelectorAll('.remove-item').forEach(button => {
                    button.addEventListener('click', (e) => {
                        const itemId = parseInt(e.target.getAttribute('data-id'));
                        removeItem(itemId);
                    });
                });
            }

            // Update cart total
            function updateCartTotal() {
                const total = items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
                if (cartTotalElement) {
                    cartTotalElement.textContent = `$${total.toFixed(2)}`;
                }
            }

            // Animate cart icon
            function animateCartIcon() {
                if (cartIcon) {
                    cartIcon.style.transform = 'scale(1.2)';
                    setTimeout(() => {
                        cartIcon.style.transform = 'scale(1)';
                    }, 300);
                }
            }

            // Show add to cart notification
            function showAddToCartNotification(itemName) {
                Swal.fire({
                    title: 'Added to Cart!',
                    text: `${itemName} has been added to your cart.`,
                    icon: 'success',
                    timer: 2000,
                    timerProgressBar: true,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            }

            // Open cart drawer
            function openCart() {
                if (cartDrawer) {
                    cartDrawer.classList.add('open');
                    ScrollLock.lock();
                }
            }

            // Close cart drawer
            function closeCart() {
                if (cartDrawer) {
                    cartDrawer.classList.remove('open');
                    ScrollLock.unlock();
                }
            }

            // Checkout - create bill and open PaymentSummary
            async function checkout() {
                if (items.length === 0) {
                    Swal.fire({
                        title: 'Empty Cart',
                        text: 'Your cart is empty. Add some items before checking out.',
                        icon: 'info',
                        confirmButtonColor: '#4a6cf7'
                    });
                    return;
                }

                const featureIds = items.map(i => i.id).filter(id => id != null);
                if (featureIds.length === 0) {
                    Swal.fire({ title: 'Cart Error', text: 'No features to checkout.', icon: 'error' });
                    return;
                }

                try {
                    if (typeof Swal !== 'undefined') Swal.fire({ title: 'Creating bill...', didOpen: () => Swal.showLoading(), allowOutsideClick: false, allowEscapeKey: false, showConfirmButton: false });
                    if (window.CartManager && typeof window.CartManager.createBillFromFeatures === 'function') {
                        const billId = await window.CartManager.createBillFromFeatures(featureIds);
                        if (typeof Swal !== 'undefined') Swal.close();
                        window.location.href = `/Payments/PaymentSummary?billId=${billId}`;
                    } else {
                        if (typeof Swal !== 'undefined') Swal.close();
                        window.location.href = `/Payments/PaymentSummaryFromFeatures?featureIds=${featureIds.join(',')}`;
                    }
                } catch (err) {
                    if (typeof Swal !== 'undefined') Swal.close();
                    Swal.fire({ title: 'Checkout Failed', text: err.message || 'Please try again later.', icon: 'error' });
                }
            }

            // Public API
            return {
                init,
                addItem,
                getItems: () => [...items]
            };
        })();

        // Premium Feature Gating functionality
        const PremiumFeatures = (() => {
            // Simulated user plan (in a real app, this would come from the server)
            let userPlan = 'basic'; // 'basic', 'professional', 'enterprise'
            
            // Define which features are available in which plans
            const featurePlans = {
                'aiCoverDesign': ['professional', 'enterprise'],
                'audioBookCreation': ['enterprise'],
                'advancedAnalytics': ['professional', 'enterprise'],
                'prioritySupport': ['professional', 'enterprise'],
                'whiteLabelOptions': ['enterprise'],
                'customIntegrations': ['enterprise']
            };
            
            // Check if user has access to a feature
            function hasAccess(feature) {
                if (!featurePlans[feature]) return true; // If not defined, assume it's free
                return featurePlans[feature].includes(userPlan);
            }
            
            // Request access to a premium feature
            function requestAccess(feature, featureName) {
                if (hasAccess(feature)) {
                    return Promise.resolve(true);
                }
                
                return new Promise((resolve) => {
                    Swal.fire({
                        title: 'Premium Feature',
                        text: `${featureName} is a premium feature only available in Professional and Enterprise plans. Add to cart to unlock!`,
                        icon: 'info',
                        showCancelButton: true,
                        confirmButtonColor: '#4a6cf7',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Add to Cart',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Add to cart
                            Cart.addItem({
                                id: Date.now(),
                                name: featureName,
                                type: 'Premium Feature',
                                price: 9.99
                            });
                            resolve(false); // Not immediately accessible
                        } else {
                            resolve(false);
                        }
                    });
                });
            }
            
            // Public API
            return {
                hasAccess,
                requestAccess
            };
        })();

