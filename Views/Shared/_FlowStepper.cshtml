@model int
@* Flow stepper — 1 AI Book Writer, 2 Book Formatting, 3 Cover Design, 4 Publish. *@
@{
    var current = Model < 1 ? 1 : (Model > 4 ? 4 : Model);
    var steps = new[] { "AI Book Writer", "Book Formatting", "Cover Design", "Publish" };
}
<style>
    .ai-flow-stepper {
        display: flex;
        align-items: flex-start;
        width: 100%;
        max-width: 100%;
        background: #fff;
        border: 1px solid #ede9fe;
        border-radius: 14px;
        padding: 14px 14px 12px;
        box-shadow: 0 4px 14px -8px rgba(91, 33, 182, 0.18);
    }
    .ai-flow-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        flex: 0 0 auto;
        min-width: 52px;
    }
    .ai-flow-dot {
        width: 28px;
        height: 28px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        background: #f1f5f9;
        color: #94a3b8;
        border: 2px solid #e2e8f0;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }
    .ai-flow-step.is-current .ai-flow-dot {
        background: #7c3aed;
        border-color: #7c3aed;
        color: #fff;
        box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.18);
    }
    .ai-flow-step.is-done .ai-flow-dot {
        background: #ede9fe;
        border-color: #c4b5fd;
        color: #6d28d9;
    }
    .ai-flow-label {
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        color: #94a3b8;
        text-align: center;
        line-height: 1.2;
        max-width: 4.8rem;
    }
    .ai-flow-step.is-current .ai-flow-label { color: #5b21b6; }
    .ai-flow-step.is-done .ai-flow-label { color: #7c3aed; }
    .ai-flow-line {
        flex: 1 1 auto;
        height: 3px;
        border-radius: 999px;
        background: #e2e8f0;
        margin-top: 13px;
        min-width: 10px;
    }
    .ai-flow-line.is-done { background: linear-gradient(90deg, #7c3aed 0%, #c4b5fd 100%); }
    @@media (min-width: 640px) {
        .ai-flow-stepper { padding: 14px 18px 12px; max-width: 720px; }
        .ai-flow-step { min-width: 64px; }
        .ai-flow-dot { width: 30px; height: 30px; font-size: 0.8rem; }
        .ai-flow-label { font-size: 0.66rem; max-width: 5.4rem; }
    }
</style>
<div data-guided-tour="ai-flow-steps">
    <div class="ai-flow-stepper" role="list" aria-label="Book creation steps">
        @for (var i = 1; i <= steps.Length; i++)
        {
            if (i > 1)
            {
                <span class="ai-flow-line @(i <= current ? "is-done" : "")" aria-hidden="true"></span>
            }
            var cls = i == current ? "is-current" : (i < current ? "is-done" : "");
            <div class="ai-flow-step @cls" role="listitem" @(i == current ? Html.Raw("aria-current=\"step\"") : Html.Raw(""))>
                <span class="ai-flow-dot">@(i < current ? Html.Raw("&#10003;") : Html.Raw(i.ToString()))</span>
                <span class="ai-flow-label">@steps[i - 1]</span>
            </div>
        }
    </div>
</div>
