@* Lifetime AI cover quota badge + upgrade card. Wired by wwwroot/js/ai-cover-limit.js *@
<div class="ai-cover-quota" id="aiCoverQuotaWrap" hidden>
    <span class="ai-cover-quota__badge is-green" id="aiCoverQuotaBadge" aria-live="polite">5 of 5 free uses remaining</span>
    <div class="ai-cover-upgrade" id="aiCoverUpgradeCard" hidden>
        <p class="ai-cover-upgrade__title">You've used all 5 free generations</p>
        <p class="ai-cover-upgrade__body">Upgrade to Pro for unlimited covers, or upload your own image for $10.</p>
        <div class="ai-cover-upgrade__actions">
            <a class="ai-cover-upgrade__btn ai-cover-upgrade__btn--primary" href="/pricing">Upgrade Now</a>
            <button type="button" class="ai-cover-upgrade__btn" id="aiCoverUploadOwnBtn">Upload Own Image</button>
        </div>
    </div>
</div>
