<div id="coverPreviewRoot" class="cover-preview-root">
    <div class="cover-preview-container">
        <div class="cover-panel cover-panel-back" id="panelBack">
            <div class="cover-panel-inner">
                <div class="cover-bleed-zone">
                    <div class="cover-safe-area">
                        <div class="back-content">
                            <p class="back-description" id="backDescription">Your book description will appear here. Add a compelling back-cover blurb to attract readers.</p>
                        </div>
                        <div class="barcode-box">
                            <div class="barcode-lines"></div>
                            <span class="barcode-isbn">ISBN 000-0-000-00000-0</span>
                            <span class="barcode-size">2.000" × 1.200"<br>(50.80mm × 30.48mm)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="cover-panel cover-panel-spine" id="panelSpine">
            <div class="spine-text" id="spineText">MY BOOK</div>
        </div>

        <div class="cover-panel cover-panel-front" id="panelFront">
            <div class="cover-panel-inner">
                <div class="cover-bleed-zone">
                    <div class="cover-safe-area">
                        <div class="front-content">
                            <h2 class="front-title" id="frontTitle">My Book</h2>
                            <p class="front-author" id="frontAuthor">Author Name</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="cover-labels">
        <div class="cover-label" id="labelBack">Back Cover &nbsp;6" × 9"<br><span class="label-mm">(152.40mm × 228.60mm)</span></div>
        <div class="cover-label cover-label-spine" id="labelSpine">Spine<br><span id="labelSpineValue">0.338" (8.59mm)</span></div>
        <div class="cover-label" id="labelFront">Front Cover &nbsp;6" × 9"<br><span class="label-mm">(152.40mm × 228.60mm)</span></div>
    </div>
</div>
