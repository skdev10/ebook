@{
    ViewData["Title"] = "Forgot Password - eBook Publisher";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { font-family: 'Outfit', sans-serif; }
        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus,
        input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 30px #f1f5f9 inset !important;
            -webkit-text-fill-color: #374151 !important;
            transition: background-color 5000s ease-in-out 0s;
        }
    </style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-[#f5f7f9] min-h-screen flex items-center justify-center p-4 sm:p-8 relative overflow-hidden antialiased text-gray-800">

    <div class="absolute top-[-15%] left-[-10%] w-[50vw] h-[50vw] bg-[#7c3aed]/10 rounded-full mix-blend-multiply filter blur-3xl opacity-60 pointer-events-none"></div>
    <div class="absolute bottom-[-15%] right-[-10%] w-[50vw] h-[50vw] bg-[#4a6cf7]/10 rounded-full mix-blend-multiply filter blur-3xl opacity-60 pointer-events-none"></div>

    <div class="bg-white rounded-[2rem] shadow-[0_20px_60px_-15px_rgba(0,0,0,0.05)] w-full max-w-[1050px] min-h-[620px] flex relative z-10 overflow-hidden border border-white/50">
        <div class="hidden md:flex relative w-[45%] lg:w-[50%] bg-[#f5f7f9] flex-shrink-0 items-center justify-center p-10 lg:p-14 overflow-hidden border-r border-gray-100">
            <div class="relative w-full max-w-[340px] lg:max-w-sm aspect-square mx-auto">
                <div class="absolute inset-0 rounded-full border-[6px] border-[#7c3aed] -translate-x-4 translate-y-4 opacity-20"></div>
                <div class="absolute inset-0 rounded-full border-[6px] border-[#7c3aed] translate-x-2 -translate-y-2 opacity-50"></div>
                <div class="absolute inset-0 rounded-full overflow-hidden bg-white shadow-2xl border-4 border-white z-10">
                    <img src="~/images/login-premium-v2.jpg" asp-append-version="true" alt="Reset your eBook Publisher password" class="w-full h-full object-cover object-center scale-105">
                </div>
                <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-[#7c3aed]/20 rounded-full blur-xl z-0"></div>
            </div>
        </div>

        <div class="w-full md:w-[55%] lg:w-[50%] p-10 sm:p-14 lg:p-24 flex flex-col justify-center items-center bg-white relative z-40 shadow-[-30px_0_40px_-20px_rgba(255,255,255,1)]">
            <div class="w-full max-w-[360px]">
                <h1 class="text-3xl font-semibold tracking-tight text-gray-900 mb-2 text-center">Forgot Password</h1>
                <p class="text-sm text-gray-500 text-center mb-8 leading-relaxed">
                    Enter your email address and we will send you a secure password reset link.
                </p>

                @if (!string.IsNullOrEmpty(ViewBag.Success as string))
                {
                    <div class="w-full mb-4 p-3.5 rounded-xl bg-green-50 text-green-700 text-sm font-medium border border-green-100">
                        <i class="fas fa-check-circle mr-2"></i>@ViewBag.Success
                    </div>
                }

                @if (!string.IsNullOrEmpty(ViewBag.Error as string))
                {
                    <div class="w-full mb-4 p-3.5 rounded-xl bg-red-50 text-red-700 text-sm font-medium border border-red-100">
                        <i class="fas fa-exclamation-circle mr-2"></i>@ViewBag.Error
                    </div>
                }

                <form method="post" action="/Account/ForgotPassword" id="forgotPasswordForm" class="w-full space-y-4">
                    @Html.AntiForgeryToken()
                    <div class="space-y-1.5">
                        <label for="UserEmail" class="text-sm font-medium text-gray-700">Email Address</label>
                        <div class="relative">
                            <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                            <input type="email"
                                   id="UserEmail"
                                   name="UserEmail"
                                   placeholder="Enter your email"
                                   class="w-full bg-[#f1f5f9] text-gray-700 text-sm rounded-full py-3.5 pl-11 pr-4 placeholder-gray-400 border border-transparent focus:border-gray-200 focus:bg-white focus:ring-4 focus:ring-gray-100 transition-all duration-200 outline-none"
                                   required />
                        </div>
                        <p id="emailValidationMessage" class="text-xs text-red-600 hidden">Please enter a valid email address.</p>
                    </div>

                    <div class="pt-2">
                        <button type="submit" id="btnSubmit" class="w-full bg-[#7c3aed] hover:bg-[#6d28d9] active:scale-[0.98] text-white text-sm font-semibold rounded-full py-3.5 px-6 transition-all duration-200 shadow-lg shadow-[#7c3aed]/25 flex justify-center items-center gap-2">
                            <i class="fas fa-paper-plane"></i>
                            <span id="btnSubmitText">Send Reset Link</span>
                        </button>
                    </div>
                </form>

                <div class="mt-5 text-center">
                    <a href="/Account/Login" class="inline-flex items-center gap-2 text-sm text-[#7c3aed] font-medium hover:underline">
                        <i class="fas fa-arrow-left"></i> Back to Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var form = document.getElementById('forgotPasswordForm');
            var emailInput = document.getElementById('UserEmail');
            var message = document.getElementById('emailValidationMessage');
            var submitBtn = document.getElementById('btnSubmit');
            var submitText = document.getElementById('btnSubmitText');

            function isValidEmail(value) {
                return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test((value || '').trim());
            }

            emailInput.addEventListener('input', function () {
                var valid = isValidEmail(emailInput.value);
                if (!emailInput.value.trim()) {
                    message.classList.add('hidden');
                    emailInput.classList.remove('ring-2', 'ring-red-100', 'border-red-200');
                    return;
                }
                if (valid) {
                    message.classList.add('hidden');
                    emailInput.classList.remove('ring-2', 'ring-red-100', 'border-red-200');
                } else {
                    message.classList.remove('hidden');
                    emailInput.classList.add('ring-2', 'ring-red-100', 'border-red-200');
                }
            });

            form.addEventListener('submit', function (e) {
                var email = emailInput.value.trim();
                if (!isValidEmail(email)) {
                    e.preventDefault();
                    message.classList.remove('hidden');
                    emailInput.focus();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Invalid Email',
                        text: 'Please enter a valid email address.',
                        confirmButtonColor: '#7c3aed'
                    });
                    return;
                }

                submitBtn.disabled = true;
                submitText.textContent = 'Sending...';
                submitBtn.classList.add('opacity-80');
                Swal.fire({
                    title: 'Sending Reset Link',
                    text: 'Please wait while we process your request...',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    didOpen: function () { Swal.showLoading(); }
                });
            });
        })();
    </script>
</body>
</html>
