@{
    ViewData["Title"] = "Complete your profile";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600&display=swap" rel="stylesheet" />
    <style>body { font-family: 'Inter', sans-serif; }</style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-[#f5f7f9] flex items-center justify-center p-6">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-[#7c3aed]/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-32 -right-24 w-[28rem] h-[28rem] bg-[#6366f1]/10 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 w-full max-w-lg bg-white rounded-[2rem] shadow-[0_24px_60px_-20px_rgba(79,70,229,0.25)] border border-slate-100 p-8 sm:p-10">
        <div class="flex items-center gap-2 mb-6">
            <div class="flex gap-1">
                <span class="h-2 w-8 rounded-full bg-[#7c3aed]"></span>
                <span class="h-2 w-8 rounded-full bg-[#7c3aed]/30"></span>
                <span class="h-2 w-8 rounded-full bg-[#7c3aed]/30"></span>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-[#7c3aed]">Step 1 of 1</span>
        </div>
        <h1 class="font-['Playfair_Display'] text-3xl text-slate-900 font-semibold tracking-tight mb-2">Almost there</h1>
        <p class="text-slate-500 text-sm mb-8 leading-relaxed">Tell us a bit about your publishing goals. Next you'll land on the Dashboard to create your first book and open AI Writer.</p>

        <form method="post" asp-action="OnboardingProfile" asp-controller="Account" class="space-y-5">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-sm font-medium text-slate-600 mb-1.5">Publisher / pen name <span class="text-slate-400 font-normal">(optional)</span></label>
                <input name="publisherName" type="text" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/25 focus:border-[#7c3aed]" placeholder="How readers will see you" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-600 mb-1.5">Primary genre</label>
                <select name="genre" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/25 focus:border-[#7c3aed]">
                    <option>Fiction</option>
                    <option>Non-fiction</option>
                    <option>Children</option>
                    <option>Business</option>
                    <option>Memoir</option>
                    <option>Other</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-600 mb-1.5">Main goal</label>
                <select name="publishingGoal" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/25 focus:border-[#7c3aed]">
                    <option>Publish ebook first</option>
                    <option>Publish print</option>
                    <option>Both</option>
                    <option>Still exploring</option>
                </select>
            </div>
            <button type="submit" class="w-full mt-2 rounded-xl bg-[#7c3aed] hover:bg-[#6d28d9] text-white font-semibold py-3.5 text-sm shadow-lg shadow-[#7c3aed]/25 transition-colors">
                Continue to publishing workspace <i class="fas fa-arrow-right ml-2"></i>
            </button>
        </form>
    </div>
    <partial name="_MobileBlockOverlay" />
</body>
</html>
