@{
    ViewData["Title"] = "Select Features - eBook Publisher";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
<style>
    .features-selection-page { max-width: 1100px; margin: 0 auto; padding: 20px; }
    .features-selection-page h1 { color: #1e293b; margin-bottom: 8px; }
    .features-selection-page .subtitle { color: #64748b; margin-bottom: 24px; }
    .features-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .feature-card { border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; background: #fff; transition: all 0.2s; }
    .feature-card:hover { border-color: #4a6cf7; box-shadow: 0 4px 12px rgba(74,108,247,0.15); }
    .feature-card.in-cart { background: #f1f5f9; border-color: #e2e8f0; }
    .feature-card.in-cart h5, .feature-card.in-cart .feature-price, .feature-card.in-cart p { color: #94a3b8; }
    .feature-row { display: flex; align-items: center; gap: 12px; flex-wrap: nowrap; }
    .feature-row .feature-checkbox { flex-shrink: 0; margin: 0; }
    .feature-row .feature-label { flex: 1; min-width: 0; cursor: pointer; }
    .feature-card h5 { color: #4a6cf7; margin: 0 0 8px 0; font-size: 1rem; }
    .feature-price { font-size: 1.25rem; font-weight: 700; color: #16a34a; margin: 8px 0; }
    .feature-card p { margin: 0; color: #64748b; font-size: 0.875rem; }
    .add-cart-section { margin-top: 16px; }
    #addToCartBtn.btn-success { background: #22c55e !important; color: white !important; }
    #addToCartBtn.btn-success:hover { background: #16a34a !important; color: white !important; }
</style>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<input type="hidden" id="UserId" value="@(ViewBag.UserId ?? 0)" />
<div class="features-selection-page">
    <h1><i class="fas fa-star"></i> Select Your Features</h1>
    <p class="subtitle">Choose the features you want and add them to your cart. Proceed to checkout when ready.</p>

    <div class="mb-3 d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="selectAllBtn">Select All</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="deselectAllBtn">Deselect All</button>
        <strong class="align-self-center ms-2">Selected: <span id="selectedCount">0</span> features</strong>
    </div>

    <div id="featuresGrid" class="features-grid">
        <div class="text-muted">Loading features...</div>
    </div>

    <div id="addToCartSection" class="add-cart-section" style="display: none;">
        <div class="d-flex justify-content-end">
            <button type="button" class="btn btn-success" id="addToCartBtn">
                <i class="fas fa-shopping-cart"></i> Add Selected to Cart
            </button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
(function() {
    let featuresData = [];
    let selectedIds = [];   // checked in grid (temporary selection)
    let cartIds = [];       // items in cart (added via "Add Selected to Cart" button)

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function loadCartFromServer() {
        return fetch('/Features/CartPreview')
            .then(r => r.json())
            .then(data => {
                if (data.success && Array.isArray(data.items)) {
                    cartIds = data.items.map(i => String(i.id));
                }
            })
            .catch(() => {});
    }

    function notifyCartUpdated() {
        document.dispatchEvent(new CustomEvent('cartServerUpdated'));
    }

    function loadFeatures() {
        Promise.all([
            fetch('/Plans/GetPlanFeatures').then(r => r.json()),
            loadCartFromServer()
        ]).then(([features]) => {
            featuresData = features;
            renderFeatures();
            updateSelection();
        }).catch(err => {
            console.error(err);
            document.getElementById('featuresGrid').innerHTML = '<div class="alert alert-danger">Failed to load features.</div>';
        });
    }
            // function renderFeatures() {
            //     const grid = document.getElementById('featuresGrid');
            //     grid.innerHTML = featuresData.map(f => {
            //         const inCart = cartIds.includes(String(f.featureId));
            //         return `
            //         <div class="feature-card ${inCart ? 'in-cart' : ''}">
            //             <div class="feature-row">
            //                 <input type="checkbox" class="feature-checkbox form-check-input" value="${f.featureId}" id="f_${f.featureId}" ${inCart ? 'checked disabled' : ''}>
            //                 <label class="feature-label" for="f_${f.featureId}">
            //                     <h5>${f.featureName}</h5>
            //                     <div class="feature-price">$${f.featureRate}</div>
            //                     <p>${f.description || 'No description'}</p>
            //                 </label>
            //             </div>
            //         </div>
            //     `;
            //     }).join('');
    function renderFeatures() {
        const grid = document.getElementById('featuresGrid');
        grid.innerHTML = featuresData.map(f => {
            const inCart = cartIds.includes(String(f.featureId));
            return `
            <div class="feature-card ${inCart ? 'in-cart' : ''}">
                <div class="feature-row">
                    <input type="checkbox" class="feature-checkbox form-check-input" value="${f.featureId}" id="f_${f.featureId}" >
                    <label class="feature-label" for="f_${f.featureId}">
                        <h5>${f.featureName}</h5>
                        <div class="feature-price">$${f.featureRate}</div>
                        <p>${f.description || 'No description'}</p>
                    </label>
                </div>
            </div>
        `;
        }).join('');

        document.querySelectorAll('.feature-checkbox').forEach(cb => {
            cb.addEventListener('change', updateSelection);
        });
        updateSelection();
    }

    function updateSelection() {
        selectedIds = Array.from(document.querySelectorAll('.feature-checkbox:checked')).map(cb => cb.value);
        document.getElementById('selectedCount').textContent = selectedIds.length;

        // Show "Add Selected to Cart" button only when there are selected items
        const addSection = document.getElementById('addToCartSection');
        if (addSection) addSection.style.display = selectedIds.length > 0 ? 'block' : 'none';

        // Sync with layout's CartManager (use cart items, not selection)
        if (typeof CartManager !== 'undefined') {
            const items = cartIds.map(id => {
                const f = featuresData.find(x => x.featureId == id);
                if (!f) return null;
                return { id: f.featureId, name: f.featureName, type: 'feature', price: parseFloat(f.featureRate) || 0 };
            }).filter(Boolean);
            CartManager.setCart({ items });
        }
    }

    async function addToCart() {
        if (selectedIds.length === 0) {
            Swal.fire('Info', 'Please select at least one feature.', 'info');
            return;
        }
        const token = getAntiForgeryToken();
        const toAdd = selectedIds.filter(id => !cartIds.includes(id));
        if (toAdd.length === 0) {
            document.querySelectorAll('.feature-checkbox:checked').forEach(cb => { cb.checked = false; });
            selectedIds = [];
            updateSelection();
            Swal.fire('Info', 'Selected features are already in the cart.', 'info');
            return;
        }
        try {
            for (const id of toAdd) {
                const res = await fetch('/Features/AddToCart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ featureId: parseInt(id, 10) })
                });
                const data = await res.json().catch(() => ({}));
                if (!data.success) throw new Error(data.message || 'Failed to add feature');
            }
            cartIds = cartIds.concat(toAdd);
            document.querySelectorAll('.feature-checkbox:checked').forEach(cb => { cb.checked = false; });
            selectedIds = [];
            updateSelection();
            renderFeatures();
            notifyCartUpdated();
            Swal.fire('Added!', 'Selected features added to cart.', 'success');
        } catch (err) {
            Swal.fire('Error', err.message || 'Failed to add to cart.', 'error');
        }
    }

    function getUserId() {
        const el = document.getElementById('UserId') || document.getElementById('userId');
        if (el && el.value) return parseInt(el.value);
        const ls = localStorage.getItem('UserId') || localStorage.getItem('userId');
        if (ls) return parseInt(ls);
        return null;
    }

    document.getElementById('selectAllBtn').addEventListener('click', () => {
        document.querySelectorAll('.feature-checkbox:not([disabled])').forEach(cb => cb.checked = true);
        updateSelection();
    });
    document.getElementById('deselectAllBtn').addEventListener('click', () => {
        document.querySelectorAll('.feature-checkbox').forEach(cb => cb.checked = false);
        updateSelection();
    });
    document.getElementById('addToCartBtn').addEventListener('click', addToCart);

    // When cart is updated elsewhere (e.g. Remove in floating cart), refresh from server so features become enabled again
    document.addEventListener('cartServerUpdated', function() {
        loadCartFromServer().then(function() {
            renderFeatures();
            updateSelection();
        });
    });

    document.addEventListener('DOMContentLoaded', loadFeatures);
})();
</script>
}
