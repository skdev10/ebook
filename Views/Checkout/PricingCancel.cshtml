@{
    ViewData["Title"] = "Checkout cancelled";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var bookId = ViewBag.BookId as int? ?? 0;
}
<div class="pricing-success" style="text-align:left;">
    <h1 style="margin:0 0 8px;">Checkout cancelled</h1>
    <p>Nothing was charged. You can keep writing and export when you are ready.</p>
    @if (bookId > 0)
    {
        <a class="pay-btn" href="/checkout/@bookId" style="margin-top:12px;">Return to the bill</a>
        <a class="ghost-btn" href="/Books/Writer?bookId=@bookId">Keep writing</a>
    }
    else
    {
        <a class="pay-btn" href="/pricing" style="margin-top:12px;">See pricing</a>
    }
</div>
