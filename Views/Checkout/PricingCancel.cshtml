@{
    ViewData["Title"] = "Checkout cancelled";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var bookId = ViewBag.BookId as int? ?? 0;
}
<div style="max-width:640px;margin:48px auto;padding:24px;background:#fff;border:1px solid #E5E5E5;border-radius:20px;">
    <h1 style="margin:0 0 8px;">Checkout cancelled</h1>
    <p>Nothing was charged. You can keep writing and export when you are ready.</p>
    @if (bookId > 0)
    {
        <a href="/checkout/@bookId">Return to the bill</a>
    }
</div>
