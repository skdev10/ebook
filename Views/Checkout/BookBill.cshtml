@model EBookDashboard.Interfaces.ExportAccessResult
@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var quote = Model?.Quote ?? new EBookDashboard.Models.PriceQuote();
    var title = ViewBag.BookTitle as string ?? "this book";
    var paperback = ViewBag.Paperback as bool? ?? false;
    var freeAllowance = ViewBag.FreeAllowance as int? ?? quote.FreeAllowance;
    var checkoutError = ViewBag.CheckoutError as string;
    var total = quote.Total;
    var dueLines = quote.Lines?.Where(l => !l.AlreadyOwned && l.LineTotal > 0).ToList() ?? new List<EBookDashboard.Models.QuoteLine>();
}
<div class="bill-page invoice-page">
    <header class="invoice-hero">
        <div>
            <p class="invoice-kicker">Secure checkout</p>
            <h1>Itemized order</h1>
            <p class="invoice-lead">Pay once for what you used. First @(freeAllowance > 0 ? freeAllowance : 20) writing pages stay free. Re-downloads after payment are always free.</p>
        </div>
    </header>

    <div class="invoice-usage" aria-label="Page usage">
        <div><strong>@quote.PageCount</strong><span>Total pages</span></div>
        <div><strong>@Math.Min(quote.PageCount, quote.FreeAllowance)</strong><span>Free pages</span></div>
        <div><strong>@quote.PaidPages</strong><span>Paid pages</span></div>
        <div><strong>$@total.ToString("0.00")</strong><span>Due now</span></div>
    </div>

    <div class="invoice-shell">
        <div class="bill-card invoice-card">
            <div class="invoice-card-head">
                <div>
                    <div class="invoice-label">Invoice for</div>
                    <h2>@title</h2>
                </div>
                <div class="invoice-badge">USD</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(checkoutError))
            {
                <div class="pricing-error" role="alert">@checkoutError Refresh this page. If it continues, open Support.</div>
            }
            else if (quote.Lines == null || !quote.Lines.Any())
            {
                <div class="pricing-empty">No billable lines yet. Keep writing, or export a free ebook from Publish.</div>
            }
            else
            {
                <div class="invoice-table" role="table">
                    <div class="invoice-row invoice-row--head" role="row">
                        <span>Service</span>
                        <span class="invoice-col-num invoice-col-qty">Qty</span>
                        <span class="invoice-col-num invoice-col-unit">Unit</span>
                        <span class="invoice-col-num">Amount</span>
                    </div>
                    @{ var i = 0; }
                    @foreach (var line in quote.Lines)
                    {
                        <div class="invoice-row bill-line @(line.AlreadyOwned ? "owned" : "") @(line.LineTotal <= 0 ? "is-free" : "")" data-stagger="@i" role="row">
                            <div>
                                <div class="bill-line-main">@line.Description</div>
                                @if (!string.IsNullOrWhiteSpace(line.Breakdown))
                                {
                                    <div class="bill-line-arith">@line.Breakdown</div>
                                }
                            </div>
                            <span class="pricing-money invoice-col-num invoice-col-qty">@line.Quantity</span>
                            <span class="pricing-money invoice-col-num invoice-col-unit">$@line.UnitAmount.ToString("0.00")</span>
                            <span class="bill-line-amt pricing-money invoice-col-num">@(line.AlreadyOwned || line.LineTotal <= 0 ? "Free" : "$" + line.LineTotal.ToString("0.00"))</span>
                        </div>
                        i++;
                    }
                </div>
            }
            <fieldset class="invoice-addons">
                <legend>Optional print package</legend>
                <label class="invoice-addon-row" for="billPaperback">
                    <input type="checkbox" id="billPaperback" @(paperback ? "checked" : "") />
                    <span>
                        <span class="bill-line-main">Paperback</span>
                        <span class="bill-line-arith">Amazon print-ready wrap + interior PDF</span>
                    </span>
                    <strong class="pricing-money">$20</strong>
                </label>
                <p>Add only if you need print files. Writing, custom cover, and premium formatting already on this book stay on the bill.</p>
            </fieldset>
        </div>

        <aside class="bill-card invoice-pay">
            <div class="invoice-label">Amount due</div>
            <div class="bill-total" id="billTotal" data-value="0">$@total.ToString("0.00")</div>
            <p class="invoice-due-note" id="billDueNote">
                @(dueLines.Count > 0 ? dueLines.Count + " paid line" + (dueLines.Count == 1 ? "" : "s") : "Nothing to pay — export is unlocked")
            </p>
            <div class="pay-error" id="payError" role="alert"></div>
            <div class="invoice-pay-actions">
                @if (string.IsNullOrWhiteSpace(checkoutError))
                {
                    <button type="button" class="pay-btn @(total > 0 ? "" : "hidden")" id="payBtn">Pay $@total.ToString("0.00") with Stripe</button>
                    <a class="pay-btn @(total > 0 ? "hidden" : "")" id="freeContinue" href="/Dashboard/Publish?bookId=@Model.BookId">Continue — $0.00</a>
                }
                else
                {
                    <button type="button" class="pay-btn" disabled>Pay unavailable</button>
                }
                @if (freeAllowance > 0)
                {
                    <a class="ghost-btn" href="/Books/AIGenerateBook?bookId=@Model.BookId">Keep writing — first @freeAllowance pages free</a>
                }
                else
                {
                    <a class="ghost-btn" href="/Books/AIGenerateBook?bookId=@Model.BookId">Keep writing</a>
                }
            </div>
            <ul class="invoice-trust">
                <li>Price is calculated on the server</li>
                <li>Stripe processes the card — we never store numbers</li>
                <li>Paid features stay unlocked on this book</li>
            </ul>
        </aside>
    </div>
</div>
<script>
(function () {
    var bookId = @Model.BookId;
    var UI = window.PricingUI;
    var lines = document.querySelectorAll(".bill-line");
    if (UI) UI.staggerIn(lines, 40, 8);
    else lines.forEach(function (el) { el.classList.add("is-in"); });
    var totalEl = document.getElementById("billTotal");
    if (UI && totalEl) UI.countTo(totalEl, @total.ToString(System.Globalization.CultureInfo.InvariantCulture), 220);

    var pb = document.getElementById("billPaperback");
    function flags() {
        return { paperback: !!(pb && pb.checked), hardcover: false };
    }
    function money(n) { return (window.PricingUI ? window.PricingUI.money(n) : ("$" + Number(n).toFixed(2))); }

    function applyQuote(d) {
        if (!d || !d.success) return;
        var usage = document.querySelectorAll(".invoice-usage strong");
        if (usage[0]) usage[0].textContent = String(d.pageCount || 0);
        if (usage[1]) usage[1].textContent = String(Math.min(d.pageCount || 0, d.freePages || 0));
        if (usage[2]) usage[2].textContent = String(d.paidPages || 0);
        if (usage[3]) usage[3].textContent = money(d.total || 0);
        if (totalEl && UI) UI.countTo(totalEl, d.total || 0, 220);
        else if (totalEl) totalEl.textContent = money(d.total || 0);
        var note = document.getElementById("billDueNote");
        var due = (d.lines || []).filter(function (l) { return !l.alreadyOwned && Number(l.lineTotal) > 0; }).length;
        if (note) note.textContent = due > 0 ? (due + " paid line" + (due === 1 ? "" : "s")) : "Nothing to pay — export is unlocked";
        var btn = document.getElementById("payBtn");
        var freeGo = document.getElementById("freeContinue");
        if (btn) {
            btn.textContent = "Pay " + money(d.total || 0) + " with Stripe";
            btn.classList.toggle("hidden", !(d.total > 0));
            btn.disabled = !(d.total > 0);
        }
        if (freeGo) freeGo.classList.toggle("hidden", d.total > 0);
        var table = document.querySelector(".invoice-table");
        if (table && d.lines) {
            var head = table.querySelector(".invoice-row--head");
            table.querySelectorAll(".invoice-row:not(.invoice-row--head)").forEach(function (el) { el.remove(); });
            d.lines.forEach(function (line) {
                var row = document.createElement("div");
                row.className = "invoice-row bill-line is-in" + (line.alreadyOwned ? " owned" : "") + (Number(line.lineTotal) <= 0 ? " is-free" : "");
                row.innerHTML = "<div><div class=\"bill-line-main\"></div><div class=\"bill-line-arith\"></div></div>"
                    + "<span class=\"pricing-money invoice-col-num invoice-col-qty\"></span>"
                    + "<span class=\"pricing-money invoice-col-num invoice-col-unit\"></span>"
                    + "<span class=\"bill-line-amt pricing-money invoice-col-num\"></span>";
                row.querySelector(".bill-line-main").textContent = line.description || "";
                row.querySelector(".bill-line-arith").textContent = line.breakdown || "";
                row.children[1].textContent = String(line.quantity || 0);
                row.children[2].textContent = money(line.unitAmount || 0);
                row.children[3].textContent = (line.alreadyOwned || Number(line.lineTotal) <= 0) ? "Free" : money(line.lineTotal);
                table.appendChild(row);
            });
        }
    }

    function refresh() {
        var f = flags();
        fetch("/pricing/quote/" + bookId + "?paperback=" + (f.paperback ? "true" : "false") + "&hardcover=" + (f.hardcover ? "true" : "false"), {
            credentials: "same-origin",
            headers: { "Accept": "application/json" }
        }).then(function (r) { return r.json(); }).then(applyQuote).catch(function () {});
    }
    if (pb) pb.addEventListener("change", refresh);

    var btn = document.getElementById("payBtn");
    if (!btn) return;
    var idleLabel = btn.textContent;
    var busy = false;
    function fail(msg) {
        busy = false;
        btn.disabled = false;
        btn.classList.remove("is-loading");
        btn.innerHTML = idleLabel;
        var err = document.getElementById("payError");
        if (err) err.textContent = msg || "Checkout did not start. Check your connection and try Pay again.";
    }
    btn.addEventListener("click", function () {
        if (busy || btn.disabled) return;
        busy = true;
        btn.disabled = true;
        btn.classList.add("is-loading");
        btn.innerHTML = '<span class="pay-spinner" aria-hidden="true"></span>Redirecting to Stripe';
        var err = document.getElementById("payError");
        if (err) err.textContent = "";
        var f = flags();
        fetch("/checkout/session", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({ bookId: bookId, paperback: f.paperback, hardcover: f.hardcover })
        }).then(function (r) {
            return r.json().then(function (d) { return { ok: r.ok, d: d }; });
        }).then(function (res) {
            var d = res.d || {};
            if (d.url) { window.location = d.url; return; }
            if (d.free) { window.location = d.downloadUrl || "/Dashboard/Publish?bookId=" + bookId; return; }
            fail(d.message || "Stripe did not return a checkout URL. Try again, or open Support.");
        }).catch(function () {
            fail("Network error starting checkout. Check your connection, then try Pay again.");
        });
    });
})();
</script>
