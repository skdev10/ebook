@model EBookDashboard.Interfaces.ExportAccessResult
@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var quote = Model.Quote;
    var title = ViewBag.BookTitle as string ?? "this book";
    var paperback = ViewBag.Paperback as bool? ?? false;
    var hardcover = ViewBag.Hardcover as bool? ?? false;
}
<style>
    .bill-page { max-width: 960px; margin: 0 auto; padding: 24px 16px 64px; display: grid; gap: 24px; }
    @@media (min-width: 900px) { .bill-page { grid-template-columns: 1.4fr 0.8fr; } }
    .bill-card { background:#fff; border:1px solid #E5E5E5; border-radius:20px; padding:24px; }
    .bill-line { display:flex; justify-content:space-between; gap:12px; padding:10px 0; border-bottom:1px solid #f3f4f6; font-variant-numeric: tabular-nums; font-family: ui-monospace, Menlo, Consolas, monospace; font-size:13px; }
    .bill-line.owned { text-decoration: line-through; color:#94a3b8; }
    .bill-total { font-family: ui-monospace, Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; font-size:28px; font-weight:800; color:#7c3aed; }
    .pay-btn { display:block; width:100%; background:linear-gradient(135deg,#7c3aed,#a78bfa); color:#fff; border:0; border-radius:12px; padding:14px 18px; font-weight:700; cursor:pointer; }
    .ghost-btn { display:block; width:100%; margin-top:10px; background:#fff; border:1px solid #e5e5e5; border-radius:12px; padding:12px; text-align:center; color:#374151; text-decoration:none; font-weight:600; }
</style>
<div class="bill-page">
    <div class="bill-card">
        <h1 style="margin:0 0 8px;font-size:22px;">Itemised bill for @title</h1>
        <p style="color:#6B6B6B;">One-time charge for this book. Re-downloading later is always free, including after you edit it.</p>
        @foreach (var line in quote.Lines)
        {
            <div class="bill-line @(line.AlreadyOwned ? "owned" : "")">
                <div>
                    <div>@line.Description</div>
                    <div style="font-size:11px;color:#94a3b8;">@line.Key</div>
                </div>
                <div>@line.LineTotal.ToString("0.00") @quote.Currency</div>
            </div>
        }
    </div>
    <div class="bill-card">
        <div style="font-size:12px;color:#64748b;text-transform:uppercase;letter-spacing:.06em;">Due now</div>
        <div class="bill-total">$@quote.Total.ToString("0.00")</div>
        @if (quote.Total > 0)
        {
            <button type="button" class="pay-btn" id="payBtn">Pay $@quote.Total.ToString("0.00") and download</button>
        }
        else
        {
            <a class="pay-btn" style="text-align:center;text-decoration:none;" href="/Dashboard/Publish?bookId=@Model.BookId">Download — $0.00</a>
        }
        <a class="ghost-btn" href="/Books/Writer?bookId=@Model.BookId">Download the free 20-page preview</a>
        <p style="font-size:12px;color:#6B6B6B;margin-top:14px;">One-time charge for this book. Re-downloading later is always free, including after you edit it.</p>
    </div>
</div>
<script>
document.getElementById('payBtn') && document.getElementById('payBtn').addEventListener('click', function () {
    var btn = this;
    btn.disabled = true;
    fetch('/checkout/session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ bookId: @Model.BookId, paperback: @(paperback ? "true" : "false"), hardcover: @(hardcover ? "true" : "false") })
    }).then(function (r) { return r.json(); }).then(function (d) {
        if (d.url) { window.location = d.url; return; }
        if (d.free) { window.location = '/Dashboard/Publish?bookId=@Model.BookId'; return; }
        alert(d.message || 'Could not start checkout');
        btn.disabled = false;
    }).catch(function () { btn.disabled = false; });
});
</script>
