@{
    ViewData["Title"] = "Download Your Book";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var bookId = ViewBag.BookId as int? ?? 0;
    var bookTitle = ViewBag.BookTitle as string ?? "Your Book";
}
<div class="min-h-full p-6 md:p-8 bg-[#f5f7f9]">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-2xl font-semibold text-slate-800 mb-2">Download Your Book</h1>
        <p class="text-slate-600 mb-8">@bookTitle</p>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
            <p class="text-slate-500 text-sm mb-6">Choose format to download. PDF, EPUB, and MOBI links appear here after generation.</p>
            <div class="flex flex-wrap gap-3">
                <a href="/Books/GenerateFormats" data-method="post" data-book-id="@bookId" data-format="pdf" class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-3 rounded-xl font-medium transition-colors">
                    <i class="fas fa-file-pdf text-red-500"></i> PDF
                </a>
                <a href="/Books/GenerateFormats" data-method="post" data-book-id="@bookId" data-format="epub" class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-3 rounded-xl font-medium transition-colors">
                    <i class="fas fa-book text-purple-500"></i> EPUB
                </a>
                <span class="inline-flex items-center gap-2 bg-slate-50 text-slate-400 px-5 py-3 rounded-xl font-medium cursor-not-allowed" title="Generate from Books page">
                    <i class="fas fa-book-open"></i> MOBI
                </span>
            </div>
            <p class="text-slate-400 text-xs mt-4">Use the Formatting and Cover Design steps to prepare your book, then generate PDF/EPUB from your book page.</p>
        </div>
        <a href="/Dashboard/MyBooks" class="inline-block mt-6 text-purple-600 hover:text-purple-800 font-medium">← Back to My Books</a>
    </div>
</div>
