@model EBookDashboard.Models.ViewModels.AIGenerateBookViewModel
@{
    ViewData["Title"] = "AI Book Writer";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var userId = ViewBag.UserId as int? ?? 0;
    var selectedBookId = ViewBag.SelectedBookId as int?;
    var selectedBookTitle = ViewBag.SelectedBookTitle as string ?? "Your book";
    var initialBookTitle = selectedBookTitle.Equals("Untitled", StringComparison.OrdinalIgnoreCase)
        || selectedBookTitle.Equals("Untitled Book", StringComparison.OrdinalIgnoreCase)
        ? "" : selectedBookTitle;
    var chapterGenFetchTimeoutMs = 3300000;
    if (ViewBag.ChapterGenerateFetchTimeoutMs is int tms) { chapterGenFetchTimeoutMs = tms; }
    else if (ViewBag.ChapterGenerateFetchTimeoutMs != null)
    {
        int parsedMs;
        if (int.TryParse(ViewBag.ChapterGenerateFetchTimeoutMs.ToString(), out parsedMs)) { chapterGenFetchTimeoutMs = parsedMs; }
    }
    var chapterGenEstimatedSeconds = 300;
    if (ViewBag.ChapterGenerateEstimatedSeconds is int tes) { chapterGenEstimatedSeconds = tes; }
    else if (ViewBag.ChapterGenerateEstimatedSeconds != null)
    {
        int parsedSec;
        if (int.TryParse(ViewBag.ChapterGenerateEstimatedSeconds.ToString(), out parsedSec)) { chapterGenEstimatedSeconds = parsedSec; }
    }
}
<script>
    window.__chapterGenFetchTimeoutMs = @chapterGenFetchTimeoutMs;
    window.__chapterGenEstimatedSeconds = @chapterGenEstimatedSeconds;
</script>
