    .book-stage { position: relative; }
    .book-nav-zone {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 28%;
        max-width: 140px;
        z-index: 5;
        cursor: pointer;
        border: none;
        background: transparent;
        padding: 0;
        transition: background 0.2s ease;
    }
    .book-nav-prev { left: 0; }
    .book-nav-next { right: 0; }
    .book-nav-zone:hover { background: rgba(124, 58, 237, 0.06); }
    .book-nav-zone:active { background: rgba(124, 58, 237, 0.1); }
    .book-nav-zone::after {
        content: '';
        position: absolute;
        top: 50%;
        width: 24px;
        height: 24px;
        margin-top: -12px;
        border: solid #78716c;
        border-width: 0 2px 2px 0;
        opacity: 0;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .book-nav-prev::after {
        left: 12px;
        transform: rotate(135deg);
    }
    .book-nav-next::after {
        right: 12px;
        left: auto;
        transform: rotate(-45deg);
    }
    .book-nav-zone:hover::after { opacity: 0.7; }
    .book-nav-zone:disabled { cursor: default; pointer-events: none; }
    .book-nav-zone:disabled::after { opacity: 0; }
    .ai-writer-total-pages {
