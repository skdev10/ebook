       // Helper: escape HTML to safely render user/AI content
        function escapeHtml(str) {
           if (str === undefined || str === null) return '';
              return String(str)
               .replace(/&/g, '&amp;')
               .replace(/</g, '&lt;')
               .replace(/>/g, '&gt;')
               .replace(/"/g, '&quot;')
               .replace(/'/g, '&#39;');
        }
       //===(5-20)=== Detect if content likely contains HTML markup == OK
       function isLikelyHtml(content) {
          if (!content) return false;
           return /<\s*\w+[\s\S]*?>/i.test(content);
       }
       //===(6-21)=== Minimal client-side sanitizer to allow basic formatting tags only ==OK
       function sanitizeHtml(unsafeHtml) {
          try {
                const allowedTags = new Set(['p','br','hr','ul','ol','li','strong','b','em','i','u','h1','h2','h3','h4','h5','h6','blockquote','code','pre','span','div']);
                const allowedAttrs = new Set(['class','style']);
                const parser = new DOMParser();
                const doc = parser.parseFromString(String(unsafeHtml), 'text/html');
                const walker = document.createTreeWalker(doc.body, NodeFilter.SHOW_ELEMENT, null);
                const toRemove = [];
                while (walker.nextNode()) {
                     const el = walker.currentNode;
                     if (!allowedTags.has(el.tagName.toLowerCase())) {
                          toRemove.push(el);
                          continue;
                     }
                     // Strip disallowed attributes and dangerous values
                     [...el.attributes].forEach(attr => {
                          const name = attr.name.toLowerCase();
                          const value = attr.value || '';
                           if (!allowedAttrs.has(name)) {
                                   el.removeAttribute(name);
                                   return;
                            }
                            if (name === 'style' && /expression\(|javascript:|url\(/i.test(value)) {
                                   el.removeAttribute('style');
                            }
                      });
                 }
                 toRemove.forEach(n => n.replaceWith(n.textContent || ''));
                 return doc.body.innerHTML;
          } catch (e) {
                 return escapeHtml(String(unsafeHtml));
          }
       }

       function normalizeManuscriptEscapes(str) {
           if (str === undefined || str === null) return '';
           var s = String(str);
           s = s.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
           var prev;
           do {
               prev = s;
               s = s.replace(/\\r\\n/g, '\n').replace(/\\n/g, '\n').replace(/\\r/g, '\n');
           } while (s !== prev);
           // Literal "\n" / "\t" two-char sequences sometimes survive JSON/API layers
           s = s.replace(/\\t/g, '\t');
           // Backslash before newline → newline only (stops a visible "\" before line breaks)
           s = s.replace(/\\\n/g, '\n').replace(/\\\r\n?/g, '\n');
           // Orphan "\" at end of a line (common copy/paste / LLM artifact)
           s = s.replace(/\\\s*$/gm, '');
           // Spurious escapes before markdown punctuation (e.g. "\*" "\#" show up in preview)
           s = s.replace(/\\([#*_`])/g, '$1');
           s = s.replace(/\\([\[\]().,!?:;])/g, '$1');
           // Collapse lines that are only "\" or whitespace + "\"
           s = s.replace(/^\s*\\\s*$/gm, '');
           return s;
       }

       function normPlaceholderKey(k) {
           return String(k || '').trim().toLowerCase().replace(/\s+/g, '');
       }

       function applyTemplatePlaceholders(raw, ctx) {
           if (raw == null) return '';
           var s = String(raw);
           if (!s || !ctx) return s;
           function lookup(key) {
               var nk = normPlaceholderKey(key);
               switch (nk) {
                   case 'title':
                   case 'booktitle':
                       return ctx.bookTitle != null ? String(ctx.bookTitle) : '';
                   case 'subtitle':
                       return ctx.subtitle != null ? String(ctx.subtitle) : '';
                   case 'description':
                       return ctx.description != null ? String(ctx.description) : '';
                   case 'genre':
                       return ctx.genre != null ? String(ctx.genre) : '';
                   case 'author':
                   case 'authorname':
                       return ctx.authorName != null ? String(ctx.authorName) : '';
                   case 'chaptertitle':
                   case 'chapter':
                       return ctx.chapterTitle != null ? String(ctx.chapterTitle) : '';
                   case 'chapternumber':
                   case 'chapterno':
                       return ctx.chapterNumber != null && ctx.chapterNumber !== '' ? String(ctx.chapterNumber) : '';
                   case 'displaychapternumber':
                       return ctx.displayChapterNumber != null && ctx.displayChapterNumber !== '' ? String(ctx.displayChapterNumber) : '';
                   default:
                       return null;
               }
           }
           s = s.replace(/\[\s*([^\]]+?)\s*\]/g, function(full, key) {
               var v = lookup(key);
               return v !== null ? v : full;
           });
           s = s.replace(/\{\{\s*([^}]+?)\s*\}\}/g, function(full, key) {
               var v = lookup(key);
               return v !== null ? v : full;
           });
           return s;
       }

       function formatManuscriptBodyToHtml(raw) {
           var s = normalizeManuscriptEscapes(raw);
           if (!s.trim()) return '<p class="text-slate-600">No content available.</p>';
           if (typeof isLikelyHtml === 'function' && isLikelyHtml(s)) {
               var htmlNorm = normalizeManuscriptEscapes(s);
               return typeof sanitizeHtml === 'function' ? sanitizeHtml(htmlNorm) : ('<p>' + escapeHtml(htmlNorm) + '</p>');
           }
           var lines = s.split('\n');
           var out = [];
           var para = [];
           function flushPara() {
               if (!para.length) return;
               out.push('<p class="manuscript-p">' + para.map(function (l) { return escapeHtml(l); }).join('<br/>') + '</p>');
               para = [];
           }
           for (var i = 0; i < lines.length; i++) {
               var line = lines[i];
               var t = line.trim();
               if (!t) { flushPara(); continue; }
               var hm = t.match(/^(#{1,6})\s+(.+)$/);
               if (hm) {
                   flushPara();
                   var level = hm[1].length;
                   out.push('<h' + level + ' class="manuscript-heading manuscript-h' + level + '">' + escapeHtml(hm[2].trim()) + '</h' + level + '>');
                   continue;
               }
               if (/^(?:\-{3,}|\*{3,}|_{3,})$/.test(t)) {
                   flushPara();
                   out.push('<hr class="manuscript-hr" />');
                   continue;
               }
               para.push(line);
           }
           flushPara();
           return out.length ? out.join('') : '<p class="text-slate-600">No content available.</p>';
       }

       window.escapeHtml = escapeHtml;
       window.normalizeManuscriptEscapes = normalizeManuscriptEscapes;
       window.formatManuscriptBodyToHtml = formatManuscriptBodyToHtml;
       window.applyTemplatePlaceholders = applyTemplatePlaceholders;

