@Html.AntiForgeryToken()

<script>
window.EBOOK_FORMATTER_BOOK_KEY = 'ebook_formatter_book_id';
window.persistFormatterBookId = function (bookId) {
    if (!bookId || bookId === '0') return;
    try { sessionStorage.setItem(window.EBOOK_FORMATTER_BOOK_KEY, String(bookId)); } catch (e) {}
};

/** JSON API fetch — sends auth-friendly headers so session expiry returns 401, not HTML login. */
window.apiJsonFetch = function (url, opts) {
    opts = opts || {};
    opts.credentials = opts.credentials || 'same-origin';
    var hdrs = Object.assign({}, opts.headers || {});
    if (!hdrs.Accept) hdrs.Accept = 'application/json';
    if (!hdrs['X-Requested-With']) hdrs['X-Requested-With'] = 'XMLHttpRequest';
    opts.headers = hdrs;
    return fetch(url, opts).then(function (res) {
        if (res.status === 401) {
            throw new Error('Session expired — please sign in again.');
        }
        return res;
    });
};

/** Multi-chapter preview + paginated viewport: #preview-content is fixed size; overflow becomes next "page". */
window._previewChaptersMeta = [];
window._previewChapterIndex = 0;
window._previewPageIndex = 0;
window._previewChapterPages = [];
window._chapterGenTimer = null;
window._chapterIndexFlyoutOpen = false;

window.aiReaderChapterStorageKey = function (bookId) {
    return 'ebook_ai_reader_chapter_' + String(bookId == null || bookId === '' ? '0' : bookId);
};
window.loadAiReaderChapterIndex = function (bookId) {
    try {
        var raw = localStorage.getItem(window.aiReaderChapterStorageKey(bookId));
        if (raw == null || raw === '') return null;
        var n = parseInt(raw, 10);
        return Number.isFinite(n) ? n : null;
    } catch (e) {
        return null;
    }
};
window.saveAiReaderChapterIndex = function (bookId, zeroBasedIndex) {
    try {
        localStorage.setItem(window.aiReaderChapterStorageKey(bookId), String(zeroBasedIndex));
    } catch (e) { /* storage full / private mode */ }
};

window.readerBookStateStorageKey = function (bookId) {
    return 'ebook_ai_reader_state_v2_' + String(bookId == null || bookId === '' ? '0' : bookId);
};
/** Persist chapter index + page-within-chapter for paginated reader. */
window.saveReaderBookState = function () {
    var bidEl = document.getElementById('BookId');
    if (!bidEl) return;
    var bid = bidEl.value;
    try {
        localStorage.setItem(window.readerBookStateStorageKey(bid), JSON.stringify({
            ch: window._previewChapterIndex || 0,
            pg: window._previewPageIndex || 0
        }));
        window.saveAiReaderChapterIndex(bid, window._previewChapterIndex || 0);
    } catch (e) { /* quota */ }
};
window.loadReaderBookState = function (bookId) {
    try {
        var raw = localStorage.getItem(window.readerBookStateStorageKey(bookId));
        if (raw) {
            var o = JSON.parse(raw);
            if (o && typeof o.ch === 'number') {
                return { ch: o.ch, pg: typeof o.pg === 'number' ? o.pg : 0 };
            }
        }
        var legacy = window.loadAiReaderChapterIndex(bookId);
        if (typeof legacy === 'number') return { ch: legacy, pg: 0 };
    } catch (e) { /* ignore */ }
    return null;
};

/** Keep hidden ChapterNo + ChapterDropdown aligned (used by generate + edit APIs). */
window.syncChapterNoDropdownAndHidden = function (chapterNum) {
    var n = parseInt(String(chapterNum), 10);
    if (!Number.isFinite(n) || n < 1) return;
    var s = String(n);
    var hidden = document.getElementById('ChapterNo');
    var ddl = document.getElementById('ChapterDropdown');
    if (hidden) hidden.value = s;
    if (ddl) {
        var found = false;
        for (var k = 0; k < ddl.options.length; k++) {
            if (ddl.options[k].value === s) { found = true; break; }
        }
        if (!found) {
            var opt = document.createElement('option');
            opt.value = s;
            opt.textContent = String(n);
            ddl.appendChild(opt);
        }
        ddl.value = s;
    }
};

/** Full chapter HTML for AI edit / save (not a single paginated slice). */
window.getWriterPreviewChapterHtmlForEdit = function () {
    var ci = window._previewChapterIndex || 0;
    var list = window._previewChaptersMeta || [];
    if (list.length && list[ci] && list[ci].html && String(list[ci].html).trim()) {
        return list[ci].html;
    }
    if (window._currentChapterContent && String(window._currentChapterContent).trim()) {
        return window._currentChapterContent;
    }
    var pe = document.getElementById('preview-content');
    return (pe && pe.innerHTML) ? pe.innerHTML : '';
};

/** Before opening edit modal or saving: align form fields + cache from current preview chapter. */
window.syncWriterChapterContextForEdit = function () {
    var html = typeof window.getWriterPreviewChapterHtmlForEdit === 'function' ? window.getWriterPreviewChapterHtmlForEdit() : '';
    if (html) window._currentChapterContent = html;
    var ci = window._previewChapterIndex || 0;
    var list = window._previewChaptersMeta || [];
    var ch = list[ci];
    if (!ch) return;
    var chNoSync = parseInt(ch && ch.chapterNo, 10);
    if (!Number.isFinite(chNoSync)) chNoSync = ci + 1;
    if (typeof window.syncChapterNoDropdownAndHidden === 'function') {
        window.syncChapterNoDropdownAndHidden(chNoSync);
    }
    var titEl = document.getElementById('Title');
    if (titEl && ch.title) {
        var ct = String(ch.title).replace(/^Chapter\s*\d+\s*[–\-:]\s*/i, '').trim();
        if (ct) titEl.value = ct;
    }
};

window._readerEscHtml = function (t) {
    if (typeof window.escapeHtml === 'function') return window.escapeHtml(t);
    return String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
};

/**
 * Split one HTML block (single element outerHTML) into multiple page wrappers when it exceeds maxH.
 * Uses binary search on words for p / headings; falls back to one clipped page if needed.
 */
window.splitOversizedHtmlSegment = function (segmentHtml, maxH, mh) {
    var tmp = document.createElement('div');
    tmp.innerHTML = segmentHtml;
    var el = tmp.firstElementChild;
    if (!el) return ['<div class="reader-chapter-block">' + segmentHtml + '</div>'];
    var text = (el.textContent || '').trim();
    var words = text.split(/\s+/).filter(Boolean);
    if (!words.length) return ['<div class="reader-chapter-block">' + segmentHtml + '</div>'];
    var tag = el.tagName.toLowerCase();
    var openTag;
    var closeTag;
    if (tag === 'p') {
        openTag = '<p class="manuscript-p">';
        closeTag = '</p>';
    } else if (/^h[1-6]$/.test(tag)) {
        var lvl = tag[1];
        openTag = '<' + tag + ' class="manuscript-heading manuscript-h' + lvl + '">';
        closeTag = '</' + tag + '>';
    } else {
        openTag = '<div class="manuscript-p">';
        closeTag = '</div>';
    }
    var esc = window._readerEscHtml;
    var out = [];
    var start = 0;
    while (start < words.length) {
        var lo = start + 1;
        var hi = words.length;
        var best = start;
        while (lo <= hi) {
            var mid = (lo + hi) >> 1;
            var chunk = words.slice(start, mid).join(' ');
            mh.innerHTML = '<div class="reader-chapter-block">' + openTag + esc(chunk) + closeTag + '</div>';
            var ht = mh.firstElementChild ? mh.firstElementChild.scrollHeight : 0;
            if (ht <= maxH) {
                best = mid;
                lo = mid + 1;
            } else hi = mid - 1;
        }
        if (best <= start) best = start + 1;
        while (best > start + 1) {
            var tryChunk = words.slice(start, best).join(' ');
            mh.innerHTML = '<div class="reader-chapter-block">' + openTag + esc(tryChunk) + closeTag + '</div>';
            var tryHt = mh.firstElementChild ? mh.firstElementChild.scrollHeight : 0;
            if (tryHt <= maxH) break;
            best--;
        }
        var chunkW = words.slice(start, best).join(' ');
        out.push('<div class="reader-chapter-block">' + openTag + esc(chunkW) + closeTag + '</div>');
        start = best;
    }
    return out.length ? out : ['<div class="reader-chapter-block">' + segmentHtml + '</div>'];
};

/** Usable inner height for one 6×9 page (matches viewport padding; no scroll). */
window.getReaderPageMaxHeight = function (shellEl, viewportEl) {
    if (!viewportEl) return 0;
    var vs = window.getComputedStyle(viewportEl);
    var padY = (parseFloat(vs.paddingTop) || 0) + (parseFloat(vs.paddingBottom) || 0);
    var blockPad = 0;
    var sample = viewportEl.querySelector('.reader-chapter-block');
    if (sample) {
        var bs = window.getComputedStyle(sample);
        blockPad = (parseFloat(bs.paddingTop) || 0) + (parseFloat(bs.paddingBottom) || 0);
    }
    var usable = Math.max(0, viewportEl.clientHeight - padY - blockPad - 8);
    if (usable >= 32) return usable;
    if (!shellEl || shellEl.clientHeight < 48) return 0;
    return Math.max(0, shellEl.clientHeight - padY - blockPad - 8);
};

window.getReaderLayoutCacheKey = function (shellEl, viewportEl) {
    if (!shellEl) return '';
    var maxH = window.getReaderPageMaxHeight(shellEl, viewportEl);
    return shellEl.clientWidth + 'x' + shellEl.clientHeight + '@@' + maxH;
};

/** Split full chapter HTML into page fragments that fit the fixed reader viewport (no scroll). */
window.splitHtmlIntoReaderPages = function (fullHtml, shellEl, viewportEl) {
    var mh = document.getElementById('previewMeasureHost');
    if (!mh || !shellEl || !viewportEl) return [fullHtml];
    var w = shellEl.clientWidth;
    var maxH = window.getReaderPageMaxHeight(shellEl, viewportEl);
    if (w < 48 || maxH < 48) return [fullHtml];
    var vpStyles = window.getComputedStyle(viewportEl);
    mh.style.width = w + 'px';
    mh.style.padding = vpStyles.padding;
    mh.style.fontSize = vpStyles.fontSize;
    mh.style.lineHeight = vpStyles.lineHeight;
    mh.style.boxSizing = 'border-box';
    mh.innerHTML = fullHtml;
    var block = mh.firstElementChild;
    if (!block || !block.classList || !block.classList.contains('reader-chapter-block')) {
        return [fullHtml];
    }
    var segments = [];
    var c = block.children;
    for (var i = 0; i < c.length; i++) {
        segments.push(c[i].outerHTML);
    }
    if (!segments.length) return [fullHtml];

    function blockHeight(innerConcat) {
        mh.innerHTML = '<div class="reader-chapter-block">' + innerConcat + '</div>';
        var b = mh.firstElementChild;
        return b ? b.scrollHeight : 0;
    }

    function pushOversizedSegment(seg) {
        var hSeg = blockHeight(seg);
        if (hSeg <= maxH) {
            pages.push('<div class="reader-chapter-block">' + seg + '</div>');
            return;
        }
        var subPages = window.splitOversizedHtmlSegment(seg, maxH, mh);
        for (var s = 0; s < subPages.length; s++) pages.push(subPages[s]);
    }

    var pages = [];
    var acc = '';
    function flushAcc() {
        if (acc) {
            pages.push('<div class="reader-chapter-block">' + acc + '</div>');
            acc = '';
        }
    }

    for (var k = 0; k < segments.length; k++) {
        var seg = segments[k];
        var combined = acc ? (acc + seg) : seg;
        var h = blockHeight(combined);
        if (h <= maxH) {
            acc = combined;
            continue;
        }
        if (acc) {
            var brp = window.BookReaderPagination;
            var pendingHeading = '';
            if (brp && typeof brp.splitAccBeforeFlush === 'function') {
                var split = brp.splitAccBeforeFlush(acc, seg);
                if (split.carry) {
                    if (split.flushBody) {
                        pages.push('<div class="reader-chapter-block">' + split.flushBody + '</div>');
                    }
                    pendingHeading = split.carry;
                    acc = '';
                } else {
                    flushAcc();
                }
            } else {
                flushAcc();
            }
            var candidate = pendingHeading ? (pendingHeading + seg) : seg;
            if (blockHeight(candidate) <= maxH) {
                acc = candidate;
            } else if (pendingHeading && blockHeight(pendingHeading) <= maxH) {
                pages.push('<div class="reader-chapter-block">' + pendingHeading + '</div>');
                if (blockHeight(seg) <= maxH) acc = seg;
                else pushOversizedSegment(seg);
            } else {
                pushOversizedSegment(candidate);
            }
        } else {
            pushOversizedSegment(seg);
        }
    }
    flushAcc();
    if (window.BookReaderPagination && typeof window.BookReaderPagination.stripTrailingHeadingsFromChapterBlockPages === 'function') {
        pages = window.BookReaderPagination.stripTrailingHeadingsFromChapterBlockPages(pages);
    }
    return pages.length ? pages : [fullHtml];
};

window.syncAiWriterPreviewLayout = function () {
    var scrollHost = document.getElementById('chapterPreviewScrollHost');
    var shell = document.getElementById('paginatedReaderShell');
    var viewport = document.getElementById('preview-content');
    var previewPane = document.querySelector('.ai-writer-preview-pane');
    if (!scrollHost || !shell) return;

    function syncPreviewPaneWidth(w) {
        if (!previewPane) return;
        if (window.innerWidth >= 1024) {
            previewPane.style.width = '';
            previewPane.style.maxWidth = '';
            return;
        }
        if (!(w > 0)) return;
        previewPane.style.width = Math.floor(w) + 'px';
        previewPane.style.maxWidth = '100%';
    }

    var nav = null;
    var isDesktopPreview = window.innerWidth >= 1024;
    var remPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    var maxShellH = Math.max(360, Math.floor(window.innerHeight - 8 * remPx));
    var minHostH = isDesktopPreview
        ? 0
        : Math.max(360, Math.floor(window.innerHeight * 0.52));

    if (window.BookInteriorPreview && typeof window.BookInteriorPreview.syncPreviewLayout === 'function') {
        window.BookInteriorPreview.syncPreviewLayout({
            host: scrollHost,
            shell: shell,
            viewport: viewport,
            measureHost: document.getElementById('previewMeasureHost'),
            navDock: nav,
            minHostHeightPx: minHostH,
            preferHeight: isDesktopPreview,
            maxHeightPx: isDesktopPreview ? maxShellH : 0,
            widthFactor: 1,
            syncMeasureTypography: true,
            onLayoutChange: function (changed) {
                if (!changed) return;
                var shellW = parseInt(shell.style.width || '0', 10);
                syncPreviewPaneWidth(shellW);
                if (window._previewChaptersMeta && window._previewChaptersMeta.length && typeof window.invalidateReaderPageCaches === 'function') {
                    window.invalidateReaderPageCaches();
                    var ch = window._previewChaptersMeta[window._previewChapterIndex || 0];
                    if (ch && !ch.loading && typeof window.ensureChapterPagesForMeta === 'function') {
                        window.ensureChapterPagesForMeta(ch);
                        if (typeof window.renderCurrentReaderPage === 'function') window.renderCurrentReaderPage();
                    }
                }
            }
        });
        var shellW = parseInt(shell.style.width || '0', 10);
        syncPreviewPaneWidth(shellW);
        return;
    }

    var paneW = scrollHost.clientWidth || 320;
    var shellH = maxShellH;
    var shellW = Math.floor(shellH * (6 / 9));
    if (shellW > Math.floor(paneW)) {
        shellW = Math.floor(paneW);
        shellH = Math.floor(shellW * (9 / 6));
    }
    syncPreviewPaneWidth(shellW);
    shell.style.width = shellW + 'px';
    shell.style.height = shellH + 'px';
    shell.style.maxWidth = '100%';
    shell.style.maxHeight = shellH + 'px';
    shell.style.aspectRatio = '6 / 9';
};

window.ensureChapterPagesForMeta = function (ch) {
    if (!ch || ch.loading) {
        window._previewChapterPages = [];
        return;
    }
    var shell = document.getElementById('paginatedReaderShell');
    var viewport = document.getElementById('preview-content');
    var fullHtml = '<div class="reader-chapter-block">' + (ch.html || '<p class="text-slate-500">No content for this chapter.</p>') + '</div>';
    if (!shell || !viewport) {
        window._previewChapterPages = [fullHtml];
        return;
    }
    var key = typeof window.getReaderLayoutCacheKey === 'function'
        ? window.getReaderLayoutCacheKey(shell, viewport)
        : (shell.clientWidth + 'x' + shell.clientHeight);
    if (ch._pagesCache && ch._pagesCacheKey === key && ch._pagesCache.length) {
        window._previewChapterPages = ch._pagesCache;
        return;
    }
    var pages = window.splitHtmlIntoReaderPages(fullHtml, shell, viewport);
    if (!pages.length) pages = [fullHtml];
    ch._pagesCache = pages;
    ch._pagesCacheKey = key;
    window._previewChapterPages = pages;
};

window.renderCurrentReaderPage = function () {
    var viewport = document.getElementById('preview-content');
    var pages = window._previewChapterPages || [];
    var pi = Math.max(0, Math.min(window._previewPageIndex || 0, Math.max(0, pages.length - 1)));
    window._previewPageIndex = pi;
    var html = pages.length ? pages[pi] : '<div class="reader-chapter-block"><p class="text-slate-500">No content.</p></div>';
    if (viewport) {
        viewport.innerHTML = html;
        viewport.scrollTop = 0;
    }
    window.updateChapterPreviewNavUI();
    window.saveReaderBookState();
    window.prefetchNextChapterPages();
};

window.readerNavNext = function () {
    var pi = window._previewPageIndex || 0;
    var ci = window._previewChapterIndex || 0;
    var pages = window._previewChapterPages || [];
    var list = window._previewChaptersMeta || [];
    if (pi < pages.length - 1) {
        window._previewPageIndex = pi + 1;
        window.renderCurrentReaderPage();
        window.requestAnimationFrame(function () {
            if (typeof window.scrollAiWriterChapterToTop === 'function') window.scrollAiWriterChapterToTop();
        });
        return;
    }
    if (ci < list.length - 1) {
        window.applyPreviewChapterIndex(ci + 1, { initialPage: 0 });
    }
};

window.readerNavPrevious = function () {
    var pi = window._previewPageIndex || 0;
    var ci = window._previewChapterIndex || 0;
    if (pi > 0) {
        window._previewPageIndex = pi - 1;
        window.renderCurrentReaderPage();
        window.requestAnimationFrame(function () {
            if (typeof window.scrollAiWriterChapterToTop === 'function') window.scrollAiWriterChapterToTop();
        });
        return;
    }
    if (ci > 0) {
        window.applyPreviewChapterIndex(ci - 1, { initialPage: -1 });
    }
};

window.prefetchNextChapterPages = function () {
    var list = window._previewChaptersMeta || [];
    var ci = window._previewChapterIndex || 0;
    if (ci >= list.length - 1) return;
    var next = list[ci + 1];
    if (!next || next.loading || next._pagesPrefetching) return;
    var shell = document.getElementById('paginatedReaderShell');
    var viewport = document.getElementById('preview-content');
    if (!shell || !viewport || !next.html) return;
    next._pagesPrefetching = true;
    var run = function () {
        try {
            var fullHtml = '<div class="reader-chapter-block">' + next.html + '</div>';
            var pages = window.splitHtmlIntoReaderPages(fullHtml, shell, viewport);
            var key = typeof window.getReaderLayoutCacheKey === 'function'
                ? window.getReaderLayoutCacheKey(shell, viewport)
                : (shell.clientWidth + 'x' + shell.clientHeight);
            next._pagesCache = pages.length ? pages : [fullHtml];
            next._pagesCacheKey = key;
        } catch (err) {
            console.warn('prefetchNextChapterPages', err);
        } finally {
            next._pagesPrefetching = false;
        }
    };
    if (typeof requestIdleCallback === 'function') {
        requestIdleCallback(run, { timeout: 1500 });
    } else setTimeout(run, 200);
};

window.invalidateReaderPageCaches = function () {
    (window._previewChaptersMeta || []).forEach(function (ch) {
        if (ch) {
            ch._pagesCache = null;
            ch._pagesCacheKey = null;
        }
    });
};

window.setPreviewChapterHeaderText = function (text) {
    var el = document.getElementById('preview-chapter-header-text');
    if (el) el.textContent = text || '';
};

/** Strip auto-generated "Chapter N" labels — show only the user's title. */
window.sanitizeChapterTitleForInput = function (title) {
    var t = (title == null ? '' : String(title)).trim();
    if (!t) return '';
    t = t.replace(/^Chapter\s*\d+\s*[:\-–]\s*/i, '').trim();
    if (/^Chapter\s*\d+$/i.test(t)) return '';
    return t;
};

/** Dropdown label: chapter number + user title (no "Chapter N:" prefix). */
window.formatChapterDropdownLabel = function (chapterNo, title) {
    var n = parseInt(String(chapterNo), 10);
    if (!Number.isFinite(n) || n < 1) n = 1;
    var t = window.sanitizeChapterTitleForInput(title);
    return t ? (n + ' — ' + t) : ('Chapter ' + n);
};

/** Visible heading / nav label — user title only. */
window.formatChapterDisplayName = function (chapterNo, title) {
    var t = window.sanitizeChapterTitleForInput(title);
