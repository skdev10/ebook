/** Pre-flight: API key + upstream queue before LLM calls (fast fail with clear message). */
window.checkUpstreamQueueBeforeAiCall = async function () {
    try {
        var ac = new AbortController();
        var tid = setTimeout(function () { ac.abort(); }, 12000);
        var r = await fetch('/Books/ChapterGenerationReady', { credentials: 'same-origin', headers: { 'Accept': 'application/json' }, signal: ac.signal });
        clearTimeout(tid);
        var d = await r.json().catch(function () { return {}; });
        if (!d.canGenerate) {
            var msg = (d.message || 'Chapter generation is not available right now.').toString();
            throw new Error(msg);
        }
        if (d.warning) {
            console.warn('ChapterGenerationReady:', d.warning);
        }
        return { ok: true, queue: d.queue || null };
    } catch (e) {
        if (e && e.name === 'AbortError') {
            console.warn('ChapterGenerationReady timed out — continuing with generate.');
            return { ok: true };
        }
        throw e;
    }
};

/**
 * Isolate preview/version state: clear text selection; on chapter change or force, drop modal edit cache and strip temp classes
 * so switching versions or chapters never carries highlights/formatting from a prior view.
 */
window.resetWriterPreviewForContextChange = function (bookId, chapterNo, responseId, forceFullReset) {
    try {
        var sel = window.getSelection && window.getSelection();
        if (sel && sel.removeAllRanges) {
            var pc = document.getElementById('preview-content');
            if (pc && sel.anchorNode && pc.contains(sel.anchorNode)) sel.removeAllRanges();
        }
    } catch (e) {}
    var bk = String(bookId || 0);
    var ch = String(chapterNo || 0);
    var key = bk + ':' + ch + ':' + String(responseId || 0);
    var prev = window._writerPreviewIsolationKey;
    window._writerPreviewIsolationKey = key;
    var chapterKeyChanged = prev && prev.length && prev.split(':').slice(0, 2).join(':') !== (bk + ':' + ch);
    if (forceFullReset || chapterKeyChanged) {
        window._editModeOriginalContent = null;
        if (window._chapterEditModalState) window._chapterEditModalState = null;
    }
    if (forceFullReset || chapterKeyChanged) {
        var pv = document.getElementById('preview-content');
        if (pv) {
            pv.querySelectorAll('.hl-temp, .import-flash, [data-writer-syntax]').forEach(function (n) {
                n.classList.remove('hl-temp', 'import-flash');
                n.removeAttribute('data-writer-syntax');
            });
        }
        window._previewChaptersMeta = [];
        window._previewChapterPages = [];
        window._previewChapterIndex = 0;
        window._previewPageIndex = 0;
    }
};

