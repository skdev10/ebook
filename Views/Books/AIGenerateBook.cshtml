                writerAutosaveStatusTimer = setTimeout(function () {
                    setWriterAutoSaveStatus('', false);
                }, 1600);
            } else {
                var msg = (result.data && result.data.message) ? result.data.message : 'Could not autosave.';
                setWriterAutoSaveStatus(msg, true);
                setTimeout(function () { queueWriterAutosave(1200); }, 1200);
            }
        }).catch(function () {
            setWriterAutoSaveStatus('Could not autosave. Retrying…', true);
            setTimeout(function () { queueWriterAutosave(1500); }, 1500);
        }).finally(function () {
            writerAutosaveInFlight = false;
            if (writerAutosaveQueued) {
                writerAutosaveQueued = false;
                queueWriterAutosave(250);
            }
        });
    }

    function queueWriterAutosave(delayMs) {
        if (writerAutosaveTimer) clearTimeout(writerAutosaveTimer);
        writerAutosaveTimer = setTimeout(function () {
            runWriterAutosaveNow();
        }, typeof delayMs === 'number' ? delayMs : 700);
    }

    /** A blank/placeholder book title that must never be force-injected into the title input. */
    function isPlaceholderBookTitle(title) {
        var t = (title || '').trim();
        if (!t) return true;
        return /^(untitled|untitled book|no book selected)$/i.test(t);
    }

    function syncWorkingOnBookTitle(title) {
        var el = document.getElementById('aiWriterSelectedBookTitle');
        if (!el) return;
        var t = (title || '').trim();
        if (isPlaceholderBookTitle(t)) {
            el.textContent = 'Untitled Book';
            return;
        }
        el.textContent = t;
    }

    function updatePreviewUI() {
        var bookTitle = getBookTitle() || defaultBookTitle;
        previewBookTitle.textContent = bookTitle || 'Your Chapter\'s Preview';
        syncWorkingOnBookTitle(getBookTitle());
        if (window._previewChaptersMeta && window._previewChaptersMeta.length > 0) {
            return;
        }
        if (typeof window.showPreviewEmptyState === 'function') {
            window.showPreviewEmptyState();
        } else {
            if (previewChapterHeader) {
                previewChapterHeader.classList.add('hidden');
                previewChapterHeader.setAttribute('aria-hidden', 'true');
            }
            previewContent.innerHTML = defaultPreviewHtml;
            previewContent.classList.add('text-slate-400');
            previewContent.classList.remove('text-slate-800');
        }
    }

    inputBookTitle.addEventListener('input', updatePreviewUI);
    inputChapterNo.addEventListener('change', updatePreviewUI);
    inputChapterTitle.addEventListener('input', updatePreviewUI);
    inputChapterTopic.addEventListener('input', function () {
        if (window.EbookUnsavedGuard) window.EbookUnsavedGuard.setDirty();
        updatePreviewUI();
        queueWriterAutosave(700);
    });

    selectBook.addEventListener('change', function() {
        var bookId = getBookId();
        var bookIdInput = document.getElementById('BookId');
        if (bookIdInput && bookId > 0) bookIdInput.value = String(bookId);
        var savedDdlSync = document.getElementById('savedResponsesDropdown');
        if (savedDdlSync && bookId > 0) savedDdlSync.value = String(bookId);
        if (typeof window.refreshBookFormattingButton === 'function') window.refreshBookFormattingButton(null);
        if (bookId > 0) {
            // Explicit book switch: load its real title (never a placeholder) and clear the guard.
            var pickedTitle = selectBook.options[selectBook.selectedIndex].text;
