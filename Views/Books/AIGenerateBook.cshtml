    .reader-chapters-wrap.hidden { display: none !important; }
    .reader-chapters-wrap:not(.hidden) { display: flex !important; flex-direction: column; gap: 0; width: 100%; }
    .reader-chapter-block {
        box-sizing: border-box;
        padding: 1rem 1.15rem;
        background: transparent;
        color: #334155;
        font-size: 0.8125rem;
