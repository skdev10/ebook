         /** When external /api/audio returns 500, Chrome/Edge can still transcribe one phrase via Web Speech API. */
         function ebookTryBrowserSpeechOnce() {
             var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
             if (!SR) return Promise.resolve(null);
             return new Promise(function (resolve) {
                 var rec = new SR();
                 rec.lang = navigator.language || 'en-US';
                 rec.interimResults = false;
                 rec.maxAlternatives = 1;
                 var settled = false;
                 var tid = setTimeout(function () { finish(null); }, 20000);
                 function finish(t) {
                     if (settled) return;
                     settled = true;
                     try { clearTimeout(tid); } catch (e0) {}
                     try { rec.stop(); } catch (e1) {}
                     resolve(t ? String(t).trim() : null);
                 }
                 rec.onresult = function (ev) {
                     try {
                         var tx = '';
                         if (ev.results && ev.results.length)
                             tx = ([].slice.call(ev.results).map(function (r) { return r[0] && r[0].transcript ? r[0].transcript : ''; })).join(' ');
                         finish(tx.trim() || null);
                     } catch (_) { finish(null); }
                 };
                 rec.onerror = function () { finish(null); };
                 try { rec.start(); } catch (_) { finish(null); }
             });
         }
