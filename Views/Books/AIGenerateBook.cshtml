        else if (ch.content && String(ch.content).trim()) total += 1;
    });
    return total;
};

window.refreshAiWriterTotalPages = async function () {
    var wrap = document.getElementById('aiWriterTotalPages');
    var valEl = document.getElementById('aiWriterTotalPagesValue');
    if (!wrap || !valEl) return;
    var bid = parseInt(String((document.getElementById('BookId') && document.getElementById('BookId').value) || '0'), 10);
    if (!bid) { wrap.classList.add('hidden'); return; }
    var localPages = typeof window.getAiWriterLocalTotalPages === 'function' ? window.getAiWriterLocalTotalPages() : 0;
    var showCount = function (n) {
        if (n > 0) {
            valEl.textContent = String(n);
            wrap.classList.remove('hidden');
        } else {
            wrap.classList.add('hidden');
        }
    };
    if (localPages > 0) showCount(localPages);
    try {
        var r = await fetch('/Dashboard/BookPageMetrics?bookId=' + encodeURIComponent(bid), { credentials: 'same-origin', headers: { Accept: 'application/json' } });
        var d = await r.json().catch(function () { return {}; });
        var apiCount = (d && d.success && d.pageCount > 0) ? parseInt(String(d.pageCount), 10) : 0;
        // B3/B4: when the server count comes from saved Book Formatting (the measured reader
        // pages), it is the single source of truth — show it directly so the AI Writer total
        // matches the Publish page exactly. Otherwise fall back to the prior max() heuristic.
        if (apiCount > 0 && d && d.pageCountSource === 'formatter') showCount(apiCount);
        else if (apiCount > 0) showCount(Math.max(apiCount, localPages));
        else if (!localPages) showCount(0);
    } catch (e) {
        if (!localPages) showCount(0);
    }
};
