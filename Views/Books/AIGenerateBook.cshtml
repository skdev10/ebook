<script>
(function () {
    var userId = @userId;
    if (userId === 0) return;

    var selectBook = document.getElementById('savedResponsesDropdown');
    var inputBookTitle = document.getElementById('BookTitle');
    var inputChapterNo = document.getElementById('ChapterDropdown');
    var inputChapterTitle = document.getElementById('Title');
    var inputChapterTopic = document.getElementById('UserInput');
    var writerAutoSaveStatus = document.getElementById('writerAutoSaveStatus');
    var previewBookTitle = document.getElementById('preview-book-title');
    var previewChapterHeader = document.getElementById('preview-chapter-header');
    var previewContent = document.getElementById('preview-content');
    var btnGenerate = document.getElementById('GenerateBtn');
    var chatContainerEl = document.getElementById('chatContainer');
    var chatContainer = chatContainerEl;
    window.chatContainer = chatContainerEl;

    var defaultPreviewHtml = previewContent ? previewContent.innerHTML : '';
    var defaultBookTitle = previewBookTitle ? previewBookTitle.textContent : '';
    var writerAutosaveTimer = null;
    var writerAutosaveInFlight = false;
    var writerAutosaveQueued = false;
    var writerAutosaveStatusTimer = null;

    function getContentFromPossibleJson(value) {
        if (value == null || value === '') return '';
        var s = (typeof value === 'string') ? value : JSON.stringify(value);
        var t = s.trim();
        if (!t) return '';
        if (t.charAt(0) !== '{' && t.charAt(0) !== '[') return s;
        try {
            var o = typeof value === 'object' ? value : JSON.parse(s);
            if (o && typeof o === 'object') {
                if (o.data && o.data.content != null && (o.data.content + '').trim()) return (o.data.content + '').trim();
                if (o.content != null && (o.content + '').trim()) return (o.content + '').trim();
                if (o.data && o.data.chapters && Array.isArray(o.data.chapters) && o.data.chapters.length > 0) {
                    var first = o.data.chapters[0];
                    var c = (first.content != null ? first.content : first.Content) + '';
                    if (c.trim()) return c.trim();
                }
                if (o.chapters && Array.isArray(o.chapters) && o.chapters.length > 0) {
                    var first = o.chapters[0];
                    var c = (first.content != null ? first.content : first.Content) + '';
                    if (c.trim()) return c.trim();
                }
                if (o.data && typeof o.data === 'string' && o.data.trim()) return o.data.trim();
            }
            return s;
        } catch (e) { return s; }
    }

    function getBookId() {
        var v = selectBook && selectBook.value;
        return v ? parseInt(v, 10) : 0;
    }
    function getBookTitle() {
        if (getBookId() > 0 && selectBook && selectBook.options[selectBook.selectedIndex]) {
            return selectBook.options[selectBook.selectedIndex].text || '';
        }
        return inputBookTitle ? inputBookTitle.value.trim() : '';
    }
    function getChapterNo() {
        return parseInt((inputChapterNo && inputChapterNo.value) || '1', 10);
    }
    function getToken() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        return t ? t.value : '';
    }

    window.syncPreviewMetaChapterTitle = function (chapterNo, newTitle) {
        var list = window._previewChaptersMeta || [];
        var n = parseInt(String(chapterNo), 10);
        list.forEach(function (ch, idx) {
            var cNo = parseInt(String((ch && (ch.chapterNo || ch.chapter)) || (idx + 1)), 10);
            if (cNo === n) {
                ch.title = newTitle;
                ch.chapterTitle = newTitle;
            }
        });
        if (typeof window.updateChapterPreviewNavUI === 'function') window.updateChapterPreviewNavUI();
        if (window._chapterIndexFlyoutOpen && typeof window.rebuildChapterIndexFlyoutList === 'function') {
            window.rebuildChapterIndexFlyoutList();
        }
    };

    window.saveChapterNameUpdate = async function (chapterNoOverride, titleOverride) {
        var bookId = getBookId();
        var chapterNo = chapterNoOverride != null ? parseInt(String(chapterNoOverride), 10) : getChapterNo();
        var title = (titleOverride != null ? String(titleOverride) : (inputChapterTitle ? inputChapterTitle.value : '')).trim();
        if (!bookId || bookId <= 0) {
            setWriterAutoSaveStatus('Select a book before renaming.', true);
            return { success: false };
        }
        if (!chapterNo || chapterNo <= 0) {
            setWriterAutoSaveStatus('Invalid chapter number.', true);
            return { success: false };
        }
        if (!title) {
            setWriterAutoSaveStatus('Chapter name cannot be empty.', true);
            return { success: false };
        }

        var saveBtn = document.getElementById('btnSaveChapterName');
        if (saveBtn) { saveBtn.disabled = true; saveBtn.classList.add('opacity-60'); }
        setWriterAutoSaveStatus('Saving chapter name…', false);

        try {
            var response = await fetch('/Books/UpdateChapterName', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getToken()
                },
                body: JSON.stringify({ bookId: bookId, chapterNumber: chapterNo, title: title }),
                credentials: 'same-origin'
            });
            var data = {};
            try { data = await response.json(); } catch (_) {}
            if (!response.ok || !data.success) {
                var msg = (data && data.message) ? data.message : 'Could not save chapter name.';
                setWriterAutoSaveStatus(msg, true);
                return { success: false, message: msg };
            }
            var savedTitle = (data.title || title).trim();
            if (inputChapterTitle && chapterNo === getChapterNo()) inputChapterTitle.value = savedTitle;
            window.syncPreviewMetaChapterTitle(chapterNo, savedTitle);
            if (typeof updatePreviewUI === 'function') updatePreviewUI();
            var ddl = document.getElementById('ChapterDropdown');
            if (ddl) {
                Array.from(ddl.options).forEach(function (opt) {
                    if (parseInt(opt.value, 10) === chapterNo) {
                        opt.textContent = typeof window.formatChapterDropdownLabel === 'function'
                            ? window.formatChapterDropdownLabel(chapterNo, savedTitle)
                            : String(chapterNo);
                        opt.setAttribute('data-title', savedTitle);
                    }
                });
            }
            setWriterAutoSaveStatus('Chapter name saved.', false);
            if (writerAutosaveStatusTimer) clearTimeout(writerAutosaveStatusTimer);
            writerAutosaveStatusTimer = setTimeout(function () { setWriterAutoSaveStatus('', false); }, 1800);
            return { success: true, title: savedTitle };
        } catch (err) {
            setWriterAutoSaveStatus('Could not save chapter name. Try again.', true);
            return { success: false };
        } finally {
            if (saveBtn) { saveBtn.disabled = false; saveBtn.classList.remove('opacity-60'); }
        }
    };

    window.promptRenameChapter = function (chapterNo, currentTitle, previewIndex) {
        var modal = document.getElementById('chapterRenameModal');
        var input = document.getElementById('chapterRenameModalInput');
        var cancelBtn = document.getElementById('chapterRenameModalCancel');
        var saveBtn = document.getElementById('chapterRenameModalSave');
        if (!modal || !input) return;
        input.value = currentTitle || '';
        modal.style.display = 'flex';
        modal._renameChapterNo = chapterNo;
        modal._renamePreviewIndex = previewIndex;
        setTimeout(function () { input.focus(); input.select(); }, 50);
        function closeModal() {
            modal.style.display = 'none';
            modal._renameChapterNo = null;
            modal._renamePreviewIndex = null;
        }
        function submitRename() {
            var nextTitle = String(input.value || '').trim();
            if (!nextTitle) {
                setWriterAutoSaveStatus('Chapter name cannot be empty.', true);
                input.focus();
                return;
            }
            var chNo = modal._renameChapterNo;
            var pIdx = modal._renamePreviewIndex;
            closeModal();
            window.saveChapterNameUpdate(chNo, nextTitle).then(function (result) {
                if (result && result.success && typeof pIdx === 'number' && typeof window.applyPreviewChapterIndex === 'function') {
                    window.applyPreviewChapterIndex(pIdx, { initialPage: 0 });
                }
            });
        }
        if (!modal._renameBound) {
            modal._renameBound = true;
            cancelBtn && cancelBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
            saveBtn && saveBtn.addEventListener('click', submitRename);
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); submitRename(); }
                if (e.key === 'Escape') { e.preventDefault(); closeModal(); }
            });
        }
    };

    function setWriterAutoSaveStatus(text, isError) {
        if (!writerAutoSaveStatus) return;
        writerAutoSaveStatus.textContent = text || '';
        writerAutoSaveStatus.classList.toggle('text-red-600', !!isError);
        writerAutoSaveStatus.classList.toggle('text-slate-400', !isError);
    }

    function parseWriterAutosaveResponse(r, text) {
        var data = {};
        try {
            data = text && String(text).trim() ? JSON.parse(text) : {};
        } catch (_) {
            data = { success: false, message: 'Autosave failed: invalid server response.' };
        }
        return { ok: r.ok, status: r.status, data: data };
    }

    function buildWriterAutosavePayload() {
        var statusValue = (document.getElementById('Status') && document.getElementById('Status').value) || '';
        var isReadOnly = String(statusValue).toLowerCase() === 'readonly';
        var userIdValue = (document.getElementById('UserId') && document.getElementById('UserId').value) || '';
        var bookIdValue = (document.getElementById('BookId') && document.getElementById('BookId').value) || '';
        var chapterNoValue = (document.getElementById('ChapterNo') && document.getElementById('ChapterNo').value) || '';
        if (!userIdValue || userIdValue === '0' || !bookIdValue || bookIdValue === '0' || !chapterNoValue) return null;
        var chapterTitle = (inputChapterTitle && inputChapterTitle.value) ? String(inputChapterTitle.value).trim() : '';
        if (isReadOnly) {
            if (!chapterTitle) return null;
            return {
                UserId: String(userIdValue),
                BookId: String(bookIdValue),
                Chapter: String(chapterNoValue),
                NewContent: '',
                ChapterTitle: chapterTitle,
                Topic: '',
                RecordVersion: false,
                TitleOnly: true
            };
        }
        var bodyHtml = '';
        if (typeof window.getWriterPreviewChapterHtmlForEdit === 'function') bodyHtml = window.getWriterPreviewChapterHtmlForEdit() || '';
        if (!bodyHtml && previewContent && previewContent.innerHTML) bodyHtml = previewContent.innerHTML;
        if (!bodyHtml) bodyHtml = window._currentChapterContent || '';
        var topicText = (inputChapterTopic && inputChapterTopic.value) ? String(inputChapterTopic.value) : '';
        var bookTitleValue = (inputBookTitle && inputBookTitle.value) ? String(inputBookTitle.value).trim() : '';
        if (!String(bodyHtml || '').trim() && !topicText.trim()) {
            if (!bookTitleValue) return null;
            return {
                UserId: String(userIdValue),
                BookId: String(bookIdValue),
                Chapter: String(chapterNoValue),
                NewContent: '',
                ChapterTitle: chapterTitle,
                BookTitle: bookTitleValue,
                Topic: '',
                RecordVersion: false,
                BookTitleOnly: true
            };
        }
        return {
            UserId: String(userIdValue),
            BookId: String(bookIdValue),
            Chapter: String(chapterNoValue),
            NewContent: bodyHtml || '<p></p>',
            ChapterTitle: chapterTitle,
            BookTitle: bookTitleValue || null,
            Topic: topicText,
            RecordVersion: false
        };
    }

    function runWriterAutosaveNow() {
        var payload = buildWriterAutosavePayload();
        if (!payload) return;
        if (writerAutosaveInFlight) {
            writerAutosaveQueued = true;
            return;
        }
        writerAutosaveInFlight = true;
        setWriterAutoSaveStatus('Saving…', false);
        fetch('/Books/SaveChapterContent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            credentials: 'same-origin'
        }).then(function (r) {
            return r.text().then(function (t) { return parseWriterAutosaveResponse(r, t); });
