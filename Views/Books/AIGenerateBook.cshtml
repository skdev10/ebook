                             if (startRecBtn) { startRecBtn.style.display = ''; startRecBtn.disabled = false; }
                             if (stopRecBtn) stopRecBtn.disabled = true;
                         }
                     } else {
                         voiceInputMode = 'idle';
                         ebookLiveSpeechRecognition = null;
                         if (recordingStripArea) { recordingStripArea.classList.add('hidden'); recordingStripArea.classList.remove('flex'); }
                         if (startRecBtn) { startRecBtn.style.display = ''; startRecBtn.disabled = false; }
                         if (stopRecBtn) stopRecBtn.disabled = true;
                     }
                 };
                 ebookLiveSpeechRecognition = rec;
                 rec.start();
                 if (startRecBtn) startRecBtn.style.display = 'none';
                 if (recordingStripArea) {
                     recordingStripArea.classList.remove('hidden');
                     recordingStripArea.classList.add('flex');
                     recordingStripArea.style.display = '';
                 }
                 var sts0 = document.getElementById('voiceRecordingStatusText');
                 if (sts0) sts0.textContent = 'Listening — text appears as you speak';
                 if (stopRecBtn) stopRecBtn.disabled = false;
             } catch (ex) {
                 console.error('[voice] live speech start:', ex);
                 ebookLiveDictationShouldRun = false;
                 voiceInputMode = 'idle';
                 ebookLiveSpeechRecognition = null;
                showNotification('Could not start live dictation: ' + (ex.message || 'unknown') + '. Try the audio upload icon.', 'error');
                 if (startRecBtn) { startRecBtn.style.display = ''; startRecBtn.disabled = false; }
             }
             return;
         }
         if (typeof MediaRecorder === 'undefined') {
             var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
             if (SR) {
                 var useSpeech = true;
                 if (typeof Swal !== 'undefined') {
                     var pick = await Swal.fire({
                         icon: 'info',
                         title: 'Voice typing',
                         text: 'This browser cannot record an audio file (MediaRecorder). You can speak once using built-in recognition instead.',
                         showCancelButton: true,
                         confirmButtonText: 'Speak now',
                         cancelButtonText: 'Cancel',
                         confirmButtonColor: '#7c3aed'
                     });
                     useSpeech = !!(pick && pick.isConfirmed);
                 } else {
                     showNotification('Recording file not supported — starting one-time voice typing.', 'info');
                 }
                 if (!useSpeech) return;
                 try {
                     startRecBtn.disabled = true;
                     var localTxt = await ebookTryBrowserSpeechOnce();
                     if (localTxt) {
                         var uiSp = document.getElementById('UserInput');
                         if (uiSp) uiSp.value = (uiSp.value ? (uiSp.value + ' ') : '') + localTxt;
                         showNotification('Text added using voice typing.', 'success');
                     } else {
                         showNotification('No speech detected. Allow microphone, try again, or type your text.', 'error');
                     }
                 } finally {
                     startRecBtn.disabled = false;
                 }
                 return;
             }
            showNotification('MediaRecorder is not available in this browser. Use the audio upload icon or type your text.', 'error');
             return;
         }
         try {
             startRecBtn.disabled = true;
             var constraints = { audio: true };
             const stream = await navigator.mediaDevices.getUserMedia(constraints);
             recordingStream = stream;
             var mimeType = MediaRecorder.isTypeSupported('audio/webm;codecs=opus') ? 'audio/webm;codecs=opus'
                 : (MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm'
                 : (MediaRecorder.isTypeSupported('audio/mp4') ? 'audio/mp4' : ''));
             try {
                 mediaRecorder = mimeType ? new MediaRecorder(stream, { mimeType: mimeType }) : new MediaRecorder(stream);
             } catch (mrCtorErr) {
                 console.warn('MediaRecorder with mime failed, default:', mrCtorErr);
                 mediaRecorder = new MediaRecorder(stream);
             }
             audioChunks = [];
             mediaRecorder.ondataavailable = function (e) { if (e.data && e.data.size > 0) audioChunks.push(e.data); };
             mediaRecorder.onerror = function (ev) {
                 console.error('[voice] MediaRecorder error:', ev && ev.error ? ev.error : ev);
                 var en = (ev && ev.error && ev.error.name) ? String(ev.error.name) : 'Unknown';
                showNotification('Recording stopped unexpectedly (' + en + '). Try again, use the audio upload icon, or type your topic.', 'error');
                 try {
                     if (recordingStream) {
                         recordingStream.getTracks().forEach(function (t) { t.stop(); });
                         recordingStream = null;
                     }
                 } catch (e0) { /* ignore */ }
                 audioChunks = [];
                 if (recordingStripArea) { recordingStripArea.classList.add('hidden'); recordingStripArea.classList.remove('flex'); }
                 if (startRecBtn) { startRecBtn.style.display = ''; startRecBtn.disabled = false; }
                 if (stopRecBtn) stopRecBtn.disabled = true;
                 voiceInputMode = 'idle';
             };
             mediaRecorder.onstop = async () => {
                 if (recordingStream) {
                     recordingStream.getTracks().forEach(t => t.stop());
                     recordingStream = null;
                 }
                 const blob = new Blob(audioChunks, { type: mediaRecorder.mimeType || "audio/webm" });
                 // Filename + multipart type must match actual codec (Safari/Edge often record mp4 — wrong .webm broke upstream MIME detection).
                 var ext = '.webm';
                 var mt = mediaRecorder.mimeType || blob.type || '';
                 if (mt.indexOf('mp4') >= 0 || mt.indexOf('mpeg') >= 0 || mt.indexOf('x-m4a') >= 0) ext = '.mp4';
                 else if (mt.indexOf('ogg') >= 0) ext = '.ogg';
                 var voiceFileName = 'voice' + ext;
                 if (!blob.size) {
                     console.error('Voice recording: empty blob — browser may need periodic timeslices or requestData() before stop.');
                    showNotification('Recording had no audio data. Try again or use the audio upload icon.', 'error');
                     if (recordingStripArea) { recordingStripArea.classList.add('hidden'); recordingStripArea.classList.remove('flex'); }
                     if (startRecBtn) { startRecBtn.style.display = ''; startRecBtn.disabled = false; }
                     if (stopRecBtn) stopRecBtn.disabled = true;
                     voiceInputMode = 'idle';
                     return;
                 }
                 const formData = new FormData();
                 formData.append("audio", blob, voiceFileName);
                 formData.append("AudioFile", blob, voiceFileName);
                 formData.append("Language", "en-US");
                 const uid = document.getElementById("UserId")?.value || "";
                 const bid = document.getElementById("BookId")?.value || "";
                 const ch = document.getElementById("ChapterNo")?.value || "0";
                 if (uid) formData.append("userId", uid);
                 if (bid) formData.append("bookId", bid);
                 if (ch) formData.append("chapter", ch);
                 try {
                     showNotification('Uploading and transcribing audio…', 'info');
                     var ac = new AbortController();
                     var uploadTid = setTimeout(function () { try { ac.abort(); } catch (eAb) {} }, 180000);
                     var res;
                     try {
                         res = await fetch("/api/AudioToText/convert", {
                             method: "POST",
                             body: formData,
                             credentials: "same-origin",
                             signal: ac.signal
                         });
                     } finally {
                         clearTimeout(uploadTid);
                     }
                     const raw = await res.text();
                     var data = {};
                     if (raw) {
                         try { data = JSON.parse(raw); } catch (parseErr) { data = {}; }
                     }
                     if (!res.ok) {
                         var errMsg = (data && (data.message || data.Message || data.detail || data.Detail || data.title || data.Title))
                             ? String(data.message || data.Message || data.detail || data.Detail || data.title || data.Title).trim()
                             : (raw && String(raw).trim().charAt(0) !== '<' ? (String(raw).length > 400 ? String(raw).slice(0, 400) + '…' : String(raw).trim()) : '');
                         if (!errMsg) errMsg = 'HTTP ' + res.status + (res.statusText ? ' ' + res.statusText : '');
                         var canBrowser = !!(window.SpeechRecognition || window.webkitSpeechRecognition);
                         var trySpeech = (data && data.suggestBrowserSpeech === true) || res.status >= 500;
                         if (trySpeech) {
                             if (canBrowser) {
                                 if (typeof Swal !== 'undefined') {
                                     await Swal.fire({
                                         icon: 'info',
                                         title: 'Speak your topic',
                                         text: 'Tap OK — then speak clearly while the browser listens once (Chrome/Edge works best).',
                                         confirmButtonText: 'OK',
                                         confirmButtonColor: '#7c3aed'
                                     });
                                 } else {
                                     showNotification('We will listen for your spoken topic next — speak when recording starts.', 'info');
                                 }
                                 var localTxt = await ebookTryBrowserSpeechOnce();
                                 if (localTxt) {
                                     var uiSpeech = document.getElementById("UserInput");
                                     if (uiSpeech) uiSpeech.value = (uiSpeech.value ? (uiSpeech.value + ' ') : '') + localTxt;
                                     showNotification('Text added using browser speech.', 'success');
                                     if (recordingStripArea) { recordingStripArea.classList.add('hidden'); recordingStripArea.classList.remove('flex'); }
                                     if (startRecBtn) { startRecBtn.style.display = ''; startRecBtn.disabled = false; }
                                     if (stopRecBtn) stopRecBtn.disabled = true;
                                     voiceInputMode = 'idle';
                                     return;
                                 }
                                 showNotification('Voice unavailable. Please type your topic manually.', 'error');
                             } else {
                                 showNotification('Voice unavailable. Please type your topic manually.', 'error');
                             }
                             if (recordingStripArea) { recordingStripArea.classList.add('hidden'); recordingStripArea.classList.remove('flex'); }
                             if (startRecBtn) { startRecBtn.style.display = ''; startRecBtn.disabled = false; }
                             if (stopRecBtn) stopRecBtn.disabled = true;
                             voiceInputMode = 'idle';
                             return;
                         }
                         showNotification('Failed to convert audio: ' + errMsg, 'error');
                         if (recordingStripArea) { recordingStripArea.classList.add('hidden'); recordingStripArea.classList.remove('flex'); }
                         if (startRecBtn) { startRecBtn.style.display = ''; startRecBtn.disabled = false; }
                         if (stopRecBtn) stopRecBtn.disabled = true;
                         voiceInputMode = 'idle';
                         return;
                     }
                     if (data.success && data.text) {
                         var txt = data.text.replace(/<p[^>]*>/gi, '\n').replace(/<\/p>/gi, '\n').replace(/<br\s*\/?>/gi, '\n').replace(/<[^>]+>/g, '').replace(/\n{3,}/g, '\n\n').trim();
                         var uiTopic = document.getElementById("UserInput");
                         if (uiTopic) uiTopic.value = (uiTopic.value ? (uiTopic.value.trim() + ' ') : '') + txt;
                         showNotification('Voice converted to text.', 'success');
                     } else {
                         showNotification('No text returned from audio.', 'error');
                     }
                 } catch (err) {
                     console.error("Error converting audio:", err);
                     var isAbort = err && (err.name === 'AbortError' || String(err.message || '').indexOf('abort') !== -1);
                    showNotification(isAbort ? 'Transcription took too long or was cancelled. Try a shorter clip or use the audio upload icon.' : ('Error converting audio: ' + (err.message || 'Unknown')), 'error');
                 }
                 if (recordingStripArea) { recordingStripArea.classList.add('hidden'); recordingStripArea.classList.remove('flex'); }
                 if (startRecBtn) { startRecBtn.style.display = ''; startRecBtn.disabled = false; }
                 if (stopRecBtn) stopRecBtn.disabled = true;
                 voiceInputMode = 'idle';
             };
             // Short timeslice reliably yields non-empty blobs on Chrome/Edge/Safari; plain start() often produced 0-byte audio.
             try {
                 mediaRecorder.start(250);
             } catch (startErr) {
                 console.error('MediaRecorder.start failed:', startErr);
                 showNotification('Could not start recording: ' + (startErr.message || 'unknown'), 'error');
                 if (recordingStream) { recordingStream.getTracks().forEach(function (t) { t.stop(); }); recordingStream = null; }
                 if (startRecBtn) { startRecBtn.style.display = ''; startRecBtn.disabled = false; }
                 voiceInputMode = 'idle';
                 return;
             }
             if (startRecBtn) startRecBtn.style.display = 'none';
             if (recordingStripArea) {
                 recordingStripArea.classList.remove('hidden');
                 recordingStripArea.classList.add('flex');
                 recordingStripArea.style.display = '';
             }
             if (stopRecBtn) stopRecBtn.disabled = false;
             voiceInputMode = 'file_record';
             var stsFile = document.getElementById('voiceRecordingStatusText');
             if (stsFile) stsFile.textContent = 'Recording file — press Stop to send for transcription';
         } catch (e) {
             var msg = (e.name === 'NotAllowedError' || e.name === 'PermissionDeniedError')
                 ? 'Microphone access was denied. Please allow microphone in your browser settings and try again.'
                 : (e.name === 'NotFoundError' || (e.message && e.message.toLowerCase().indexOf('device') !== -1))
                 ? 'No microphone found. Connect a microphone and refresh the page.'
                 : 'Microphone error: ' + (e.message || 'Please check your microphone and try again.');
             showNotification(msg, 'error');
             console.error('getUserMedia error:', e.name, e.message);
             if (startRecBtn) { startRecBtn.disabled = false; startRecBtn.style.display = ''; }
             voiceInputMode = 'idle';
         }
