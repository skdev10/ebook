         /** Legacy browsers / embedded WebViews may omit navigator.mediaDevices; map webkit/moz getUserMedia to a Promise API. */
         (function ebookPatchMediaDevicesGetUserMedia() {
             try {
                 if (typeof navigator === 'undefined') return;
                 if (!navigator.mediaDevices)
                     navigator.mediaDevices = {};
                 if (typeof navigator.mediaDevices.getUserMedia === 'function') return;
                 var legacy = navigator.webkitGetUserMedia || navigator.mozGetUserMedia || navigator.getUserMedia || navigator.msGetUserMedia;
                 if (typeof legacy !== 'function') return;
                 navigator.mediaDevices.getUserMedia = function (constraints) {
                     return new Promise(function (resolve, reject) {
                         legacy.call(navigator, constraints, resolve, reject);
                     });
                 };
             } catch (e) {
                 console.warn('[voice] mediaDevices polyfill:', e);
             }
         })();
         function ebookSpeechRecognitionCtor() {
             return window.SpeechRecognition || window.webkitSpeechRecognition;
         }
         function ebookHasLiveSpeechRecognition() {
             return typeof ebookSpeechRecognitionCtor() === 'function';
