/**
 * Prepends prior-chapter text (from loaded preview) so the API can stay consistent; user still only sees the new chapter streamed.
 * Keeps payload bounded.
 */
window.buildGenerateUserInputWithMemory = function (originalBrief) {
    var brief = (originalBrief == null ? '' : String(originalBrief)).trim();
    var list = window._previewChaptersMeta || [];
    if (!list.length || !brief) return brief;
    var maxTotal = 14000;
    var parts = [];
    var total = 0;
    for (var i = 0; i < list.length; i++) {
        var html = (list[i] && list[i].html) ? String(list[i].html) : '';
        var plain = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
        if (!plain) continue;
        if (plain.length > 4000) plain = plain.slice(0, 4000) + '…';
        var chunk = '[Prior chapter ' + (i + 1) + ' (continuity only — do not repeat in output):]\n' + plain;
        if (total + chunk.length + 200 > maxTotal) break;
        parts.push(chunk);
        total += chunk.length;
    }
    if (!parts.length) return brief;
    return parts.join('\n\n') + '\n\n---\n\n[Write ONLY the new chapter from this brief — pure narrative prose, no headings or meta:]\n' + brief;
};

window.updateChapterPreviewNavUI = function () {
    var nav = document.getElementById('chapterPreviewNav');
    var label = document.getElementById('chapterPreviewNavLabel');
    var prev = document.getElementById('btnPreviewChPrev');
    var next = document.getElementById('btnPreviewChNext');
    var fill = document.getElementById('chapterReadProgressFill');
    var idxBtn = document.getElementById('btnOpenChapterIndex');
    var pageInd = document.getElementById('aiWriterPageIndicator');
    var list = window._previewChaptersMeta || [];
    if (list.length === 0) {
        if (nav) nav.classList.add('hidden');
        if (pageInd) pageInd.classList.add('hidden');
        var psHide = document.getElementById('btnAiWriterPrevSide');
        var nsHide = document.getElementById('btnAiWriterNextSide');
        if (psHide) { psHide.style.visibility = 'hidden'; psHide.disabled = true; }
        if (nsHide) { nsHide.style.visibility = 'hidden'; nsHide.disabled = true; }
        if (typeof window.syncAiWriterPreviewLayout === 'function') {
            requestAnimationFrame(function () { window.syncAiWriterPreviewLayout(); });
        }
        return;
    }
    if (nav) nav.classList.add('hidden');
    var psShow = document.getElementById('btnAiWriterPrevSide');
    var nsShow = document.getElementById('btnAiWriterNextSide');
    if (psShow) psShow.style.visibility = '';
    if (nsShow) nsShow.style.visibility = '';
    var chIdx = window._previewChapterIndex || 0;
    var pgIdx = window._previewPageIndex || 0;
    var ch = list[chIdx] || {};
    var pageCount = (window._previewChapterPages && window._previewChapterPages.length) || 1;
    var chCount = list.length;
    if (label) {
        var chNum = (ch && ch.chapterNo != null && ch.chapterNo !== '') ? parseInt(ch.chapterNo, 10) : (chIdx + 1);
        if (!Number.isFinite(chNum)) chNum = chIdx + 1;
        var displayTitle = (typeof window.formatChapterDisplayName === 'function')
            ? window.formatChapterDisplayName(chNum, ch.title)
            : window.sanitizeChapterTitleForInput(ch.title);
        if (!displayTitle) displayTitle = 'Untitled';
        label.textContent = ch.loading
            ? ('Loading… ' + displayTitle)
            : (displayTitle + ' · Page ' + (pgIdx + 1) + ' / ' + pageCount);
    }
    if (pageInd) {
        if (ch.loading) {
            pageInd.classList.add('hidden');
        } else {
            pageInd.textContent = 'Page ' + (pgIdx + 1) + ' of ' + pageCount;
            pageInd.classList.remove('hidden');
        }
    }
    if (ch.loading) {
        if (prev) prev.disabled = true;
        if (next) next.disabled = true;
        var prevSideL = document.getElementById('btnAiWriterPrevSide');
        var nextSideL = document.getElementById('btnAiWriterNextSide');
        if (prevSideL) prevSideL.disabled = true;
        if (nextSideL) nextSideL.disabled = true;
        if (fill) fill.style.width = '0%';
        if (idxBtn) {
            idxBtn.style.display = chCount > 1 ? '' : 'none';
            idxBtn.disabled = chCount <= 1;
        }
        if (window._chapterIndexFlyoutOpen && typeof window.rebuildChapterIndexFlyoutList === 'function') {
            window.rebuildChapterIndexFlyoutList();
        }
        if (typeof window.syncAiWriterPreviewLayout === 'function') {
            requestAnimationFrame(function () { window.syncAiWriterPreviewLayout(); });
        }
        return;
    }
    if (prev) prev.disabled = (chIdx <= 0 && pgIdx <= 0);
    if (next) next.disabled = (chIdx >= chCount - 1 && pgIdx >= pageCount - 1);
    if (fill) {
        var frac = chCount ? ((chIdx + (pgIdx + 1) / pageCount) / chCount) : 0;
        fill.style.width = (Math.min(1, frac) * 100) + '%';
    }
    if (idxBtn) {
        idxBtn.style.display = chCount > 1 ? '' : 'none';
        idxBtn.disabled = chCount <= 1;
    }
    var prevSide = document.getElementById('btnAiWriterPrevSide');
    var nextSide = document.getElementById('btnAiWriterNextSide');
    if (prevSide) prevSide.disabled = !!prev && prev.disabled;
    if (nextSide) nextSide.disabled = !!next && next.disabled;
    if (window._chapterIndexFlyoutOpen && typeof window.rebuildChapterIndexFlyoutList === 'function') {
        window.rebuildChapterIndexFlyoutList();
    }
    if (typeof window.syncAiWriterPreviewLayout === 'function') {
        requestAnimationFrame(function () { window.syncAiWriterPreviewLayout(); });
    }
    if (typeof window.refreshAiWriterTotalPages === 'function') window.refreshAiWriterTotalPages();
};

/**
 * Bug #5: bind the preview card to the *selected* chapter (by chapterNo), so switching chapters
 * never leaves a stale chapter title/heading in the preview. No-op when preview has no chapters.
 */
window.syncPreviewToSelectedChapter = function (chapterNo) {
    if (!Number.isFinite(chapterNo)) return;
    var list = window._previewChaptersMeta || [];
    var idx = -1;
    for (var i = 0; i < list.length; i++) {
        var cn = (list[i] && list[i].chapterNo != null && list[i].chapterNo !== '')
            ? parseInt(list[i].chapterNo, 10) : (i + 1);
        if (cn === chapterNo) { idx = i; break; }
    }
    // A1 fix: if the selected chapter isn't present in the reader, load it so the
    // preview card title/content always follow the selected chapter — instead of
    // silently keeping the previously shown chapter's title.
    if (idx < 0) {
        var bidEl = document.getElementById('BookId');
        var bid = bidEl ? parseInt(bidEl.value, 10) : 0;
        if (bid > 0 && typeof window.loadChapterPreview === 'function') {
            window.loadChapterPreview(bid, chapterNo);
        }
        return;
    }
    if (idx === window._previewChapterIndex) return;
    if (typeof window.applyPreviewChapterIndex === 'function') {
        window.applyPreviewChapterIndex(idx, { initialPage: 0 });
    }
    if (typeof window.updateChapterPreviewNavUI === 'function') {
        window.updateChapterPreviewNavUI();
    }
};

/**
 * Show chapter idx in paginated viewport. opts.initialPage: 0-based page, or -1 = last page of chapter.
 */
window.applyPreviewChapterIndex = function (idx, opts) {
    opts = opts || {};
    var list = window._previewChaptersMeta;
    if (!list || !list.length) return;
    var i = Math.max(0, Math.min(idx, list.length - 1));
    window._previewChapterIndex = i;
    var ch = list[i] || {};
    var readerView = document.getElementById('readerViewport');
    var bookStage = document.getElementById('bookStage');
    var previewContent = document.getElementById('preview-content');
    var previewHeader = document.getElementById('preview-chapter-header');
    var wrap = document.getElementById('readerChaptersWrap');
    if (typeof BookReader !== 'undefined' && BookReader.hideStage) {
        BookReader.hideStage();
    }
    if (bookStage) bookStage.style.display = 'none';
    if (readerView) {
        readerView.classList.add('hidden');
        readerView.classList.remove('book-reader-active');
    }
    if (wrap) wrap.classList.add('hidden');
    if (previewContent) previewContent.classList.remove('hidden');
    if (previewHeader) {
        if (typeof window.showPreviewChapterChrome === 'function') {
            var chNumHdr = (ch && ch.chapterNo != null && ch.chapterNo !== '') ? parseInt(ch.chapterNo, 10) : (i + 1);
            if (!Number.isFinite(chNumHdr)) chNumHdr = i + 1;
            window.showPreviewChapterChrome(chNumHdr, ch.title);
        } else {
            previewHeader.classList.remove('hidden');
            previewHeader.setAttribute('aria-hidden', 'false');
            window.setPreviewChapterHeaderText(
                (typeof window.sanitizeChapterTitleForInput === 'function' ? window.sanitizeChapterTitleForInput(ch.title) : ch.title) || ''
            );
        }
    }
    var chNoSync = (ch && ch.chapterNo != null && ch.chapterNo !== '') ? parseInt(ch.chapterNo, 10) : NaN;
    if (!Number.isFinite(chNoSync)) chNoSync = i + 1;
    if (typeof window.syncChapterNoDropdownAndHidden === 'function') {
        window.syncChapterNoDropdownAndHidden(chNoSync);
    }
    if (ch && ch.html) {
        window._currentChapterContent = ch.html;
    }
    var titleForm = document.getElementById('Title');
    if (titleForm && ch && ch.title) {
        var cleanTitle = String(ch.title).replace(/^Chapter\s*\d+\s*[–\-:]\s*/i, '').trim();
        if (cleanTitle) titleForm.value = cleanTitle;
    }
    if (ch.loading) {
        window._previewChapterPages = [];
        if (previewContent) {
            previewContent.innerHTML = '<div class="reader-chapter-block"><p class="text-slate-600 flex items-center gap-2"><span class="animate-spin rounded-full h-5 w-5 border-2 border-violet-500 border-t-transparent inline-block" aria-hidden="true"></span> Loading chapter…</p></div>';
            previewContent.scrollTop = 0;
        }
        window.updateChapterPreviewNavUI();
        window.saveReaderBookState();
        window.requestAnimationFrame(function () {
            if (typeof window.scrollAiWriterChapterToTop === 'function') window.scrollAiWriterChapterToTop();
        });
        return;
    }
    if (typeof window.syncAiWriterPreviewLayout === 'function') {
        window.syncAiWriterPreviewLayout();
    }
    window.ensureChapterPagesForMeta(ch);

    function finishPreviewPageApply() {
        var pgs = window._previewChapterPages || [];
        var maxP = Math.max(0, pgs.length - 1);
        if (opts.initialPage === -1) {
            window._previewPageIndex = maxP;
        } else if (typeof opts.initialPage === 'number' && opts.initialPage >= 0) {
            window._previewPageIndex = Math.min(opts.initialPage, maxP);
        } else {
            window._previewPageIndex = Math.min(window._previewPageIndex || 0, maxP);
        }
        window.renderCurrentReaderPage();
        window.requestAnimationFrame(function () {
            if (typeof window.scrollAiWriterChapterToTop === 'function') window.scrollAiWriterChapterToTop();
        });
    }

    var shellEl = document.getElementById('paginatedReaderShell');
    var viewportEl = document.getElementById('preview-content');
    var maxHNow = typeof window.getReaderPageMaxHeight === 'function' && shellEl && viewportEl
        ? window.getReaderPageMaxHeight(shellEl, viewportEl) : 0;
    if (maxHNow < 48) {
        requestAnimationFrame(function () {
            if (typeof window.syncAiWriterPreviewLayout === 'function') window.syncAiWriterPreviewLayout();
            window.ensureChapterPagesForMeta(ch);
            finishPreviewPageApply();
        });
        return;
    }
    finishPreviewPageApply();
};

window.setPreviewChaptersFromList = function (meta, startChapterIndex, startPageIndex) {
    window._previewChaptersMeta = meta || [];
    var n = window._previewChaptersMeta.length;
    var resolved = 0;
    var resolvedPage = 0;
    var bidEl = document.getElementById('BookId');
    var bid = bidEl ? bidEl.value : '0';

    if (typeof startChapterIndex === 'number' && Number.isFinite(startChapterIndex)) {
        resolved = Math.max(0, Math.min(startChapterIndex, Math.max(0, n - 1)));
        if (typeof startPageIndex === 'number' && Number.isFinite(startPageIndex)) {
            resolvedPage = Math.max(0, startPageIndex);
        }
    } else if (n > 0) {
        var state = window.loadReaderBookState(bid);
        if (state && typeof state.ch === 'number' && state.ch >= 0 && state.ch < n) {
            resolved = state.ch;
            resolvedPage = Math.max(0, state.pg || 0);
        }
    }

    if (!n) {
        window._previewChapterIndex = 0;
        window._previewPageIndex = 0;
        window._previewChapterPages = [];
        window.updateChapterPreviewNavUI();
        return;
    }
    window.applyPreviewChapterIndex(resolved, { initialPage: resolvedPage });
};

window.previewChapterDelta = function (delta) {
    if (delta < 0) window.readerNavPrevious();
    else if (delta > 0) window.readerNavNext();
};

(function bindChapterPreviewNavButtons() {
    var p = document.getElementById('btnPreviewChPrev');
    var n = document.getElementById('btnPreviewChNext');
    var ps = document.getElementById('btnAiWriterPrevSide');
    var ns = document.getElementById('btnAiWriterNextSide');
    var idxBtn = document.getElementById('btnOpenChapterIndex');
    if (p) p.addEventListener('click', function () { window.readerNavPrevious(); });
    if (n) n.addEventListener('click', function () { window.readerNavNext(); });
    if (ps) ps.addEventListener('click', function () { window.readerNavPrevious(); });
    if (ns) ns.addEventListener('click', function () { window.readerNavNext(); });
    if (idxBtn) idxBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        var panel = document.getElementById('chapterIndexFlyout');
        if (panel && !panel.classList.contains('hidden')) window.closeChapterIndexFlyout();
        else window.openChapterIndexFlyout();
    });
    document.addEventListener('click', function (e) {
        if (!window._chapterIndexFlyoutOpen) return;
        var fly = document.getElementById('chapterIndexFlyout');
        var t = e.target;
        if (!fly || !t) return;
        if (fly.contains(t) || (idxBtn && idxBtn.contains(t))) return;
        window.closeChapterIndexFlyout();
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && window._chapterIndexFlyoutOpen) {
            e.preventDefault();
            window.closeChapterIndexFlyout();
            return;
        }
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        if (e.ctrlKey || e.metaKey || e.altKey) return;
        var t = e.target;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
        if (t && t.closest && t.closest('#chapterEditModal')) return;
        if (!window.readerHasNavigableSpread()) return;
        e.preventDefault();
        if (e.key === 'ArrowLeft') window.readerNavPrevious();
        else window.readerNavNext();
    });
    var _readerResizeTimer;
    window.addEventListener('resize', function () {
        clearTimeout(_readerResizeTimer);
        _readerResizeTimer = setTimeout(function () {
            if (typeof window.syncAiWriterPreviewLayout === 'function') window.syncAiWriterPreviewLayout();
            if (!(window._previewChaptersMeta && window._previewChaptersMeta.length)) return;
            var pc = document.getElementById('preview-content');
            if (!pc || pc.classList.contains('hidden')) return;
            window.invalidateReaderPageCaches();
            var ch = window._previewChaptersMeta[window._previewChapterIndex || 0];
            if (ch && !ch.loading) {
                window.ensureChapterPagesForMeta(ch);
                var maxP = Math.max(0, (window._previewChapterPages || []).length - 1);
                if ((window._previewPageIndex || 0) > maxP) window._previewPageIndex = maxP;
                window.renderCurrentReaderPage();
            }
        }, 300);
    });
})();

window.refreshFullBookPreviewFromWriter = function () {
    var uidEl = document.getElementById('UserId');
    var bidEl = document.getElementById('BookId');
    var uid = uidEl ? uidEl.value : '';
    var bid = bidEl ? bidEl.value : '';
    if (uid && bid && typeof window.loadFullBookIntoPageFlip === 'function') {
        window.loadFullBookIntoPageFlip(parseInt(uid, 10), parseInt(bid, 10));
    }
};
/** Call after selecting a book from the dropdown: loads full manuscript into “Your Chapter’s Preview” (scroll + chapter nav). */
window.previewFullBookFromBookSelection = function () {
    var uidEl = document.getElementById('UserId');
    var bidEl = document.getElementById('BookId');
    var ddl = document.getElementById('savedResponsesDropdown');
    var uid = uidEl ? uidEl.value : '';
    var bid = (bidEl && bidEl.value && bidEl.value !== '0') ? bidEl.value : (ddl && ddl.value ? ddl.value : '');
    if (!bid || bid === '0') {
        if (typeof showNotification === 'function') showNotification('Please select a book from the list first.', 'warning');
        else alert('Please select a book from the list first.');
        return;
    }
    if (!uid || uid === '0') {
        if (typeof showNotification === 'function') showNotification('User session missing. Please sign in again.', 'error');
        return;
    }
    if (bidEl && (!bidEl.value || bidEl.value === '0')) bidEl.value = String(bid);
    if (typeof window.loadFullBookIntoPageFlip === 'function') {
        window.loadFullBookIntoPageFlip(parseInt(uid, 10), parseInt(bid, 10));
    }
};
// Load full book into scroll preview and merge unsaved generation into the chapter list when requested
window.loadFullBookIntoPageFlip = function(uid, bid, opts) {
    if (!uid || !bid) return;
    opts = opts || {};
    fetch('/Books/GetFullBookContent?bookId=' + encodeURIComponent(bid))
        .then(function(r) {
            if (!r.ok) throw new Error('Failed to load book (' + r.status + ')');
            return r.json();
        })
        .then(function(data) {
            if (!data || !data.success) {
                var msg = (data && data.message) ? data.message : 'Could not load book content.';
                if (typeof showNotification === 'function') showNotification(msg, 'error');
                return;
            }
            var chapters = (data.chapters || []).slice().sort(function(a, b) {
                return (parseInt(a.chapterNo, 10) || 0) - (parseInt(b.chapterNo, 10) || 0);
            });
            if (chapters.length === 0 && !opts.mergeBookData) return;
            var phBase = {
                bookTitle: (data.bookTitle && String(data.bookTitle)) || '',
                subtitle: (data.subtitle && String(data.subtitle)) || '',
                description: (data.description && String(data.description)) || '',
                genre: (data.genre && String(data.genre)) || '',
                authorName: (data.authorName && String(data.authorName)) || ''
            };
            try { window._aiBookPreviewContext = Object.assign({}, phBase); } catch (e) {}
            var ap = window.applyTemplatePlaceholders;
            var chaptersMeta = [];
            var fmt = window.formatManuscriptBodyToHtml;
            var esc = window.escapeHtml || function(x) {
                return String(x == null ? '' : x).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            };
            chapters.forEach(function(ch, idx) {
                var titleRaw = (ch.chapterTitle || '').trim();
                var chNo = parseInt(ch.chapterNo, 10);
                if (!Number.isFinite(chNo)) chNo = idx + 1;
                var narrativeNum = (function(list, i) {
                    var cn0 = parseInt(list[i].chapterNo, 10);
                    if (!Number.isFinite(cn0) || cn0 <= 0) return null;
                    var n = 0;
                    for (var j = 0; j <= i; j++) {
                        var cn = parseInt(list[j].chapterNo, 10);
                        if (Number.isFinite(cn) && cn > 0) n++;
                    }
                    return n;
                })(chapters, idx);
                var phCtx = Object.assign({}, phBase, {
                    chapterTitle: titleRaw,
                    chapterNumber: chNo,
                    displayChapterNumber: narrativeNum != null ? narrativeNum : ''
                });
                var title = typeof ap === 'function' ? ap(titleRaw, phCtx) : titleRaw;
                var headingHtml = typeof window.buildPreviewChapterHeadingHtml === 'function'
                    ? window.buildPreviewChapterHeadingHtml(title, esc)
                    : '';
                var bodyRaw = ch.content || '';
                var body = typeof ap === 'function' ? ap(bodyRaw, phCtx) : bodyRaw;
                body = typeof window.normalizeManuscriptEscapes === 'function' ? window.normalizeManuscriptEscapes(body) : body;
                var bodyHtml = typeof fmt === 'function' ? fmt(body) : ('<p class="manuscript-p">' + esc(String(body)) + '</p>');
                var fragment = headingHtml + bodyHtml;
                var plain = fragment.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
                var wc = plain.split(/\s+/).filter(Boolean).length;
                var cleanTitle = window.sanitizeChapterTitleForInput ? window.sanitizeChapterTitleForInput(title) : title;
                chaptersMeta.push({ html: fragment, title: cleanTitle || title || '', wordCount: wc, chapterNo: chNo });
            });
            var startIdx = 0;
            var startPg = 0;
            if (opts.mergeBookData && typeof window.patchPreviewMetaArrayWithGeneration === 'function') {
                startIdx = window.patchPreviewMetaArrayWithGeneration(chaptersMeta, opts.mergeBookData, phBase);
                startPg = 0;
            } else if (typeof opts.startIndex === 'number') {
                startIdx = opts.startIndex;
                startPg = typeof opts.startPageIndex === 'number' ? Math.max(0, opts.startPageIndex) : 0;
            } else if (typeof window.loadReaderBookState === 'function') {
                var st = window.loadReaderBookState(String(bid));
                if (st && typeof st.ch === 'number' && st.ch >= 0 && st.ch < chaptersMeta.length) {
                    startIdx = st.ch;
                    startPg = Math.max(0, st.pg || 0);
                }
            }
            var readerView = document.getElementById('readerViewport');
            var bookStage = document.getElementById('bookStage');
            var previewContent = document.getElementById('preview-content');
            if (!previewContent) return;
            if (typeof BookReader !== 'undefined' && BookReader.hideStage) {
                BookReader.hideStage();
            }
            if (bookStage) bookStage.style.display = 'none';
            if (readerView) {
                readerView.classList.add('hidden');
                readerView.classList.remove('book-reader-active');
            }
            var wrap = document.getElementById('readerChaptersWrap');
            if (wrap) wrap.classList.add('hidden');
            previewContent.classList.remove('hidden');
            setTimeout(function() {
                if (typeof window.setPreviewChaptersFromList === 'function') {
                    window.setPreviewChaptersFromList(chaptersMeta, startIdx, startPg);
                }
                var brScroll = document.getElementById('bookResult');
                if (brScroll) brScroll.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 50);
            if (data.bookTitle) {
                var tEl = document.getElementById('preview-book-title');
                if (tEl) {
                    var disp = typeof window.applyTemplatePlaceholders === 'function'
                        ? window.applyTemplatePlaceholders(String(data.bookTitle), phBase)
                        : data.bookTitle;
                    tEl.textContent = disp;
                }
            }
        })
        .catch(function (err) {
            console.error('loadFullBookIntoPageFlip', err);
            var m = (err && err.message) ? err.message : 'Network error loading book.';
            if (typeof showNotification === 'function') showNotification(m, 'error');
        });
};
document.addEventListener('DOMContentLoaded', function() {
    try {
        var freshQp = new URLSearchParams(window.location.search);
        if (freshQp.get('fresh') === '1' && window.EditorDraftReset) {
            var bid = parseInt(document.getElementById('BookId')?.value || '0', 10);
            if (bid > 0) window.EditorDraftReset.clearAllClientState(bid);
            freshQp.delete('fresh');
            var clean = window.location.pathname + (freshQp.toString() ? '?' + freshQp.toString() : '');
            window.history.replaceState({}, '', clean);
        }
    } catch (_) { /* no-op */ }
    var userId = @userId;
    if (typeof window.syncAiWriterPreviewLayout === 'function') {
        window.syncAiWriterPreviewLayout();
        window.addEventListener('load', function onAiWriterLayoutBoot() {
            window.removeEventListener('load', onAiWriterLayoutBoot);
            requestAnimationFrame(function () {
                window.syncAiWriterPreviewLayout();
                requestAnimationFrame(function () { window.syncAiWriterPreviewLayout(); });
            });
        });
        var sidebarEl = document.querySelector('.ai-writer-sidebar');
        if (sidebarEl && typeof ResizeObserver !== 'undefined') {
            var sidebarRo = new ResizeObserver(function () {
                window.syncAiWriterPreviewLayout();
            });
            sidebarRo.observe(sidebarEl);
            var metaElRo = document.querySelector('.ai-writer-preview-meta');
            if (metaElRo) sidebarRo.observe(metaElRo);
            var stackEl = document.querySelector('.ai-writer-preview-stack');
            if (stackEl) sidebarRo.observe(stackEl);
            var topicBoxRo = document.getElementById('chapterTopicBox');
            if (topicBoxRo) sidebarRo.observe(topicBoxRo);
        }
        var bookResultEl = document.getElementById('bookResult');
        if (bookResultEl && typeof ResizeObserver !== 'undefined') {
            var previewRo = new ResizeObserver(function () {
                window.syncAiWriterPreviewLayout();
            });
            previewRo.observe(bookResultEl);
        }
    }
    var nextBtn = document.getElementById('btnNextStep');
    var savedDdl = document.getElementById('savedResponsesDropdown');

    function getCurrentBookId() {
        var bidEl = document.getElementById('BookId');
        var fromField = (bidEl && bidEl.value) ? String(bidEl.value).trim() : '';
        if (fromField && fromField !== '0') return fromField;
        var ddl = document.getElementById('savedResponsesDropdown');
        if (ddl && ddl.value && String(ddl.value).trim() !== '0') return String(ddl.value).trim();
        return '';
    }
    function navigateToBookFormatting(bid, fmt) {
        var url = '/BookDesign/CoverDesignCalculatorFixing?bookId=' + encodeURIComponent(bid);
        if (fmt) url += '&format=' + encodeURIComponent(fmt);
        window.location.href = url;
    }
    function goToCoverDesign(bookId, format) {
        var bid = (bookId && String(bookId).trim() !== '0') ? String(bookId).trim() : getCurrentBookId();
        if (!bid || bid === '0') {
            if (typeof showNotification === 'function') showNotification('Please select or generate a book first.', 'error');
            else alert('Please select or generate a book first.');
            return;
        }
        var bookIdInput = document.getElementById('BookId');
        if (bookIdInput) bookIdInput.value = bid;
        var ddl = document.getElementById('savedResponsesDropdown');
        if (ddl) ddl.value = bid;
        if (typeof window.persistFormatterBookId === 'function') window.persistFormatterBookId(bid);
        var fmt = format || 'Ebook';
        fetch('/Books/EnterBookFormatting', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ bookId: parseInt(bid, 10) || 0, format: fmt })
        }).then(function (r) {
            if (r.status === 401) {
                if (typeof showNotification === 'function') showNotification('Session expired. Please sign in again.', 'error');
                else alert('Session expired. Please sign in again.');
                return null;
            }
            return r.json().catch(function () { return null; });
        }).then(function (data) {
            if (data && data.success && data.redirectUrl) {
                window.location.href = data.redirectUrl;
                return;
            }
            if (data && data.message && typeof showNotification === 'function') {
