     //==================================
     // Hit API for the edit request
     //=================================
       async function processEditRequest(requestData) {

          console.log("📨 Step 5: Execute processEditRequest() to POST Request:");
            const messageElement = document.getElementById('processingMessage');
            var controller = null;
            var timeoutId = null;
         try {
             if (typeof window.showChapterGenerationOverlay === 'function') {
                 window.showChapterGenerationOverlay('Applying edits…');
             }
             controller = new AbortController();
             timeoutId = setTimeout(function () { controller.abort(); }, 180000);
             const response = await fetch('/Books/EditChapter', {
                 method: 'POST',
                 headers: { 'Content-Type': 'application/json' },
                 body: JSON.stringify(requestData),
                 credentials: 'same-origin',
                 signal: controller.signal
             });
             if (timeoutId) { clearTimeout(timeoutId); timeoutId = null; }

             console.log("📨 Step 6: Received the response from API:", response.status);
             var responseText = await response.text();
             var bookData = {};
             if (responseText && responseText.trim()) {
                 try { bookData = JSON.parse(responseText); } catch (_) { bookData = { raw: responseText }; }
             }

            if (response.ok) {
                 console.log("✅ Edit response:", bookData);
                 var errFlag = bookData && (bookData.error === true || bookData.Error === true || bookData.success === false || bookData.Success === false);
                 if (errFlag) {
                     var emsg = (bookData.message || bookData.Message || bookData.detail || 'Edit failed.').toString();
                     throw new Error(emsg);
                 }

                 document.getElementById('APIRawResponse').value =
                     typeof bookData === 'object' && bookData !== null ? JSON.stringify(bookData) : responseText;
                 var rid = bookData.responseId || bookData.response_id;
                 var ridEl = document.getElementById('ResponseId');
                 if (ridEl && rid != null && rid !== '') ridEl.value = String(rid);

                 if (typeof showGeneratedChapterWithTyping === 'function') {
                     showGeneratedChapterWithTyping(bookData, function () {
                         if (typeof window.refreshFullBookPreviewFromWriter === 'function') window.refreshFullBookPreviewFromWriter();
                         loadSavedBooksDropdown();
                         if (typeof showNotification === 'function') showNotification('Edits applied. Preview updated.', 'success');
                         checkAndDisableButtonsForReadOnly("Edit");
                         if (rid && typeof refreshChapterIterationsDropdown === 'function')
                             refreshChapterIterationsDropdown(String(rid));
                     });
                 } else {
                     if (typeof window.refreshFullBookPreviewFromWriter === 'function') window.refreshFullBookPreviewFromWriter();
                     loadSavedBooksDropdown();
                     showNotification('Edits applied. Draft updated — lock official text on Book formatting.', 'success');
                     checkAndDisableButtonsForReadOnly("Edit");
                 }
             } else {
                 console.error("❌ Step 8: Server returned error:", responseText);
                 throw new Error(parseApiErrorMessage(responseText) || 'Failed to edit chapter');
             }
         } catch (error) {
             console.error("🔥 Step 9: Exception occurred:", error);
             const chatContainer = document.getElementById("chatContainer");
             if (chatContainer && typeof addMessage === 'function') {
                 addMessage(`❌ Sorry, I encountered an error: ${error.message}`);
             }
            showNotification('Failed to edit chapter: ' + (error && error.message ? error.message : 'Unknown error'), 'error');
         } finally {
             if (timeoutId) { clearTimeout(timeoutId); timeoutId = null; }
             if (typeof window.hideChapterGenerationOverlay === 'function') window.hideChapterGenerationOverlay();
             if (typeof hideGenerateLoading === 'function') hideGenerateLoading();
             enableControls();
             if (messageElement) {
                 messageElement.classList.add('hidden');
                 messageElement.classList.remove('flex');
             }
             var editBtnEl = document.getElementById('EditBtn');
             if (editBtnEl) editBtnEl.disabled = false;
         }
     }
