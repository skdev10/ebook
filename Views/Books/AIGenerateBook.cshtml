<div class="dash-flow-page">
    <main class="dash-flow-main">
        <div class="ai-writer-page-wrap dash-flow-inner flex flex-col min-h-0" data-aos="fade-up" data-aos-duration="500">
        <div class="ai-writer-main-layout book-preview-layout-row dash-flow-grid dash-flow-grid--writer w-full flex flex-col lg:flex-row min-h-0">
        <!-- Left Column: Forms -->
        <div class="ai-writer-sidebar book-preview-layout-sidebar w-full flex flex-col gap-2 shrink-0 min-h-0">
            <section class="flex flex-col gap-3" data-guided-tour="ai-book-picker">
                @await Html.PartialAsync("_FlowStepper", 1)
                <div class="hidden-fields sr-only" aria-hidden="true">
                    <label for="UserId">UserId:</label>
                    <input type="text" id="UserId" value="@ViewBag.UserId">
                    <label for="BookId">BookId:</label>
                    <input type="text" id="BookId" value="@(selectedBookId ?? 0)">
                    <button type="button" id="btnSaveChapterName" class="hidden" tabindex="-1" aria-hidden="true"></button>
                    <label for="ResponseId">ResponseId:</label>
                    <input type="text" id="ResponseId" value="0">
                    <label for="ChapterNo">ChapterNo:</label>
                    <input type="text" id="ChapterNo" value="1">
                    <label for="Title">ChapterTitle:</label>
                    <input type="hidden" id="Title" value="" maxlength="200">
                    <select id="savedResponsesDropdown" tabindex="-1"><option value="@(selectedBookId ?? 0)" selected>@selectedBookTitle</option></select>
                    <button type="button" id="bookSelectionPreviewBtn" tabindex="-1"></button>
                    <button type="button" id="createBookBtn" tabindex="-1"></button>
                </div>
            </section>


            <hr class="border-slate-200/80 my-1 hidden" aria-hidden="true">

            <div id="chapterWorkflowProgress" class="chapter-workflow-progress hidden" role="status" aria-live="polite" aria-hidden="true" style="display:none !important;">
                <span id="chapterWorkflowProgressText">Ready to Write</span>
                <span id="chapterFinalizedBadge" class="chapter-finalized-badge hidden" aria-hidden="true"><i class="fas fa-lock text-[9px]" aria-hidden="true"></i> Finalized</span>
            </div>

            <section class="flex flex-col gap-3" data-guided-tour="ai-write-section">
                <h2 class="font-serif-custom text-xl font-medium tracking-tight text-slate-800">Write a New Book</h2>
                <div class="flex flex-col gap-2">
                    <label class="text-sm font-medium text-slate-500">Book Title</label>
                    <input type="text" id="BookTitle" value="@initialBookTitle" placeholder="Enter Book Title" class="form-input-uniform w-full bg-white border border-slate-200 rounded-xl px-4 py-3.5 text-base text-slate-800 placeholder:text-slate-300 focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400 transition-all shadow-sm">
                </div>
                <div class="flex flex-col gap-2">
                    <label class="text-sm font-medium text-slate-500">Chapter No.</label>
                    <div class="chapter-no-input-group flex w-full rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden focus-within:ring-2 focus-within:ring-purple-400 focus-within:border-purple-400 transition-all">
                        <select id="ChapterDropdown" class="chapter-no-select flex-1 min-w-[100px] appearance-none bg-transparent border-0 px-4 py-3.5 pr-8 text-base text-slate-700 focus:outline-none focus:ring-0 cursor-pointer" onchange="loadBookChapterNos(this.value)">
                            <option value="1" selected>Click “Add a chapter” to start →</option>
                        </select>
                        <span class="flex items-center px-2 text-slate-400 pointer-events-none"><i class="fas fa-chevron-down text-sm"></i></span>
                        <button id="addChapterBtn" type="button" class="add-chapter-btn-inline inline-flex items-center justify-center shrink-0 px-3 text-xs font-semibold text-white bg-purple-600 hover:bg-purple-700 border-l border-slate-200 transition-colors whitespace-nowrap" onclick="addNewChapter()" title="Add a new chapter" aria-label="Add a chapter">Add a chapter</button>
                    </div>
                    <div class="flex flex-col gap-2 pt-1 hidden" id="iterationPickerWrap">
                        <div id="chapterVersionsSummary" class="hidden rounded-lg border border-emerald-200/70 bg-emerald-50/90 px-2.5 py-2 text-xs text-emerald-900" role="status" aria-live="polite">
                            <span id="chapterVersionsSummaryText"></span>
                        </div>
                        <label class="text-sm font-medium text-slate-500">Version history</label>
                        <div class="iteration-select-wrap">
                            <select id="IterationDropdown" class="form-input-uniform w-full bg-white border border-slate-200 rounded-xl px-4 py-3 text-base text-slate-800 focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400 shadow-sm" onchange="onChapterIterationSelected(this.value)" title="Draft versions for this chapter only (newest at bottom)">
                                <option value="">— Generate to create v1 —</option>
                            </select>
                            <span class="iteration-select-chevron" aria-hidden="true"><i class="fas fa-chevron-down text-sm"></i></span>
                        </div>
                        <button type="button" id="btnFinalizeChapterVersion" class="inline-flex items-center justify-center gap-2 self-start rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2.5 shadow-sm shadow-emerald-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" title="Make the selected version the current (finalized) version of this chapter"><i class="fas fa-check-circle text-xs" aria-hidden="true"></i> Set as current version</button>
                    </div>
                    <div class="flex flex-wrap items-center gap-3 pt-1 status-display-none">
                        <span class="text-sm text-slate-500">Status:</span>
                        <input type="text" id="Status" value="OK" readonly class="form-input-uniform flex-1 min-w-[120px] px-4 font-semibold text-red-600 bg-white border border-slate-200 rounded-xl">
                    </div>
                </div>
            </section>

            <section class="flex flex-col gap-2" data-guided-tour="ai-topic-generate">
                <div>
                    <h2 class="font-serif-custom text-2xl font-medium tracking-tight text-slate-800 m-0">Chapter topic / brief</h2>
                    <p id="chapterTitleTopicHint" class="text-xs text-slate-400 mt-1 mb-0">Enter a chapter title first.</p>
                </div>
                <div id="chapterTopicBox" class="relative flex flex-col bg-white border border-slate-200 rounded-2xl shadow-sm focus-within:border-purple-400 focus-within:ring-1 focus-within:ring-purple-400 transition-all overflow-hidden min-h-[240px]">
                    <textarea id="UserInput" placeholder="e.g. A short summary of what this chapter should cover" class="form-input-uniform w-full flex-1 resize-none bg-transparent px-5 py-3 text-base text-slate-600 placeholder:text-slate-400 focus:outline-none min-h-[280px]"></textarea>
                    <div class="bg-slate-50/80 p-1.5 mx-1 mb-1 rounded-xl flex items-center justify-end gap-2 border border-slate-100">
                        <input type="file" id="chapterImportFileInput" accept=".pdf,.txt,.text,.md,.markdown,.docx,application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="hidden" aria-label="Upload document (PDF, Word, TXT, or Markdown)" />
                        <button type="button" id="chapterDocUploadBtn" class="inline-flex items-center justify-center text-xs font-semibold text-slate-700 hover:text-violet-900 px-3.5 py-2 rounded-xl border border-slate-200 bg-white hover:bg-violet-50 hover:border-violet-300 transition-all shadow-sm disabled:opacity-50 disabled:cursor-not-allowed" title="Upload PDF, Word (.docx), TXT, or Markdown — preview updates automatically" aria-label="Upload docs">
                            Upload docs
                        </button>
                        <button type="button" id="GenerateBtn" class="inline-flex items-center justify-center text-xs font-semibold text-white px-3.5 py-2 rounded-xl bg-purple-600 hover:bg-purple-700 shadow-sm transition-all hover:scale-[1.02] shrink-0 disabled:opacity-50 disabled:cursor-not-allowed" title="Generate chapter" aria-label="Generate chapter" onclick="confirmGenerateChapter()">
                            <span id="GenerateBtnLabel">Generate</span>
                        </button>
                    </div>
                    <button type="button" id="EditBtn" class="hidden" tabindex="-1" aria-hidden="true" onclick="openChapterEditModal()"></button>
                </div>
                <div id="processingMessage" class="hidden items-center gap-3 p-3 rounded-xl bg-blue-50 border border-blue-200 text-blue-800 text-sm font-medium my-2" role="status" aria-live="polite">
                    <span class="animate-spin rounded-full h-5 w-5 border-2 border-blue-500 border-t-transparent shrink-0"></span>
                    <span id="processingMessageText">Generating your chapter…</span>
                </div>
                <div id="chapterEditPanel" class="chapter-edit-panel" style="display: none;">
                    <div id="chapterEditHelp" class="chapter-edit-help">
                        <strong>Editing syntax</strong><br>
                        Chapter title: <code># Chapter Title</code><br>
                        Section heading: <code>## Section Title</code><br>
                        Paragraph: normal text<br>
                        <strong>Bold:</strong> <code>**Bold Text**</code><br>
                        <em>Italic:</em> <code>*Italic Text*</code>
                    </div>
                    <p class="chapter-edit-notice"><i class="fas fa-info-circle text-purple-500"></i> Save draft here; official chapter lock &amp; PDF — <strong>Book formatting</strong> page par last step.</p>
                </div>
                <p id="writerAutoSaveStatus" class="text-xs text-slate-400 leading-relaxed" aria-live="polite"></p>
                <input type="hidden" id="APIRawResponse">

                <div class="ai-writer-sticky-actions" data-guided-tour="ai-next-step">
                    <button type="button" id="btnNextStep" class="btn-book-formatting" disabled title="Select a book first">
                        <span>Book formatting</span>
                        <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
                    </button>
                </div>
            </section>
        </div>

        <div class="ai-writer-preview-stack book-preview-layout-preview flex flex-col min-w-[300px] min-h-0 flex-1 w-full">
            <div class="ai-writer-preview-pane w-full flex flex-col min-h-0 flex-1">
            <div class="ai-writer-preview-column w-full flex flex-col gap-4 min-h-0 flex-1">
            <div class="ai-writer-preview-meta flex flex-col gap-2 mb-4 shrink-0">
                <div class="flex items-center gap-2 text-sm font-semibold text-violet-600 tracking-wide">
                    <span class="h-px w-4 bg-violet-500 shrink-0"></span>
                    Ebook AI
                </div>
                <h1 id="preview-book-title" class="font-serif-custom text-2xl lg:text-[1.65rem] font-medium tracking-tight text-slate-900 transition-all duration-300 m-0">Your Chapter's Preview</h1>
                <p class="preview-intro-desc text-sm text-slate-500 leading-relaxed m-0">
                    Your manuscript appears as a paginated ebook page. Use the side arrows to turn pages.
                </p>
                <div id="chatContainer" class="chat-container hidden flex-col flex-shrink-0" aria-live="polite"></div>
            </div>
            <!-- Side-by-side preview (edit mode: Original | Regenerated) -->
            <div id="sideBySidePreview" class="preview-side-by-side hidden mb-6">
                <div class="preview-side-panel">
                    <h4><i class="fas fa-book-open text-slate-500 mr-2"></i> Original</h4>
                    <div id="sideBySideOriginal" class="preview-side-body"></div>
                </div>
                <div class="preview-side-panel">
                    <h4><i class="fas fa-magic text-purple-500 mr-2"></i> Regenerated</h4>
                    <div id="sideBySideNew" class="preview-side-body"></div>
                </div>
            </div>
            <div id="bookResult" class="relative flex flex-col min-h-0 flex-1 ai-writer-ebook-preview-wrap" data-guided-tour="ai-preview-panel">
                <div id="chapterGenerationOverlay" class="chapter-generation-overlay hidden" role="status" aria-live="polite">
                    <div class="animate-spin rounded-full h-12 w-12 border-4 border-violet-200 border-t-violet-600"></div>
                    <p id="chapterGenerationOverlayText" class="text-slate-800 font-semibold text-center">Writing…</p>
                </div>
                <div id="bookResultStatusBanner" class="hidden mb-4 rounded-xl border border-violet-300/80 bg-violet-50/95 px-4 py-3 text-sm text-slate-800 shadow-sm leading-relaxed" role="status" aria-live="polite"></div>
                <div id="bookResultContent" class="book-result-content flex flex-col flex-1 min-h-0">
                    <div id="chapterPreviewScrollHost" class="chapter-preview-scroll-host book-preview-stage min-h-0 flex-1 flex flex-col">
                    <div id="paginatedReaderShell" class="paginated-reader-shell book-page-preview-shell">
                    <h3 id="preview-chapter-header" class="tracking-tight shrink-0 flex items-center gap-2 group hidden" aria-hidden="true">
                        <span id="preview-chapter-header-text" class="min-w-0 ai-writer-chapter-title-text"></span>
                    </h3>
                    <div id="preview-content" class="chapter-preview-viewport book-page-preview-content flex flex-col text-base text-slate-700 leading-relaxed"></div>
                    <button type="button" id="btnAiWriterPrevSide" class="book-preview-nav-side book-preview-nav-side-prev ai-writer-preview-side-nav ai-writer-preview-side-prev" aria-label="Previous page" title="Previous page"><i class="fas fa-chevron-left w-4 h-4" aria-hidden="true"></i></button>
                    <button type="button" id="btnAiWriterNextSide" class="book-preview-nav-side book-preview-nav-side-next ai-writer-preview-side-nav ai-writer-preview-side-next" aria-label="Next page" title="Next page"><i class="fas fa-chevron-right w-4 h-4" aria-hidden="true"></i></button>
                    </div>
                    <div id="aiWriterPageIndicator" class="ai-writer-page-indicator hidden" style="display:none !important;" aria-live="polite">Page 1 of 1</div>
                    <div id="aiWriterTotalPages" class="ai-writer-total-pages hidden" style="display:none !important;" aria-live="polite">
                        <i class="fas fa-book text-[11px]" aria-hidden="true"></i>
                        <span>Total pages: <strong id="aiWriterTotalPagesValue">—</strong></span>
                    </div>
                    <div id="previewMeasureHost" class="preview-measure-host book-page-preview-measure" aria-hidden="true"></div>
                    <div id="readerViewport" class="hidden">
                        <div id="readerChaptersWrap" class="reader-chapters-wrap hidden flex flex-col gap-4"></div>
                        <div id="bookStage" class="book-stage" style="display: none;">
                            <div id="bookContainer" class="book-container">
                                <div id="pageLayerA" class="book-page-layer" aria-hidden="false">
                                    <div class="book-page-background"></div>
                                    <div class="book-page-content-wrap">
                                        <div id="bookPageContentA" class="book-page-content" role="article"></div>
                                        <div id="bookPageFooterA" class="book-page-footer"></div>
                                    </div>
                                </div>
                                <div id="pageLayerB" class="book-page-layer book-page-layer-off" aria-hidden="true">
                                    <div class="book-page-background"></div>
                                    <div class="book-page-content-wrap">
                                        <div id="bookPageContentB" class="book-page-content" role="article"></div>
                                        <div id="bookPageFooterB" class="book-page-footer"></div>
                                    </div>
                                </div>
                            </div>
                            <button type="button" id="bookNavPrev" class="book-nav-zone book-nav-prev" aria-label="Previous page" title="Previous page"></button>
                            <button type="button" id="bookNavNext" class="book-nav-zone book-nav-next" aria-label="Next page" title="Next page"></button>
                            <div id="bookPageIndicator" class="book-page-indicator" aria-live="polite">1 / 1</div>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
            </div>
            </div>
        </div>
        </div>
    </main>
</div>

<!-- Notification Container (for showNotification) -->
<div id="notificationContainer" class="fixed top-4 right-4 z-[10000] flex flex-col gap-2 max-w-sm"></div>

<!-- Create Book Modal - full form (no Category/Tags), all optional, save to DB then redirect -->
<div id="createBookModal" class="create-book-modal-overlay" style="display: none;">
    <div class="create-book-modal-box create-book-modal-scroll" onclick="event.stopPropagation()">
        <div class="create-book-modal-header">
            <div class="modal-icon"><i class="fas fa-book-open"></i></div>
            <h3>Create New Book</h3>
            <p class="text-sm text-slate-500 mt-1">Enter a title (optional). Book will be saved to your library.</p>
        </div>
        <div class="create-book-modal-body">
            <div class="create-book-form-group">
                <label class="create-book-label">Book Title <span class="text-slate-400 font-normal">(Optional)</span></label>
                <input type="text" id="createBookModalTitle" class="create-book-input form-input-uniform" placeholder="Enter book title">
            </div>
        </div>
        <div class="create-book-modal-actions">
            <button type="button" id="createBookModalCancel" class="btn btn-confirm-no">Cancel</button>
            <button type="button" id="createBookModalConfirm" class="btn btn-confirm-yes"><i class="fas fa-save mr-1"></i> Create Book</button>
        </div>
    </div>
</div>
<!-- Confirmation Modal - theme-matched outstanding UI -->
<div id="confirmationModal">
    <div class="confirmation-modal-box">
        <div class="confirmation-modal-header">
            <div class="confirmation-modal-icon">
                <i class="fas fa-question"></i>
            </div>
            <h3 class="confirmation-modal-title">Confirm Action</h3>
        </div>
        <div class="confirmation-modal-body">
            <p id="confirmationModalMessage">Are you sure you want to proceed?</p>
        </div>
        <div class="confirmation-modal-actions">
            <button type="button" id="confirmNo" class="btn btn-confirm-no">No</button>
            <button type="button" id="confirmYes" class="btn btn-confirm-yes">Yes</button>
        </div>
    </div>
</div>
<!-- Generate confirmation modal - theme matched -->
<div id="generateConfirmModal">
    <div class="generate-confirm-modal-box">
        <div class="generate-confirm-modal-header">
            <div class="generate-confirm-modal-icon">
                <i class="fas fa-magic"></i>
            </div>
            <h3 class="generate-confirm-modal-title">Generate Chapter</h3>
        </div>
        <div class="generate-confirm-modal-body">
            <p>This chapter will be generated based on your chapter brief. Generation usually takes a few minutes.</p>
            <p id="generateConfirmEtaHint" class="text-sm text-violet-700 mt-2 mb-0 font-medium"></p>
        </div>
        <div class="generate-confirm-modal-actions">
            <button type="button" id="generateConfirmCancel" class="btn btn-generate-cancel">Cancel</button>
            <button type="button" id="generateConfirmYes" class="btn btn-generate-yes"><span id="generateConfirmYesLabel">Generate</span></button>
        </div>
    </div>
</div>

<!-- Chapter rename modal -->
<div id="chapterRenameModal" class="create-book-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="chapterRenameModalTitle">
    <div class="create-book-modal-box" onclick="event.stopPropagation()">
        <div class="create-book-modal-header">
            <div class="modal-icon"><i class="fas fa-pen"></i></div>
            <h3 id="chapterRenameModalTitle">Rename chapter</h3>
            <p class="text-sm text-slate-500 mt-1">This name is saved permanently for this chapter.</p>
        </div>
        <div class="create-book-modal-body">
            <div class="create-book-form-group">
                <label class="create-book-label" for="chapterRenameModalInput">Chapter name</label>
                <input type="text" id="chapterRenameModalInput" class="create-book-input form-input-uniform" maxlength="200" placeholder="Enter chapter name">
            </div>
        </div>
        <div class="create-book-modal-actions">
            <button type="button" id="chapterRenameModalCancel" class="btn btn-confirm-no">Cancel</button>
            <button type="button" id="chapterRenameModalSave" class="btn btn-confirm-yes"><i class="fas fa-save mr-1"></i> Save</button>
        </div>
    </div>
</div>

<!-- Chapter Edit Modal: outstanding UI, full interaction, save to DB -->
<div id="chapterEditModal" class="chapter-edit-modal-overlay fixed inset-0 z-[9999] hidden items-center justify-center p-4" style="display: none;">
    <div class="chapter-edit-modal-box relative bg-white rounded-3xl shadow-2xl max-w-5xl w-full max-h-[92vh] overflow-hidden flex flex-col mx-auto border-0" onclick="event.stopPropagation()">
        <div class="chapter-edit-modal-header flex items-center justify-between px-6 py-5 text-white" style="background-color:#5b21b6;">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center"><i class="fas fa-pen-fancy text-lg"></i></div>
                <div>
                    <h3 class="text-xl font-bold tracking-tight">Edit Chapter</h3>
                    <p class="text-white/90 text-sm font-normal mt-0.5">Apply changes or refine with AI, then save to database</p>
                </div>
            </div>
            <button type="button" id="chapterEditModalClose" class="p-2.5 rounded-xl hover:bg-white/20 text-white transition-colors" aria-label="Close"><i class="fas fa-times text-lg"></i></button>
        </div>
