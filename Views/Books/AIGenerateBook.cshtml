                     addMessage('The server responded but no chapter text was found. Compare your Postman JSON to fields: data.content, content, chapters[0].content, text. ' + (detail ? ('Server note: ' + detail) : ''), false);
                 }
                 if (typeof showNotification === 'function') showNotification('No chapter text in response — check chat / API shape.', 'error');
                 if (typeof onDone === 'function') onDone();
                 return;
             }
             var idx = 0;
             // Faster typing simulation for typical chapters; very long chapters skip animation so preview + Finalize are usable immediately.
             var CHARS_PER_FRAME = 28;
             function finalizeFormattedBody() {
                 var bodyForFmt = typeof applyTemplatePlaceholders === 'function' ? applyTemplatePlaceholders(content, phBase) : content;
                 bodyForFmt = typeof normalizeManuscriptEscapes === 'function' ? normalizeManuscriptEscapes(bodyForFmt) : bodyForFmt;
                 var bodyHtml = typeof formatManuscriptBodyToHtml === 'function' ? formatManuscriptBodyToHtml(bodyForFmt) : ((bodyForFmt + '').indexOf('<') >= 0 ? bodyForFmt : '<p class="manuscript-p">' + esc(String(bodyForFmt)) + '</p>');
                 previewContent.innerHTML = '';
                 var list = (window._previewChaptersMeta && window._previewChaptersMeta.length) ? window._previewChaptersMeta.slice() : [];
                 var ix = 0;
                 if (typeof window.patchPreviewMetaArrayWithGeneration === 'function') {
                     ix = window.patchPreviewMetaArrayWithGeneration(list, bookData, phBase);
                 } else {
                     var headingHtml = typeof window.buildPreviewChapterHeadingHtml === 'function'
                         ? window.buildPreviewChapterHeadingHtml(title, esc)
                         : '';
                     var fragment = headingHtml + bodyHtml;
                     var plain = fragment.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
                     var cleanTitle = typeof window.sanitizeChapterTitleForInput === 'function'
                         ? window.sanitizeChapterTitleForInput(title) : title;
                     list = [{ html: fragment, title: cleanTitle || title || '', wordCount: plain.split(/\s+/).filter(Boolean).length, chapterNo: chNo }];
                     ix = 0;
                 }
                 if (typeof window.setPreviewChaptersFromList === 'function') {
                     window.setPreviewChaptersFromList(list, ix, 0);
                 } else {
                     previewContent.innerHTML = '<div class="reader-chapter-block">' + bodyHtml + '</div>';
                 }
                 if (typeof window.scrollAiWriterPreviewColumnToBottom === 'function') window.scrollAiWriterPreviewColumnToBottom();
                 try { streamEl.removeAttribute('aria-busy'); } catch (e) {}
                 if (typeof window.markChapterAsGenerated === 'function') window.markChapterAsGenerated();
                 if (typeof onDone === 'function') onDone();
             }
             if (chars.length > 4000) {
                 try { streamEl.removeAttribute('aria-busy'); } catch (e) {}
                 finalizeFormattedBody();
                 return;
             }
             function pump() {
                 var end = Math.min(idx + CHARS_PER_FRAME, chars.length);
                 streamEl.textContent += chars.slice(idx, end).join('');
                 idx = end;
                 if (typeof window.scrollAiWriterPreviewColumnToBottom === 'function') window.scrollAiWriterPreviewColumnToBottom();
                 if (idx < chars.length) {
                     requestAnimationFrame(pump);
                 } else {
                     finalizeFormattedBody();
                 }
             }
             requestAnimationFrame(pump);
         }
