      function getChapterDropdownMax() {
          var ddl = document.getElementById('ChapterDropdown');
          if (!ddl) return 0;
          var max = 0;
          for (var i = 0; i < ddl.options.length; i++) {
              var v = parseInt(ddl.options[i].value, 10);
              if (Number.isFinite(v) && v > max) max = v;
          }
          return max;
      }

      var CHAPTER_BROWSE_LABEL = 'Enter chapter title first';

      function setVersionHistoryPanelVisible(visible) {
          var wrap = document.getElementById('iterationPickerWrap');
          if (wrap) {
              wrap.classList.toggle('hidden', !visible);
              wrap.classList.toggle('flex', visible);
          }
      }

      function shouldShowVersionHistoryPanel() {
          var bid = document.getElementById('BookId') && document.getElementById('BookId').value;
          var ch = document.getElementById('ChapterNo') && document.getElementById('ChapterNo').value;
          return bid && bid !== '0' && ch && ch !== '0';
      }

      function ensureChapterBrowseOption() {
          var ddl = document.getElementById('ChapterDropdown');
          if (!ddl) return;
          var k, found = false;
          for (k = 0; k < ddl.options.length; k++) {
              if (ddl.options[k].value === '0') { found = true; break; }
          }
          if (!found) {
              var opt = document.createElement('option');
              opt.value = '0';
              opt.textContent = CHAPTER_BROWSE_LABEL;
              ddl.insertBefore(opt, ddl.firstChild);
          }
      }

      function clearChapterVersionHistoryUi() {
          var itSel = document.getElementById('IterationDropdown');
          if (itSel) itSel.innerHTML = '<option value="">— Generate to create v1 —</option>';
          var sumWrap = document.getElementById('chapterVersionsSummary');
          if (sumWrap) sumWrap.classList.add('hidden');
          var sumTxt = document.getElementById('chapterVersionsSummaryText');
          if (sumTxt) sumTxt.textContent = '';
          setVersionHistoryPanelVisible(shouldShowVersionHistoryPanel());
      }

      async function promptNewChapterTitle() {
          if (typeof Swal !== 'undefined') {
              var r = await Swal.fire({
                  title: 'Chapter title',
                  input: 'text',
                  inputPlaceholder: 'Enter chapter title',
                  showCancelButton: true,
                  confirmButtonText: 'OK',
                  cancelButtonText: 'Cancel',
                  confirmButtonColor: '#7c3aed',
                  cancelButtonColor: '#64748b',
                  focusCancel: false,
                  allowOutsideClick: false,
                  inputValidator: function (value) {
                      if (!value || !String(value).trim()) return 'Chapter title is required';
                  }
              });
              if (!r.isConfirmed) return null;
              return String(r.value || '').trim();
          }
          var t = prompt('Chapter title');
          if (t === null) return null;
          return String(t).trim();
      }

       async function addNewChapter() {
                const userId = document.getElementById("UserId").value;
                const bookId = document.getElementById('BookId').value;
                if (!bookId || bookId === "0") {
                   Swal.fire("Select a book", "Please select or create a book first, then add a chapter.", "warning");
                   return;
                }

          var chapterTitle = await promptNewChapterTitle();
          if (chapterTitle === null) return;
          if (!chapterTitle) {
              if (typeof window.shakeChapterTitleRequired === 'function') window.shakeChapterTitleRequired();
              return;
          }

          const response = await fetch(`/Books/GetLastChapter?userId=${userId}&bookId=${bookId}`);
          const data = await response.json();
          var apiLast = parseInt(data.lastChapter, 10) || 0;
          var ddlMax = getChapterDropdownMax();
          var nextChapter = (ddlMax > apiLast) ? ddlMax : (apiLast + 1);

          let chapterDropdown = document.getElementById("ChapterDropdown");
          var nextStr = String(nextChapter);
          var optionExists = false;
          if (chapterDropdown) {
              for (var k = 0; k < chapterDropdown.options.length; k++) {
                  if (chapterDropdown.options[k].value === nextStr) {
                      optionExists = true;
                      break;
                  }
              }
          }

          document.getElementById("Title").value = chapterTitle;
          document.getElementById("UserInput").value = "";
          document.getElementById("Status").value = "Draft";
          var cc = document.getElementById('chatContainer');
          if (cc) cc.innerHTML = '';
          checkAndDisableButtonsForReadOnly("Draft");

          document.getElementById("ChapterNo").value = nextStr;
          if (chapterDropdown) {
              if (typeof window.ensureChapterDropdownOption === 'function') {
                  window.ensureChapterDropdownOption(nextChapter);
                  if (chapterTitle && typeof window.formatChapterDropdownLabel === 'function') {
                      for (var j = 0; j < chapterDropdown.options.length; j++) {
                          if (chapterDropdown.options[j].value === nextStr) {
                              chapterDropdown.options[j].textContent = window.formatChapterDropdownLabel(nextChapter, chapterTitle);
                              break;
                          }
                      }
                  }
              } else if (!optionExists) {
                  var opt = document.createElement("option");
                  opt.value = nextStr;
                  opt.textContent = (typeof window.formatChapterDropdownLabel === 'function')
                      ? window.formatChapterDropdownLabel(nextChapter, chapterTitle)
                      : nextStr;
                  chapterDropdown.insertBefore(opt, chapterDropdown.options[0]);
              }
              chapterDropdown.value = nextStr;
          }

          document.getElementById("ResponseId").value = "0";
          var apiRawEl = document.getElementById('APIRawResponse');
          if (apiRawEl) apiRawEl.value = '';
          clearChapterVersionHistoryUi();
          if (typeof window.clearChapterDraftGenerated === 'function') window.clearChapterDraftGenerated();
          // A3 fix: adding a new (empty) chapter must NOT wipe the whole-book preview.
          // Switch the writer/editor context to the new chapter, but keep previously
          // generated chapters in the reader so e.g. Ch.1's content stays available.
          // (A full reset here used to clear _previewChaptersMeta/_previewChapterPages and
          // then showPreviewEmptyState() rendered "No generated chapter yet".)
          (function switchWriterContextKeepReader() {
              var bk = String(parseInt(bookId, 10) || 0);
              var chNo = String(parseInt(nextChapter, 10) || 1);
              window._writerPreviewIsolationKey = bk + ':' + chNo + ':0';
              window._editModeOriginalContent = null;
              if (window._chapterEditModalState) window._chapterEditModalState = null;
          })();
          if (typeof window.updateGenerateBtnMode === 'function') window.updateGenerateBtnMode();
          // No-op when the reader still holds generated chapters; only shows the empty
          // state when there is genuinely nothing generated yet (very first chapter).
          if (typeof window.showPreviewEmptyState === 'function') window.showPreviewEmptyState();
          if (typeof window.updatePreviewUI === 'function') window.updatePreviewUI();
          if (typeof window.syncChapterTopicLock === 'function') window.syncChapterTopicLock();
          setVersionHistoryPanelVisible(true);

      }
