      //   Parse and Save Book Content (Cover Suggestion)
      //   Converts/breaks down ResponseData from apirawresponse table
      //   Filtered by UserId and BookId
      //==============================================================
      async function parseAndSaveBookContent() {
          console.log("🟢 parseAndSaveBookContent() function started");

          const userId = document.getElementById("UserId")?.value;
          const bookId = document.getElementById("BookId")?.value;

          if (!userId || userId === "0") {
              alert("Error: UserId is required.");
              showNotification('UserId is required', 'warning');
              return;
          }

          if (!bookId || bookId === "0") {
              alert("Error: BookId is required.");
              showNotification('BookId is required', 'warning');
              return;
          }

          const coverBtn = document.getElementById("CoverBtn");
          if (coverBtn) {
              coverBtn.disabled = true;
              coverBtn.innerHTML = '⏳ Parsing...';
          }

          try {
              const requestData = {
                  UserId: parseInt(userId),
                  BookId: parseInt(bookId)
              };

              console.log("🟢 Sending parse request with UserId:", requestData.UserId, "BookId:", requestData.BookId);

              const response = await fetch('/BookParser/ParseAndSave', {
                  method: 'POST',
                  headers: {
                      'Content-Type': 'application/json',
                      'Accept': 'application/json'
                  },
                  body: JSON.stringify(requestData)
              });

              const responseText = await response.text();
              console.log("🟢 Response status:", response.status);
              console.log("🟢 Response text:", responseText);

              if (!response.ok) {
                  let errorMessage = `Server returned ${response.status}`;
                  try {
                      const errorData = JSON.parse(responseText);
                      errorMessage = errorData.message || errorData.title || responseText;
                  } catch {
                      errorMessage = responseText || `Server returned ${response.status}`;
                  }
                  throw new Error(errorMessage);
              }

              const result = JSON.parse(responseText);
              console.log("🟢 Parsed result:", result);

              if (result.success) {
                  let message = `Book content parsed and saved successfully! Processed ${result.processedCount} response(s).`;
                  if (result.createdCount > 0 || result.updatedCount > 0) {
                      message += ` Created: ${result.createdCount}, Updated: ${result.updatedCount}`;
                  }

                  showNotification(message, 'success');

                  const chatContainer = document.getElementById("chatContainer");
                  if (chatContainer) {
                      const successMessage = addMessage(`✅ ${message}`);

                      // Display extracted content using ChapterDataExtractor results
                      if (result.extractedContents && result.extractedContents.length > 0) {
                          result.extractedContents.forEach((extracted, index) => {
                              let contentHtml = `<div style="margin-top: 15px; padding: 15px; background: #f5f5f5; border-radius: 8px; border-left: 4px solid #007bff;">`;

                              if (extracted.chapterTitle) {
                                  contentHtml += `<h3 style="margin-top: 0; color: #007bff;">📖 ${extracted.chapterTitle}</h3>`;
                              }

                              if (extracted.style) {
                                  contentHtml += `<p><strong>Style:</strong> ${extracted.style}</p>`;
                              }

                              if (extracted.content) {
                                  // Sanitize and display HTML content
                                  const sanitizedContent = sanitizeHtml(extracted.content);
                                  contentHtml += `<div style="margin-top: 10px;"><strong>Content:</strong><div style="margin-top: 5px; padding: 10px; background: white; border-radius: 4px;">${sanitizedContent}</div></div>`;
                              }

                              if (extracted.highlights) {
                                  contentHtml += `<div style="margin-top: 10px;"><strong>Highlights:</strong>`;
                                  if (typeof extracted.highlights === 'string') {
                                      try {
                                          const highlightsObj = JSON.parse(extracted.highlights);
                                          if (highlightsObj.detailed_bullet_summary) {
                                              const sanitizedHighlights = sanitizeHtml(highlightsObj.detailed_bullet_summary);
                                              contentHtml += `<div style="margin-top: 5px; padding: 10px; background: white; border-radius: 4px;">${sanitizedHighlights}</div>`;
                                          } else {
                                              contentHtml += `<div style="margin-top: 5px; padding: 10px; background: white; border-radius: 4px;">${JSON.stringify(highlightsObj, null, 2)}</div>`;
                                          }
                                      } catch (e) {
                                          contentHtml += `<div style="margin-top: 5px; padding: 10px; background: white; border-radius: 4px;">${extracted.highlights}</div>`;
                                      }
                                  } else if (typeof extracted.highlights === 'object') {
                                      if (extracted.highlights.detailed_bullet_summary) {
                                          const sanitizedHighlights = sanitizeHtml(extracted.highlights.detailed_bullet_summary);
                                          contentHtml += `<div style="margin-top: 5px; padding: 10px; background: white; border-radius: 4px;">${sanitizedHighlights}</div>`;
                                      } else {
                                          contentHtml += `<div style="margin-top: 5px; padding: 10px; background: white; border-radius: 4px;">${JSON.stringify(extracted.highlights, null, 2)}</div>`;
                                      }
                                  }
                                  contentHtml += `</div>`;
                              }

                              contentHtml += `<p style="margin-bottom: 0; font-size: 12px; color: #666;">Response ID: ${extracted.responseId}</p>`;
                              contentHtml += `</div>`;

                              addMessage(contentHtml);
                          });
                      }

                      if (result.errors && result.errors.length > 0) {
                          const errorMessage = addMessage(`⚠️ Some errors occurred: ${result.errors.join(', ')}`);
                      }
                  }
              } else {
                  throw new Error(result.message || 'Failed to parse and save book content');
              }
          } catch (error) {
              console.error("❌ Error parsing and saving book content:", error);
              showNotification('Failed to parse and save book content: ' + error.message, 'error');

              const chatContainer = document.getElementById("chatContainer");
              if (chatContainer) {
                  const errorMessage = addMessage(`❌ Sorry, I encountered an error: ${error.message}`);
              }
          } finally {
              if (coverBtn) {
                  coverBtn.disabled = false;
                  coverBtn.innerHTML = '✅ Cover Suggession';
              }
          }
      }

