                      ? window.formatChapterDropdownLabel(chapterNo, chapterTitle)
                      : (`Chapter ${chapterNo}` + (chapterTitle && chapterTitle !== 'Untitled Chapter' ? (' — ' + chapterTitle) : ''));

                  ddl.innerHTML += `<option value="${chapterNo}" data-status="${row.chapterStatus || row.status || 'OK'}" data-title="${String(chapterTitle).replace(/"/g, '&quot;')}">${displayText.replace(/</g, '&lt;')}</option>`;
