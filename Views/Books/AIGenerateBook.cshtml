        margin-bottom: 0;
    }
    #bookResultContent #readerViewport { flex: 1 1 auto; min-height: auto; max-height: none; }
    /* Reader viewport: grows with content — page scroll, not inner trap */
    #readerViewport {
        flex: 1 1 auto;
        min-height: auto;
        max-height: none;
        width: 100%;
        overflow: visible;
        overflow-x: hidden;
        display: none;
        padding: 0;
        border-radius: 0;
    }
    #readerViewport:not(.hidden) { display: block !important; visibility: visible !important; opacity: 1 !important; }
    /* === Book-style reader: blends with bookResult bg, user turns pages only by click/key === */
    #readerViewport.book-reader-active {
        overflow: hidden !important;
        padding: 0 !important;
        display: flex !important;
        align-items: stretch;
        justify-content: center;
        min-height: 0;
        flex: 1 1 auto;
        max-height: 100%;
        background: transparent !important;
        border-radius: 0;
        box-shadow: none;
        transform: none;
    }
    .book-stage {
        width: 100%;
        max-width: 880px;
        height: 100%;
        min-height: 0;
        flex: 1 1 auto;
        display: flex;
        align-items: stretch;
        justify-content: center;
        position: relative;
        padding: 20px 16px;
        box-sizing: border-box;
        transform: none;
    }
    /* Layered structure: only pageLayer animates; text in pageContent never transforms */
    .book-container {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: visible;
        border-radius: 3px;
        box-shadow: 0 6px 24px rgba(0,0,0,0.1), 0 0 0 1px rgba(0,0,0,0.05);
        background: #fafaf9;
    }
    .book-page-layer {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform 0.35s ease-out;
        will-change: transform;
        z-index: 1;
    }
    .book-page-layer.book-page-layer-active { z-index: 2; }
    .book-page-layer-off { transform: translateX(100%); pointer-events: none; }
    .book-page-layer.book-page-leave-left { transform: translateX(-100%); }
    .book-page-layer.book-page-leave-right { transform: translateX(100%); }
    .book-page-layer.book-page-enter-from-right { transform: translateX(0); }
    .book-page-layer.book-page-enter-from-left { transform: translateX(0); }
    .book-page-background {
        position: absolute;
        inset: 0;
        background: #fafaf9;
        border-radius: 2px;
        transform: none;
        pointer-events: none;
    }
    .book-page-content-wrap {
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        padding: 2.5rem;
        box-sizing: border-box;
        transform: none !important;
        scale: 1;
        rotate: 0deg;
    }
    .book-page-content {
        flex: 1 1 auto;
        min-height: 0;
        height: auto;
        overflow-y: hidden;
        overflow-x: hidden;
        word-wrap: break-word;
        transform: none !important;
        scale: 1;
        rotate: 0deg;
        color: #1c1917;
