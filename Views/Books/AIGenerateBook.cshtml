             if (uid) formData.append("userId", uid);
             if (bid) formData.append("bookId", bid);
             if (ch) formData.append("chapter", ch);
             var res = await fetch("/api/AudioToText/convert", { method: "POST", body: formData, credentials: "same-origin" });
             var raw = await res.text();
             var data = {};
             if (raw) { try { data = JSON.parse(raw); } catch (e) { data = {}; } }
             if (!res.ok) {
                 var errMsg = (data && (data.message || data.Message)) ? String(data.message || data.Message) : ('HTTP ' + res.status);
                 showNotification('Upload failed: ' + errMsg, 'error');
