     /** Prefer server JSON `{ message }` for errors; avoid dumping huge HTML into UI. */
     function parseApiErrorMessage(raw) {
         if (raw == null || raw === '') return 'Request failed';
         var t = String(raw).trim();
         if (/504\s+Gateway\s+Time-?out/i.test(t) || /Gateway Time-out/i.test(t)) {
             return 'The server gateway timed out before chapter generation finished. Wait a minute and try again — if this repeats, ask support to run: sudo bash deploy/apply-nginx-timeouts.sh on the server.';
         }
         if (t.charAt(0) === '{') {
             try {
                 var j = JSON.parse(t);
                 if (j && typeof j.message === 'string' && j.message.trim()) return j.message.trim();
                 if (j && typeof j.Message === 'string' && j.Message.trim()) return j.Message.trim();
                 if (j && typeof j.detail === 'string' && j.detail.trim()) return j.detail.trim();
                 if (j && typeof j.title === 'string' && j.title.trim()) return j.title.trim();
             } catch (e) { /* ignore */ }
         }
         return t.length > 600 ? (t.slice(0, 600) + '…') : t;
     }
