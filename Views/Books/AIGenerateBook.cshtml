                  window.location.href = newBookId ? '/Books/AIGenerateBook?bookId=' + encodeURIComponent(newBookId) : '/Dashboard';
                  return;
              }
              var errMsg = 'Failed to create book.';
              try { var err = JSON.parse(responseText); errMsg = err.message || errMsg; } catch (e) { if (responseText) errMsg = responseText; }
              showNotification(errMsg, 'error');
          } catch (err) {
              showNotification('Error: ' + (err.message || 'Network error'), 'error');
          } finally {
              if (confirmBtn) { confirmBtn.disabled = false; confirmBtn.innerHTML = '<i class="fas fa-save mr-1"></i> Create Book'; }
