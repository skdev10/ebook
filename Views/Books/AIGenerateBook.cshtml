window.refreshChapterWorkflowProgress = async function () {
    if (window._refreshWorkflowBusy) return;
    window._refreshWorkflowBusy = true;
    var uid = parseInt(String((document.getElementById('UserId') && document.getElementById('UserId').value) || '0'), 10);
    var bid = parseInt(String((document.getElementById('BookId') && document.getElementById('BookId').value) || '0'), 10);
    var ch = parseInt(String((document.getElementById('ChapterNo') && document.getElementById('ChapterNo').value) || '1'), 10);
    var textEl = document.getElementById('chapterWorkflowProgressText');
    if (!textEl || !uid || !bid) {
        window._refreshWorkflowBusy = false;
        return;
    }
    var hasGenerated = typeof window.hasCurrentChapterGenerated === 'function' && window.hasCurrentChapterGenerated();
    try {
        var r = await fetch('/Books/GetBookWritingProgress?userId=' + uid + '&bookId=' + bid, { credentials: 'same-origin', headers: { Accept: 'application/json' } });
        var d = await r.json().catch(function () { return {}; });
        if (!d.success) return;
        var total = d.totalChapters || 0;
        var fin = d.finalizedChapters || 0;
        var current = (d.chapters || []).find(function (c) { return c.number === ch; });
        var curLabel = current && current.displayLabel
            ? window.sanitizeChapterTitleForInput(current.displayLabel)
            : '';
        if (!curLabel && typeof window.formatChapterDisplayName === 'function') {
            curLabel = window.formatChapterDisplayName(ch, document.getElementById('Title') && document.getElementById('Title').value);
        }
        var statusField = document.getElementById('Status') && document.getElementById('Status').value;
        var isActuallyFinalized = hasGenerated && (
            statusField === 'ReadOnly' || (current && current.isFinalized));
        var curStatus = !hasGenerated
            ? 'Ready to Write'
            : (isActuallyFinalized ? 'Finalized' : 'Ready');
        textEl.innerHTML = (curLabel ? ('<strong>' + curLabel + '</strong> — ') : '') + curStatus
            + (fin > 0 && total > 0 ? (' <span class="text-violet-600/80">· ' + fin + ' of ' + total + ' finalized</span>') : '');
        if (typeof window.syncFinalizedBadge === 'function') window.syncFinalizedBadge(isActuallyFinalized);
        if (typeof window.refreshBookFormattingButton === 'function') window.refreshBookFormattingButton(d);
    } catch (e) {
        console.warn('refreshChapterWorkflowProgress', e);
    } finally {
        window._refreshWorkflowBusy = false;
    }
};

/** Formats stored UTC version date/time as a human-friendly "June 18, 2026 at 4:37 PM". */
window.formatFriendlyVersionDate = function (dateStr, timeStr) {
    var d = (dateStr || '').trim();
    if (!d) return '';
    var t = (timeStr || '').split('.')[0] || '00:00:00';
    var dt = new Date(d + 'T' + t + 'Z');
    if (isNaN(dt.getTime())) return d;
    var months = ['January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'];
    var h = dt.getUTCHours();
    var ampm = h >= 12 ? 'PM' : 'AM';
    var h12 = h % 12; if (h12 === 0) h12 = 12;
    var mins = ('0' + dt.getUTCMinutes()).slice(-2);
    return months[dt.getUTCMonth()] + ' ' + dt.getUTCDate() + ', ' + dt.getUTCFullYear()
        + ' at ' + h12 + ':' + mins + ' ' + ampm;
};

