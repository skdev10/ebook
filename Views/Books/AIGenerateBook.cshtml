    /* Manuscript / page-flip: markdown-style headings + horizontal rules */
    #bookResult .book-page-content .manuscript-chapter-heading {
        color: #334155; font-size: 0.9375rem; font-weight: 600; margin: 0 0 0.65rem 0;
        letter-spacing: -0.01em;
