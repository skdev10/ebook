    .ai-writer-sidebar [data-guided-tour="ai-write-section"] > h2,
    .ai-writer-sidebar [data-guided-tour="ai-book-picker"] > h2 {
        margin-bottom: 0 !important;
    }
    .ai-writer-sidebar label.text-sm {
        margin-bottom: 0;
    }
    .ai-writer-sidebar #iterationPickerWrap {
        gap: 0.5rem !important;
        padding-top: 0 !important;
    }
    .ai-writer-sidebar #bookSelectionPreviewBtn {
        min-height: 3.25rem;
    }
    /* Book Selection row: one baseline — controls share vertical center; chevrons stay optically centered */
    .ai-writer-book-selection-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.625rem;
        width: 100%;
    }
    .ai-writer-book-selection-row > .flex-1 {
        align-self: stretch;
        display: flex;
        align-items: center;
        min-width: min(100%, 12rem);
    }
    .ai-writer-book-selection-row > .flex-1 > .relative {
        width: 100%;
        display: flex;
        align-items: center;
    }
    .ai-writer-book-selection-row > .flex-1 select {
        line-height: 1.35;
    }
    .ai-writer-book-selection-row > .flex-1 .pointer-events-none {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        padding-top: 0;
        padding-bottom: 0;
    }
    .ai-writer-book-selection-row #bookSelectionPreviewBtn,
    .ai-writer-book-selection-row label[for="chapterImportFileInput"],
    .ai-writer-book-selection-row #createBookBtn {
        align-self: center;
        height: 3.25rem;
        min-height: 3.25rem;
        box-sizing: border-box;
    }
    .ai-writer-book-selection-row #createBookBtn {
        width: 3.25rem;
        min-width: 3.25rem;
        padding: 0;
        line-height: 1;
    }
    /* Modals on this page: match single-line control height */
    #createBookModal input#createBookModalTitle,
    #chapterEditModal input#chapterEditModalPrompt {
        box-sizing: border-box;
        min-height: 3.25rem;
        padding-top: 0.875rem;
        padding-bottom: 0.875rem;
        font-size: 1rem;
        line-height: 1.5;
    }
    /* Reader pagination - book-like page turn */
    .reader-footer .reader-page-info { font-weight: 700; min-width: 90px; }
    /* Side-by-side preview: Original (left) vs Regenerated (right) */
    .preview-side-by-side {
        display: grid;
        grid-template-columns: 1fr 1fr;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        gap: 1rem;
        width: 100%;
        min-height: 400px;
        margin-top: 1rem;
    }
    .preview-side-by-side.hidden { display: none !important; }
    .preview-side-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .preview-side-panel h4 {
        margin: 0;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: #334155;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }
    .preview-side-panel .preview-side-body {
        flex: 1;
        overflow-y: auto;
        padding: 1rem 1.25rem;
        font-size: 0.9375rem;
        line-height: 1.7;
        color: #1e293b;
    }
    .preview-side-panel .preview-side-body p { margin: 0 0 0.75em 0; }
    .preview-side-panel .preview-side-body p:last-child { margin-bottom: 0; }

     div#chapterVersionsSummary {
    display: none;
}
