        // ==== Book Reader: page splitting, flip animation, keyboard ====
        var BookReader = (function() {
            var pages = [];
            var currentIndex = 0;
            var viewport = null;
            var totalWords = 0;
            var contentA = null, footerA = null, contentB = null, footerB = null;
            var layerA = null, layerB = null;
            var SLIDE_DURATION = 350;
            var isAnimating = false;

            function getMeasureDiv() {
                var m = document.getElementById('bookMeasureDiv');
                if (!m) {
                    m = document.createElement('div');
                    m.id = 'bookMeasureDiv';
                    m.className = 'book-page-content';
                    m.style.cssText = 'position:absolute;left:-9999px;top:0;visibility:hidden;overflow:hidden;font-family:Georgia,Times New Roman,serif;font-size:1rem;line-height:1.7;text-align:justify;';
                    document.body.appendChild(m);
                }
                return m;
            }

            function getContentDimensions() {
                var container = document.getElementById('bookContainer');
                var wrap = document.querySelector('.book-page-content-wrap');
                if (!container || !wrap) return { w: 400, h: 500 };
                var cs = window.getComputedStyle(wrap);
                var padH = (parseFloat(cs.paddingLeft) || 0) + (parseFloat(cs.paddingRight) || 0);
                var padV = (parseFloat(cs.paddingTop) || 0) + (parseFloat(cs.paddingBottom) || 0);
                var footer = document.querySelector('.book-page-footer');
                var footerH = footer ? footer.offsetHeight || 40 : 40;
                var w = container.offsetWidth - padH;
                var h = container.offsetHeight - padV - footerH;
                return { w: Math.max(200, w), h: Math.max(200, h) };
            }

            function parseSegments(html) {
                var wrap = document.createElement('div');
                wrap.innerHTML = html;
                var segs = [];
                for (var i = 0; i < wrap.children.length; i++) {
                    var el = wrap.children[i];
                    segs.push(el.outerHTML);
                }
                if (segs.length === 0 && html.trim()) segs.push('<p>' + html.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</p>');
                return segs;
            }

            function splitContentIntoPages(contentHtml, contentW, contentH) {
                var measure = getMeasureDiv();
                measure.style.width = contentW + 'px';
                measure.style.height = 'auto';
                measure.style.minHeight = contentH + 'px';
                var segs = parseSegments(contentHtml);
                var result = [];
                var currentPage = [];
                var currentHeight = 0;

                for (var i = 0; i < segs.length; i++) {
                    measure.innerHTML = currentPage.concat([segs[i]]).join('');
                    var h = measure.offsetHeight;
                    if (h <= contentH || currentPage.length === 0) {
                        currentPage.push(segs[i]);
                        currentHeight = h;
                    } else {
                        if (currentPage.length > 0) {
                            result.push(currentPage.join(''));
                            currentPage = [];
                        }
                        measure.innerHTML = segs[i];
                        if (measure.offsetHeight <= contentH) {
                            currentPage = [segs[i]];
                            currentHeight = measure.offsetHeight;
                        } else {
                            result.push(segs[i]);
                        }
                    }
                }
                if (currentPage.length > 0) result.push(currentPage.join(''));
                return result;
            }

            function fillLayer(contentEl, footerEl, pageIdx) {
                if (!contentEl) return;
                var total = pages.length;
                contentEl.innerHTML = pages[pageIdx] || '';
                if (footerEl) footerEl.textContent = (pageIdx + 1) + ' / ' + total;
            }

            function renderCurrentView() {
                fillLayer(contentA, footerA, currentIndex);
            }

            function updateControls() {
                var prevBtn = document.getElementById('bookNavPrev');
                var nextBtn = document.getElementById('bookNavNext');
                var ind = document.getElementById('bookPageIndicator');
                if (ind) ind.textContent = (currentIndex + 1) + ' / ' + pages.length;
                if (prevBtn) prevBtn.disabled = currentIndex <= 0;
                if (nextBtn) nextBtn.disabled = currentIndex >= pages.length - 1;
            }

            function goToPage(index) {
                var total = pages.length;
                if (total === 0) return;
                index = Math.max(0, Math.min(index, total - 1));
                if (index === currentIndex) { updateControls(); return; }
                if (isAnimating) return;
                var next = index > currentIndex;
                isAnimating = true;
                if (next) {
                    fillLayer(contentB, footerB, index);
                    layerB.classList.remove('book-page-layer-off');
                    layerB.style.transform = 'translateX(100%)';
                    layerB.offsetHeight;
                    layerB.classList.add('book-page-enter-from-right');
                    layerB.style.transform = 'translateX(0)';
                    layerA.classList.add('book-page-leave-left');
                    layerA.style.transform = 'translateX(-100%)';
                    layerB.classList.add('book-page-layer-active');
                } else {
                    fillLayer(contentB, footerB, index);
                    layerB.classList.remove('book-page-layer-off');
                    layerB.style.transform = 'translateX(-100%)';
                    layerB.offsetHeight;
                    layerB.classList.add('book-page-enter-from-left');
                    layerB.style.transform = 'translateX(0)';
                    layerA.classList.add('book-page-leave-right');
                    layerA.style.transform = 'translateX(100%)';
                    layerB.classList.add('book-page-layer-active');
                }
                setTimeout(function() {
                    currentIndex = index;
                    fillLayer(contentA, footerA, currentIndex);
                    layerA.classList.remove('book-page-leave-left', 'book-page-leave-right');
                    layerA.style.transform = '';
                    layerB.classList.remove('book-page-enter-from-right', 'book-page-enter-from-left', 'book-page-layer-active');
                    layerB.style.transform = '';
                    layerB.classList.add('book-page-layer-off');
                    layerB.style.transform = 'translateX(100%)';
                    updateControls();
                    isAnimating = false;
                }, SLIDE_DURATION);
                updateControls();
            }

            function nextPage() { goToPage(currentIndex + 1); }
            function prevPage() { goToPage(currentIndex - 1); }

            var keydownBound = false;
            var swipeBound = false;
            function onKeydown(e) {
                if (!viewport || !viewport.classList.contains('book-reader-active')) return;
                if (e.key === 'ArrowRight') { e.preventDefault(); nextPage(); }
                if (e.key === 'ArrowLeft') { e.preventDefault(); prevPage(); }
            }
            function bindNavZones() {
                var stage = document.getElementById('bookStage');
                var prevBtn = document.getElementById('bookNavPrev');
                var nextBtn = document.getElementById('bookNavNext');
                if (prevBtn) prevBtn.onclick = function() { prevPage(); };
                if (nextBtn) nextBtn.onclick = function() { nextPage(); }
                if (stage && !swipeBound) {
                    var startX = 0;
                    stage.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, { passive: true });
                    stage.addEventListener('touchend', function(e) {
                        if (!e.changedTouches.length) return;
                        var dx = e.changedTouches[0].clientX - startX;
                        if (dx > 50) nextPage();
                        else if (dx < -50) prevPage();
                    }, { passive: true });
                    swipeBound = true;
                }
            }
            return {
                init: function() {
                    viewport = document.getElementById('readerViewport');
                    contentA = document.getElementById('bookPageContentA');
                    footerA = document.getElementById('bookPageFooterA');
                    contentB = document.getElementById('bookPageContentB');
                    footerB = document.getElementById('bookPageFooterB');
                    layerA = document.getElementById('pageLayerA');
                    layerB = document.getElementById('pageLayerB');
                    if (layerB) { layerB.classList.add('book-page-layer-off'); layerB.style.transform = 'translateX(100%)'; }
                    if (!keydownBound) { document.addEventListener('keydown', onKeydown); keydownBound = true; }
                    bindNavZones();
                },
                setPages: function(htmlPages, wordCount) {
                    pages = htmlPages && htmlPages.length ? htmlPages : ['<p>No content.</p>'];
                    totalWords = wordCount || 0;
                    currentIndex = 0;
                    renderCurrentView();
                    updateControls();
                },
                getPages: function() { return pages.slice(); },
                getCurrentIndex: function() { return currentIndex; },
                getTotalPages: function() { return pages.length; },
                getTotalWords: function() { return totalWords; },
                goToPage: goToPage,
                nextPage: nextPage,
                prevPage: prevPage,
                splitContentIntoPages: function(contentHtml) {
                    var dim = getContentDimensions();
                    return splitContentIntoPages(contentHtml, dim.w, dim.h);
                },
                showStage: function() {
                    var wrap = document.getElementById('readerChaptersWrap');
                    var stage = document.getElementById('bookStage');
                    if (wrap) wrap.classList.add('hidden');
                    if (stage) { stage.style.display = 'flex'; }
                    if (viewport) viewport.classList.add('book-reader-active');
                },
                hideStage: function() {
                    var stage = document.getElementById('bookStage');
                    if (stage) stage.style.display = 'none';
                    if (viewport) viewport.classList.remove('book-reader-active');
                },
                addPage: function(html) { pages.push(html); },
                setCurrentPageContent: function(html) {
                    if (pages.length) pages[pages.length - 1] = html;
                    else pages = [html];
                    renderCurrentView();
                },
                getCurrentPageIndex: function() { return pages.length - 1; },
                updateControls: updateControls
            };
        })();

        // ====(19-24)==== UI Helper Function to DISPLAY BOOK CONTENT ===================== OK
        //  Display chapters in flowing preview (#preview-content, no inner scroll); prev/next use _previewChaptersMeta.
        //======================================
        window.buildPreviewMetaEntryFromGeneration = function (bookData, phBase, chapterIndexZeroBased) {
            var core = (bookData && bookData.data) ? bookData.data : bookData || {};
            var rawContent = (typeof window.extractChapterBodyFromGenerateResponse === 'function')
                ? window.extractChapterBodyFromGenerateResponse(bookData)
                : '';
            if (!rawContent) {
                rawContent = core.content || (core.chapters && core.chapters[0] && (core.chapters[0].content || core.chapters[0].Content)) || '';
            }
            var content = (typeof getContentFromPossibleJson === 'function' ? getContentFromPossibleJson(rawContent) : rawContent) || (rawContent + '').trim() || '';
            if (typeof content !== 'string') content = String(content);
            var titleRaw = (core.title || (core.suggest_chapter_name || '').split('\n')[0] || (core.chapters && core.chapters[0] && (core.chapters[0].chapterTitle || core.chapters[0].title)) || '').trim();
            var ix = typeof chapterIndexZeroBased === 'number' ? chapterIndexZeroBased : 0;
            var chNo = ix + 1;
            var ap = typeof applyTemplatePlaceholders === 'function' ? applyTemplatePlaceholders : null;
            var fmt = typeof formatManuscriptBodyToHtml === 'function' ? formatManuscriptBodyToHtml : null;
            var esc = typeof escapeHtml === 'function' ? escapeHtml : function (x) {
                return String(x == null ? '' : x).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            };
            var phCtx = Object.assign({}, phBase || {}, {
                chapterTitle: titleRaw,
                chapterNumber: chNo,
                displayChapterNumber: chNo
            });
            var title = ap ? ap(titleRaw, phCtx) : titleRaw;
            var headingHtml = typeof window.buildPreviewChapterHeadingHtml === 'function'
                ? window.buildPreviewChapterHeadingHtml(title, esc)
                : '';
            var body = ap ? ap(content, phCtx) : content;
            body = typeof normalizeManuscriptEscapes === 'function' ? normalizeManuscriptEscapes(body) : body;
            var bodyHtml = fmt ? fmt(body) : ((body + '').indexOf('<') >= 0 ? body : '<p class="manuscript-p">' + esc(String(body)) + '</p>');
            var fragment = headingHtml + bodyHtml;
            var plain = fragment.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
            var wc = plain.split(/\s+/).filter(Boolean).length;
            var cleanTitle = typeof window.sanitizeChapterTitleForInput === 'function'
                ? window.sanitizeChapterTitleForInput(title) : title;
            return { html: fragment, title: cleanTitle || title || '', wordCount: wc, chapterNo: chNo };
        };
        window.patchPreviewMetaArrayWithGeneration = function (chaptersMeta, bookData, phBase) {
            if (!chaptersMeta || !bookData) return 0;
            var chNoEl = document.getElementById('ChapterNo');
            var chNo = chNoEl ? parseInt(chNoEl.value, 10) : NaN;
            if (!Number.isFinite(chNo) || chNo < 1) chNo = 1;
            var ix = chNo - 1;
            var entry = window.buildPreviewMetaEntryFromGeneration(bookData, phBase, ix);
            if (!entry) return ix;
            while (chaptersMeta.length < ix) {
                var n = chaptersMeta.length + 1;
                chaptersMeta.push({
                    html: '<p class="manuscript-p text-slate-500">No content for this chapter yet.</p>',
                    title: '',
                    wordCount: 0,
                    chapterNo: n
                });
            }
            if (chaptersMeta.length === ix) {
                chaptersMeta.push(entry);
            } else {
                chaptersMeta[ix] = entry;
            }
            return ix;
        };
