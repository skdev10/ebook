      async function refreshChapterIterationsDropdown(preferredResponseId) {
          var sel = document.getElementById('IterationDropdown');
          var sumWrap = document.getElementById('chapterVersionsSummary');
          var sumTxt = document.getElementById('chapterVersionsSummaryText');
          if (!sel) return 0;
          var uid = document.getElementById('UserId') && document.getElementById('UserId').value;
          var bid = document.getElementById('BookId') && document.getElementById('BookId').value;
          var ch = document.getElementById('ChapterNo') && document.getElementById('ChapterNo').value;
          if (!uid || uid === '0' || !bid || bid === '0' || !ch || ch === '0') {
              sel.innerHTML = '<option value="">—</option>';
              if (sumWrap) sumWrap.classList.add('hidden');
              setVersionHistoryPanelVisible(false);
              return 0;
          }
          try {
              var res = await fetch('/Books/GetChapterIterations?userId=' + encodeURIComponent(uid) + '&bookId=' + encodeURIComponent(bid) + '&chapterNo=' + encodeURIComponent(ch));
              var data = await res.json();
              if (!data.success || !data.iterations || !data.iterations.length) {
                  sel.innerHTML = '<option value="">— Generate to create v1 —</option>';
                  if (sumWrap) sumWrap.classList.add('hidden');
                  setVersionHistoryPanelVisible(shouldShowVersionHistoryPanel());
                  return 0;
              }
              setVersionHistoryPanelVisible(true);
              var n = data.iterations.length;
              var finalized = data.iterations.filter(function (it) { return it.isFinalized; }).length;
              if (sumWrap && sumTxt) {
                  sumTxt.textContent = 'Chapter ' + String(ch) + ': ' + n + ' version' + (n === 1 ? '' : 's') + (finalized ? ' (' + finalized + ' current)' : '') + '.';
                  sumWrap.classList.remove('hidden');
              }
              sel.innerHTML = '';
              data.iterations.forEach(function (it) {
                  var opt = document.createElement('option');
                  opt.value = String(it.responseId || '');
                  var label = 'v' + it.iterationNumber;
                  if (it.title) label += ': ' + String(it.title).substring(0, 48);
                  var friendly = (typeof window.formatFriendlyVersionDate === 'function')
                      ? window.formatFriendlyVersionDate(it.generationDate, it.generationTime)
                      : (it.generationDate || '');
                  if (friendly) label += ' · ' + friendly;
                  if (it.isFinalized) label += ' [Current]';
                  opt.textContent = label;
                  sel.appendChild(opt);
              });
              var pick = preferredResponseId ? String(preferredResponseId) : '';
              if (pick) {
                  for (var i = 0; i < sel.options.length; i++) {
                      if (sel.options[i].value === pick) { sel.selectedIndex = i; return n; }
                  }
              }
              sel.selectedIndex = sel.options.length - 1;
              return n;
          } catch (e) {
              console.warn('refreshChapterIterationsDropdown', e);
              if (sumWrap) sumWrap.classList.add('hidden');
              setVersionHistoryPanelVisible(false);
              return 0;
          }
      }

      /** Promote the version currently selected in Version history to the chapter's [Current] (finalized) version. */
      async function finalizeCurrentChapterVersion() {
          var sel = document.getElementById('IterationDropdown');
          var btn = document.getElementById('btnFinalizeChapterVersion');
          var uid = parseInt(String((document.getElementById('UserId') && document.getElementById('UserId').value) || '0'), 10);
          var bid = parseInt(String((document.getElementById('BookId') && document.getElementById('BookId').value) || '0'), 10);
          var ch = parseInt(String((document.getElementById('ChapterNo') && document.getElementById('ChapterNo').value) || '0'), 10);
          var responseId = parseInt(String((sel && sel.value) || '0'), 10);
          if (!uid || !bid || !ch || !responseId) {
              if (typeof showNotification === 'function') showNotification('Pick a version from Version history first.', 'error');
              return;
          }
          if (btn) { btn.disabled = true; }
          try {
              var res = await fetch('/Books/PromoteChapterVersion', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  credentials: 'same-origin',
                  body: JSON.stringify({ UserId: uid, BookId: bid, ChapterNo: ch, ResponseId: responseId })
              });
              var data = await res.json().catch(function () { return { success: false }; });
              if (!res.ok || !data.success) {
                  if (typeof showNotification === 'function') showNotification((data && data.message) || 'Could not finalize this version.', 'error');
                  return;
              }
              if (typeof showNotification === 'function') showNotification('This version is now the current version of the chapter.', 'success');
              if (typeof refreshChapterIterationsDropdown === 'function') await refreshChapterIterationsDropdown(String(responseId));
              if (typeof window.refreshChapterWorkflowProgress === 'function') window.refreshChapterWorkflowProgress();
              if (typeof loadSavedBooksDropdown === 'function') loadSavedBooksDropdown();
          } catch (e) {
              if (typeof showNotification === 'function') showNotification('Finalize failed: ' + (e.message || 'Unknown error'), 'error');
          } finally {
              if (btn) { btn.disabled = false; }
          }
      }
      document.addEventListener('DOMContentLoaded', function () {
          var btn = document.getElementById('btnFinalizeChapterVersion');
          if (btn) btn.addEventListener('click', finalizeCurrentChapterVersion);
      });

      /** Load editor fields for a specific apirawresponse row (one iteration). */
      async function onChapterIterationSelected(responseIdStr) {
          if (!responseIdStr) return;
          var userId = document.getElementById('UserId').value;
          var bookId = document.getElementById('BookId').value;
          var chapterNo = document.getElementById('ChapterNo').value;
          var prevChapterKey = String(bookId || 0) + ':' + String(chapterNo || 0);
          if (typeof window.resetWriterPreviewForContextChange === 'function') {
              window.resetWriterPreviewForContextChange(parseInt(bookId, 10) || 0, parseInt(chapterNo, 10) || 0, parseInt(responseIdStr, 10) || 0, false);
          }
          try {
              var response = await fetch('/Books/GetChapterData?userId=' + encodeURIComponent(userId) + '&bookId=' + encodeURIComponent(bookId) + '&chapterNo=' + encodeURIComponent(chapterNo) + '&responseId=' + encodeURIComponent(responseIdStr));
              if (!response.ok) throw new Error('Failed to load version');
              var result = await response.json();
              if (!result.success) {
                  showNotification(result.message || 'Could not load version', 'error');
                  return;
              }
              var latestChapter = result.chapters && result.chapters.length > 0 ? result.chapters[0] : null;
              var newCh = latestChapter ? String(latestChapter.chapterNo != null ? latestChapter.chapterNo : chapterNo) : String(chapterNo);
              var newKey = String(result.bookId || bookId) + ':' + newCh;
              if (newKey !== prevChapterKey && typeof window.resetWriterPreviewForContextChange === 'function') {
                  window.resetWriterPreviewForContextChange(parseInt(result.bookId || bookId, 10) || 0, parseInt(newCh, 10) || 0, parseInt(responseIdStr, 10) || 0, true);
              }
              document.getElementById('ResponseId').value = latestChapter ? latestChapter.responseId : '0';
              document.getElementById('BookTitle').value = result.bookTitle || '';
              document.getElementById('Status').value = latestChapter ? latestChapter.statusCode : 'Draft';
              document.getElementById('Title').value = latestChapter
                  ? (typeof window.sanitizeChapterTitleForInput === 'function'
                      ? window.sanitizeChapterTitleForInput(latestChapter.chapterTitle)
                      : (latestChapter.chapterTitle || ''))
                  : '';
              var topicText = window.parseChapterTopicFromRequestData(latestChapter ? latestChapter.requestData : '', latestChapter && latestChapter.chapterTopic);
              document.getElementById('UserInput').value = topicText;
              checkAndDisableButtonsForReadOnly(latestChapter ? latestChapter.statusCode : 'Draft');
              populateBookForm(result);
              if (latestChapter && typeof showBookContent === 'function') {
                  showBookContent({
                      bookId: result.bookId,
