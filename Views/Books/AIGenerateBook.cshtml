window.stripAugmentedTopicFromText = function (raw) {
    if (raw == null) return '';
    var text = String(raw).trim();
    if (!text) return '';
    var markers = [
        'pure narrative prose, no headings or meta:',
        'pure narrative prose:',
        '[Write ONLY the new chapter from this brief',
        '[Write ONLY the new chapter from the brief'
    ];
    function briefAfterMarker(src) {
        var i, m, idx, tail;
        for (i = 0; i < markers.length; i++) {
            m = markers[i];
            idx = src.toLowerCase().indexOf(m.toLowerCase());
            if (idx >= 0) {
                tail = src.slice(idx + m.length).trim().replace(/^[:\s"]+/, '').trim();
                if (tail) return tail.replace(/^"+|"+$/g, '');
            }
        }
        return '';
    }
    var fromMarkers = briefAfterMarker(text);
    if (fromMarkers) return fromMarkers;
    if (text.indexOf('[Prior chapter') >= 0 && text.indexOf('---') >= 0) {
        var parts = text.split('---');
        var nonEmpty = [];
        for (var p = 0; p < parts.length; p++) {
            var seg = (parts[p] || '').trim();
            if (seg) nonEmpty.push(seg);
        }
        if (nonEmpty.length > 0) {
            var last = nonEmpty[nonEmpty.length - 1];
            var fromLast = briefAfterMarker(last);
            if (fromLast) return fromLast;
            if (last.indexOf('[Prior chapter') < 0) return last.replace(/^"+|"+$/g, '');
        }
    }
    return text;
};

/** User brief only — never show AI system/continuity instructions in the topic field. */
window.parseChapterTopicFromRequestData = function (requestData, chapterTopicField) {
    try {
        if (chapterTopicField != null && String(chapterTopicField).trim())
            return window.stripAugmentedTopicFromText(chapterTopicField);
        if (!requestData) return '';
        if (typeof requestData === 'object' && requestData.chapterTopic != null)
            return window.stripAugmentedTopicFromText(requestData.chapterTopic);
        var s = typeof requestData === 'string' ? requestData.trim() : '';
        if (!s) return '';
        if (s.charAt(0) === '{') {
            try {
                var o = JSON.parse(s);
                var t = o.chapterTopic || o.chapter_topic || o.UserInput || o.user_input || o.topic || o.Topic || '';
                if (t) return window.stripAugmentedTopicFromText(String(t));
            } catch (e) { /* ignore malformed JSON */ }
        }
        return window.stripAugmentedTopicFromText(s);
    } catch (e) {
        console.warn('parseChapterTopicFromRequestData failed', e);
        return '';
    }
};
// Stable alias — do not redeclare a global function named getChapterTopicFromRequestData (it would shadow this).
window.getChapterTopicFromRequestData = window.parseChapterTopicFromRequestData;

