@{
    var meterBookId = ViewBag.SelectedBookId as int? ?? 0;
}
<div id="writingCostMeter" class="pricing-meter" data-book-id="@meterBookId" style="background:#fff;border:1px solid var(--dash-border, #E5E5E5);border-radius:var(--dash-card-radius, 14px);padding:14px 16px;">
    <div style="font-size:12px;color:#64748b;font-weight:700;letter-spacing:.04em;text-transform:uppercase;margin-bottom:8px;">Writing cost</div>
    <div class="pricing-money" style="font-size:13px;">
        <div><span id="meterPages">0</span> pages</div>
        <div class="meter-bar" aria-hidden="true">
            <span id="meterBillFill" class="meter-fill is-bill"></span>
            <span id="meterFreeFill" class="meter-fill is-free"></span>
        </div>
        <div>Running writing cost: <strong id="meterCost" data-value="0">$0.00</strong></div>
    </div>
    <p style="margin:8px 0 0;font-size:12px;color:#6B6B6B;">Nothing is charged until you export. Keep writing, you can stop, edit or delete pages any time.</p>
    <div class="meter-notice" id="meterNotice" role="status">
        <span id="meterNoticeText"></span>
        <button type="button" id="meterNoticeDismiss" aria-label="Dismiss">×</button>
    </div>
</div>
<script>
(function () {
    var rates = { perPage: null, free: 0, wordsPerPage: null };
    var root = document.getElementById("writingCostMeter");
    var bookId = (root && root.getAttribute("data-book-id")) || "0";
    try {
        var q = new URLSearchParams(location.search);
        if (q.get("bookId")) bookId = q.get("bookId");
    } catch (e) {}
    var noticeKey = "pricingMeterNotice:" + bookId;
    var crossed = false;

    fetch("/pricing/rates", { credentials: "same-origin" }).then(function (r) { return r.json(); }).then(function (d) {
        (d.rules || []).forEach(function (rule) {
            if (rule.key === "writing.per_page") { rates.perPage = rule.unitAmount; rates.free = rule.freeAllowance; }
        });
        if (d.wordsPerPage) rates.wordsPerPage = d.wordsPerPage;
        tick();
    }).catch(function () {});

    function words() {
        var el = document.getElementById("bookResult") || document.querySelector("[data-word-count]");
        var text = el ? (el.innerText || el.textContent || "") : "";
        return (text.match(/\b\w+\b/g) || []).length;
    }

    function tick() {
        if (!rates.wordsPerPage || rates.perPage == null) return;
        var pages = Math.ceil(words() / rates.wordsPerPage) || 0;
        var billable = Math.max(0, pages - (rates.free || 0));
        var cost = billable * rates.perPage;
        var pagesEl = document.getElementById("meterPages");
        var costEl = document.getElementById("meterCost");
        if (pagesEl) pagesEl.textContent = String(pages);
        if (costEl && window.PricingUI) window.PricingUI.countTo(costEl, cost, 220);
        else if (costEl) costEl.textContent = "$" + cost.toFixed(2);
        var max = Math.max(pages, rates.free || 1, 1);
        var ff = document.getElementById("meterFreeFill");
        var bf = document.getElementById("meterBillFill");
        if (ff) ff.style.transform = "scaleX(" + (Math.min(pages, rates.free) / max) + ")";
        if (bf) bf.style.transform = "scaleX(" + (pages / max) + ")";

        if (pages > (rates.free || 0) && bookId && bookId !== "0") {
            var seen = false;
            try { seen = localStorage.getItem(noticeKey) === "1"; } catch (e) {}
            if (!seen && !crossed) {
                crossed = true;
                try { localStorage.setItem(noticeKey, "1"); } catch (e) {}
                var notice = document.getElementById("meterNotice");
                var text = document.getElementById("meterNoticeText");
                if (text) {
                    text.textContent = "You are past the " + rates.free + " free pages. Writing is now $" + Number(rates.perPage).toFixed(2) + " per page.";
                }
                if (notice) notice.classList.add("is-on");
                if (root) {
                    root.classList.remove("is-pulse");
                    void root.offsetWidth;
                    root.classList.add("is-pulse");
                }
            }
        }
    }

    var dismiss = document.getElementById("meterNoticeDismiss");
    if (dismiss) {
        dismiss.addEventListener("click", function () {
            var notice = document.getElementById("meterNotice");
            if (notice) notice.classList.remove("is-on");
        });
    }
    setInterval(tick, 4000);
    document.addEventListener("input", tick);
})();
</script>
