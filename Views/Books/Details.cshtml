@model EBookDashboard.Models.Books
@{
    ViewData["Title"] = Model?.Title ?? "Book Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var authorName = ViewBag.AuthorName as string ?? "Author";
    var coverSrc = !string.IsNullOrEmpty(Model?.CoverImagePath) ? (Model.CoverImagePath.StartsWith("/") ? Model.CoverImagePath : "/" + Model.CoverImagePath) : "";
    var chapterCount = Model?.Chapters?.Count ?? 0;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    .book-detail-cover { aspect-ratio: 2/3; object-fit: cover; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); }
    .book-detail-placeholder { aspect-ratio: 2/3; background: linear-gradient(135deg, #7c3aed 0%, #4a6cf7 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 3rem; font-weight: 700; letter-spacing: -0.02em; }
</style>
<div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <a href="@Url.Action("EBookHub", "Books")" class="inline-flex items-center gap-2 text-gray-500 hover:text-gray-800 mb-8 text-sm font-medium">
        <i class="fas fa-arrow-left"></i> Back to EBook Hub
    </a>
    <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-0">
            <!-- Left: Cover -->
            <div class="lg:col-span-1 bg-gray-50 p-8 flex items-center justify-center min-h-[400px] lg:min-h-[560px]">
                @if (!string.IsNullOrEmpty(coverSrc))
                {
                    <img src="@coverSrc" alt="@Model?.Title" class="book-detail-cover w-full max-w-[280px] rounded-2xl" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="book-detail-placeholder w-full max-w-[280px] rounded-2xl hidden">@(Model?.Title?.Length > 0 ? Model.Title[0].ToString().ToUpper() : "?")</div>
                }
                else
                {
                    <div class="book-detail-placeholder w-full max-w-[280px] rounded-2xl">@(Model?.Title?.Length > 0 ? Model.Title[0].ToString().ToUpper() : "?")</div>
                }
            </div>
            <!-- Right: Info -->
            <div class="lg:col-span-2 p-8 sm:p-10 flex flex-col justify-center">
                <span class="text-xs font-semibold tracking-widest uppercase text-[#7c3aed] mb-2">@(Model?.Genre ?? "Book")</span>
                <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight mb-2">@Model?.Title</h1>
                <p class="text-lg text-gray-500 mb-6">by @authorName</p>
                <div class="flex flex-wrap gap-4 mb-6 text-sm text-gray-500">
                    <span><i class="fas fa-book-open text-[#7c3aed] mr-1"></i> @(Model?.WordCount.ToString("N0") ?? "0") words</span>
                    <span><i class="fas fa-list text-[#7c3aed] mr-1"></i> @chapterCount chapter@(chapterCount != 1 ? "s" : "")</span>
                </div>
                <p class="text-gray-600 leading-relaxed mb-8">@(string.IsNullOrEmpty(Model?.Description) ? "No description available." : Model.Description)</p>
                <div class="flex flex-wrap gap-4">
                    <a href="@Url.Action("AIGenerateBook", "Books", new { bookId = Model?.BookId })" class="inline-flex items-center gap-2 bg-[#7c3aed] hover:bg-[#6d28d9] text-white font-semibold px-6 py-3.5 rounded-xl transition-colors shadow-lg shadow-[#7c3aed]/25">
                        <i class="fas fa-book-reader"></i> Start Reading
                    </a>
                    <a href="@Url.Action("EBookHub", "Books")" class="inline-flex items-center gap-2 border border-gray-200 text-gray-700 font-medium px-6 py-3.5 rounded-xl hover:bg-gray-50 transition-colors">
                        <i class="fas fa-arrow-left"></i> Back to Hub
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
