@{
    ViewData["Title"] = "Chat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="chat-container">
    <div class="chat-header">
        <h1 class="chat-title">Chat with AI</h1>
        <p class="chat-subtitle">Ask anything — get help on the same page.</p>
    </div>

    <div id="chatMessages" class="chat-messages">
        <div class="chat-welcome" id="chatWelcome">
            <p>How can I help you today? Type your question below.</p>
        </div>
    </div>

    <div class="chat-input-area">
        <form id="chatForm" class="chat-form">
            @Html.AntiForgeryToken()
            <textarea id="promptInput"
                      class="chat-input"
                      placeholder="Message ChatGPT..."
                      rows="1"
                      maxlength="4000"></textarea>
            <button type="submit" id="submitBtn" class="chat-send-btn" title="Send">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </form>
        <p class="chat-hint">Press Enter to send, Shift+Enter for new line.</p>
    </div>
</div>

@section Styles {
    <style>
        .chat-container {
            display: flex;
            flex-direction: column;
            height: calc(100vh - 180px);
            max-width: 900px;
            margin: 0 auto;
        }

        .chat-header {
            text-align: center;
            padding: 1rem 0 1.5rem;
            border-bottom: 1px solid #e5e7eb;
        }

        .chat-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #111827;
            margin: 0;
        }

        .chat-subtitle {
            color: #6b7280;
            margin: 0.25rem 0 0;
            font-size: 0.9rem;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem 0;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .chat-welcome {
            text-align: center;
            color: #6b7280;
            padding: 2rem 1rem;
        }

            .chat-welcome p {
                margin: 0;
            }

        .message {
            padding: 1rem 1.25rem;
            border-radius: 12px;
            max-width: 85%;
            white-space: pre-wrap;
            word-break: break-word;
        }

            .message.user {
                align-self: flex-end;
                background: #2563eb;
                color: #fff;
            }

            .message.assistant {
                align-self: flex-start;
                background: #f3f4f6;
                color: #111827;
                border: 1px solid #e5e7eb;
            }

            .message.error {
                align-self: flex-start;
                background: #fef2f2;
                color: #b91c1c;
                border: 1px solid #fecaca;
            }

        .message-label {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.35rem;
            opacity: 0.85;
        }

        .chat-input-area {
            padding: 1rem 0 1.5rem;
            border-top: 1px solid #e5e7eb;
        }

        .chat-form {
            display: flex;
            align-items: flex-end;
            gap: 0.75rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .chat-form:focus-within {
                border-color: #2563eb;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
            }

        .chat-input {
            flex: 1;
            border: none;
            background: transparent;
            resize: none;
            font-size: 1rem;
            line-height: 1.5;
            padding: 0.25rem 0;
            min-height: 24px;
            max-height: 200px;
        }

            .chat-input:focus {
                outline: none;
            }

        .chat-send-btn {
            flex-shrink: 0;
            width: 40px;
            height: 40px;
            border: none;
            border-radius: 10px;
            background: #2563eb;
            color: #fff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }

            .chat-send-btn:hover {
                background: #1d4ed8;
            }

            .chat-send-btn:disabled {
                background: #9ca3af;
                cursor: not-allowed;
            }

        .chat-hint {
            font-size: 0.75rem;
            color: #9ca3af;
            margin: 0.5rem 0 0 0.25rem;
        }

        .typing-indicator {
            align-self: flex-start;
            padding: 1rem 1.25rem;
            background: #f3f4f6;
            border-radius: 12px;
            color: #6b7280;
            font-size: 0.9rem;
        }
    </style>
}

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('chatForm');
            const input = document.getElementById('promptInput');
            const messagesEl = document.getElementById('chatMessages');
            const welcomeEl = document.getElementById('chatWelcome');
            const submitBtn = document.getElementById('submitBtn');

            function addMessage(content, role, isError) {
                if (welcomeEl) welcomeEl.style.display = 'none';
                const div = document.createElement('div');
                div.className = 'message ' + (role === 'user' ? 'user' : (isError ? 'error' : 'assistant'));
                const label = document.createElement('div');
                label.className = 'message-label';
                label.textContent = role === 'user' ? 'You' : 'Assistant';
                div.appendChild(label);
                const text = document.createElement('div');
                text.textContent = content;
                div.appendChild(text);
                messagesEl.appendChild(div);
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            function setLoading(loading) {
                submitBtn.disabled = loading;
                input.disabled = loading;
            }

            function autoResize(el) {
                el.style.height = 'auto';
                el.style.height = Math.min(el.scrollHeight, 200) + 'px';
            }

            input.addEventListener('input', function () { autoResize(this); });
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    form.requestSubmit();
                }
            });

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const prompt = input.value.trim();
                if (!prompt) return;

                addMessage(prompt, 'user');
                input.value = '';
                autoResize(input);

                const typing = document.createElement('div');
                typing.className = 'message assistant typing-indicator';
                typing.textContent = 'Thinking...';
                messagesEl.appendChild(typing);
                messagesEl.scrollTop = messagesEl.scrollHeight;

                setLoading(true);

                try {
                    const res = await fetch('@Url.Action("Ask", "Chat")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                        },
                        body: JSON.stringify({ prompt: prompt })
                    });
                    const data = await res.json();
                    typing.remove();
                    addMessage(data.response || 'No response.', 'assistant', !data.success);
                } catch (err) {
                    typing.remove();
                    addMessage('Failed to get a response. Check your connection and API key.', 'assistant', true);
                } finally {
                    setLoading(false);
                }
            });
        })();
    </script>
}
