                                </div>
                                <div class="p-3">
                                    <h3 class="font-semibold text-gray-900 text-sm truncate group-hover:text-purple-700" title="@title">@title</h3>
                                    <p class="text-gray-500 text-xs mt-0.5 truncate">@(string.IsNullOrWhiteSpace(draft.Subtitle) ? draft.Status : draft.Subtitle)</p>
                                    <p class="text-gray-400 text-[11px] mt-1.5 truncate">@(string.IsNullOrWhiteSpace(draft.LastEditedText) ? "Edited recently" : draft.LastEditedText)</p>
                                </div>
                                </a>
                            </div>
                        }
                    }
                </div>
                <p id="drafts-modal-empty" class="hidden text-center text-sm text-gray-400 py-10">No drafts match your search.</p>
            </div>
        </div>
    </div>
}

<!-- Continue Reading Modal -->
<div id="reading-modal" class="fixed inset-0 z-50 hidden" aria-modal="true" role="dialog">
    <div id="modal-backdrop" class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm transition-opacity opacity-0 cursor-pointer"></div>
    <div class="fixed inset-0 z-10 overflow-y-auto pointer-events-none flex min-h-full items-center justify-center p-4">
        <div id="modal-panel" class="pointer-events-auto relative w-full max-w-4xl transform overflow-hidden rounded-3xl bg-white text-left shadow-2xl transition-all duration-300 ease-out opacity-0 translate-y-4 scale-95">
            <div class="grid md:grid-cols-2">
                <div class="relative bg-purple-900 min-h-[320px] md:min-h-[420px] overflow-hidden flex items-center justify-center p-8">
                    <div class="absolute inset-0 bg-cover bg-center opacity-40" style="background-image: url('https://images.unsplash.com/photo-1519681393784-d120267933ba?q=80&w=2070'); mix-blend-mode: overlay;"></div>
                    <div class="absolute top-0 right-0 w-64 h-64 bg-purple-500 blur-3xl opacity-20 rounded-full"></div>
                    <div class="relative z-10 text-center">
                        <img id="modal-cover-img" src="@(!string.IsNullOrEmpty(DashCoverSrc(Model.CurrentWorkingBook?.CoverImagePath)) ? DashCoverSrc(Model.CurrentWorkingBook?.CoverImagePath) : defaultCoverPlaceholder)" alt="@(Model.CurrentWorkingBook?.Title ?? "Book")" class="dashboard-cover-img dash-placeholder-cover w-40 h-56 object-cover rounded shadow-2xl mx-auto mb-6 border-2 border-white/20 rotate-2">
                        <h3 class="font-serif text-3xl text-white font-bold mb-2">@(Model.CurrentWorkingBook?.Title ?? "Your Book")</h3>
                        <p class="text-purple-200 font-medium">Resume reading</p>
                    </div>
                </div>
                <div class="p-8 md:p-10 flex flex-col justify-between min-h-[400px]">
                    <div>
                        <div class="flex justify-between items-center mb-6">
                            <span class="text-xs font-bold tracking-widest text-purple-600 uppercase">Resume Reading</span>
                            <button type="button" id="close-modal" class="text-gray-400 hover:text-gray-600 transition-colors bg-gray-50 p-2 rounded-full hover:bg-gray-100" aria-label="Close">
                                <i class="fas fa-times w-5 h-5"></i>
