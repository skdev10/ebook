        </div>
    </div>
</div>

<!-- Toast -->
<div id="toast-dash" class="toast-dash">Notification</div>

<script>
    function showToast(message) {
        var t = document.getElementById('toast-dash');
        if (!t) return;
        t.textContent = message;
        t.classList.add('show');
        clearTimeout(window._toastTimeout);
        window._toastTimeout = setTimeout(function () { t.classList.remove('show'); }, 3000);
    }
    (function () {
        var DASH_BOOK_KEY = 'ebook_dashboard_selected_book';
        var defaultContinueBookId = '@(primaryDraft != null ? primaryDraft.BookId.ToString() : (demoDrafts.Any() ? demoDrafts.First().BookId.ToString() : "0"))';
        function markWrapCoverImage(img) {
            if (!img) return;
            function applyWrapClass() {
                if (!img.naturalWidth || !img.naturalHeight) return;
                var ratio = img.naturalWidth / img.naturalHeight;
                if (ratio >= 1.15) img.classList.add('is-wrap-cover');
                else img.classList.remove('is-wrap-cover');
            }
            if (img.complete) applyWrapClass();
            img.addEventListener('load', applyWrapClass);
            img.addEventListener('error', function () { img.classList.remove('is-wrap-cover'); });
        }
        document.querySelectorAll('img.dashboard-cover-img').forEach(markWrapCoverImage);
        var dashCoverPlaceholder = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defaultCoverPlaceholder));
        function setCoverInSlot(imgEl, emptyEl, url) {
            if (!imgEl) return;
            var src = (url && url.trim()) ? url.trim() : dashCoverPlaceholder;
            imgEl.src = src;
            imgEl.classList.remove('hidden');
            if (emptyEl) emptyEl.classList.add('hidden');
        }
        function applySelectedBook(item) {
            if (!item) return;
            var title = item.getAttribute('data-title') || 'Your Book';
            var cover = item.getAttribute('data-cover-url') || '';
            var bid = item.getAttribute('data-book-id') || '0';
            var resume = item.getAttribute('data-resume-url') || item.getAttribute('href') || '';
            document.querySelectorAll('.book-item.is-selected').forEach(function (el) { el.classList.remove('is-selected'); });
            item.classList.add('is-selected');
            var sidebarTitle = document.getElementById('dash-sidebar-title');
            if (sidebarTitle) sidebarTitle.textContent = title;
            setCoverInSlot(document.getElementById('dash-sidebar-cover-img'), null, cover);
            setCoverInSlot(document.getElementById('modal-cover-img'), null, cover);
            try { sessionStorage.setItem(DASH_BOOK_KEY, bid); } catch (_) {}
        }
        document.querySelectorAll('.book-item[data-book-id]').forEach(function (item) {
            item.addEventListener('click', function (e) {
                if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                applySelectedBook(item);
            });
        });
        var initial = null;
        if (defaultContinueBookId && defaultContinueBookId !== '0') {
            initial = document.querySelector('.book-item[data-book-id="' + defaultContinueBookId + '"]');
            try { sessionStorage.setItem(DASH_BOOK_KEY, String(defaultContinueBookId)); } catch (_) {}
        }
        if (!initial) {
            var storedId = '';
            try { storedId = sessionStorage.getItem(DASH_BOOK_KEY) || ''; } catch (_) {}
            initial = storedId
                ? document.querySelector('.book-item[data-book-id="' + storedId + '"]')
                : document.querySelector('.book-item[data-book-id]');
        }
        if (initial) applySelectedBook(initial);
    })();

    // Dashboard search is initialised in a dedicated, isolated <script> block
    // at the end of this page so an unrelated error above can never stop it.

    (function () {
        var modal = document.getElementById('reading-modal');
        var openBtn = document.getElementById('continue-reading-btn');
        var closeBtn = document.getElementById('close-modal');
        var backdrop = document.getElementById('modal-backdrop');
        var panel = document.getElementById('modal-panel');
        if (!modal || !openBtn) return;
        function openModal() {
            var startUrl = openBtn.getAttribute('data-start-url');
            if (startUrl) { window.location.href = startUrl; return; }
            modal.classList.remove('hidden');
            modal.style.display = '';
            requestAnimationFrame(function () {
                backdrop.classList.remove('opacity-0');
                panel.classList.remove('opacity-0', 'translate-y-4', 'scale-95');
                panel.classList.add('opacity-100', 'translate-y-0', 'scale-100');
            });
        }
        function closeModal() {
            backdrop.classList.add('opacity-0');
            panel.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
            panel.classList.add('opacity-0', 'translate-y-4', 'scale-95');
            setTimeout(function () {
                modal.classList.add('hidden');
                modal.style.display = 'none';
            }, 300);
        }
        openBtn.addEventListener('click', function (e) { e.preventDefault(); openModal(); });
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (backdrop) backdrop.addEventListener('click', closeModal);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
        });
    })();

    // Published book → open a clean, read-only reader modal (not the editor)
    (function () {
        var modal = document.getElementById('book-reader-modal');
        var backdrop = document.getElementById('book-reader-backdrop');
        var closeBtn = document.getElementById('book-reader-close');
        var frame = document.getElementById('book-reader-frame');
        var titleEl = document.getElementById('book-reader-title');
        var newTab = document.getElementById('book-reader-newtab');
        var loading = document.getElementById('book-reader-loading');
        if (!modal || !frame) return;

        function previewUrl(bookId) {
            return '/BookDesign/PreviewBookHtml?bookId=' + encodeURIComponent(bookId);
        }
        function openReader(bookId, title) {
            if (!bookId) return;
            if (titleEl) titleEl.textContent = title || 'Reading';
            if (newTab) newTab.href = previewUrl(bookId);
            if (loading) loading.classList.remove('hidden');
            frame.src = previewUrl(bookId);
            modal.classList.add('is-open');
            document.body.style.overflow = 'hidden';
        }
        function closeReader() {
            modal.classList.remove('is-open');
            document.body.style.overflow = '';
            // Release the iframe so audio/large DOM is torn down and a fresh load happens next time.
            setTimeout(function () { if (!modal.classList.contains('is-open')) frame.src = 'about:blank'; }, 260);
        }

        frame.addEventListener('load', function () {
            if (frame.src && frame.src !== 'about:blank' && loading) loading.classList.add('hidden');
        });

        document.addEventListener('click', function (e) {
            var card = e.target.closest('.js-open-reader');
            if (!card) return;
            // Allow new-tab affordances (ctrl/cmd/middle-click) to use the href normally.
            if (e.defaultPrevented || e.button === 1 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            // Never hijack the 3-dot actions menu.
            if (e.target.closest('.dash-book-menu-wrap')) return;
            var bookId = card.getAttribute('data-book-id');
            if (!bookId) return;
            e.preventDefault();
            openReader(bookId, card.getAttribute('data-book-title'));
        });

        if (closeBtn) closeBtn.addEventListener('click', closeReader);
        if (backdrop) backdrop.addEventListener('click', closeReader);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && modal.classList.contains('is-open')) closeReader();
        });
    })();

    (function () {
        var epubCarousel = document.getElementById('epubCarousel');
        var epubPrev = document.getElementById('epubCarouselPrev');
        var epubNext = document.getElementById('epubCarouselNext');
        if (!epubCarousel || !epubPrev || !epubNext) return;
        epubPrev.addEventListener('click', function () { epubCarousel.scrollBy({ left: -220, behavior: 'smooth' }); });
        epubNext.addEventListener('click', function () { epubCarousel.scrollBy({ left: 220, behavior: 'smooth' }); });
    })();

    (function () {
        var modal = document.getElementById('drafts-modal');
        if (!modal) return;
        var backdrop = document.getElementById('drafts-modal-backdrop');
        var closeBtn = document.getElementById('close-drafts-modal');
        var searchInput = document.getElementById('drafts-modal-search');
        var grid = document.getElementById('drafts-modal-grid');
        var emptyMsg = document.getElementById('drafts-modal-empty');

        function openDraftsModal() {
            modal.classList.add('is-open');
            document.body.style.overflow = 'hidden';
            if (searchInput) {
                searchInput.value = '';
                filterDrafts('');
                searchInput.focus(); 
            }
        }
        function closeDraftsModal() {
            modal.classList.remove('is-open');
            document.body.style.overflow = '';
        }
        function filterDrafts(term) {
            if (!grid) return;
            var q = (term || '').toLowerCase().trim();
            var visible = 0;
            grid.querySelectorAll('.drafts-modal-item').forEach(function (item) {
                var title = item.getAttribute('data-title') || '';
                var show = !q || title.indexOf(q) !== -1;
                item.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            if (emptyMsg) emptyMsg.classList.toggle('hidden', visible > 0);
        }

        document.querySelectorAll('#open-all-drafts-modal, .open-all-drafts-modal').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                openDraftsModal();
            });
        });
        if (closeBtn) closeBtn.addEventListener('click', closeDraftsModal);
        if (backdrop) backdrop.addEventListener('click', closeDraftsModal);
        if (searchInput) searchInput.addEventListener('input', function (e) { filterDrafts(e.target.value); });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && modal.classList.contains('is-open')) closeDraftsModal();
        });
    })();

    (function () {
        function getAntiForgeryToken() {
            var t = document.querySelector('input[name="__RequestVerificationToken"]');
            return t ? t.value : (document.querySelector('meta[name="RequestVerificationToken"]')?.getAttribute('content') || '');
        }
        function runDeleteBook(bookId) {
            var token = getAntiForgeryToken();
            fetch('/Books/Delete/' + bookId, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            }).then(function (res) {
                if (res.ok || res.redirected) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ title: 'Deleted', text: 'Book removed permanently.', icon: 'success', timer: 1500, showConfirmButton: false })
                            .then(function () { window.location.reload(); });
                    } else {
                        window.location.reload();
                    }
                } else {
                    return res.text().then(function (t) { throw new Error(t || 'Delete failed'); });
                }
            }).catch(function (e) {
                if (typeof Swal !== 'undefined') Swal.fire({ title: 'Error', text: e.message || 'Could not delete book.', icon: 'error' });
                else alert(e.message || 'Could not delete book.');
            });
        }
        function confirmDeleteBook(bookId) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Delete book permanently?',
                    text: 'This removes the book and all chapters. This cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Yes, delete'
                }).then(function (r) { if (r.isConfirmed) runDeleteBook(bookId); });
            } else if (confirm('Delete this book permanently? This cannot be undone.')) {
                runDeleteBook(bookId);
            }
        }
        document.addEventListener('click', function (e) {
            var menuBtn = e.target.closest('.dash-book-menu-btn');
            if (menuBtn) {
                e.preventDefault();
                e.stopPropagation();
                var wrap = menuBtn.closest('.dash-book-menu-wrap');
                var menu = wrap && wrap.querySelector('.dash-book-menu');
                document.querySelectorAll('.dash-book-menu.is-open').forEach(function (m) {
                    if (m !== menu) m.classList.remove('is-open');
                });
                if (menu) menu.classList.toggle('is-open');
                menuBtn.setAttribute('aria-expanded', menu && menu.classList.contains('is-open') ? 'true' : 'false');
                return;
            }
            if (!e.target.closest('.dash-book-menu-wrap')) {
                document.querySelectorAll('.dash-book-menu.is-open').forEach(function (m) { m.classList.remove('is-open'); });
                document.querySelectorAll('.dash-book-menu-btn[aria-expanded="true"]').forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
            }
            var btn = e.target.closest('.dash-delete-book-btn');
            if (!btn) return;
            e.preventDefault();
            e.stopPropagation();
            var bookId = parseInt(btn.getAttribute('data-book-id'), 10);
            if (!bookId) return;
            confirmDeleteBook(bookId);
        });
    })();

    (function () {
        function applyDashProfile(src) {
            if (!src) return;
            var img = document.getElementById('dash-profile-avatar');
            var fallback = document.getElementById('dash-profile-avatar-default');
            if (!img) return;
            var url = src + (src.indexOf('?') >= 0 ? '&' : '?') + 't=' + Date.now();
            img.src = url;
            img.classList.remove('hidden');
            if (fallback) fallback.classList.add('hidden');
        }
        var cached = sessionStorage.getItem('newProfilePicture');
        if (cached) applyDashProfile(cached);
        fetch('/Dashboard/GetProfilePicture')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data && data.success && data.imagePath) applyDashProfile(data.imagePath);
            })
            .catch(function () { /* keep server-rendered avatar */ });
        window.addEventListener('profilePictureUpdated', function () {
            var pic = sessionStorage.getItem('newProfilePicture');
            if (pic) applyDashProfile(pic);
        });
    })();
</script>

<script>
    // Dashboard book/draft/author search — isolated so it always runs.
    (function () {
        function initDashSearch() {
            var input = document.getElementById('search-input');
            if (!input || input.dataset.searchBound === '1') return;
            input.dataset.searchBound = '1';
            var noBooksMsg = document.getElementById('no-books-msg');

            function applyFilter() {
                var term = (input.value || '').trim().toLowerCase();
                var items = document.querySelectorAll('.book-item');
                var visible = 0;
                items.forEach(function (item) {
                    var hay = ((item.getAttribute('data-title') || '') + ' ' + (item.textContent || '')).toLowerCase();
                    var match = term === '' || hay.indexOf(term) !== -1;
                    item.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                if (noBooksMsg) noBooksMsg.classList.toggle('hidden', !(term !== '' && visible === 0));
            }

            input.addEventListener('input', applyFilter);
            // Block the implicit form submit / page reload on Enter.
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); applyFilter(); }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initDashSearch);
        } else {
            initDashSearch();
        }
    })();
</script>
