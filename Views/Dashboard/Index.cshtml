                                </div>
                                <span class="text-sm font-medium text-gray-600">@(Model.CurrentWorkingBook?.ProgressPercentage ?? 0)%</span>
                            </div>
                            <div class="flex gap-4 text-sm text-gray-500 mt-2">
                                <span class="flex items-center gap-1.5"><i class="fas fa-book-open w-4 h-4"></i> @(Model.CurrentWorkingBook?.ProgressText ?? "—")</span>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4 mt-8">
                        <a href="@Url.Action("MyBooks", "Dashboard")" class="py-3.5 px-4 rounded-xl border border-gray-200 text-gray-700 font-medium hover:bg-gray-50 active:bg-gray-100 transition-colors flex items-center justify-center gap-2">
                            <i class="fas fa-list w-4 h-4"></i> Chapters
                        </a>
                        <a id="modal-read-now-btn" href="@((Model.DemoCurrentReadBookId ?? Model.CurrentWorkingBook?.BookId ?? 0) > 0 ? Url.Action("MyBooks", "Dashboard", new { bookId = Model.DemoCurrentReadBookId ?? Model.CurrentWorkingBook?.BookId, preview = 1 }) : Url.Action("EBookHub", "Books"))" class="py-3.5 px-4 rounded-xl bg-purple-600 text-white font-medium hover:bg-purple-700 active:bg-purple-800 transition-all shadow-lg shadow-purple-200 flex items-center justify-center gap-2 hover:-translate-y-0.5">
                            Read Now <i class="fas fa-arrow-right w-4 h-4"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Book Reader modal: full formatted book in a clean reading view (read-only) -->
<div id="book-reader-modal" class="book-reader-modal" aria-modal="true" role="dialog" aria-label="Book reader">
    <div id="book-reader-backdrop" class="book-reader-backdrop"></div>
    <div class="book-reader-shell" role="document">
        <div class="book-reader-topbar">
            <div class="book-reader-title-wrap">
                <i class="fas fa-book-open" aria-hidden="true"></i>
                <span id="book-reader-title" class="book-reader-title">Reading</span>
            </div>
            <div class="book-reader-actions">
                <a id="book-reader-newtab" href="#" target="_blank" rel="noopener" class="book-reader-action-btn" title="Open in a new tab">
                    <i class="fas fa-up-right-from-square" aria-hidden="true"></i><span>New tab</span>
                </a>
                <button type="button" id="book-reader-close" class="book-reader-close" aria-label="Close reader">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="book-reader-body">
            <div id="book-reader-loading" class="book-reader-loading">
                <span class="book-reader-spinner" aria-hidden="true"></span>
                <span>Opening your book…</span>
