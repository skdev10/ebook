@model EBookDashboard.Models.DashboardProfileViewModel
@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var profilePathOrig = ViewBag.ProfilePicturePath as string;
    var profileBackgroundOrig = ViewBag.ProfileBackgroundPath as string;
    var defaultCoverImage = "https://images.unsplash.com/photo-1524996297542-sadfcd2d824f?q=80&w=2000&auto=format&fit=crop";

    string ResolveMedia(string? path, string fallback)
    {
        if (string.IsNullOrWhiteSpace(path)) return fallback;
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }
        return path.StartsWith("/") ? path : "/" + path;
    }

    var safeName = Uri.EscapeDataString(Model?.UserName ?? "User");
    var defaultAvatar = Url.Content("~/images/default-avatar.svg");
    var avatar = ResolveMedia(profilePathOrig, defaultAvatar);
    var profileBackgroundImage = ResolveMedia(profileBackgroundOrig, defaultCoverImage);
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var writeUrl = baseUrl + "/Books/AIGenerateBook";
    var full = (Model?.UserName ?? "").Trim();
    var nameParts = string.IsNullOrEmpty(full) ? Array.Empty<string>() : full.Split(new[] { ' ' }, 2, StringSplitOptions.RemoveEmptyEntries);
    var firstName = nameParts.Length > 0 ? nameParts[0] : "";
    var lastName = nameParts.Length > 1 ? nameParts[1] : "";
    var planLabel = Model?.PlanName ?? (ViewBag.AccountType as string ?? "Free");
    var memberSinceText = Model != null && Model.MemberSince != default ? Model.MemberSince.ToString("dd MMM yyyy") : "—";
    var nextBillingText = Model != null && Model.NextBillingDate != default ? Model.NextBillingDate.ToString("dd MMM yyyy") : "—";
    var premiumUnlocked = ViewBag.PremiumContentUnlocked as bool? ?? false;
    var profileBio = ViewBag.ProfileBio as string ?? "";
}

<form id="profileAntiForgery" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<style>
    .profile-dash-hide-scrollbar::-webkit-scrollbar { display: none; }
    .profile-dash-hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .profile-dash-wrap { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }
    .profile-dash-inner { max-width: 72rem; margin-left: auto; margin-right: auto; }
    .profile-form-input {
        width: 100%; border: 1px solid #e2e8f0; border-radius: 14px;
        padding: 0.875rem 1rem; font-size: 1rem; color: #1e293b; background: #fff;
        outline: none; transition: border-color 0.2s, box-shadow 0.2s;
    }
    .profile-form-input:focus {
        border-color: #8b5cf6; box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.18);
    }
    .profile-form-label { display: block; font-size: 0.875rem; font-weight: 500; color: #475569; margin-bottom: 0.375rem; }
    .profile-avatar-wrap { position: relative; cursor: pointer; }
    .profile-avatar-wrap .profile-avatar-overlay {
        position: absolute; inset: 0; border-radius: 9999px;
        background: rgba(15, 23, 42, 0.45); color: #fff;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 0.25rem; opacity: 0; transition: opacity 0.2s ease;
        font-size: 0.7rem; font-weight: 600; text-align: center; padding: 0.5rem;
    }
    .profile-avatar-wrap:hover .profile-avatar-overlay,
    .profile-avatar-wrap:focus-within .profile-avatar-overlay { opacity: 1; }
    .profile-cover-banner { cursor: pointer; }
    .profile-cover-banner:hover .profile-cover-actions { opacity: 1; }
    .profile-cover-actions {
        opacity: 0.92; transition: opacity 0.2s ease;
    }
    .profile-btn-ghost {
        display: inline-flex; align-items: center; gap: 0.35rem;
        padding: 0.5rem 0.85rem; border-radius: 0.5rem; font-size: 0.8125rem; font-weight: 600;
        border: 1px solid rgba(255,255,255,0.35); background: rgba(0,0,0,0.35);
        color: #fff; backdrop-filter: blur(8px); transition: background 0.2s;
    }
    .profile-btn-ghost:hover { background: rgba(0,0,0,0.55); }
    .profile-btn-sm {
        display: inline-flex; align-items: center; gap: 0.35rem;
        padding: 0.4rem 0.75rem; border-radius: 0.5rem; font-size: 0.75rem; font-weight: 600;
        border: 1px solid #e2e8f0; background: #fff; color: #475569;
    }
    .profile-btn-sm:hover { border-color: #c4b5fd; color: #6d28d9; background: #faf5ff; }
    .profile-btn-sm.danger:hover { border-color: #fecaca; color: #dc2626; background: #fef2f2; }
</style>

<input type="file" id="profileFileInput" accept="image/jpeg,image/png,image/jpg" class="hidden" aria-hidden="true" />
<input type="file" id="profileBackgroundFileInput" accept="image/jpeg,image/png,image/jpg,image/webp" class="hidden" aria-hidden="true" />

<div class="dash-flow-page">
<main class="dash-flow-main">
<div class="dash-flow-inner flex flex-col min-h-0">
    <div class="bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] w-full profile-dash-inner min-h-[calc(100vh-120px)] flex flex-col overflow-hidden border border-slate-200/80">

        <!-- In-page header (complements dashboard sidebar) -->
        <header class="h-16 md:h-20 bg-white flex items-center justify-between px-6 md:px-8 shrink-0 border-b border-slate-100">
            <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-violet-600">eBook AI</p>
                <h1 class="text-lg md:text-xl font-medium text-slate-800 tracking-tight">Profile</h1>
            </div>
            <div class="flex items-center gap-4">
                <a href="/Dashboard/MyBooks" class="hidden sm:inline-flex text-sm font-medium text-slate-600 hover:text-violet-600 transition-colors">My Books</a>
                <a href="/Books/AIGenerateBook" class="hidden sm:inline-flex text-sm font-medium text-violet-600 hover:text-violet-700 transition-colors">AI Writer</a>
                <div class="flex items-center gap-2 cursor-default">
                    <img src="@avatar" alt="" class="profile-media-img w-8 h-8 rounded-full object-cover shadow-sm border border-slate-200" id="profileHeaderAvatar" />
                    <span class="text-sm font-medium text-slate-700 max-w-[140px] truncate hidden sm:inline" id="profileHeaderName">@(Model?.UserName ?? "User")</span>
                </div>
            </div>
        </header>

        <div class="flex-1 flex flex-col min-w-0 bg-[#f8fafc] overflow-y-auto">
            <!-- Cover -->
            <div id="profileCoverBanner" class="profile-cover-banner h-52 md:h-64 relative bg-violet-600 overflow-hidden shrink-0 group" role="button" tabindex="0" aria-label="Change profile background image">
                <img id="profileCoverImage" src="@profileBackgroundImage" alt="" class="profile-media-img absolute inset-0 w-full h-full object-cover opacity-90" loading="lazy" decoding="async" />
                <div class="absolute inset-0 bg-gradient-to-r from-violet-900/50 via-violet-700/25 to-transparent pointer-events-none"></div>
                <div class="profile-cover-actions absolute top-4 right-4 flex flex-wrap items-center justify-end gap-2 z-10">
                    <button type="button" id="btnChangeCover" class="profile-btn-ghost" title="Upload background">
                        <i data-lucide="image-plus" class="w-4 h-4"></i> Change background
                    </button>
                    <button type="button" id="btnRemoveCover" class="profile-btn-ghost" title="Remove background">
                        <i data-lucide="trash-2" class="w-4 h-4"></i> Remove
                    </button>
                </div>
                <p class="absolute bottom-4 left-6 text-xs text-white/80 hidden sm:block pointer-events-none">JPG, PNG or WEBP · max 5 MB</p>
            </div>

            <div class="px-4 sm:px-8 pb-12 md:pb-16 -mt-20 md:-mt-24 relative z-10 flex flex-col lg:flex-row gap-6 lg:gap-8 items-start">

                <!-- Left: card -->
                <div class="w-full lg:w-[320px] bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex flex-col items-center shrink-0 mx-auto lg:mx-0">
                    <div class="relative -mt-14 md:-mt-16 mb-4">
                        <button type="button" id="btnPickImage" class="profile-avatar-wrap rounded-full border-0 p-0 bg-transparent" title="Change profile photo" aria-label="Change profile photo">
                            <img id="profileImageMain" src="@avatar" alt="Profile" class="profile-media-img w-[108px] h-[108px] md:w-[120px] md:h-[120px] rounded-full object-cover border-4 border-white shadow-md bg-white pointer-events-none" />
                            <span class="profile-avatar-overlay rounded-full">
                                <i data-lucide="camera" class="w-5 h-5"></i>
                                Change photo
                            </span>
                        </button>
                    </div>
                    <h2 id="profileNameHeading" class="text-xl font-medium text-slate-900 tracking-tight text-center">@(Model?.UserName ?? "User")</h2>
                    <p class="text-sm text-slate-500 mt-1 text-center">@(Model?.UserRole ?? "Reader") · @planLabel</p>

                    <div class="w-full mt-8 flex flex-col border-t border-slate-100 text-left">
                        <div class="flex justify-between items-center py-3.5 border-b border-slate-100">
                            <span class="text-sm font-medium text-slate-500">Books in library</span>
                            <span class="text-sm font-semibold text-violet-600">@(Model?.TotalBooks ?? 0)</span>
                        </div>
                        <div class="flex justify-between items-center py-3.5 border-b border-slate-100">
                            <span class="text-sm font-medium text-slate-500">Published</span>
                            <span class="text-sm font-semibold text-emerald-600">@(Model?.BooksRead ?? 0)</span>
                        </div>
                        <div class="flex justify-between items-center py-3.5">
                            <span class="text-sm font-medium text-slate-500">Drafts / in progress</span>
                            <span class="text-sm font-semibold text-amber-600">@(Model?.BooksReading ?? 0)</span>
                        </div>
                    </div>

                    <a href="/Dashboard/MyBooks" class="w-full mt-4 text-center bg-white border border-slate-200 text-slate-600 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-50 hover:text-slate-900 transition-colors shadow-sm">
                        Open My Books
                    </a>

                    <div class="w-full mt-3 flex items-center justify-between border border-slate-200 rounded-lg p-3 bg-slate-50/80 hover:border-violet-200 transition-colors gap-2">
                        <span class="text-xs sm:text-sm text-violet-600 truncate select-all" title="Continue writing">@writeUrl</span>
                        <button type="button" id="btnCopyWriteUrl" class="text-slate-400 hover:text-violet-600 shrink-0 p-1" title="Copy link">
                            <i data-lucide="copy" class="w-4 h-4" stroke-width="1.5"></i>
                        </button>
                    </div>

                    <div class="w-full mt-3 flex flex-wrap items-center justify-center gap-2">
                        <button type="button" id="btnRemoveImage" class="profile-btn-sm danger">
                            <i data-lucide="user-x" class="w-3.5 h-3.5"></i> Remove photo
                        </button>
                    </div>
                    <p class="w-full mt-2 text-center text-xs text-slate-400">JPG or PNG · max 2 MB · saved to your account</p>
                </div>

                <!-- Right: tabs + forms -->
                <div class="flex-1 w-full bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col overflow-hidden min-h-[480px]">
                    <div class="flex overflow-x-auto border-b border-slate-100 px-6 md:px-8 pt-5 gap-6 profile-dash-hide-scrollbar">
                        <button type="button" id="tabBtnAccount" class="pb-4 text-sm font-medium text-violet-600 border-b-2 border-violet-600 whitespace-nowrap">Account</button>
                        <button type="button" id="tabBtnSecurity" class="pb-4 text-sm font-medium text-slate-500 border-b-2 border-transparent hover:text-slate-700 whitespace-nowrap">Security</button>
                        <button type="button" id="tabBtnPlan" class="pb-4 text-sm font-medium text-slate-500 border-b-2 border-transparent hover:text-slate-700 whitespace-nowrap">Plan &amp; billing</button>
                    </div>

                    <!-- Account -->
                    <div id="panelAccount" class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5">
                        <div>
                            <label class="block text-sm font-medium text-slate-500 mb-2">First name</label>
                            <input type="text" id="firstName" value="@firstName" autocomplete="given-name" class="w-full border border-slate-200 rounded-lg px-4 py-2.5 text-base text-slate-800 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500 transition-shadow" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-500 mb-2">Last name</label>
                            <input type="text" id="lastName" value="@lastName" autocomplete="family-name" class="w-full border border-slate-200 rounded-lg px-4 py-2.5 text-base text-slate-800 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500 transition-shadow" />
                        </div>
                        <input type="hidden" id="fullName" value="@(Model?.UserName ?? "")" />
                        <div>
                            <label class="block text-sm font-medium text-slate-500 mb-2">Username</label>
                            <input type="text" id="username" value="@((ViewBag.ProfileUsername as string) ?? "")" autocomplete="username" class="w-full border border-slate-200 rounded-lg px-4 py-2.5 text-base text-slate-800 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500 transition-shadow" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-500 mb-2">Email</label>
                            <input type="email" id="email" value="@(Model?.UserEmail ?? "")" autocomplete="email" class="w-full border border-slate-200 rounded-lg px-4 py-2.5 text-base text-slate-800 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500 transition-shadow" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-500 mb-2">Country</label>
                            <input type="text" id="country" value="@(Model?.Country ?? "")" autocomplete="country-name" class="w-full border border-slate-200 rounded-lg px-4 py-2.5 text-base text-slate-800 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500 transition-shadow" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-500 mb-2">Member since</label>
                            <input type="text" readonly value="@memberSinceText" class="w-full border border-slate-100 bg-slate-50 rounded-lg px-4 py-2.5 text-base text-slate-600" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-slate-500 mb-2">Bio</label>
                            <textarea id="profileBio" rows="4" maxlength="500" class="w-full border border-slate-200 rounded-lg px-4 py-3 text-base text-slate-800 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500 transition-shadow resize-y" placeholder="Tell readers about yourself...">@profileBio</textarea>
                            <p class="text-xs text-slate-400 mt-1">Max 500 characters.</p>
                        </div>
                        <div class="md:col-span-2 rounded-lg border border-violet-100 bg-violet-50/50 p-4 text-sm text-slate-600">
                            <p class="font-medium text-violet-800 mb-1">Your ebook workspace</p>
                            <p class="leading-relaxed mb-3">Manage drafts and published titles under <strong>My Books</strong>, format interiors and covers from the sidebar, and use <strong>AI Writer</strong> to generate new chapters.</p>
                            <button type="button" id="replayTourBtn" class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white px-4 py-2 text-sm font-semibold text-violet-700 hover:bg-violet-50">Replay Tour</button>
                        </div>
                        <div class="md:col-span-2">
                            <button type="button" id="btnUpdateProfile" class="bg-violet-600 hover:bg-violet-700 text-white px-8 py-2.5 rounded-lg text-sm font-medium transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2">
                                Save changes
                            </button>
                        </div>
                    </div>

                    <!-- Security -->
                    <div id="panelSecurity" class="hidden p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5">
                        <div class="md:col-span-2 text-sm text-slate-500 mb-1">Update the password you use to sign in to eBook AI.</div>
                        <div>
                            <label class="block text-sm font-medium text-slate-500 mb-2">Current password</label>
                            <input type="password" id="currentPassword" autocomplete="current-password" class="w-full border border-slate-200 rounded-lg px-4 py-2.5 text-base text-slate-800 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-500 mb-2">New password</label>
                            <input type="password" id="newPassword" autocomplete="new-password" class="w-full border border-slate-200 rounded-lg px-4 py-2.5 text-base text-slate-800 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-slate-500 mb-2">Confirm new password</label>
                            <input type="password" id="confirmPassword" autocomplete="new-password" class="w-full border border-slate-200 rounded-lg px-4 py-2.5 text-base text-slate-800 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500 md:max-w-md" />
                        </div>
                        <div class="md:col-span-2">
                            <button type="button" id="btnChangePassword" class="bg-violet-600 hover:bg-violet-700 text-white px-8 py-2.5 rounded-lg text-sm font-medium transition-colors shadow-sm">
                                Change password
                            </button>
                        </div>
                    </div>

                    <!-- Plan -->
                    <div id="panelPlan" class="hidden p-6 md:p-8 space-y-5">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-sm font-medium text-slate-500 mb-2">Current plan</label>
                                <input type="text" readonly value="@planLabel" class="w-full border border-slate-100 bg-slate-50 rounded-lg px-4 py-2.5 text-base text-slate-800 font-medium" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-500 mb-2">Billing cycle</label>
                                <input type="text" readonly value="@(Model?.BillingCycle ?? "—")" class="w-full border border-slate-100 bg-slate-50 rounded-lg px-4 py-2.5 text-base text-slate-600" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-500 mb-2">Plan price</label>
                                <input type="text" readonly value="@(Model != null ? Model.PlanPrice.ToString("C") : "—")" class="w-full border border-slate-100 bg-slate-50 rounded-lg px-4 py-2.5 text-base text-slate-600" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-500 mb-2">Renews / ends</label>
                                <input type="text" readonly value="@nextBillingText" class="w-full border border-slate-100 bg-slate-50 rounded-lg px-4 py-2.5 text-base text-slate-600" />
                            </div>
                            <div class="md:col-span-2">
                                <label class="block text-sm font-medium text-slate-500 mb-2">Payment method on file</label>
                                <input type="text" readonly value="@(Model?.PaymentMethod ?? "—")" class="w-full border border-slate-100 bg-slate-50 rounded-lg px-4 py-2.5 text-base text-slate-600" />
                            </div>
                        </div>
                        @if (Model?.PlanFeatures != null && Model.PlanFeatures.Count > 0)
                        {
                            <div>
                                <p class="text-sm font-medium text-slate-700 mb-2">Included features</p>
                                <ul class="rounded-lg border border-slate-200 divide-y divide-slate-100 max-h-48 overflow-y-auto">
                                    @foreach (var feat in Model.PlanFeatures)
                                    {
                                        <li class="flex items-center justify-between px-4 py-2.5 text-sm @(feat.IsIncluded ? "text-slate-700" : "text-slate-400")">
                                            <span>@feat.Name</span>
                                            @if (feat.IsIncluded)
                                            {<span class="text-emerald-600 font-medium">Included</span>}
                                            else
                                            {<span class="text-slate-400">—</span>}
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        <a href="/Payments/FeaturesSelection" class="inline-flex items-center gap-2 text-sm font-medium text-violet-600 hover:text-violet-700">
                            <i data-lucide="credit-card" class="w-4 h-4"></i> Plans &amp; features
                        </a>

                        <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-4 space-y-3">
                            <p class="text-sm font-semibold text-slate-800">Payment &amp; premium exports</p>
                            <p class="text-xs text-slate-500">Premium audiobook generation, full-service publish, and manuscript PDF download unlock after payment. Everything stays visible; actions show when you’re on a paid tier (demo uses your account role).</p>
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="text-xs font-semibold @(premiumUnlocked ? "text-emerald-600" : "text-amber-700")">@(premiumUnlocked ? "Payment active (demo)" : "Not paid — preview mode")</span>
                            </div>
                            <button type="button" id="btnProfilePdfExport" class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold @(premiumUnlocked ? "bg-violet-600 hover:bg-violet-700 text-white" : "bg-slate-200 text-slate-500 cursor-not-allowed")" @(premiumUnlocked ? "" : "disabled title=\"Available after payment\"")>
                                <i data-lucide="download" class="w-4 h-4"></i> Download manuscript PDF
                            </button>
                            @if (!premiumUnlocked)
                            {
                                <p class="text-xs text-slate-400"><i class="fas fa-info-circle text-violet-500"></i> Available after payment</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

</div>
</main>
</div>

<script>
(function () {
    function lucideInit() {
        if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();
    }
    lucideInit();
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', lucideInit);

    function wireProfileImageFallbacks() {
        var fallbackSvg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1200 720'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='#5b21b6'/><stop offset='55%' stop-color='#7c3aed'/><stop offset='100%' stop-color='#312e81'/></linearGradient></defs><rect width='1200' height='720' fill='url(#g)'/><circle cx='180' cy='120' r='220' fill='rgba(255,255,255,0.12)'/><circle cx='980' cy='620' r='260' fill='rgba(255,255,255,0.10)'/><text x='50%' y='52%' dominant-baseline='middle' text-anchor='middle' font-family='Inter,Segoe UI,Arial,sans-serif' font-size='52' fill='rgba(255,255,255,0.92)'>eBook AI</text></svg>";
        var fallbackData = 'data:image/svg+xml;utf8,' + encodeURIComponent(fallbackSvg);
        document.querySelectorAll('.profile-media-img').forEach(function (img) {
            if (!img) return;
            img.addEventListener('error', function () {
                if (img.getAttribute('data-fallback-applied') === '1') return;
                img.setAttribute('data-fallback-applied', '1');
                img.src = fallbackData;
            });
            var src = img.getAttribute('src') || '';
            if (!src.trim()) img.src = fallbackData;
        });
    }
    wireProfileImageFallbacks();

    var token = document.querySelector('#profileAntiForgery input[name="__RequestVerificationToken"]')?.value || '';
    var firstNameEl = document.getElementById('firstName');
    var lastNameEl = document.getElementById('lastName');
    var fullNameEl = document.getElementById('fullName');
    var username = document.getElementById('username');
    var email = document.getElementById('email');
    var country = document.getElementById('country');
    var profileBio = document.getElementById('profileBio');
    var btnUpdateProfile = document.getElementById('btnUpdateProfile');
    var btnChangePassword = document.getElementById('btnChangePassword');
    var btnPickImage = document.getElementById('btnPickImage');
    var btnChangeCover = document.getElementById('btnChangeCover');
    var btnRemoveCover = document.getElementById('btnRemoveCover');
    var btnRemoveImage = document.getElementById('btnRemoveImage');
    var fileInput = document.getElementById('profileFileInput');
    var backgroundFileInput = document.getElementById('profileBackgroundFileInput');
    var imageMain = document.getElementById('profileImageMain');
    var coverImage = document.getElementById('profileCoverImage');
    var headerAvatar = document.getElementById('profileHeaderAvatar');
    var nameHeading = document.getElementById('profileNameHeading');
    var headerName = document.getElementById('profileHeaderName');
    var defaultCoverImage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defaultCoverImage));

    function syncFullName() {
        var f = (firstNameEl.value || '').trim();
        var l = (lastNameEl.value || '').trim();
        fullNameEl.value = (f + ' ' + l).trim();
    }

    firstNameEl?.addEventListener('input', syncFullName);
    lastNameEl?.addEventListener('input', syncFullName);

    function notify(icon, text) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: icon, text: text, timer: 2200, showConfirmButton: false });
        } else alert(text);
    }

    // Tabs
    var tabAccount = document.getElementById('tabBtnAccount');
    var tabSecurity = document.getElementById('tabBtnSecurity');
    var tabPlan = document.getElementById('tabBtnPlan');
    var panelAccount = document.getElementById('panelAccount');
    var panelSecurity = document.getElementById('panelSecurity');
    var panelPlan = document.getElementById('panelPlan');

    function setTab(which) {
        [tabAccount, tabSecurity, tabPlan].forEach(function (b) {
            b.classList.remove('text-violet-600', 'border-violet-600');
            b.classList.add('text-slate-500', 'border-transparent');
        });
        [panelAccount, panelSecurity, panelPlan].forEach(function (p) { p.classList.add('hidden'); });
        if (which === 'account') {
            tabAccount.classList.add('text-violet-600', 'border-violet-600');
            tabAccount.classList.remove('text-slate-500', 'border-transparent');
            panelAccount.classList.remove('hidden');
        } else if (which === 'security') {
            tabSecurity.classList.add('text-violet-600', 'border-violet-600');
            tabSecurity.classList.remove('text-slate-500', 'border-transparent');
            panelSecurity.classList.remove('hidden');
        } else {
            tabPlan.classList.add('text-violet-600', 'border-violet-600');
            tabPlan.classList.remove('text-slate-500', 'border-transparent');
            panelPlan.classList.remove('hidden');
        }
        lucideInit();
    }
    tabAccount?.addEventListener('click', function () { setTab('account'); });
    tabSecurity?.addEventListener('click', function () { setTab('security'); });
    tabPlan?.addEventListener('click', function () { setTab('plan'); });

    document.querySelectorAll('.profile-dash-shortcut').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var t = btn.getAttribute('data-tab');
            if (t) setTab(t);
        });
    });

    function validateProfileInputs(payload) {
        if (!payload.fullName || payload.fullName.length < 2 || payload.fullName.length > 80) {
            return 'Full name must be between 2 and 80 characters.';
        }
        if (!/^[a-zA-Z0-9\s.\-']+$/.test(payload.fullName)) {
            return 'Full name contains invalid characters.';
        }
        var emailValue = String(payload.email || '');
        var looksLikeEmail = emailValue.includes('@@') && emailValue.indexOf('@@') > 0 && emailValue.indexOf('.', emailValue.indexOf('@@')) > emailValue.indexOf('@@') + 1;
        if (!emailValue || !looksLikeEmail) {
            return 'Please provide a valid email address.';
        }
        if (payload.username && (payload.username.length < 3 || payload.username.length > 32)) {
            return 'Username must be between 3 and 32 characters.';
        }
        if (payload.username && !/^[a-zA-Z0-9_.-]+$/.test(payload.username)) {
            return 'Username can contain only letters, numbers, dot, underscore, and hyphen.';
        }
        if (payload.country && payload.country.length > 60) {
            return 'Country must be 60 characters or fewer.';
        }
        if (payload.country && !/^[a-zA-Z\s.\-']+$/.test(payload.country)) {
            return 'Country contains invalid characters.';
        }
        if (payload.bio && payload.bio.length > 500) {
            return 'Bio must be 500 characters or fewer.';
        }
        return '';
    }

    btnUpdateProfile?.addEventListener('click', async function () {
        syncFullName();
        var payload = {
            fullName: (fullNameEl.value || '').trim(),
            email: (email.value || '').trim(),
            username: (username.value || '').trim(),
            country: (country && country.value ? country.value : '').trim(),
            bio: (profileBio && profileBio.value ? profileBio.value : '').trim()
        };
        var validationError = validateProfileInputs(payload);
        if (validationError) {
            notify('warning', validationError);
            return;
        }
        var res = await fetch('/Dashboard/UpdateProfile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(payload)
        });
        var data = await res.json().catch(function () { return null; });
        if (!data || !data.success) return notify('error', (data && data.message) ? data.message : 'Profile update failed.');
        var display = (data.fullName || payload.fullName || '').trim() || nameHeading.textContent;
        nameHeading.textContent = display;
        if (headerName) headerName.textContent = display;
        fullNameEl.value = data.fullName != null ? data.fullName : fullNameEl.value;
        if (data.email != null) email.value = data.email;
        if (data.username != null && username) username.value = data.username;
        if (data.country != null && country) country.value = data.country;
        if (data.bio != null && profileBio) profileBio.value = data.bio;
        if (data.fullName != null) {
            var parts = String(data.fullName).trim().split(/\s+/);
            if (firstNameEl) firstNameEl.value = parts[0] || '';
            if (lastNameEl) lastNameEl.value = parts.length > 1 ? parts.slice(1).join(' ') : '';
        }
        notify('success', 'Profile saved. Your account details are updated in the database.');
    });

    btnChangePassword?.addEventListener('click', async function () {
        var oldPass = document.getElementById('currentPassword').value || '';
        var newPass = document.getElementById('newPassword').value || '';
        var confirmPass = document.getElementById('confirmPassword').value || '';
        if (!oldPass || !newPass) return notify('error', 'Please fill password fields.');
        if (newPass !== confirmPass) return notify('error', 'New and confirm password must match.');
        if (newPass.length < 6) return notify('error', 'New password must be at least 6 characters.');
        var body = new URLSearchParams();
        body.append('__RequestVerificationToken', token);
        body.append('oldPassword', oldPass);
        body.append('newPassword', newPass);
        var res = await fetch('/Dashboard/ChangePassword', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: body.toString()
        });
        if (!res.ok) {
            var err = await res.json().catch(function () { return null; });
            return notify('error', (err && err.message) ? err.message : 'Failed to change password.');
        }
        document.getElementById('currentPassword').value = '';
        document.getElementById('newPassword').value = '';
        document.getElementById('confirmPassword').value = '';
        notify('success', 'Password changed successfully.');
    });

    function pickProfileFile() { if (fileInput) fileInput.click(); }
    function pickBackgroundFile() { if (backgroundFileInput) backgroundFileInput.click(); }
    btnPickImage?.addEventListener('click', function (e) { e.preventDefault(); pickProfileFile(); });
    btnChangeCover?.addEventListener('click', function (e) { e.stopPropagation(); pickBackgroundFile(); });
    document.getElementById('profileCoverBanner')?.addEventListener('click', function (e) {
        if (e.target.closest('#btnRemoveCover') || e.target.closest('#btnChangeCover')) return;
        pickBackgroundFile();
    });
    document.getElementById('profileCoverBanner')?.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pickBackgroundFile(); }
    });

    fileInput?.addEventListener('change', async function () {
        if (!fileInput.files || !fileInput.files[0]) return;
        var fd = new FormData();
        fd.append('profilePicture', fileInput.files[0]);
        fd.append('__RequestVerificationToken', token);
        var res = await fetch('/Dashboard/UploadProfilePicture', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: fd
        });
        var data = await res.json().catch(function () { return null; });
        if (!data || !data.success) return notify('error', (data && data.message) ? data.message : 'Image upload failed.');
        var src = data.imagePath + (data.imagePath.indexOf('?') >= 0 ? '&' : '?') + 't=' + Date.now();
        imageMain.src = src;
        if (headerAvatar) headerAvatar.src = src;
        try {
            sessionStorage.setItem('newProfilePicture', data.imagePath);
            localStorage.setItem('profilePictureUpdated', Date.now().toString());
        } catch (e) {}
        notify('success', 'Profile photo saved to your account.');
        fileInput.value = '';
        lucideInit();
    });

    backgroundFileInput?.addEventListener('change', async function () {
        if (!backgroundFileInput.files || !backgroundFileInput.files[0]) return;
        var fd = new FormData();
        fd.append('backgroundImage', backgroundFileInput.files[0]);
        fd.append('__RequestVerificationToken', token);
        var res = await fetch('/Dashboard/UploadProfileBackground', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: fd
        });
        var data = await res.json().catch(function () { return null; });
        if (!data || !data.success) return notify('error', (data && data.message) ? data.message : 'Background upload failed.');
        if (coverImage) {
            coverImage.src = data.imagePath + (data.imagePath.indexOf('?') >= 0 ? '&' : '?') + 't=' + Date.now();
            coverImage.setAttribute('data-fallback-applied', '0');
        }
        notify('success', 'Background image saved to your account.');
        backgroundFileInput.value = '';
    });

    btnRemoveImage?.addEventListener('click', async function () {
        var res = await fetch('/Dashboard/RemoveProfilePicture', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token }
        });
        var data = await res.json().catch(function () { return null; });
        if (!data || !data.success) return notify('error', (data && data.message) ? data.message : 'Could not remove image.');
        var fallback = '@defaultAvatar';
        imageMain.src = fallback;
        if (headerAvatar) headerAvatar.src = fallback;
        notify('success', 'Profile photo removed.');
    });

    btnRemoveCover?.addEventListener('click', async function (e) {
        e.stopPropagation();
        var res = await fetch('/Dashboard/RemoveProfileBackground', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token }
        });
        var data = await res.json().catch(function () { return null; });
        if (!data || !data.success) return notify('error', (data && data.message) ? data.message : 'Could not remove background image.');
        if (coverImage) {
            coverImage.src = defaultCoverImage;
            coverImage.setAttribute('data-fallback-applied', '0');
        }
        notify('success', 'Background image removed.');
    });

    document.getElementById('btnCopyWriteUrl')?.addEventListener('click', function () {
        var u = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(writeUrl));
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(u).then(function () { notify('success', 'AI Writer link copied.'); }).catch(function () { prompt('Copy:', u); });
        } else prompt('Copy:', u);
    });

    var premiumOk = @(premiumUnlocked ? "true" : "false");
    document.getElementById('btnProfilePdfExport')?.addEventListener('click', function () {
        var btn = document.getElementById('btnProfilePdfExport');
        if (!premiumOk || (btn && btn.disabled)) return notify('info', 'PDF download is available after payment.');
        var w = window.open('', '_blank');
        if (!w) return notify('error', 'Allow pop-ups to download, or use Print to PDF.');
        var name = (nameHeading && nameHeading.textContent) ? nameHeading.textContent : 'My manuscript';
        w.document.write('<html><head><title>' + name.replace(/</g,'') + '</title></head><body style="font-family:Georgia,serif;padding:2rem"><h1>' + name.replace(/</g,'') + '</h1><p>Demo PDF export: your latest draft would be merged here from the server.</p><p style="color:#64748b;font-size:0.9rem">Generated from Profile → premium export.</p></body></html>');
        w.document.close();
        w.focus();
        setTimeout(function () { w.print(); }, 400);
    });
})();
</script>
