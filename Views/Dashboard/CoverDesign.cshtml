    if (btnKdpPrintCalculator) {
        btnKdpPrintCalculator.addEventListener('click', function () { openPrintCalculatorFromPage(); });
    }

    if (btnGoToPublish) btnGoToPublish.addEventListener('click', function (e) {
        e.preventDefault();
        if (!selectedBook || !selectedBook.bookId) {
            toast('error', 'No book loaded. Create or select a book first.');
            return;
        }
        var bid = selectedBook.bookId;
        try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(bid)); } catch (_) {}
        window.location.href = '/Dashboard/Publish?bookId=' + encodeURIComponent(bid);
    });

    function boot() {
        if (initialBookId <= 0) {
            var s = 0;
            try { s = parseInt(sessionStorage.getItem(FORMATTER_BOOK_KEY) || '0', 10); } catch (_) { s = 0; }
            if (s > 0) {
                window.location.replace('/Dashboard/CoverDesign?bookId=' + s);
                return;
            }
        }
        loadBooks();
        refreshLucide();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
})();
</script>
