    var covWrapBuildInFlight = false;
    var covWrapBuildPromise = null;

    function setCovWrapView(mode) {
        mode = mode === 'full' ? 'full' : 'front';
        var col = document.getElementById('covPreviewColumn');
        var tabs = document.getElementById('covWrapViewTabs');
        if (col) col.classList.toggle('cov-show-full-wrap', mode === 'full');
        if (tabs) {
            tabs.querySelectorAll('.cov-wrap-view-tab').forEach(function (b) {
                var on = b.getAttribute('data-wrap-view') === mode;
                b.classList.toggle('is-active', on);
            });
