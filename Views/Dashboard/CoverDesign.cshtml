    function persistPublishFormat(fmt) {
        fmt = normalizePublishFormat(fmt);
        if (!fmt || !selectedBook || !selectedBook.bookId) return Promise.resolve();
        return fetch('/Dashboard/SetPublishFormat', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ bookId: selectedBook.bookId, format: fmt })
        }).then(function (r) { return r.json(); }).then(function (d) {
            if (d && d.success && d.format) bookPublishFormat = normalizePublishFormat(d.format);
            return d;
        }).catch(function () { return null; });
    }

    function applyPublishFormat(fmt, opts) {
        opts = opts || {};
        var next = normalizePublishFormat(fmt);
        if (!next) next = 'Paperback';
        bookPublishFormat = next;
        syncFormatSegUi();
        syncPrintWrapUiVisibility();
        updatePublishGate();
        updateGenerateGate();
        if (opts.persist) {
            // User taps only Ebook | Paperback — persist that choice (Both becomes Paperback if they tap it).
            var saveAs = opts.userClicked ? formatSegUiValue(next) : next;
            persistPublishFormat(saveAs);
        }
    }

    function canGenerateFullCover() {
        var bookOk = !!(selectedBook && selectedBook.bookId);
        var titleOk = !!(bookTitle && (bookTitle.value || '').trim());
        var fmtOk = !!normalizePublishFormat(bookPublishFormat);
        var dirOk = false;
        try { dirOk = !!covComposeDescription(); } catch (_) {
            dirOk = !!(imageDirection && (imageDirection.value || '').trim());
        }
        if (!bookOk || !titleOk || !fmtOk || !dirOk) return false;
        if (needsPrintWrapAutoBuild()) {
            var sum = (backCoverSummary && backCoverSummary.value || '').trim();
            if (!sum) return false;
        }
        return true;
    }

    function updateGenerateGate() {
        if (!btnGenerate && !btnRegenerate) return;
        var ok = canGenerateFullCover();
        var busy = previewBusy && !previewBusy.classList.contains('hidden');
        var missing = [];
        if (!(selectedBook && selectedBook.bookId)) missing.push('manuscript');
        if (!(bookTitle && (bookTitle.value || '').trim())) missing.push('title');
        if (!normalizePublishFormat(bookPublishFormat)) missing.push('cover type');
        var dirOk = false;
        try { dirOk = !!covComposeDescription(); } catch (_) {
            dirOk = !!(imageDirection && (imageDirection.value || '').trim());
        }
        if (!dirOk) missing.push('image direction');
        if (needsPrintWrapAutoBuild() && !(backCoverSummary && (backCoverSummary.value || '').trim())) {
            missing.push('book summary');
        }
        var needMsg = missing.length
            ? ('Add: ' + missing.join(', '))
            : (isEbookCoverMode()
                ? 'Generate the front cover for this manuscript'
                : 'Generate front cover, then full wrap');
        if (btnGenerate && !busy) {
            btnGenerate.disabled = !ok;
            btnGenerate.title = needMsg;
        }
        if (btnRegenerate && !busy) {
            btnRegenerate.disabled = !ok;
            btnRegenerate.title = ok
                ? (isEbookCoverMode()
                    ? 'Regenerate a fresh front cover'
                    : 'Regenerate a fresh full cover with the current fields')
                : needMsg;
        }
    }

    /** Saved front cover on disk — required before any full-wrap API call. */
    function hasSavedFrontForWrap() {
        if (selectedPath && String(selectedPath).trim() && String(selectedPath).indexOf('data:') !== 0) return true;
        var front = (selectedBook && (selectedBook.aiCoverLastPreview || selectedBook.coverImagePath)) || '';
        return !!String(front).trim() && String(front).indexOf('data:') !== 0;
    }

    function resetPrintWrapPreviewUi() {
        coverWraparoundRef = '';
        setPrintWrapSaved(false);
        showCovFullWrapSection(false);
        var tabs = document.getElementById('covWrapViewTabs');
        if (tabs) tabs.classList.add('hidden');
        setCovWrapView('front');
        var img = document.getElementById('covFullWrapImg');
        if (img) { img.src = ''; img.classList.add('hidden'); }
        var frame = document.getElementById('covFullWrapFrame');
