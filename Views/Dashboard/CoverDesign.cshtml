@{
    ViewData["Title"] = "AI Cover Design";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var initialBookId = ViewBag.BookId as int? ?? 0;
    var coverProgressPlaceholder = Url.Content("~/images/books/cover-in-progress.png");
}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Fredoka+One&family=Baloo+2:wght@500;700&display=swap" rel="stylesheet">
<style>
    /* Match dashboard: Inter body, Playfair headings, violet accents */
    .cover-design-page { font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; color: #0f172a; }
    .cover-design-page .font-serif { font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; }
    /* Fallback when no cover image: solid brand violet — no gradient / no blue wash */
    .cov-preview-fallback-purple {
        background: #475569 !important;
        background-image: none !important;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), inset 0 -1px 0 rgba(0, 0, 0, 0.08);
    }
    .cov-preview-typography {
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55), 0 1px 3px rgba(0, 0, 0, 0.45);
    }
    /* Live title/author: multi-line clamp (no hardcoded sample text; binds to form / API) */
    .cov-preview-title {
        display: -webkit-box;
        -webkit-line-clamp: 5;
        -webkit-box-orient: vertical;
        overflow: hidden;
        word-break: break-word;
    }
    #covPreviewAuthor {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        word-break: break-word;
    }
    /* Image Direction: taller writing area, no visible Y-scrollbar (still scrolls with wheel / touch) */
    .cov-image-direction-shell {
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        position: relative;
        overflow: hidden;
    }
    .cov-image-direction-shell:focus-within {
        box-shadow: 0 4px 24px -8px rgba(109, 40, 217, 0.12), 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .cov-image-direction-textarea {
        min-height: 15rem;
        max-height: 22rem;
        line-height: 1.65;
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        caret-color: #6d28d9;
        border-radius: 14px 14px 4px 4px;
    }
    .cov-image-direction-textarea::placeholder {
        color: #94a3b8;
    }
    .cov-image-direction-textarea::-webkit-scrollbar {
        width: 0;
        height: 0;
    }
    .cov-action-icon-btn {
        flex-shrink: 0;
        width: 2.75rem;
        height: 2.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.875rem;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
        cursor: pointer;
    }
    .cov-action-icon-btn:active:not(:disabled) { transform: scale(0.96); }
    .cov-action-icon-btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
    .cov-action-icon-btn--muted {
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #475569;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
    }
    .cov-action-icon-btn--muted:hover:not(:disabled) {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: #5b21b6;
        box-shadow: 0 4px 12px -4px rgba(91, 33, 182, 0.2);
    }
    .cov-action-icon-btn--accent {
        border: 1px solid #ddd6fe;
        background: #f5f3ff;
        color: #6d28d9;
        box-shadow: 0 1px 2px rgba(91, 33, 182, 0.08);
    }
    .cov-action-icon-btn--accent:hover:not(:disabled) {
        background: #ede9fe;
        border-color: #c4b5fd;
        box-shadow: 0 4px 14px -4px rgba(91, 33, 182, 0.35);
    }
    .cov-action-icon-btn:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.35);
    }
    /* Cover style: visual cards (left panel only) */
    .cov-style-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; }
    @@media (min-width: 420px) { .cov-style-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .cov-style-card {
        position: relative; border-radius: 14px; border: 2px solid #e2e8f0; background: #fff;
        padding: 0.65rem 0.5rem 0.55rem; text-align: center; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s, transform 0.12s;
        min-height: 4.25rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.2rem;
    }
    .cov-style-card:hover { border-color: #c4b5fd; box-shadow: 0 4px 14px -6px rgba(91, 33, 182, 0.35); }
    .cov-style-card.is-selected { border-color: #7c3aed; box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.22); }
    .cov-style-card:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.35); }
    .cov-style-card:active { transform: scale(0.98); }
    .cov-style-card__swatch { width: 100%; height: 1.35rem; border-radius: 8px; margin-bottom: 0.15rem; }
    .cov-style-card__label { font-size: 0.7rem; font-weight: 600; color: #334155; letter-spacing: 0.02em; }
    .cov-style-card__hint { font-size: 0.62rem; color: #94a3b8; line-height: 1.2; }
    /* Preview typography by style (right panel — no field labels, only live title/author) */
    #covPreviewShell { transition: box-shadow 0.35s ease; }
    #covPreviewShell.cov-style-minimal #covPreviewTitle { font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; font-size: clamp(1.1rem, 3.5vw, 1.65rem); }
    #covPreviewShell.cov-style-bold #covPreviewTitle { font-weight: 800; letter-spacing: -0.02em; font-size: clamp(1.35rem, 4vw, 2.25rem); }
    #covPreviewShell.cov-style-elegant #covPreviewTitle { font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-weight: 600; }
    #covPreviewShell.cov-style-modern #covPreviewTitle { font-family: ui-sans-serif, system-ui, sans-serif; font-weight: 700; letter-spacing: -0.03em; }
    #covPreviewShell.cov-style-vintage #covPreviewTitle { font-family: Georgia, 'Times New Roman', serif; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; font-size: clamp(1rem, 3vw, 1.5rem); }
    #covPreviewShell.cov-style-minimal #covPreviewAuthor { letter-spacing: 0.28em; text-transform: uppercase; font-size: 0.72rem; }
    #covPreviewShell.cov-style-bold #covPreviewAuthor { font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.8rem; }
    #covPreviewShell.cov-style-elegant #covPreviewAuthor { font-family: 'Playfair Display', Georgia, serif; font-style: italic; letter-spacing: 0.06em; text-transform: none; font-size: 0.95rem; }
    #covPreviewShell.cov-style-modern #covPreviewAuthor { font-family: ui-sans-serif, system-ui, sans-serif; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; font-size: 0.7rem; }
    #covPreviewShell.cov-style-vintage #covPreviewAuthor { font-family: Georgia, serif; letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.72rem; opacity: 0.95; }
    /* Cartoon — playful children's-book look (gradient shows when no AI art is set yet). */
    #covPreviewShell.cov-style-cartoon { background: linear-gradient(135deg, #FFE566, #FF6B9D); border: 6px solid #333; border-radius: 12px; }
    #covPreviewShell.cov-style-cartoon #covPreviewTitle { font-family: 'Fredoka One', 'Baloo 2', cursive; font-weight: 400; color: #1A1A1A; text-shadow: 3px 3px 0px rgba(0,0,0,0.3); }
    #covPreviewShell.cov-style-cartoon #covPreviewAuthor { font-family: 'Fredoka One', 'Baloo 2', cursive; color: #1A1A1A; text-shadow: 2px 2px 0px rgba(0,0,0,0.25); }
    /* Print / eBook format toggle (Cover Design) */
    .cov-format-seg {
        display: flex;
        gap: 0.4rem;
        padding: 0.3rem;
        border-radius: 14px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }
    .cov-format-seg__btn {
        flex: 1 1 0;
        min-width: 0;
        padding: 0.65rem 0.75rem;
        border-radius: 11px;
        font-size: 0.8125rem;
        font-weight: 650;
        color: #64748b;
        background: transparent;
        border: 1px solid transparent;
        cursor: pointer;
        transition: background 0.15s, color 0.15s, border-color 0.15s, box-shadow 0.15s;
    }
    .cov-format-seg__btn:hover { color: #5b21b6; background: #fff; border-color: #ddd6fe; }
    .cov-format-seg__btn.is-active {
        color: #fff;
        background: #7c3aed;
        border-color: #7c3aed;
        box-shadow: 0 4px 12px -4px rgba(124, 58, 237, 0.45);
    }
    .cov-format-seg__btn:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.35); }
    .cov-format-hint { font-size: 0.75rem; color: #94a3b8; line-height: 1.4; margin: 0.45rem 0 0; }
    #btnGenerate:disabled,
    #btnRegenerate:disabled {
        opacity: 0.45;
        cursor: not-allowed;
        box-shadow: none;
    }
    /* Print / eBook target tabs + size lock (both 2:3). */
    .cov-target-tabs { display: flex; gap: 0.5rem; }
    .cov-target-tab { padding: 6px 14px; border-radius: 999px; font-size: 0.8rem; font-weight: 600; color: #6d28d9; background: #f5f3ff; border: 1px solid #ddd6fe; cursor: pointer; transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease; }
    .cov-target-tab:hover { background: #ede9fe; border-color: #c4b5fd; }
    .cov-target-tab.is-active { background: #7c3aed; color: #fff; border-color: #7c3aed; }
    #covFullWrapSection .cov-full-wrap-stage {
        max-width: 100%;
        overflow-x: auto;
        border-radius: 16px;
        border: 1px solid #ddd6fe;
        background: linear-gradient(180deg, #faf5ff 0%, #f8fafc 100%);
        padding: 16px;
        box-shadow: 0 8px 24px -12px rgba(91, 33, 182, 0.25);
    }
    #covFullWrapImg {
        width: 100%;
        max-width: 100%;
        height: auto;
        display: block;
        margin: 0 auto;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.12);
        object-fit: contain;
        object-position: center;
        background: #fff;
    }
    #covFullWrapFrame { width: 100%; }
    #covFullWrapFrame .cov-wrap-guides {
        position: absolute;
        inset: 0;
        pointer-events: none;
        border-radius: 8px;
        overflow: hidden;
    }
    .cov-wrap-guide-label {
        position: absolute;
        top: 8px;
        z-index: 2;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #fff;
        background: rgba(15, 23, 42, 0.55);
        border-radius: 4px;
        padding: 2px 6px;
    }
    .cov-wrap-guide-label--back { left: 8%; }
    .cov-wrap-guide-label--spine { left: 50%; transform: translateX(-50%); }
    .cov-wrap-guide-label--front { right: 8%; }
    .cov-wrap-guide-bleed {
        position: absolute;
        inset: 0;
        box-shadow: inset 0 0 0 3px rgba(239, 68, 68, 0.28);
    }
    .cov-wrap-guide-safe {
        position: absolute;
        inset: 4.5% 3.5%;
        border: 1px dashed rgba(16, 185, 129, 0.55);
    }
    .cov-wrap-guide-barcode {
        position: absolute;
        right: 7%;
        bottom: 7%;
        width: 15%;
        height: 13%;
        border: 1px dashed rgba(100, 116, 139, 0.65);
        background: rgba(255, 255, 255, 0.22);
        border-radius: 2px;
        z-index: 2;
    }
    .cov-wrap-guide-barcode::after {
        content: "Barcode";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(51, 65, 85, 0.75);
        white-space: nowrap;
    }
    .cov-project-row { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
    .cov-project-row select { flex: 1 1 12rem; min-width: 0; }
    .cov-project-row .cov-project-btn {
        padding: 0.45rem 0.7rem;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 650;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #475569;
        cursor: pointer;
    }
    .cov-project-row .cov-project-btn:hover { border-color: #c4b5fd; color: #5b21b6; }
    .cov-wrap-view-tabs { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; }
    .cov-wrap-view-tab { padding: 5px 12px; border-radius: 999px; font-size: 0.75rem; font-weight: 600; color: #6d28d9; background: #f5f3ff; border: 1px solid #ddd6fe; cursor: pointer; }
    .cov-wrap-view-tab.is-active { background: #7c3aed; color: #fff; border-color: #7c3aed; }
    #covPreviewColumn.cov-show-full-wrap #covFullWrapSection { display: block !important; }
    /* Keep front + wrap visible together so preview matches what Publish exports. */
    #covPreviewColumn.cov-show-full-wrap .cov-preview-book-stage { display: flex; }
    #covPreviewColumn.cov-target-print .cov-preview-book-stage,
    #covPreviewColumn.cov-target-ebook .cov-preview-book-stage {
        max-width: min(100%, 28rem);
    }
    .cov-preview-book-stage {
        perspective: none;
        padding: 0;
        transform-style: flat;
        width: 100%;
        aspect-ratio: 2 / 3;
        position: relative;
    }
    /* Clean upright book preview — no skewed 3D tilt */
    #covPreviewShell.cov-preview-3d {
        transform: none;
        transform-style: flat;
        transition: box-shadow 0.35s ease, transform 0.2s ease;
        box-shadow:
            0 1px 2px rgba(15, 23, 42, 0.06),
            0 18px 40px -14px rgba(15, 23, 42, 0.38),
            6px 0 14px -8px rgba(15, 23, 42, 0.22),
            inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }
    #covPreviewShell.cov-preview-3d:hover {
        transform: translateY(-2px);
        box-shadow:
            0 2px 4px rgba(15, 23, 42, 0.08),
            0 22px 48px -14px rgba(15, 23, 42, 0.42),
            8px 0 16px -8px rgba(15, 23, 42, 0.24),
            inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    }
    #covPreviewTitle.cov-line-empty, #covPreviewAuthor.cov-line-empty { opacity: 0; min-height: 0.1em; }
    /* Image-only preview: cover art from API, no title/author overlay */
    .cov-preview-typography { display: none !important; }
    .cov-preview-card .cov-preview-book-stage,
    .cov-preview-card #optionsWrap {
        align-self: center;
        width: 100%;
        max-width: min(100%, 28rem);
        margin-left: auto;
        margin-right: auto;
    }
    .cov-preview-card #covPreviewShell {
        width: 100%;
        height: 100%;
    }
    /* Premium export CTA */
    .cov-export-premium {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
        width: 100%; margin-top: 0.75rem; padding: 0.95rem 1.25rem;
        border-radius: 1rem; border: none; cursor: pointer;
        background: linear-gradient(135deg, #5b21b6 0%, #7c3aed 48%, #a78bfa 100%);
        color: #fff; font-weight: 700; font-size: 0.92rem; letter-spacing: 0.02em;
        box-shadow: 0 14px 32px -10px rgba(91, 33, 182, 0.65), inset 0 1px 0 rgba(255,255,255,0.22);
        transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    }
    .cov-export-premium:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 18px 40px -10px rgba(91, 33, 182, 0.75), inset 0 1px 0 rgba(255,255,255,0.28);
        filter: brightness(1.03);
    }
    .cov-export-premium:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
    /* Print wrap modal */
    .cov-wrap-modal-panel {
        background: #fff; border-radius: 1.25rem; max-width: 56rem; width: 100%;
        max-height: 92vh; overflow: auto; padding: 1.5rem;
        box-shadow: 0 32px 64px -24px rgba(15, 23, 42, 0.45);
        border: 1px solid rgba(124, 58, 237, 0.12);
    }
    .cov-wrap-parts {
        display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; align-items: start;
        margin-bottom: 1rem;
    }
    @@media (max-width: 640px) {
        .cov-wrap-parts { grid-template-columns: 1fr; }
    }
    .cov-wrap-part--spine,
    .cov-wrap-full { display: none !important; }
    .cov-wrap-part {
        border-radius: 0.85rem; overflow: hidden; background: #f8fafc;
        border: 1px solid #e2e8f0; box-shadow: 0 4px 14px -8px rgba(15,23,42,0.15);
    }
    .cov-wrap-part-label {
        font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
        color: #64748b; padding: 0.45rem 0.65rem; background: #fff; border-bottom: 1px solid #f1f5f9;
    }
    .cov-wrap-part img { width: 100%; height: auto; display: block; object-fit: fill; background: #fff; }
    .cov-wrap-part--front img, .cov-wrap-part--back img { aspect-ratio: var(--cov-panel-aspect, 2 / 3); }
    .cov-wrap-full img {
        width: 100%; height: auto; aspect-ratio: var(--cov-wrap-aspect, auto);
        border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #f8fafc;
    }
    .cov-wrap-kdp-debug {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.68rem; line-height: 1.45; color: #64748b; background: #f8fafc;
        border: 1px solid #e2e8f0; border-radius: 0.65rem; padding: 0.55rem 0.75rem; margin-bottom: 0.85rem;
    }
    .cov-wrap-saved-badge {
        display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.72rem; font-weight: 600;
        color: #047857; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 999px; padding: 0.25rem 0.65rem;
    }
    /* Main layout — Formatting-style: left scrolls (hidden bar), right preview sticky */
    .cover-design-page.dash-flow-cover {
        width: 100%;
    }
    @@media (min-width: 1024px) {
        .dash-flow-page:has(.cover-design-page) > .dash-flow-main {
            overflow: visible !important;
        }
        .dash-flow-page:has(.cover-design-page) .dash-flow-inner {
            overflow: visible;
        }
    }
    #coverMain.cov-main-card {
        align-items: stretch;
        background: transparent;
        border-radius: 0;
        border: none;
        box-shadow: none;
        overflow: visible;
        gap: var(--dash-flow-gap, 1rem);
    }
    @@media (min-width: 1024px) {
        #coverMain.cov-main-card {
            display: grid !important;
            grid-template-columns: minmax(0, var(--dash-flow-left, 28%)) minmax(0, var(--dash-flow-right, 72%));
            align-items: stretch;
            min-height: calc(100dvh - 4.5rem);
            max-height: calc(100dvh - 4.5rem);
            overflow: hidden;
        }
        #coverMain.cov-main-card > .cov-form-column {
            width: 100% !important;
            max-width: 100%;
            display: flex;
            flex-direction: column;
            max-height: calc(100dvh - 5rem);
            min-height: 0;
            min-width: 0;
            overflow: hidden;
            position: relative;
            z-index: 5;
        }
        #coverMain.cov-main-card > .cov-form-column .cov-form-scroll {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 0.25rem;
            padding-bottom: 0.75rem;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        #coverMain.cov-main-card > .cov-form-column .cov-form-scroll::-webkit-scrollbar {
            width: 0 !important;
            height: 0 !important;
            display: none !important;
        }
        #coverMain.cov-main-card > .cov-form-column .cov-form-actions {
            flex-shrink: 0;
            padding-top: 0.65rem;
            background: linear-gradient(180deg, rgba(245, 243, 255, 0) 0%, #f5f3ff 32%);
        }
        #coverMain.cov-main-card > #covPreviewColumn {
            width: 100% !important;
            max-width: 100%;
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 0.35rem;
            align-self: start;
            max-height: calc(100dvh - 3.75rem);
            min-height: calc(100dvh - 3.75rem);
            min-width: 0;
            overflow: hidden;
            z-index: 1;
        }
    }
    .cover-design-page .cov-form-column {
        background: transparent;
        border: none;
        padding-left: 0;
        padding-right: 0;
    }
    #covPreviewColumn {
        align-self: stretch;
        background: transparent;
        justify-content: flex-start;
        align-items: stretch;
    }
    .cov-preview-column-inner {
        width: 100%;
        max-width: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        min-height: 0;
        gap: 0.35rem;
    }
    .cov-preview-column-inner .cov-preview-header-row,
    .cov-preview-column-inner #covPreviewHeaderTitle,
    .cov-preview-column-inner #optionsWrap,
    .cov-preview-column-inner #covWrapViewTabs,
    .cov-preview-column-inner #covWrapBuildBanner,
    .cov-preview-column-inner #covFullWrapSection {
        width: 100%;
        max-width: min(100%, 36rem);
        margin-left: auto;
        margin-right: auto;
    }
    #covPreviewColumn .cov-preview-book-stage {
        align-self: center;
        margin-left: auto;
        margin-right: auto;
        width: 100%;
        max-width: min(100%, 28rem);
        max-height: min(70vh, 40rem);
        flex: 0 1 auto;
        min-height: 0;
        display: block;
        aspect-ratio: 2 / 3;
        padding: 0;
        background: transparent;
        border-radius: 0.85rem;
        overflow: hidden;
    }
    /* Cover fills the stage exactly (same size) */
    #covPreviewColumn #covPreviewShell {
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        max-height: none !important;
        aspect-ratio: unset;
        margin: 0;
        display: block;
        border-radius: 0.35rem 0.85rem 0.85rem 0.35rem;
    }
    #covPreviewPlaceholderImg,
    #covPreviewBgImg {
        object-fit: cover;
        object-position: center center;
