    (function bindCoverProjects() {
        var sel = document.getElementById('covProjectSelect');
        var btnNew = document.getElementById('btnCovNew');
        var btnDup = document.getElementById('btnCovDup');
        var btnDel = document.getElementById('btnCovDel');
        if (sel) {
            sel.addEventListener('change', function () {
                var id = parseInt(sel.value, 10) || 0;
                if (!id) return;
                postCoverProject('/Dashboard/ActivateCoverDesign', { coverId: id }).then(function (d) {
                    if (!(d && d.success && d.cover)) {
                        toast('error', (d && d.message) || 'Could not open cover.');
                        return;
                    }
                    activeCoverId = d.cover.coverId;
                    applyPublishFormat(d.cover.coverType || 'Paperback', { persist: false });
                    if (d.cover.frontImagePath) {
                        applyBestFrontPreview(d.cover.frontImagePath).catch(function () {
                            selectedPath = d.cover.frontImagePath;
                            setCoverImageVisible(toUrl(d.cover.frontImagePath));
                        });
                    }
                    if (selectedBook && selectedBook.bookId) loadSavedPrintWrapAssets(selectedBook.bookId);
                    updatePublishGate();
                    toast('info', 'Opened ' + (d.cover.displayName || 'cover') + '.');
                });
            });
        }
        if (btnNew) {
            btnNew.addEventListener('click', function () {
                if (!selectedBook || !selectedBook.bookId) {
                    toast('info', 'Attach a book first.');
                    return;
                }
                var type = formatSegUiValue(bookPublishFormat) || 'Paperback';
                postCoverProject('/Dashboard/CreateCoverDesign', { bookId: selectedBook.bookId, coverType: type }).then(function (d) {
                    if (!(d && d.success)) {
                        toast('error', (d && d.message) || 'Could not create cover.');
                        return;
                    }
                    loadCoverProjects(selectedBook.bookId);
                    applyPublishFormat(type, { persist: true, userClicked: true });
                    toast('success', 'New cover project created.');
                });
