@{
    ViewData["Title"] = "AI Cover Design";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var initialBookId = ViewBag.BookId as int? ?? 0;
}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
<style>
    /* Match dashboard: Inter body, Playfair headings, violet accents */
    .cover-design-page { font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; color: #0f172a; }
    .cover-design-page .font-serif { font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; }
    /* Fallback when no cover image: solid brand violet — no gradient / no blue wash */
    .cov-preview-fallback-purple {
        background: #5b21b6 !important;
        background-image: none !important;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), inset 0 -1px 0 rgba(0, 0, 0, 0.08);
    }
    .cov-preview-typography {
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55), 0 1px 3px rgba(0, 0, 0, 0.45);
    }
    /* Live title/author: multi-line clamp (no hardcoded sample text; binds to form / API) */
    .cov-preview-title {
        display: -webkit-box;
        -webkit-line-clamp: 5;
        -webkit-box-orient: vertical;
        overflow: hidden;
        word-break: break-word;
    }
    #covPreviewAuthor {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        word-break: break-word;
    }
    /* Image Direction: taller writing area, no visible Y-scrollbar (still scrolls with wheel / touch) */
    .cov-image-direction-shell {
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        position: relative;
        overflow: hidden;
    }
    .cov-image-direction-shell:focus-within {
        box-shadow: 0 4px 24px -8px rgba(109, 40, 217, 0.12), 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .cov-image-direction-textarea {
        min-height: 15rem;
        max-height: 22rem;
        line-height: 1.65;
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        caret-color: #6d28d9;
        border-radius: 14px 14px 4px 4px;
    }
    .cov-image-direction-textarea::placeholder {
        color: #94a3b8;
    }
    .cov-image-direction-textarea::-webkit-scrollbar {
        width: 0;
        height: 0;
    }
    .cov-action-icon-btn {
        flex-shrink: 0;
        width: 2.75rem;
        height: 2.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.875rem;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
        cursor: pointer;
    }
    .cov-action-icon-btn:active:not(:disabled) { transform: scale(0.96); }
    .cov-action-icon-btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
    .cov-action-icon-btn--muted {
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #475569;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
    }
    .cov-action-icon-btn--muted:hover:not(:disabled) {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: #5b21b6;
        box-shadow: 0 4px 12px -4px rgba(91, 33, 182, 0.2);
    }
    .cov-action-icon-btn--accent {
        border: 1px solid #ddd6fe;
        background: #f5f3ff;
        color: #6d28d9;
        box-shadow: 0 1px 2px rgba(91, 33, 182, 0.08);
    }
    .cov-action-icon-btn--accent:hover:not(:disabled) {
        background: #ede9fe;
        border-color: #c4b5fd;
        box-shadow: 0 4px 14px -4px rgba(91, 33, 182, 0.35);
    }
    .cov-action-icon-btn:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.35);
    }
    /* Cover style: visual cards (left panel only) */
    .cov-style-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; }
    @@media (min-width: 420px) { .cov-style-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .cov-style-card {
        position: relative; border-radius: 14px; border: 2px solid #e2e8f0; background: #fff;
        padding: 0.65rem 0.5rem 0.55rem; text-align: center; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s, transform 0.12s;
        min-height: 4.25rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.2rem;
    }
    .cov-style-card:hover { border-color: #c4b5fd; box-shadow: 0 4px 14px -6px rgba(91, 33, 182, 0.35); }
    .cov-style-card.is-selected { border-color: #7c3aed; box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.22); }
    .cov-style-card:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.35); }
    .cov-style-card:active { transform: scale(0.98); }
    .cov-style-card__swatch { width: 100%; height: 1.35rem; border-radius: 8px; margin-bottom: 0.15rem; }
    .cov-style-card__label { font-size: 0.7rem; font-weight: 600; color: #334155; letter-spacing: 0.02em; }
    .cov-style-card__hint { font-size: 0.62rem; color: #94a3b8; line-height: 1.2; }
    /* Preview typography by style (right panel — no field labels, only live title/author) */
    #covPreviewShell { transition: box-shadow 0.35s ease; }
    #covPreviewShell.cov-style-minimal #covPreviewTitle { font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; font-size: clamp(1.1rem, 3.5vw, 1.65rem); }
    #covPreviewShell.cov-style-bold #covPreviewTitle { font-weight: 800; letter-spacing: -0.02em; font-size: clamp(1.35rem, 4vw, 2.25rem); }
    #covPreviewShell.cov-style-elegant #covPreviewTitle { font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-weight: 600; }
    #covPreviewShell.cov-style-modern #covPreviewTitle { font-family: ui-sans-serif, system-ui, sans-serif; font-weight: 700; letter-spacing: -0.03em; }
    #covPreviewShell.cov-style-vintage #covPreviewTitle { font-family: Georgia, 'Times New Roman', serif; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; font-size: clamp(1rem, 3vw, 1.5rem); }
    #covPreviewShell.cov-style-minimal #covPreviewAuthor { letter-spacing: 0.28em; text-transform: uppercase; font-size: 0.72rem; }
    #covPreviewShell.cov-style-bold #covPreviewAuthor { font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.8rem; }
    #covPreviewShell.cov-style-elegant #covPreviewAuthor { font-family: 'Playfair Display', Georgia, serif; font-style: italic; letter-spacing: 0.06em; text-transform: none; font-size: 0.95rem; }
    #covPreviewShell.cov-style-modern #covPreviewAuthor { font-family: ui-sans-serif, system-ui, sans-serif; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; font-size: 0.7rem; }
    #covPreviewShell.cov-style-vintage #covPreviewAuthor { font-family: Georgia, serif; letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.72rem; opacity: 0.95; }
    .cov-preview-book-stage {
        perspective: 1200px;
        padding: 0 0 1rem;
        transform-style: preserve-3d;
        width: 100%;
        max-width: min(100%, 22rem);
        margin-left: 0;
        margin-right: 0;
        align-self: flex-start;
    }
    /* Preview: no zoom wrapper — 3D tilt on the shell only */
    #covPreviewShell.cov-preview-3d {
        transform: rotateY(-4deg) rotateX(2deg);
        transform-style: preserve-3d;
        transition: transform 0.2s ease, box-shadow 0.35s ease;
        box-shadow:
            0 2px 4px rgba(15, 23, 42, 0.06),
            0 24px 48px -12px rgba(15, 23, 42, 0.35),
            0 0 0 1px rgba(255, 255, 255, 0.06) inset;
    }
    #covPreviewTitle.cov-line-empty, #covPreviewAuthor.cov-line-empty { opacity: 0; min-height: 0.1em; }
    /* Image-only preview: cover art from API, no title/author overlay */
    .cov-preview-typography { display: none !important; }
    #covPreviewColumn .cov-preview-book-stage,
    #covPreviewColumn #optionsWrap,
    #covPreviewColumn #sequentialCoverWrap {
        align-self: flex-start;
        width: 100%;
    }
</style>

<div class="bg-[#f5f7f9] min-h-full flex text-slate-900 flex-1">
    <main class="flex-1 overflow-y-auto overflow-x-hidden p-8 lg:p-12 w-full min-h-0">
        <div class="max-w-[1600px] mx-auto w-full flex flex-col min-h-0">
<div class="cover-design-page antialiased w-full flex justify-center items-start py-0 px-0 md:px-0">
    <!-- Loading -->
    <div id="screenLoading" class="bg-white rounded-[32px] shadow-sm border border-slate-200/60 w-full max-w-[1600px] min-h-[min(850px,calc(100vh-140px))] md:min-h-[850px] p-8 lg:p-12 flex flex-col gap-3 animate-pulse">
        <div class="h-8 bg-slate-200 rounded-xl w-1/3"></div>
        <div class="h-4 bg-slate-200 rounded w-full"></div>
        <div class="h-4 bg-slate-200 rounded w-5/6"></div>
    </div>

    <div id="emptyState" class="hidden bg-white rounded-[32px] shadow-sm border border-slate-200/60 w-full max-w-[1600px] min-h-[min(850px,calc(100vh-140px))] md:min-h-[850px] p-10 lg:p-12 flex flex-col items-center justify-center text-center text-slate-500">
        You do not have any books yet. Create a book first, then return here to design your cover.
    </div>

    <div id="coverMain" class="hidden bg-white rounded-[32px] shadow-sm w-full max-w-[1600px] min-h-[min(850px,calc(100vh-140px))] md:min-h-[850px] flex flex-col lg:flex-row gap-12 lg:gap-24 overflow-hidden border border-slate-200/60">
        <!-- Form (full width with dashboard sidebar only — no duplicate inner nav) -->
        <div class="w-full lg:w-5/12 p-6 md:p-10 lg:p-12 border-b lg:border-b-0 lg:border-r border-slate-100 flex flex-col bg-white shrink-0">
            <div class="flex items-center gap-2 mb-2">
                <i data-lucide="sparkles" class="w-5 h-5 text-violet-600" stroke-width="1.5"></i>
                <span class="text-xs font-semibold uppercase tracking-wide text-violet-600">Ebook AI</span>
            </div>
            <h1 class="font-serif text-2xl md:text-[1.65rem] text-slate-900 font-medium tracking-tight mb-2">AI Book Cover Creator</h1>
            <p class="text-sm text-slate-500 mb-6">Uses the same book as in AI Writer / Book Formatting. Adjust details, then generate.</p>
            <div class="h-px w-full bg-slate-100 mb-8"></div>

            <div class="flex flex-col gap-2 flex-1">
                <div class="hidden" data-guided-tour="cov-book" aria-hidden="true">
                    <select id="bookSelect" class="hidden" tabindex="-1" aria-hidden="true"></select>
                </div>
                <div class="flex flex-col gap-3" data-guided-tour="cov-fields">
                <div>
                    <label class="block text-sm text-slate-600 mb-2 font-medium">Book Title <span class="text-slate-400 font-normal">(from your book)</span></label>
                    <input type="text" id="bookTitle" readonly tabindex="-1" class="w-full border border-slate-200 rounded-[14px] px-4 py-3.5 text-base text-slate-800 bg-slate-50 cursor-default outline-none transition-all duration-200" title="Loaded from your book; edit in AI Writer" />
                </div>
                <div>
                    <label class="block text-sm text-slate-600 mb-2 font-medium">Author Name <span class="text-slate-400 font-normal">(from your account / book)</span></label>
                    <input type="text" id="authorName" readonly tabindex="-1" class="w-full border border-slate-200 rounded-[14px] px-4 py-3.5 text-base text-slate-800 bg-slate-50 cursor-default outline-none transition-all duration-200" title="Loaded from your profile or book" />
                </div>
                <div>
                    <label class="block text-sm text-slate-600 mb-2 font-medium">Book Category / Genre <span class="text-slate-400 font-normal">(from your book)</span></label>
                    <select id="bookCategory" disabled class="w-full border border-slate-200 rounded-[14px] px-4 py-3.5 text-base text-slate-800 outline-none bg-slate-50 cursor-default appearance-none opacity-100" style="background-image:url(\"data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='%2394a3b8'%3e%3cpath stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'/%3e%3c/svg%3e\");background-repeat:no-repeat;background-position:right 1rem center;background-size:1rem;padding-right:2.5rem;">
                        <option value="">Loading from your library…</option>
                    </select>
                </div>
                <input type="hidden" id="coverStyle" value="modern" autocomplete="off" />
                </div>
            </div>

            <div class="mt-0 pt-1" data-guided-tour="cov-prompt">
                <h2 class="font-serif text-xl text-slate-900 font-medium tracking-tight mb-1">Image Direction</h2>
                <p class="text-sm text-slate-500 mb-3 leading-snug">Mood, palette, main subject, and style references—the clearer you are, the stronger the cover.</p>
                <div class="cov-image-direction-shell border border-slate-200 rounded-[20px] p-1.5 flex flex-col focus-within:border-violet-500 focus-within:ring-2 focus-within:ring-violet-500/20 transition-all duration-200 bg-white">
                    <textarea id="imageDirection" rows="10" placeholder="Example: Warm twilight over a quiet city skyline, deep indigo and amber, lone figure in silhouette, cinematic depth—no text on the image, no cluttered collage…" class="cov-image-direction-textarea w-full px-4 py-4 text-base text-slate-800 outline-none resize-none bg-slate-50/40 focus:bg-white transition-colors"></textarea>
                    <div class="bg-slate-50 rounded-[14px] flex flex-wrap justify-end items-center p-2.5 mt-1 border border-slate-100/90 gap-2">
                        @* <button type="button" id="btnEditCover" class="cov-action-icon-btn cov-action-icon-btn--muted" title="Edit cover — apply Image Direction to current cover" aria-label="Edit cover">
                            <i data-lucide="pencil" class="w-5 h-5" stroke-width="2"></i>
                        </button>
                        <button type="button" id="btnRegenerate" class="cov-action-icon-btn cov-action-icon-btn--accent" title="Regenerate — new cover with current fields" aria-label="Regenerate cover">
                            <i data-lucide="refresh-cw" class="w-5 h-5" stroke-width="2"></i>
                        </button> *@
                        <button type="button" id="btnGenerate" class="inline-flex items-center gap-2 rounded-full bg-violet-600 text-white px-5 py-2.5 text-sm font-semibold shadow-md shadow-violet-500/30 hover:bg-violet-700 transition-colors">
                            <i data-lucide="wand-2" class="w-4 h-4" stroke-width="1.75"></i>
                            Generate Cover
                        </button>
                    </div>
                </div>
            </div>

            <a href="#" id="btnGoToPublish" class="mt-3 w-full rounded-[14px] bg-violet-700 text-white py-3.5 text-sm font-semibold shadow-lg shadow-violet-500/25 hover:bg-violet-800 transition-all flex items-center justify-center gap-2 no-underline" data-guided-tour="cov-publish" title="Open Publish with this same book">
                <i data-lucide="rocket" class="w-4 h-4" stroke-width="1.75"></i>
                Continue to Publish
            </a>
            <p class="mt-2 text-[11px] text-slate-400 text-center leading-snug">Uses the book loaded here (same as AI Writer / Formatting). You can finish cover later and return anytime.</p>
        </div>

        <!-- Preview: live book only — no form labels on the cover art -->
        <div id="covPreviewColumn" class="w-full lg:w-7/12 flex-1 min-h-0 p-6 md:p-10 lg:p-12 flex flex-col items-stretch bg-white">
            <div class="flex items-center gap-3 mb-2 shrink-0">
                <span class="w-5 h-0.5 bg-violet-500 rounded-full"></span>
                <span class="text-violet-600 font-medium text-sm tracking-wide">Ebook AI</span>
            </div>
            <h2 class="font-serif text-2xl md:text-3xl text-slate-900 font-medium tracking-tight mb-1 shrink-0">Cover preview</h2>
            <p class="text-sm text-slate-500 leading-relaxed max-w-lg mb-6 shrink-0">Cover preview shows only the AI-generated artwork — no title or author overlay.</p>

            <div class="cov-preview-book-stage">
                    <div id="covPreviewShell" class="cov-preview-3d w-full aspect-[2/3] rounded-[28px] overflow-hidden relative shadow-xl shadow-slate-900/12 transition-all duration-500 border border-slate-200 ring-1 ring-slate-900/5 cov-style-modern" data-guided-tour="cov-preview">
                        <img id="covPreviewBgImg" src="" alt="" class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500 pointer-events-none" />
                        <div id="covPreviewFallbackBg" class="cov-preview-fallback-purple absolute inset-0 transition-opacity duration-500"></div>
                        <div class="absolute inset-0 flex flex-col items-center justify-between pt-[12%] pb-[14%] px-5 sm:px-7 text-center z-10 cov-preview-typography">
                            <h3 id="covPreviewTitle" class="cov-preview-title font-sans text-2xl sm:text-3xl md:text-4xl text-white font-medium tracking-tight leading-snug transition-all duration-300 max-w-[min(100%,20rem)] md:max-w-[22rem] mx-auto" title=""></h3>
                            <p id="covPreviewAuthor" class="text-sm sm:text-base text-white/95 font-normal transition-all duration-300 max-w-[min(100%,18rem)] mx-auto leading-snug" title=""></p>
                        </div>
                        <div id="previewBusy" class="hidden absolute inset-0 z-20 bg-violet-950/55 flex flex-col items-center justify-center text-white gap-2">
                            <div class="w-10 h-10 border-2 border-violet-200 border-t-violet-400 rounded-full animate-spin"></div>
                            <span id="previewBusyText" class="text-sm font-medium">Generating…</span>
                        </div>
                    </div>
            </div>

            <div id="covPrintWrapModal" class="hidden fixed inset-0 z-[9999] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
                <div class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-auto p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-semibold text-slate-900">Complete print cover (Front + Spine + Back)</h3>
                        <button type="button" id="covPrintWrapClose" class="p-2 rounded-lg hover:bg-slate-100 text-slate-500" aria-label="Close"><i data-lucide="x" class="w-5 h-5"></i></button>
                    </div>
                    <img id="covPrintWrapImg" alt="Full wrap cover" class="w-full rounded-xl border border-slate-200 bg-slate-50" />
                    <p class="text-xs text-slate-500 mt-3">Spine width computed from your page count. Continue to Publish when ready.</p>
                </div>
            </div>

            <input type="hidden" id="coverGeneratedPayload" value="" />

            <div id="optionsWrap" class="mt-8 hidden w-full max-w-2xl">
                <h3 class="text-sm font-semibold text-slate-800 mb-3">Recent covers <span class="text-slate-400 font-normal">(tap to select)</span></h3>
                <div id="optionsGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
            </div>
            <div id="sequentialCoverWrap" class="mt-8 hidden w-full max-w-3xl rounded-2xl border border-slate-200 bg-slate-50/60 p-4">
                <h3 class="text-sm font-semibold text-slate-800 mb-3">Auto-generated print set (Back | Spine | Front)</h3>
                <div class="grid grid-cols-3 gap-3 items-end">
                    <img id="seqBackCover" alt="Back cover" class="w-full aspect-[2/3] rounded-xl border border-slate-200 object-cover bg-white" />
                    <img id="seqSpineCover" alt="Spine" class="w-full aspect-[1/3] rounded-xl border border-slate-200 object-cover bg-white" />
                    <img id="seqFrontCover" alt="Front cover" class="w-full aspect-[2/3] rounded-xl border border-slate-200 object-cover bg-white" />
                </div>
                <div class="mt-4">
                    <p class="text-xs font-semibold text-slate-600 mb-2 uppercase tracking-wide">Composited Full Wrap</p>
                    <img id="seqCompositeWrap" alt="Full wrap cover" class="w-full rounded-xl border border-slate-200 object-cover bg-white" />
                </div>
            </div>
        </div>
    </div>
</div>
        </div>
    </main>
</div>

<script src="~/js/cover-download-modal.js" asp-append-version="true"></script>
<script src="~/js/cover-kdp-export.js" asp-append-version="true"></script>
<script>
(function () {
    'use strict';

    var initialBookId = @(initialBookId);
    var coverFlowPrintReady = false;
    try {
        coverFlowPrintReady = (new URLSearchParams(window.location.search).get('flow') || '').toLowerCase() === 'printready';
    } catch (e) { coverFlowPrintReady = false; }
    var books = [];
    var selectedBook = null;
    /** Current selection: relative path, http(s) URL, or data:image URL */
    var selectedPath = '';
    var selectedOptionEl = null;
    var booksCacheKey = 'cover_design_books_cache_v1';
    var FORMATTER_BOOK_KEY = typeof window.EBOOK_FORMATTER_BOOK_KEY === 'string' ? window.EBOOK_FORMATTER_BOOK_KEY : 'ebook_formatter_book_id';
    /** Last 3 generated / edited cover URLs for quick recall */
    var coverHistory = [];
    var MAX_HISTORY = 3;
    var hasAiCoverThisSession = false;
    var bookPublishingPlatform = '';

    function isPrintReadyPlatform() {
        var p = (bookPublishingPlatform || '').toLowerCase();
        return p.indexOf('print ready') >= 0 || p.indexOf('just print ready') >= 0;
    }

    function isKdpOrEbookPlatform() {
        var p = (bookPublishingPlatform || '').toLowerCase();
        if (isPrintReadyPlatform()) return false;
        return p.indexOf('kdp') >= 0 || p.indexOf('amazon') >= 0 || p.indexOf('ebook') >= 0 || p.indexOf('ingram') >= 0 || p.indexOf('barnes') >= 0 || !p;
    }

    var screenLoading = document.getElementById('screenLoading');
    var emptyState = document.getElementById('emptyState');
    var coverMain = document.getElementById('coverMain');
    var bookSelect = document.getElementById('bookSelect');
    var bookTitle = document.getElementById('bookTitle');
    var authorName = document.getElementById('authorName');
    var bookCategory = document.getElementById('bookCategory');
    var coverStyle = document.getElementById('coverStyle');
    var imageDirection = document.getElementById('imageDirection');
    var btnGenerate = document.getElementById('btnGenerate');
    var btnRegenerate = document.getElementById('btnRegenerate');
    var btnEditCover = document.getElementById('btnEditCover');
    var covPreviewTitle = document.getElementById('covPreviewTitle');
    var covPreviewAuthor = document.getElementById('covPreviewAuthor');
    var covPreviewBgImg = document.getElementById('covPreviewBgImg');
    var covPreviewFallbackBg = document.getElementById('covPreviewFallbackBg');
    var previewBusy = document.getElementById('previewBusy');
    var previewBusyText = document.getElementById('previewBusyText');
    var optionsWrap = document.getElementById('optionsWrap');
    var optionsGrid = document.getElementById('optionsGrid');
    var coverGeneratedPayload = document.getElementById('coverGeneratedPayload');
    var btnGoToPublish = document.getElementById('btnGoToPublish');
    var covPreviewShell = document.getElementById('covPreviewShell');
    var sequentialCoverWrap = document.getElementById('sequentialCoverWrap');
    if (sequentialCoverWrap) sequentialCoverWrap.classList.add('hidden');
    var seqBackCover = document.getElementById('seqBackCover');
    var seqSpineCover = document.getElementById('seqSpineCover');
    var seqFrontCover = document.getElementById('seqFrontCover');
    var seqCompositeWrap = document.getElementById('seqCompositeWrap');
    var sequentialAssets = { front: '', spine: '', back: '', wrap: '' };

    function toast(icon, text) {
        if (typeof Swal !== 'undefined') Swal.fire({ icon: icon, text: text, timer: 2600, showConfirmButton: false });
        else alert(text);
    }

    function toUrl(path) {
        if (!path) return '';
        if (path.indexOf('http') === 0 || path.indexOf('data:') === 0) return path;
        return path.indexOf('/') === 0 ? path : '/' + path;
    }

    function refreshLucide() {
        if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();
    }

    function loadImage(src) {
        return new Promise(function (resolve, reject) {
            var img = new Image();
            img.onload = function () { resolve(img); };
            img.onerror = function () { reject(new Error('Failed to load image.')); };
            img.src = src;
        });
    }

    /**
     * KDP default spine formula (white paper) for trim 6x9.
     * Reference: https://kdp.amazon.com/cover-calculator
     */
    function computeSpineWidthPx(pageCount, dpi) {
        var pages = Math.max(24, parseInt(pageCount, 10) || 120);
        var thicknessInches = pages * 0.002252;
        return Math.max(0.055, thicknessInches) * (dpi || 300);
    }

    function buildSpineDataUrl(title, pageCount) {
        var h = 1200;
        var w = Math.max(48, Math.round(computeSpineWidthPx(pageCount, 300) * 0.2));
        var c = document.createElement('canvas');
        c.width = w;
        c.height = h;
        var ctx = c.getContext('2d');
        var g = ctx.createLinearGradient(0, 0, w, 0);
        g.addColorStop(0, '#312e81');
        g.addColorStop(1, '#1e1b4b');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, w, h);
        ctx.save();
        ctx.translate(w / 2, h / 2);
        ctx.rotate(-Math.PI / 2);
        ctx.fillStyle = '#f8fafc';
        ctx.font = '700 34px Inter, system-ui, sans-serif';
        var t = (title || 'Untitled').toUpperCase();
        if (t.length > 40) t = t.slice(0, 37) + '…';
        var tw = ctx.measureText(t).width;
        ctx.fillText(t, -tw / 2, 10);
        ctx.restore();
        return c.toDataURL('image/png');
    }

    function buildBackCoverDataUrl(title, author) {
        var w = 900;
        var h = 1350;
        var c = document.createElement('canvas');
        c.width = w;
        c.height = h;
        var ctx = c.getContext('2d');
        var g = ctx.createLinearGradient(0, 0, w, h);
        g.addColorStop(0, '#1e1b4b');
        g.addColorStop(1, '#312e81');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, w, h);
        ctx.fillStyle = 'rgba(255,255,255,0.08)';
        ctx.beginPath();
        ctx.arc(w * 0.84, h * 0.22, w * 0.35, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#f8fafc';
        ctx.font = '700 42px Inter, system-ui, sans-serif';
        var safeTitle = String(title || 'Untitled');
        if (safeTitle.length > 36) safeTitle = safeTitle.slice(0, 33) + '…';
        ctx.fillText(safeTitle, 64, 120);
        ctx.fillStyle = '#c4b5fd';
        ctx.font = '500 28px Inter, system-ui, sans-serif';
        ctx.fillText(String(author || ''), 64, 172);
        ctx.fillStyle = '#e2e8f0';
        ctx.font = '400 26px Georgia, serif';
        var blurb = 'A compelling story crafted and prepared for publication with AI-assisted tools.';
        var words = blurb.split(' ');
        var line = '';
        var y = 260;
        words.forEach(function (word) {
            var test = line ? line + ' ' + word : word;
            if (ctx.measureText(test).width > w - 128 && line) {
                ctx.fillText(line, 64, y);
                line = word;
                y += 42;
            } else {
                line = test;
            }
        });
        if (line) ctx.fillText(line, 64, y);
        return c.toDataURL('image/png');
    }

    async function composeSequentialWrap(frontUrl, spineUrl, backUrl) {
        var front = await loadImage(frontUrl);
        var spine = await loadImage(spineUrl);
        var back = await loadImage(backUrl);
        var h = Math.max(front.height, back.height, spine.height);
        var fw = Math.round((front.width / front.height) * h);
        var bw = Math.round((back.width / back.height) * h);
        var sw = Math.max(24, Math.round((spine.width / spine.height) * h));
        var c = document.createElement('canvas');
        c.width = bw + sw + fw;
        c.height = h;
        var ctx = c.getContext('2d');
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(0, 0, c.width, c.height);
        ctx.drawImage(back, 0, 0, bw, h);
        ctx.drawImage(spine, bw, 0, sw, h);
        ctx.drawImage(front, bw + sw, 0, fw, h);
        return c.toDataURL('image/png');
    }

    function renderSequentialAssets() {
        if (!sequentialCoverWrap || !seqFrontCover || !seqSpineCover || !seqBackCover || !seqCompositeWrap) return;
        if (!sequentialAssets.front || !sequentialAssets.spine || !sequentialAssets.back || !sequentialAssets.wrap) {
            sequentialCoverWrap.classList.add('hidden');
            return;
        }
        sequentialCoverWrap.classList.remove('hidden');
        seqFrontCover.src = sequentialAssets.front;
        seqSpineCover.src = sequentialAssets.spine;
        seqBackCover.src = sequentialAssets.back;
        seqCompositeWrap.src = sequentialAssets.wrap;
    }

    async function buildSequentialCoverSet(frontSource, meta) {
        var front = toUrl(frontSource || '');
        if (!front) throw new Error('Front cover is missing.');
        var pageCount = (selectedBook && (selectedBook.pageCount || selectedBook.totalPages || selectedBook.pages)) || 120;
        var spine = buildSpineDataUrl(meta.title, pageCount);
        var back = buildBackCoverDataUrl(meta.title, meta.author);
        var wrap = await composeSequentialWrap(front, spine, back);
        sequentialAssets = { front: front, spine: spine, back: back, wrap: wrap };
        window.__coverDesignSequentialAssets = sequentialAssets;
        renderSequentialAssets();
    }

