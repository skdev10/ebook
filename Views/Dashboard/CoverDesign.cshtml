    (function bindCovWrapViewTabs() {
        var tabs = document.getElementById('covWrapViewTabs');
        if (!tabs) return;
        tabs.addEventListener('click', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('.cov-wrap-view-tab') : null;
            if (!b) return;
            setCovWrapView(b.getAttribute('data-wrap-view'));
        });
    })();

    function pollPrintWrapUntilReady(maxMs, intervalMs) {
        maxMs = maxMs || 900000;
        intervalMs = intervalMs || 3000;
        var started = Date.now();
        return new Promise(function (resolve, reject) {
            function tick() {
                if (!selectedBook || !selectedBook.bookId) {
                    reject(new Error('No book loaded.'));
                    return;
                }
                fetch('/Dashboard/GetPrintReadyCoverAssets?bookId=' + encodeURIComponent(selectedBook.bookId), {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                }).then(function (r) { return r.json(); }).then(function (d) {
                    var wrap = d && d.cover ? (d.cover.wrap || '').trim() : '';
                    var st = d && d.wrapCoverStatus ? String(d.wrapCoverStatus) : '';
                    if (wrap && (d.wrapMatchesFront !== false || String(d.wrapCoverStatus || '') === 'Ready')) return resolve(d);
                    if (st === 'Failed' || st === 'MissingFront')
                        return reject(new Error(d.message || 'Full wrap generation failed.'));
                    if (Date.now() - started > maxMs)
                        return reject(new Error('Full wrap is still building. Please wait and refresh.'));
                    setTimeout(tick, intervalMs);
                }).catch(reject);
            }
            tick();
        });
    }

    function buildPrintWrapNow(forceRebuild) {
        if (!selectedBook || !selectedBook.bookId || !needsPrintWrapAutoBuild()) return Promise.resolve(null);
        if (!hasSavedFrontForWrap()) {
            resetPrintWrapPreviewUi();
            return Promise.resolve(null);
        }
        if (covWrapBuildInFlight && covWrapBuildPromise) return covWrapBuildPromise;

        updateCovWrapBuildBanner({ wrapCoverStatus: 'Generating' });
        showCovFullWrapSection(true);
        var placeholder = document.getElementById('covFullWrapPlaceholder');
        var building = document.getElementById('covFullWrapBuilding');
        var tabs = document.getElementById('covWrapViewTabs');
        if (placeholder) { placeholder.classList.add('hidden'); }
        if (building) building.classList.remove('hidden');
        if (tabs) tabs.classList.remove('hidden');

        covWrapBuildInFlight = true;
        updatePublishGate();
        covWrapBuildPromise = Promise.resolve(persistBackCoverSummary()).then(function () {
            return resolveWrapPageCount();
        }).then(function (pageCount) {
            // wait:true — local ImageSharp wrap finishes in seconds. wait:false used to
            // queue background AI fallbacks that hung for 15+ minutes on "Generating".
            return fetch('/Dashboard/GeneratePrintReadyWrapFromFront', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({
                    bookId: selectedBook.bookId,
                    pageCount: pageCount > 0 ? pageCount : null,
                    force: !!forceRebuild,
                    wait: true,
                    title: (bookTitle.value || '').trim() || selectedBook.title || 'My Book',
                    author: (authorName.value || '').trim() || (selectedBook.authorName || ''),
                    genre: (bookCategory.value || '').trim()
                })
            });
        }).then(function (r) {
            if (!r.ok) {
                return r.text().then(function (t) {
                    var msg = 'Full wrap generation failed.';
                    try {
                        var j = JSON.parse(t);
                        if (j && j.message) msg = j.message;
                    } catch (_) {
                        if (t && t.length < 240 && t.indexOf('<') < 0) msg = t;
                    }
                    throw new Error(msg);
                });
            }
            return r.json();
        }).then(function (d) {
            if (d && d.status === 'processing') return pollPrintWrapUntilReady(90000, 2000);
            return d;
        })
        .then(function (d) {
                if (d && d.success && d.cover) {
                var wrap = (d.cover.wrap || '').trim();
                if (wrap) {
                    showCovFullWrapPreview(wrap, d.pageCount || 0);
                    coverWraparoundRef = wrap;
                    setPrintWrapSaved(true);
                }
                var newFront = (d.cover.front || '').trim();
                if (newFront) {
                    var frontUrl = toUrl(newFront);
                    setCoverImageVisible(frontUrl + (frontUrl.indexOf('?') >= 0 ? '&' : '?') + '_t=' + Date.now());
                }
                updateCovWrapBuildBanner(d);
                if (!wrap) {
                    // success but empty wrap — try assets endpoint once more
                    return fetch('/Dashboard/GetPrintReadyCoverAssets?bookId=' + encodeURIComponent(selectedBook.bookId), {
                        credentials: 'same-origin', headers: { 'Accept': 'application/json' }
                    }).then(function (r) { return r.json(); }).then(function (assets) {
                        var w = assets && assets.cover ? (assets.cover.wrap || '').trim() : '';
                        if (w) {
                            showCovFullWrapPreview(w, assets.pageCount || 0);
                            coverWraparoundRef = w;
                            setPrintWrapSaved(true);
                            updateCovWrapBuildBanner(assets);
                        } else {
                            updateCovWrapBuildBanner({ wrapCoverStatus: 'Failed' });
                        }
                        return assets || d;
                    }).catch(function () { return d; });
                }
            } else {
                // Hard fail from server — still try to recover an existing wrap asset.
                return fetch('/Dashboard/GetPrintReadyCoverAssets?bookId=' + encodeURIComponent(selectedBook.bookId), {
                    credentials: 'same-origin', headers: { 'Accept': 'application/json' }
                }).then(function (r) { return r.json(); }).then(function (assets) {
                    var w = assets && assets.cover ? (assets.cover.wrap || '').trim() : '';
                    if (w) {
                        showCovFullWrapPreview(w, assets.pageCount || 0);
                        coverWraparoundRef = w;
                        setPrintWrapSaved(true);
                        updateCovWrapBuildBanner(assets);
                        toast('success', 'Full wrap recovered and ready.');
                        return assets;
                    }
                    updateCovWrapBuildBanner({ wrapCoverStatus: 'Failed' });
                    if (d && d.message) toast('error', d.message);
                    return d;
                }).catch(function () {
                    updateCovWrapBuildBanner({ wrapCoverStatus: 'Failed' });
                    return d;
                });
            }
            return d;
        })
        .catch(function (err) {
            updateCovWrapBuildBanner({ wrapCoverStatus: 'Failed' });
            if (err && err.message) toast('error', err.message);
            return null;
        })
        .finally(function () {
            covWrapBuildInFlight = false;
            covWrapBuildPromise = null;
            var building = document.getElementById('covFullWrapBuilding');
            if (building) building.classList.add('hidden');
            updatePublishGate();
        });

        return covWrapBuildPromise;
    }

    function queuePrintWrapInBackground() {
        return buildPrintWrapNow(false);
    }

    function showCovFullWrapSection(show) {
        var section = document.getElementById('covFullWrapSection');
        if (section) section.classList.toggle('hidden', !show || !needsPrintWrapAutoBuild());
    }

    function showCovFullWrapPreview(wrapUrl, pageCount) {
        wrapUrl = (wrapUrl || '').trim();
        if (!wrapUrl) return;
        showCovFullWrapSection(true);
        var img = document.getElementById('covFullWrapImg');
        var frame = document.getElementById('covFullWrapFrame');
        var placeholder = document.getElementById('covFullWrapPlaceholder');
        var building = document.getElementById('covFullWrapBuilding');
        var tabs = document.getElementById('covWrapViewTabs');
        var hint = document.getElementById('covWrapPageHint');
        if (building) building.classList.add('hidden');
        if (tabs) tabs.classList.remove('hidden');
        if (hint && pageCount) hint.textContent = pageCount + ' pages · Back · Spine · Front (KDP print wrap)';
        if (img) {
            var src = toUrl(wrapUrl);
            if (!src) {
                img.src = '';
                img.classList.add('hidden');
                if (frame) frame.classList.add('hidden');
                if (placeholder) {
                    var phText = document.getElementById('covFullWrapPlaceholderText');
                    if (phText) phText.textContent = 'Full wrap path was empty. Click Retry wrap below.';
                    placeholder.classList.remove('hidden');
                }
                setPrintWrapSaved(false);
                return;
            }
            src = src + (src.indexOf('?') >= 0 ? '&' : '?') + '_t=' + Date.now();
            img.onload = function () {
                img.classList.remove('hidden');
                if (frame) frame.classList.remove('hidden');
                if (placeholder) placeholder.classList.add('hidden');
                setPrintWrapSaved(true);
            };
            img.onerror = function () {
                img.classList.add('hidden');
                img.removeAttribute('src');
                if (frame) frame.classList.add('hidden');
                if (placeholder) {
                    var phErr = document.getElementById('covFullWrapPlaceholderText');
                    if (phErr) phErr.textContent = 'Could not load wrap image. Click Retry wrap.';
                    placeholder.classList.remove('hidden');
                }
                coverWraparoundRef = '';
                setPrintWrapSaved(false);
                updateCovWrapBuildBanner({ wrapCoverStatus: 'Failed' });
            };
            img.src = src;
            img.classList.remove('hidden');
            if (frame) frame.classList.remove('hidden');
            if (placeholder) placeholder.classList.add('hidden');
        } else {
            setPrintWrapSaved(true);
        }
        coverWraparoundRef = wrapUrl;
        setCovWrapView('full');
    }

    function updateCovWrapBuildBanner(data) {
        var banner = document.getElementById('covWrapBuildBanner');
        var text = document.getElementById('covWrapBuildBannerText');
        var spinner = banner ? banner.querySelector('.cov-wrap-build-spinner') : null;
        var retryBtn = document.getElementById('btnRetryPrintWrap');
        if (!banner || !needsPrintWrapAutoBuild()) return;
        var wrap = data && data.cover ? (String(data.cover.wrap || '').trim()) : (coverWraparoundRef || '').trim();
        var status = data && data.wrapCoverStatus ? String(data.wrapCoverStatus) : '';
        var wrapMatches = data && data.wrapMatchesFront !== false;
        var hasFront = hasSavedFrontForWrap();
        if (retryBtn) retryBtn.classList.add('hidden');
        if (wrap && (wrapMatches || status === 'Ready' || status === '')) {
            banner.classList.add('hidden');
            showCovFullWrapPreview(wrap, data && data.pageCount ? data.pageCount : 0);
            return;
        }
        if (status === 'Stale' && !wrap) {
            banner.classList.add('hidden');
            resetPrintWrapPreviewUi();
            return;
        }
        // Stale with a wrap URL still present: keep showing it while rebuild runs.
        if (status === 'Stale' && wrap) {
            showCovFullWrapPreview(wrap, data && data.pageCount ? data.pageCount : 0);
        }
        if (!hasFront && status !== 'Failed' && status !== 'MissingFront') {
            banner.classList.add('hidden');
            return;
        }
        banner.classList.remove('hidden');
        banner.classList.remove('border-amber-200', 'bg-amber-50', 'text-amber-900');
        banner.classList.add('border-violet-200', 'bg-violet-50', 'text-violet-900');
        if (spinner) spinner.classList.remove('hidden');
        if (status === 'Failed' || status === 'MissingFront' || status === 'Missing') {
            banner.classList.remove('border-violet-200', 'bg-violet-50', 'text-violet-900');
            banner.classList.add('border-amber-200', 'bg-amber-50', 'text-amber-900');
            if (spinner) spinner.classList.add('hidden');
            if (retryBtn) retryBtn.classList.remove('hidden');
            if (text) {
                text.textContent = status === 'MissingFront' || status === 'Missing'
                    ? 'Front cover not saved yet. Regenerate cover, then Retry wrap.'
                    : 'Full wrap build failed. Click Retry wrap — usually finishes in a few seconds.';
            }
            return;
        }
        if (text) text.textContent = 'Building full print wrap from your front cover (usually a few seconds)…';
    }

    (function bindRetryPrintWrap() {
        var retryBtn = document.getElementById('btnRetryPrintWrap');
        if (!retryBtn) return;
        retryBtn.addEventListener('click', function () {
            if (covWrapBuildInFlight) return;
            // force:false first — recover existing wrap / rebuild without clearing Settings.
            // Only force-clear if that returns empty.
            buildPrintWrapNow(false).then(function (d) {
                var wrap = d && d.cover ? (d.cover.wrap || '').trim() : '';
                if (wrap) return d;
                return buildPrintWrapNow(true);
            });
        });
    })();

    function startCovWrapStatusPolling() {
        /* Sync wrap build replaces slow background polling. */
    }

    async function resolveWrapPageCount() {
        var pageCount = (selectedBook && (selectedBook.pageCount || selectedBook.estimatedPages || selectedBook.totalPages)) || 0;
        if (!pageCount && selectedBook && selectedBook.bookId) {
            try {
                var metricsResp = await fetch('/Dashboard/BookPageMetrics?bookId=' + encodeURIComponent(selectedBook.bookId));
                var metricsData = await metricsResp.json();
                if (metricsData && metricsData.success && metricsData.pageCount > 0) {
                    pageCount = metricsData.pageCount;
                    selectedBook.pageCount = pageCount;
                }
            } catch (_) {}
        }
        if (pageCount < 24) pageCount = 24;
        return pageCount;
    }

