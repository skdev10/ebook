    /** Merge latest DB + Settings for one book; keeps form author if API has no display name. */
    function refreshBookFromServer(bookId) {
        var id = parseInt(bookId, 10);
        if (!id) return Promise.resolve();
        return fetch('/Books/GetBookForCoverDesign?bookId=' + encodeURIComponent(id))
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success || !d.book) return;
                var b = d.book;
                var ix = books.findIndex(function (x) { return x.bookId === b.bookId; });
                if (ix >= 0) books[ix] = Object.assign({}, books[ix], b);
                if (!selectedBook || selectedBook.bookId !== b.bookId) return;
                selectedBook = Object.assign({}, selectedBook, b);
                bookTitle.value = (b.title != null) ? b.title : bookTitle.value;
                if (bookSubtitle && b.subtitle != null) bookSubtitle.value = b.subtitle || '';
                var srvAuthor = (b.authorName || '').trim();
                if (srvAuthor) authorName.value = srvAuthor;
                setGenreFromApi((b.genre || '').trim());
                var dir = (b.aiCoverPrompt || '').trim();
                if (dir) imageDirection.value = dir;
                loadCoverProjects(b.bookId);
                fetch('/BookDesign/GetBookFormatting?bookId=' + encodeURIComponent(b.bookId))
                    .then(function (r) { return r.json(); })
                    .then(function (fd) {
                        if (fd && fd.success && fd.data) {
                            bookPublishingPlatform = (fd.data.publishingPlatform || fd.data.publishingPlatforms || '').trim();
                            var fmt = (fd.data.format || '').trim();
                            if (fmt === 'Print') fmt = 'Paperback';
                            applyPublishFormat(fmt || 'Paperback', { persist: false });
                            /* Full wrap builds only after front cover generate — not on page load. */
                        }
                    })
                    .catch(function () {});
                var path = (b.aiCoverLastPreview || b.coverImagePath || '').trim();
                if (!path) path = readPersistedCoverUrl(b.bookId);
                if (path) {
                    coverHistory = [];
                    applyBestFrontPreview(path).catch(function () {
                        selectedPath = path;
                        setCoverImageVisible(toUrl(path));
                    });
                    pushCoverHistory(path);
                }
                applyCoverStyleClass();
                syncCoverStyleCards();
                updateLivePreview();
                fetch('/Dashboard/BookPageMetrics?bookId=' + encodeURIComponent(b.bookId))
                    .then(function (r) { return r.json(); })
                    .then(function (m) {
                        if (m && m.success && m.pageCount > 0) {
                            if (selectedBook && selectedBook.bookId === b.bookId) {
                                selectedBook.pageCount = m.pageCount;
                                selectedBook.estimatedPages = m.pageCount;
                            }
                            if (ix >= 0) {
                                books[ix].pageCount = m.pageCount;
                                books[ix].estimatedPages = m.pageCount;
                            }
                        }
                    })
                    .catch(function () {});
            })
            .catch(function () { /* offline / error: keep cached form */ });
    }

    /* ===== Reference image: the AI matches its palette + mood ===== */
    var covRefStyleNote = '';

    /** Image Direction text + (when a reference image is uploaded) an AI style-match note. */
    function covComposeDescription() {
        var d = (imageDirection && imageDirection.value || '').trim();
        if (covRefStyleNote) d = d ? (d + '\n\n' + covRefStyleNote) : covRefStyleNote;
        return d;
    }

    (function initCoverReferenceImage() {
        var input = document.getElementById('covRefImageInput');
        var pickBtn = document.getElementById('covRefPickBtn');
        var block = document.getElementById('covRefImageBlock');
        var emptyEl = document.getElementById('covRefEmpty');
        var previewEl = document.getElementById('covRefPreview');
        var thumbEl = document.getElementById('covRefThumb');
        var summaryEl = document.getElementById('covRefSummary');
        var swatchesEl = document.getElementById('covRefSwatches');
        var removeBtn = document.getElementById('covRefRemoveBtn');
        if (!input || !pickBtn || !previewEl) return;

        function toHex(v) { var h = Math.max(0, Math.min(255, Math.round(v))).toString(16); return h.length === 1 ? '0' + h : h; }

        /** Dominant palette + tone via a small canvas sample. */
        function analyzeImage(img) {
            var w = 48, h = 64;
            var canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            var ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, w, h);
            var data = ctx.getImageData(0, 0, w, h).data;
            var buckets = {};
            var lumSum = 0, satSum = 0, n = 0;
            for (var i = 0; i < data.length; i += 4) {
                var r = data[i], g = data[i + 1], b = data[i + 2];
                if (data[i + 3] < 128) continue;
                n++;
                lumSum += 0.2126 * r + 0.7152 * g + 0.0722 * b;
                var mx = Math.max(r, g, b), mn = Math.min(r, g, b);
                satSum += mx === 0 ? 0 : (mx - mn) / mx;
                var key = (r >> 5) + ',' + (g >> 5) + ',' + (b >> 5);
                if (!buckets[key]) buckets[key] = { r: 0, g: 0, b: 0, count: 0 };
                buckets[key].r += r; buckets[key].g += g; buckets[key].b += b; buckets[key].count++;
            }
            if (!n) return null;
            var top = Object.keys(buckets)
                .map(function (k) { return buckets[k]; })
                .sort(function (a, b2) { return b2.count - a.count; })
                .slice(0, 3)
                .map(function (bk) { return '#' + toHex(bk.r / bk.count) + toHex(bk.g / bk.count) + toHex(bk.b / bk.count); });
            var avgLum = lumSum / n, avgSat = satSum / n;
            var tone = avgLum > 170 ? 'bright, light and airy' : (avgLum < 85 ? 'dark, moody and dramatic' : 'balanced mid-tone');
            var sat = avgSat > 0.45 ? 'vivid, saturated colours' : (avgSat < 0.18 ? 'muted, desaturated colours' : 'softly saturated colours');
            return { colors: top, tone: tone, sat: sat };
        }

        function applyAnalysis(a) {
            covRefStyleNote =
                'STYLE REFERENCE (from the user\'s uploaded reference cover): design this cover in the same visual style — ' +
                'dominant colours ' + a.colors.join(', ') + '; ' + a.tone + ' overall with ' + a.sat + '. ' +
                'Match the reference\'s mood, palette and composition, but create an original cover for THIS book — do not copy the reference.';
            if (summaryEl) summaryEl.textContent = 'Palette ' + a.colors.join(' · ') + ' — ' + a.tone + ', ' + a.sat + '.';
            if (swatchesEl) {
                swatchesEl.innerHTML = '';
                a.colors.forEach(function (c) {
                    var s = document.createElement('span');
                    s.className = 'cov-ref-swatch';
                    s.style.background = c;
                    s.title = c;
                    swatchesEl.appendChild(s);
                });
            }
            updateGenerateGate();
        }

        function clearReference() {
            covRefStyleNote = '';
            input.value = '';
            if (thumbEl) thumbEl.src = '';
            if (previewEl) previewEl.classList.add('hidden');
            if (emptyEl) emptyEl.classList.remove('hidden');
            if (block) block.classList.remove('has-image');
            updateGenerateGate();
        }

        pickBtn.addEventListener('click', function () { input.click(); });
        if (removeBtn) removeBtn.addEventListener('click', clearReference);

        input.addEventListener('change', function () {
            var file = input.files && input.files[0];
            if (!file) return;
            if (file.size > 12 * 1024 * 1024) {
                toast('error', 'Reference image is too large (max 12 MB).');
                input.value = '';
                return;
            }
            var reader = new FileReader();
            reader.onload = function () {
                var img = new Image();
                img.onload = function () {
                    var a = null;
                    try { a = analyzeImage(img); } catch (e) { console.warn('[CoverDesign] reference analysis failed', e); }
                    if (!a) {
                        toast('error', 'Could not read that image. Try a PNG or JPG.');
                        clearReference();
                        return;
                    }
                    applyAnalysis(a);
                    if (thumbEl) thumbEl.src = String(reader.result);
                    if (emptyEl) emptyEl.classList.add('hidden');
                    if (previewEl) previewEl.classList.remove('hidden');
                    if (block) block.classList.add('has-image');
                    toast('success', 'Reference understood — the AI will match its colours and mood.');
                };
                img.onerror = function () { toast('error', 'Could not read that image. Try a PNG or JPG.'); clearReference(); };
                img.src = String(reader.result);
            };
            reader.readAsDataURL(file);
        });
    })();

    /** Structured prompt for logging / future models (also sent as Description separately). */
    function buildStructuredPrompt() {
        var title = (bookTitle.value || '').trim() || (selectedBook && selectedBook.title) || 'My Book';
        var author = (authorName.value || '').trim() || (selectedBook && selectedBook.authorName) || '';
        var genre = (bookCategory.value || '').trim();
        var style = (coverStyle.value || '').trim() || 'modern';
        var description = covComposeDescription();
        return (
            'Book Title: ' + title + '\n' +
            'Author: ' + author + '\n' +
            'Genre: ' + genre + '\n' +
            'Cover Style: ' + style + '\n' +
            'Description: ' + description
        );
    }

    /** Wraparound from /api/generate-spine-book-cover — never slice/recompose on the client. */
    var coverWraparoundRef = '';

    var printWrapSaved = false;
    var printWrapAssets = { front: '', spine: '', back: '', wrap: '' };
    var lastKdpLayout = null;

    function setImgSrcOrHide(imgEl, url) {
        if (!imgEl) return;
        if (url) {
            imgEl.src = toUrl(url);
            imgEl.classList.remove('hidden');
        } else {
            imgEl.src = '';
            imgEl.classList.add('hidden');
        }
    }

    function setPrintWrapSaved(saved) {
        printWrapSaved = !!saved;
        var badge = document.getElementById('covWrapSavedBadge');
        if (badge) badge.classList.toggle('hidden', !printWrapSaved);
        updatePublishGate();
    }

    function isLikelyWrapCoverPath(path) {
        var p = String(path || '').toLowerCase();
        return p.indexOf('printreadycoverwrap') >= 0
            || p.indexOf('coverwrap') >= 0
            || p.indexOf('spine-book-cover') >= 0
            || p.indexOf('generate-spine-book-cover') >= 0;
    }

    async function createFrontPanelDataUrlFromWrap(pathOrUrl) {
        var src = toUrl(pathOrUrl);
        if (!src) return '';
        var img = await loadImage(src);
        if (!img || !img.naturalWidth || !img.naturalHeight) return src;
        var ratio = img.naturalWidth / img.naturalHeight;
        if (ratio < 1.2) return src;
        var panelWidth = Math.max(24, Math.round(img.naturalWidth * 0.48));
        var sx = Math.max(0, img.naturalWidth - panelWidth);
        var canvas = document.createElement('canvas');
        canvas.width = panelWidth;
        canvas.height = img.naturalHeight;
        var ctx = canvas.getContext('2d');
        if (!ctx) return src;
        ctx.drawImage(img, sx, 0, panelWidth, img.naturalHeight, 0, 0, panelWidth, img.naturalHeight);
        return canvas.toDataURL('image/png');
    }

    async function applyBestFrontPreview(path) {
        if (!path) return '';
        var resolved = toUrl(path);
        if (!resolved) return '';
        try {
            if (isLikelyWrapCoverPath(path)) {
                resolved = await createFrontPanelDataUrlFromWrap(path);
            } else {
                var probe = await loadImage(resolved);
                if (probe && probe.naturalWidth > 0 && probe.naturalHeight > 0) {
                    var ratio = probe.naturalWidth / probe.naturalHeight;
                    if (ratio >= 1.2) resolved = await createFrontPanelDataUrlFromWrap(resolved);
                }
            }
        } catch (_) {
            resolved = toUrl(path);
        }
        selectedPath = resolved;
        setCoverImageVisible(resolved);
        if (selectedBook && selectedBook.bookId) persistCoverSelection(selectedBook.bookId, selectedPath);
        return resolved;
    }

    function applyFrontOnlyPreview(frontUrl) {
        if (!frontUrl) return;
        applyBestFrontPreview(frontUrl).catch(function () {});
    }

    function showPrintWrapModal(assets, saved, layoutOrServer, openModal) {
        assets = assets || {};
        var wrap = assets.wrap || coverWraparoundRef || '';
        var pageCount = assets.pageCount || (layoutOrServer && layoutOrServer.pageCount) || 0;

        printWrapAssets = {
            front: assets.front || selectedPath || '',
            back: assets.back || '',
            wrap: wrap,
            pageCount: pageCount
        };
        if (wrap) coverWraparoundRef = wrap;

        setImgSrcOrHide(document.getElementById('covPrintFrontImg'), printWrapAssets.front);
        setImgSrcOrHide(document.getElementById('covPrintBackImg'), printWrapAssets.back);

        var debugEl = document.getElementById('covWrapKdpDebug');
        if (debugEl) {
            debugEl.textContent = pageCount
                ? 'pages=' + pageCount + ' | wraparound stored — download print-ready from Publish'
                : 'wraparound stored — download print-ready from Publish';
        }

        setPrintWrapSaved(saved);
        if (openModal !== false) {
            var modal = document.getElementById('covPrintWrapModal');
            if (modal) modal.classList.remove('hidden');
        }
        refreshLucide();
    }

    function loadSavedPrintWrapAssets(bookId) {
        if (!bookId) return Promise.resolve();
        return fetch('/Dashboard/GetPrintReadyCoverAssets?bookId=' + encodeURIComponent(bookId))
            .then(function (r) { return r.text(); })
            .then(function (text) {
                var d = {};
                try { d = text ? JSON.parse(text) : {}; } catch (e) { return; }
                if (!d || !d.success || !d.cover) return;
                var c = d.cover;
                if (!c.front && !c.wrap) return;

                var wrapMatches = d.wrapMatchesFront !== false;
                var st = d.wrapCoverStatus ? String(d.wrapCoverStatus) : '';
                if (c.wrap && (wrapMatches || st === 'Ready' || st === 'Stale')) {
                    coverWraparoundRef = c.wrap;
                    updateCovWrapBuildBanner(d);
                    showCovFullWrapPreview(c.wrap, d.pageCount || 0);
                } else {
                    resetPrintWrapPreviewUi();
                    if (c.front && needsPrintWrapAutoBuild()) {
                        updateCovWrapBuildBanner({ wrapCoverStatus: 'Missing', cover: { front: c.front } });
                    }
                }
                printWrapAssets = {
                    front: c.front || '',
                    back: c.back || '',
                    spine: c.spine || '',
                    wrap: (c.wrap || ''),
                    pageCount: d.pageCount || 0
                };
                setPrintWrapSaved(!!(c.wrap && (wrapMatches || st === 'Ready' || st === 'Stale')));
                coverHistory = [];
                var frontOnly = (c.front || '').trim();
                if (frontOnly) {
                    applyBestFrontPreview(frontOnly).catch(function () {
                        selectedPath = frontOnly;
                        setCoverImageVisible(toUrl(frontOnly));
                    });
                    pushCoverHistory(frontOnly);
                    if (selectedBook && selectedBook.bookId) {
                        selectedBook.aiCoverLastPreview = frontOnly;
                        selectedBook.coverImagePath = frontOnly;
                        persistCoverSelection(selectedBook.bookId, frontOnly);
                        patchBooksCache(selectedBook.bookId, {
                            aiCoverLastPreview: frontOnly,
                            coverImagePath: frontOnly
                        });
                    }
                }
            })
            .catch(function () {});
    }

    function setCoverImageVisible(url) {
        if (url) {
            covPreviewBgImg.classList.remove('opacity-100');
            covPreviewBgImg.classList.add('opacity-0');
            covPreviewBgImg.onerror = function () {
                covPreviewBgImg.onerror = null;
                setCoverImageVisible('');
            };
            covPreviewBgImg.onload = function () {
                covPreviewBgImg.classList.remove('opacity-0');
                covPreviewBgImg.classList.add('opacity-100');
                covPreviewBgImg.onload = null;
            };
            covPreviewBgImg.src = url;
            if (covPreviewPlaceholderImg) covPreviewPlaceholderImg.classList.add('opacity-0');
        } else {
            covPreviewBgImg.src = '';
            covPreviewBgImg.classList.add('opacity-0');
            covPreviewBgImg.classList.remove('opacity-100');
            if (covPreviewPlaceholderImg) {
                covPreviewPlaceholderImg.src = coverProgressPlaceholder;
                covPreviewPlaceholderImg.classList.remove('opacity-0');
            }
        }
        updatePublishGate();
    }

    // Front cover exists (ebook) — or for paperback/both, full wrap must also be saved.
    function frontCoverIsReady() {
        if (coverGeneratedPayload && (coverGeneratedPayload.value || '').trim()) return true;
        if (selectedPath && String(selectedPath).trim()) return true;
        if (selectedBook && (selectedBook.coverImagePath || selectedBook.aiCoverLastPreview)) return true;
        return false;
    }

    function fullWrapIsReady() {
        return !!(printWrapSaved && String(coverWraparoundRef || '').trim());
    }

    /** Publish is allowed only when export assets for the selected format are ready. */
    function coverIsReady() {
        if (!frontCoverIsReady()) return false;
        // Paperback / Both: block Continue until the exact full wrap Publish will export exists.
        if (needsPrintWrapAutoBuild()) return fullWrapIsReady();
        return true;
    }

    function updatePublishGate() {
        var frontReady = frontCoverIsReady();
        var ready = coverIsReady();
        var needsWrap = needsPrintWrapAutoBuild();
        var ebookMode = isEbookCoverMode();

        // Always refresh export buttons (even while Publish is temporarily busy).
        var dlBtns = document.querySelectorAll('.cov-download-btn');
        dlBtns.forEach(function (b) {
            var part = b.getAttribute('data-part') || 'front';
            if (part === 'wrap') {
                var wrapOk = !ebookMode && fullWrapIsReady();
                b.disabled = !wrapOk;
                b.classList.toggle('hidden', ebookMode);
                b.title = wrapOk
                    ? 'Download print-ready full wrap PDF'
                    : (ebookMode ? 'Switch to Paperback for wrap PDF' : 'Full wrap not ready yet');
            } else {
                b.disabled = !frontReady && !fullWrapIsReady();
                b.title = (frontReady || fullWrapIsReady())
                    ? 'Download front cover PNG'
                    : 'Generate a cover first';
            }
        });

        var epubBtn = document.getElementById('btnDownloadEbookBundle');
        if (epubBtn) {
            epubBtn.classList.toggle('hidden', !ebookMode);
            epubBtn.disabled = !(ebookMode && frontReady && selectedBook && selectedBook.bookId);
            epubBtn.title = epubBtn.disabled
                ? (ebookMode
                    ? 'Generate a front cover first, then download EPUB (cover + manuscript)'
                    : 'Available in eBook mode')
                : 'Download EPUB with this front cover and the manuscript chapters';
        }

        var frontLabelEl = document.getElementById('btnDownloadCoverFrontLabel');
        if (frontLabelEl) frontLabelEl.textContent = 'Download Front Cover — PNG';
        var wrapLabelEl = document.getElementById('btnDownloadCoverWrapLabel');
        if (wrapLabelEl) wrapLabelEl.textContent = 'Download Full Wrap — PDF';

        if (btnGenerate) btnGenerate.classList.toggle('hidden', frontReady);
        if (btnRegenerate) btnRegenerate.classList.toggle('hidden', !frontReady);
        syncGenerateButtonLabels();
        updateGenerateGate();

        if (!btnGoToPublish) return;
        if (btnGoToPublish.getAttribute('data-busy') === 'true') return;

        btnGoToPublish.setAttribute('aria-disabled', ready ? 'false' : 'true');
        btnGoToPublish.style.pointerEvents = ready ? '' : 'none';
        btnGoToPublish.style.opacity = ready ? '' : '0.5';
        if (ready) {
            btnGoToPublish.title = needsWrap
                ? 'Full wrap ready — open Publish to download front + full wrap'
                : 'Open Publish with this same manuscript';
        } else if (needsWrap && frontReady && !fullWrapIsReady()) {
            btnGoToPublish.title = 'Wait until the full wrap cover finishes building';
        } else if (!(selectedBook && selectedBook.bookId)) {
            btnGoToPublish.title = 'Select a manuscript first';
        } else {
            btnGoToPublish.title = 'Generate a cover first to continue';
        }
        var hint = document.getElementById('btnGoToPublishHint');
        if (hint) {
            if (!(selectedBook && selectedBook.bookId)) {
                hint.textContent = 'Select a manuscript above, then generate its cover.';
                hint.classList.remove('text-amber-700', 'text-emerald-700');
            } else if (ready && needsWrap) {
                hint.textContent = 'Full wrap saved — Publish export will download this same file.';
                hint.classList.remove('text-amber-700');
                hint.classList.add('text-emerald-700');
            } else if (ready && ebookMode) {
                hint.textContent = 'Front cover ready — download EPUB (cover + manuscript) or continue to Publish.';
                hint.classList.remove('text-amber-700');
                hint.classList.add('text-emerald-700');
            } else if (needsWrap && frontReady && !fullWrapIsReady()) {
                hint.textContent = 'Full wrap is still building — Continue to Publish stays disabled until it is ready.';
                hint.classList.add('text-amber-700');
                hint.classList.remove('text-emerald-700');
            } else if (!frontReady) {
                hint.textContent = ebookMode
                    ? 'Generate the front cover, then download PNG or EPUB.'
                    : 'Generate your cover first — for print, wait until the full wrap is ready.';
                hint.classList.remove('text-amber-700', 'text-emerald-700');
            } else {
                hint.textContent = 'Step 4 is Publish — continue when your cover looks right.';
                hint.classList.remove('text-amber-700', 'text-emerald-700');
            }
        }
    }

    function hideCoverOptionsGrid() {
        if (optionsWrap) {
            optionsWrap.classList.add('hidden');
            optionsWrap.setAttribute('hidden', 'hidden');
        }
        if (optionsGrid) optionsGrid.innerHTML = '';
    }

    function pushCoverHistory(url) {
        /* Single front cover only — no multi-option grid. */
        hideCoverOptionsGrid();
    }

    function renderHistoryThumbnails() {
        hideCoverOptionsGrid();
    }

    /** Front cover URL only — never wrap/spine/back (those are separate). */
    function pickFrontCoverUrl(d) {
        if (!d) return '';
        if (d.coverUrl) return d.coverUrl;
        if (d.cover && d.cover.front) return d.cover.front;
        if ((d.status === 'success' || d.status === 'complete') && d.image_base64)
            return 'data:image/png;base64,' + d.image_base64;
        if (d.imageDataUrl) return d.imageDataUrl;
        if (d.options && d.options.length) return d.options[0];
        return '';
    }

    /** Legacy alias — use pickFrontCoverUrl */
    function pickPreviewUrls(d) {
        var u = pickFrontCoverUrl(d);
        return u ? [u] : [];
    }

    function applyGenerationSuccess(d, label) {
        var primary = pickFrontCoverUrl(d);
        if (!primary) {
            toast('error', (d && d.message) ? d.message : 'No image returned.');
            return;
        }
        hasAiCoverThisSession = true;
        coverHistory = [primary];
        selectedPath = primary;
        hideCoverOptionsGrid();
        applyBestFrontPreview(primary).catch(function () {
            selectedPath = primary;
            setCoverImageVisible(toUrl(primary));
        });
        if (selectedBook && selectedBook.bookId) {
            selectedBook.aiCoverLastPreview = primary;
            if (primary.indexOf('data:') !== 0) selectedBook.coverImagePath = primary;
            persistCoverSelection(selectedBook.bookId, primary);
            var cachePatch = { aiCoverLastPreview: primary };
            if (primary.indexOf('data:') !== 0) cachePatch.coverImagePath = primary;
            patchBooksCache(selectedBook.bookId, cachePatch);
        }
        try {
            if (coverGeneratedPayload) {
                coverGeneratedPayload.value = (primary.indexOf('data:') === 0)
                    ? ('data-url-chars:' + String(primary.length))
                    : primary;
            }
        } catch (e) { /* ignore */ }
        toast('success', label === 'edit' ? 'Cover updated.' : 'Front cover ready — composing full print wrap…');
        updateLivePreview();
        setPrintWrapSaved(false);
        resetPrintWrapPreviewUi();
        // Wait for front to be saved server-side BEFORE wrap compose — otherwise wrap
        // hits MissingFront and the Full wrap tab shows a broken image forever.
        var afterFrontSaved = (selectedBook && selectedBook.bookId && primary.indexOf('data:') !== 0)
            ? setServerActiveCover(selectedBook.bookId, primary)
            : Promise.resolve(false);
        afterFrontSaved.then(function () {
            if (needsPrintWrapAutoBuild()) {
                if (hasSavedFrontForWrap() || (primary && primary.indexOf('data:') !== 0)) {
                    buildPrintWrapNow(true);
                } else {
                    updateCovWrapBuildBanner({ wrapCoverStatus: 'MissingFront' });
                    updatePublishGate();
                    toast('info', 'Save a front cover image first, then the full wrap can build.');
                }
            }
        });
    }

    function setBusy(busy, label) {
        previewBusy.classList.toggle('hidden', !busy);
        if (previewBusyText) previewBusyText.textContent = label || 'Generating…';
        // While generating, keep the "cover in progress" artwork on the front preview.
        // On finish the new cover's onload hides it again (or it stays if generation failed
        // and there is no usable cover art).
        if (covPreviewPlaceholderImg) {
            if (busy) {
                covPreviewPlaceholderImg.src = coverProgressPlaceholder;
                covPreviewPlaceholderImg.classList.remove('opacity-0');
            } else if (covPreviewBgImg && covPreviewBgImg.src && covPreviewBgImg.classList.contains('opacity-100')) {
                covPreviewPlaceholderImg.classList.add('opacity-0');
            }
        }
        btnGenerate.disabled = busy;
        if (btnRegenerate) btnRegenerate.disabled = busy;
        if (btnEditCover) btnEditCover.disabled = busy;
        setPublishButtonBusy(busy);
        if (busy) {
            btnGenerate.innerHTML = '<span class="inline-flex items-center gap-2"><span class="w-4 h-4 border-2 border-white/80 border-t-transparent rounded-full animate-spin"></span> Generating…</span>';
            if (btnRegenerate) btnRegenerate.innerHTML = '<span class="inline-flex items-center gap-2"><span class="w-4 h-4 border-2 border-violet-400 border-t-transparent rounded-full animate-spin"></span> Regenerating…</span>';
        } else {
            btnGenerate.innerHTML = '<i data-lucide="wand-2" class="w-4 h-4" stroke-width="1.75"></i> <span id="btnGenerateLabel">' + generatePrimaryLabel() + '</span>';
            if (btnRegenerate) btnRegenerate.innerHTML = '<i data-lucide="refresh-cw" class="w-4 h-4" stroke-width="1.75"></i> <span id="btnRegenerateLabel">' + regeneratePrimaryLabel() + '</span>';
            refreshLucide();
            updateGenerateGate();
        }
    }

    async function generatePrintReadyCoverFromApi() {
        if (!selectedBook) {
            toast('error', 'No book loaded.');
            return;
        }
        var userPrompt = covComposeDescription();
        if (!userPrompt) {
            toast('info', 'Write your Image Direction or upload a reference image first, then click Generate Cover.');
            if (imageDirection) imageDirection.focus();
            return;
        }
        var pageCount = (selectedBook && (selectedBook.pageCount || selectedBook.estimatedPages || selectedBook.totalPages)) || 0;
        if (!pageCount && selectedBook && selectedBook.bookId) {
            try {
                var metricsResp = await fetch('/Dashboard/BookPageMetrics?bookId=' + encodeURIComponent(selectedBook.bookId));
                var metricsData = await metricsResp.json();
                if (metricsData && metricsData.success && metricsData.pageCount > 0) {
                    pageCount = metricsData.pageCount;
                    selectedBook.pageCount = pageCount;
                }
            } catch (_) {}
        }
        if (!pageCount) {
            toast('error', 'Could not determine page count for spine width. Open Book Formatting first.');
            return;
        }
        var body = {
            bookId: selectedBook.bookId,
            pageCount: pageCount,
            title: (bookTitle.value || '').trim() || selectedBook.title || 'My Book',
            author: (authorName.value || '').trim() || (selectedBook.authorName || ''),
            genre: (bookCategory.value || '').trim(),
            style: (coverStyle.value || '').trim() || 'modern',
            description: userPrompt,
            coverStyle: buildStructuredPrompt(),
            size: '1536x1024',
            quality: 'high'
        };
        setBusy(true, 'Generating full wrap (back + spine + front)…');
        try {
            var r = await fetch('/Dashboard/GeneratePrintReadyCover', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(body)
            });
            var text = await r.text();
            var d = {};
            try { d = text ? JSON.parse(text) : {}; } catch (e) {
                console.error('[CoverDesign] GeneratePrintReadyCover JSON parse error', e, text);
                var gatewayMsg = r.status === 504
                    ? 'Cover generation timed out at the server gateway. Please retry — full wraps can take several minutes.'
                    : (text && text.indexOf('<html') >= 0 ? ('Server error (HTTP ' + r.status + '). Please retry.') : (text || 'Invalid JSON'));
                d = { success: false, message: gatewayMsg };
            }
            if (!r.ok && !d.message) d.message = 'HTTP ' + r.status;
            if (d.status === 'error' || d.success === false) {
                toast('error', d.message || 'Print wrap generation failed.');
                return;
            }
            if (!(d.status === 'success' || d.success === true)) {
                toast('error', d.message || 'Unexpected response.');
                return;
            }
            var c = d.cover || {};
            if (c.wrap) coverWraparoundRef = c.wrap;
            printWrapAssets = {
                front: c.front || '',
                back: c.back || '',
                spine: c.spine || '',
                wrap: c.wrap || '',
                pageCount: d.pageCount || pageCount
            };
            setPrintWrapSaved(!!c.wrap);
            lastKdpLayout = d.kdp || null;
            var previewPath = c.front || c.wrap || (d.options && d.options[0]) || '';
            if (!previewPath) {
                toast('error', 'No cover image returned from print wrap API.');
                return;
            }
            coverHistory = [];
            await applyBestFrontPreview(previewPath);
            pushCoverHistory(selectedPath || previewPath);
            if (selectedBook && selectedBook.bookId) {
                selectedBook.aiCoverLastPreview = previewPath;
                if (c.front && c.front.indexOf('data:') !== 0) selectedBook.coverImagePath = c.front;
                persistCoverSelection(selectedBook.bookId, selectedPath || previewPath);
                patchBooksCache(selectedBook.bookId, {
                    aiCoverLastPreview: previewPath,
                    coverImagePath: c.front || selectedBook.coverImagePath
                });
            }
            try {
                if (coverGeneratedPayload) {
                    coverGeneratedPayload.value = (previewPath.indexOf('data:') === 0)
                        ? ('data-url-chars:' + String(previewPath.length))
                        : (c.wrap || previewPath);
                }
            } catch (e) { /* ignore */ }
            showSpinePagesCreatedAlert(d.pageCount || pageCount);
            showPrintWrapModal(printWrapAssets, !!c.wrap, d, true);
            toast('success', 'Full print wrap saved — ready to export on Publish.');
            updateLivePreview();
            setTimeout(function () { renderHistoryThumbnails(); }, 0);
        } catch (err) {
            console.error('[CoverDesign] GeneratePrintReadyCover fetch error', err);
            toast('error', err.message || 'Network error.');
        } finally {
            setBusy(false);
        }
    }

    async function pollGenerateCoverStatus(maxMs, intervalMs) {
        var deadline = Date.now() + (maxMs || 900000);
        var interval = intervalMs || 3000;
        var sawProcessing = false;
        while (Date.now() < deadline) {
            await new Promise(function (r) { setTimeout(r, interval); });
            try {
                var st = await fetch('/Dashboard/GenerateCoverStatus?bookId=' + encodeURIComponent(selectedBook.bookId), {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                });
                var sd = await st.json();
                if (sd.status === 'processing') sawProcessing = true;
                if (sd.status === 'complete' && sd.success !== false) return sd;
                if (sd.status === 'error') throw new Error(sd.message || 'Cover generation failed.');
                if (sd.status === 'idle' && sawProcessing)
                    throw new Error('Cover job was lost. Please click Generate Cover again.');
            } catch (pollErr) {
                if (pollErr && pollErr.message) throw pollErr;
            }
        }
        throw new Error('Cover generation is taking longer than expected. Please wait and refresh the page.');
    }

    async function generateFrontCoverOnly(endpointUrl) {
        var url = endpointUrl || '/Dashboard/GenerateCover';
        var prompt = buildStructuredPrompt();
        var body = {
            bookId: selectedBook.bookId,
            prompt: prompt,
            title: (bookTitle.value || '').trim() || selectedBook.title || 'My Book',
            author: (authorName.value || '').trim() || (selectedBook.authorName || ''),
            genre: (bookCategory.value || '').trim(),
            style: (coverStyle.value || '').trim() || 'modern',
            description: covComposeDescription()
        };
        setBusy(true, 'Generating front cover…');
        try {
            var r = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(body)
            });
            var text = await r.text();
            var d = {};
            try { d = text ? JSON.parse(text) : {}; } catch (e) {
                console.error('[CoverDesign] JSON parse error', e, text);
                var frontMsg = r.status === 504
                    ? 'Front cover timed out at the server gateway. Please retry.'
                    : (text && text.indexOf('<html') >= 0 ? ('Server error (HTTP ' + r.status + '). Please retry.') : (text || 'Invalid JSON'));
                d = { success: false, message: frontMsg };
            }
            if (!r.ok && !d.message) d.message = 'HTTP ' + r.status;
            if (d.status === 'processing') {
                setBusy(true, 'AI is generating your cover — please wait…');
                d = await pollGenerateCoverStatus(900000, 3000);
            }
            if (d.status === 'error' || d.success === false) {
                toast('error', d.message || 'Generation failed.');
                return false;
            }
            if (!(d.status === 'success' || d.status === 'complete' || d.success === true)) {
                toast('error', d.message || 'Unexpected response.');
                return false;
            }
            if (d.coverUrl && selectedBook) selectedBook.aiCoverLastPreview = d.coverUrl;
            applyGenerationSuccess(d, 'generate');
            return true;
        } catch (err) {
            console.error('[CoverDesign] GenerateCover fetch error', err);
            toast('error', err.message || 'Network error.');
            return false;
        } finally {
            setBusy(false);
        }
    }

    async function generateCoverFromDashboard(endpointUrl) {
        if (!selectedBook || !selectedBook.bookId) {
            toast('info', 'Select a manuscript from the list above to generate and save the cover.');
            if (bookSelect) bookSelect.focus();
            return;
        }
        if (!(bookTitle && (bookTitle.value || '').trim())) {
            toast('info', 'Add a book title first.');
            if (bookTitle) bookTitle.focus();
            return;
        }
        if (!normalizePublishFormat(bookPublishFormat)) {
            toast('info', 'Choose eBook or Paperback.');
            return;
        }
        if (needsPrintWrapAutoBuild()) {
            var sum = (backCoverSummary && backCoverSummary.value || '').trim();
            if (!sum) {
                toast('info', 'Add a Book Summary for the back cover.');
                if (backCoverSummary) backCoverSummary.focus();
                return;
            }
        }
        var userPrompt = covComposeDescription();
        if (!userPrompt) {
            toast('info', 'Write your Image Direction or upload a reference image first, then click ' + generatePrimaryLabel() + '.');
            if (imageDirection) imageDirection.focus();
            return;
        }
        // Step 1: front cover only. Step 2: full wrap (Paperback/Both) runs after front succeeds.
        await generateFrontCoverOnly(endpointUrl);
    }

    function getPreviewImageAsBase64Async() {
        return new Promise(function (resolve) {
            var src = covPreviewBgImg && covPreviewBgImg.src ? covPreviewBgImg.src.trim() : '';
            if (!src) { resolve(null); return; }
            if (src.indexOf('data:image') === 0) {
                var i = src.indexOf('base64,');
                resolve(i >= 0 ? src.substring(i + 7) : null);
                return;
            }
            fetch(src, { credentials: 'same-origin', mode: 'cors' })
                .then(function (r) { return r.ok ? r.blob() : Promise.reject(new Error('HTTP ' + r.status)); })
                .then(function (blob) {
                    var reader = new FileReader();
                    reader.onloadend = function () {
                        var s = typeof reader.result === 'string' ? reader.result : '';
                        var ix = s.indexOf('base64,');
                        resolve(ix >= 0 ? s.substring(ix + 7) : null);
                    };
                    reader.onerror = function () { resolve(null); };
                    reader.readAsDataURL(blob);
                })
                .catch(function (e) {
                    console.warn('[CoverDesign] could not rasterize preview for edit:', e);
                    resolve(null);
                });
        });
    }

    async function editCoverWithApi() {
        var direction = (imageDirection.value || '').trim();
        setBusy(true);
        try {
            var b64 = await getPreviewImageAsBase64Async();
            if (!b64) {
                toast('info', 'Generate a cover first, then you can refine it — or regenerate with updated fields.');
                return;
            }
            var r = await fetch('/Dashboard/EditCover', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                    bookId: selectedBook ? selectedBook.bookId : 0,
                    encoded_image: b64,
                    image_direction: direction,
                    size: null
                })
            });
            var text = await r.text();
            var d = {};
            try { d = text ? JSON.parse(text) : {}; } catch (e) { d = { success: false, message: text }; }
            if (d.status === 'error' || d.success === false) {
                toast('error', d.message || 'Edit failed.');
                return;
            }
            if (d.coverUrl && selectedBook) selectedBook.aiCoverLastPreview = d.coverUrl;
            applyGenerationSuccess(d, 'edit');
        } catch (err) {
            console.error('[CoverDesign] EditCover error', err);
            toast('error', err.message || 'Edit request failed.');
        } finally {
            setBusy(false);
        }
    }

    function bindBook(bookId) {
        var id = parseInt(bookId, 10) || 0;
        selectedBook = id > 0 ? (books.find(function (b) { return b.bookId === id; }) || null) : null;
        if (!selectedBook) {
            // Soft mid-entry: no book — keep draft fields editable, clear book-bound assets.
            selectedPath = '';
            coverHistory = [];
            hasAiCoverThisSession = false;
            selectedOptionEl = null;
            resetPrintWrapPreviewUi();
            optionsWrap.classList.add('hidden');
            optionsGrid.innerHTML = '';
            setCoverImageVisible('');
            previewBusy.classList.add('hidden');
            applyCoverStyleClass();
            syncCoverStyleCards();
            restoreCoverDraftLocal();
            updateLivePreview();
            syncCovPreviewHeader();
            updateGenerateGate();
            updatePublishGate();
            return;
        }
        bookTitle.value = selectedBook.title || '';
        authorName.value = selectedBook.authorName || '';
        setGenreFromApi((selectedBook.genre || '').trim());
        imageDirection.value = selectedBook.aiCoverPrompt || '';
        if (backCoverSummary) backCoverSummary.value = selectedBook.description || '';
        updateBackCoverSummaryWarn();
        selectedPath = resolveCoverPathForBook(selectedBook);
        coverHistory = [];
        hasAiCoverThisSession = false;
        selectedOptionEl = null;
        resetPrintWrapPreviewUi();
        optionsWrap.classList.add('hidden');
        optionsGrid.innerHTML = '';
        updateLivePreview();
        if (selectedPath) {
            applyBestFrontPreview(selectedPath).catch(function () {
                setCoverImageVisible(toUrl(selectedPath));
            });
            pushCoverHistory(selectedPath);
        } else {
            setCoverImageVisible('');
        }
        previewBusy.classList.add('hidden');
        applyCoverStyleClass();
        syncCoverStyleCards();
        loadSavedPrintWrapAssets(parseInt(bookId, 10));
    }

    function renderBooks(data) {
        if (!data || !data.success || !data.books || !data.books.length) {
            screenLoading.classList.add('hidden');
            // Soft mid-entry still opens the studio even with an empty library.
            emptyState.classList.add('hidden');
            coverMain.classList.remove('hidden');
            books = [];
            bookSelect.innerHTML = '<option value="0" selected>Choose a manuscript…</option>';
            var hintEmpty = document.getElementById('covManuscriptHint');
            if (hintEmpty) hintEmpty.textContent = 'No manuscripts yet — create or upload a book first, then return here.';
            bindBook(0);
            applyCoverStyleClass();
            syncCoverStyleCards();
            refreshLucide();
            return;
        }
        books = data.books;
        screenLoading.classList.add('hidden');
        emptyState.classList.add('hidden');
        coverMain.classList.remove('hidden');
        var opts = '<option value="0">Choose a manuscript…</option>' + books.map(function (b, ix) {
            var label = (ix + 1) + '. ' + (b.title || 'Untitled');
            return '<option value="' + b.bookId + '">' + label.replace(/</g, '&lt;') + '</option>';
        }).join('');
        bookSelect.innerHTML = opts;
        var hint = document.getElementById('covManuscriptHint');
        if (hint) {
            hint.textContent = books.length === 1
                ? '1 manuscript ready — generate its cover, then export.'
                : books.length + ' manuscripts — pick one, generate cover, export, then switch to the next.';
        }
        // Phase A (start→finish): bookId in URL binds that book.
        // Phase B (mid-entry): bookId=0 stays unattached — never auto-pick first/session book.
        var defaultId = initialBookId > 0 ? initialBookId : 0;
        if (defaultId > 0) {
            var found = books.some(function (b) { return b.bookId === defaultId; });
            if (!found) defaultId = 0;
        }
        bookSelect.value = String(defaultId);
        if (defaultId > 0) {
            try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(defaultId)); } catch (_) {}
            bindBook(defaultId);
            refreshBookFromServer(defaultId).then(function () {
                loadSavedPrintWrapAssets(defaultId);
            });
        } else {
            bindBook(0);
        }
        applyCoverStyleClass();
        syncCoverStyleCards();
        refreshLucide();
    }

    var booksRendered = false;

    function loadBooks() {
        if (initialBookId > 0) {
            try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(initialBookId)); } catch (_) {}
        }
        var cached = null;
        try { cached = JSON.parse(sessionStorage.getItem(booksCacheKey) || 'null'); } catch (_) { cached = null; }
        if (initialBookId > 0 && cached && cached.success && cached.books && cached.books.length) {
            var hasTarget = cached.books.some(function (b) { return b.bookId === initialBookId; });
            if (!hasTarget) cached = null;
        }
        if (cached && cached.success && cached.books && cached.books.length) {
            cached.books.forEach(function (b) {
                if (!b || !b.bookId) return;
                if (!(b.aiCoverLastPreview || b.coverImagePath)) {
                    var sess = readPersistedCoverUrl(b.bookId);
                    if (sess) b.aiCoverLastPreview = sess;
                }
            });
            booksRendered = true;
            renderBooks(cached);
        }

        if (initialBookId > 0 && !booksRendered) {
            fetch('/Books/GetBookForCoverDesign?bookId=' + encodeURIComponent(initialBookId))
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (d && d.success && d.book) {
                        booksRendered = true;
                        renderBooks({ success: true, books: [d.book] });
                    }
                })
                .catch(function () { /* full list fetch is fallback */ });
        }

        var listController = new AbortController();
        var listTimeout = setTimeout(function () { listController.abort(); }, 20000);
        fetch('/Books/GetUserBooksForCoverDesign', { signal: listController.signal })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                clearTimeout(listTimeout);
                if (initialBookId > 0 && d && d.success && d.books && d.books.length) {
                    d.books.sort(function (a, b) {
                        if (a.bookId === initialBookId) return -1;
                        if (b.bookId === initialBookId) return 1;
                        return 0;
                    });
                }
                try { sessionStorage.setItem(booksCacheKey, JSON.stringify(d)); } catch (_) {}
                if (d && d.success && d.books && d.books.length) {
                    booksRendered = true;
                    renderBooks(d);
                } else if (!booksRendered) {
                    // Soft mid-entry: still open the studio without forcing a book.
                    booksRendered = true;
                    renderBooks({ success: true, books: [] });
                }
            })
            .catch(function () {
                clearTimeout(listTimeout);
                screenLoading.classList.add('hidden');
                if (!booksRendered) {
                    booksRendered = true;
                    renderBooks({ success: true, books: [] });
                }
            });
    }

