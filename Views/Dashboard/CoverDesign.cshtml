    }

    function syncGenerateButtonLabels() {
        var genLabel = document.getElementById('btnGenerateLabel');
        var regenLabel = document.getElementById('btnRegenerateLabel');
        if (genLabel) genLabel.textContent = generatePrimaryLabel();
        if (regenLabel) regenLabel.textContent = regeneratePrimaryLabel();
