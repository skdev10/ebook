        var building = document.getElementById('covFullWrapBuilding');
        if (building) building.classList.add('hidden');
        var placeholder = document.getElementById('covFullWrapPlaceholder');
        if (placeholder) {
            var phText = document.getElementById('covFullWrapPlaceholderText');
            if (phText) phText.textContent = 'Full wrap appears here after you generate your front cover.';
            placeholder.classList.remove('hidden');
        }
        var badge = document.getElementById('covWrapSavedBadge');
        if (badge) badge.classList.add('hidden');
