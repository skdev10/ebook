    function loadSavedPrintWrapAssets(bookId) {
        if (!bookId) return Promise.resolve();
        return fetch('/Dashboard/GetPrintReadyCoverAssets?bookId=' + encodeURIComponent(bookId))
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d || !d.success || !d.cover) return;
                var c = d.cover;
                if (!c.front && !c.wrap) return;

                if (c.wrap) coverWraparoundRef = c.wrap;
                printWrapAssets = {
                    front: c.front || '',
                    back: c.back || '',
                    spine: c.spine || '',
                    wrap: c.wrap || '',
                    pageCount: d.pageCount || 0
                };
                setPrintWrapSaved(!!c.wrap);
                coverHistory = [];
                var latest = c.front || c.wrap;
                if (latest) {
                    applyBestFrontPreview(latest).catch(function () {
                        selectedPath = latest;
                        setCoverImageVisible(toUrl(latest));
                    });
                    pushCoverHistory(latest);
                    if (selectedBook && selectedBook.bookId) {
                        selectedBook.aiCoverLastPreview = latest;
                        if (latest.indexOf('data:') !== 0) selectedBook.coverImagePath = c.front || latest;
                        persistCoverSelection(selectedBook.bookId, latest);
                        patchBooksCache(selectedBook.bookId, {
                            aiCoverLastPreview: latest,
                            coverImagePath: c.front || selectedBook.coverImagePath
                        });
                    }
                }
            })
            .catch(function () {});
    }

    function setCoverImageVisible(url) {
        if (url) {
            covPreviewBgImg.classList.remove('opacity-100');
            covPreviewBgImg.classList.add('opacity-0');
            covPreviewBgImg.onerror = function () {
                covPreviewBgImg.onerror = null;
                setCoverImageVisible('');
            };
            covPreviewBgImg.onload = function () {
                covPreviewBgImg.classList.remove('opacity-0');
                covPreviewBgImg.classList.add('opacity-100');
                covPreviewBgImg.onload = null;
            };
            covPreviewBgImg.src = url;
            if (covPreviewPlaceholderImg) covPreviewPlaceholderImg.classList.add('opacity-0');
        } else {
            covPreviewBgImg.src = '';
            covPreviewBgImg.classList.add('opacity-0');
            covPreviewBgImg.classList.remove('opacity-100');
            if (covPreviewPlaceholderImg) {
                covPreviewPlaceholderImg.src = coverProgressPlaceholder;
                covPreviewPlaceholderImg.classList.remove('opacity-0');
            }
        }
    }

    function pushCoverHistory(url) {
        if (!url) return;
        coverHistory = coverHistory.filter(function (u) { return u !== url; });
        coverHistory.unshift(url);
        if (coverHistory.length > MAX_HISTORY) coverHistory.length = MAX_HISTORY;
        renderHistoryThumbnails();
    }

    function renderHistoryThumbnails() {
        if (!coverHistory.length) {
            optionsWrap.classList.add('hidden');
            optionsGrid.innerHTML = '';
            return;
        }
        optionsWrap.classList.remove('hidden');
        optionsGrid.innerHTML = coverHistory.map(function (p, idx) {
            var u = toUrl(p).replace(/"/g, '&quot;');
            var sel = (p === selectedPath) ? 'border-violet-600 ring-2 ring-violet-300' : 'border-slate-200';
            return '<button type="button" class="option-tile relative rounded-2xl overflow-hidden border-2 ' + sel + ' hover:border-violet-500 transition-all focus:outline-none focus:ring-2 focus:ring-violet-400" data-path="' + (p || '').replace(/"/g, '&quot;') + '">' +
                '<img src="' + u + '" alt="" class="w-full aspect-[2/3] object-cover" loading="lazy" />' +
                '<span class="absolute bottom-2 right-2 text-[10px] bg-black/60 text-white px-2 py-0.5 rounded-full">' + (idx + 1) + '</span></button>';
        }).join('');

        Array.prototype.forEach.call(optionsGrid.querySelectorAll('.option-tile'), function (btn) {
            btn.addEventListener('click', function () {
                if (selectedOptionEl) {
                    selectedOptionEl.classList.remove('border-violet-600', 'ring-2', 'ring-violet-300');
                    selectedOptionEl.classList.add('border-slate-200');
                }
                selectedOptionEl = btn;
                btn.classList.add('border-violet-600', 'ring-2', 'ring-violet-300');
                btn.classList.remove('border-slate-200');
                selectedPath = btn.getAttribute('data-path') || '';
                setCoverImageVisible(toUrl(selectedPath));
                if (selectedBook && selectedBook.bookId) persistCoverSelection(selectedBook.bookId, selectedPath);
                if (coverGeneratedPayload) coverGeneratedPayload.value = selectedPath.indexOf('data:') === 0 ? selectedPath.substring(0, 120) + '…' : selectedPath;
                renderHistoryThumbnails();
            });
        });
        refreshLucide();
    }

    /** Normalize API response: supports { status, image_base64 }, { success, options }, { imageDataUrl }. */
    function pickPreviewUrls(d) {
        var urls = [];
        if (!d) return urls;
        if (d.coverUrl) urls.push(d.coverUrl);
        if (d.cover) {
            if (d.cover.wrap) urls.push(d.cover.wrap);
            if (d.cover.front) urls.push(d.cover.front);
            if (d.cover.back) urls.push(d.cover.back);
            if (d.cover.spine) urls.push(d.cover.spine);
        }
        if (d.status === 'success' && d.image_base64) {
            urls.push('data:image/png;base64,' + d.image_base64);
        }
        if (d.imageDataUrl) urls.push(d.imageDataUrl);
        if (d.options && d.options.length) {
            d.options.forEach(function (o) { if (o) urls.push(o); });
        }
        var seen = {};
        return urls.filter(function (u) {
            if (!u || seen[u]) return false;
            seen[u] = true;
            return true;
        });
    }

    function applyGenerationSuccess(d, label) {
        var urls = pickPreviewUrls(d);
        if (!urls.length) {
            toast('error', (d && d.message) ? d.message : 'No image returned.');
            return;
        }
        hasAiCoverThisSession = true;
        coverHistory = [];
        var primary = urls[0];
        selectedPath = primary;
        pushCoverHistory(primary);
        urls.slice(1).forEach(function (u) { pushCoverHistory(u); });
        setCoverImageVisible(toUrl(primary));
        if (selectedBook && selectedBook.bookId) {
            selectedBook.aiCoverLastPreview = primary;
            if (primary.indexOf('data:') !== 0) selectedBook.coverImagePath = primary;
            persistCoverSelection(selectedBook.bookId, primary);
            var cachePatch = { aiCoverLastPreview: primary };
            if (primary.indexOf('data:') !== 0) cachePatch.coverImagePath = primary;
            patchBooksCache(selectedBook.bookId, cachePatch);
        }
        try {
            if (coverGeneratedPayload) {
                coverGeneratedPayload.value = (primary.indexOf('data:') === 0)
                    ? ('data-url-chars:' + String(primary.length))
                    : primary;
            }
        } catch (e) { /* ignore */ }
        toast('success', label === 'edit' ? 'Cover updated.' : 'Cover ready.');
        updateLivePreview();
        setTimeout(function () { renderHistoryThumbnails(); }, 0);
    }

    function setBusy(busy, label) {
        previewBusy.classList.toggle('hidden', !busy);
        if (previewBusyText) previewBusyText.textContent = label || 'Generating…';
        btnGenerate.disabled = busy;
        if (btnRegenerate) btnRegenerate.disabled = busy;
        if (btnEditCover) btnEditCover.disabled = busy;
        setPublishButtonBusy(busy);
        if (busy) {
            btnGenerate.innerHTML = '<span class="inline-flex items-center gap-2"><span class="w-4 h-4 border-2 border-white/80 border-t-transparent rounded-full animate-spin"></span> Generating…</span>';
        } else {
            btnGenerate.innerHTML = '<i data-lucide="wand-2" class="w-4 h-4" stroke-width="1.75"></i> Generate Cover';
            refreshLucide();
        }
    }

    async function generatePrintReadyCoverFromApi() {
        if (!selectedBook) {
            toast('error', 'No book loaded.');
            return;
        }
        var userPrompt = (imageDirection.value || '').trim();
        if (!userPrompt) {
            toast('info', 'Write your Image Direction prompt first, then click Generate Cover.');
            if (imageDirection) imageDirection.focus();
            return;
        }
        var pageCount = (selectedBook && (selectedBook.pageCount || selectedBook.estimatedPages || selectedBook.totalPages)) || 0;
        if (!pageCount && selectedBook && selectedBook.bookId) {
            try {
                var metricsResp = await fetch('/Dashboard/BookPageMetrics?bookId=' + encodeURIComponent(selectedBook.bookId));
                var metricsData = await metricsResp.json();
                if (metricsData && metricsData.success && metricsData.pageCount > 0) {
                    pageCount = metricsData.pageCount;
                    selectedBook.pageCount = pageCount;
                }
            } catch (_) {}
        }
        if (!pageCount) {
            toast('error', 'Could not determine page count for spine width. Open Book Formatting first.');
            return;
        }
        var body = {
            bookId: selectedBook.bookId,
            pageCount: pageCount,
            title: (bookTitle.value || '').trim() || selectedBook.title || 'My Book',
            author: (authorName.value || '').trim() || (selectedBook.authorName || ''),
            genre: (bookCategory.value || '').trim(),
            style: (coverStyle.value || '').trim() || 'modern',
            description: userPrompt,
            coverStyle: buildStructuredPrompt(),
            size: '1536x1024',
            quality: 'high'
        };
        setBusy(true, 'Generating full wrap (back + spine + front)…');
        try {
            var r = await fetch('/Dashboard/GeneratePrintReadyCover', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(body)
            });
            var text = await r.text();
            var d = {};
            try { d = text ? JSON.parse(text) : {}; } catch (e) {
                console.error('[CoverDesign] GeneratePrintReadyCover JSON parse error', e, text);
                var gatewayMsg = r.status === 504
                    ? 'Cover generation timed out at the server gateway. Please retry — full wraps can take several minutes.'
                    : (text && text.indexOf('<html') >= 0 ? ('Server error (HTTP ' + r.status + '). Please retry.') : (text || 'Invalid JSON'));
                d = { success: false, message: gatewayMsg };
            }
            if (!r.ok && !d.message) d.message = 'HTTP ' + r.status;
            if (d.status === 'error' || d.success === false) {
                toast('error', d.message || 'Print wrap generation failed.');
                return;
            }
            if (!(d.status === 'success' || d.success === true)) {
                toast('error', d.message || 'Unexpected response.');
                return;
            }
            var c = d.cover || {};
            if (c.wrap) coverWraparoundRef = c.wrap;
            printWrapAssets = {
                front: c.front || '',
                back: c.back || '',
                spine: c.spine || '',
                wrap: c.wrap || '',
                pageCount: d.pageCount || pageCount
            };
            setPrintWrapSaved(!!c.wrap);
            lastKdpLayout = d.kdp || null;
            var previewPath = c.front || c.wrap || (d.options && d.options[0]) || '';
            if (!previewPath) {
                toast('error', 'No cover image returned from print wrap API.');
                return;
            }
            coverHistory = [];
            await applyBestFrontPreview(previewPath);
            pushCoverHistory(selectedPath || previewPath);
            if (selectedBook && selectedBook.bookId) {
                selectedBook.aiCoverLastPreview = previewPath;
                if (c.front && c.front.indexOf('data:') !== 0) selectedBook.coverImagePath = c.front;
                persistCoverSelection(selectedBook.bookId, selectedPath || previewPath);
                patchBooksCache(selectedBook.bookId, {
                    aiCoverLastPreview: previewPath,
                    coverImagePath: c.front || selectedBook.coverImagePath
                });
            }
            try {
                if (coverGeneratedPayload) {
                    coverGeneratedPayload.value = (previewPath.indexOf('data:') === 0)
                        ? ('data-url-chars:' + String(previewPath.length))
                        : (c.wrap || previewPath);
                }
            } catch (e) { /* ignore */ }
            showSpinePagesCreatedAlert(d.pageCount || pageCount);
            showPrintWrapModal(printWrapAssets, !!c.wrap, d, true);
            toast('success', 'Full print wrap saved — ready to export on Publish.');
            updateLivePreview();
            setTimeout(function () { renderHistoryThumbnails(); }, 0);
        } catch (err) {
            console.error('[CoverDesign] GeneratePrintReadyCover fetch error', err);
            toast('error', err.message || 'Network error.');
        } finally {
            setBusy(false);
        }
    }

    async function generateCoverFromDashboard(endpointUrl) {
        if (!selectedBook) {
            toast('error', 'No book loaded.');
            return;
        }
        var userPrompt = (imageDirection.value || '').trim();
        if (!userPrompt) {
            toast('info', 'Write your Image Direction prompt first, then click Generate Cover.');
            if (imageDirection) imageDirection.focus();
            return;
        }
        var isPrintFlow = (isPrintReadyPlatform() || coverFlowPrintReady || bookPublishFormat === 'Paperback' || bookPublishFormat === 'Both') && !skipPrintReadyAuto;
        if (isPrintFlow) {
            await generatePrintReadyCoverFromApi();
            return;
        }
        var url = endpointUrl || '/Dashboard/GenerateCover';
        var prompt = buildStructuredPrompt();
        var body = {
            bookId: selectedBook.bookId,
            prompt: prompt,
            title: (bookTitle.value || '').trim() || selectedBook.title || 'My Book',
            author: (authorName.value || '').trim() || (selectedBook.authorName || ''),
            genre: (bookCategory.value || '').trim(),
            style: (coverStyle.value || '').trim() || 'modern',
            description: (imageDirection.value || '').trim()
        };
        setBusy(true, 'Generating front cover…');
        try {
            var r = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(body)
            });
            var text = await r.text();
            var d = {};
            try { d = text ? JSON.parse(text) : {}; } catch (e) {
                console.error('[CoverDesign] JSON parse error', e, text);
                d = { success: false, message: text || 'Invalid JSON' };
            }
            if (!r.ok && !d.message) d.message = 'HTTP ' + r.status;
            if (d.status === 'error' || d.success === false) {
                toast('error', d.message || 'Generation failed.');
                return;
            }
            if (!(d.status === 'success' || d.success === true)) {
                toast('error', d.message || 'Unexpected response.');
                return;
            }
            if (d.coverUrl && selectedBook) selectedBook.aiCoverLastPreview = d.coverUrl;
            applyGenerationSuccess(d, 'generate');
            toast('success', 'Front cover ready.');
        } catch (err) {
            console.error('[CoverDesign] GenerateCover fetch error', err);
            toast('error', err.message || 'Network error.');
        } finally {
            setBusy(false);
        }
    }

    function getPreviewImageAsBase64Async() {
        return new Promise(function (resolve) {
            var src = covPreviewBgImg && covPreviewBgImg.src ? covPreviewBgImg.src.trim() : '';
            if (!src) { resolve(null); return; }
            if (src.indexOf('data:image') === 0) {
                var i = src.indexOf('base64,');
                resolve(i >= 0 ? src.substring(i + 7) : null);
                return;
            }
            fetch(src, { credentials: 'same-origin', mode: 'cors' })
                .then(function (r) { return r.ok ? r.blob() : Promise.reject(new Error('HTTP ' + r.status)); })
                .then(function (blob) {
                    var reader = new FileReader();
                    reader.onloadend = function () {
                        var s = typeof reader.result === 'string' ? reader.result : '';
                        var ix = s.indexOf('base64,');
                        resolve(ix >= 0 ? s.substring(ix + 7) : null);
                    };
                    reader.onerror = function () { resolve(null); };
                    reader.readAsDataURL(blob);
                })
                .catch(function (e) {
                    console.warn('[CoverDesign] could not rasterize preview for edit:', e);
                    resolve(null);
                });
        });
    }

    async function editCoverWithApi() {
        var direction = (imageDirection.value || '').trim();
        setBusy(true);
        try {
            var b64 = await getPreviewImageAsBase64Async();
            if (!b64) {
                toast('info', 'Generate a cover first, then you can refine it — or regenerate with updated fields.');
                return;
            }
            var r = await fetch('/Dashboard/EditCover', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                    bookId: selectedBook ? selectedBook.bookId : 0,
                    encoded_image: b64,
                    image_direction: direction,
                    size: null
                })
            });
            var text = await r.text();
            var d = {};
            try { d = text ? JSON.parse(text) : {}; } catch (e) { d = { success: false, message: text }; }
            if (d.status === 'error' || d.success === false) {
                toast('error', d.message || 'Edit failed.');
                return;
            }
            if (d.coverUrl && selectedBook) selectedBook.aiCoverLastPreview = d.coverUrl;
            applyGenerationSuccess(d, 'edit');
        } catch (err) {
            console.error('[CoverDesign] EditCover error', err);
            toast('error', err.message || 'Edit request failed.');
        } finally {
            setBusy(false);
        }
    }

    function bindBook(bookId) {
        selectedBook = books.find(function (b) { return b.bookId === parseInt(bookId, 10); }) || null;
        if (!selectedBook) return;
        bookTitle.value = selectedBook.title || '';
        authorName.value = selectedBook.authorName || '';
        setGenreFromApi((selectedBook.genre || '').trim());
        imageDirection.value = selectedBook.aiCoverPrompt || selectedBook.description || '';
        selectedPath = resolveCoverPathForBook(selectedBook);
        coverHistory = [];
        hasAiCoverThisSession = false;
        selectedOptionEl = null;
        optionsWrap.classList.add('hidden');
        optionsGrid.innerHTML = '';
        updateLivePreview();
        if (selectedPath) {
            applyBestFrontPreview(selectedPath).catch(function () {
                setCoverImageVisible(toUrl(selectedPath));
            });
            pushCoverHistory(selectedPath);
        } else {
            setCoverImageVisible('');
        }
        previewBusy.classList.add('hidden');
        applyCoverStyleClass();
        syncCoverStyleCards();
        loadSavedPrintWrapAssets(parseInt(bookId, 10));
    }

    function renderBooks(data) {
        if (!data || !data.success || !data.books || !data.books.length) {
            screenLoading.classList.add('hidden');
            emptyState.classList.remove('hidden');
            return;
        }
        books = data.books;
        screenLoading.classList.add('hidden');
        coverMain.classList.remove('hidden');
        bookSelect.innerHTML = books.map(function (b) {
            return '<option value="' + b.bookId + '">' + (b.title || 'Untitled').replace(/</g, '&lt;') + '</option>';
        }).join('');
        var defaultId = initialBookId > 0 ? initialBookId : 0;
        if (!defaultId) {
            try { defaultId = parseInt(sessionStorage.getItem(FORMATTER_BOOK_KEY) || '0', 10); } catch (_) { defaultId = 0; }
        }
        if (!defaultId) defaultId = books[0].bookId;
        var found = books.some(function (b) { return b.bookId === defaultId; });
        if (!found) defaultId = books[0].bookId;
        bookSelect.value = String(defaultId);
        try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(defaultId)); } catch (_) {}
        bindBook(defaultId);
        refreshBookFromServer(defaultId).then(function () {
            loadSavedPrintWrapAssets(defaultId);
        });
        applyCoverStyleClass();
        syncCoverStyleCards();
        refreshLucide();
    }

    var booksRendered = false;

    function loadBooks() {
        if (initialBookId > 0) {
            try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(initialBookId)); } catch (_) {}
        }
        var cached = null;
        try { cached = JSON.parse(sessionStorage.getItem(booksCacheKey) || 'null'); } catch (_) { cached = null; }
        if (initialBookId > 0 && cached && cached.success && cached.books && cached.books.length) {
            var hasTarget = cached.books.some(function (b) { return b.bookId === initialBookId; });
            if (!hasTarget) cached = null;
        }
        if (cached && cached.success && cached.books && cached.books.length) {
            cached.books.forEach(function (b) {
                if (!b || !b.bookId) return;
                if (!(b.aiCoverLastPreview || b.coverImagePath)) {
                    var sess = readPersistedCoverUrl(b.bookId);
                    if (sess) b.aiCoverLastPreview = sess;
                }
            });
            booksRendered = true;
            renderBooks(cached);
        }

        if (initialBookId > 0 && !booksRendered) {
            fetch('/Books/GetBookForCoverDesign?bookId=' + encodeURIComponent(initialBookId))
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (d && d.success && d.book) {
                        booksRendered = true;
                        renderBooks({ success: true, books: [d.book] });
                    }
                })
                .catch(function () { /* full list fetch is fallback */ });
        }

        var listController = new AbortController();
        var listTimeout = setTimeout(function () { listController.abort(); }, 20000);
        fetch('/Books/GetUserBooksForCoverDesign', { signal: listController.signal })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                clearTimeout(listTimeout);
                if (initialBookId > 0 && d && d.success && d.books && d.books.length) {
                    d.books.sort(function (a, b) {
                        if (a.bookId === initialBookId) return -1;
                        if (b.bookId === initialBookId) return 1;
                        return 0;
                    });
                }
                try { sessionStorage.setItem(booksCacheKey, JSON.stringify(d)); } catch (_) {}
                if (d && d.success && d.books && d.books.length) {
                    booksRendered = true;
                    renderBooks(d);
                } else if (!booksRendered) {
                    screenLoading.classList.add('hidden');
                    emptyState.classList.remove('hidden');
                    emptyState.textContent = 'No books found. Create a book from the Dashboard first.';
                }
            })
            .catch(function () {
                clearTimeout(listTimeout);
                screenLoading.classList.add('hidden');
                if (!booksRendered) {
                    emptyState.classList.remove('hidden');
                    emptyState.textContent = 'Failed to load books. Please refresh.';
                }
            });
    }

    bookSelect.addEventListener('change', function () {
        bindBook(this.value);
        refreshBookFromServer(this.value).then(function () { loadSavedPrintWrapAssets(this.value); }.bind(this));
    });
    btnGenerate.addEventListener('click', function () { generateCoverFromDashboard(); });
    if (btnRegenerate) btnRegenerate.addEventListener('click', function () {
        generateCoverFromDashboard('/Dashboard/RegenerateCover');
    });
    if (btnEditCover) btnEditCover.addEventListener('click', function () {
        editCoverWithApi();
    });

    function loadScriptOnce(src, attrVal) {
        return new Promise(function (resolve, reject) {
            var sel = 'script[data-asset="' + attrVal + '"]';
            if (document.querySelector(sel)) { resolve(); return; }
            var s = document.createElement('script');
            s.src = src;
            s.async = true;
            s.setAttribute('data-asset', attrVal);
            s.onload = function () { resolve(); };
            s.onerror = function () { reject(new Error('Could not load ' + src)); };
            document.head.appendChild(s);
        });
    }

    function ensureHtml2Canvas() {
        if (typeof html2canvas !== 'undefined') return Promise.resolve();
        return loadScriptOnce('https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js', 'html2canvas');
    }

    function captureCoverDataUrl() {
        return ensureHtml2Canvas().then(function () {
            if (!covPreviewShell || typeof html2canvas === 'undefined') return null;
            return html2canvas(covPreviewShell, {
                scale: 2,
                useCORS: true,
                allowTaint: true,
                logging: false,
                backgroundColor: null
            }).then(function (canvas) {
                try { return canvas.toDataURL('image/jpeg', 0.92); } catch (e) { return null; }
            });
        });
    }

    function escapeHtmlText(s) {
        if (s === undefined || s === null) return '';
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function buildPdfPreviewModalHtml(coverDataUrl, data) {
        var ch = (data.chapters || []).slice(0, 6);
        var cards = ch.map(function (c) {
            var heading = c.chapterDisplayHeading || ('Section ' + (c.displayChapterNumber || ''));
            var t = String(c.chapterTitle || '').trim();
            if (t.length > 72) t = t.slice(0, 72) + '…';
            return '<div style="border:1px solid #e2e8f0;border-radius:12px;padding:10px;background:#fafafa;">' +
                '<div style="font-weight:600;font-size:12px;color:#4c1d95;margin-bottom:6px;">' + escapeHtmlText(heading) + (t && heading.indexOf(t) < 0 ? ' · ' + escapeHtmlText(t) : '') + '</div>' +
                '<div style="font-size:11px;line-height:1.45;color:#475569;max-height:120px;overflow:hidden;">' + (c.previewHtml || '') + '</div></div>';
        }).join('');
        var coverImg = coverDataUrl
            ? '<img src="' + coverDataUrl.replace(/"/g, '&quot;') + '" alt="" style="width:100%;max-width:200px;margin:0 auto;display:block;border-radius:16px;box-shadow:0 10px 30px rgba(76,29,149,0.22);aspect-ratio:2/3;object-fit:cover;"/>'
            : '<div style="width:100%;max-width:200px;margin:0 auto;aspect-ratio:2/3;border-radius:16px;background:#475569;"></div>';
        return '<div style="text-align:left;color:#0f172a;">' +
            '<p style="margin:0 0 12px;font-size:13px;color:#64748b;">Your PDF will match this cover (captured live) and include <strong>' + (data.totalChapters || 0) + '</strong> formatted chapters.</p>' +
            '<div style="display:grid;grid-template-columns:minmax(120px,1fr) minmax(0,2fr);gap:14px;max-height:min(52vh,440px);overflow:auto;padding-right:4px;">' +
            '<div style="text-align:center;">' + coverImg + '</div>' +
            '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;align-content:start;">' + cards + '</div>' +
            '</div></div>';
    }

    function buildChapterViewerModalHtml(data) {
