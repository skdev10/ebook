<script>
(function () {
    'use strict';

    var initialBookId = @(initialBookId);
    var coverFlowPrintReady = false;
    var coverType = '';
    var skipPrintReadyAuto = false;
    try {
        var coverParams = new URLSearchParams(window.location.search);
        coverFlowPrintReady = (coverParams.get('flow') || '').toLowerCase() === 'printready';
        coverType = (coverParams.get('coverType') || '').toLowerCase();
        skipPrintReadyAuto = (coverParams.get('skipPrintReadyAuto') || '').toLowerCase() === '1';
    } catch (e) { coverFlowPrintReady = false; }
    var books = [];
    var selectedBook = null;
    /** Current selection: relative path, http(s) URL, or data:image URL */
    var selectedPath = '';
    var selectedOptionEl = null;
    var booksCacheKey = 'cover_design_books_cache_v1';
    var FORMATTER_BOOK_KEY = typeof window.EBOOK_FORMATTER_BOOK_KEY === 'string' ? window.EBOOK_FORMATTER_BOOK_KEY : 'ebook_formatter_book_id';

    function coverUrlSessionKey(bookId) {
        return 'coverDesign_selectedUrl_' + bookId;
    }

    function persistCoverSelection(bookId, url) {
        if (!bookId || !url) return;
        try {
            sessionStorage.setItem(coverUrlSessionKey(bookId), url);
            sessionStorage.setItem('coverDesign_selectedUrl', url);
            sessionStorage.setItem('coverDesign_hasGenerated', '1');
            sessionStorage.setItem('coverDesign_lastBookId', String(bookId));
        } catch (_) {}
    }

    // #8: persist the user's chosen cover variation on the SERVER so Publish/export uses it
    // (sessionStorage alone would leave the default first variation as the stored active cover).
    function setServerActiveCover(bookId, url) {
        if (!bookId || !url) return Promise.resolve(false);
        if (String(url).indexOf('data:') === 0) return Promise.resolve(false); // transient preview
        return fetch('/Dashboard/SetActiveCover', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ bookId: bookId, url: url })
        }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) {
            return !!(r.ok && j && j.success !== false);
        }); }).catch(function () { return false; });
    }

    function readPersistedCoverUrl(bookId) {
        if (!bookId) return '';
        try {
            var scoped = sessionStorage.getItem(coverUrlSessionKey(bookId));
            if (scoped) return scoped.trim();
            var lastId = parseInt(sessionStorage.getItem('coverDesign_lastBookId') || '0', 10);
            if (lastId === bookId) {
                var legacy = sessionStorage.getItem('coverDesign_selectedUrl');
                if (legacy) return legacy.trim();
            }
        } catch (_) {}
        return '';
    }

    function patchBooksCache(bookId, patch) {
        if (!bookId || !patch) return;
        var ix = books.findIndex(function (b) { return b.bookId === bookId; });
        if (ix >= 0) books[ix] = Object.assign({}, books[ix], patch);
        try {
            var cached = JSON.parse(sessionStorage.getItem(booksCacheKey) || 'null');
            if (cached && cached.success && cached.books) {
                var j = cached.books.findIndex(function (b) { return b.bookId === bookId; });
                if (j >= 0) {
                    cached.books[j] = Object.assign({}, cached.books[j], patch);
                    sessionStorage.setItem(booksCacheKey, JSON.stringify(cached));
                }
            }
        } catch (_) {}
    }

    function resolveCoverPathForBook(book) {
        if (!book) return '';
        var path = (book.aiCoverLastPreview || book.coverImagePath || '').trim();
        if (!path) {
            try {
                if (sessionStorage.getItem('coverDesign_hasGenerated') === '1')
                    path = readPersistedCoverUrl(book.bookId);
            } catch (_) {}
        }
        return path;
    }
    /** Last 3 generated / edited cover URLs for quick recall */
    var coverHistory = [];
    var MAX_HISTORY = 3;
    var hasAiCoverThisSession = false;
    var bookPublishingPlatform = '';
    var bookPublishFormat = 'Paperback';

    function normalizePublishFormat(fmt) {
        fmt = (fmt || '').trim();
        if (!fmt) return '';
        if (/^print$/i.test(fmt)) return 'Paperback';
        if (/^e-?books?$/i.test(fmt)) return 'Ebook';
        if (/^paperback$/i.test(fmt)) return 'Paperback';
        if (/^hardcover$/i.test(fmt)) return 'Paperback';
        if (/^both$/i.test(fmt)) return 'Both';
        return fmt;
    }

    function formatSegUiValue(fmt) {
        fmt = normalizePublishFormat(fmt);
        if (fmt === 'Ebook') return 'Ebook';
        return 'Paperback';
    }

    function needsPrintWrapAutoBuild() {
        var fmt = normalizePublishFormat(bookPublishFormat);
        return fmt === 'Paperback'
            || fmt === 'Both'
            || coverType === 'both'
            || coverType === 'paperback'
            || coverType === 'print';
    }

    function syncFormatSegUi() {
        var ui = formatSegUiValue(bookPublishFormat || 'Paperback');
        var seg = document.getElementById('covFormatSeg');
        if (seg) {
            seg.querySelectorAll('.cov-format-seg__btn').forEach(function (btn) {
                var on = (btn.getAttribute('data-format') || '') === ui;
                btn.classList.toggle('is-active', on);
                btn.setAttribute('aria-checked', on ? 'true' : 'false');
            });
        }
        var hint = document.getElementById('covFormatHint');
        if (hint) {
            if (ui === 'Ebook') {
                hint.textContent = 'eBook = front cover only. Safe for Kindle / EPUB export.';
            } else {
                hint.textContent = 'Paperback = full wrap with 0.125" bleed, spine from page count, barcode zone on the back.';
            }
        }
        var intro = document.getElementById('covBackSummaryIntro');
        if (intro) {
            intro.textContent = 'Required for print wraps — printed on the back panel inside the safe area.';
        }
