                '<div style="display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#475569;padding:8px 12px;border-bottom:1px solid #e2e8f0;background:#fafafa;">' +
                '<span style="font-weight:600;max-width:48%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + bookT + '</span>' +
                '<span style="max-width:48%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right;">' + bookA + '</span></div>' +
                '<div style="padding:12px 14px 10px;">' +
                '<h4 style="margin:0 0 10px;font-size:14px;color:' + headColor + ';border-bottom:1px solid #ede9fe;padding-bottom:6px;font-family:' + fontFam + ';">' + heading + '</h4>' +
                '<article style="font-size:' + pt + ';line-height:' + lh + ';color:#334155;font-family:' + fontFam + ';text-align:' + (interior === 'minimalist' ? 'left' : 'justify') + ';">' + body + '</article>' +
                '</div>' +
                '<div style="text-align:center;font-size:10px;color:#64748b;padding:8px;border-top:1px solid #f1f5f9;background:#fafafa;">Section ' + secNum + ' · full page numbers in your PDF footer</div>' +
                '</section>';
        }).join('');
        return '<div style="text-align:left;">' +
            '<p style="margin:0 0 12px;font-size:12px;color:#64748b;">Layout uses your saved formatter settings (style, size, spacing). Each chapter starts on a new section; long chapters flow across pages in the PDF the same way.</p>' +
            '<div style="max-height:min(65vh,560px);overflow:auto;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:12px;padding:12px;">' + parts + '</div>' +
            '</div>';
    }

    function downloadBookPdfFlow() {
        if (!selectedBook) {
            toast('error', 'No book loaded.');
            return;
        }
        if (typeof Swal === 'undefined') {
            toast('error', 'Need SweetAlert2.');
            return;
        }
        Swal.fire({
            title: 'Preparing preview',
            html: '<p style="margin:12px 0;color:#64748b;">Capturing your cover and loading chapters…</p>',
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: function () { Swal.showLoading(); }
        });
        var pCover = captureCoverDataUrl();
        var pData = fetch('/Dashboard/BookPdfPreviewData?bookId=' + encodeURIComponent(selectedBook.bookId)).then(function (r) { return r.json(); });
        Promise.all([pCover, pData]).then(function (tuple) {
            var coverDataUrl = tuple[0];
            var data = tuple[1];
            Swal.close();
            if (!data || !data.success) {
                toast('error', (data && data.message) ? data.message : 'Could not load book.');
                return;
            }
            return Swal.fire({
                title: 'Export complete book',
                html: buildPdfPreviewModalHtml(coverDataUrl, data),
                width: 620,
                showCancelButton: true,
                confirmButtonText: 'Download PDF',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#7c3aed',
                customClass: { popup: 'rounded-2xl shadow-xl', actions: 'gap-3 mt-2' }
            }).then(function (res) {
                if (!res.isConfirmed) return;
                Swal.fire({
                    title: 'Generating PDF',
                    html: '<p style="color:#64748b;margin-top:8px">Rendering in high quality…</p>',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    didOpen: function () { Swal.showLoading(); }
                });
                return captureCoverDataUrl().then(function (cov2) {
                    return fetch('/BookDesign/GetBookFormatting?bookId=' + encodeURIComponent(selectedBook.bookId))
                        .then(function (r) { return r.json(); })
                        .then(function (fmtRes) {
                            var fmtBody = {};
                            if (fmtRes && fmtRes.success && fmtRes.data) {
                                var d = fmtRes.data;
                                if (d.interiorStyle) fmtBody.interiorStyle = d.interiorStyle;
                                if (d.textSize) fmtBody.textSize = d.textSize;
                                if (d.lineSpacing) fmtBody.lineSpacing = d.lineSpacing;
                                if (d.format) fmtBody.bookFormat = d.format;
                                if (d.publishingPlatform) fmtBody.publishingPlatform = d.publishingPlatform;
                            }
                            return fetch('/Dashboard/DownloadBookPdf', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', Accept: 'application/pdf, application/json' },
                                body: JSON.stringify(Object.assign({
                                    bookId: selectedBook.bookId,
                                    coverImageDataUrl: cov2,
                                    displayTitle: (bookTitle.value || '').trim() || (selectedBook.title || ''),
                                    displayAuthor: (authorName.value || '').trim() || (selectedBook.authorName || ''),
                                    displayGenre: (bookCategory.value || '').trim()
                                }, fmtBody))
                            });
                        });
                }).then(function (r) {
                    var ct = (r.headers.get('content-type') || '').toLowerCase();
                    if (!r.ok) {
                        return r.json().then(function (j) { return { ok: false, msg: (j && j.message) ? j.message : 'PDF failed' }; })
                            .catch(function () { return { ok: false, msg: 'PDF failed (HTTP ' + r.status + ')' }; });
                    }
                    if (ct.indexOf('application/pdf') < 0) {
                        return r.text().then(function (t) { return { ok: false, msg: t || 'Server did not return a PDF file.' }; });
                    }
                    return r.blob().then(function (blob) {
                        if (!blob || blob.size < 128) return { ok: false, msg: 'PDF file is empty.' };
                        return blob.arrayBuffer().then(function (ab) {
                            var u8 = new Uint8Array(ab);
                            var hdr = String.fromCharCode(u8[0] || 0, u8[1] || 0, u8[2] || 0, u8[3] || 0);
                            if (hdr !== '%PDF') return { ok: false, msg: 'Download is not a valid PDF. PDF generation may have failed on the server.' };
                            return { ok: true, blob: new Blob([ab], { type: 'application/pdf' }) };
                        });
                    });
                }).then(function (result) {
                    Swal.close();
                    if (!result.ok) {
                        toast('error', result.msg || 'PDF failed');
                        return;
                    }
                    var base = (bookTitle.value || selectedBook.title || 'book').replace(/[^\w\-\s]/g, '').replace(/\s+/g, '-').replace(/^-|-$/g, '') || 'book';
                    var fname = base + '-' + selectedBook.bookId + '.pdf';
                    if (window.navigator && typeof window.navigator.msSaveOrOpenBlob === 'function') {
                        window.navigator.msSaveOrOpenBlob(result.blob, fname);
                    } else {
                        var url = URL.createObjectURL(result.blob);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = fname;
                        document.body.appendChild(a);
                        a.click();
                        setTimeout(function () { a.remove(); URL.revokeObjectURL(url); }, 120000);
                    }
                    Swal.fire({
                        icon: 'success',
                        title: 'Ready',
                        text: 'Your PDF has been downloaded.',
                        showCancelButton: true,
                        confirmButtonText: 'View Chapters',
                        cancelButtonText: 'Done',
                        confirmButtonColor: '#7c3aed'
                    }).then(function(v) {
                        if (!v.isConfirmed) return;
                        fetch('/Dashboard/BookPdfPreviewData?bookId=' + encodeURIComponent(selectedBook.bookId) + '&full=true')
                            .then(function(r) { return r.json(); })
                            .then(function(chData) {
                                if (!chData || !chData.success) {
                                    toast('error', (chData && chData.message) ? chData.message : 'Could not load chapters.');
                                    return;
                                }
                                Swal.fire({
                                    title: 'Chapter-wise View',
                                    html: buildChapterViewerModalHtml(chData),
                                    width: 860,
                                    confirmButtonText: 'Close',
                                    confirmButtonColor: '#7c3aed'
                                });
                            })
                            .catch(function() { toast('error', 'Could not load chapter view.'); });
                    });
                }).catch(function (e) {
                    Swal.close();
                    toast('error', (e && e.message) ? e.message : 'Download failed');
                });
            });
        }).catch(function () {
            Swal.close();
            toast('error', 'Preview failed.');
        });
    }

    if (btnGoToPublish) btnGoToPublish.addEventListener('click', function (e) {
        if (btnGoToPublish.getAttribute('aria-disabled') === 'true') {
            e.preventDefault();
            return;
        }
        e.preventDefault();
        if (!selectedBook || !selectedBook.bookId) {
            toast('error', 'No book loaded. Create or select a book first.');
            return;
        }
        var bid = selectedBook.bookId;
        try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(bid)); } catch (_) {}
        var publishUrl = '/Dashboard/Publish?bookId=' + encodeURIComponent(bid);
        var isPrintFmt = bookPublishFormat === 'Paperback' || bookPublishFormat === 'Both';
        if (coverFlowPrintReady || isPrintReadyPlatform() || isPrintFmt) publishUrl += '&flow=printready';
        window.location.href = publishUrl;
    });

    function boot() {
        if (initialBookId <= 0) {
            try {
                var rememberedId = parseInt(sessionStorage.getItem(FORMATTER_BOOK_KEY) || '0', 10);
                if (rememberedId > 0) initialBookId = rememberedId;
            } catch (_) { /* no-op */ }
        }
        loadBooks();
        if (coverType === 'both') {
            if (btnGoToPublish) btnGoToPublish.innerHTML = '<i data-lucide="rocket" class="w-4 h-4" stroke-width="1.75"></i> Continue to Publish with both files';
        }
        refreshLucide();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
})();
</script>
