    function loadBooks() {
        var cached = null;
        try { cached = JSON.parse(sessionStorage.getItem(booksCacheKey) || 'null'); } catch (_) { cached = null; }
        if (cached && cached.success && cached.books && cached.books.length) renderBooks(cached);
        fetch('/Books/GetUserBooksForCoverDesign')
            .then(function (r) { return r.json(); })
            .then(function (d) {
                try { sessionStorage.setItem(booksCacheKey, JSON.stringify(d)); } catch (_) {}
                renderBooks(d);
            })
            .catch(function () {
                screenLoading.classList.add('hidden');
                if (!cached) {
                    emptyState.classList.remove('hidden');
                    emptyState.textContent = 'Failed to load books. Please refresh.';
                }
            });
    }

    bookSelect.addEventListener('change', function () {
        bindBook(this.value);
        refreshBookFromServer(this.value);
    });
    btnGenerate.addEventListener('click', function () { generateCoverFromDashboard(); });
    var covPrintWrapClose = document.getElementById('covPrintWrapClose');
    if (covPrintWrapClose) covPrintWrapClose.addEventListener('click', function () {
        var m = document.getElementById('covPrintWrapModal');
        if (m) m.classList.add('hidden');
    });
    if (btnRegenerate) btnRegenerate.addEventListener('click', function () {
        console.log('[CoverDesign] Regenerate clicked');
        generateCoverFromDashboard('/Dashboard/RegenerateCover');
    });
    if (btnEditCover) btnEditCover.addEventListener('click', function () {
        console.log('[CoverDesign] Edit cover clicked');
        editCoverWithApi();
    });

    function loadScriptOnce(src, attrVal) {
        return new Promise(function (resolve, reject) {
            var sel = 'script[data-asset="' + attrVal + '"]';
            if (document.querySelector(sel)) { resolve(); return; }
            var s = document.createElement('script');
            s.src = src;
            s.async = true;
            s.setAttribute('data-asset', attrVal);
            s.onload = function () { resolve(); };
            s.onerror = function () { reject(new Error('Could not load ' + src)); };
            document.head.appendChild(s);
        });
    }

    function ensureHtml2Canvas() {
        if (typeof html2canvas !== 'undefined') return Promise.resolve();
        return loadScriptOnce('https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js', 'html2canvas');
    }

    function captureCoverDataUrl() {
        return ensureHtml2Canvas().then(function () {
            if (!covPreviewShell || typeof html2canvas === 'undefined') return null;
            return html2canvas(covPreviewShell, {
                scale: 2,
                useCORS: true,
                allowTaint: true,
                logging: false,
                backgroundColor: null
            }).then(function (canvas) {
                try { return canvas.toDataURL('image/jpeg', 0.92); } catch (e) { return null; }
            });
        });
    }

    function escapeHtmlText(s) {
        if (s === undefined || s === null) return '';
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function buildPdfPreviewModalHtml(coverDataUrl, data) {
        var ch = (data.chapters || []).slice(0, 6);
        var cards = ch.map(function (c) {
            var t = String(c.chapterTitle || '').trim();
            if (t.length > 72) t = t.slice(0, 72) + '…';
            return '<div style="border:1px solid #e2e8f0;border-radius:12px;padding:10px;background:#fafafa;">' +
                '<div style="font-weight:600;font-size:12px;color:#4c1d95;margin-bottom:6px;">Chapter ' + c.displayChapterNumber + (t ? ' · ' + escapeHtmlText(t) : '') + '</div>' +
                '<div style="font-size:11px;line-height:1.45;color:#475569;max-height:120px;overflow:hidden;">' + (c.previewHtml || '') + '</div></div>';
        }).join('');
        var coverImg = coverDataUrl
            ? '<img src="' + coverDataUrl.replace(/"/g, '&quot;') + '" alt="" style="width:100%;max-width:200px;margin:0 auto;display:block;border-radius:16px;box-shadow:0 10px 30px rgba(76,29,149,0.22);aspect-ratio:2/3;object-fit:cover;"/>'
            : '<div style="width:100%;max-width:200px;margin:0 auto;aspect-ratio:2/3;border-radius:16px;background:#5b21b6;"></div>';
        return '<div style="text-align:left;color:#0f172a;">' +
            '<p style="margin:0 0 12px;font-size:13px;color:#64748b;">Your PDF will match this cover (captured live) and include <strong>' + (data.totalChapters || 0) + '</strong> formatted chapters.</p>' +
            '<div style="display:grid;grid-template-columns:minmax(120px,1fr) minmax(0,2fr);gap:14px;max-height:min(52vh,440px);overflow:auto;padding-right:4px;">' +
            '<div style="text-align:center;">' + coverImg + '</div>' +
            '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;align-content:start;">' + cards + '</div>' +
            '</div></div>';
    }

    function buildChapterViewerModalHtml(data) {
        var fmt = (data && data.formatting) ? data.formatting : {};
        var interior = String(fmt.interiorStyle || 'Novel').toLowerCase();
        var pt = fmt.textSize === 'Small' ? '12px' : (fmt.textSize === 'Large' ? '15px' : '13px');
        var lh = fmt.lineSpacing ? String(fmt.lineSpacing) : '1.55';
        var headColor = interior === 'modern' ? '#4f46e5' : (interior === 'minimalist' ? '#0a0a0a' : (interior === 'eleganttrade' ? '#4a3728' : '#4c1d95'));
        var fontFam = (interior === 'modern' || interior === 'minimalist')
            ? 'system-ui,Segoe UI,Roboto,sans-serif'
            : (interior === 'eleganttrade' ? 'Georgia,Palatino Linotype,Palatino,serif' : 'Georgia,Times New Roman,serif');
        var bookT = escapeHtmlText((data && data.bookTitle) || '');
        var bookA = escapeHtmlText((data && data.authorName) || '');
        var chapters = (data && data.chapters) ? data.chapters : [];
        var parts = chapters.map(function (c, idx) {
            var heading = 'Chapter ' + c.displayChapterNumber + (c.chapterTitle ? ': ' + escapeHtmlText(c.chapterTitle) : '');
            var body = c.chapterHtml || c.previewHtml || '<p>No content.</p>';
            var secNum = idx + 1;
            return '<section class="viewer-chapter" style="page-break-before:always;background:#fff;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:14px;overflow:hidden;box-shadow:0 4px 14px -8px rgba(15,23,42,0.2);">' +
                '<div style="display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#475569;padding:8px 12px;border-bottom:1px solid #e2e8f0;background:#fafafa;">' +
                '<span style="font-weight:600;max-width:48%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + bookT + '</span>' +
                '<span style="max-width:48%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right;">' + bookA + '</span></div>' +
                '<div style="padding:12px 14px 10px;">' +
                '<h4 style="margin:0 0 10px;font-size:14px;color:' + headColor + ';border-bottom:1px solid #ede9fe;padding-bottom:6px;font-family:' + fontFam + ';">' + heading + '</h4>' +
                '<article style="font-size:' + pt + ';line-height:' + lh + ';color:#334155;font-family:' + fontFam + ';text-align:' + (interior === 'minimalist' ? 'left' : 'justify') + ';">' + body + '</article>' +
                '</div>' +
                '<div style="text-align:center;font-size:10px;color:#64748b;padding:8px;border-top:1px solid #f1f5f9;background:#fafafa;">Section ' + secNum + ' · full page numbers in your PDF footer</div>' +
                '</section>';
        }).join('');
        return '<div style="text-align:left;">' +
            '<p style="margin:0 0 12px;font-size:12px;color:#64748b;">Layout uses your saved formatter settings (style, size, spacing). Each chapter starts on a new section; long chapters flow across pages in the PDF the same way.</p>' +
            '<div style="max-height:min(65vh,560px);overflow:auto;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:12px;padding:12px;">' + parts + '</div>' +
            '</div>';
    }

    function downloadBookPdfFlow() {
        if (!selectedBook) {
            toast('error', 'No book loaded.');
            return;
        }
        if (typeof Swal === 'undefined') {
            toast('error', 'Need SweetAlert2.');
            return;
        }
        Swal.fire({
            title: 'Preparing preview',
            html: '<p style="margin:12px 0;color:#64748b;">Capturing your cover and loading chapters…</p>',
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: function () { Swal.showLoading(); }
        });
        var pCover = captureCoverDataUrl();
        var pData = fetch('/Dashboard/BookPdfPreviewData?bookId=' + encodeURIComponent(selectedBook.bookId)).then(function (r) { return r.json(); });
        Promise.all([pCover, pData]).then(function (tuple) {
            var coverDataUrl = tuple[0];
            var data = tuple[1];
            Swal.close();
            if (!data || !data.success) {
                toast('error', (data && data.message) ? data.message : 'Could not load book.');
                return;
            }
            return Swal.fire({
                title: 'Export complete book',
                html: buildPdfPreviewModalHtml(coverDataUrl, data),
                width: 620,
                showCancelButton: true,
                confirmButtonText: 'Download PDF',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#7c3aed',
                customClass: { popup: 'rounded-2xl shadow-xl', actions: 'gap-3 mt-2' }
            }).then(function (res) {
                if (!res.isConfirmed) return;
                Swal.fire({
                    title: 'Generating PDF',
                    html: '<p style="color:#64748b;margin-top:8px">Rendering in high quality…</p>',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    didOpen: function () { Swal.showLoading(); }
                });
                return captureCoverDataUrl().then(function (cov2) {
                    return fetch('/BookDesign/GetBookFormatting?bookId=' + encodeURIComponent(selectedBook.bookId))
                        .then(function (r) { return r.json(); })
                        .then(function (fmtRes) {
                            var fmtBody = {};
                            if (fmtRes && fmtRes.success && fmtRes.data) {
                                var d = fmtRes.data;
                                if (d.interiorStyle) fmtBody.interiorStyle = d.interiorStyle;
                                if (d.textSize) fmtBody.textSize = d.textSize;
                                if (d.lineSpacing) fmtBody.lineSpacing = d.lineSpacing;
                                if (d.format) fmtBody.bookFormat = d.format;
                                if (d.publishingPlatform) fmtBody.publishingPlatform = d.publishingPlatform;
                            }
                            return fetch('/Dashboard/DownloadBookPdf', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', Accept: 'application/pdf, application/json' },
                                body: JSON.stringify(Object.assign({
                                    bookId: selectedBook.bookId,
                                    coverImageDataUrl: cov2,
                                    displayTitle: (bookTitle.value || '').trim() || (selectedBook.title || ''),
                                    displayAuthor: (authorName.value || '').trim() || (selectedBook.authorName || ''),
                                    displayGenre: (bookCategory.value || '').trim()
                                }, fmtBody))
                            });
                        });
                }).then(function (r) {
                    var ct = (r.headers.get('content-type') || '').toLowerCase();
                    if (ct.indexOf('application/pdf') >= 0)
                        return r.blob().then(function (blob) { return { ok: true, blob: blob }; });
                    return r.json().then(function (j) { return { ok: false, msg: (j && j.message) ? j.message : 'PDF failed' }; });
                }).then(function (result) {
                    Swal.close();
                    if (!result.ok) {
                        toast('error', result.msg || 'PDF failed');
                        return;
                    }
                    var url = URL.createObjectURL(result.blob);
                    var a = document.createElement('a');
                    a.href = url;
                    var base = (bookTitle.value || selectedBook.title || 'book').replace(/[^\w\-\s]/g, '').replace(/\s+/g, '-').replace(/^-|-$/g, '') || 'book';
                    a.download = base + '-' + selectedBook.bookId + '.pdf';
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    URL.revokeObjectURL(url);
                    Swal.fire({
                        icon: 'success',
                        title: 'Ready',
                        text: 'Your PDF has been downloaded.',
                        showCancelButton: true,
                        confirmButtonText: 'View Chapters',
                        cancelButtonText: 'Done',
                        confirmButtonColor: '#7c3aed'
                    }).then(function(v) {
                        if (!v.isConfirmed) return;
                        fetch('/Dashboard/BookPdfPreviewData?bookId=' + encodeURIComponent(selectedBook.bookId) + '&full=true')
                            .then(function(r) { return r.json(); })
                            .then(function(chData) {
                                if (!chData || !chData.success) {
                                    toast('error', (chData && chData.message) ? chData.message : 'Could not load chapters.');
                                    return;
                                }
                                Swal.fire({
                                    title: 'Chapter-wise View',
                                    html: buildChapterViewerModalHtml(chData),
                                    width: 860,
                                    confirmButtonText: 'Close',
                                    confirmButtonColor: '#7c3aed'
                                });
                            })
                            .catch(function() { toast('error', 'Could not load chapter view.'); });
                    });
                }).catch(function (e) {
                    Swal.close();
                    toast('error', (e && e.message) ? e.message : 'Download failed');
                });
            });
        }).catch(function () {
            Swal.close();
            toast('error', 'Preview failed.');
        });
    }

    if (btnGoToPublish) btnGoToPublish.addEventListener('click', function (e) {
        e.preventDefault();
        if (!selectedBook || !selectedBook.bookId) {
            toast('error', 'No book loaded. Create or select a book first.');
            return;
        }
        var bid = selectedBook.bookId;
        try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(bid)); } catch (_) {}
        window.location.href = '/Dashboard/Publish?bookId=' + encodeURIComponent(bid);
    });

    function boot() {
        if (initialBookId <= 0) {
            var s = 0;
            try { s = parseInt(sessionStorage.getItem(FORMATTER_BOOK_KEY) || '0', 10); } catch (_) { s = 0; }
            if (s > 0) {
                window.location.replace('/Dashboard/CoverDesign?bookId=' + s);
                return;
            }
        }
        loadBooks();
        refreshLucide();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
})();
</script>
