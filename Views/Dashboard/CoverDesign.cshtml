        var p = String(path || '').toLowerCase();
        return p.indexOf('printreadycoverwrap') >= 0
            || p.indexOf('coverwrap') >= 0
            || p.indexOf('spine-book-cover') >= 0
            || p.indexOf('generate-spine-book-cover') >= 0;
