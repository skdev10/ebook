    function toUrl(path) {
        if (!path) return '';
        // Strip BOM / replacement chars that produce 404s like /%EF%BF%BD
        path = String(path).replace(/^[\uFEFF\uFFFD]+|[\uFEFF\uFFFD]+$/g, '').trim();
        if (!path || path === '\uFFFD') return '';
        if (path.indexOf('http') === 0 || path.indexOf('data:') === 0) return path;
        return path.indexOf('/') === 0 ? path : '/' + path;
    }

