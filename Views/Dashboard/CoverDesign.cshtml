        if (btnDel) {
            btnDel.addEventListener('click', function () {
                var id = activeCoverId || (sel && parseInt(sel.value, 10)) || 0;
                if (!id) return;
                if (!window.confirm('Remove this cover project? (You can keep at least one.)')) return;
