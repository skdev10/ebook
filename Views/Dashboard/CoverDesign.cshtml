        }
        if (btnDup) {
            btnDup.addEventListener('click', function () {
                var id = activeCoverId || (sel && parseInt(sel.value, 10)) || 0;
                if (!id) { toast('info', 'Select a cover to duplicate.'); return; }
                postCoverProject('/Dashboard/DuplicateCoverDesign', { coverId: id }).then(function (d) {
                    if (!(d && d.success)) {
                        toast('error', (d && d.message) || 'Could not duplicate.');
                        return;
