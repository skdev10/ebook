    /** Merge latest DB + Settings for one book; keeps form author if API has no display name. */
    function refreshBookFromServer(bookId) {
        var id = parseInt(bookId, 10);
        if (!id) return Promise.resolve();
        return fetch('/Books/GetBookForCoverDesign?bookId=' + encodeURIComponent(id))
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success || !d.book) return;
                var b = d.book;
                var ix = books.findIndex(function (x) { return x.bookId === b.bookId; });
                if (ix >= 0) books[ix] = Object.assign({}, books[ix], b);
                if (!selectedBook || selectedBook.bookId !== b.bookId) return;
                selectedBook = Object.assign({}, selectedBook, b);
                bookTitle.value = (b.title != null) ? b.title : bookTitle.value;
                var srvAuthor = (b.authorName || '').trim();
                if (srvAuthor) authorName.value = srvAuthor;
                setGenreFromApi((b.genre || '').trim());
                var dir = (b.aiCoverPrompt || '').trim();
                if (dir) imageDirection.value = dir;
                fetch('/BookDesign/GetBookFormatting?bookId=' + encodeURIComponent(b.bookId))
                    .then(function (r) { return r.json(); })
                    .then(function (fd) {
                        if (fd && fd.success && fd.data) {
                            bookPublishingPlatform = (fd.data.publishingPlatform || fd.data.publishingPlatforms || '').trim();
                        }
                    })
                    .catch(function () {});
                var path = (b.aiCoverLastPreview || b.coverImagePath || '').trim();
                if (path) {
                    selectedPath = path;
                    setCoverImageVisible(toUrl(path));
                    if (coverHistory.indexOf(path) < 0) pushCoverHistory(path);
                }
                applyCoverStyleClass();
                syncCoverStyleCards();
                updateLivePreview();
            })
            .catch(function () { /* offline / error: keep cached form */ });
    }

