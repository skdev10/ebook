    async function createFrontPanelDataUrlFromWrap(pathOrUrl) {
        var src = toUrl(pathOrUrl);
        if (!src) return '';
        var img = await loadImage(src);
        if (!img || !img.naturalWidth || !img.naturalHeight) return src;
        var ratio = img.naturalWidth / img.naturalHeight;
        if (ratio < 1.2) return src;
        var panelWidth = Math.max(24, Math.round(img.naturalWidth * 0.48));
        var sx = Math.max(0, img.naturalWidth - panelWidth);
        var canvas = document.createElement('canvas');
        canvas.width = panelWidth;
        canvas.height = img.naturalHeight;
        var ctx = canvas.getContext('2d');
        if (!ctx) return src;
        ctx.drawImage(img, sx, 0, panelWidth, img.naturalHeight, 0, 0, panelWidth, img.naturalHeight);
        return canvas.toDataURL('image/png');
    }

    async function applyBestFrontPreview(path) {
        if (!path) return '';
        var resolved = toUrl(path);
        if (!resolved) return '';
        try {
            if (isLikelyWrapCoverPath(path)) {
                resolved = await createFrontPanelDataUrlFromWrap(path);
            } else {
                var probe = await loadImage(resolved);
                if (probe && probe.naturalWidth > 0 && probe.naturalHeight > 0) {
                    var ratio = probe.naturalWidth / probe.naturalHeight;
                    if (ratio >= 1.2) resolved = await createFrontPanelDataUrlFromWrap(resolved);
                }
            }
        } catch (_) {
            resolved = toUrl(path);
        }
        selectedPath = resolved;
        setCoverImageVisible(resolved);
        if (selectedBook && selectedBook.bookId) persistCoverSelection(selectedBook.bookId, selectedPath);
        return resolved;
    }

    function applyFrontOnlyPreview(frontUrl) {
        if (!frontUrl) return;
        applyBestFrontPreview(frontUrl).catch(function () {});
