    }

    function isEbookCoverMode() {
        return formatSegUiValue(bookPublishFormat || 'Paperback') === 'Ebook';
    }

    function generatePrimaryLabel() {
        return isEbookCoverMode() ? 'Generate Front Cover' : 'Generate Full Cover';
    }

    function regeneratePrimaryLabel() {
