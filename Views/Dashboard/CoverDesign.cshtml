    function syncPrintWrapUiVisibility() {
        var show = needsPrintWrapAutoBuild();
        var banner = document.getElementById('covWrapBuildBanner');
        var section = document.getElementById('covFullWrapSection');
        var tabs = document.getElementById('covWrapViewTabs');
        var col = document.getElementById('covPreviewColumn');
