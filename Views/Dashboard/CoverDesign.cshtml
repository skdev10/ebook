    function loadScriptOnce(src, attrVal) {
        return new Promise(function (resolve, reject) {
            var sel = 'script[data-asset="' + attrVal + '"]';
            if (document.querySelector(sel)) { resolve(); return; }
            var s = document.createElement('script');
            s.src = src;
            s.async = true;
            s.setAttribute('data-asset', attrVal);
            s.onload = function () { resolve(); };
            s.onerror = function () { reject(new Error('Could not load ' + src)); };
            document.head.appendChild(s);
        });
    }

    function ensureHtml2Canvas() {
        if (typeof html2canvas !== 'undefined') return Promise.resolve();
        return loadScriptOnce('https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js', 'html2canvas');
    }

    function captureCoverDataUrl() {
        return ensureHtml2Canvas().then(function () {
            if (!covPreviewShell || typeof html2canvas === 'undefined') return null;
            return html2canvas(covPreviewShell, {
                scale: 2,
                useCORS: true,
                allowTaint: true,
                logging: false,
                backgroundColor: null
            }).then(function (canvas) {
                try { return canvas.toDataURL('image/jpeg', 0.92); } catch (e) { return null; }
            });
        });
    }

    function escapeHtmlText(s) {
        if (s === undefined || s === null) return '';
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function buildPdfPreviewModalHtml(coverDataUrl, data) {
        var ch = (data.chapters || []).slice(0, 6);
        var cards = ch.map(function (c) {
            var heading = c.chapterDisplayHeading || ('Section ' + (c.displayChapterNumber || ''));
            var t = String(c.chapterTitle || '').trim();
            if (t.length > 72) t = t.slice(0, 72) + '…';
            return '<div style="border:1px solid #e2e8f0;border-radius:12px;padding:10px;background:#fafafa;">' +
                '<div style="font-weight:600;font-size:12px;color:#4c1d95;margin-bottom:6px;">' + escapeHtmlText(heading) + (t && heading.indexOf(t) < 0 ? ' · ' + escapeHtmlText(t) : '') + '</div>' +
                '<div style="font-size:11px;line-height:1.45;color:#475569;max-height:120px;overflow:hidden;">' + (c.previewHtml || '') + '</div></div>';
        }).join('');
        var coverImg = coverDataUrl
            ? '<img src="' + coverDataUrl.replace(/"/g, '&quot;') + '" alt="" style="width:100%;max-width:200px;margin:0 auto;display:block;border-radius:16px;box-shadow:0 10px 30px rgba(76,29,149,0.22);aspect-ratio:2/3;object-fit:cover;"/>'
            : '<div style="width:100%;max-width:200px;margin:0 auto;aspect-ratio:2/3;border-radius:16px;background:#475569;"></div>';
        return '<div style="text-align:left;color:#0f172a;">' +
            '<p style="margin:0 0 12px;font-size:13px;color:#64748b;">Your PDF will match this cover (captured live) and include <strong>' + (data.totalChapters || 0) + '</strong> formatted chapters.</p>' +
            '<div style="display:grid;grid-template-columns:minmax(120px,1fr) minmax(0,2fr);gap:14px;max-height:min(52vh,440px);overflow:auto;padding-right:4px;">' +
            '<div style="text-align:center;">' + coverImg + '</div>' +
            '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;align-content:start;">' + cards + '</div>' +
            '</div></div>';
    }

    function buildChapterViewerModalHtml(data) {
        var fmt = (data && data.formatting) ? data.formatting : {};
        var interior = String(fmt.interiorStyle || 'Novel').toLowerCase();
        var pt = fmt.textSize === 'Small' ? '12px' : (fmt.textSize === 'Large' ? '15px' : '13px');
        var lh = fmt.lineSpacing ? String(fmt.lineSpacing) : '1.55';
        var headColor = interior === 'modern' ? '#4f46e5' : (interior === 'minimalist' ? '#0a0a0a' : (interior === 'eleganttrade' ? '#4a3728' : '#4c1d95'));
        var fontFam = (interior === 'modern' || interior === 'minimalist')
            ? 'system-ui,Segoe UI,Roboto,sans-serif'
            : (interior === 'eleganttrade' ? 'Georgia,Palatino Linotype,Palatino,serif' : 'Georgia,Times New Roman,serif');
        var bookT = escapeHtmlText((data && data.bookTitle) || '');
        var bookA = escapeHtmlText((data && data.authorName) || '');
        var chapters = (data && data.chapters) ? data.chapters : [];
        var parts = chapters.map(function (c, idx) {
            var heading = c.chapterDisplayHeading || ('Section ' + (c.displayChapterNumber || (idx + 1)));
            if (c.chapterTitle && heading.indexOf(c.chapterTitle) < 0 && heading.indexOf('Chapter 0') < 0) {
                heading = heading + (c.chapterTitle ? ': ' + escapeHtmlText(c.chapterTitle) : '');
            }
            var body = c.chapterHtml || c.previewHtml || '<p>No content.</p>';
            var secNum = idx + 1;
            return '<section class="viewer-chapter" style="page-break-before:always;background:#fff;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:14px;overflow:hidden;box-shadow:0 4px 14px -8px rgba(15,23,42,0.2);">' +
                '<div style="display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#475569;padding:8px 12px;border-bottom:1px solid #e2e8f0;background:#fafafa;">' +
                '<span style="font-weight:600;max-width:48%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + bookT + '</span>' +
                '<span style="max-width:48%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right;">' + bookA + '</span></div>' +
                '<div style="padding:12px 14px 10px;">' +
                '<h4 style="margin:0 0 10px;font-size:14px;color:' + headColor + ';border-bottom:1px solid #ede9fe;padding-bottom:6px;font-family:' + fontFam + ';">' + heading + '</h4>' +
                '<article style="font-size:' + pt + ';line-height:' + lh + ';color:#334155;font-family:' + fontFam + ';text-align:' + (interior === 'minimalist' ? 'left' : 'justify') + ';">' + body + '</article>' +
                '</div>' +
                '<div style="text-align:center;font-size:10px;color:#64748b;padding:8px;border-top:1px solid #f1f5f9;background:#fafafa;">Section ' + secNum + ' · full page numbers in your PDF footer</div>' +
                '</section>';
        }).join('');
        return '<div style="text-align:left;">' +
            '<p style="margin:0 0 12px;font-size:12px;color:#64748b;">Layout uses your saved formatter settings (style, size, spacing). Each chapter starts on a new section; long chapters flow across pages in the PDF the same way.</p>' +
            '<div style="max-height:min(65vh,560px);overflow:auto;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:12px;padding:12px;">' + parts + '</div>' +
            '</div>';
    }

    function downloadBookPdfFlow() {
        if (!selectedBook) {
            toast('error', 'No book loaded.');
            return;
        }
        if (typeof Swal === 'undefined') {
            toast('error', 'Need SweetAlert2.');
            return;
        }
        Swal.fire({
            title: 'Preparing preview',
            html: '<p style="margin:12px 0;color:#64748b;">Capturing your cover and loading chapters…</p>',
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: function () { Swal.showLoading(); }
        });
        var pCover = captureCoverDataUrl();
        var pData = fetch('/Dashboard/BookPdfPreviewData?bookId=' + encodeURIComponent(selectedBook.bookId)).then(function (r) { return r.json(); });
        Promise.all([pCover, pData]).then(function (tuple) {
            var coverDataUrl = tuple[0];
            var data = tuple[1];
            Swal.close();
            if (!data || !data.success) {
                toast('error', (data && data.message) ? data.message : 'Could not load book.');
                return;
            }
            return Swal.fire({
                title: 'Export complete book',
                html: buildPdfPreviewModalHtml(coverDataUrl, data),
                width: 620,
                showCancelButton: true,
                confirmButtonText: 'Download PDF',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#7c3aed',
                customClass: { popup: 'rounded-2xl shadow-xl', actions: 'gap-3 mt-2' }
            }).then(function (res) {
                if (!res.isConfirmed) return;
                Swal.fire({
                    title: 'Generating PDF',
                    html: '<p style="color:#64748b;margin-top:8px">Rendering in high quality…</p>',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    didOpen: function () { Swal.showLoading(); }
                });
                return captureCoverDataUrl().then(function (cov2) {
                    return fetch('/BookDesign/GetBookFormatting?bookId=' + encodeURIComponent(selectedBook.bookId))
                        .then(function (r) { return r.json(); })
                        .then(function (fmtRes) {
                            var fmtBody = {};
                            if (fmtRes && fmtRes.success && fmtRes.data) {
                                var d = fmtRes.data;
                                if (d.interiorStyle) fmtBody.interiorStyle = d.interiorStyle;
                                if (d.textSize) fmtBody.textSize = d.textSize;
                                if (d.lineSpacing) fmtBody.lineSpacing = d.lineSpacing;
                                if (d.format) fmtBody.bookFormat = d.format;
                                if (d.publishingPlatform) fmtBody.publishingPlatform = d.publishingPlatform;
                            }
                            return fetch('/Dashboard/DownloadBookPdf', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', Accept: 'application/pdf, application/json' },
                                body: JSON.stringify(Object.assign({
                                    bookId: selectedBook.bookId,
                                    coverImageDataUrl: cov2,
                                    displayTitle: (bookTitle.value || '').trim() || (selectedBook.title || ''),
                                    displayAuthor: (authorName.value || '').trim() || (selectedBook.authorName || ''),
                                    displayGenre: (bookCategory.value || '').trim()
                                }, fmtBody))
                            });
                        });
                }).then(function (r) {
                    var ct = (r.headers.get('content-type') || '').toLowerCase();
                    if (!r.ok) {
                        return r.json().then(function (j) { return { ok: false, msg: (j && j.message) ? j.message : 'PDF failed' }; })
                            .catch(function () { return { ok: false, msg: 'PDF failed (HTTP ' + r.status + ')' }; });
                    }
                    if (ct.indexOf('application/pdf') < 0) {
                        return r.text().then(function (t) { return { ok: false, msg: t || 'Server did not return a PDF file.' }; });
                    }
                    return r.blob().then(function (blob) {
                        if (!blob || blob.size < 128) return { ok: false, msg: 'PDF file is empty.' };
                        return blob.arrayBuffer().then(function (ab) {
                            var u8 = new Uint8Array(ab);
                            var hdr = String.fromCharCode(u8[0] || 0, u8[1] || 0, u8[2] || 0, u8[3] || 0);
                            if (hdr !== '%PDF') return { ok: false, msg: 'Download is not a valid PDF. PDF generation may have failed on the server.' };
                            return { ok: true, blob: new Blob([ab], { type: 'application/pdf' }) };
                        });
                    });
                }).then(function (result) {
                    Swal.close();
                    if (!result.ok) {
                        toast('error', result.msg || 'PDF failed');
                        return;
                    }
                    var base = (bookTitle.value || selectedBook.title || 'book').replace(/[^\w\-\s]/g, '').replace(/\s+/g, '-').replace(/^-|-$/g, '') || 'book';
                    var fname = base + '-' + selectedBook.bookId + '.pdf';
                    if (window.navigator && typeof window.navigator.msSaveOrOpenBlob === 'function') {
                        window.navigator.msSaveOrOpenBlob(result.blob, fname);
                    } else {
                        var url = URL.createObjectURL(result.blob);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = fname;
                        document.body.appendChild(a);
                        a.click();
                        setTimeout(function () { a.remove(); URL.revokeObjectURL(url); }, 120000);
                    }
                    Swal.fire({
                        icon: 'success',
                        title: 'Ready',
                        text: 'Your PDF has been downloaded.',
                        showCancelButton: true,
                        confirmButtonText: 'View Chapters',
                        cancelButtonText: 'Done',
                        confirmButtonColor: '#7c3aed'
                    }).then(function(v) {
                        if (!v.isConfirmed) return;
                        fetch('/Dashboard/BookPdfPreviewData?bookId=' + encodeURIComponent(selectedBook.bookId) + '&full=true')
                            .then(function(r) { return r.json(); })
                            .then(function(chData) {
                                if (!chData || !chData.success) {
                                    toast('error', (chData && chData.message) ? chData.message : 'Could not load chapters.');
                                    return;
                                }
                                Swal.fire({
                                    title: 'Chapter-wise View',
                                    html: buildChapterViewerModalHtml(chData),
                                    width: 860,
                                    confirmButtonText: 'Close',
                                    confirmButtonColor: '#7c3aed'
                                });
                            })
                            .catch(function() { toast('error', 'Could not load chapter view.'); });
                    });
                }).catch(function (e) {
                    Swal.close();
                    toast('error', (e && e.message) ? e.message : 'Download failed');
                });
            });
        }).catch(function () {
            Swal.close();
            toast('error', 'Preview failed.');
        });
    }

    if (btnGoToPublish) btnGoToPublish.addEventListener('click', function (e) {
        if (btnGoToPublish.getAttribute('aria-disabled') === 'true') {
            e.preventDefault();
            if (btnGoToPublish.getAttribute('data-busy') !== 'true') {
                if (needsPrintWrapAutoBuild() && frontCoverIsReady() && !fullWrapIsReady()) {
                    toast('info', 'Full wrap is still building. Continue to Publish unlocks when the full cover is ready for export.');
                } else {
                    toast('info', 'Generate a cover first, then continue to Publish.');
                }
            }
            return;
        }
        e.preventDefault();
        if (!selectedBook || !selectedBook.bookId) {
            toast('error', 'No book loaded. Create or select a book first.');
            return;
        }
        var bid = selectedBook.bookId;
        try { sessionStorage.setItem(FORMATTER_BOOK_KEY, String(bid)); } catch (_) {}
        var publishUrl = '/Dashboard/Publish?bookId=' + encodeURIComponent(bid);
        if (bookPublishFormat === 'Paperback' || bookPublishFormat === 'Hardcover' || bookPublishFormat === 'Both') publishUrl += '&flow=printready';
        if (window.EbookGuidedFlow && typeof window.EbookGuidedFlow.appendGuided === 'function') {
            publishUrl = window.EbookGuidedFlow.appendGuided(publishUrl);
        } else {
            publishUrl += '&guided=1';
        }
        window.location.href = publishUrl;
    });

    (function initCoverDownload() {
        document.querySelectorAll('.cov-download-btn').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                var bid = selectedBook && selectedBook.bookId ? selectedBook.bookId : initialBookId;
                if (!bid || bid <= 0) {
                    toast('error', 'No book loaded.');
                    return;
                }
                var part = btn.getAttribute('data-part') || 'front';
                var format = btn.getAttribute('data-format') || 'png';
                if (part === 'wrap' && !fullWrapIsReady()) {
                    toast('error', 'Full wrap is not ready yet. Wait for wrap generation, or download front PNG.');
                    return;
                }
                if (part === 'front' && !frontCoverIsReady() && !fullWrapIsReady()) {
                    toast('error', 'Generate a cover first.');
                    return;
                }
                btn.disabled = true;
                try {
                    if (!window.ModuleExport || typeof window.ModuleExport.getExport !== 'function') {
                        toast('error', 'Download helper failed to load. Refresh the page.');
                        return;
                    }
                    var url = '/Dashboard/DownloadPrintReadyCoverAsset?bookId=' + encodeURIComponent(bid)
                        + '&part=' + encodeURIComponent(part)
                        + '&format=' + encodeURIComponent(format);
                    var ext = format === 'pdf' ? 'pdf' : 'png';
                    var result = await window.ModuleExport.getExport(url, 'cover-' + bid + '-' + part + '.' + ext);
                    if (!result.ok) toast('error', result.message || 'Download failed');
                    else toast('success', part === 'wrap' ? 'Full wrap PDF download started' : 'Front cover PNG download started');
                } catch (err) {
                    toast('error', 'Download failed');
                } finally {
                    updatePublishGate();
                }
            });
        });

        var epubBtn = document.getElementById('btnDownloadEbookBundle');
        if (epubBtn) {
            epubBtn.addEventListener('click', async function () {
                var bid = selectedBook && selectedBook.bookId ? selectedBook.bookId : 0;
                if (!bid) {
                    toast('info', 'Select a manuscript first.');
                    return;
                }
                if (!frontCoverIsReady()) {
                    toast('info', 'Generate the front cover first.');
                    return;
                }
                epubBtn.disabled = true;
                var prevHtml = epubBtn.innerHTML;
                epubBtn.innerHTML = '<span class="inline-flex items-center gap-2"><span class="w-4 h-4 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin"></span> Building EPUB…</span>';
                try {
                    var r = await fetch('/Books/ExportEpub', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/epub+zip, application/json' },
                        body: JSON.stringify({
                            bookId: bid,
                            coverImageDataUrl: selectedPath || null,
                            displayTitle: (bookTitle && bookTitle.value || '').trim() || (selectedBook.title || ''),
                            displayAuthor: (authorName && authorName.value || '').trim() || (selectedBook.authorName || '')
                        })
                    });
                    var ct = (r.headers.get('content-type') || '').toLowerCase();
                    if (!r.ok || ct.indexOf('json') >= 0) {
                        var errBody = {};
                        try { errBody = await r.json(); } catch (_) {}
                        toast('error', (errBody && errBody.message) || 'EPUB export failed. Make sure the manuscript has chapters.');
                        return;
                    }
                    var blob = await r.blob();
                    if (!blob || blob.size < 64) {
                        toast('error', 'EPUB file was empty.');
                        return;
                    }
                    var base = ((bookTitle && bookTitle.value) || selectedBook.title || 'book')
                        .replace(/[^\w\-\s]/g, '').replace(/\s+/g, '-').replace(/^-|-$/g, '') || 'book';
                    var fname = base + '-' + bid + '-ebook.epub';
                    var a = document.createElement('a');
                    a.href = URL.createObjectURL(blob);
                    a.download = fname;
                    document.body.appendChild(a);
                    a.click();
                    setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 1500);
                    toast('success', 'EPUB downloaded — front cover + manuscript.');
                } catch (err) {
                    toast('error', 'EPUB export failed.');
                } finally {
                    epubBtn.innerHTML = prevHtml;
                    refreshLucide();
                    updatePublishGate();
                }
            });
        }
    })();

    function getBackCoverSummaryText() {
        if (backCoverSummary && backCoverSummary.value.trim()) return backCoverSummary.value.trim();
        if (selectedBook && selectedBook.description) return String(selectedBook.description).trim();
        return '';
    }

    function updateBackCoverSummaryWarn() {
        if (!backCoverSummaryWarn) return;
        var len = getBackCoverSummaryText().length;
        backCoverSummaryWarn.classList.toggle('hidden', len <= 1200);
    }

    var saveBackSummaryTimer = null;
    function scheduleSaveBackCoverSummary() {
        updateBackCoverSummaryWarn();
        clearTimeout(saveBackSummaryTimer);
        saveBackSummaryTimer = setTimeout(persistBackCoverSummary, 700);
    }

    async function persistBackCoverSummary() {
        if (!selectedBook || !selectedBook.bookId) return;
        var text = getBackCoverSummaryText();
        selectedBook.description = text;
        try {
            var r = await fetch('/Books/SaveBackCoverSummary', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ bookId: selectedBook.bookId, backSummary: text })
            });
            var d = await r.json().catch(function () { return {}; });
            if (d && d.tooLong && backCoverSummaryWarn) backCoverSummaryWarn.classList.remove('hidden');
            var hint = document.getElementById('backCoverSummaryHint');
            if (hint && d && d.success) hint.textContent = 'Saved · used on back panel of print wrap export.';
        } catch (_) { /* non-blocking */ }
    }

    (function bindBackCoverSummary() {
        if (!backCoverSummary) return;
        backCoverSummary.addEventListener('input', function () {
            scheduleSaveBackCoverSummary();
            updateGenerateGate();
            if (window.EbookUnsavedGuard) window.EbookUnsavedGuard.setDirty();
        });
        backCoverSummary.addEventListener('change', persistBackCoverSummary);
    })();

    if (imageDirection) {
        imageDirection.addEventListener('input', function () {
            updateGenerateGate();
            if (window.EbookUnsavedGuard) window.EbookUnsavedGuard.setDirty();
        });
    }
    [bookTitle, authorName, bookCategory].forEach(function (el) {
        if (!el) return;
        el.addEventListener('input', function () {
            if (window.EbookUnsavedGuard) window.EbookUnsavedGuard.setDirty();
            updateLivePreview();
            updateGenerateGate();
        });
        el.addEventListener('change', function () {
            if (window.EbookUnsavedGuard) window.EbookUnsavedGuard.setDirty();
            updateLivePreview();
            updateGenerateGate();
        });
    });
    if (window.EbookUnsavedGuard) {
        window.EbookUnsavedGuard.setContext('Book Cover');
        window.EbookUnsavedGuard.markSaved();
        window.EbookUnsavedGuard.setPendingSaveHandler(function () {
            return new Promise(function (resolve) {
                try {
                    persistCoverDraftLocal();
                    // If a book is attached and a cover path exists, keep session export selection warm.
                    if (selectedBook && selectedBook.bookId && selectedPath) {
                        persistCoverSelection(selectedBook.bookId, selectedPath);
                        setServerActiveCover(selectedBook.bookId, selectedPath).finally(function () {
                            resolve(true);
                        });
                        return;
                    }
                    resolve(true);
                } catch (e) {
                    resolve(false);
                }
            });
        });
    }

    var COVER_DRAFT_KEY = 'coverDesign_softDraft_v1';
    function persistCoverDraftLocal() {
        try {
            var payload = {
                title: (bookTitle && bookTitle.value) || '',
                author: (authorName && authorName.value) || '',
                genre: (bookCategory && bookCategory.value) || '',
                style: (coverStyle && coverStyle.value) || 'modern',
                direction: (imageDirection && imageDirection.value) || '',
                summary: (backCoverSummary && backCoverSummary.value) || '',
                bookId: (selectedBook && selectedBook.bookId) || 0,
                savedAt: Date.now()
            };
            localStorage.setItem(COVER_DRAFT_KEY, JSON.stringify(payload));
        } catch (_) { /* ignore quota */ }
    }
    function restoreCoverDraftLocal() {
        try {
            var raw = localStorage.getItem(COVER_DRAFT_KEY);
            if (!raw) return;
            var d = JSON.parse(raw);
            if (!d || typeof d !== 'object') return;
            if (bookTitle && !(bookTitle.value || '').trim() && d.title) bookTitle.value = d.title;
            if (authorName && !(authorName.value || '').trim() && d.author) authorName.value = d.author;
            if (bookCategory && d.genre) {
                try { setGenreFromApi(d.genre); } catch (_) { bookCategory.value = d.genre; }
            }
            if (coverStyle && d.style) coverStyle.value = d.style;
            if (imageDirection && !(imageDirection.value || '').trim() && d.direction) imageDirection.value = d.direction;
            if (backCoverSummary && !(backCoverSummary.value || '').trim() && d.summary) backCoverSummary.value = d.summary;
        } catch (_) { /* ignore */ }
    }

    function boot() {
        // Soft mid-entry: do NOT auto-attach a remembered book when URL has no bookId.
        loadBooks();
        syncFormatSegUi();
        updatePublishGate();
        updateGenerateGate();
        syncPrintWrapUiVisibility();
        syncGenerateButtonLabels();
        if (coverType === 'both') {
            if (btnGoToPublish) btnGoToPublish.innerHTML = '<i data-lucide="rocket" class="w-4 h-4" stroke-width="1.75"></i> Continue to Publish with both files';
        }
        refreshLucide();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
})();
</script>
