@{
    ViewData["Title"] = "Publish";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var bookId = ViewBag.SelectedBookId as int? ?? 0;
    var pbTitle = ViewBag.PublishBookTitle as string ?? "";
    var pbDesc = ViewBag.PublishBookDescription as string ?? "";
    var pbGenre = ViewBag.PublishBookGenre as string ?? "";
    var pbCover = ViewBag.PublishBookCover as string ?? "";
    var pbStatus = ViewBag.PublishBookStatus as string ?? "";
    var alreadyListed = ViewBag.PublishBookAlreadyListed as bool? ?? false;
    var publishableKey = ViewBag.PublishableKey as string ?? "";

    string CoverUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || path.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
            return path;
        return path.StartsWith("/") ? path : "/" + path;
    }

    var pbCoverWrap = ViewBag.PublishBookCoverWrap as string ?? "";
    var hasSavedFrontCover = ViewBag.PublishHasFrontCover as bool? ?? (bookId > 0 && !string.IsNullOrEmpty(pbCover));
    var hasSavedCoverWrap = bookId > 0 && !string.IsNullOrEmpty(pbCoverWrap);

    var pbChapterCount = ViewBag.PublishBookChapterCount is int pcc ? pcc : 0;
    var pbEstimatedPages = ViewBag.PublishBookEstimatedPages is int pep ? pep : 0;
    var pbWordCount = ViewBag.PublishBookWordCount is int pwc ? pwc : 0;
    var publishReady = ViewBag.PublishBookReady as bool? ?? false;
    var canExport = ViewBag.PublishCanExport as bool? ?? (pbChapterCount > 0);
    var publishStateText = canExport
        ? (publishReady && (ViewBag.PublishBookStatus as string ?? "").Equals("Finalized", StringComparison.OrdinalIgnoreCase) ? "Finalized — ready to export" : "Ready to export")
        : (bookId > 0 ? "Add chapters in AI Writer" : "No book selected");
    var isPrintReadyFlow = ViewBag.PublishPrintReadyMode as bool? ?? false;
    var publishBookFormat = (ViewBag.PublishBookFormat as string ?? "Ebook").Trim();
    if (!publishBookFormat.Equals("Ebook", StringComparison.OrdinalIgnoreCase)
        && !publishBookFormat.Equals("Paperback", StringComparison.OrdinalIgnoreCase)
        && !publishBookFormat.Equals("Both", StringComparison.OrdinalIgnoreCase))
    {
        publishBookFormat = "Ebook";
    }
    var isBothFormat = publishBookFormat.Equals("Both", StringComparison.OrdinalIgnoreCase);
    var showPrintExports = isPrintReadyFlow || isBothFormat;
    var showEbookExports = isBothFormat || (!isPrintReadyFlow && publishBookFormat.Equals("Ebook", StringComparison.OrdinalIgnoreCase));
    var displayCoverUrl = CoverUrl(isPrintReadyFlow && hasSavedCoverWrap ? pbCoverWrap : pbCover);
    var displayCoverIsWrap = isPrintReadyFlow && hasSavedCoverWrap;
}

