    .pr-primary-action {
        background: linear-gradient(135deg, #5b21b6 0%, #7c3aed 55%, #8b5cf6 100%);
        color: #fff;
        border: 1px solid #6d28d9;
        box-shadow: 0 14px 28px -18px rgba(91, 33, 182, 0.9);
    }
    .pr-primary-action:hover {
        transform: translateY(-1px);
        box-shadow: 0 18px 32px -20px rgba(91, 33, 182, 0.95);
    }
