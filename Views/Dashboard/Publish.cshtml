    .kdp-reference-card {
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        padding: 0.85rem;
        background: #ffffff;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }
    .kdp-template {
        position: relative;
        min-height: 320px;
        border-radius: 0.85rem;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        overflow: hidden;
    }
    .kdp-template::before,
    .kdp-template::after {
        content: "";
        position: absolute;
        inset: 10px;
        border: 1px dashed #cbd5e1;
        border-radius: 0.65rem;
    }
    .kdp-template::after {
        inset: 22px;
        border-color: #94a3b8;
    }
    .kdp-spine-zone {
        position: absolute;
        top: 18px;
        bottom: 18px;
        left: 50%;
        width: 44px;
        transform: translateX(-50%);
        border-left: 2px solid #94a3b8;
        border-right: 2px solid #94a3b8;
        background: rgba(148, 163, 184, 0.18);
    }
    .kdp-barcode-zone {
        position: absolute;
        right: 12%;
        bottom: 14%;
        width: 86px;
        height: 68px;
        border: 1px solid #64748b;
        border-radius: 0.25rem;
        background: repeating-linear-gradient(
            to right,
            #475569 0 2px,
            #e2e8f0 2px 4px
