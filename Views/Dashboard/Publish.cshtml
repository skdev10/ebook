        padding: 0.65rem 0.75rem;
        border-radius: 0.875rem;
        border: 1px solid #e2e8f0;
        background: #fff;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.8125rem;
        color: #475569;
        transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s, background 0.2s, color 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
    }
    .pub-learn-tab:hover { border-color: #c4b5fd; color: #5b21b6; }
    .pub-learn-tab--active {
        background: #5b21b6;
        color: #fff !important;
        border-color: transparent;
        box-shadow: 0 10px 28px -10px rgba(124, 58, 237, 0.65);
        transform: translateY(-1px);
    }
    .pub-learn-tab--active .fab.fa-amazon { color: #fbbf24; }
    .pub-learn-panels { max-height: min(58vh, 540px); overflow-y: auto; padding-right: 0.35rem; scrollbar-width: thin; }
    .pub-learn-panel { display: none; animation: pubLearnIn 0.25s ease; }
    .pub-learn-panel--active { display: block; }
    @@keyframes pubLearnIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    .pub-learn-card {
        margin-bottom: 0.875rem;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 18px -10px rgba(15, 23, 42, 0.15);
    }
    .pub-learn-card-head {
        padding: 0.55rem 0.9rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: #3730a3;
        background: #f5f3ff;
        border-bottom: 1px solid #ede9fe;
        letter-spacing: 0.01em;
    }
    .pub-learn-embed { aspect-ratio: 16/9; background: #0f172a; position: relative; }
    .pub-learn-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

    .container { width: 100%; max-width: none; }
    .book-card {
        background: #ffffff;
        border-radius: 1.5rem;
        border: 1px solid #dbe3ee;
        padding: clamp(1.15rem, 2.2vw, 2.4rem);
        box-shadow: 0 26px 44px -34px rgba(30, 41, 59, 0.4);
        display: flex;
        gap: clamp(1rem, 1.4vw, 2rem);
        align-items: flex-start;
    }
    .book-cover {
        flex-shrink: 0;
        width: clamp(170px, 16vw, 220px);
        height: clamp(238px, 22vw, 308px);
        border-radius: 0.85rem;
        overflow: hidden;
        box-shadow: 0 16px 34px -18px rgba(15, 23, 42, 0.55);
        position: relative;
    }
    .book-cover img { width: 100%; height: 100%; object-fit: cover; }
    .book-cover img.is-wrap-cover { object-position: right center; }
    .book-cover--wrap {
        width: min(100%, 420px);
        max-width: 100%;
        aspect-ratio: auto;
        min-height: 120px;
        height: auto;
    }
    .book-cover--wrap img.publish-cover-img--wrap {
        width: 100%;
        height: auto;
        max-height: 220px;
        object-fit: contain;
        object-position: center;
        background: #f8fafc;
    }
    .book-cover-placeholder {
        width: 100%;
        height: 100%;
        background: #5b21b6;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 0.86rem;
        font-weight: 600;
    }
    .book-info { flex: 1; min-width: 0; padding-top: 0.15rem; }
    .label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #7c3aed;
        text-transform: uppercase;
        margin-bottom: 0.7rem;
    }
    .book-title {
        font-size: clamp(1.5rem, 1.25rem + 1vw, 2.2rem);
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.95rem;
        line-height: 1.2;
    }
    .book-description {
        font-size: 0.93rem;
        line-height: 1.72;
        color: #64748b;
        margin-bottom: 1.2rem;
        max-width: 68ch;
    }
    .tags { display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: center; }
    .tag {
        padding: 0.42rem 0.82rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: default;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        line-height: 1.15;
    }
    .tag.fiction { background: #ede9fe; color: #6d28d9; border-color: #ddd6fe; }
    .tag.draft { background: #fef3c7; color: #b45309; border-color: #fde68a; }

    @@media (min-width: 1180px) {
        .publish-sections {
            grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
            align-items: start;
        }
        .publish-card--checkout,
        .publish-card--platforms {
            grid-column: 1 / -1;
        }
        .publish-card--checkout { order: 0; }
        .publish-card--pipeline {
            order: 1;
            grid-column: 1;
        }
        .publish-card--pro {
            order: 2;
            grid-column: 2;
        }
        .publish-card--platforms { order: 3; }
    }
    @@media (max-width: 768px) {
        .publish-hero {
            border-radius: 1.1rem;
        }
        .book-card {
            flex-direction: column;
            border-radius: 1.1rem;
        }
        .book-cover {
            margin: 0 auto;
        }
        .book-info {
            text-align: left;
        }
    }
    @@media (prefers-reduced-motion: reduce) {
        .publish-card {
            transition: none;
        }
        .publish-card:hover {
            transform: none;
        }
    }
</style>

<div class="bg-[#f5f7f9] min-h-full flex text-slate-900 flex-1">
<div class="max-w-[1600px] mx-auto w-full flex flex-col min-h-0">
<div class="publish-page publish-page-shell bg-white rounded-[32px] shadow-sm border border-slate-200/60 w-full min-h-[min(850px,calc(100vh-140px))] md:min-h-[850px] p-6 md:p-10 lg:p-12 text-slate-800">
    <section class="publish-hero mb-6 sm:mb-8 lg:mb-10">
        <div>
            <p class="publish-kicker">Distribution Console</p>
            <h1 class="publish-hero-title text-3xl lg:text-4xl font-medium text-slate-900 tracking-tight">Export your book</h1>
            @if (isPrintReadyFlow && !isBothFormat)
            {
                <p class="publish-hero-copy">Paperback / print-ready mode: download your <strong>full wrap cover</strong> (back + spine + front) and <strong>formatted interior PDF</strong> for KDP upload.</p>
            }
            else if (isBothFormat)
            {
                <p class="publish-hero-copy">Both formats: export ebook files (front cover + EPUB) and print-ready files (full wrap + interior PDF).</p>
            }
            else
            {
                <p class="publish-hero-copy">Open your book and export front cover + EPUB for Kindle, KDP ebook, IngramSpark, or any store.</p>
            }
        </div>
        <div class="publish-hero-meta">
            <span class="publish-chip @(alreadyListed ? "publish-chip-ready" : "publish-chip-neutral")">
                <i class="fas @(alreadyListed ? "fa-check-circle" : "fa-hourglass-half")" aria-hidden="true"></i> @publishStateText
            </span>
            @if (isPrintReadyFlow)
            {
                <span class="publish-chip publish-chip-neutral"><i class="fas fa-ruler-combined" aria-hidden="true"></i> Print-ready mode</span>
            }
            <span class="publish-chip publish-chip-neutral">
                <i class="fas fa-book-open" aria-hidden="true"></i> Book ID @(bookId > 0 ? bookId.ToString() : "Not selected")
            </span>
            @if (pbChapterCount > 0)
            {
                <span class="publish-chip publish-chip-neutral"><i class="fas fa-list-ol" aria-hidden="true"></i> @pbChapterCount chapter@(pbChapterCount == 1 ? "" : "s")</span>
            }
        </div>
    </section>

    <section class="publish-stat-strip mb-6 sm:mb-8">
        <article class="publish-stat">
            <p class="publish-stat-label">Selection</p>
            <p class="publish-stat-value">@(bookId > 0 ? "Book linked" : "Book not selected")</p>
            <p class="publish-stat-sub">@(bookId > 0 ? ("ID " + bookId) : "Select a title in My Books")</p>
        </article>
        <article class="publish-stat">
            <p class="publish-stat-label">Manuscript</p>
            <p class="publish-stat-value">@(pbEstimatedPages > 0 ? (pbEstimatedPages + " estimated pages") : (pbChapterCount > 0 ? (pbChapterCount + " chapter" + (pbChapterCount == 1 ? "" : "s")) : "No chapters yet"))</p>
            <p class="publish-stat-sub">Used for PDF and print exports</p>
        </article>
        <article class="publish-stat">
            <p class="publish-stat-label">Export</p>
            <p class="publish-stat-value">@publishStateText</p>
            <p class="publish-stat-sub">@(pbWordCount > 0 ? (pbWordCount.ToString("N0") + " words in manuscript") : "EPUB and Word when chapters exist")</p>
        </article>
    </section>

    <div class="container mb-8">
        @if (bookId > 0 && !string.IsNullOrEmpty(pbTitle))
        {
            <div class="book-card">
                <div class="book-cover@(displayCoverIsWrap ? " book-cover--wrap" : "")">
                    @if (!string.IsNullOrEmpty(displayCoverUrl))
                    {
                        <img src="@displayCoverUrl" alt="" class="publish-cover-img@(displayCoverIsWrap ? " publish-cover-img--wrap" : "")" loading="eager" decoding="async" />
                    }
                    else
                    {
                        <div class="book-cover-placeholder">No cover yet — design in Cover Design</div>
                    }
                </div>
                <div class="book-info">
                    <div class="label">@(canExport ? "Export your book" : "Your book")</div>
                    <h1 class="book-title">@pbTitle</h1>
                    <p class="book-description">
                        @(string.IsNullOrWhiteSpace(pbDesc) ? "Description can be updated in AI Writer or My Books." : pbDesc)
                    </p>
                    @if (pbChapterCount > 0)
                    {
                        <p class="text-sm text-slate-600 mb-4"><strong>@pbChapterCount</strong> chapter@(pbChapterCount == 1 ? "" : "s") on file.</p>
                    }
                    <div class="tags flex-wrap">
                        @if (!string.IsNullOrEmpty(pbGenre))
                        {
                            <span class="tag fiction" style="cursor:default;">@pbGenre</span>
                        }
                        <span class="tag draft" style="cursor:default;">@(alreadyListed ? "Published" : pbStatus)</span>
                        @if (pbEstimatedPages > 0)
                        {
                            <span class="tag fiction" style="cursor:default;">@pbEstimatedPages pages</span>
                        }
                    </div>
                    @if (!canExport)
                    {
                    <p class="text-sm text-slate-600 mb-4">Add chapter content in <a href="/Books/AIGenerateBook?bookId=@bookId" class="text-violet-700 font-semibold underline">AI Writer</a>, then return here to export.</p>
                    }
                    <p class="text-xs text-slate-500 mt-4">
                        Edit manuscript in <a href="/Books/AIGenerateBook?bookId=@bookId" class="text-violet-700 font-semibold underline">AI Writer</a> ·
                        <a href="/BookDesign/CoverDesignCalculatorFixing?bookId=@bookId" class="text-violet-700 font-semibold underline">Formatting</a> ·
                        <a href="/Dashboard/CoverDesign?bookId=@bookId" class="text-violet-700 font-semibold underline">Cover</a>
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="book-card">
                <div class="book-cover">
                    <div class="book-cover-placeholder">Select a book</div>
                </div>
                <div class="book-info">
                    <div class="label">No book selected</div>
                    <h1 class="book-title">Choose a book to publish</h1>
                    <p class="book-description">
                        Open <a href="/Dashboard/MyBooks" class="text-violet-700 font-semibold underline">My Books</a> or <a href="/Dashboard/CoverDesign" class="text-violet-700 font-semibold underline">Cover Design</a> and pick a title, or add <code class="bg-slate-100 px-1 rounded">?bookId=</code> to this page URL after creating a book in AI Writer.
                    </p>
                    <div class="mt-4 flex flex-wrap gap-3">
                        <a href="/Dashboard/MyBooks" class="inline-flex items-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700">Go to My Books</a>
                        <a href="/Books/AIGenerateBook" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white text-slate-800 font-semibold px-5 py-2.5 text-sm hover:bg-slate-50">Create in AI Writer</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (bookId > 0 && !string.IsNullOrEmpty(pbTitle) && showPrintExports)
    {
        <section class="publish-card publish-card--printready mb-8 p-5 md:p-6" id="publishSavedCoverSection">
            <div class="mb-3">
                <h2 class="text-lg font-semibold text-slate-900">Your print cover</h2>
                <p class="text-sm text-slate-600 mt-1">This is the cover from <a href="/Dashboard/CoverDesign?bookId=@bookId" class="text-violet-700 font-semibold underline">Cover Design</a>. Export downloads the <strong>full wrap</strong> (back + spine + front) at KDP size@(pbEstimatedPages > 0 ? (" for " + pbEstimatedPages + " pages") : "").</p>
            </div>
            <div class="publish-wrap-preview">
                @if (hasSavedCoverWrap)
                {
                    <img id="publishWrapPreview" src="@CoverUrl(pbCoverWrap)" alt="Full cover wrap from Cover Design" />
                    <span id="publishWrapPlaceholder" class="text-sm text-slate-500 hidden">No wrap yet</span>
                }
                else
                {
                    <img id="publishWrapPreview" class="hidden" alt="Full cover wrap from Cover Design" />
                    <span id="publishWrapPlaceholder" class="text-sm text-slate-500 text-center px-4">No print wrap saved yet. Open <a href="/Dashboard/CoverDesign?bookId=@bookId" class="text-violet-700 font-semibold underline">Cover Design</a>, generate your cover, then return here.</span>
                }
            </div>
        </section>
    }

    <section class="publish-export-stores" id="publishExportStores" aria-labelledby="publishExportStoresTitle">
        <h2 id="publishExportStoresTitle">@(isPrintReadyFlow && !isBothFormat ? "Export print-ready files" : "Export your book")</h2>
        @if (bookId > 0)
        {
            @if (canExport)
            {
                @if (isBothFormat)
                {
                    <p class="publish-export-hint" id="publishExportHint">Both format selected: export front cover + EPUB and print-ready files (full wrap + print-ready ZIP).</p>
                }
                else if (isPrintReadyFlow)
                {
                    <p class="publish-export-hint" id="publishExportHint">Print-ready mode: download your <strong>full wrap cover (PNG)</strong> and <strong>formatted interior PDF</strong> for KDP upload.</p>
                }
                else
                {
                    <p class="publish-export-hint" id="publishExportHint">Ebook format selected: export exactly 2 files (front cover image + EPUB).</p>
                }
                <div class="publish-export-actions">
                    <button type="button" data-export-kind="print" id="btnExportCoverWrap" class="@(showPrintExports ? "" : "hidden ")inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700 shadow-md shadow-violet-500/25 w-full sm:w-auto">
                        <i class="fas fa-image" aria-hidden="true"></i> Download full wrap cover (PNG)
                    </button>
                    <button type="button" data-export-kind="print" id="btnPrintReadyPublishPrimary" class="@(showPrintExports ? "" : "hidden ")inline-flex items-center justify-center gap-2 rounded-xl border-2 border-violet-400 bg-white text-violet-800 font-semibold px-5 py-2.5 text-sm hover:bg-violet-50 w-full sm:w-auto">
                        <i class="fas fa-file-pdf" aria-hidden="true"></i> Download print-ready interior PDF
                    </button>
                    <button type="button" data-export-kind="print" id="btnExportPrintBundle" class="@(showPrintExports ? "" : "hidden ")inline-flex items-center justify-center gap-2 rounded-xl border-2 border-violet-300 bg-white text-violet-800 font-semibold px-5 py-2.5 text-sm hover:bg-violet-50 w-full sm:w-auto">
                        <i class="fas fa-file-archive" aria-hidden="true"></i> Download print pack (ZIP)
                    </button>
                    @if (hasSavedFrontCover)
                    {
                        <button type="button" data-export-kind="ebook" id="btnExportFrontCover" class="@(showEbookExports ? "" : "hidden ")inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700 shadow-md shadow-violet-500/25 w-full sm:w-auto">
                            <i class="fas fa-image" aria-hidden="true"></i> Download front cover
                        </button>
                    }
                    <button type="button" data-export-kind="ebook" id="btnExportEpub" class="@(showEbookExports ? "" : "hidden ")inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700 shadow-md shadow-violet-500/25 w-full sm:w-auto">
                        <i class="fas fa-book" aria-hidden="true"></i> Download EPUB
                    </button>
                </div>
                <p class="publish-export-tip mt-3 mb-0 @(showPrintExports && isPrintReadyFlow && !isBothFormat ? "" : "hidden")" id="publishExportTipPrint">KDP upload: use the <strong>interior PDF</strong> for manuscript and the <strong>full wrap PNG</strong> for cover — spine width matches your page count.</p>
                <p class="publish-export-tip mt-3 mb-0 @(showEbookExports && !isPrintReadyFlow ? "" : "hidden")" id="publishExportTipEbook">After download: open the <strong>.epub</strong> file with Apple Books, Google Play Books, Calibre, or send to your Kindle.</p>
            }
            else
            {
                <p class="publish-export-hint">Add chapter content in <a href="/Books/AIGenerateBook?bookId=@bookId" class="text-violet-700 font-semibold underline">AI Writer</a>, then export from here.</p>
                @if (isPrintReadyFlow && hasSavedCoverWrap)
                {
                    <div class="publish-export-actions mt-3">
                        <button type="button" id="btnExportCoverWrap" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-violet-400 bg-white text-violet-800 font-semibold px-5 py-2.5 text-sm hover:bg-violet-50 w-full sm:w-auto">
                            <i class="fas fa-image" aria-hidden="true"></i> Download full wrap cover (PNG)
                        </button>
                    </div>
                    <p class="publish-export-tip mt-2 mb-0">Cover wrap is ready. Add chapters in AI Writer to export the interior PDF@(isBothFormat ? " and print pack" : "").</p>
                }
            }
        }
        else
        {
            <p class="publish-export-hint">Open <a href="/Dashboard/MyBooks" class="text-violet-700 font-semibold underline">My Books</a> and pick a title to export EPUB or print-ready files.</p>
        }
    </section>

</div>
</div>
</div>

<div id="publishDetailOverlay" class="publish-detail-overlay" role="dialog" aria-modal="true">
    <div class="publish-detail-box">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 bg-violet-700 text-white">
            <h3 id="publishDetailTitle" class="text-lg font-semibold">Guide</h3>
            <button type="button" id="publishDetailClose" class="p-2 rounded-lg hover:bg-white/15 text-white" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-5 overflow-y-auto flex-1">
            <div class="publish-progress" id="publishProgressBar"></div>
            <div id="publishDetailSteps"></div>
            <div class="mt-5 rounded-xl overflow-hidden border border-slate-200 bg-slate-900 aspect-video">
                <div id="publishVideoSlot" class="w-full h-full min-h-[200px]"></div>
            </div>
        </div>
    </div>
</div>

@if (bookId > 0)
{
    <script src="~/js/cover-kdp-export.js" asp-append-version="true"></script>
}
<script>
(function () {
    var paid = true;
    var bookId = @(bookId);
    var publishReady = @(publishReady.ToString().ToLowerInvariant());
    var alreadyListed = @(alreadyListed.ToString().ToLowerInvariant());
    var isPrintReadyFlow = @(isPrintReadyFlow.ToString().ToLowerInvariant());
    var isBothFormat = @(isBothFormat.ToString().ToLowerInvariant());
    var showPrintExports = @(showPrintExports.ToString().ToLowerInvariant());
    var publishableKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(publishableKey));
    var pbTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbTitle));
    var pbGenre = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbGenre));
    var pbDesc = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbDesc));
    var pbCoverRef = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(CoverUrl(pbCover)));
    var pbEstimatedPages = @(pbEstimatedPages);
    var publishBookFormat = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(publishBookFormat));

    function draftIndicatesPrintReady() {
        var draft = getFormatterDraftSnapshot();
        var plats = ((draft.publishingPlatform || '') + ',' + (draft.publishingPlatforms || '')).toLowerCase();
        var fmt = (draft.bookFormat || publishBookFormat || '').trim();
        if (fmt === 'Print') fmt = 'Paperback';
        return plats.indexOf('print ready') >= 0 || fmt === 'Paperback';
    }

    function applyPublishExportModeUi() {
        var section = document.getElementById('publishExportStores');
        if (!section) return;
        var hint = document.getElementById('publishExportHint');
        var title = document.getElementById('publishExportStoresTitle');
        var tipPrint = document.getElementById('publishExportTipPrint');
        var tipEbook = document.getElementById('publishExportTipEbook');
        var printOnly = isPrintReadyFlow && !isBothFormat;
        section.querySelectorAll('[data-export-kind]').forEach(function (el) {
            var kind = el.getAttribute('data-export-kind');
            var show = kind === 'print' ? showPrintExports : showEbookExports;
            el.classList.toggle('hidden', !show);
        });
        if (title) title.textContent = printOnly ? 'Export print-ready files' : 'Export your book';
        if (hint && printOnly) {
            hint.innerHTML = 'Print-ready mode: download your <strong>full wrap cover (PNG)</strong> and <strong>formatted interior PDF</strong> for KDP upload.';
        } else if (hint && isBothFormat) {
            hint.textContent = 'Both format selected: export front cover + EPUB and print-ready files (full wrap + interior PDF).';
        } else if (hint && showEbookExports && !showPrintExports) {
            hint.textContent = 'Ebook format selected: export front cover image + EPUB.';
        }
        if (tipPrint) tipPrint.classList.toggle('hidden', !(showPrintExports && printOnly));
        if (tipEbook) tipEbook.classList.toggle('hidden', !(showEbookExports && !isPrintReadyFlow));
        var printSection = document.getElementById('publishSavedCoverSection');
        if (printSection) printSection.classList.toggle('hidden', !showPrintExports);
    }

    function syncPublishModeFromContext() {
        try {
            var qp = new URLSearchParams(window.location.search);
            if (qp.get('flow') === 'printready' && publishBookFormat !== 'Both') {
                isPrintReadyFlow = true;
                showPrintExports = true;
                showEbookExports = false;
            }
        } catch (_) { /* no-op */ }
        if (publishBookFormat !== 'Both' && draftIndicatesPrintReady()) {
            isPrintReadyFlow = true;
            showPrintExports = true;
            showEbookExports = false;
        }
        applyPublishExportModeUi();
    }

    function getLocalFormatterPageCount(bid) {
        if (!bid || bid <= 0) return 0;
        try {
            var raw = localStorage.getItem('formatter_draft_v2_' + bid);
            if (!raw) return 0;
            var st = JSON.parse(raw);
            var n = parseInt(st.previewPageCount, 10);
            return (Number.isFinite(n) && n > 0) ? Math.min(828, n) : 0;
        } catch (e) { return 0; }
    }

    function resolvePublishPageCount(assetsPageCount) {
        var pages = parseInt(assetsPageCount, 10);
        if (Number.isFinite(pages) && pages > 0) return Math.min(828, pages);
        pages = parseInt(pbEstimatedPages, 10);
        if (Number.isFinite(pages) && pages > 0) return Math.min(828, pages);
        pages = getLocalFormatterPageCount(bookId);
        if (Number.isFinite(pages) && pages > 0) return pages;
        return 0;
    }

    function loadImageAspectRatio(ref) {
        return new Promise(function (resolve, reject) {
            var src = String(ref || '').trim();
            if (!src) { reject(new Error('Missing image.')); return; }
            var url = src.indexOf('data:') === 0 ? src : (src.indexOf('http') === 0 || src.indexOf('/') === 0 ? src : ('/' + src));
            var img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = function () {
                if (!img.naturalWidth || !img.naturalHeight) reject(new Error('Invalid image dimensions.'));
                else resolve(img.naturalWidth / img.naturalHeight);
            };
            img.onerror = function () { reject(new Error('Could not load cover image.')); };
            img.src = url;
        });
    }

    function isFullWrapAspectRatio(ratio) {
        return Number.isFinite(ratio) && ratio >= 1.28;
    }

    function showTransientMessage(kind, text) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: kind,
                title: kind === 'success' ? 'Done' : (kind === 'error' ? 'Error' : ''),
                text: text,
                timer: kind === 'success' ? 4200 : 2600,
                showConfirmButton: false
            });
        } else {
            alert(text);
        }
    }

    function parseFilenameFromDisposition(header) {
        if (!header) return '';
        var m = /filename\*=UTF-8''([^;]+)|filename="?([^";]+)"?/i.exec(header);
        if (!m) return '';
        try {
            return decodeURIComponent((m[1] || m[2] || '').trim());
        } catch (e) {
            return (m[1] || m[2] || '').trim();
        }
    }

    function downloadBlobAsFile(blob, filename) {
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename || 'book.epub';
        a.rel = 'noopener';
        document.body.appendChild(a);
        a.click();
        setTimeout(function () {
            a.remove();
            URL.revokeObjectURL(url);
        }, 400);
    }

    function safeBookSlug() {
        return String(pbTitle || 'book')
            .toLowerCase()
            .replace(/[^\w\s-]+/g, '')
            .replace(/\s+/g, '-')
            .replace(/^-+|-+$/g, '') || 'book';
    }

    function getPublishAntiForgeryToken() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        return t ? t.value : '';
    }

    function getFormatterDraftSnapshot() {
        if (!bookId || bookId <= 0) return {};
        try {
            var raw = localStorage.getItem('formatter_draft_v2_' + bookId);
            if (!raw) return {};
            var s = JSON.parse(raw);
            if (!s || typeof s !== 'object') return {};
            return {
                interiorStyle: s.interiorStyle || null,
                textSize: s.textSize || null,
                lineSpacing: s.lineSpacing || null,
                bookFormat: s.format || null,
                publishingPlatform: s.publishingPlatform || null,
                publishingPlatforms: s.publishingPlatforms || null,
                previewPageCount: s.previewPageCount || null
            };
        } catch (e) {
            return {};
        }
    }

    function runEbookExport(triggerBtn, format) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }
        var fmt = (format || 'epub').toLowerCase();
        var url = fmt === 'docx' ? '/Books/ExportDocx' : '/Books/ExportEpub';
        var token = getPublishAntiForgeryToken();
        if (triggerBtn) triggerBtn.disabled = true;
        showTransientMessage('info', fmt === 'docx' ? 'Building Word document…' : 'Building EPUB…');
        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            credentials: 'same-origin',
            body: JSON.stringify(Object.assign({
                bookId: bookId,
                displayTitle: pbTitle || '',
                displayAuthor: '',
                displayGenre: pbGenre || '',
                exportFormat: fmt
            }, getFormatterDraftSnapshot()))
        })
            .then(function (res) {
                if (!res.ok) {
                    return res.json().catch(function () { return {}; }).then(function (j) {
                        throw new Error((j && j.message) ? j.message : 'Export failed.');
                    });
                }
                var cd = res.headers.get('Content-Disposition') || '';
                var serverName = parseFilenameFromDisposition(cd);
                return res.blob().then(function (blob) {
                    if (!blob || blob.size < 80) {
                        throw new Error('Export file is empty. Add chapter text in AI Writer, then try again.');
                    }
                    var ext = fmt === 'docx' ? 'docx' : 'epub';
                    var mime = fmt === 'docx'
                        ? 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                        : 'application/epub+zip';
                    var typed = blob.type ? blob : new Blob([blob], { type: mime });
                    var fname = serverName || (safeBookSlug() + '-' + bookId + '.' + ext);
                    downloadBlobAsFile(typed, fname);
                    showTransientMessage('success', fmt === 'epub'
                        ? 'EPUB downloaded — open it in Apple Books, Play Books, or Calibre.'
                        : 'Word file downloaded.');
                });
            })
            .catch(function (err) {
                showTransientMessage('error', err && err.message ? err.message : 'Export failed.');
            })
            .finally(function () {
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

