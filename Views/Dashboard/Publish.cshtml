        .publish-export-stores .publish-export-actions {
            flex-direction: row;
            flex-wrap: wrap;
            max-width: none;
        }
    }
    /* E1: use the empty right side on the Publish page. On wide screens the
       "what you'll get" manifest sits on the left and the primary download/export
       actions move into a sticky panel on the right. Stacks on narrow screens. */
    .publish-export-grid {
        display: grid;
        gap: 1.1rem;
    }
