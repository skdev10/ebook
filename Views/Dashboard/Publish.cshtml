<div class="dash-flow-page">
<main class="dash-flow-main">
<div class="dash-flow-inner flex flex-col min-h-0">
<div class="publish-page publish-page-shell bg-white rounded-[32px] shadow-sm border border-slate-200/60 w-full min-h-[min(850px,calc(100vh-140px))] md:min-h-[850px] p-6 md:p-10 lg:p-12 text-slate-800">
    <section class="publish-hero mb-6 sm:mb-8 lg:mb-10" data-guided-tour="pub-hero">
        <div class="flex flex-col gap-4">
            @if (bookId > 0)
            {
                <div>
                    <button type="button" data-flow-back="@(ViewBag.FlowBackUrl ?? $"/Dashboard/CoverDesign?bookId={bookId}")" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors"><i class="fas fa-arrow-left text-xs"></i> Back to Cover Design</button>
                </div>
            }
            <div class="mb-2">@await Html.PartialAsync("_FlowStepper", 4)</div>
        <div>
            <p class="publish-kicker">Publish</p>
            <h1 id="publishHeroTitle" class="publish-hero-title text-3xl lg:text-4xl font-medium text-slate-900 tracking-tight">@(isEbookFormat && !isBothFormat ? "Download your ebook" : isPrintReadyFlow && !isBothFormat ? "Download your print-ready files" : "Export your book")</h1>
            <p id="publishHeroCopy" class="publish-hero-copy">@(isEbookFormat && !isBothFormat ? "Front cover + EPUB for ebook stores." : isPrintReadyFlow && !isBothFormat ? "Front cover + full wrap + interior PDF for paperback upload." : "Ebook: front cover + EPUB · Paperback: front cover + full wrap + PDF · Both: all four files.")</p>
        </div>
        <div class="publish-hero-meta">
            <span class="publish-chip @(alreadyListed ? "publish-chip-ready" : "publish-chip-neutral")">
                <i class="fas @(alreadyListed ? "fa-check-circle" : "fa-hourglass-half")" aria-hidden="true"></i> @publishStateText
            </span>
            @if (isPrintReadyFlow)
            {
                <span class="publish-chip publish-chip-neutral"><i class="fas fa-ruler-combined" aria-hidden="true"></i> Print-ready mode</span>
            }
            <span class="publish-chip publish-chip-neutral">
                <i class="fas fa-book-open" aria-hidden="true"></i> Book ID @(bookId > 0 ? bookId.ToString() : "Not selected")
            </span>
            @if (pbChapterCount > 0)
            {
                <span class="publish-chip publish-chip-neutral"><i class="fas fa-list-ol" aria-hidden="true"></i> @pbChapterCount chapter@(pbChapterCount == 1 ? "" : "s")</span>
            }
        </div>
        </div>
    </section>

    @if (bookId > 0)
    {
        <section class="publish-format-picker mb-6 sm:mb-8" aria-labelledby="publishFormatPickerTitle">
            <h2 id="publishFormatPickerTitle" class="publish-format-picker-title">Publishing format</h2>
            <p class="publish-format-picker-sub">Choose what you are publishing — the downloads below change to match.</p>
            <div class="publish-format-options" role="radiogroup" aria-label="Publishing format">
                <button type="button" class="publish-format-option @(isEbookFormat ? "is-selected" : "")" data-publish-format="Ebook" role="radio" aria-checked="@(isEbookFormat ? "true" : "false")">
                    <span class="publish-format-icon"><i class="fas fa-tablet-alt" aria-hidden="true"></i></span>
                    <span class="publish-format-name">eBook</span>
                    <span class="publish-format-desc">Front cover + EPUB</span>
                </button>
                <button type="button" class="publish-format-option @(isPaperbackFormat ? "is-selected" : "")" data-publish-format="Paperback" role="radio" aria-checked="@(isPaperbackFormat ? "true" : "false")">
                    <span class="publish-format-icon"><i class="fas fa-book" aria-hidden="true"></i></span>
                    <span class="publish-format-name">Paperback</span>
                    <span class="publish-format-desc">Full wrap cover + interior PDF</span>
                </button>
                <button type="button" class="publish-format-option @(isBothFormat ? "is-selected" : "")" data-publish-format="Both" role="radio" aria-checked="@(isBothFormat ? "true" : "false")">
                    <span class="publish-format-icon"><i class="fas fa-layer-group" aria-hidden="true"></i></span>
                    <span class="publish-format-name">eBook + Paperback</span>
                    <span class="publish-format-desc">All four files together</span>
                </button>
            </div>
        </section>
    }

    <section class="publish-stat-strip mb-6 sm:mb-8" data-guided-tour="pub-status">
        <article class="publish-stat">
            <p class="publish-stat-label">Selection</p>
            <p class="publish-stat-value">@(bookId > 0 ? "Book linked" : "Book not selected")</p>
            <p class="publish-stat-sub">@(bookId > 0 ? ("ID " + bookId) : "Select a title in My Books")</p>
        </article>
        <article class="publish-stat">
            <p class="publish-stat-label">Manuscript</p>
            <p class="publish-stat-value">@(pbEstimatedPages > 0 ? (pbEstimatedPages + " estimated pages") : (pbChapterCount > 0 ? (pbChapterCount + " chapter" + (pbChapterCount == 1 ? "" : "s")) : "No chapters yet"))</p>
            <p class="publish-stat-sub">Used for PDF and print exports</p>
        </article>
        <article class="publish-stat">
            <p class="publish-stat-label">Export</p>
            <p class="publish-stat-value">@publishStateText</p>
            <p class="publish-stat-sub">@(pbWordCount > 0 ? (pbWordCount.ToString("N0") + " words in manuscript") : "EPUB and Word when chapters exist")</p>
        </article>
    </section>

    <div class="container mb-8">
        @if (bookId > 0 && !string.IsNullOrEmpty(pbTitle))
        {
            <div class="book-card">
                <div class="book-cover@(displayCoverIsWrap ? " book-cover--wrap" : "")" id="publishBookCoverShell">
                    @if (!string.IsNullOrEmpty(displayCoverUrl))
                    {
                        <img id="publishBookCoverImg" src="@displayCoverUrl" alt="" class="publish-cover-img@(displayCoverIsWrap ? " publish-cover-img--wrap" : "")" loading="eager" decoding="async" />
                    }
                    else
                    {
                        <div class="book-cover-placeholder">No cover yet — design in Cover Design</div>
                    }
                </div>
                <div class="book-info">
                    <div class="book-info-main">
                        <div class="label">@(canExport ? "Export your book" : "Your book")</div>
                        <h1 class="book-title">@pbTitle</h1>
                        <p class="book-description">
                            @(string.IsNullOrWhiteSpace(pbDesc) ? "Description can be updated in AI Writer or My Books." : pbDesc)
                        </p>
                        @if (pbChapterCount > 0)
                        {
                            <p class="text-sm text-slate-600 mb-4"><strong>@pbChapterCount</strong> chapter@(pbChapterCount == 1 ? "" : "s") on file.</p>
                        }
                        <div class="tags flex-wrap">
                            @if (!string.IsNullOrEmpty(pbGenre))
                            {
                                <span class="tag fiction" style="cursor:default;">@pbGenre</span>
                            }
                            <span class="tag draft" style="cursor:default;">@(alreadyListed ? "Published" : pbStatus)</span>
                            @if (pbEstimatedPages > 0)
                            {
                                <span class="tag fiction" style="cursor:default;">@pbEstimatedPages pages</span>
                            }
                        </div>
                        @if (!canExport)
                        {
                            <p class="text-sm text-slate-600 mt-4 mb-0">Add chapter content in <a href="/Books/AIGenerateBook?bookId=@bookId" class="publish-leave-to-writer text-violet-700 font-semibold underline">AI Writer</a>, then return here to export.</p>
                        }
                    </div>
                    <div class="publish-quick-actions" aria-label="Edit and navigation">
                        @if (alreadyListed)
                        {
                            <p class="publish-locked-note"><i class="fas fa-info-circle" aria-hidden="true"></i> This book is published. You can still edit it — changes are saved automatically.</p>
                        }
                        <a href="/Books/AIGenerateBook?bookId=@bookId" class="publish-quick-btn publish-leave-to-writer"><i class="fas fa-pen-nib" aria-hidden="true"></i> Edit in AI Writer</a>
                        <a href="/BookDesign/CoverDesignCalculatorFixing?bookId=@bookId" class="publish-quick-btn"><i class="fas fa-book-open" aria-hidden="true"></i> Book Formatting</a>
                        <a href="/Dashboard/CoverDesign?bookId=@bookId" class="publish-quick-btn"><i class="fas fa-image" aria-hidden="true"></i> Cover Design</a>
                        @if (alreadyListed)
                        {
                            <a href="/Dashboard/MyBooks" class="publish-quick-btn"><i class="fas fa-book" aria-hidden="true"></i> View in My Books</a>
                            <a href="/Dashboard" id="publishFinishBtnLocked" class="publish-finish-btn publish-quick-btn publish-quick-btn--primary" data-finish-toast="This book is published and safely saved. Manage it anytime from My Books."><i class="fas fa-check-circle" aria-hidden="true"></i> Done — Go to Dashboard</a>
                        }
                        else
                        {
                            <button type="button" id="publishFinalizeBtn" data-book-id="@bookId" class="publish-quick-btn publish-quick-btn--primary"><i class="fas fa-flag-checkered" aria-hidden="true"></i> Finalize</button>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="book-card">
                <div class="book-cover">
                    <div class="book-cover-placeholder">Select a book</div>
                </div>
                <div class="book-info">
                    <div class="label">No book selected</div>
                    <h1 class="book-title">Choose a book to publish</h1>
                    <p class="book-description">
                        Open <a href="/Dashboard/MyBooks" class="text-violet-700 font-semibold underline">My Books</a> or <a href="/Dashboard/CoverDesign" class="text-violet-700 font-semibold underline">Cover Design</a> and pick a title, or add <code class="bg-slate-100 px-1 rounded">?bookId=</code> to this page URL after creating a book in AI Writer.
                    </p>
                    <div class="mt-4 flex flex-wrap gap-3">
                        <a href="/Dashboard/MyBooks" class="inline-flex items-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700">Go to My Books</a>
                        <a href="@(bookId > 0 ? $"/Books/AIGenerateBook?bookId={bookId}" : "/Dashboard")" class="publish-leave-to-writer inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white text-slate-800 font-semibold px-5 py-2.5 text-sm hover:bg-slate-50">Continue in AI Writer</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (bookId > 0 && !string.IsNullOrEmpty(pbTitle) && showPrintExports)
    {
        <section class="publish-card publish-card--printready mb-8 p-5 md:p-6" id="publishSavedCoverSection">
            <div class="mb-3">
                <h2 class="text-lg font-semibold text-slate-900">Your print cover (full wrap)</h2>
                <p class="text-sm text-slate-600 mt-1">This is the <strong>exact full wrap</strong> file exported below (back + spine + front) at KDP size@(pbEstimatedPages > 0 ? (" for " + pbEstimatedPages + " pages") : ""). The book card above shows the front panel only.</p>
            </div>
            @if (!externalApiConfigured)
            {
                <div class="publish-wrap-status publish-wrap-status--info" role="note">
                    <strong>Book API key optional for wrap.</strong> Full wrap is built locally from your saved front cover. An API key is still needed for AI cover generation in Cover Design.
                </div>
            }
            else if (!hasSavedCoverWrap && hasSavedFrontCover)
            {
                <div class="publish-wrap-status publish-wrap-status--info" id="publishWrapBuildHint">
                    Front cover saved. Full wrap builds automatically from your cover — usually under a minute.
                </div>
            }
            <div class="publish-wrap-preview">
                <p id="publishWrapPreloadStatus" class="publish-wrap-status publish-wrap-status--info hidden" aria-live="polite"></p>
                <p id="publishWrapPreloadError" class="publish-wrap-status publish-wrap-status--error hidden" role="alert"></p>
                @if (hasSavedCoverWrap)
                {
                    <img id="publishWrapPreview" src="@CoverUrl(pbCoverWrap)" alt="Full cover wrap from Cover Design" />
                    <span id="publishWrapPlaceholder" class="text-sm text-slate-500 hidden">No wrap yet</span>
                }
                else
                {
                    <img id="publishWrapPreview" class="hidden" alt="Full cover wrap from Cover Design" />
                    <div id="publishWrapPlaceholder" class="publish-wrap-empty">
                        <i class="fas fa-book-open" aria-hidden="true"></i>
                        <span>No print wrap saved yet. Open <a href="/Dashboard/CoverDesign?bookId=@bookId" class="text-violet-700 font-semibold underline">Cover Design</a>, generate your cover, then return here — the wrap will build in the background when possible.</span>
                    </div>
                }
            </div>
        </section>
    }

    <section class="publish-export-stores" id="publishExportStores" aria-labelledby="publishExportStoresTitle" data-guided-tour="pub-export">
        <h2 id="publishExportStoresTitle">@(isPrintReadyFlow && !isBothFormat ? "Export print-ready files" : "Export your book")</h2>
        @if (bookId > 0)
        {
            @if (canExport)
            {
                @if (isBothFormat)
                {
                    <p class="publish-export-hint" id="publishExportHint">Both formats — 4 files: front cover, EPUB, full wrap cover, and interior PDF.</p>
                }
                else if (isPrintReadyFlow)
                {
                    <p class="publish-export-hint" id="publishExportHint">Paperback output — 3 files: <strong>front cover</strong>, <strong>full wrap</strong> (back + spine + same front), and <strong>interior PDF</strong>.</p>
                }
                else
                {
                    <p class="publish-export-hint" id="publishExportHint">Ebook output — 2 files: front cover image + EPUB.</p>
                }
                <div class="publish-export-grid">
                <div class="publish-output-manifest @(isBothFormat ? "publish-output-manifest--dual" : "")" id="publishOutputManifest">
                    @if (showEbookExports)
                    {
                        <article class="publish-output-card @(isPrintReadyFlow && !isBothFormat ? "hidden" : "")" id="publishOutputEbook" data-output-kind="ebook">
                            <h3>Ebook output</h3>
                            <ul>
                                <li><i class="fas fa-image" aria-hidden="true"></i><span><strong>Front cover</strong> — single panel image (PNG/JPG) for ebook stores</span></li>
                                <li><i class="fas fa-book" aria-hidden="true"></i><span><strong>EPUB</strong> — formatted manuscript with embedded cover</span></li>
                            </ul>
                        </article>
                    }
                    @if (showPrintExports)
                    {
                        <article class="publish-output-card @(isEbookFormat && !isBothFormat ? "hidden" : "")" id="publishOutputPrint" data-output-kind="print">
                            <h3>Paperback output</h3>
                            <ul>
                                <li><i class="fas fa-image" aria-hidden="true"></i><span><strong>Front cover</strong> — same image from Cover Design (also on the wrap front panel)</span></li>
                                <li><i class="fas fa-book-open" aria-hidden="true"></i><span><strong>Full wrap cover</strong> — back + spine + front at 300 DPI with 0.125″ bleed</span></li>
                                <li><i class="fas fa-file-pdf" aria-hidden="true"></i><span><strong>Interior PDF</strong> — 6×9″ trim, KDP-safe margins for Amazon paperback upload</span></li>
                                @if (isBothFormat)
                                {
                                    <li><i class="fas fa-file-archive" aria-hidden="true"></i><span><strong>One ZIP, both formats</strong> — the print pack also bundles the EPUB + front cover so ebook &amp; paperback publish together</span></li>
                                }
                            </ul>
                        </article>
                    }
                </div>
                <div class="publish-export-actions">
                    <button type="button" data-export-kind="ebook" id="btnExportFrontCover" class="@(showEbookExports ? "" : "hidden ")inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700 shadow-md shadow-violet-500/25 w-full sm:w-auto">
                        <i class="fas fa-download" aria-hidden="true"></i> Download front cover
                    </button>
                    <button type="button" data-export-kind="ebook" id="btnExportEpub" class="@(showEbookExports ? "" : "hidden ")inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700 shadow-md shadow-violet-500/25 w-full sm:w-auto">
                        <i class="fas fa-download" aria-hidden="true"></i> Download EPUB
                    </button>
                    <button type="button" data-export-kind="print" id="btnExportCoverWrap" class="@(showPrintExports ? "" : "hidden ")inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700 shadow-md shadow-violet-500/25 w-full sm:w-auto">
                        <i class="fas fa-download" aria-hidden="true"></i> Download full wrap cover
                    </button>
                    <button type="button" data-export-kind="print" id="btnExportFrontCoverPrint" class="@(showPrintExports && !showEbookExports ? "" : "hidden ")inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700 shadow-md shadow-violet-500/25 w-full sm:w-auto">
                        <i class="fas fa-download" aria-hidden="true"></i> Download front cover
                    </button>
                    <button type="button" data-export-kind="print" id="btnPrintReadyPublishPrimary" class="@(showPrintExports ? "" : "hidden ")inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700 shadow-md shadow-violet-500/25 w-full sm:w-auto">
                        <i class="fas fa-download" aria-hidden="true"></i> Download interior PDF
                    </button>
                    <button type="button" data-export-kind="print" id="btnExportPrintBundle" class="@(isBothFormat ? "" : "hidden ")inline-flex items-center justify-center gap-2 rounded-xl border-2 border-violet-300 bg-white text-violet-800 font-semibold px-5 py-2.5 text-sm hover:bg-violet-50 w-full sm:w-auto">
                        <i class="fas fa-file-archive" aria-hidden="true"></i> Download all files (ZIP)
                    </button>
                </div>
                </div>
                <p class="publish-export-tip mt-3 mb-0 @(showPrintExports && isPrintReadyFlow && !isBothFormat ? "" : "hidden")" id="publishExportTipPrint">KDP paperback: upload the <strong>interior PDF</strong> (6×9 trim, safe margins) as manuscript and the <strong>full wrap PNG</strong> as cover — spine width matches your page count.</p>
                <p class="publish-export-tip mt-3 mb-0 @(showEbookExports && !isPrintReadyFlow && !isBothFormat ? "" : "hidden")" id="publishExportTipEbook">KDP ebook: upload the <strong>EPUB</strong> as manuscript and the <strong>front cover JPG/PNG</strong> as cover art.</p>
            }
            else
            {
                <p class="publish-export-hint">Add chapter content in <a href="/Books/AIGenerateBook?bookId=@bookId" class="publish-leave-to-writer text-violet-700 font-semibold underline">AI Writer</a>, then export from here.</p>
                @if (isPrintReadyFlow && hasSavedCoverWrap)
                {
                    <div class="publish-export-actions mt-3">
                        <button type="button" id="btnExportCoverWrapNoChapters" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-violet-400 bg-white text-violet-800 font-semibold px-5 py-2.5 text-sm hover:bg-violet-50 w-full sm:w-auto">
                            <i class="fas fa-image" aria-hidden="true"></i> Download full wrap cover (PNG)
                        </button>
                    </div>
                    <p class="publish-export-tip mt-2 mb-0">Cover wrap is ready. Add chapters in AI Writer to export the interior PDF@(isBothFormat ? " and print pack" : "").</p>
                }
            }
        }
        else
        {
            <p class="publish-export-hint">Open <a href="/Dashboard/MyBooks" class="text-violet-700 font-semibold underline">My Books</a> and pick a title to export EPUB or print-ready files.</p>
        }
    </section>

</div>
</div>
</main>
</div>

<div id="publishDetailOverlay" class="publish-detail-overlay" role="dialog" aria-modal="true">
    <div class="publish-detail-box">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 bg-violet-700 text-white">
            <h3 id="publishDetailTitle" class="text-lg font-semibold">Guide</h3>
            <button type="button" id="publishDetailClose" class="p-2 rounded-lg hover:bg-white/15 text-white" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-5 overflow-y-auto flex-1">
            <div class="publish-progress" id="publishProgressBar"></div>
            <div id="publishDetailSteps"></div>
            <div class="mt-5 rounded-xl overflow-hidden border border-slate-200 bg-slate-900 aspect-video">
                <div id="publishVideoSlot" class="w-full h-full min-h-[200px]"></div>
            </div>
        </div>
    </div>
</div>

@if (bookId > 0)
{
    <script src="~/js/cover-kdp-export.js" asp-append-version="true"></script>
}
<script>
(function () {
    var paid = true;
    var bookId = @(bookId);
    var publishReady = @(publishReady.ToString().ToLowerInvariant());
    var alreadyListed = @(alreadyListed.ToString().ToLowerInvariant());
    var isPrintReadyFlow = @(isPrintReadyFlow.ToString().ToLowerInvariant());
    var isPaperbackFormat = @(isPaperbackFormat.ToString().ToLowerInvariant());
    var isBothFormat = @(isBothFormat.ToString().ToLowerInvariant());
    var forcedPrintReadyFlow = @(isPrintReadyFlow.ToString().ToLowerInvariant());
    var showPrintExports = @(showPrintExports.ToString().ToLowerInvariant());
    var showEbookExports = @(showEbookExports.ToString().ToLowerInvariant());
    var publishableKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(publishableKey));
    var pbTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbTitle));
    var pbGenre = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbGenre));
    var pbDesc = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbDesc));
    var pbCoverRef = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(CoverUrl(pbCover)));
    var pbCoverWrapRef = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(CoverUrl(pbCoverWrap)));
    var pbEstimatedPages = @(pbEstimatedPages);
    var publishBookFormat = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(publishBookFormat));
    var publishFormatterSnapshot = @Html.Raw(publishFormatterSnapshotJson);

    function parseExportErrorResponse(res, fallbackMsg) {
        var ct = (res.headers.get('Content-Type') || '').toLowerCase();
        if (ct.indexOf('application/json') >= 0) {
            return res.json().then(function (j) {
                throw new Error((j && j.message) ? j.message : fallbackMsg);
            });
        }
        return res.text().then(function (t) {
            throw new Error(t || fallbackMsg);
        });
    }

    // Publishing format picker — persists the choice, then reloads so every
    // export section/cover preview re-renders for the selected format.
    (function bindPublishFormatPicker() {
        var options = document.querySelectorAll('.publish-format-option');
        if (!options.length || !bookId) return;
        options.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var fmt = btn.getAttribute('data-publish-format');
                if (!fmt || btn.classList.contains('is-selected')) return;
                options.forEach(function (b) { b.disabled = true; });
                fetch('/Dashboard/SetPublishFormat', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ bookId: bookId, format: fmt })
                }).then(function (r) { return r.json(); }).then(function (d) {
                    if (d && d.success) { window.location.reload(); return; }
                    options.forEach(function (b) { b.disabled = false; });
                    if (typeof showNotification === 'function') showNotification((d && d.message) || 'Could not change format.', 'error');
                    else alert((d && d.message) || 'Could not change format.');
                }).catch(function () {
                    options.forEach(function (b) { b.disabled = false; });
                    if (typeof showNotification === 'function') showNotification('Could not change format. Try again.', 'error');
                });
            });
        });
    })();

    /** Dashboard JSON endpoints sometimes return HTML (504 gateway, login page) — parse safely. */
    function parseDashboardJsonResponse(res, fallbackMsg) {
        return res.text().then(function (text) {
            if (!text) return {};
            try {
                return JSON.parse(text);
            } catch (e) {
                if (text.indexOf('<!DOCTYPE') >= 0 || text.indexOf('<html') >= 0) {
                    if (res.status === 401) throw new Error('Please sign in again, then retry.');
                    throw new Error(fallbackMsg || ('Server error (HTTP ' + res.status + '). Please refresh and try again.'));
                }
                throw new Error((text && text.length < 240) ? text : (fallbackMsg || 'Invalid server response.'));
            }
        });
    }

    function fetchPrintReadyCoverAssets() {
        return fetch('/Dashboard/GetPrintReadyCoverAssets?bookId=' + encodeURIComponent(bookId), {
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json' }
        }).then(function (r) {
            return parseDashboardJsonResponse(r, 'Could not load cover assets.').then(function (j) {
                if (!r.ok || j.success === false) throw new Error((j && j.message) ? j.message : 'Could not load cover assets.');
                return j;
            });
        });
    }

    function queuePrintWrapGeneration(forceRebuild) {
        var pageCount = resolvePublishPageCount(pbEstimatedPages > 0 ? pbEstimatedPages : getLocalFormatterPageCount(bookId));
        if (pageCount > 0 && pageCount < 24) pageCount = 24;
        return fetch('/Dashboard/GeneratePrintReadyWrapFromFront', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
                bookId: bookId,
                pageCount: pageCount > 0 ? pageCount : null,
                force: !!forceRebuild,
                wait: true,
                title: pbTitle || '',
                author: '',
                genre: pbGenre || ''
            })
        }).then(function (r) {
            return parseDashboardJsonResponse(r, 'Full wrap generation failed.').then(function (j) {
                if (!r.ok || j.success === false) throw new Error((j && j.message) ? j.message : 'Full wrap generation failed.');
                syncWrapReadyFromAssets(j);
                var wrap = j && j.cover ? (j.cover.wrap || '').trim() : '';
                if (wrap) applySavedCoverPreview(wrap);
                return j;
            });
        });
    }

    function pollForPrintWrap(maxMs, intervalMs) {
        maxMs = maxMs || 45000;
        intervalMs = intervalMs || 1500;
        var started = Date.now();
        return new Promise(function (resolve, reject) {
            function tick() {
                fetchPrintReadyCoverAssets().then(function (data) {
                    syncWrapReadyFromAssets(data);
                    var wrap = data && data.cover ? (data.cover.wrap || '').trim() : '';
                    if (wrap || publishWrapCoverReady) return resolve(data);
                    if (data && data.wrapCoverStatus === 'Failed') {
                        reject(new Error('Full wrap generation failed. Open Cover Design to regenerate your front cover, then return here.'));
                        return;
                    }
                    if (Date.now() - started > maxMs) {
                        reject(new Error('Full wrap is still building. Wait a moment and refresh — or open Cover Design to regenerate your front cover.'));
                        return;
                    }
                    setTimeout(tick, intervalMs);
                }).catch(reject);
            }
            tick();
        });
    }

    var publishWrapCoverReady = !!(String(pbCoverWrapRef || '').trim());
    var publishWrapPollTimer = null;

    function normalizePublishCoverAssets(assets) {
        if (!assets) return null;
        if (assets.cover && ((assets.cover.wrap || '').trim() || (assets.cover.front || '').trim())) return assets;
        var wrap = (assets.wrap || '').trim();
        var front = (assets.front || pbCoverRef || '').trim();
        if (!wrap && !front) return null;
        return {
            cover: {
                wrap: wrap,
                front: front,
                spine: (assets.spine || '').trim(),
                back: (assets.back || '').trim()
            },
            pageCount: assets.pageCount || pbEstimatedPages || 0,
            layout: assets.layout || null,
            trimSize: assets.trimSize || null
        };
    }

    function syncWrapReadyFromAssets(data) {
        var prev = window._publishCoverAssets || {};
        var wrap = data && data.cover ? (data.cover.wrap || '').trim() : '';
        var status = data && data.wrapCoverStatus ? String(data.wrapCoverStatus) : '';
        var matchesFront = !(data && data.wrapMatchesFront === false);
        // Local wraps stamp front SHA/ref — treat Ready + wrap as ready even if pixel compare flaked.
        publishWrapCoverReady = !!(wrap && matchesFront && status !== 'Stale' && status !== 'Failed' && status !== 'MissingFront');
        if (!publishWrapCoverReady && status === 'Ready' && wrap) {
            publishWrapCoverReady = true;
            matchesFront = true;
        }
        if (!publishWrapCoverReady && status === 'Ready' && matchesFront) {
            var cached = (prev.cover && prev.cover.wrap) || String(pbCoverWrapRef || '').trim();
            publishWrapCoverReady = !!cached;
            if (publishWrapCoverReady && !wrap) wrap = cached;
        }
        if ((status === 'Stale' || data && data.wrapMatchesFront === false) && !publishWrapCoverReady) {
            wrap = '';
            publishWrapCoverReady = false;
            applySavedCoverPreview('');
        }
        window._publishCoverAssets = {
            cover: data && data.cover ? {
                wrap: wrap,
                front: (data.cover.front || prev.cover && prev.cover.front || pbCoverRef || '').trim(),
                spine: (data.cover.spine || prev.cover && prev.cover.spine || '').trim(),
                back: (data.cover.back || prev.cover && prev.cover.back || '').trim()
            } : (prev.cover || { wrap: wrap, front: pbCoverRef || '', spine: '', back: '' }),
            pageCount: (data && data.pageCount) || prev.pageCount || pbEstimatedPages || 0,
            layout: (data && data.layout) || prev.layout || null,
            trimSize: (data && data.trimSize) || prev.trimSize || null,
            wrapCoverStatus: status,
            wrapMatchesFront: matchesFront
        };
        updateWrapExportButtonState(data);
        return publishWrapCoverReady;
    }

    function wrapDownloadButtonLabel() {
        // Stable CTA — never swap to "Building wrap…" (that flickered during format
        // selection / background preload). Progress belongs in the download UX on click.
        return '<i class="fas fa-download" aria-hidden="true"></i> Download full wrap cover';
    }

    function updateWrapExportButtonState(data) {
        var btn = document.getElementById('btnExportCoverWrap');
        var statusEl = document.getElementById('publishWrapPreloadStatus');
        var errorEl = document.getElementById('publishWrapPreloadError');
        var hintEl = document.getElementById('publishWrapBuildHint');
        if (!btn || !showPrintExports) return;
        var wrapStatus = data && data.wrapCoverStatus ? String(data.wrapCoverStatus) : (publishWrapCoverReady ? 'Ready' : 'Generating');
        var matchesFront = !(data && data.wrapMatchesFront === false);
        var ready = publishWrapCoverReady && wrapStatus !== 'Stale' && matchesFront;
        var busy = btn.getAttribute('aria-busy') === 'true';
        btn.classList.remove('opacity-60', 'cursor-not-allowed');
        if (!busy) {
            btn.disabled = false;
            btn.setAttribute('aria-disabled', 'false');
            btn.innerHTML = wrapDownloadButtonLabel();
            if (btn.dataset.publishOriginalHtml) btn.dataset.publishOriginalHtml = btn.innerHTML;
        }

        if (ready) {
            if (statusEl) { statusEl.textContent = ''; statusEl.classList.add('hidden'); }
            if (errorEl) { errorEl.textContent = ''; errorEl.classList.add('hidden'); }
            if (hintEl) hintEl.classList.add('hidden');
            var wrap = data && data.cover ? (data.cover.wrap || '').trim()
                : ((window._publishCoverAssets && window._publishCoverAssets.cover && window._publishCoverAssets.cover.wrap) || '').trim();
            if (wrap) applySavedCoverPreview(wrap);
            return;
        }
        if (wrapStatus === 'Stale') {
            // Quiet background refresh — keep preview empty until the matching wrap lands.
            if (statusEl) { statusEl.textContent = ''; statusEl.classList.add('hidden'); }
            if (errorEl) { errorEl.textContent = ''; errorEl.classList.add('hidden'); }
            return;
        }
        if (wrapStatus === 'Failed') {
            if (statusEl) { statusEl.textContent = ''; statusEl.classList.add('hidden'); }
            if (errorEl) {
                errorEl.textContent = 'Full wrap generation failed. Open Cover Design to regenerate your front cover, then return here.';
                errorEl.classList.remove('hidden');
            }
            return;
        }
        if (wrapStatus === 'MissingFront') {
            if (errorEl) {
                errorEl.textContent = 'Generate a front cover in Cover Design first — the full wrap uses that exact image.';
                errorEl.classList.remove('hidden');
            }
            if (statusEl) { statusEl.textContent = ''; statusEl.classList.add('hidden');
            }
            return;
        }
        // Background generate/preload: no "Building wrap…" chrome — download click finishes it.
        if (errorEl) { errorEl.textContent = ''; errorEl.classList.add('hidden'); }
        if (statusEl) { statusEl.textContent = ''; statusEl.classList.add('hidden'); }
        if (hintEl) hintEl.classList.add('hidden');
    }

    function startWrapStatusPolling() {
        if (!needsPrintWrapGeneration() || publishWrapCoverReady) return;
        if (publishWrapPollTimer) return;
        publishWrapPollTimer = setInterval(function () {
            fetchPrintReadyCoverAssets()
                .then(function (data) {
                    syncWrapReadyFromAssets(data);
                    var st = data && data.wrapCoverStatus ? String(data.wrapCoverStatus) : '';
                    if (st === 'Stale' || st === 'Generating') {
                        // Keep polling / queue rebuild until preview matches export asset.
                        return;
                    }
                    if (publishWrapCoverReady && publishWrapPollTimer) {
                        clearInterval(publishWrapPollTimer);
                        publishWrapPollTimer = null;
                        var wrap = data && data.cover ? (data.cover.wrap || '').trim() : '';
                        if (wrap) applySavedCoverPreview(wrap);
                    }
                })
                .catch(function () { /* non-fatal */ });
        }, 3000);
    }

    function validatePdfBlob(blob) {
        if (!blob || blob.size < 128) {
            return Promise.reject(new Error('PDF file is empty. Add chapter text and try again.'));
        }
        return blob.arrayBuffer().then(function (ab) {
            var u8 = new Uint8Array(ab);
            var hdr = String.fromCharCode(u8[0] || 0, u8[1] || 0, u8[2] || 0, u8[3] || 0);
            if (hdr !== '%PDF') {
                return Promise.reject(new Error('Download is not a valid PDF. PDF generation failed on the server — check that Chromium/Puppeteer is available.'));
            }
            return new Blob([ab], { type: 'application/pdf' });
        });
    }

    function ensureFormatterSavedOnServer(retryCount) {
        if (!bookId || bookId <= 0) return Promise.resolve(true);
        if (typeof window.fmtFlushFormattingForExport === 'function' && document.getElementById('book-formatter-root')) {
            return window.fmtFlushFormattingForExport();
        }
        var attempts = Math.max(1, retryCount == null ? 2 : (retryCount + 1));
        var snap = getFormatterDraftSnapshot();
        var draftJson = null;
        try {
            draftJson = localStorage.getItem('formatter_draft_v2_' + bookId);
        } catch (e) { /* ignore */ }
        var interior = snap.interiorStyle || (publishFormatterSnapshot && publishFormatterSnapshot.interiorStyle) || 'Novel';
        var textSize = snap.textSize || (publishFormatterSnapshot && publishFormatterSnapshot.textSize) || 'Medium';
        var lineSpacing = snap.lineSpacing || (publishFormatterSnapshot && publishFormatterSnapshot.lineSpacing) || '1.6';
        var payload = {
            bookId: bookId,
            format: snap.bookFormat || publishBookFormat || null,
            interiorStyle: interior,
            textSize: textSize,
            lineSpacing: lineSpacing,
            publishingPlatforms: snap.publishingPlatforms || '',
            publishingPlatform: snap.publishingPlatform || '',
            previewPageCount: snap.previewPageCount || null,
            draftStateJson: draftJson || null
        };
        if (!payload.format) payload.format = publishBookFormat || 'Ebook';

        function trySave(left) {
            return fetch('/BookDesign/SaveBookFormatting', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(payload)
            })
                .then(function (r) { return r.json(); })
                .then(function (j) {
                    if (j && j.success) return true;
                    if (left > 1) {
                        return new Promise(function (resolve) {
                            setTimeout(function () { resolve(trySave(left - 1)); }, 400);
                        });
                    }
                    return false;
                })
                .catch(function () {
                    if (left > 1) {
                        return new Promise(function (resolve) {
                            setTimeout(function () { resolve(trySave(left - 1)); }, 400);
                        });
                    }
                    return false;
                });
        }
        return trySave(attempts);
    }

    function fetchExportOnce(url, init, expectPdf) {
        return fetch(url, init).then(function (res) {
            var ct = (res.headers.get('Content-Type') || '').toLowerCase();
            if (!res.ok) return parseExportErrorResponse(res, expectPdf ? 'Could not generate PDF.' : 'Export failed.');
            if (expectPdf && ct.indexOf('application/pdf') < 0) {
                return parseExportErrorResponse(res, 'Server did not return a PDF file.');
            }
            return res;
        });
    }

    function fetchPdfExport(url, body) {
        showTransientMessage('info', 'Saving your formatting, then building PDF…');
        var init = {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/pdf, application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(body)
        };
        return ensureFormatterSavedOnServer(2).then(function (saved) {
            if (!saved) showTransientMessage('warning', 'Could not sync formatting — using last saved settings.');
            return fetchExportOnce(url, init, true).catch(function (err) {
                var msg = err && err.message ? err.message : '';
                if (/500|pdf|chromium|empty|failed/i.test(msg)) {
                    showTransientMessage('info', 'First PDF can take up to a minute — retrying…');
                    return new Promise(function (resolve) {
                        setTimeout(function () { resolve(fetchExportOnce(url, init, true)); }, 2500);
                    });
                }
                throw err;
            }).then(function (res) {
                var serverName = parseFilenameFromDisposition(res.headers.get('Content-Disposition'));
                return res.blob().then(validatePdfBlob).then(function (blob) {
                    return { blob: blob, fileName: serverName };
                });
            });
        });
    }

    function draftIndicatesPrintReady() {
        var draft = getFormatterDraftSnapshot();
        var fmt = (draft.bookFormat || publishBookFormat || '').trim();
        if (fmt === 'Print') fmt = 'Paperback';
        return fmt === 'Paperback' || fmt === 'Both';
    }

    function redirectToDashboardAfterExport(message, flowPath) {
        var path = flowPath || (isPrintReadyFlow ? 'print' : 'ebook');
        notifyBookPublishedAfterDownload(path).finally(function () {
            showTransientMessage('success', message || 'Download complete.');
        });
    }

    function notifyBookPublishedAfterDownload(flowPath) {
        if (!bookId || bookId <= 0) return Promise.resolve();
        var token = getPublishAntiForgeryToken();
        var path = (flowPath || (isPrintReadyFlow ? 'print' : 'ebook')).toLowerCase();
        return fetch('/Dashboard/MarkBookPublished', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            credentials: 'same-origin',
            body: JSON.stringify(buildExportPayload({
                bookId: bookId,
                bookFormat: path === 'print' ? 'Paperback' : (publishBookFormat || 'Ebook'),
                publishingPlatform: path === 'print' ? 'Just Print Ready File' : null
            }))
        }).catch(function () { return null; });
    }

    function applyPublishExportModeUi() {
        var section = document.getElementById('publishExportStores');
        if (!section) return;
        var hint = document.getElementById('publishExportHint');
        var title = document.getElementById('publishExportStoresTitle');
        var tipPrint = document.getElementById('publishExportTipPrint');
        var tipEbook = document.getElementById('publishExportTipEbook');
        var printOnly = isPrintReadyFlow && !isBothFormat;
        section.querySelectorAll('[data-export-kind]').forEach(function (el) {
            var kind = el.getAttribute('data-export-kind');
            var show = false;
            if (el.id === 'btnExportFrontCover') {
                show = showEbookExports;
            } else if (el.id === 'btnExportFrontCoverPrint') {
                show = showPrintExports && !showEbookExports;
            } else if (el.id === 'btnExportEpub') {
                show = showEbookExports;
            } else if (el.id === 'btnExportPrintBundle') {
                show = isBothFormat;
            } else if (kind === 'print') {
                show = showPrintExports;
            }
            if (printOnly && el.id === 'btnExportPrintBundle') show = false;
            el.classList.toggle('hidden', !show);
        });
        if (title) title.textContent = printOnly ? 'Export print-ready files' : 'Export your book';
        if (hint && printOnly) {
            hint.innerHTML = 'Paperback output — 3 files: <strong>front cover</strong>, <strong>full wrap cover</strong>, and <strong>6×9 interior PDF</strong>.';
        } else if (hint && isBothFormat) {
            hint.textContent = 'Both formats — 4 files: front cover, EPUB, full wrap cover, and interior PDF.';
        } else if (hint && showEbookExports && !showPrintExports) {
            hint.textContent = 'Ebook output — 2 files: front cover image + EPUB.';
        }
        if (tipPrint) tipPrint.classList.toggle('hidden', !(showPrintExports && printOnly));
        if (tipEbook) tipEbook.classList.toggle('hidden', !(showEbookExports && !isPrintReadyFlow && !isBothFormat));
        var printSection = document.getElementById('publishSavedCoverSection');
        if (printSection) printSection.classList.toggle('hidden', !showPrintExports);
        var outEbook = document.getElementById('publishOutputEbook');
        var outPrint = document.getElementById('publishOutputPrint');
        if (outEbook) outEbook.classList.toggle('hidden', !showEbookExports || (printOnly && !isBothFormat));
        if (outPrint) outPrint.classList.toggle('hidden', !showPrintExports || (showEbookExports && !showPrintExports));
        var manifest = document.getElementById('publishOutputManifest');
        if (manifest) manifest.classList.toggle('publish-output-manifest--dual', isBothFormat);
    }

    function updatePublishHeroForFormat() {
        var titleEl = document.getElementById('publishHeroTitle');
        var copyEl = document.getElementById('publishHeroCopy');
        var fmt = (publishBookFormat || 'Ebook').trim();
        if (fmt === 'Print') fmt = 'Paperback';
        if (titleEl) {
            titleEl.textContent = fmt === 'Ebook'
                ? 'Download your ebook'
                : (fmt === 'Paperback' ? 'Download your print-ready files' : 'Export your book');
        }
        if (copyEl) {
            copyEl.textContent = fmt === 'Ebook'
                ? 'Front cover + EPUB for ebook stores.'
                : (fmt === 'Paperback'
                    ? 'Front cover + full wrap + interior PDF for paperback upload.'
                    : 'Ebook: front cover + EPUB · Paperback: front cover + full wrap + PDF · Both: all four files.');
        }
    }

    function applyPublishCoverForFormat() {
        var img = document.getElementById('publishBookCoverImg');
        var shell = document.getElementById('publishBookCoverShell');
        var assets = window._publishCoverAssets || {};
        var cover = assets.cover || {};
        // Hero book card ALWAYS shows the front panel (2:3). Full wrap lives only in
        // #publishWrapPreview — same URL the wrap download endpoint serves — so preview
        // and export never disagree.
        var url = ((cover.front || '').trim() || (pbCoverRef || '').trim() || (cover.wrap || '').trim());
        if (!img) return;
        if (!url) return;
        img.src = url;
        img.classList.remove('publish-cover-img--wrap', 'is-wrap-cover');
        if (shell) shell.classList.remove('book-cover--wrap');
        markPublishCoverImage(img);
    }

    function persistPublishFormat(fmt) {
        if (!bookId || bookId <= 0) return Promise.resolve();
        var snap = getFormatterDraftSnapshot();
        return fetch('/BookDesign/SaveBookFormatting', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
                bookId: bookId,
                format: fmt,
                // Send blank (not 'Novel') when unknown so the server keeps the persisted
                // interior style instead of clobbering it with a hardcoded default.
                interiorStyle: snap.interiorStyle || '',
                textSize: snap.textSize || '',
                lineSpacing: snap.lineSpacing || '',
                publishingPlatforms: snap.publishingPlatforms || '',
                publishingPlatform: snap.publishingPlatform || ''
            })
        }).catch(function () { return null; });
    }

    function setPublishFormat(fmt, persist) {
        var norm = (fmt || 'Ebook').trim();
        if (norm === 'Print') norm = 'Paperback';
        if (norm !== 'Ebook' && norm !== 'Paperback' && norm !== 'Both') norm = 'Ebook';
        publishBookFormat = norm;
        var hidden = document.getElementById('pubFormat');
        if (hidden) hidden.value = norm;
        var opts = document.getElementById('pubFormatOptions');
        if (opts) {
            opts.querySelectorAll('.pub-format-btn').forEach(function (b) {
                var active = (b.getAttribute('data-format') || '') === norm;
                b.classList.toggle('bg-violet-600', active);
                b.classList.toggle('text-white', active);
                b.classList.toggle('text-slate-700', !active);
            });
        }
        syncPublishModeFromContext();
        applyPublishCoverForFormat();
        updatePublishHeroForFormat();
        if (persist) persistPublishFormat(norm);
    }

    function syncPublishModeFromContext() {
        var fmt = (publishBookFormat || 'Ebook').trim();
        if (fmt === 'Print') fmt = 'Paperback';
        isPaperbackFormat = fmt === 'Paperback';
        isBothFormat = fmt === 'Both';
        isPrintReadyFlow = isPaperbackFormat || isBothFormat;
        showPrintExports = isPaperbackFormat || isBothFormat;
        showEbookExports = fmt === 'Ebook' || fmt === 'Both';
        applyPublishExportModeUi();
    }

    function getLocalFormatterPageCount(bid) {
        if (!bid || bid <= 0) return 0;
        try {
            var raw = localStorage.getItem('formatter_draft_v2_' + bid);
            if (!raw) return 0;
            var st = JSON.parse(raw);
            var n = parseInt(st.previewPageCount, 10);
            return (Number.isFinite(n) && n > 0) ? Math.min(828, n) : 0;
        } catch (e) { return 0; }
    }

    function resolvePublishPageCount(assetsPageCount) {
        var pages = parseInt(assetsPageCount, 10);
        if (Number.isFinite(pages) && pages > 0) return Math.min(828, pages);
        pages = parseInt(pbEstimatedPages, 10);
        if (Number.isFinite(pages) && pages > 0) return Math.min(828, pages);
        pages = getLocalFormatterPageCount(bookId);
        if (Number.isFinite(pages) && pages > 0) return pages;
        return 0;
    }

    function loadImageAspectRatio(ref) {
        return new Promise(function (resolve, reject) {
            var src = String(ref || '').trim();
            if (!src) { reject(new Error('Missing image.')); return; }
            var url = src.indexOf('data:') === 0 ? src : (src.indexOf('http') === 0 || src.indexOf('/') === 0 ? src : ('/' + src));
            var img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = function () {
                if (!img.naturalWidth || !img.naturalHeight) reject(new Error('Invalid image dimensions.'));
                else resolve(img.naturalWidth / img.naturalHeight);
            };
            img.onerror = function () { reject(new Error('Could not load cover image.')); };
            img.src = url;
        });
    }

    function isFullWrapAspectRatio(ratio) {
        return Number.isFinite(ratio) && ratio >= 1.28;
    }

    function showTransientMessage(kind, text) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: kind,
                title: kind === 'success' ? 'Done' : (kind === 'error' ? 'Error' : ''),
                text: text,
                timer: kind === 'success' ? 4200 : 2600,
                showConfirmButton: false
            });
        } else {
            alert(text);
        }
    }

    // Persistent download UX: button spinner + blocking SweetAlert loader so the
    // user clearly sees that the export is in progress (covers ebook, paperback, both).
    function setPublishButtonBusy(btn, busyLabel) {
        if (!btn) return;
        if (!btn.dataset.publishOriginalHtml) btn.dataset.publishOriginalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> ' + (busyLabel || 'Preparing…');
    }

    var _stillGeneratingTimer = null;
    function cancelStillGeneratingTimer() {
        if (_stillGeneratingTimer) { clearTimeout(_stillGeneratingTimer); _stillGeneratingTimer = null; }
    }

    function clearPublishButtonBusy(btn) {
        cancelStillGeneratingTimer();
        if (!btn) return;
        if (btn.dataset.publishOriginalHtml) {
            btn.innerHTML = btn.dataset.publishOriginalHtml;
            delete btn.dataset.publishOriginalHtml;
        }
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
    }

    function showPublishDownloadLoader(title, message) {
        if (typeof Swal === 'undefined') return;
        Swal.fire({
            title: title || 'Preparing your download',
            html: '<p style="margin:0;color:#475569;font-size:14px;line-height:1.55">'
                + (message || 'Your download will be ready in a few minutes. Please keep this tab open while we build your files…')
                + '</p>',
            allowOutsideClick: false,
            allowEscapeKey: false,
            showConfirmButton: false,
            didOpen: function () { if (typeof Swal.showLoading === 'function') Swal.showLoading(); }
        });
        // After 90s, reassure the user it's still working (no freeze / no silent timeout).
        cancelStillGeneratingTimer();
        _stillGeneratingTimer = setTimeout(function () {
            try {
                if (typeof Swal !== 'undefined' && typeof Swal.isVisible === 'function' && Swal.isVisible()) {
                    var html = document.querySelector('.swal2-html-container');
                    if (html && !html.querySelector('.still-generating-note')) {
                        html.insertAdjacentHTML('beforeend',
                            '<p class="still-generating-note" style="margin:10px 0 0;color:#b45309;font-size:13px;font-weight:600;line-height:1.5">Still generating… large books can take a little longer. Please keep this tab open.</p>');
                    }
                }
            } catch (e) { /* ignore */ }
        }, 90000);
    }

    // Wrap a download flow with the busy button + loader. The success/error
    // SweetAlerts shown later automatically replace the loader modal.
    function startPublishDownloadUx(triggerBtn, busyLabel, loaderTitle, loaderMessage) {
        setPublishButtonBusy(triggerBtn, busyLabel || 'Preparing…');
        showPublishDownloadLoader(loaderTitle, loaderMessage);
    }

    function parseFilenameFromDisposition(header) {
        if (!header) return '';
        var m = /filename\*=UTF-8''([^;]+)|filename="?([^";]+)"?/i.exec(header);
        if (!m) return '';
        try {
            return decodeURIComponent((m[1] || m[2] || '').trim());
        } catch (e) {
            return (m[1] || m[2] || '').trim();
        }
    }

    function sanitizeDownloadFilename(name, fallback) {
        var base = String(name || fallback || 'book').trim();
        base = base.replace(/[\\/:*?"<>|]+/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
        return base || 'book';
    }

    function downloadBlobAsFile(blob, filename) {
        var safeName = sanitizeDownloadFilename(filename, 'book.pdf');
        var typed = (blob && blob.type === 'application/pdf')
            ? blob
            : new Blob([blob], { type: safeName.toLowerCase().endsWith('.pdf') ? 'application/pdf' : (blob.type || 'application/octet-stream') });
        if (window.navigator && typeof window.navigator.msSaveOrOpenBlob === 'function' && typed.type === 'application/pdf') {
            window.navigator.msSaveOrOpenBlob(typed, safeName);
            return;
        }
        var url = URL.createObjectURL(typed);
        var a = document.createElement('a');
        a.href = url;
        a.download = safeName;
        a.rel = 'noopener';
        a.style.display = 'none';
        document.body.appendChild(a);
        try { a.click(); } catch (e) { /* fallback below */ }
        setTimeout(function () {
            a.remove();
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: 'Download ready',
                    html: '<p class="text-sm text-slate-600 mb-3">If the file did not start, tap the button below.</p>' +
                        '<a href="' + url + '" download="' + safeName.replace(/"/g, '') + '" class="inline-flex items-center justify-center rounded-xl bg-violet-600 text-white font-semibold px-4 py-2 text-sm">Download ' + safeName.replace(/</g, '') + '</a>',
                    showConfirmButton: false,
                    showCloseButton: true,
                    closeButtonAriaLabel: 'Close',
                    timer: 120000
                });
            }
            setTimeout(function () { URL.revokeObjectURL(url); }, 300000);
        }, 1200);
    }

    function safeBookSlug() {
        return String(pbTitle || 'book')
            .toLowerCase()
            .replace(/[^\w\s-]+/g, '')
            .replace(/\s+/g, '-')
            .replace(/^-+|-+$/g, '') || 'book';
    }

    function getPublishAntiForgeryToken() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        return t ? t.value : '';
    }

    function buildExportPayload(overrides) {
        return Object.assign({}, getFormatterDraftSnapshot(), overrides || {});
    }

    function getFormatterDraftSnapshot() {
        var base = {};
        try {
            if (publishFormatterSnapshot && typeof publishFormatterSnapshot === 'object') {
                base = {
                    interiorStyle: publishFormatterSnapshot.interiorStyle || null,
                    textSize: publishFormatterSnapshot.textSize || null,
                    lineSpacing: publishFormatterSnapshot.lineSpacing || null,
                    bookFormat: publishFormatterSnapshot.bookFormat || null,
                    publishingPlatform: publishFormatterSnapshot.publishingPlatform || null,
                    publishingPlatforms: publishFormatterSnapshot.publishingPlatforms || null,
                    previewAccent: publishFormatterSnapshot.previewAccent || null,
                    pageBackgroundColor: publishFormatterSnapshot.pageBackgroundColor || null
                };
            }
        } catch (e) { /* ignore */ }
        if (!bookId || bookId <= 0) return base;
        try {
            var raw = localStorage.getItem('formatter_draft_v2_' + bookId);
            if (!raw) return base;
            var s = JSON.parse(raw);
            if (!s || typeof s !== 'object') return base;
            return Object.assign({}, base, {
                interiorStyle: s.interiorStyle || base.interiorStyle || null,
                textSize: s.textSize || base.textSize || null,
                lineSpacing: s.lineSpacing || base.lineSpacing || null,
                bookFormat: s.format || base.bookFormat || null,
                publishingPlatform: s.publishingPlatform || base.publishingPlatform || null,
                publishingPlatforms: s.publishingPlatforms || base.publishingPlatforms || null,
                previewPageCount: s.previewPageCount || null,
                previewAccent: s.previewAccent || base.previewAccent || null,
                pageBackgroundColor: s.pageBackgroundColor || base.pageBackgroundColor || null
            });
        } catch (e) {
            return base;
        }
    }

    function runEbookExport(triggerBtn, format) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }
        var fmt = (format || 'epub').toLowerCase();
        var url = fmt === 'docx' ? '/Books/ExportDocx' : '/Books/ExportEpub';
        startPublishDownloadUx(triggerBtn, 'Building…',
            fmt === 'docx' ? 'Preparing your Word file' : 'Preparing your EPUB',
            fmt === 'docx'
                ? 'Saving formatting and building your Word file. This can take a few minutes — please keep this tab open…'
                : 'Saving formatting and building your EPUB. This can take a few minutes — please keep this tab open…');
        var exportBody = buildExportPayload({
            bookId: bookId,
            displayTitle: pbTitle || '',
            displayAuthor: '',
            displayGenre: pbGenre || '',
            exportFormat: fmt,
            bookFormat: 'Ebook',
            publishingPlatform: '',
            publishingPlatforms: ''
        });
        ensureFormatterSavedOnServer(2).then(function (saved) {
            if (!saved) showTransientMessage('warning', 'Could not sync formatting — using last saved settings.');
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(exportBody)
            });
        }).then(function (res) {
            if (!res.ok) {
                return res.json().catch(function () { return {}; }).then(function (j) {
                    throw new Error((j && j.message) ? j.message : 'Export failed.');
                });
            }
            var cd = res.headers.get('Content-Disposition') || '';
            var serverName = parseFilenameFromDisposition(cd);
            return res.blob().then(function (blob) {
                if (!blob || blob.size < 80) {
                    throw new Error('Export file is empty. Add chapter text in AI Writer, then try again.');
                }
                var ext = fmt === 'docx' ? 'docx' : 'epub';
                var mime = fmt === 'docx'
                    ? 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                    : 'application/epub+zip';
                var typed = blob.type ? blob : new Blob([blob], { type: mime });
                var fname = serverName || (safeBookSlug() + '-' + bookId + '.' + ext);
                downloadBlobAsFile(typed, fname);
                redirectToDashboardAfterExport(fmt === 'epub'
                    ? 'EPUB downloaded.'
                    : 'Word file downloaded.');
            });
        }).catch(function (err) {
            showTransientMessage('error', err && err.message ? err.message : 'Export failed.');
        }).finally(function () {
            clearPublishButtonBusy(triggerBtn);
        });
    }

