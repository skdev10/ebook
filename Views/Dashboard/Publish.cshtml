    #btnStripePublish {
        border-radius: 0.95rem !important;
        font-size: 0.9rem;
        padding-block: 0.82rem !important;
        padding-inline: 1.15rem !important;
    }
    #btnDownloadEbook,
    #btnDownloadEbookPrint,
    #btnDownloadFullBookPdf,
    #btnDownloadInteriorPdf,
    #btnDownloadKdpCover,
    #btnDownloadCoverWrap,
    #btnExportEpub,
    #btnExportDocx,
    #btnExportPdf,
    #btnExportPrintBundle,
    #btnExportCoverWrap,
    #btnPrintReadyPublishPrimary,
