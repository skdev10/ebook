    function parseTrimSize(label) {
        var s = String(label || '6 x 9 in').toLowerCase();
        if (s.indexOf('5.5') >= 0 && s.indexOf('8.5') >= 0) return { w: 5.5, h: 8.5 };
        if (s.indexOf('8.5') >= 0 && s.indexOf('11') >= 0) return { w: 8.5, h: 11 };
        return { w: 6, h: 9 };
    }

    function imageRefToBase64(ref) {
        ref = (ref || '').trim();
        if (!ref) return Promise.reject(new Error('Missing cover image.'));
        if (ref.indexOf('data:image') === 0) {
            var i = ref.indexOf('base64,');
            return Promise.resolve(i >= 0 ? ref.substring(i + 7) : ref);
        }
        var url = ref.indexOf('http') === 0 || ref.indexOf('/') === 0 ? ref : ('/' + ref);
        return fetch(url).then(function (r) {
            if (!r.ok) throw new Error('Could not load cover wrap.');
            return r.blob();
        }).then(function (blob) {
            return new Promise(function (resolve, reject) {
                var reader = new FileReader();
                reader.onload = function () {
                    var data = String(reader.result || '');
                    var comma = data.indexOf(',');
                    resolve(comma >= 0 ? data.substring(comma + 1) : data);
                };
                reader.onerror = function () { reject(new Error('Could not read cover wrap.')); };
                reader.readAsDataURL(blob);
            });
        });
    }

