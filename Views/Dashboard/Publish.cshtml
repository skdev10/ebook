    function ensurePrintWrapGenerated() {
        if (!bookId || bookId <= 0) return Promise.reject(new Error('Select a book first.'));
        if (!needsPrintWrapGeneration()) return Promise.resolve({ skipped: true });
        return fetchPrintReadyCoverAssets().then(function (assets) {
            syncWrapReadyFromAssets(assets);
            var wrap = assets && assets.cover ? (assets.cover.wrap || '').trim() : '';
            var matches = !(assets && assets.wrapMatchesFront === false);
            var st = assets && assets.wrapCoverStatus ? String(assets.wrapCoverStatus) : '';
            if (wrap && matches && st !== 'Stale') return assets;
            return queuePrintWrapGeneration(st === 'Stale' || !matches);
        });
    }

