        background: #f5f3ff;
        border-bottom: 1px solid #ede9fe;
        letter-spacing: 0.01em;
    }
    .pub-learn-embed { aspect-ratio: 16/9; background: #0f172a; position: relative; }
    .pub-learn-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

    .container { width: 100%; max-width: none; }
    .book-card {
        background: #ffffff;
        border-radius: 1.5rem;
        border: 1px solid #dbe3ee;
        padding: clamp(1.15rem, 2.2vw, 2.4rem);
        box-shadow: 0 26px 44px -34px rgba(30, 41, 59, 0.4);
        display: flex;
        gap: clamp(1rem, 1.4vw, 2rem);
        align-items: flex-start;
    }
    .book-cover {
        flex-shrink: 0;
        width: clamp(170px, 16vw, 220px);
        height: clamp(238px, 22vw, 308px);
        border-radius: 0.85rem;
        overflow: hidden;
        box-shadow: 0 16px 34px -18px rgba(15, 23, 42, 0.55);
        position: relative;
    }
    .book-cover img { width: 100%; height: 100%; object-fit: cover; }
    .book-cover-placeholder {
        width: 100%;
        height: 100%;
        background: #5b21b6;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 0.86rem;
        font-weight: 600;
    }
    .book-info { flex: 1; min-width: 0; padding-top: 0.15rem; }
    .label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #7c3aed;
        text-transform: uppercase;
        margin-bottom: 0.7rem;
    }
    .book-title {
        font-size: clamp(1.5rem, 1.25rem + 1vw, 2.2rem);
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.95rem;
        line-height: 1.2;
    }
    .book-description {
        font-size: 0.93rem;
        line-height: 1.72;
        color: #64748b;
        margin-bottom: 1.2rem;
        max-width: 68ch;
    }
    .tags { display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: center; }
    .tag {
        padding: 0.42rem 0.82rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: default;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        line-height: 1.15;
    }
    .tag.fiction { background: #ede9fe; color: #6d28d9; border-color: #ddd6fe; }
    .tag.draft { background: #fef3c7; color: #b45309; border-color: #fde68a; }

    @@media (min-width: 1180px) {
        .publish-sections {
            grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
            align-items: start;
        }
        .publish-card--checkout,
        .publish-card--platforms {
            grid-column: 1 / -1;
        }
        .publish-card--checkout { order: 0; }
        .publish-card--pipeline {
            order: 1;
            grid-column: 1;
        }
        .publish-card--pro {
            order: 2;
            grid-column: 2;
        }
        .publish-card--platforms { order: 3; }
    }
    @@media (max-width: 768px) {
        .publish-hero {
            border-radius: 1.1rem;
        }
        .book-card {
            flex-direction: column;
            border-radius: 1.1rem;
        }
        .book-cover {
            margin: 0 auto;
        }
        .book-info {
            text-align: left;
        }
    }
    @@media (prefers-reduced-motion: reduce) {
        .publish-card {
            transition: none;
        }
        .publish-card:hover {
            transform: none;
        }
    }
</style>

<div class="bg-[#f5f7f9] min-h-full flex text-slate-900 flex-1">
<main class="flex-1 overflow-y-auto overflow-x-hidden w-full min-h-0 p-4 sm:p-6 lg:p-8">

<div class="publish-page text-slate-800 max-w-none mx-auto w-full px-0 py-6 sm:py-8 lg:py-10">
    <section class="publish-hero mb-6 sm:mb-8 lg:mb-10">
        <div>
            <p class="publish-kicker">Distribution Console</p>
            <h1 class="publish-hero-title text-3xl lg:text-4xl font-medium text-slate-900 tracking-tight">Publish your book</h1>
            <p class="publish-hero-copy">Finalize listing metadata, complete secure checkout, and your title is marked published only after Stripe confirms payment.</p>
        </div>
        <div class="publish-hero-meta">
            <span class="publish-chip @(alreadyListed ? "publish-chip-ready" : "publish-chip-neutral")">
                <i class="fas @(alreadyListed ? "fa-check-circle" : "fa-hourglass-half")" aria-hidden="true"></i> @publishStateText
            </span>
            @if (isPrintReadyFlow)
            {
                <span class="publish-chip publish-chip-neutral"><i class="fas fa-ruler-combined" aria-hidden="true"></i> Print-ready mode</span>
            }
            <span class="publish-chip publish-chip-neutral">
                <i class="fas fa-book-open" aria-hidden="true"></i> Book ID @(bookId > 0 ? bookId.ToString() : "Not selected")
            </span>
            @if (pbChapterCount > 0)
            {
                <span class="publish-chip publish-chip-neutral"><i class="fas fa-list-ol" aria-hidden="true"></i> @pbChapterCount chapter@(pbChapterCount == 1 ? "" : "s")</span>
            }
        </div>
    </section>

    <section class="publish-stat-strip mb-6 sm:mb-8">
        <article class="publish-stat">
            <p class="publish-stat-label">Selection</p>
            <p class="publish-stat-value">@(bookId > 0 ? "Book linked" : "Book not selected")</p>
            <p class="publish-stat-sub">@(bookId > 0 ? ("ID " + bookId) : "Select a title in My Books")</p>
        </article>
        <article class="publish-stat">
            <p class="publish-stat-label">Manuscript</p>
            <p class="publish-stat-value">@(pbEstimatedPages > 0 ? (pbEstimatedPages + " estimated pages") : (pbChapterCount > 0 ? (pbChapterCount + " chapter" + (pbChapterCount == 1 ? "" : "s")) : "No chapters yet"))</p>
            <p class="publish-stat-sub">Single page-count source for PDF + Stripe</p>
        </article>
        <article class="publish-stat">
            <p class="publish-stat-label">Checkout state</p>
            <p class="publish-stat-value">@publishStateText</p>
            <p class="publish-stat-sub">@(pbWordCount > 0 ? (pbWordCount.ToString("N0") + " words in manuscript") : "Stripe confirms publish status")</p>
        </article>
    </section>

    <div class="container mb-8">
        @if (bookId > 0 && !string.IsNullOrEmpty(pbTitle) && publishReady)
        {
            <div class="book-card">
                <div class="book-cover">
                    @if (!string.IsNullOrEmpty(pbCover))
                    {
                        <img src="@CoverUrl(pbCover)" alt="" loading="eager" decoding="async" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&amp;w=600&amp;auto=format&amp;fit=crop';" />
                    }
                    else
                    {
                        <div class="book-cover-placeholder">Book cover</div>
                    }
                </div>
                <div class="book-info">
                    <div class="label">Ready to publish</div>
                    <h1 class="book-title">@pbTitle</h1>
                    <p class="book-description">
                        @(string.IsNullOrWhiteSpace(pbDesc) ? "Description can be updated in AI Writer or My Books." : pbDesc)
                    </p>
                    @if (pbChapterCount > 0)
                    {
                        <p class="text-sm text-slate-600 mb-4"><strong>@pbChapterCount</strong> chapter@(pbChapterCount == 1 ? "" : "s") on file.</p>
                    }
                    <div class="tags flex-wrap">
                        @if (!string.IsNullOrEmpty(pbGenre))
                        {
                            <span class="tag fiction" style="cursor:default;">@pbGenre</span>
                        }
                        <span class="tag draft" style="cursor:default;">@(alreadyListed ? "Published" : pbStatus)</span>
                        @if (pbEstimatedPages > 0)
                        {
                            <span class="tag fiction" style="cursor:default;">@pbEstimatedPages pages</span>
                        }
                    </div>
                    <div class="mt-4 flex flex-wrap items-center gap-2">
                        @if (isPrintReadyFlow)
                        {
                            if (!alreadyListed && publishReady)
                            {
                                <button type="button" id="btnPrintReadyPublishPrimary" class="inline-flex items-center gap-2 rounded-xl font-semibold px-4 py-2.5 text-sm transition-all pr-primary-action">
                                    <i class="fas fa-credit-card"></i> Publish with Stripe
                                </button>
                            }
                            else
                            {
                                <button type="button" id="btnPrintReadyPublishPrimary" disabled class="inline-flex items-center gap-2 rounded-xl bg-slate-300 text-slate-600 font-semibold px-4 py-2.5 text-sm cursor-not-allowed">
                                    <i class="fas fa-check-circle"></i> @(alreadyListed ? "Already published" : "Publish unavailable")
                                </button>
                            }
                            <button type="button" id="btnDownloadKdpCover" class="inline-flex items-center gap-2 rounded-xl font-semibold px-4 py-2.5 text-sm transition-all pr-secondary-action">
                                <i class="fas fa-image"></i> Download KDP Cover
                            </button>
                            <button type="button" id="btnDownloadFullBookPdf" class="inline-flex items-center gap-2 rounded-xl font-semibold px-4 py-2.5 text-sm transition-all pr-tertiary-action">
                                <i class="fas fa-file-pdf"></i> Download Full Book
                            </button>
                            <span id="pub-pdf-hint" class="text-xs text-slate-500">Three quick actions: publish, download KDP wrap cover, or download full book PDF.</span>
                        }
                        else
                        {
                            <button type="button" id="btnDownloadEbook" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 text-white font-semibold px-4 py-2.5 text-sm hover:bg-slate-800 transition-colors">
                                <i class="fas fa-file-pdf"></i> Full print-ready PDF
                            </button>
                            <button type="button" id="btnDownloadInteriorPdf" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white text-slate-800 font-semibold px-4 py-2.5 text-sm hover:bg-slate-50">
                                <i class="fas fa-book-open"></i> Interior only PDF
                            </button>
                            <button type="button" id="btnDownloadCoverWrap" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white text-slate-800 font-semibold px-4 py-2.5 text-sm hover:bg-slate-50">
                                <i class="fas fa-image"></i> Cover wrap PNG
                            </button>
                            <span id="pub-pdf-hint" class="text-xs text-slate-500">Download options: full print-ready, interior-only, or saved wrap cover asset.</span>
                        }
                    </div>
                    <p class="text-xs text-slate-500 mt-4">
                        @if (isPrintReadyFlow)
                        {
                            <text>Print-ready mode uses formatting + trim dimensions. Update manuscript in <a href="/Books/AIGenerateBook?bookId=@bookId" class="text-violet-700 font-semibold underline">AI Writer</a> or formatting in <a href="/BookDesign/CoverDesignCalculatorFixing?bookId=@bookId" class="text-violet-700 font-semibold underline">Book Formatting</a>.</text>
                        }
                        else
                        {
                            <text>Finalized title and cover from your library. To replace the cover or manuscript, use <a href="/Dashboard/CoverDesign?bookId=@bookId" class="text-violet-700 font-semibold underline">Cover Design</a> or <a href="/Dashboard/MyBooks" class="text-violet-700 font-semibold underline">My Books</a>.</text>
                        }
                    </p>
                </div>
            </div>
        }
        else if (bookId > 0 && !string.IsNullOrEmpty(pbTitle) && !publishReady)
        {
            <div class="book-card border-amber-100 bg-white">
                <div class="book-cover">
                    @if (!string.IsNullOrEmpty(pbCover))
                    {
                        <img src="@CoverUrl(pbCover)" alt="" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&amp;w=600&amp;auto=format&amp;fit=crop';" />
                    }
                    else
                    {
                        <div class="book-cover-placeholder">Cover pending</div>
                    }
                </div>
                <div class="book-info">
                    <div class="label text-amber-800">Not ready for checkout</div>
                    <h1 class="book-title text-slate-900">@pbTitle</h1>
                    <p class="book-description text-slate-600">
                        @if (isPrintReadyFlow)
                        {
                            <text>Print-ready mode is active. Finalize your manuscript status in <a href="/Books/AIGenerateBook?bookId=@bookId" class="text-violet-700 font-semibold underline">AI Writer</a> and keep formatting updated in <a href="/BookDesign/CoverDesignCalculatorFixing?bookId=@bookId" class="text-violet-700 font-semibold underline">Formatting</a>, then return to calculate wrap dimensions.</text>
                        }
                        else
                        {
                            <text>Publishing checkout unlocks when the book is marked <strong>Finalized</strong> (or <strong>Published</strong> / <strong>Paid</strong>) and a saved cover is on file. Finish <a href="/Books/AIGenerateBook?bookId=@bookId" class="text-violet-700 font-semibold underline">AI Writer</a>, <a href="/BookDesign/CoverDesignCalculatorFixing?bookId=@bookId" class="text-violet-700 font-semibold underline">formatting</a>, and <a href="/Dashboard/CoverDesign?bookId=@bookId" class="text-violet-700 font-semibold underline">cover design</a>, then return.</text>
                        }
                    </p>
                    <p class="text-sm text-slate-500">Current status: <strong>@(string.IsNullOrEmpty(pbStatus) ? "Draft" : pbStatus)</strong></p>
                </div>
            </div>
        }
        else
        {
            <div class="book-card">
                <div class="book-cover">
                    <div class="book-cover-placeholder">Select a book</div>
                </div>
                <div class="book-info">
                    <div class="label">No book selected</div>
                    <h1 class="book-title">Choose a book to publish</h1>
                    <p class="book-description">
                        Open <a href="/Dashboard/MyBooks" class="text-violet-700 font-semibold underline">My Books</a> or <a href="/Dashboard/CoverDesign" class="text-violet-700 font-semibold underline">Cover Design</a> and pick a title, or add <code class="bg-slate-100 px-1 rounded">?bookId=</code> to this page URL after creating a book in AI Writer.
                    </p>
                    <div class="mt-4 flex flex-wrap gap-3">
                        <a href="/Dashboard/MyBooks" class="inline-flex items-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700">Go to My Books</a>
                        <a href="/Books/AIGenerateBook" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white text-slate-800 font-semibold px-5 py-2.5 text-sm hover:bg-slate-50">Create in AI Writer</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="publish-sections">
        @if (isPrintReadyFlow && bookId > 0)
        {
            <section class="publish-card publish-card--printready">
                <h2 class="text-lg font-semibold text-slate-900 mb-2 publish-card-title"><i class="fas fa-check-circle"></i><span>Print-ready flow active</span></h2>
                <p class="text-sm text-slate-500 mb-3 publish-card-sub">KDP-style template panel removed. Use the three action buttons above for final publish, KDP cover download, and full book PDF download.</p>
                <p class="text-xs text-slate-500">Source-of-truth page count: <strong>@(pbEstimatedPages > 0 ? pbEstimatedPages : 0)</strong> · Stripe checkout uses server-side validation.</p>
                <p id="pub-stripe-err" class="text-sm text-red-600 hidden mt-3"></p>
            </section>
        }
        else
        {
            @if (publishReady || bookId <= 0)
            {
            <section class="publish-card publish-card--checkout">
                <h2 class="text-lg font-semibold text-slate-900 mb-2 publish-card-title"><i class="fas fa-rocket"></i><span>List your book on Ebook Hub</span></h2>
                <p class="text-sm text-slate-500 mb-4 publish-card-sub">Complete these fields for this release. Publishing requires a successful Stripe payment — your book is marked Published only after checkout succeeds.</p>
                <div class="publish-form-grid grid md:grid-cols-2 gap-4 mb-6">
                    <label class="block text-sm">
                        <span class="text-slate-700 font-medium">Retail price (USD)</span>
                        <input type="text" id="pubRetailPrice" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-violet-500/30 focus:border-violet-500 outline-none" placeholder="9.99" value="9.99" autocomplete="off" />
                    </label>
                    <label class="block text-sm">
                        <span class="text-slate-700 font-medium">Primary category</span>
                        <input type="text" id="pubCategory" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-violet-500/30 focus:border-violet-500 outline-none" placeholder="Fiction / Business" value="@pbGenre" autocomplete="off" />
                    </label>
                    <div class="block text-sm md:col-span-2">
                        <span class="text-slate-700 font-medium">Publishing format</span>
                        <input type="hidden" id="pubFormat" value="Ebook" />
                        <div id="pubFormatOptions" class="mt-1 inline-flex items-center rounded-xl border border-slate-200 bg-white p-1 gap-1">
                            <button type="button" data-format="Ebook" class="pub-format-btn rounded-lg px-4 py-2 text-sm font-semibold bg-violet-600 text-white">Ebook</button>
                            <button type="button" data-format="Paperback" class="pub-format-btn rounded-lg px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Paperback</button>
                        </div>
                    </div>
                    <label class="block text-sm md:col-span-2">
                        <span class="text-slate-700 font-medium">Distribution territories</span>
                        <select id="pubTerritories" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-violet-500/30 focus:border-violet-500 outline-none bg-white">
                            <option value="worldwide" selected>Worldwide (all marketplaces)</option>
                            <option value="us">United States only</option>
                            <option value="uk-eu">UK &amp; EU</option>
                        </select>
                    </label>
                    <label class="flex items-start gap-2 md:col-span-2 text-sm text-slate-600 cursor-pointer">
                        <input type="checkbox" id="pubAgree" class="mt-1 rounded border-slate-300 text-violet-600 focus:ring-violet-500" />
                        <span>I confirm I hold rights to publish this work and accept the platform listing terms for this release.</span>
                    </label>
                </div>
                @if (alreadyListed)
                {
                    <div class="rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-900 text-sm px-4 py-3 mb-4">
                        This book already has a completed payment or publish status. Open <a href="/Dashboard/MyBooks" class="font-semibold underline">My Books</a> to manage downloads.
                    </div>
                }
                <div class="flex flex-wrap gap-3 items-center">
                    @if (alreadyListed)
                    {
                        <button type="button" id="btnStripePublish" disabled class="inline-flex items-center gap-2 rounded-xl bg-slate-300 text-slate-600 font-semibold px-5 py-3 text-sm cursor-not-allowed">
                            <i class="fas fa-credit-card"></i> Pay &amp; publish with Stripe
                        </button>
                    }
                    else
                    {
                        <button type="button" id="btnStripePublish" class="publish-stripe-btn inline-flex items-center gap-2 rounded-xl bg-violet-700 text-white font-semibold px-5 py-3 text-sm shadow-md hover:bg-violet-800 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-credit-card"></i> Pay &amp; publish with Stripe
                        </button>
                    }
                    <span id="pub-stripe-hint" class="text-xs text-slate-500">Secure Checkout · Book ID @(bookId > 0 ? bookId.ToString() : "— select a book from Cover Design or My Books")</span>
                </div>
                <p id="pub-stripe-err" class="text-sm text-red-600 mt-3 hidden"></p>
            </section>
            }

            @if (!publishReady && bookId > 0)
            {
                <p class="text-center text-sm text-slate-500 py-2">Complete the steps above to enable checkout.</p>
            }

            @if (publishReady)
            {
            <section class="publish-card publish-card--pipeline">
                <h2 class="text-lg font-semibold text-slate-900 mb-2 publish-card-title"><i class="fas fa-route"></i><span>Your publishing pipeline</span></h2>
                <ol class="publish-pipeline-list">
                    <li><a href="/Books/AIGenerateBook" class="text-violet-600 hover:underline">AI Writer</a> — manuscript</li>
                    <li><a href="/Books/AIGenerateBookFormat" class="text-violet-600 hover:underline">Formatting</a></li>
                    <li><a href="/Dashboard/CoverDesign" class="text-violet-600 hover:underline">AI cover design</a></li>
                    <li>Publish — payment &amp; distribution (this page)</li>
                </ol>
            </section>

            <section class="publish-card publish-card--platforms">
                <h2 class="text-lg font-semibold text-slate-900 mb-1 publish-card-title"><i class="fas fa-globe"></i><span>Option A — External platforms</span></h2>
                <p class="text-sm text-slate-500 mb-4 publish-card-sub">Checklists and embedded YouTube tutorials.</p>
                <div class="publish-platform-grid">
                    <button type="button" class="group text-left rounded-2xl border border-slate-200/90 bg-white shadow-sm hover:shadow-xl hover:shadow-violet-500/10 hover:border-violet-200/80 hover:-translate-y-0.5 transition-all duration-300 overflow-hidden publish-platform-btn" data-platform="kdp">
                        <div class="publish-platform-media aspect-[16/10] overflow-hidden bg-slate-100">
                            <img src="https://images.unsplash.com/photo-1543002588-bfa74002ed7e?q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async">
                        </div>
                        <div class="publish-platform-body p-4">
                            <div class="publish-platform-name"><i class="fab fa-amazon text-amber-600 mr-2"></i>Amazon KDP</div>
                            <div class="publish-platform-sub">eBook, paperback, hardcover</div>
                        </div>
                    </button>
                    <button type="button" class="group text-left rounded-2xl border border-slate-200/90 bg-white shadow-sm hover:shadow-xl hover:shadow-violet-500/10 hover:border-violet-200/80 hover:-translate-y-0.5 transition-all duration-300 overflow-hidden publish-platform-btn" data-platform="bn">
                        <div class="publish-platform-media aspect-[16/10] overflow-hidden bg-slate-100">
                            <img src="https://images.unsplash.com/photo-1507842217343-583bb7270b66?q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async">
                        </div>
                        <div class="publish-platform-body p-4">
                            <div class="publish-platform-name"><i class="fas fa-book text-slate-600 mr-2"></i>Barnes &amp; Noble Press</div>
                            <div class="publish-platform-sub">NOOK &amp; print</div>
                        </div>
                    </button>
                    <button type="button" class="group text-left rounded-2xl border border-slate-200/90 bg-white shadow-sm hover:shadow-xl hover:shadow-violet-500/10 hover:border-violet-200/80 hover:-translate-y-0.5 transition-all duration-300 overflow-hidden publish-platform-btn" data-platform="lulu">
                        <div class="publish-platform-media aspect-[16/10] overflow-hidden bg-slate-100">
                            <img src="https://images.unsplash.com/photo-1589829085413-56de8ae18c73?q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async">
                        </div>
                        <div class="publish-platform-body p-4">
                            <div class="publish-platform-name"><i class="fas fa-print text-purple-600 mr-2"></i>Lulu</div>
                            <div class="publish-platform-sub">Print &amp; global reach</div>
                        </div>
                    </button>
                    <button type="button" class="group text-left rounded-2xl border border-slate-200/90 bg-white shadow-sm hover:shadow-xl hover:shadow-violet-500/10 hover:border-violet-200/80 hover:-translate-y-0.5 transition-all duration-300 overflow-hidden publish-platform-btn" data-platform="ingram">
                        <div class="publish-platform-media aspect-[16/10] overflow-hidden bg-slate-100">
                            <img src="https://images.unsplash.com/photo-1554774853-719586f37d05?q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async">
                        </div>
                        <div class="publish-platform-body p-4">
                            <div class="publish-platform-name"><i class="fas fa-network-wired text-indigo-600 mr-2"></i>IngramSpark</div>
                            <div class="publish-platform-sub">Wide distribution</div>
                        </div>
                    </button>
                </div>
            </section>

            <section class="publish-card publish-card--pro publish-paid-wrap @(paid ? "" : "disabled")">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                    <div>
                        <h2 class="text-lg font-semibold text-slate-900 publish-card-title"><i class="fas fa-crown"></i><span>Option B — Publish through our platform</span></h2>
                        <p class="text-sm text-slate-500 publish-card-sub">We handle submission, metadata, and distribution on your behalf.</p>
                    </div>
                    @if (!paid)
                    {
                        <span class="publish-badge-disabled" title="Available after plan upgrade"><i class="fas fa-lock"></i> Premium</span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full">Active</span>
                    }
                </div>
                <div class="grid md:grid-cols-3 gap-4 text-sm @premiumDimClass">
                    <div class="publish-metric">
                        <p class="font-semibold text-slate-800 mb-1">Timeline</p>
                        <p class="text-slate-600">Estimated 14–21 business days from approved files to live listings (demo).</p>
                    </div>
                    <div class="publish-metric">
                        <p class="font-semibold text-slate-800 mb-1">Distribution</p>
                        <p class="text-slate-600">Major English-language channels + library partners.</p>
                    </div>
                    <div class="publish-metric">
                        <p class="font-semibold text-slate-800 mb-1">Revenue</p>
                        <p class="text-slate-600">Net royalties after platform fees; 85% to author on direct sales (demo).</p>
                    </div>
                </div>
                <div class="mt-4 flex flex-wrap gap-3 @premiumDimClass">
                    @if (paid)
                    {
                        <button type="button" id="btnSubmitFullService" class="inline-flex items-center gap-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-semibold px-5 py-2.5 text-sm shadow-md transition-colors">
                            <i class="fas fa-paper-plane"></i> Submit for full-service publish
                        </button>
                    }
                    else
                    {
                        <button type="button" id="btnSubmitFullService" disabled class="inline-flex items-center gap-2 rounded-xl bg-slate-300 text-slate-500 font-semibold px-5 py-2.5 text-sm cursor-not-allowed opacity-60">
                            <i class="fas fa-paper-plane"></i> Submit for full-service publish
                        </button>
                    }
                    <a href="/Payments/FeaturesSelection" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium px-5 py-2.5 text-sm">View plans</a>
                </div>
            </section>
            }
        }
    </div>
</div>

</main>
</div>

<div id="publishDetailOverlay" class="publish-detail-overlay" role="dialog" aria-modal="true">
    <div class="publish-detail-box">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 bg-violet-700 text-white">
            <h3 id="publishDetailTitle" class="text-lg font-semibold">Guide</h3>
            <button type="button" id="publishDetailClose" class="p-2 rounded-lg hover:bg-white/15 text-white" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-5 overflow-y-auto flex-1">
            <div class="publish-progress" id="publishProgressBar"></div>
            <div id="publishDetailSteps"></div>
            <div class="mt-5 rounded-xl overflow-hidden border border-slate-200 bg-slate-900 aspect-video">
                <div id="publishVideoSlot" class="w-full h-full min-h-[200px]"></div>
            </div>
        </div>
    </div>
</div>

@if (!alreadyListed && bookId > 0 && publishReady)
{
    <script src="https://js.stripe.com/v3/"></script>
}
<script>
(function () {
    var paid = @((ViewBag.PublishViaPlatformPaid as bool? ?? false).ToString().ToLowerInvariant());
    var bookId = @(bookId);
    var publishReady = @(publishReady.ToString().ToLowerInvariant());
    var alreadyListed = @(alreadyListed.ToString().ToLowerInvariant());
    var isPrintReadyFlow = @(isPrintReadyFlow.ToString().ToLowerInvariant());
    var publishableKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(publishableKey));
    var pbTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbTitle));
    var pbGenre = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbGenre));
    var pbDesc = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbDesc));
    var pbEstimatedPages = @(pbEstimatedPages);

    function initPrintReadyCalculator() {
        if (!isPrintReadyFlow) return;
        var trimMap = {
            '6x9': { w: 6, h: 9 },
            '5.5x8.5': { w: 5.5, h: 8.5 },
            '8.5x11': { w: 8.5, h: 11 }
        };
        var pageInput = document.getElementById('prPageCount');
        var trimSelect = document.getElementById('prTrimSize');
        var interiorSelect = document.getElementById('prInteriorType');
        var spineInEl = document.getElementById('prSpineIn');
        var spineMmEl = document.getElementById('prSpineMm');
        var wrapInEl = document.getElementById('prWrapIn');
        var wrapMmEl = document.getElementById('prWrapMm');
        var syncedPageEl = document.getElementById('prSyncedPageCount');
        if (!pageInput || !trimSelect || !interiorSelect || !spineInEl || !spineMmEl || !wrapInEl || !wrapMmEl) return;

        function toMm(vIn) { return vIn * 25.4; }
        function fmtNum(v, d) { return Number(v || 0).toFixed(d); }
        function recalc() {
            var pages = parseInt(pageInput.value || '200', 10);
            if (!Number.isFinite(pages)) pages = 200;
            pages = Math.max(24, Math.min(828, pages));
            pageInput.value = String(pages);
            if (syncedPageEl && pbEstimatedPages > 0) syncedPageEl.textContent = String(pbEstimatedPages);
            var trim = trimMap[trimSelect.value] || trimMap['6x9'];
            var mult = interiorSelect.value === 'color' ? 0.002347 : 0.002252;
            var bleed = 0.125;
            var spineIn = Math.max(0.055, pages * mult);
            var wrapWIn = (trim.w * 2) + spineIn + (bleed * 2);
            var wrapHIn = trim.h + (bleed * 2);
            spineInEl.textContent = fmtNum(spineIn, 3) + ' in';
            spineMmEl.textContent = fmtNum(toMm(spineIn), 2) + ' mm';
            wrapInEl.textContent = fmtNum(wrapWIn, 3) + ' × ' + fmtNum(wrapHIn, 3) + ' in';
            wrapMmEl.textContent = fmtNum(toMm(wrapWIn), 2) + ' × ' + fmtNum(toMm(wrapHIn), 2) + ' mm';
        }
        [pageInput, trimSelect, interiorSelect, document.getElementById('prBindingType'), document.getElementById('prPaperType')]
            .forEach(function (el) { if (el) el.addEventListener('input', recalc); if (el) el.addEventListener('change', recalc); });
        recalc();
    }

    function showTransientMessage(kind, text) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: kind,
                text: text,
                timer: 2600,
                showConfirmButton: false
            });
        } else {
            alert(text);
        }
    }

    function downloadBlobAsFile(blob, filename) {
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
    }

    function safeBookSlug() {
        return String(pbTitle || 'book')
            .toLowerCase()
            .replace(/[^\w\s-]+/g, '')
            .replace(/\s+/g, '-')
            .replace(/^-+|-+$/g, '') || 'book';
    }

    function runPublishPdfDownload(triggerBtn) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }
        if (triggerBtn) triggerBtn.disabled = true;

        fetch('/Dashboard/DownloadBookPdf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                bookId: bookId,
                displayTitle: pbTitle || '',
                displayAuthor: '',
                displayGenre: pbGenre || '',
                publishingPlatform: isPrintReadyFlow ? 'Just Print Ready File' : null
            })
        })
            .then(function (res) {
                if (!res.ok) {
                    return res.text().then(function (t) {
                        throw new Error(t || 'Could not generate PDF.');
                    });
                }
                return res.blob();
            })
            .then(function (blob) {
                downloadBlobAsFile(blob, safeBookSlug() + '-' + bookId + '.pdf');
                showTransientMessage('success', 'Full print-ready PDF download started.');
            })
            .catch(function (err) {
                showTransientMessage('error', err && err.message ? err.message : 'PDF download failed.');
            })
            .finally(function () {
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

    function runInteriorPdfDownload(triggerBtn) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }
        if (triggerBtn) triggerBtn.disabled = true;
        fetch('/Dashboard/DownloadBookInteriorPdf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                bookId: bookId,
                displayTitle: pbTitle || '',
                displayAuthor: '',
                displayGenre: pbGenre || '',
                publishingPlatform: isPrintReadyFlow ? 'Just Print Ready File' : null
            })
        })
            .then(function (res) {
                if (!res.ok) {
                    return res.text().then(function (t) { throw new Error(t || 'Could not generate interior PDF.'); });
                }
                return res.blob();
            })
            .then(function (blob) {
                downloadBlobAsFile(blob, safeBookSlug() + '-' + bookId + '-interior.pdf');
                showTransientMessage('success', 'Interior-only PDF download started.');
            })
            .catch(function (err) {
                showTransientMessage('error', err && err.message ? err.message : 'Interior PDF download failed.');
            })
            .finally(function () {
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

    function runCoverWrapDownload(triggerBtn) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }
        if (triggerBtn) triggerBtn.disabled = true;
        fetch('/Dashboard/DownloadPrintReadyCoverAsset?bookId=' + encodeURIComponent(bookId) + '&part=wrap')
            .then(function (res) {
                if (!res.ok) throw new Error('Cover wrap not available yet. Generate print-ready cover first.');
                return Promise.all([res.blob(), res.headers.get('content-type') || 'image/png']);
            })
            .then(function (pair) {
                var blob = pair[0];
                var ctype = pair[1];
                var ext = ctype.indexOf('jpeg') >= 0 ? 'jpg' : (ctype.indexOf('webp') >= 0 ? 'webp' : 'png');
                downloadBlobAsFile(blob, safeBookSlug() + '-' + bookId + '-cover-wrap.' + ext);
                showTransientMessage('success', 'Cover wrap download started.');
            })
            .catch(function (err) {
                showTransientMessage('error', err && err.message ? err.message : 'Cover wrap download failed.');
            })
            .finally(function () {
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

    var guides = {
        kdp: {
            title: 'How to publish on Amazon KDP',
            videoId: 'APLYMkoa9o0',
            steps: [
                'Create or sign in to your Amazon account and open Kindle Direct Publishing (KDP).',
                'Add your author name, contributor roles, and publisher imprint (if any).',
                'Enter bank account details and complete tax interview (W-9 / W-8BEN as applicable).',
                'Choose format: Kindle eBook, paperback, and/or hardcover; set trim size for print.',
                'Upload your interior manuscript and cover files.',
                'Set list price, territories, and optional KDP Select enrollment, then publish.'
            ]
        },
        bn: {
            title: 'Barnes & Noble Press',
            videoId: 'APLYMkoa9o0',
            steps: [
                'Create a B&amp;N Press account and verify your email.',
                'Enter author and publisher information.',
                'Add payment and tax profile for royalties.',
                'Pick eBook or print format and interior specifications.',
                'Upload manuscript and cover; run the built-in validator.',
                'Set pricing and territories, then submit for review.'
            ]
        },
        lulu: {
            title: 'Lulu publishing',
            videoId: 'uoqV1JuU3Gg',
            steps: [
                'Sign up at Lulu and start a new book project.',
                'Choose book size, binding, and paper type.',
                'Upload interior PDF and cover (single PDF wrap for print).',
                'Order a proof copy before wide distribution.',
                'Connect to global retail channels if desired.',
                'Set retail price and publish.'
            ]
        },
        ingram: {
            title: 'IngramSpark',
            videoId: 'APLYMkoa9o0',
            steps: [
                'Create an IngramSpark account and add publisher details.',
                'Complete compensation (bank) and tax forms.',
                'Select trim size, laminate, and distribution options.',
                'Upload print-ready PDF interior and cover with correct spine width.',
                'Set list price, returns, and discount for retailers.',
                'Approve eProof and enable distribution.'
            ]
        }
    };

    function buildPublishLearningModalHtml() {
        var kdp = [
            { id: 'APLYMkoa9o0', t: 'Complete beginner guide to Amazon KDP' },
            { id: 'oXIu2lJOLO8', t: 'How to upload your KDP book (beginners)' },
            { id: 'H4x8fH-vd1g', t: 'KDP upload: step-by-step tutorial' }
        ];
        var lulu = [
            { id: 'uoqV1JuU3Gg', t: 'Lulu — print book & global distribution' },
            { id: 'XhXnr5QrUY8', t: 'Lulu — print formatting essentials' },
            { id: 'HM410PAhnAg', t: 'Lulu — cover file setup (Photoshop)' }
        ];
        function rows(list) {
            return list.map(function (v) {
                return '<div class="pub-learn-card">' +
                    '<div class="pub-learn-card-head">' + v.t + '</div>' +
                    '<div class="pub-learn-embed"><iframe loading="lazy" src="https://www.youtube.com/embed/' + v.id + '?rel=0&modestbranding=1" title="YouTube tutorial" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div></div>';
            }).join('');
        }
        return '<div class="pub-learn-wrap">' +
            '<p class="pub-learn-lede">Curated YouTube walkthroughs for <strong>Amazon KDP</strong> and <strong>Lulu</strong> (uploads, formatting, covers). Third-party creators — always verify latest requirements on each platform. When you are ready, continue to Stripe.</p>' +
            '<div class="pub-learn-tabs" role="tablist">' +
            '<button type="button" class="pub-learn-tab pub-learn-tab--active" data-pub-tab="kdp"><i class="fab fa-amazon"></i> Amazon KDP</button>' +
            '<button type="button" class="pub-learn-tab" data-pub-tab="lulu"><i class="fas fa-print"></i> Lulu</button></div>' +
            '<div class="pub-learn-panels">' +
            '<div class="pub-learn-panel pub-learn-panel--active" data-pub-panel="kdp">' + rows(kdp) + '</div>' +
            '<div class="pub-learn-panel" data-pub-panel="lulu">' + rows(lulu) + '</div></div></div>';
    }

    function wirePublishLearningTabs(container) {
        if (!container) return;
        container.querySelectorAll('.pub-learn-tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
                var key = tab.getAttribute('data-pub-tab');
                container.querySelectorAll('.pub-learn-tab').forEach(function (t) {
                    t.classList.toggle('pub-learn-tab--active', t === tab);
                });
                container.querySelectorAll('.pub-learn-panel').forEach(function (p) {
                    p.classList.toggle('pub-learn-panel--active', p.getAttribute('data-pub-panel') === key);
                });
            });
        });
    }

    function mountVideo(videoId) {
        var slot = document.getElementById('publishVideoSlot');
        if (!slot) return;
        if (!videoId) {
            slot.innerHTML = '<div class="flex items-center justify-center h-full min-h-[200px] text-slate-400 text-sm p-4 text-center">Tutorial video unavailable.</div>';
            return;
        }
        var src = 'https://www.youtube.com/embed/' + videoId + '?rel=0&modestbranding=1';
        slot.innerHTML = '<iframe class="publish-video-frame w-full h-full min-h-[220px]" src="' + src + '" title="YouTube tutorial" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>';
    }

    function openDetail(key) {
        var g = guides[key];
        if (!g) return;
        document.getElementById('publishDetailTitle').innerHTML = g.title;
        var stepsEl = document.getElementById('publishDetailSteps');
        var prog = document.getElementById('publishProgressBar');
        stepsEl.innerHTML = '';
        prog.innerHTML = '';
        g.steps.forEach(function (text, i) {
            var row = document.createElement('div');
            row.className = 'publish-step';
            row.innerHTML = '<span class="publish-step-num">' + (i + 1) + '</span><span>' + text + '</span>';
            stepsEl.appendChild(row);
            var dot = document.createElement('span');
            dot.className = 'done';
            prog.appendChild(dot);
        });
        mountVideo(g.videoId);
        document.getElementById('publishDetailOverlay').classList.add('open');
    }

    document.querySelectorAll('.publish-platform-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { openDetail(this.getAttribute('data-platform')); });
    });
    document.getElementById('publishDetailClose').addEventListener('click', function () {
        document.getElementById('publishDetailOverlay').classList.remove('open');
        var slot = document.getElementById('publishVideoSlot');
        if (slot) slot.innerHTML = '';
    });
    document.getElementById('publishDetailOverlay').addEventListener('click', function (e) {
        if (e.target === this) {
            this.classList.remove('open');
            var slot = document.getElementById('publishVideoSlot');
            if (slot) slot.innerHTML = '';
        }
    });

    var sub = document.getElementById('btnSubmitFullService');
    if (sub) sub.addEventListener('click', function () {
        if (!paid) {
            if (typeof Swal !== 'undefined') Swal.fire({ icon: 'info', title: 'Premium', text: 'Upgrade your plan for full-service publishing.', confirmButtonColor: '#7c3aed' });
            else alert('Premium feature');
            return;
        }
        if (typeof Swal !== 'undefined') Swal.fire({ icon: 'success', title: 'Submitted (demo)', text: 'Our team would contact you within 1 business day.', confirmButtonColor: '#7c3aed' });
        else alert('Submitted (demo)');
    });

    var stripeBtn = document.getElementById('btnStripePublish');
    var errEl = document.getElementById('pub-stripe-err');
    var pubFormatOptions = document.getElementById('pubFormatOptions');
    var pubFormatInput = document.getElementById('pubFormat');

    if (pubFormatOptions && pubFormatInput) {
        pubFormatOptions.addEventListener('click', function (e) {
            var btn = e.target && e.target.closest ? e.target.closest('.pub-format-btn') : null;
            if (!btn) return;
            var v = btn.getAttribute('data-format') || 'Ebook';
            pubFormatInput.value = v;
            pubFormatOptions.querySelectorAll('.pub-format-btn').forEach(function (b) {
                var active = b === btn;
                b.classList.toggle('bg-violet-600', active);
                b.classList.toggle('text-white', active);
                b.classList.toggle('text-slate-700', !active);
            });
        });
    }

    function setImgOrLabel(imgEl, labelEl, value) {
        if (!imgEl || !labelEl) return;
        if (value) {
            imgEl.src = value;
            imgEl.classList.remove('hidden');
            labelEl.classList.add('hidden');
        } else {
            imgEl.src = '';
            imgEl.classList.add('hidden');
            labelEl.classList.remove('hidden');
        }
    }

    function runPrintReadyAutoCover(triggerBtn) {
        if (!isPrintReadyFlow || !bookId || bookId <= 0) return;
        var statusEl = document.getElementById('pr-cover-status');
        var trimEl = document.getElementById('prTrimSize');
        var prPageInput = document.getElementById('prPageCount');
        var pageCount = pbEstimatedPages > 0 ? pbEstimatedPages : parseInt((prPageInput && prPageInput.value) || '0', 10);

        if (triggerBtn) triggerBtn.disabled = true;
        if (statusEl) statusEl.textContent = 'Generating back + spine + front cover set...';

        fetch('/Dashboard/GeneratePrintReadyCover', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
                bookId: bookId,
                trimSize: trimEl ? trimEl.value : '6x9',
                pageCount: pageCount
            })
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data || data.success === false) {
                    throw new Error((data && data.message) || 'Could not generate print-ready cover.');
                }

                var wrapImg = document.getElementById('prWrapPreview');
                var wrapPlaceholder = document.getElementById('prWrapPlaceholder');
                var wrap = data.cover && data.cover.wrap ? data.cover.wrap : '';
                if (wrapImg) {
                    if (wrap) {
                        wrapImg.src = wrap;
                        wrapImg.classList.remove('hidden');
                        if (wrapPlaceholder) wrapPlaceholder.classList.add('hidden');
                    } else {
                        wrapImg.src = '';
                        wrapImg.classList.add('hidden');
                        if (wrapPlaceholder) wrapPlaceholder.classList.remove('hidden');
                    }
                }

                setImgOrLabel(document.getElementById('prBackPreview'), document.getElementById('prBackLabel'), data.cover && data.cover.back ? data.cover.back : '');
                setImgOrLabel(document.getElementById('prSpinePreview'), document.getElementById('prSpineLabel'), data.cover && data.cover.spine ? data.cover.spine : '');
                setImgOrLabel(document.getElementById('prFrontPreview'), document.getElementById('prFrontLabel'), data.cover && data.cover.front ? data.cover.front : '');

                if (data.pageCount && prPageInput) prPageInput.value = String(data.pageCount);
                if (statusEl) statusEl.textContent = 'Auto-cover generated from title/content. Ready for checkout + export.';
            })
            .catch(function (err) {
                if (statusEl) statusEl.textContent = (err && err.message) ? err.message : 'Auto cover generation failed.';
                showTransientMessage('error', (err && err.message) ? err.message : 'Auto cover generation failed.');
            })
            .finally(function () {
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

    function runStripePublishCheckout(opts) {
        var activeBtn = (opts && opts.button) ? opts.button : stripeBtn;
        if (!activeBtn) return;
        activeBtn.disabled = true;
        if (errEl) { errEl.classList.add('hidden'); errEl.textContent = ''; }
        var publishFormat = (document.getElementById('pubFormat') && document.getElementById('pubFormat').value) || 'Ebook';
        var requestedPageCount = (opts && opts.pageCount) ? opts.pageCount : (pbEstimatedPages > 0 ? pbEstimatedPages : 0);
        fetch('/Checkout/CreateBookCheckoutSession', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                bookId: bookId,
                publishIntent: true,
                format: publishFormat,
                pageCount: requestedPageCount,
                printReadyFlow: !!(opts && opts.printReadyFlow)
            })
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.alreadyPaid) {
                    window.location.href = '/Dashboard/MyBooks';
                    return;
                }
                if (data.url) {
                    window.location.href = data.url;
                    return;
                }
                if (data.sessionId && typeof Stripe !== 'undefined' && publishableKey) {
                    var stripe = Stripe(publishableKey);
                    return stripe.redirectToCheckout({ sessionId: data.sessionId }).then(function (result) {
                        if (result.error && errEl) { errEl.textContent = result.error.message || 'Checkout failed.'; errEl.classList.remove('hidden'); }
                        activeBtn.disabled = false;
                    });
                }
                if (errEl) { errEl.textContent = data.message || 'Could not start checkout. Is Stripe configured?'; errEl.classList.remove('hidden'); }
                activeBtn.disabled = false;
            })
            .catch(function () {
                if (errEl) { errEl.textContent = 'Network error. Please try again.'; errEl.classList.remove('hidden'); }
                activeBtn.disabled = false;
            });
    }

    var pdfBtn = document.getElementById('btnDownloadEbook');
    var pdfBtnPrint = document.getElementById('btnDownloadEbookPrint');
    var fullBookBtn = document.getElementById('btnDownloadFullBookPdf');
    var interiorBtn = document.getElementById('btnDownloadInteriorPdf');
    var coverWrapBtn = document.getElementById('btnDownloadCoverWrap');
    var kdpCoverBtn = document.getElementById('btnDownloadKdpCover');
    var printReadyPublishPrimaryBtn = document.getElementById('btnPrintReadyPublishPrimary');
    if (pdfBtn) {
        pdfBtn.addEventListener('click', function () { runPublishPdfDownload(pdfBtn); });
    }
    if (pdfBtnPrint) {
        pdfBtnPrint.addEventListener('click', function () { runPublishPdfDownload(pdfBtnPrint); });
    }
    if (fullBookBtn) {
        fullBookBtn.addEventListener('click', function () { runPublishPdfDownload(fullBookBtn); });
    }
    if (interiorBtn) {
        interiorBtn.addEventListener('click', function () { runInteriorPdfDownload(interiorBtn); });
    }
    if (coverWrapBtn) {
        coverWrapBtn.addEventListener('click', function () { runCoverWrapDownload(coverWrapBtn); });
    }
    if (kdpCoverBtn) {
        kdpCoverBtn.addEventListener('click', function () { runCoverWrapDownload(kdpCoverBtn); });
    }

    if (stripeBtn && !isPrintReadyFlow && !alreadyListed && bookId > 0 && publishReady) {
        stripeBtn.addEventListener('click', function () {
            var agree = document.getElementById('pubAgree');
            if (agree && !agree.checked) {
                if (typeof Swal !== 'undefined') Swal.fire({ icon: 'warning', title: 'Confirmation required', text: 'Please confirm rights and terms before paying.', confirmButtonColor: '#7c3aed' });
                else alert('Please confirm rights and terms.');
                return;
            }
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: '<span style="font-family:Georgia,\'Playfair Display\',serif;font-weight:600;font-size:1.35rem;color:#5b21b6">Publish hub</span>',
                    html: buildPublishLearningModalHtml(),
                    width: 920,
                    showCancelButton: true,
                    confirmButtonText: 'Continue to Stripe checkout',
                    cancelButtonText: 'Not yet',
                    confirmButtonColor: '#7c3aed',
                    cancelButtonColor: '#94a3b8',
                    focusConfirm: false,
                    customClass: {
                        popup: 'publish-learning-swal-popup',
                        actions: 'publish-learning-swal-actions',
                        confirmButton: 'rounded-xl px-5 py-2.5 text-sm font-semibold shadow-md',
                        cancelButton: 'rounded-xl px-5 py-2.5 text-sm font-semibold'
                    },
                    didOpen: function () {
                        wirePublishLearningTabs(Swal.getHtmlContainer());
                    }
                }).then(function (res) {
                    if (res.isConfirmed) runStripePublishCheckout();
                });
            } else {
                runStripePublishCheckout();
            }
        });
    }

    if (printReadyPublishPrimaryBtn && isPrintReadyFlow && !alreadyListed && bookId > 0 && publishReady) {
        printReadyPublishPrimaryBtn.addEventListener('click', function () {
            runStripePublishCheckout({
                button: printReadyPublishPrimaryBtn,
                pageCount: (pbEstimatedPages > 0 ? pbEstimatedPages : 0),
                printReadyFlow: true
            });
        });
    }

    var prGenerateBtn = document.getElementById('btnGeneratePrintReadyCover');
    if (prGenerateBtn && isPrintReadyFlow && bookId > 0) {
        prGenerateBtn.addEventListener('click', function () { runPrintReadyAutoCover(prGenerateBtn); });
        setTimeout(function () { runPrintReadyAutoCover(prGenerateBtn); }, 220);
    }

    initPrintReadyCalculator();
})();
</script>
