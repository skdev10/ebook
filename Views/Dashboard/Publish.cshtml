        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 16px -10px rgba(15, 23, 42, 0.9);
    }
    .kdp-pin.p1 { top: 7%; left: 3%; }
    .kdp-pin.p2 { top: 13%; left: 7%; }
    .kdp-pin.p3 { top: 19%; left: 11%; }
    .kdp-pin.p4 { top: 8%; left: 29%; }
    .kdp-pin.p5 { top: 11%; left: 36%; }
    .kdp-pin.p6 { top: 22%; left: 57%; }
    .kdp-pin.p7 { top: 30%; left: 57%; }
    .kdp-pin.p8 { top: 38%; left: 57%; }
    .kdp-pin.p9 { right: 17%; bottom: 29%; }
    .kdp-caption {
        font-size: 0.75rem;
        color: #64748b;
        line-height: 1.45;
    }
    .pr-cover-preview {
        border: 1px solid #e2e8f0;
        border-radius: 0.85rem;
        background: #f8fafc;
        min-height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    .pr-cover-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .pr-cover-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.5rem;
    }
    .pr-cover-tile {
        border: 1px solid #e2e8f0;
        border-radius: 0.65rem;
        background: #fff;
        min-height: 92px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
