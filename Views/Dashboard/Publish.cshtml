        --pub-muted: #64748b;
        --pub-accent: #5b21b6;
        font-family: 'Inter', sans-serif;
        margin: 0 auto;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .publish-simple-publish {
        margin-top: 1.5rem;
        padding: 1.5rem 1.65rem;
        border-radius: 1.15rem;
        border: 1px solid #ddd6fe;
        background: linear-gradient(180deg, #faf5ff 0%, #f5f3ff 100%);
