    function buildPrintWrapFromAssets(assets) {
        // Always use the server-saved wrap (same file as #publishWrapPreview). Never
        // client-recompose — that produced a different PNG than the preview strip.
        assets = normalizePublishCoverAssets(assets);
        if (!assets || !assets.cover) {
            return Promise.reject(new Error('Cover not available yet. Generate your cover in Cover Design first.'));
        }
        var wrapUrl = (assets.cover.wrap || '').trim();
        if (!wrapUrl) {
            return Promise.reject(new Error('Full wrap is not ready yet. Wait for generation, then try again.'));
        }
        return imageRefToBlob(wrapUrl).then(function (blob) { return { blob: blob, composed: null }; });
    }

    function runCoverWrapDownload(triggerBtn) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }

        function doDownload() {
            var serverUrl = '/Dashboard/DownloadPrintReadyCoverAsset?bookId=' + encodeURIComponent(bookId) + '&part=wrap';
            return fetch(serverUrl)
                .then(function (r) {
                    if (r.ok) {
                        return r.blob().then(function (blob) {
                            var ext = (r.headers.get('content-disposition') || '').indexOf('.jpg') >= 0 ? 'jpg' : 'png';
                            downloadBlobAsFile(blob, safeBookSlug() + '-' + bookId + '-kdp-full-wrap.' + ext);
                            redirectToDashboardAfterExport('Full wrap cover downloaded.', 'print');
                        });
                    }
                    // Server rebuilds wrap when missing — regenerate once, then retry download only.
                    return queuePrintWrapGeneration(true).then(function () {
                        return fetch(serverUrl).then(function (r2) {
                            if (!r2.ok) throw new Error('Full wrap download failed after rebuild. Open Cover Design and regenerate.');
                            return r2.blob().then(function (blob) {
                                var ext = (r2.headers.get('content-disposition') || '').indexOf('.jpg') >= 0 ? 'jpg' : 'png';
                                downloadBlobAsFile(blob, safeBookSlug() + '-' + bookId + '-kdp-full-wrap.' + ext);
                                redirectToDashboardAfterExport('Full wrap cover downloaded.', 'print');
                            });
                        });
                    });
                });
        }

        function finishErr(err) {
            showTransientMessage('error', err && err.message ? err.message : 'Cover wrap download failed.');
        }

        function finishFinally() {
            clearPublishButtonBusy(triggerBtn);
            if (triggerBtn) updateWrapExportButtonState(window._publishCoverAssets || {});
        }

        // Fast path: wrap already matches preview — download the same server file immediately.
        if (publishWrapCoverReady) {
            setPublishButtonBusy(triggerBtn, 'Downloading…');
            doDownload().catch(finishErr).finally(finishFinally);
            return;
        }

        startPublishDownloadUx(triggerBtn, 'Preparing…', 'Preparing full wrap cover',
            'Using the same full cover shown in preview. This usually takes a moment…');

        ensurePrintWrapGenerated()
            .then(function () {
                if (!publishWrapCoverReady) throw new Error('Full wrap could not be built. Open Cover Design and regenerate your front cover.');
                return doDownload();
            })
            .catch(finishErr)
            .finally(finishFinally);
    }

    function parseTrimSize(label) {
        var s = String(label || '6 x 9 in').toLowerCase();
        if (s.indexOf('5.5') >= 0 && s.indexOf('8.5') >= 0) return { w: 5.5, h: 8.5 };
        if (s.indexOf('8.5') >= 0 && s.indexOf('11') >= 0) return { w: 8.5, h: 11 };
        return { w: 6, h: 9 };
    }

    function imageRefToBase64(ref) {
        ref = (ref || '').trim();
        if (!ref) return Promise.reject(new Error('Missing cover image.'));
        if (ref.indexOf('data:image') === 0) {
            var i = ref.indexOf('base64,');
            return Promise.resolve(i >= 0 ? ref.substring(i + 7) : ref);
        }
        var url = ref.indexOf('http') === 0 || ref.indexOf('/') === 0 ? ref : ('/' + ref);
        return fetch(url).then(function (r) {
            if (!r.ok) throw new Error('Could not load cover wrap.');
            return r.blob();
        }).then(function (blob) {
            return new Promise(function (resolve, reject) {
                var reader = new FileReader();
                reader.onload = function () {
                    var data = String(reader.result || '');
                    var comma = data.indexOf(',');
                    resolve(comma >= 0 ? data.substring(comma + 1) : data);
                };
                reader.onerror = function () { reject(new Error('Could not read cover wrap.')); };
                reader.readAsDataURL(blob);
            });
        });
    }

