    function buildPrintWrapFromAssets(assets) {
        if (!assets || !assets.cover) return Promise.reject(new Error('Cover not available yet. Generate your cover in Cover Design first.'));
        var c = assets.cover;
        var frontUrl = (c.front || '').trim();
        var wrapUrl = (c.wrap || '').trim();
        var spineUrl = (c.spine || '').trim();
        var backUrl = (c.back || '').trim();
        if (!wrapUrl && !frontUrl) return Promise.reject(new Error('No cover image found. Generate a cover in Cover Design first.'));

        function composeAtKdp() {
            var realPages = resolvePublishPageCount(assets.pageCount);
            if (!realPages || realPages <= 0) {
                return Promise.reject(new Error('Page count is unknown. Open Book Formatting first, then try again.'));
            }
            if (!window.CoverKdpExport || typeof window.CoverKdpExport.composePrintWrapFromParts !== 'function') {
                return Promise.reject(new Error('Cover export module not loaded.'));
            }
            return window.CoverKdpExport.composePrintWrapFromParts(frontUrl, spineUrl, backUrl, {
                pageCount: realPages,
                dpi: 300,
                trimKey: '6x9',
                paperType: 'White paper',
                title: pbTitle || 'My Book',
                useApiSpineArt: !!spineUrl,
                useApiBackArt: !!backUrl
            });
        }

        if (wrapUrl) {
            return loadImageAspectRatio(wrapUrl).then(function (ratio) {
                if (isFullWrapAspectRatio(ratio)) {
                    return imageRefToBlob(wrapUrl).then(function (blob) { return { blob: blob, composed: null }; });
                }
                return composeAtKdp().then(function (result) {
                    if (!result || !result.dataUrl) throw new Error('Could not build full wrap from saved cover.');
                    var dataUrl = result.dataUrl;
                    var byteString = atob(dataUrl.split(',')[1]);
                    var ab = new ArrayBuffer(byteString.length);
                    var ia = new Uint8Array(ab);
                    for (var i = 0; i < byteString.length; i++) ia[i] = byteString.charCodeAt(i);
                    return { blob: new Blob([ab], { type: 'image/png' }), composed: result };
                });
            }).catch(function () {
                return composeAtKdp().then(function (result) {
                    if (!result || !result.dataUrl) throw new Error('Could not build full wrap from saved cover.');
                    var dataUrl = result.dataUrl;
                    var byteString = atob(dataUrl.split(',')[1]);
                    var ab = new ArrayBuffer(byteString.length);
                    var ia = new Uint8Array(ab);
                    for (var i = 0; i < byteString.length; i++) ia[i] = byteString.charCodeAt(i);
                    return { blob: new Blob([ab], { type: 'image/png' }), composed: result };
                });
            });
        }

        return composeAtKdp().then(function (result) {
            if (!result || !result.dataUrl) throw new Error('Could not build full wrap from saved cover.');
            var dataUrl = result.dataUrl;
            var byteString = atob(dataUrl.split(',')[1]);
            var ab = new ArrayBuffer(byteString.length);
            var ia = new Uint8Array(ab);
            for (var i = 0; i < byteString.length; i++) ia[i] = byteString.charCodeAt(i);
            return { blob: new Blob([ab], { type: 'image/png' }), composed: result };
        });
    }

