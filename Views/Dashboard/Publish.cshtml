    .pr-cover-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pr-cover-tile span { font-size: 0.72rem; color: #64748b; }
    .pr-sync-note {
        font-size: 0.74rem;
        color: #475569;
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        border-radius: 0.7rem;
