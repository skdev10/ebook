    }
    @@media (max-width: 1024px) {
        .publish-printready-shell {
            grid-template-columns: 1fr;
        }
        .kdp-template {
            min-height: 290px;
        }
        .pr-cover-grid {
            grid-template-columns: 1fr;
        }
    }
    .publish-paid-wrap { position: relative; }
    .publish-paid-wrap.disabled::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(248, 250, 252, 0.65);
        border-radius: 1.25rem;
        pointer-events: none;
    }
    .publish-badge-disabled {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        padding: 0.35rem 0.65rem;
        border-radius: 9999px;
    }

    .publish-detail-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 10050;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(6px);
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    .publish-detail-overlay.open { display: flex; }
    .publish-detail-box {
        background: #fff;
        border-radius: 1.25rem;
        max-width: 720px;
        width: 100%;
        max-height: 90vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border: 1px solid #e2e8f0;
    }
    .publish-step {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        padding: 0.65rem 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
        color: #334155;
    }
    .publish-step:last-child { border-bottom: 0; }
    .publish-step-num {
        flex-shrink: 0;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 0.75rem;
        background: #6d28d9;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .publish-progress { display: flex; gap: 0.35rem; margin: 1rem 0; flex-wrap: wrap; }
    .publish-progress span { flex: 1; min-width: 60px; height: 6px; border-radius: 9999px; background: #e2e8f0; }
