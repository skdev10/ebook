                btn.disabled = false;
                btn.innerHTML = original;
                if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Network error', text: 'Please try again.', confirmButtonColor: '#7c3aed' });
                else alert('Network error. Please try again.');
            });
        });
    })();

    // "Done — Go to Dashboard" (published/locked state) — reassure work is saved, then navigate.
    (function wireFinishButtons() {
        var finishBtns = document.querySelectorAll('.publish-finish-btn');
        Array.prototype.forEach.call(finishBtns, function (btn) {
            btn.addEventListener('click', function (e) {
                var href = btn.getAttribute('href') || '/Dashboard';
                var msg = btn.getAttribute('data-finish-toast') || 'Your work is saved.';
                if (typeof Swal === 'undefined') return; // let the normal link navigation happen
                e.preventDefault();
                Swal.fire({
                    icon: 'success',
                    title: 'Saved',
                    text: msg,
                    timer: 1400,
                    timerProgressBar: true,
                    showConfirmButton: false,
                    didClose: function () { window.location.href = href; }
                });
                // Safety net in case the dialog is dismissed without firing didClose.
                setTimeout(function () { window.location.href = href; }, 1700);
            });
        });
    })();

    var pubFormatOptions = document.getElementById('pubFormatOptions');
    var pubFormatInput = document.getElementById('pubFormat');

    if (pubFormatOptions && pubFormatInput) {
        pubFormatOptions.addEventListener('click', function (e) {
            var btn = e.target && e.target.closest ? e.target.closest('.pub-format-btn') : null;
            if (!btn) return;
            var v = btn.getAttribute('data-format') || 'Ebook';
            setPublishFormat(v, true);
        });
    }

    window._publishCoverAssets = {
        cover: { front: pbCoverRef || '', wrap: pbCoverWrapRef || '', spine: '', back: '' },
        pageCount: pbEstimatedPages || 0
    };
    setPublishFormat(publishBookFormat || 'Ebook', false);

    function setImgOrLabel(imgEl, labelEl, value) {
        if (!imgEl || !labelEl) return;
        if (value) {
            imgEl.src = value;
            imgEl.classList.remove('hidden');
            labelEl.classList.add('hidden');
            markPublishCoverImage(imgEl);
        } else {
            imgEl.src = '';
            imgEl.classList.add('hidden');
            labelEl.classList.remove('hidden');
            imgEl.classList.remove('is-wrap-cover');
        }
    }

    function shouldForceFrontPanel(src, ratio) {
        var ref = String(src || '').toLowerCase();
        if (/wrap|print-ready|cover-wrap|kdp-cover|full-cover|spine-book-cover|spine/.test(ref)) return true;
        return Number.isFinite(ratio) && ratio >= 1.02;
    }

    function markPublishCoverImage(img) {
        if (!img || img.classList.contains('publish-cover-img--wrap')) return;
        // Never CSS-crop the dedicated wrap strip — that must match the exported file 1:1.
        if (img.id === 'publishWrapPreview') {
            img.classList.remove('is-wrap-cover');
            return;
        }
        var apply = function () {
            var w = img.naturalWidth || 0;
            var h = img.naturalHeight || 0;
            if (!w || !h) return;
            var ratio = w / h;
            var src = img.currentSrc || img.src || '';
            if (shouldForceFrontPanel(src, ratio)) img.classList.add('is-wrap-cover');
            else img.classList.remove('is-wrap-cover');
        };
        if (img.complete) apply();
        img.addEventListener('load', apply);
        img.addEventListener('error', function () { img.classList.remove('is-wrap-cover'); });
    }

    function applySavedCoverPreview(wrapUrl) {
        var wrapImg = document.getElementById('publishWrapPreview');
        var wrapPlaceholder = document.getElementById('publishWrapPlaceholder');
        wrapUrl = (wrapUrl || '').trim();
        if (wrapImg && wrapUrl) {
            // Cache-bust so the strip always matches the freshly saved export asset.
            var src = wrapUrl;
            if (src.indexOf('data:') !== 0) {
                src = src + (src.indexOf('?') >= 0 ? '&' : '?') + '_t=' + Date.now();
            }
            wrapImg.src = src;
            wrapImg.classList.remove('hidden', 'is-wrap-cover');
            wrapImg.style.objectFit = 'contain';
            wrapImg.style.objectPosition = 'center';
            if (wrapPlaceholder) wrapPlaceholder.classList.add('hidden');
        } else if (wrapImg) {
            wrapImg.src = '';
            wrapImg.classList.add('hidden');
            if (wrapPlaceholder) wrapPlaceholder.classList.remove('hidden');
        }
    }

    /** Silently pre-generate full wrap when front cover exists but wrap is missing/stale (print/both flow). */
    function preloadPrintWrapIfNeeded() {
        if (!bookId || bookId <= 0 || !needsPrintWrapGeneration()) return;
        if (publishWrapCoverReady) {
            updateWrapExportButtonState(window._publishCoverAssets || { wrapCoverStatus: 'Ready' });
            return;
        }
        var assets = window._publishCoverAssets || {};
        var cover = assets.cover || {};
        if (!(cover.front || pbCoverRef || '').trim()) {
            updateWrapExportButtonState({ wrapCoverStatus: 'MissingFront' });
            return;
        }
        var errorEl = document.getElementById('publishWrapPreloadError');
        if (errorEl) { errorEl.textContent = ''; errorEl.classList.add('hidden'); }
        var forceRebuild = assets.wrapCoverStatus === 'Stale' || assets.wrapMatchesFront === false;
        updateWrapExportButtonState({ wrapCoverStatus: 'Generating' });
        queuePrintWrapGeneration(forceRebuild).catch(function () { /* non-fatal preload */ });
        startWrapStatusPolling();
    }

    function loadSavedCoverPreview() {
        if (!bookId || bookId <= 0) return;
        fetchPrintReadyCoverAssets()
            .then(function (data) {
                var c = data.cover || {};
                var wrap = (c.wrap || '').trim();
                var front = (c.front || '').trim();
                window._publishCoverAssets = {
                    cover: {
                        front: front || pbCoverRef || '',
                        wrap: wrap || pbCoverWrapRef || '',
                        spine: (c.spine || '').trim(),
                        back: (c.back || '').trim()
                    },
                    pageCount: data.pageCount || pbEstimatedPages || 0,
                    layout: data.layout || null,
                    trimSize: data.trimSize || null
                };
                syncWrapReadyFromAssets(data);
                if (wrap) applySavedCoverPreview(wrap);
                applyPublishCoverForFormat();
            })
            .catch(function () { /* non-fatal */ })
            .finally(function () { preloadPrintWrapIfNeeded(); });
    }

    var exportEpubBtn = document.getElementById('btnExportEpub');
    var exportFrontCoverBtn = document.getElementById('btnExportFrontCover');
    var exportFrontCoverPrintBtn = document.getElementById('btnExportFrontCoverPrint');
    var exportPrintBundleBtn = document.getElementById('btnExportPrintBundle');
    var exportCoverWrapBtn = document.getElementById('btnExportCoverWrap');
    var printReadyPrimaryBtn = document.getElementById('btnPrintReadyPublishPrimary');
    if (exportFrontCoverBtn) {
        exportFrontCoverBtn.addEventListener('click', function () { runFrontCoverDownload(exportFrontCoverBtn); });
    }
    if (exportFrontCoverPrintBtn) {
        exportFrontCoverPrintBtn.addEventListener('click', function () { runFrontCoverDownload(exportFrontCoverPrintBtn); });
    }
    if (exportEpubBtn) {
        exportEpubBtn.addEventListener('click', function () { runEbookExport(exportEpubBtn, 'epub'); });
    }
    if (printReadyPrimaryBtn) {
        printReadyPrimaryBtn.addEventListener('click', function () { runInteriorPdfDownload(printReadyPrimaryBtn); });
    }
    if (exportPrintBundleBtn) {
        exportPrintBundleBtn.addEventListener('click', function () { runPrintBundleExport(exportPrintBundleBtn); });
    }
    if (exportCoverWrapBtn) {
        exportCoverWrapBtn.addEventListener('click', function () { runCoverWrapDownload(exportCoverWrapBtn); });
    }
    var exportCoverWrapNoChaptersBtn = document.getElementById('btnExportCoverWrapNoChapters');
    if (exportCoverWrapNoChaptersBtn) {
        exportCoverWrapNoChaptersBtn.addEventListener('click', function () { runCoverWrapDownload(exportCoverWrapNoChaptersBtn); });
    }

    document.querySelectorAll('img.publish-cover-img:not(.publish-cover-img--wrap)').forEach(markPublishCoverImage);

    document.querySelectorAll('a.publish-leave-to-writer[href]').forEach(function (link) {
        link.addEventListener('click', function (e) {
            var href = link.getAttribute('href') || '';
            if (!href || href.indexOf('/Books/AIGenerateBook') < 0) return;
            e.preventDefault();
            if (typeof window.confirmLeaveToAiWriter === 'function') {
                window.confirmLeaveToAiWriter(href);
            } else if (typeof window.confirmFlowBack === 'function') {
                window.confirmFlowBack(href);
            } else if (window.confirm('If you leave, your saved work on this step will be lost. Continue?')) {
                window.location.replace(href + (href.indexOf('?') >= 0 ? '&' : '?') + '_r=' + Date.now());
            }
        });
    });

    syncPublishModeFromContext();

    if (bookId > 0) {
        loadSavedCoverPreview();
        ensureFormatterSavedOnServer(1).catch(function () { return false; });
    }
})();
</script>
