    var exportDocxBtn = document.getElementById('btnExportDocx');
    var exportPdfBtn = document.getElementById('btnExportPdf');
    var exportPrintBundleBtn = document.getElementById('btnExportPrintBundle');
    var exportCoverWrapBtn = document.getElementById('btnExportCoverWrap');
    if (exportEpubBtn) {
        exportEpubBtn.addEventListener('click', function () { runEbookExport(exportEpubBtn, 'epub'); });
    }
    if (exportDocxBtn) {
        exportDocxBtn.addEventListener('click', function () { runEbookExport(exportDocxBtn, 'docx'); });
    }
    if (exportPdfBtn) {
        exportPdfBtn.addEventListener('click', function () { runPublishPdfDownload(exportPdfBtn); });
    }
    if (exportPrintBundleBtn) {
        exportPrintBundleBtn.addEventListener('click', function () { runPrintBundleExport(exportPrintBundleBtn); });
    }
    if (exportCoverWrapBtn) {
        exportCoverWrapBtn.addEventListener('click', function () { runCoverWrapDownload(exportCoverWrapBtn); });
    }

    var prGenerateBtn = document.getElementById('btnGeneratePrintReadyCover');
    if (prGenerateBtn && isPrintReadyFlow && bookId > 0) {
        prGenerateBtn.addEventListener('click', function () { runPrintReadyAutoCover(prGenerateBtn); });
    }

    initPrintReadyCalculator();

    var publishPicker = document.getElementById('publishBookPicker');
    if (publishPicker) {
        publishPicker.addEventListener('change', function () {
            var id = parseInt(this.value, 10);
            if (!id) return;
            var url = '/Dashboard/Publish?bookId=' + id;
            if (isPrintReadyFlow) url += '&flow=printready';
            window.location.href = url;
        });
    }
})();
