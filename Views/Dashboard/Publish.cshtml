        border-left: 4px solid #a78bfa;
    }
    .publish-pipeline-list {
        list-style: none;
        margin: 0;
        padding: 0.2rem 0 0;
        display: grid;
        gap: 0.58rem;
        counter-reset: publishStep;
    }
    .publish-pipeline-list li {
        counter-increment: publishStep;
        position: relative;
        padding-left: 2.45rem;
        font-size: 0.9rem;
        color: #334155;
        line-height: 1.45;
    }
    .publish-pipeline-list li::before {
        content: counter(publishStep);
        position: absolute;
        left: 0;
        top: 0.02rem;
        width: 1.55rem;
        height: 1.55rem;
        border-radius: 0.58rem;
        display: inline-flex;
