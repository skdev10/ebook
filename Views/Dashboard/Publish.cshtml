            top: 1rem;
            padding: 1.15rem;
            border-radius: 1.1rem;
            border: 1px solid #ddd6fe;
            background: linear-gradient(180deg, #ffffff 0%, #faf7ff 100%);
            box-shadow: 0 22px 42px -30px rgba(76, 29, 149, 0.6);
        }
        .publish-export-grid .publish-export-actions > button {
            width: 100%;
        }
