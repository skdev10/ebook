        color: #64748b;
        margin-bottom: 0.2rem;
    }
    .publish-meta-grid dd {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: #0f172a;
    }
    .publish-page--publish-step .publish-stat-strip,
    .publish-page--publish-step #publishSavedCoverSection,
