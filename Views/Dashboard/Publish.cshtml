        border: 1px solid #cbd5e1;
        overflow: hidden;
    }
    .kdp-template::before,
    .kdp-template::after {
        content: "";
        position: absolute;
        inset: 10px;
        border: 1px dashed #cbd5e1;
        border-radius: 0.65rem;
    }
    .kdp-template::after {
        inset: 22px;
        border-color: #94a3b8;
    }
    .kdp-spine-zone {
        position: absolute;
        top: 18px;
        bottom: 18px;
        left: 50%;
        width: 44px;
