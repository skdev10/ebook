        width: 1rem;
        text-align: center;
        flex-shrink: 0;
    }
    .publish-export-stores .publish-export-actions {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        max-width: 28rem;
    }
    /* Premium gradient treatment for the solid download buttons (outline buttons keep white bg). */
    .publish-export-actions > button.bg-violet-600 {
        background-image: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 45%, #6d28d9 100%);
        border: none;
        box-shadow: 0 14px 26px -14px rgba(91, 33, 182, 0.65);
        transition: transform 0.18s ease, box-shadow 0.2s ease, filter 0.2s ease;
    }
