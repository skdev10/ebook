        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }
    .publish-platform-btn {
        cursor: pointer;
        border: 0;
        background: transparent;
        width: 100%;
    }
    .publish-card--platforms {
        background: #0f172a;
        border-color: #1e293b;
    }
    .publish-card--platforms .publish-card-title,
    .publish-card--platforms .publish-card-title i {
        color: #f8fafc;
    }
