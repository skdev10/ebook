    function imageRefToBlob(ref) {
        var src = String(ref || '').trim();
        if (!src) return Promise.reject(new Error('Cover image is not available.'));
        if (src.indexOf('data:image') === 0) {
            var parts = src.split(',');
            if (parts.length < 2) return Promise.reject(new Error('Invalid cover data.'));
            var mimeMatch = /^data:(image\/[a-zA-Z0-9.+-]+);base64/.exec(parts[0] || '');
            var mime = (mimeMatch && mimeMatch[1]) ? mimeMatch[1] : 'image/png';
            var byteString = atob(parts[1]);
            var ab = new ArrayBuffer(byteString.length);
            var ia = new Uint8Array(ab);
            for (var i = 0; i < byteString.length; i++) ia[i] = byteString.charCodeAt(i);
            return Promise.resolve(new Blob([ab], { type: mime }));
        }
        var url = src.indexOf('http') === 0 || src.indexOf('/') === 0 ? src : ('/' + src);
        return fetch(url).then(function (r) {
            if (!r.ok) throw new Error('Could not load cover image.');
            return r.blob();
        });
    }

    function runFrontCoverDownload(triggerBtn) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }
        if (triggerBtn) triggerBtn.disabled = true;

        var serverUrl = '/Dashboard/DownloadPrintReadyCoverAsset?bookId=' + encodeURIComponent(bookId) + '&part=front';

        fetch(serverUrl)
            .then(function (r) {
                if (r.ok) {
                    return r.blob().then(function (blob) {
                        var ext = (r.headers.get('content-disposition') || '').indexOf('.jpg') >= 0 ? 'jpg' : 'png';
                        downloadBlobAsFile(blob, safeBookSlug() + '-' + bookId + '-front-cover.' + ext);
                        showTransientMessage('success', 'Front cover downloaded.');
                    });
                }
                return fetch('/Dashboard/GetPrintReadyCoverAssets?bookId=' + encodeURIComponent(bookId))
                    .then(function (assetsResp) { return assetsResp.json(); })
                    .then(function (assets) {
                        var c = assets && assets.cover ? assets.cover : null;
                        var frontUrl = (c && c.front ? c.front : '').trim();
                        var wrapUrl = (c && c.wrap ? c.wrap : '').trim();
                        if (!frontUrl && wrapUrl && window.CoverKdpExport
                            && typeof window.CoverKdpExport.extractPanelsFromWrap === 'function') {
                            return window.CoverKdpExport.extractPanelsFromWrap(wrapUrl, assets.layout || null)
                                .then(function (panels) {
                                    if (panels && panels.front) return imageRefToBlob(panels.front);
                                    throw new Error('Front cover panel not available.');
                                });
                        }
                        if (!frontUrl) frontUrl = String(pbCoverRef || '').trim();
                        if (!frontUrl) throw new Error('Front cover is not available yet. Generate a cover in AI Cover Design first.');
                        return imageRefToBlob(frontUrl);
                    })
                    .then(function (blob) {
                        downloadBlobAsFile(blob, safeBookSlug() + '-' + bookId + '-front-cover.png');
                        showTransientMessage('success', 'Front cover downloaded.');
                    });
            })
            .catch(function (err) {
