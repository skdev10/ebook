    .publish-video-frame { width: 100%; aspect-ratio: 16/9; border: 0; border-radius: 0.75rem; background: #0f172a; }

    .publish-learning-swal-popup {
        border-radius: 1.5rem !important;
        padding: 1.35rem 1.35rem 1rem !important;
        background: #f8fafc !important;
        border: 1px solid rgba(124, 58, 237, 0.2) !important;
        box-shadow: 0 25px 50px -12px rgba(76, 29, 149, 0.28) !important;
    }
    .publish-learning-swal-popup .swal2-title { margin-bottom: 0.35rem !important; padding: 0 0.5rem !important; }
    .publish-learning-swal-popup .swal2-html-container { margin: 0.5rem 0 0 !important; padding: 0 0.25rem !important; }
    .publish-learning-swal-actions { margin-top: 1.15rem !important; gap: 0.65rem !important; }
    .pub-learn-wrap { text-align: left; font-family: 'Inter', system-ui, sans-serif; color: #0f172a; }
    .pub-learn-lede {
        font-size: 0.8125rem;
        color: #64748b;
        margin: 0 0 1rem;
        line-height: 1.55;
        padding: 0.65rem 0.85rem;
        border-radius: 0.75rem;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid #e9d5ff;
    }
    .pub-learn-tabs { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; }
    .pub-learn-tab {
        flex: 1;
        padding: 0.65rem 0.75rem;
        border-radius: 0.875rem;
        border: 1px solid #e2e8f0;
        background: #fff;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.8125rem;
        color: #475569;
        transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s, background 0.2s, color 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
    }
    .pub-learn-tab:hover { border-color: #c4b5fd; color: #5b21b6; }
    .pub-learn-tab--active {
        background: #5b21b6;
        color: #fff !important;
        border-color: transparent;
        box-shadow: 0 10px 28px -10px rgba(124, 58, 237, 0.65);
        transform: translateY(-1px);
    }
    .pub-learn-tab--active .fab.fa-amazon { color: #fbbf24; }
    .pub-learn-panels { max-height: min(58vh, 540px); overflow-y: auto; padding-right: 0.35rem; scrollbar-width: thin; }
    .pub-learn-panel { display: none; animation: pubLearnIn 0.25s ease; }
    .pub-learn-panel--active { display: block; }
    @@keyframes pubLearnIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    .pub-learn-card {
        margin-bottom: 0.875rem;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 18px -10px rgba(15, 23, 42, 0.15);
    }
    .pub-learn-card-head {
        padding: 0.55rem 0.9rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: #3730a3;
        background: #f5f3ff;
        border-bottom: 1px solid #ede9fe;
        letter-spacing: 0.01em;
    }
    .pub-learn-embed { aspect-ratio: 16/9; background: #0f172a; position: relative; }
    .pub-learn-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

    .container { width: 100%; max-width: none; }
    .book-card {
        background: #ffffff;
        border-radius: 1.5rem;
        border: 1px solid #dbe3ee;
        padding: clamp(1.15rem, 2.2vw, 2.4rem);
        box-shadow: 0 26px 44px -34px rgba(30, 41, 59, 0.4);
        display: flex;
        gap: clamp(1rem, 1.4vw, 2rem);
        align-items: flex-start;
    }
    .book-cover {
        flex-shrink: 0;
        width: clamp(170px, 16vw, 220px);
        height: clamp(238px, 22vw, 308px);
        border-radius: 0.85rem;
        overflow: hidden;
        box-shadow: 0 16px 34px -18px rgba(15, 23, 42, 0.55);
        position: relative;
    }
    .book-cover img { width: 100%; height: 100%; object-fit: cover; }
    .book-cover-placeholder {
        width: 100%;
        height: 100%;
        background: #5b21b6;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 0.86rem;
        font-weight: 600;
    }
    .book-info { flex: 1; min-width: 0; padding-top: 0.15rem; }
    .label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #7c3aed;
        text-transform: uppercase;
        margin-bottom: 0.7rem;
    }
    .book-title {
        font-size: clamp(1.5rem, 1.25rem + 1vw, 2.2rem);
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.95rem;
        line-height: 1.2;
    }
    .book-description {
        font-size: 0.93rem;
        line-height: 1.72;
        color: #64748b;
        margin-bottom: 1.2rem;
        max-width: 68ch;
    }
    .tags { display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: center; }
    .tag {
        padding: 0.42rem 0.82rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: default;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        line-height: 1.15;
    }
    .tag.fiction { background: #ede9fe; color: #6d28d9; border-color: #ddd6fe; }
    .tag.draft { background: #fef3c7; color: #b45309; border-color: #fde68a; }

    @@media (min-width: 1180px) {
        .publish-sections {
            grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
            align-items: start;
        }
        .publish-card--checkout,
        .publish-card--platforms {
            grid-column: 1 / -1;
        }
        .publish-card--checkout { order: 0; }
        .publish-card--pipeline {
            order: 1;
            grid-column: 1;
        }
        .publish-card--pro {
            order: 2;
            grid-column: 2;
        }
        .publish-card--platforms { order: 3; }
    }
    @@media (max-width: 768px) {
        .publish-hero {
            border-radius: 1.1rem;
        }
        .book-card {
            flex-direction: column;
            border-radius: 1.1rem;
        }
        .book-cover {
            margin: 0 auto;
        }
        .book-info {
            text-align: left;
        }
    }
    @@media (prefers-reduced-motion: reduce) {
        .publish-card {
            transition: none;
        }
        .publish-card:hover {
            transform: none;
        }
    }
</style>

<div class="bg-[#f5f7f9] min-h-full flex text-slate-900 flex-1">
<main class="flex-1 overflow-y-auto overflow-x-hidden p-8 lg:p-12 w-full min-h-0">
<div class="max-w-[1600px] mx-auto w-full flex flex-col min-h-0">
<div class="publish-page publish-page-shell bg-white rounded-[32px] shadow-sm border border-slate-200/60 w-full min-h-[min(850px,calc(100vh-140px))] md:min-h-[850px] p-6 md:p-10 lg:p-12 text-slate-800">
@Html.AntiForgeryToken()
    <section class="publish-hero mb-6 sm:mb-8 lg:mb-10">
        <div>
            <p class="publish-kicker">Distribution Console</p>
            <h1 class="publish-hero-title text-3xl lg:text-4xl font-medium text-slate-900 tracking-tight">Export your book</h1>
            <p class="publish-hero-copy">Open your book and export EPUB or Word (.docx) for KDP, IngramSpark, or any store. No checkout steps required to download.</p>
        </div>
        <div class="publish-hero-meta">
            <span class="publish-chip @(alreadyListed ? "publish-chip-ready" : "publish-chip-neutral")">
                <i class="fas @(alreadyListed ? "fa-check-circle" : "fa-hourglass-half")" aria-hidden="true"></i> @publishStateText
            </span>
            @if (isPrintReadyFlow)
            {
                <span class="publish-chip publish-chip-neutral"><i class="fas fa-ruler-combined" aria-hidden="true"></i> Print-ready mode</span>
            }
            <span class="publish-chip publish-chip-neutral">
                <i class="fas fa-book-open" aria-hidden="true"></i> Book ID @(bookId > 0 ? bookId.ToString() : "Not selected")
            </span>
            @if (pbChapterCount > 0)
            {
                <span class="publish-chip publish-chip-neutral"><i class="fas fa-list-ol" aria-hidden="true"></i> @pbChapterCount chapter@(pbChapterCount == 1 ? "" : "s")</span>
            }
        </div>
    </section>

    @if (publishBooks.Any())
    {
        <div class="publish-book-picker">
            <label for="publishBookPicker">Choose book to export</label>
            <select id="publishBookPicker" aria-label="Choose book">
                <option value="">— Select a book —</option>
                @foreach (var b in publishBooks)
                {
                    var chLabel = b.ExportableChapterCount > 0 ? $" — {b.ExportableChapterCount} ch" : " — no content yet";
                    if (bookId == b.BookId)
                    {
                        <option value="@b.BookId" selected="selected">@b.Title@chLabel</option>
                    }
                    else
                    {
                        <option value="@b.BookId">@b.Title@chLabel</option>
                    }
                }
            </select>
            @if (bookId <= 0)
            {
                <p class="publish-export-tip mt-2">Pick a book above — export buttons appear when chapter text exists in AI Writer.</p>
            }
        </div>
    }

    <section class="publish-stat-strip mb-6 sm:mb-8">
        <article class="publish-stat">
            <p class="publish-stat-label">Selection</p>
            <p class="publish-stat-value">@(bookId > 0 ? "Book linked" : "Book not selected")</p>
            <p class="publish-stat-sub">@(bookId > 0 ? ("ID " + bookId) : "Select a title in My Books")</p>
        </article>
        <article class="publish-stat">
            <p class="publish-stat-label">Manuscript</p>
            <p class="publish-stat-value">@(pbEstimatedPages > 0 ? (pbEstimatedPages + " estimated pages") : (pbChapterCount > 0 ? (pbChapterCount + " chapter" + (pbChapterCount == 1 ? "" : "s")) : "No chapters yet"))</p>
            <p class="publish-stat-sub">Used for PDF and print exports</p>
        </article>
        <article class="publish-stat">
            <p class="publish-stat-label">Export</p>
            <p class="publish-stat-value">@publishStateText</p>
            <p class="publish-stat-sub">@(pbWordCount > 0 ? (pbWordCount.ToString("N0") + " words in manuscript") : "EPUB and Word when chapters exist")</p>
        </article>
    </section>

    <div class="container mb-8">
        @if (bookId > 0 && !string.IsNullOrEmpty(pbTitle))
        {
            <div class="book-card">
                <div class="book-cover">
                    @{
                        var displayCoverUrl = CoverUrl(pbCover);
                    }
                    @if (!string.IsNullOrEmpty(displayCoverUrl))
                    {
                        <img src="@displayCoverUrl" alt="" loading="eager" decoding="async" />
                    }
                    else
                    {
                        <div class="book-cover-placeholder">No cover yet — design in Cover Design</div>
                    }
                </div>
                <div class="book-info">
                    <div class="label">@(canExport ? "Export your book" : "Your book")</div>
                    <h1 class="book-title">@pbTitle</h1>
                    <p class="book-description">
                        @(string.IsNullOrWhiteSpace(pbDesc) ? "Description can be updated in AI Writer or My Books." : pbDesc)
                    </p>
                    @if (pbChapterCount > 0)
                    {
                        <p class="text-sm text-slate-600 mb-4"><strong>@pbChapterCount</strong> chapter@(pbChapterCount == 1 ? "" : "s") on file.</p>
                    }
                    <div class="tags flex-wrap">
                        @if (!string.IsNullOrEmpty(pbGenre))
                        {
                            <span class="tag fiction" style="cursor:default;">@pbGenre</span>
                        }
                        <span class="tag draft" style="cursor:default;">@(alreadyListed ? "Published" : pbStatus)</span>
                        @if (pbEstimatedPages > 0)
                        {
                            <span class="tag fiction" style="cursor:default;">@pbEstimatedPages pages</span>
                        }
                    </div>
                    @if (!canExport)
                    {
                    <p class="text-sm text-slate-600 mb-4">Add chapter content in <a href="/Books/AIGenerateBook?bookId=@bookId" class="text-violet-700 font-semibold underline">AI Writer</a>, then return here to export.</p>
                    }
                    <p class="text-xs text-slate-500 mt-4">
                        Edit manuscript in <a href="/Books/AIGenerateBook?bookId=@bookId" class="text-violet-700 font-semibold underline">AI Writer</a> ·
                        <a href="/BookDesign/CoverDesignCalculatorFixing?bookId=@bookId" class="text-violet-700 font-semibold underline">Formatting</a> ·
                        <a href="/Dashboard/CoverDesign?bookId=@bookId" class="text-violet-700 font-semibold underline">Cover</a>
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="book-card">
                <div class="book-cover">
                    <div class="book-cover-placeholder">Select a book</div>
                </div>
                <div class="book-info">
                    <div class="label">No book selected</div>
                    <h1 class="book-title">Choose a book to publish</h1>
                    <p class="book-description">
                        Open <a href="/Dashboard/MyBooks" class="text-violet-700 font-semibold underline">My Books</a> or <a href="/Dashboard/CoverDesign" class="text-violet-700 font-semibold underline">Cover Design</a> and pick a title, or add <code class="bg-slate-100 px-1 rounded">?bookId=</code> to this page URL after creating a book in AI Writer.
                    </p>
                    <div class="mt-4 flex flex-wrap gap-3">
                        <a href="/Dashboard/MyBooks" class="inline-flex items-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700">Go to My Books</a>
                        <a href="/Books/AIGenerateBook" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white text-slate-800 font-semibold px-5 py-2.5 text-sm hover:bg-slate-50">Create in AI Writer</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <section class="publish-export-stores" id="publishExportStores" aria-labelledby="publishExportStoresTitle">
        <h2 id="publishExportStoresTitle">Export your book</h2>
        @if (bookId > 0)
        {
            @if (canExport)
            {
                @if (isPrintReadyFlow)
                {
                    <p class="publish-export-hint" id="publishExportHint">Download a print-ready ZIP (interior PDF + full wrap cover) or grab the cover wrap PNG alone.</p>
                }
                else
                {
                    <p class="publish-export-hint" id="publishExportHint">EPUB, Word, or PDF — ready for KDP, IngramSpark, or any store.</p>
                }
                <div class="publish-export-actions">
                    @if (isPrintReadyFlow)
                    {
                        <button type="button" id="btnExportPrintBundle" class="inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700 shadow-md shadow-violet-500/25 w-full sm:w-auto">
                            <i class="fas fa-file-archive" aria-hidden="true"></i> Export print pack (PDF + cover)
                        </button>
                        @if (hasSavedCoverWrap)
                        {
                            <button type="button" id="btnExportCoverWrap" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-violet-400 bg-white text-violet-800 font-semibold px-5 py-2.5 text-sm hover:bg-violet-50 w-full sm:w-auto">
                                <i class="fas fa-image" aria-hidden="true"></i> Download cover wrap PNG
                            </button>
                        }
                    }
                    else
                    {
                        <button type="button" id="btnExportEpub" class="inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 text-white font-semibold px-5 py-2.5 text-sm hover:bg-violet-700 shadow-md shadow-violet-500/25 w-full sm:w-auto">
                            <i class="fas fa-book" aria-hidden="true"></i> Download EPUB
                        </button>
                        <button type="button" id="btnExportDocx" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-violet-300 bg-white text-violet-800 font-semibold px-5 py-2.5 text-sm hover:bg-violet-50 w-full sm:w-auto">
                            <i class="fas fa-file-word" aria-hidden="true"></i> Export Word
                        </button>
                        <button type="button" id="btnExportPdf" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-violet-300 bg-white text-violet-800 font-semibold px-5 py-2.5 text-sm hover:bg-violet-50 w-full sm:w-auto">
                            <i class="fas fa-file-pdf" aria-hidden="true"></i> Download PDF
                        </button>
                    }
                </div>
                @if (!isPrintReadyFlow)
                {
                    <p class="publish-export-tip mt-3 mb-0">After download: open the <strong>.epub</strong> file with Apple Books, Google Play Books, Calibre, or send to your Kindle.</p>
                }
            }
            else
            {
                <p class="publish-export-hint">Add chapter content in <a href="/Books/AIGenerateBook?bookId=@bookId" class="text-violet-700 font-semibold underline">AI Writer</a>, then export from here.</p>
                @if (isPrintReadyFlow && hasSavedCoverWrap)
                {
                    <div class="publish-export-actions mt-3">
                        <button type="button" id="btnExportCoverWrap" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-violet-400 bg-white text-violet-800 font-semibold px-5 py-2.5 text-sm hover:bg-violet-50 w-full sm:w-auto">
                            <i class="fas fa-image" aria-hidden="true"></i> Download cover wrap PNG
                        </button>
                    </div>
                    <p class="publish-export-tip mt-2 mb-0">Cover wrap is ready. Add chapters to export the full print pack.</p>
                }
            }
        }
        else
        {
            <p class="publish-export-hint">Choose a book above to download EPUB, PDF, or a print-ready pack.</p>
        }
    </section>

</div>
</div>
</main>
</div>

<div id="publishDetailOverlay" class="publish-detail-overlay" role="dialog" aria-modal="true">
    <div class="publish-detail-box">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 bg-violet-700 text-white">
            <h3 id="publishDetailTitle" class="text-lg font-semibold">Guide</h3>
            <button type="button" id="publishDetailClose" class="p-2 rounded-lg hover:bg-white/15 text-white" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-5 overflow-y-auto flex-1">
            <div class="publish-progress" id="publishProgressBar"></div>
            <div id="publishDetailSteps"></div>
            <div class="mt-5 rounded-xl overflow-hidden border border-slate-200 bg-slate-900 aspect-video">
                <div id="publishVideoSlot" class="w-full h-full min-h-[200px]"></div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var paid = true;
    var bookId = @(bookId);
    var publishReady = @(publishReady.ToString().ToLowerInvariant());
    var alreadyListed = @(alreadyListed.ToString().ToLowerInvariant());
    var isPrintReadyFlow = @(isPrintReadyFlow.ToString().ToLowerInvariant());
    var publishableKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(publishableKey));
    var pbTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbTitle));
    var pbGenre = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbGenre));
    var pbDesc = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pbDesc));
    var pbEstimatedPages = @(pbEstimatedPages);

    function initPrintReadyCalculator() {
        if (!isPrintReadyFlow) return;
        var trimMap = {
            '6x9': { w: 6, h: 9 },
            '5.5x8.5': { w: 5.5, h: 8.5 },
            '8.5x11': { w: 8.5, h: 11 }
        };
        var pageInput = document.getElementById('prPageCount');
        var trimSelect = document.getElementById('prTrimSize');
        var interiorSelect = document.getElementById('prInteriorType');
        var spineInEl = document.getElementById('prSpineIn');
        var spineMmEl = document.getElementById('prSpineMm');
        var wrapInEl = document.getElementById('prWrapIn');
        var wrapMmEl = document.getElementById('prWrapMm');
        var syncedPageEl = document.getElementById('prSyncedPageCount');
        if (!pageInput || !trimSelect || !interiorSelect || !spineInEl || !spineMmEl || !wrapInEl || !wrapMmEl) return;

        function toMm(vIn) { return vIn * 25.4; }
        function fmtNum(v, d) { return Number(v || 0).toFixed(d); }
        function recalc() {
            var pages = parseInt(pageInput.value || '200', 10);
            if (!Number.isFinite(pages)) pages = 200;
            pages = Math.max(24, Math.min(828, pages));
            pageInput.value = String(pages);
            if (syncedPageEl && pbEstimatedPages > 0) syncedPageEl.textContent = String(pbEstimatedPages);
            var trim = trimMap[trimSelect.value] || trimMap['6x9'];
            var mult = interiorSelect.value === 'color' ? 0.002347 : 0.002252;
            var bleed = 0.125;
            var spineIn = Math.max(0.055, pages * mult);
            var wrapWIn = (trim.w * 2) + spineIn + (bleed * 2);
            var wrapHIn = trim.h + (bleed * 2);
            spineInEl.textContent = fmtNum(spineIn, 3) + ' in';
            spineMmEl.textContent = fmtNum(toMm(spineIn), 2) + ' mm';
            wrapInEl.textContent = fmtNum(wrapWIn, 3) + ' × ' + fmtNum(wrapHIn, 3) + ' in';
            wrapMmEl.textContent = fmtNum(toMm(wrapWIn), 2) + ' × ' + fmtNum(toMm(wrapHIn), 2) + ' mm';
        }
        [pageInput, trimSelect, interiorSelect, document.getElementById('prBindingType'), document.getElementById('prPaperType')]
            .forEach(function (el) { if (el) el.addEventListener('input', recalc); if (el) el.addEventListener('change', recalc); });
        recalc();
    }

    function showTransientMessage(kind, text) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: kind,
                text: text,
                timer: 2600,
                showConfirmButton: false
            });
        } else {
            alert(text);
        }
    }

    function parseFilenameFromDisposition(header) {
        if (!header) return '';
        var m = /filename\*=UTF-8''([^;]+)|filename="?([^";]+)"?/i.exec(header);
        if (!m) return '';
        try {
            return decodeURIComponent((m[1] || m[2] || '').trim());
        } catch (e) {
            return (m[1] || m[2] || '').trim();
        }
    }

    function downloadBlobAsFile(blob, filename) {
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename || 'book.epub';
        a.rel = 'noopener';
        document.body.appendChild(a);
        a.click();
        setTimeout(function () {
            a.remove();
            URL.revokeObjectURL(url);
        }, 400);
    }

    function safeBookSlug() {
        return String(pbTitle || 'book')
            .toLowerCase()
            .replace(/[^\w\s-]+/g, '')
            .replace(/\s+/g, '-')
            .replace(/^-+|-+$/g, '') || 'book';
    }

    function getPublishAntiForgeryToken() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        return t ? t.value : '';
    }

    function runEbookExport(triggerBtn, format) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }
        var fmt = (format || 'epub').toLowerCase();
        var url = fmt === 'docx' ? '/Books/ExportDocx' : '/Books/ExportEpub';
        var token = getPublishAntiForgeryToken();
        if (triggerBtn) triggerBtn.disabled = true;
        showTransientMessage('info', fmt === 'docx' ? 'Building Word document…' : 'Building EPUB…');
        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            credentials: 'same-origin',
            body: JSON.stringify({
                bookId: bookId,
                displayTitle: pbTitle || '',
                displayAuthor: '',
                displayGenre: pbGenre || '',
                exportFormat: fmt
            })
        })
            .then(function (res) {
                if (!res.ok) {
                    return res.json().catch(function () { return {}; }).then(function (j) {
                        throw new Error((j && j.message) ? j.message : 'Export failed.');
                    });
                }
                var cd = res.headers.get('Content-Disposition') || '';
                var serverName = parseFilenameFromDisposition(cd);
                return res.blob().then(function (blob) {
                    if (!blob || blob.size < 80) {
                        throw new Error('Export file is empty. Add chapter text in AI Writer, then try again.');
                    }
                    var ext = fmt === 'docx' ? 'docx' : 'epub';
                    var mime = fmt === 'docx'
                        ? 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                        : 'application/epub+zip';
                    var typed = blob.type ? blob : new Blob([blob], { type: mime });
                    var fname = serverName || (safeBookSlug() + '-' + bookId + '.' + ext);
                    downloadBlobAsFile(typed, fname);
                    showTransientMessage('success', fmt === 'epub'
                        ? 'EPUB downloaded — open it in Apple Books, Play Books, or Calibre.'
                        : 'Word file downloaded.');
                });
            })
            .catch(function (err) {
                showTransientMessage('error', err && err.message ? err.message : 'Export failed.');
            })
            .finally(function () {
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

    function runPrintBundleExport(triggerBtn) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }
        var token = getPublishAntiForgeryToken();
        if (triggerBtn) triggerBtn.disabled = true;
        showTransientMessage('info', 'Preparing print-ready ZIP…');
        fetch('/Books/ExportPrintReadyBundle', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            credentials: 'same-origin',
            body: JSON.stringify({
                bookId: bookId,
                displayTitle: pbTitle || '',
                displayAuthor: '',
                displayGenre: pbGenre || '',
                publishingPlatform: 'Just Print Ready File'
            })
        })
            .then(function (res) {
                if (!res.ok) {
                    return res.json().catch(function () { return {}; }).then(function (j) {
                        throw new Error((j && j.message) ? j.message : 'Export failed.');
                    });
                }
                return res.blob();
            })
            .then(function (blob) {
                downloadBlobAsFile(blob, safeBookSlug() + '-print-ready-' + bookId + '.zip');
                showTransientMessage('success', 'ZIP downloaded: interior PDF (chapters only) + your saved full cover wrap.');
            })
            .catch(function (err) {
                showTransientMessage('error', err && err.message ? err.message : 'Export failed.');
            })
            .finally(function () {
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

    function runPublishPdfDownload(triggerBtn) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }
        if (triggerBtn) triggerBtn.disabled = true;

        fetch('/Dashboard/DownloadBookPdf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                bookId: bookId,
                displayTitle: pbTitle || '',
                displayAuthor: '',
                displayGenre: pbGenre || '',
                publishingPlatform: isPrintReadyFlow ? 'Just Print Ready File' : null
            })
        })
            .then(function (res) {
                if (!res.ok) {
                    return res.text().then(function (t) {
                        throw new Error(t || 'Could not generate PDF.');
                    });
                }
                return res.blob();
            })
            .then(function (blob) {
                downloadBlobAsFile(blob, safeBookSlug() + '-' + bookId + '.pdf');
                showTransientMessage('success', 'Full print-ready PDF download started.');
            })
            .catch(function (err) {
                showTransientMessage('error', err && err.message ? err.message : 'PDF download failed.');
            })
            .finally(function () {
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

    function runInteriorPdfDownload(triggerBtn) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }
        if (triggerBtn) triggerBtn.disabled = true;
        fetch('/Dashboard/DownloadBookInteriorPdf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                bookId: bookId,
                displayTitle: pbTitle || '',
                displayAuthor: '',
                displayGenre: pbGenre || '',
                publishingPlatform: isPrintReadyFlow ? 'Just Print Ready File' : null
            })
        })
            .then(function (res) {
                if (!res.ok) {
                    return res.text().then(function (t) { throw new Error(t || 'Could not generate interior PDF.'); });
                }
                return res.blob();
            })
            .then(function (blob) {
                downloadBlobAsFile(blob, safeBookSlug() + '-' + bookId + '-interior.pdf');
                showTransientMessage('success', 'Interior-only PDF download started.');
            })
            .catch(function (err) {
                showTransientMessage('error', err && err.message ? err.message : 'Interior PDF download failed.');
            })
            .finally(function () {
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

    function runCoverWrapDownload(triggerBtn) {
        if (!bookId || bookId <= 0) {
            showTransientMessage('warning', 'Select a book first.');
            return;
        }
        if (triggerBtn) triggerBtn.disabled = true;
        fetch('/Dashboard/DownloadPrintReadyCoverAsset?bookId=' + encodeURIComponent(bookId) + '&part=wrap')
            .then(function (res) {
                if (!res.ok) throw new Error('Cover wrap not available yet. Generate print-ready cover first.');
                return Promise.all([res.blob(), res.headers.get('content-type') || 'image/png']);
            })
            .then(function (pair) {
                var blob = pair[0];
                var ctype = pair[1];
                var ext = ctype.indexOf('jpeg') >= 0 ? 'jpg' : (ctype.indexOf('webp') >= 0 ? 'webp' : 'png');
                downloadBlobAsFile(blob, safeBookSlug() + '-' + bookId + '-cover-wrap.' + ext);
                showTransientMessage('success', 'Cover wrap download started.');
            })
            .catch(function (err) {
                showTransientMessage('error', err && err.message ? err.message : 'Cover wrap download failed.');
            })
            .finally(function () {
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

