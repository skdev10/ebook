@using EBookDashboard.Services
@{
    ViewData["Title"] = "My Books";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var rawBooks = ViewBag.Books as IEnumerable<object> ?? Enumerable.Empty<object>();
    var authorName = ViewBag.AuthorName as string ?? "Author";
    var userId = ViewBag.UserId;

    object? Prop(object obj, string name)
    {
        if (obj is IDictionary<string, object> dict && dict.TryGetValue(name, out var val))
            return val;
        var p = obj.GetType().GetProperty(name);
        return p?.GetValue(obj);
    }

    int AsInt(object? v)
    {
        if (v == null) return 0;
        if (v is int i) return i;
        if (int.TryParse(v.ToString(), out var n)) return n;
        return 0;
    }

    string AsString(object? v) => v?.ToString() ?? "";
    string CoverUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || path.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
            return path;
        return path.StartsWith("/") ? path : "/" + path;
    }

    var stripeReady = ViewBag.StripePaymentsReady as bool? ?? false;
    var paymentJustCompleted = ViewBag.PaymentJustCompleted as bool? ?? false;
    var books = rawBooks.Select(b => new
    {
        BookId = AsInt(Prop(b, "BookId")),
        Title = AsString(Prop(b, "Title")),
        Status = AsString(Prop(b, "Status")),
        ChapterCount = AsInt(Prop(b, "ChapterCount")),
        WordCount = AsInt(Prop(b, "WordCount")),
        Genre = AsString(Prop(b, "Genre")),
        Description = AsString(Prop(b, "Description")),
        CoverImagePath = AsString(Prop(b, "CoverImagePath"))
    })
    .Where(b => BookFlowStateService.IsPublishedStatus(b.Status))
    .ToList();
    var firstBook = books.FirstOrDefault();
    var firstBookExportReady = firstBook != null && BookFlowStateService.IsPublishedStatus(firstBook.Status);
}
@Html.AntiForgeryToken()
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

<style>
