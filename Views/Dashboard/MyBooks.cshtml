    /* 3D book preview (modal hero) */
    .mybooks-3d-row {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: stretch;
        padding: 16px 18px 8px;
        background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, transparent 100%);
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .mybooks-3d-stage {
        perspective: 1200px;
        flex: 0 0 auto;
        width: min(200px, 42vw);
        height: 280px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .mybooks-3d-book {
        position: relative;
        width: 140px;
        height: 210px;
        transform-style: preserve-3d;
        transform: rotateY(-32deg) rotateX(4deg);
        animation: mybooks-book-tilt 6s ease-in-out infinite alternate;
    }
    @@keyframes mybooks-book-tilt {
        from { transform: rotateY(-28deg) rotateX(3deg); }
        to { transform: rotateY(-38deg) rotateX(6deg); }
    }
    .mybooks-3d-face {
        position: absolute;
        inset: 0;
        border-radius: 2px 4px 4px 2px;
        backface-visibility: hidden;
        box-shadow: -8px 10px 28px rgba(0,0,0,0.45);
    }
    .mybooks-3d-cover {
        transform: translateZ(10px);
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.15);
    }
    .mybooks-3d-cover img {
        width: 100%; height: 100%; object-fit: cover;
        display: block;
    }
    .mybooks-3d-cover-fallback {
        width: 100%; height: 100%;
        display: flex; align-items: center; justify-content: center;
        padding: 12px; text-align: center;
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 0.85rem; font-weight: 600; color: #fafafa;
        background: linear-gradient(145deg, #312e81 0%, #4c1d95 100%);
    }
    .mybooks-3d-pages {
        transform: translateZ(0px) translateX(6px);
        background: linear-gradient(90deg, #f8fafc 0%, #e2e8f0 35%, #cbd5e1 100%);
        width: 100%; height: 100%;
        box-shadow: inset -3px 0 8px rgba(15,23,42,0.15);
    }
    .mybooks-3d-pages::before {
        content: '';
        position: absolute;
        left: 4px; top: 6px; bottom: 6px; width: 2px;
        background: repeating-linear-gradient(
            transparent 0 3px,
            rgba(148,163,184,0.35) 3px 4px
        );
    }
    .mybooks-3d-spine {
        position: absolute;
        left: 0; top: 0; bottom: 0; width: 14px;
        transform-origin: left center;
        transform: rotateY(-90deg) translateZ(0);
        background: linear-gradient(90deg, #1e1b4b 0%, #312e81 100%);
        border-radius: 2px 0 0 2px;
        box-shadow: inset -2px 0 6px rgba(0,0,0,0.35);
    }
    .mybooks-3d-meta {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
        color: rgba(255,255,255,0.92);
    }
    .mybooks-3d-meta-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: -0.02em;
    }
    .mybooks-3d-meta-line {
        font-size: 0.75rem;
        opacity: 0.85;
        line-height: 1.45;
    }
    /* Chapter prev/next — one “page” at a time, book-style reading */
    .mybooks-chapter-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px 16px;
        padding: 12px 20px;
        background: linear-gradient(180deg, rgba(0,0,0,0.28) 0%, rgba(0,0,0,0.18) 100%);
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .mybooks-ch-nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 600;
        border: 1px solid rgba(255,255,255,0.22);
        background: rgba(255,255,255,0.12);
        color: #fff;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s, transform 0.15s;
    }
    .mybooks-ch-nav-btn:hover:not(:disabled) {
        background: rgba(255,255,255,0.22);
        border-color: rgba(255,255,255,0.35);
        transform: translateY(-1px);
    }
    .mybooks-ch-nav-btn:disabled {
        opacity: 0.38;
        cursor: not-allowed;
        transform: none;
    }
    .mybooks-ch-nav-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: rgba(255,255,255,0.92);
        text-align: center;
        flex: 1 1 auto;
        min-width: 140px;
    }
    .mybooks-ch-nav-title {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        line-height: 1.35;
        max-width: 100%;
        word-break: break-word;
    }
    .mybooks-ch-nav-sub {
        font-size: 0.72rem;
        font-weight: 500;
        opacity: 0.88;
    }
    .mybooks-chapter-view { animation: mybooks-chapter-fade 0.35s ease; }
    @@keyframes mybooks-chapter-fade {
        from { opacity: 0.35; }
        to { opacity: 1; }
    }
</style>

<div class="bg-[#f5f7f9] min-h-full flex text-slate-900 flex-1">
    <main class="flex-1 overflow-y-auto overflow-x-hidden p-8 lg:p-12 w-full min-h-0">
        <div class="max-w-[1600px] mx-auto w-full min-h-0 flex flex-col box-border">
<div class="mybooks-container p-3 sm:p-4 min-h-0 flex-1 flex items-stretch sm:items-center justify-center w-full max-w-[100vw] overflow-x-hidden box-border rounded-2xl">
    <div class="mybooks-main flex flex-col lg:flex-row w-full max-w-full overflow-hidden gap-3 lg:gap-4 min-h-0 lg:min-h-[min(920px,calc(100vh-6rem))] lg:max-h-[min(960px,calc(100vh-4rem))]">

        <!-- Left: Recommended + Categories -->
        <div class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8 flex flex-col overflow-y-auto no-scrollbar rounded-2xl lg:rounded-3xl relative order-1">
            @if (paymentJustCompleted)
            {
                <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50/95 text-emerald-950 text-sm px-4 py-3 flex items-start gap-3" role="status">
                    <i class="fas fa-circle-check mt-0.5 text-emerald-600" aria-hidden="true"></i>
                    <span><strong>Payment received.</strong> Your book is marked paid — downloads and publish actions are unlocked.</span>
                </div>
            }
            @if (!stripeReady)
            {
                <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50/90 text-amber-950 text-sm px-4 py-3" role="status">
                    Payments are not active until Stripe keys are configured (<code class="text-xs">Stripe:PublishableKey</code> and <code class="text-xs">Stripe:SecretKey</code> in configuration or environment). Checkout links will remind you until then.
                </div>
            }
            <div class="flex justify-between items-center mb-6" data-guided-tour="mb-actions">
                <h2 class="text-xl tracking-tight font-semibold text-slate-900">Recommended</h2>
                <div class="flex items-center gap-2">
                    <a href="/Dashboard/StartNewBook?create=1" data-editor-reset-new="1" data-book-id="@(ViewBag.ActiveBookId ?? 0)" class="text-violet-800 bg-violet-100 hover:bg-violet-200 px-4 py-2 rounded-xl text-sm font-medium transition-all flex items-center gap-1">
                        <i class="fas fa-plus"></i> New Book
                    </a>
                    @if (books.Any())
                    {
                        <a id="btn-top-publish"
                           href="@(firstBookExportReady ? $"/Dashboard/Publish?bookId={firstBook!.BookId}" : "")"
                           class="px-4 py-2 rounded-xl text-sm font-semibold text-white transition-all flex items-center gap-2 shadow-md hover:shadow-lg hover:-translate-y-0.5 @(firstBookExportReady ? "" : "mybooks-export-disabled")"
                           @(firstBookExportReady ? null : "aria-disabled=\"true\"")
                           title="@(firstBookExportReady ? "Download export pack for this book" : "Finish Writer → Format → Cover → Publish and download once to unlock Export Pack")"
                           style="@(firstBookExportReady ? "background:linear-gradient(135deg,#7c3aed,#4f46e5);" : "")">
                            <i class="fas fa-download"></i> Export Pack
                        </a>
                        <button type="button" id="btn-delete-book-top" class="hidden px-4 py-2 rounded-xl text-sm font-semibold transition-all flex items-center gap-2 border border-red-200 bg-red-50 text-red-800 hover:bg-red-100" title="Delete selected book permanently">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    }
                    else
                    {
                        <button id="btn-top-publish" type="button" disabled class="bg-slate-300 text-slate-500 px-4 py-2 rounded-xl text-sm font-medium cursor-not-allowed flex items-center gap-1">
                            <i class="fas fa-upload"></i> Publish
                        </button>
                    }
                </div>
            </div>

            @if (books != null && books.Any())
            {
                <div class="grid grid-cols-2 md:grid-cols-4 gap-5 mb-10" id="recommendedGrid" data-guided-tour="mb-books">
                    @foreach (var book in books.Take(8))
                    {
                        var title = string.IsNullOrWhiteSpace(book.Title) ? "Untitled" : book.Title;
                        var desc = (book.Description ?? "").ToString();
                        if (desc != null && desc.Length > 120) { desc = desc.Substring(0, 117) + "..."; }
                        var status = string.IsNullOrWhiteSpace(book.Status) ? "Draft" : book.Status;
                        var chCount = book.ChapterCount;
                        var wordCount = book.WordCount;
                        var genre = book.Genre ?? "";
                        <div class="mybooks-card-wrap">
                            <div class="mybooks-menu-wrap">
                                <button type="button" class="mybooks-menu-btn" aria-label="Book actions for @title" aria-haspopup="true" aria-expanded="false"><i class="fas fa-ellipsis-v" aria-hidden="true"></i></button>
                                <div class="mybooks-menu" role="menu">
                                    <a href="/Dashboard/Publish?bookId=@book.BookId" role="menuitem"><i class="fas fa-edit" aria-hidden="true"></i><span>Edit</span></a>
                                    <button type="button" class="mybooks-menu-delete dash-delete-book-btn" data-book-id="@book.BookId" role="menuitem"><i class="fas fa-trash-alt" aria-hidden="true"></i><span>Delete</span></button>
                                </div>
                            </div>
                        <div class="book-card-mybooks book-card cursor-pointer flex flex-col rounded-2xl border border-slate-100 overflow-hidden bg-white shadow-sm"
                             data-book-id="@book.BookId"
                             data-title="@title"
                             data-author="@authorName"
                             data-desc="@(desc ?? "")"
                             data-status="@status"
                             data-chapter-count="@chCount"
                             data-word-count="@wordCount"
                             data-genre="@genre"
                             data-cover="@CoverUrl(book.CoverImagePath ?? "")">
                            <div class="aspect-[2/3] bg-violet-100 relative overflow-hidden border-b border-violet-200">
                                @if (!string.IsNullOrEmpty(book.CoverImagePath))
                                {
                                    <img src="@CoverUrl(book.CoverImagePath)" alt="@title" class="absolute inset-0 w-full h-full object-cover" loading="eager" decoding="async" fetchpriority="high" onerror="this.style.display='none';this.nextElementSibling?.classList.remove('hidden');" />
                                    <div class="hidden absolute inset-0 w-full h-full flex flex-col justify-center items-center text-center p-4">
                                        <span class="font-serif text-lg text-slate-700 leading-tight">@(title.Length > 20 ? title.Substring(0, 18) + "…" : title)</span>
                                        <i class="fas fa-book-open text-violet-600 mt-2 text-2xl"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="absolute inset-0 w-full h-full flex flex-col justify-center items-center text-center p-4">
                                        <span class="font-serif text-lg text-slate-700 leading-tight">@(title.Length > 20 ? title.Substring(0, 18) + "…" : title)</span>
                                        <i class="fas fa-book-open text-violet-600 mt-2 text-2xl"></i>
                                    </div>
                                }
                            </div>
                            <div class="p-3.5 flex flex-col min-w-0">
                                <h3 class="text-base font-medium truncate text-slate-900">@(title.Length > 22 ? title.Substring(0, 20) + "…" : title)</h3>
                                <p class="text-sm text-slate-500 truncate">@authorName</p>
                                @if (chCount > 0)
                                {
                                    <p class="text-[11px] text-violet-700 font-semibold mt-1.5 truncate" title="Chapters with exportable content"><i class="fas fa-book-open" aria-hidden="true"></i> @chCount chapter@(chCount == 1 ? "" : "s") ready</p>
                                }
                            </div>
                        </div>
                        </div>
                    }
                </div>

                <section class="flex-1 flex flex-col">
                    <h2 class="text-xl tracking-tight font-semibold text-slate-900 mb-4">Categories</h2>
                    <div class="flex gap-2 overflow-x-auto no-scrollbar pb-2 mb-4 select-none" id="categoryPills">
                        <button type="button" class="category-pill category-pill-active whitespace-nowrap px-5 py-2 rounded-xl text-sm font-medium transition-colors cursor-pointer bg-violet-700 text-white" data-genre="">All</button>
                        @foreach (var g in books.Select(b => b.Genre ?? "").Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().Take(8))
                        {
                            <button type="button" class="category-pill whitespace-nowrap bg-slate-50 text-slate-600 hover:bg-slate-100 px-5 py-2 rounded-xl text-sm font-medium border border-slate-100 cursor-pointer" data-genre="@g">@g</button>
                        }
                    </div>
                    <div class="flex gap-5 overflow-x-auto no-scrollbar pt-4 pb-4 items-end flex-1 drag-scroll select-none lg:grid lg:overflow-visible lg:grid-cols-[repeat(auto-fill,minmax(220px,1fr))] lg:gap-5" id="categoriesScroll">
                        @foreach (var book in books)
                        {
                            var title = string.IsNullOrWhiteSpace(book.Title) ? "Untitled" : book.Title;
                            var desc = (book.Description ?? "").ToString();
                            if (desc != null && desc.Length > 120) { desc = desc.Substring(0, 117) + "..."; }
                            <div class="book-card shrink-0 w-[140px] cursor-pointer flex flex-col rounded-2xl"
                                 data-book-id="@book.BookId"
                                 data-title="@title"
                                 data-author="@authorName"
                                 data-desc="@(desc ?? "")"
                                 data-status="@(string.IsNullOrWhiteSpace(book.Status) ? "Draft" : book.Status)"
                                 data-chapter-count="@book.ChapterCount"
                                 data-word-count="@book.WordCount"
                                 data-genre="@(book.Genre ?? "")"
                                 data-cover="@CoverUrl(book.CoverImagePath ?? "")">
                                <div class="aspect-[2/3] rounded-2xl mb-2 overflow-hidden shadow-sm bg-violet-100 border border-violet-200 book-card-mybooks relative">
                                    @if (!string.IsNullOrEmpty(book.CoverImagePath))
                                    {
                                        <img src="@CoverUrl(book.CoverImagePath)" alt="@title" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" onerror="this.style.display='none';this.nextElementSibling?.classList.remove('hidden');" />
                                        <div class="hidden absolute inset-0 flex flex-col justify-center items-center text-center p-3">
                                            <span class="font-serif text-sm text-slate-700 leading-tight">@(title.Length > 18 ? title.Substring(0, 16) + "…" : title)</span>
                                            <i class="fas fa-book-open text-violet-600 mt-2 text-xl"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="absolute inset-0 flex flex-col justify-center items-center text-center p-3">
                                            <span class="font-serif text-sm text-slate-800 leading-tight">@(title.Length > 15 ? title.Substring(0, 12) + "…" : title)</span>
                                            <i class="fas fa-book text-violet-600 mt-2"></i>
                                        </div>
                                    }
                                </div>
                                <h3 class="text-sm font-medium truncate text-slate-900 text-center">@(title.Length > 18 ? title.Substring(0, 16) + "…" : title)</h3>
                                <a href="/Dashboard/Publish?bookId=@book.BookId" class="text-[10px] font-semibold text-violet-600 hover:text-violet-800 text-center block mt-0.5">Edit</a>
                                <p class="text-xs text-slate-500 truncate text-center">@authorName</p>
                                @if (book.ChapterCount > 0)
                                {
                                    <p class="text-[10px] text-violet-600 font-semibold text-center mt-1 truncate">@book.ChapterCount AI save(s)</p>
                                }
                            </div>
                        }
                    </div>
                </section>
            }
            else
            {
                <div class="flex-1 flex flex-col items-center justify-center text-center py-12">
                    <i class="fas fa-book-open text-6xl text-violet-200 mb-4"></i>
                    <h3 class="text-xl font-semibold text-slate-700 mb-2">No published books yet</h3>
                    <p class="text-slate-500 mb-6 max-w-md">Finished books appear here after you publish. Continue your drafts from the Dashboard, or start a new project.</p>
                    <a href="@Url.Action("Index", "Dashboard")" class="bg-violet-700 hover:bg-violet-800 text-white px-6 py-3 rounded-xl font-medium inline-flex items-center gap-2 mr-3">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                    <a href="@Url.Action("StartNewBook", "Dashboard", new { create = 1 })" data-editor-reset-new="1" data-book-id="@(ViewBag.ActiveBookId ?? 0)" class="inline-flex items-center gap-2 border border-violet-200 text-violet-800 bg-violet-50 hover:bg-violet-100 px-6 py-3 rounded-xl font-medium">
                        <i class="fas fa-plus"></i> New Book
                    </a>
                </div>
            }
        </div>

        <!-- Right: Detail Panel (full width on small screens, fixed width on lg+) -->
        <aside class="w-full lg:w-[min(420px,38vw)] lg:max-w-[420px] lg:min-w-[300px] aside-panel-mybooks rounded-2xl lg:rounded-[1.5rem] flex flex-col text-white px-5 py-8 sm:px-8 sm:py-10 relative overflow-y-auto overflow-x-hidden shadow-xl shrink-0 order-2 lg:order-2 min-h-[min(520px,70vh)]" aria-label="Selected book details" data-guided-tour="mb-detail">
            <div class="flex-1 flex flex-col items-stretch relative z-10 w-full max-w-md mx-auto lg:max-w-none">
                <p class="mybooks-aside-kicker">Your library</p>
                <div class="mybooks-aside-divider"></div>
                <div id="aside-cover-wrapper" class="w-full flex justify-center mb-6">
                    <div class="w-48 aspect-[2/3] rounded-xl shadow-lg p-5 flex flex-col items-center justify-center text-center border-2 border-violet-900" style="background-color:#4c1d95;">
                        <i class="fas fa-book-open text-5xl mb-2" style="color:#c4b5fd;"></i>
                        <span class="font-serif text-lg" style="color:#e9d5ff;">Select a book</span>
                    </div>
                </div>
                <h2 id="aside-title" class="text-[22px] tracking-tight font-medium mb-1 text-center text-white">Select a book</h2>
                <p id="aside-author" class="text-base mb-2 text-center" style="color:#c4b5fd;">@authorName</p>
                <div class="flex items-center gap-2 mb-4 text-sm" style="color:#c4b5fd;">
                    <span id="aside-meta"></span>
                </div>
                <div id="aside-stats" class="flex w-full gap-2 mb-6 pb-6 border-b border-white/10">
                    <div class="mybooks-stat-pill flex flex-col items-center gap-1 flex-1 min-w-0">
                        <span id="aside-pages" class="text-white font-semibold text-sm tabular-nums">—</span>
                        <span class="text-[10px] uppercase tracking-wider font-medium" style="color:#c4b5fd;">Words</span>
                    </div>
                    <div class="mybooks-stat-pill flex flex-col items-center gap-1 flex-1 min-w-0" title="Kitni dafa AI ne is book ke liye jawab DB mein save kiya (sab chapters mila kar)">
                        <span id="aside-chapters" class="text-white font-semibold text-sm tabular-nums">—</span>
                        <span class="text-[10px] uppercase tracking-wider font-medium leading-tight text-center" style="color:#c4b5fd;">AI saves</span>
                    </div>
                    <div class="mybooks-stat-pill flex flex-col items-center gap-1 flex-1 min-w-0">
                        <span id="aside-status" class="text-white font-semibold text-xs text-center leading-tight truncate max-w-full px-1">—</span>
                        <span class="text-[10px] uppercase tracking-wider font-medium" style="color:#c4b5fd;">Status</span>
                    </div>
                </div>
                    <p class="text-[11px] text-center leading-snug px-1" style="color:#c4b5fd;">Published titles only — open preview or export pack.</p>
                <div class="w-full space-y-2.5 mt-auto">
                    <button type="button" id="btn-view-book" class="hidden w-full py-3.5 px-5 sm:px-6 rounded-xl text-sm font-bold flex justify-center items-center gap-2 cursor-pointer shadow-lg border-2 min-h-[48px]" style="background-color:#ffffff;color:#4c1d95;border-color:#e9d5ff;">
                        <i class="fas fa-book-open" aria-hidden="true"></i> Preview full book
                    </button>
                    <a id="btn-edit-book" href="#" class="hidden w-full py-3 px-6 rounded-xl text-sm font-semibold flex justify-center items-center gap-2 border border-white/30 text-white hover:bg-white/10 transition-colors">
                        <i class="fas fa-edit" aria-hidden="true"></i> Edit
                    </a>
                    <p class="text-[11px] text-center leading-snug px-1" style="color:#c4b5fd;">Opens a print-style chapter preview (same data as your PDF export).</p>
                    <button type="button" id="btn-delete-book" class="w-full py-3 px-6 rounded-xl text-sm font-semibold flex justify-center items-center gap-2 cursor-pointer border border-red-300/40" style="background-color:#991b1b;color:#fff;">
                        <i class="fas fa-trash"></i> Delete book
                    </button>
                </div>
            </div>
        </aside>
    </div>
</div>
        </div>
    </main>
</div>

<!-- Full book preview (Stripe-style modal) -->
<div id="fullBookPreviewModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(15,23,42,0.55);backdrop-filter:blur(6px);align-items:center;justify-content:center;padding:1.5rem;" onclick="if(event.target===this && typeof closeFullBookModal==='function')closeFullBookModal();">
    <div style="background:#fff;border-radius:1.25rem;width:100%;max-width:720px;max-height:88vh;display:flex;flex-direction:column;box-shadow:0 25px 60px rgba(0,0,0,0.25);overflow:hidden;position:relative;" onclick="event.stopPropagation();">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;border-bottom:1px solid #f1f5f9;flex-shrink:0;">
            <div>
                <h2 id="modalBookTitle" style="font-size:1.1rem;font-weight:600;color:#0f172a;margin:0;"></h2>
                <p id="modalChapterCount" style="font-size:0.8rem;color:#64748b;margin:0.2rem 0 0;"></p>
            </div>
            <button type="button" onclick="closeFullBookModal()" style="width:2rem;height:2rem;border-radius:50%;border:none;background:#f1f5f9;cursor:pointer;font-size:1.1rem;display:flex;align-items:center;justify-content:center;color:#64748b;" aria-label="Close">✕</button>
        </div>
        <div id="modalChapterTabs" style="display:flex;gap:0.5rem;padding:0.75rem 1.5rem;overflow-x:auto;border-bottom:1px solid #f1f5f9;flex-shrink:0;scrollbar-width:thin;"></div>
        <div id="modalBookContent" style="flex:1;overflow-y:auto;padding:2rem 2.5rem;font-family:Georgia,'Times New Roman',serif;font-size:1.0625rem;line-height:1.85;color:#1e293b;text-align:justify;scrollbar-width:thin;"></div>
        <div style="padding:1rem 1.5rem;border-top:1px solid #f1f5f9;display:flex;justify-content:flex-end;flex-shrink:0;background:#fafafa;">
            <button type="button" onclick="closeFullBookModal()" style="padding:0.5rem 1.25rem;background:#7c3aed;color:#fff;border:none;border-radius:0.5rem;font-weight:500;cursor:pointer;font-size:0.875rem;">Close</button>
        </div>
    </div>
</div>

<script>
(function() {
    const books = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(books));
    const displayAuthorName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(authorName));
    function escapeHtmlText(s) {
        if (s === undefined || s === null) return '';
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function resolveCoverUrl(path) {
        if (path == null || path === '') return '';
        var p = String(path).trim();
        if (!p) return '';
        if (/^https?:\/\//i.test(p) || p.indexOf('data:') === 0) return p;
        return p.indexOf('/') === 0 ? p : '/' + p;
    }
    function setAsideCover(coverWrap, src, titleText) {
        if (!coverWrap) return;
        coverWrap.innerHTML = '';
        if (src) {
            var img = document.createElement('img');
            img.src = src;
            img.alt = titleText || '';
            img.className = 'w-full max-w-[192px] aspect-[2/3] object-cover rounded-xl shadow-lg border-2 border-violet-900 mx-auto';
            img.loading = 'eager';
            img.decoding = 'async';
            img.onerror = function() {
                this.onerror = null;
                setAsideCover(coverWrap, '', titleText);
            };
            coverWrap.appendChild(img);
        } else {
            var safe = escapeHtmlText((titleText || '').substring(0, 24));
            coverWrap.innerHTML = '<div class="w-48 max-w-full aspect-[2/3] rounded-xl shadow-lg p-5 flex flex-col items-center justify-center text-center border-2 border-violet-900 mx-auto" style="background-color:#4c1d95;"><i class="fas fa-book-open text-5xl mb-2" style="color:#c4b5fd;"></i><span class="font-serif text-sm" style="color:#e9d5ff;">' + (safe || '—') + '</span></div>';
        }
    }
    var MYBOOKS_SEL_KEY = 'ebook_mybooks_selected_book';
    var serverSelectedBookId = @(ViewBag.SelectedBookId != null ? ViewBag.SelectedBookId.ToString() : "0");

    function setSelectedBookCard(bookId) {
        document.querySelectorAll('#recommendedGrid .book-card, #categoriesScroll .book-card').forEach(function(c) {
            var id = parseInt(c.getAttribute('data-book-id'), 10);
            if (id === bookId) c.classList.add('book-card-selected');
            else c.classList.remove('book-card-selected');
        });
    }
    function getBookFromCard(card) {
        if (!card) return null;
        return getBook({
            BookId: card.getAttribute('data-book-id'),
            Title: card.getAttribute('data-title'),
            Description: card.getAttribute('data-desc'),
            Status: card.getAttribute('data-status'),
            ChapterCount: card.getAttribute('data-chapter-count'),
            WordCount: card.getAttribute('data-word-count'),
            Genre: card.getAttribute('data-genre'),
            CoverImagePath: card.getAttribute('data-cover')
        });
    }
    function resolveBookById(bookId) {
        if (!bookId) return null;
        var found = books && books.find(function(b) { return bookIdFrom(b) === bookId; });
        if (found) return getBook(found);
        var card = document.querySelector('#recommendedGrid .book-card[data-book-id="' + bookId + '"], #categoriesScroll .book-card[data-book-id="' + bookId + '"]');
        return getBookFromCard(card);
    }
    function scrollSelectedCardIntoView(bookId) {
        var card = document.querySelector('#recommendedGrid .book-card-selected[data-book-id="' + bookId + '"], #categoriesScroll .book-card-selected[data-book-id="' + bookId + '"]');
        if (card && card.scrollIntoView) {
            try { card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' }); } catch (e) { card.scrollIntoView(false); }
        }
    }
    function updateUrlBookId(bookId) {
        try {
            var url = new URL(window.location.href);
            url.searchParams.set('bookId', String(bookId));
            window.history.replaceState({}, '', url.pathname + url.search);
        } catch (e) {}
    }
    function persistActiveBookOnServer(bookId) {
        var token = getMyBooksAntiForgeryToken();
        fetch('/Dashboard/SetActiveBook?bookId=' + encodeURIComponent(bookId), {
            method: 'POST',
            credentials: 'same-origin',
            headers: token ? { 'RequestVerificationToken': token } : {}
        }).catch(function() {});
    }
    function selectMyBook(bookId, opts) {
        opts = opts || {};
        bookId = parseInt(bookId, 10);
        if (!bookId) return;
        var book = resolveBookById(bookId);
        if (!book) return;
        fillAside(book);
        try { sessionStorage.setItem(MYBOOKS_SEL_KEY, String(bookId)); } catch (e) {}
        var bookIdEl = document.getElementById('BookId');
        if (bookIdEl) bookIdEl.value = String(bookId);
        if (!opts.skipServer) persistActiveBookOnServer(bookId);
        if (!opts.skipScroll) scrollSelectedCardIntoView(bookId);
        if (!opts.skipUrl) updateUrlBookId(bookId);
    }
    function bookIdFrom(b) {
        if (!b) return 0;
        var id = b.BookId != null ? b.BookId : b.bookId;
        return id != null ? id : 0;
    }
    function normalizeGenre(s) {
        return (s == null ? '' : String(s)).trim().toLowerCase();
    }
    function isBookPublished(status) {
        var s = (status == null ? '' : String(status)).trim().toLowerCase();
        return s === 'published' || s === 'finalized' || s === 'final' || s === 'paid';
    }
    function setExportPackButtonState(btn, book, options) {
        if (!btn || !book) return;
        options = options || {};
        var published = isBookPublished(book.status);
        if (published) {
            btn.href = '/Dashboard/Publish?bookId=' + book.bookId;
            btn.removeAttribute('aria-disabled');
            btn.classList.remove('mybooks-export-disabled');
            btn.title = options.label === 'aside'
                ? 'Open professional export page'
                : 'Download export pack for this book';
            if (options.isTop) {
                btn.style.background = 'linear-gradient(135deg,#7c3aed,#4f46e5)';
            }
        } else {
            btn.removeAttribute('href');
            btn.setAttribute('aria-disabled', 'true');
            btn.classList.add('mybooks-export-disabled');
            btn.title = 'Finish Writer → Format → Cover → Publish and download once to unlock Export Pack';
            if (options.isTop) {
                btn.style.background = '';
            }
        }
    }
    function getBook(book) {
        return {
            bookId: bookIdFrom(book),
            title: book.Title || book.title || 'Untitled',
            author: displayAuthorName,
            desc: book.Description || book.description || '',
            status: book.Status || book.status || 'Draft',
            chapterCount: book.ChapterCount || book.chapterCount || 0,
            wordCount: book.WordCount || book.wordCount || 0,
            genre: book.Genre || book.genre || '',
            cover: resolveCoverUrl(book.CoverImagePath || book.coverImagePath || book.cover || '')
        };
    }
    let selectedBookId = null;

    // Drag to scroll
    document.querySelectorAll('.drag-scroll').forEach(slider => {
        let isDown = false, startX, scrollLeft;
        slider.addEventListener('mousedown', e => { isDown = true; slider.classList.add('is-dragging'); startX = e.pageX - slider.offsetLeft; scrollLeft = slider.scrollLeft; });
        slider.addEventListener('mouseleave', () => { isDown = false; slider.classList.remove('is-dragging'); });
        slider.addEventListener('mouseup', () => { isDown = false; setTimeout(() => slider.classList.remove('is-dragging'), 10); });
        slider.addEventListener('mousemove', e => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - slider.offsetLeft;
            slider.scrollLeft = scrollLeft - (x - startX) * 1.2;
        });
    });

    // Category pills (pills are NOT on drag-scroll so clicks always register)
    document.querySelectorAll('#categoryPills .category-pill').forEach(function(pill) {
        pill.addEventListener('click', function(ev) {
            ev.stopPropagation();
            document.querySelectorAll('#categoryPills .category-pill').forEach(function(p) {
                p.classList.remove('category-pill-active', 'bg-violet-700', 'text-white');
                p.classList.add('bg-slate-50', 'text-slate-600', 'border', 'border-slate-100');
            });
            this.classList.remove('bg-slate-50', 'text-slate-600', 'border', 'border-slate-100');
            this.classList.add('category-pill-active', 'bg-violet-700', 'text-white');
            var selected = normalizeGenre(this.getAttribute('data-genre'));
            document.querySelectorAll('#categoriesScroll .book-card').forEach(function(card) {
                var cardG = normalizeGenre(card.getAttribute('data-genre'));
                var show = !selected || cardG === selected;
                card.style.display = show ? 'flex' : 'none';
            });
            if (selectedBookId) setSelectedBookCard(selectedBookId);
        });
    });

    function fillAside(book) {
        if (!book) return;
        selectedBookId = book.bookId;
        document.getElementById('aside-title').textContent = book.title || 'Untitled';
        document.getElementById('aside-author').textContent = book.author || '';
        document.getElementById('aside-meta').textContent = (book.genre || '') ? 'Genre: ' + book.genre : '';
        document.getElementById('aside-pages').textContent = book.wordCount != null ? book.wordCount.toLocaleString() : '—';
        document.getElementById('aside-chapters').textContent = book.chapterCount != null ? book.chapterCount : '—';
        document.getElementById('aside-status').textContent = book.status || 'Published';
        document.getElementById('btn-view-book').classList.remove('hidden');
        var editBtn = document.getElementById('btn-edit-book');
        if (editBtn) {
            editBtn.href = '/Dashboard/Publish?bookId=' + book.bookId;
            editBtn.classList.remove('hidden');
        }
        var deleteTop = document.getElementById('btn-delete-book-top');
        if (deleteTop) deleteTop.classList.remove('hidden');
        var hasChapters = (book.chapterCount || 0) > 0;
        var publishBtn = document.getElementById('btn-top-publish');
        if (publishBtn) {
            setExportPackButtonState(publishBtn, book, { isTop: true });
        }
        var coverWrap = document.getElementById('aside-cover-wrapper');
        setAsideCover(coverWrap, book.cover, book.title);
        setSelectedBookCard(book.bookId);
    }

    document.addEventListener('click', function(e) {
        var card = e.target.closest('#recommendedGrid .book-card[data-book-id], #categoriesScroll .book-card[data-book-id]');
        if (!card) return;
        var row = card.closest('.drag-scroll');
        if (row && row.classList.contains('is-dragging')) return;
        var bookId = parseInt(card.getAttribute('data-book-id'), 10);
        if (!bookId) return;
        selectMyBook(bookId);
    });
    document.addEventListener('dblclick', function(e) {
        var card = e.target.closest('#recommendedGrid .book-card[data-book-id], #categoriesScroll .book-card[data-book-id]');
        if (!card) return;
        var bookId = parseInt(card.getAttribute('data-book-id'), 10);
        if (bookId > 0) {
            selectMyBook(bookId);
            var previewBtn = document.getElementById('btn-view-book');
            if (previewBtn) previewBtn.click();
        }
    });

    function normalizeChaptersForModal(chData) {
        var raw = (chData && (chData.chapters || chData.Chapters)) ? (chData.chapters || chData.Chapters) : [];
        return raw.map(function (c) {
            var html = c.chapterHtml || c.ChapterHtml || c.previewHtml || c.PreviewHtml || '';
            var title = (c.chapterTitle || c.ChapterTitle || '').trim();
            return { chapterTitle: title, content: html };
        });
    }

    window.showChapterInModal = function (ch, num, container) {
        var raw = (ch.content || ch.Content || '').trim();
        var title = ch.chapterTitle || ch.title || ('Chapter ' + num);
        container.scrollTop = 0;
        var titleEsc = escapeHtmlText(title);
        if (raw.indexOf('<') >= 0 && raw.indexOf('>') > 0) {
            container.innerHTML = '<h3 style="font-family:Georgia,serif;font-size:1.35rem;font-weight:600;color:#0f172a;margin:0 0 1.5rem;padding-bottom:1rem;border-bottom:1px solid #f1f5f9;">' + titleEsc + '</h3><div class="modal-chapter-html">' + raw + '</div>';
            return;
        }
        var body = raw;
        container.innerHTML = '<h3 style="font-family:Georgia,serif;font-size:1.35rem;font-weight:600;color:#0f172a;margin:0 0 1.5rem;padding-bottom:1rem;border-bottom:1px solid #f1f5f9;">' + titleEsc + '</h3>' +
            (body ? body.split('\n').filter(function (p) { return p.trim(); }).map(function (p) {
                return '<p style="margin:0 0 1rem;text-indent:1.5rem;">' + escapeHtmlText(p) + '</p>';
            }).join('') : '<p style="color:#94a3b8;">No content for this chapter.</p>');
    };

    window.closeFullBookModal = function () {
        var modal = document.getElementById('fullBookPreviewModal');
        if (modal) modal.style.display = 'none';
        document.body.style.overflow = '';
    };

    window.openFullBookModal = function (bookTitle, chapters) {
        var modal = document.getElementById('fullBookPreviewModal');
        var tEl = document.getElementById('modalBookTitle');
        var cEl = document.getElementById('modalChapterCount');
        var tabs = document.getElementById('modalChapterTabs');
        var content = document.getElementById('modalBookContent');
        if (!modal || !tEl || !cEl || !tabs || !content) return;
        tEl.textContent = bookTitle || 'Book Preview';
        cEl.textContent = (chapters ? chapters.length : 0) + ' chapters';
        tabs.innerHTML = '';
        content.innerHTML = '';
        if (chapters && chapters.length) {
            chapters.forEach(function (ch, i) {
                var tab = document.createElement('button');
                tab.type = 'button';
                tab.textContent = 'Ch. ' + (i + 1);
                tab.title = ch.chapterTitle || '';
                tab.style.cssText = 'padding:0.35rem 0.85rem;border-radius:9999px;border:1px solid #e2e8f0;background:' + (i === 0 ? '#7c3aed' : '#fff') + ';color:' + (i === 0 ? '#fff' : '#475569') + ';font-size:0.8rem;cursor:pointer;white-space:nowrap;flex-shrink:0;font-weight:500;';
                tab.addEventListener('click', function () {
                    Array.prototype.forEach.call(tabs.querySelectorAll('button'), function (b) {
                        b.style.background = '#fff';
                        b.style.color = '#475569';
                    });
                    tab.style.background = '#7c3aed';
                    tab.style.color = '#fff';
                    window.showChapterInModal(ch, i + 1, content);
                });
                tabs.appendChild(tab);
                if (i === 0) window.showChapterInModal(ch, 1, content);
            });
        } else {
            content.innerHTML = '<p style="color:#94a3b8;text-align:center;padding:3rem;">No content yet.</p>';
        }
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    };

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') window.closeFullBookModal();
    });

    document.getElementById('btn-view-book').addEventListener('click', function () {
        if (!selectedBookId) return;
        var modal = document.getElementById('fullBookPreviewModal');
        var mc = document.getElementById('modalBookContent');
        var mt = document.getElementById('modalBookTitle');
        var mcc = document.getElementById('modalChapterCount');
        var mtabs = document.getElementById('modalChapterTabs');
        if (mc) mc.innerHTML = '<p style="color:#64748b;text-align:center;padding:2rem;">Loading…</p>';
        if (mt) mt.textContent = 'Loading…';
        if (mcc) mcc.textContent = '';
        if (mtabs) mtabs.innerHTML = '';
        if (modal) {
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }
        fetch('/Dashboard/BookPdfPreviewData?bookId=' + encodeURIComponent(selectedBookId) + '&full=true')
            .then(function (r) { return r.json(); })
            .then(function (chData) {
                if (!chData || !chData.success) {
                    window.closeFullBookModal();
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'error', title: 'Preview unavailable', text: (chData && chData.message) ? chData.message : 'Could not load book.', confirmButtonColor: '#7c3aed' });
                    } else {
                        alert((chData && chData.message) ? chData.message : 'Could not load book.');
                    }
                    return;
                }
                var bt = chData.bookTitle || chData.BookTitle || 'Book Preview';
                window.openFullBookModal(bt, normalizeChaptersForModal(chData));
            })
            .catch(function () {
                window.closeFullBookModal();
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Could not load preview.', confirmButtonColor: '#7c3aed' });
                } else {
                    alert('Could not load preview.');
                }
            });
    });

    function triggerDeleteBook() {
        if (!selectedBookId) return;
        if (typeof Swal === 'undefined') {
            if (confirm('Delete this book permanently?')) doDelete(selectedBookId);
            return;
        }
        Swal.fire({ title: 'Delete Book?', text: 'This cannot be undone.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', cancelButtonColor: '#6b7280', confirmButtonText: 'Yes, Delete' })
            .then(function(r) { if (r.isConfirmed) doDelete(selectedBookId); });
    }

    document.getElementById('btn-delete-book').addEventListener('click', triggerDeleteBook);
    document.getElementById('btn-delete-book-top')?.addEventListener('click', triggerDeleteBook);

    function doDelete(id) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        fetch('/Books/Delete/' + id, { method: 'POST', headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' }, body: '__RequestVerificationToken=' + encodeURIComponent(token) })
            .then(function(res) {
                if (res.ok || res.redirected) { if (typeof Swal !== 'undefined') Swal.fire({ title: 'Deleted', icon: 'success', timer: 1500, showConfirmButton: false }).then(() => location.reload()); else location.reload(); }
                else return res.text().then(t => { throw new Error(t || 'Delete failed'); });
            })
            .catch(function(e) { if (typeof Swal !== 'undefined') Swal.fire({ title: 'Error', text: e.message, icon: 'error' }); else alert(e.message); });
    }

    function getMyBooksAntiForgeryToken() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        return t ? t.value : '';
    }

    function safeBookSlugFromTitle(title) {
        return String(title || 'book')
            .toLowerCase()
            .replace(/[^\w\s-]+/g, '')
            .replace(/\s+/g, '-')
            .replace(/^-+|-+$/g, '') || 'book';
    }

    function downloadBlobAsFile(blob, filename) {
        var safeName = String(filename || 'book.epub').replace(/[\\/:*?"<>|]+/g, '').replace(/\s+/g, '-');
        var typed = blob.type ? blob : new Blob([blob], { type: safeName.toLowerCase().endsWith('.pdf') ? 'application/pdf' : 'application/octet-stream' });
        var url = URL.createObjectURL(typed);
        var a = document.createElement('a');
        a.href = url;
        a.download = safeName;
        a.style.display = 'none';
        document.body.appendChild(a);
        a.click();
        setTimeout(function () {
            a.remove();
            URL.revokeObjectURL(url);
        }, 300000);
    }

    function runMyBooksExport(bookId, title, genre, format, triggerBtn) {
        if (!bookId || bookId <= 0) return;
        var fmt = (format || 'epub').toLowerCase();
        var url = fmt === 'docx' ? '/Books/ExportDocx' : '/Books/ExportEpub';
        var token = getMyBooksAntiForgeryToken();
        if (triggerBtn) triggerBtn.disabled = true;
        var toast = function (msg, icon) {
            if (typeof Swal !== 'undefined') Swal.fire({ toast: true, position: 'top-end', icon: icon || 'info', title: msg, showConfirmButton: false, timer: 2200 });
        };
        toast(fmt === 'docx' ? 'Building Word…' : 'Building EPUB…', 'info');
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            credentials: 'same-origin',
            body: JSON.stringify({
                bookId: bookId,
                displayTitle: title || '',
                displayAuthor: '',
                displayGenre: genre || '',
                exportFormat: fmt
            })
        })
            .then(function (res) {
                if (!res.ok) {
                    return res.json().catch(function () { return {}; }).then(function (j) {
                        throw new Error((j && j.message) ? j.message : 'Export failed.');
                    });
                }
                var cd = res.headers.get('Content-Disposition') || '';
                var m = /filename\*=UTF-8''([^;]+)|filename="?([^";]+)"?/i.exec(cd);
                var serverName = '';
                if (m) {
                    try { serverName = decodeURIComponent((m[1] || m[2] || '').trim()); }
                    catch (e) { serverName = (m[1] || m[2] || '').trim(); }
                }
                return res.blob().then(function (blob) {
                    if (!blob || blob.size < 80) {
                        throw new Error('Export file is empty. Add chapter text in AI Writer first.');
                    }
                    var ext = fmt === 'docx' ? 'docx' : 'epub';
                    var mime = fmt === 'docx'
                        ? 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                        : 'application/epub+zip';
                    var typed = blob.type ? blob : new Blob([blob], { type: mime });
                    var fname = serverName || (safeBookSlugFromTitle(title) + '-' + bookId + '.' + ext);
                    downloadBlobAsFile(typed, fname);
                    toast(fmt === 'epub' ? 'EPUB saved — open in Books / Calibre' : 'Word file saved', 'success');
                });
            })
            .catch(function (err) {
                if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Export failed', text: err && err.message ? err.message : 'Try again.', confirmButtonColor: '#7c3aed' });
                else alert(err && err.message ? err.message : 'Export failed.');
            })
            .finally(function () {
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

    document.addEventListener('click', function (e) {
        var menuBtn = e.target.closest('.mybooks-menu-btn');
        if (menuBtn) {
            e.preventDefault();
            e.stopPropagation();
            var wrap = menuBtn.closest('.mybooks-menu-wrap');
            var menu = wrap && wrap.querySelector('.mybooks-menu');
            document.querySelectorAll('.mybooks-menu.is-open').forEach(function (m) {
                if (m !== menu) m.classList.remove('is-open');
            });
            if (menu) menu.classList.toggle('is-open');
            menuBtn.setAttribute('aria-expanded', menu && menu.classList.contains('is-open') ? 'true' : 'false');
            return;
        }
        if (!e.target.closest('.mybooks-menu-wrap')) {
            document.querySelectorAll('.mybooks-menu.is-open').forEach(function (m) { m.classList.remove('is-open'); });
            document.querySelectorAll('.mybooks-menu-btn[aria-expanded="true"]').forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
        }
    });

    (function initMyBooksSelection() {
        var params = new URLSearchParams(window.location.search);
        var bid = parseInt(params.get('bookId') || '0', 10);
        var autoPreview = params.get('preview') === '1';
        if (!bid) {
            try { bid = parseInt(sessionStorage.getItem(MYBOOKS_SEL_KEY) || '0', 10); } catch (e) {}
        }
        if (!bid) bid = parseInt(serverSelectedBookId || '0', 10);
        if (!bid && books && books.length) bid = bookIdFrom(books[0]);
        if (bid) {
            selectMyBook(bid);
            if (autoPreview) {
                var viewBtn = document.getElementById('btn-view-book');
                if (viewBtn) viewBtn.click();
            }
        }
    })();
})();
</script>
