@model List<EBookDashboard.Models.PricingRule>
@{
    ViewData["Title"] = "Pricing";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var rules = Model ?? new List<EBookDashboard.Models.PricingRule>();
    string Amt(decimal n) => n.ToString("0.00");
}
<style>
    .pricing-page { max-width: 1120px; margin: 0 auto; padding: 24px 16px 64px; }
    .pricing-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
    @@media (min-width: 960px) { .pricing-grid { grid-template-columns: 1.1fr 0.9fr; align-items: start; } }
    .price-card, .calc-card { background: #fff; border: 1px solid #E5E5E5; border-radius: 20px; padding: 24px; }
    .price-row { display: flex; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f3f4f6; }
    .price-amt { font-family: ui-monospace, Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; font-weight: 700; }
    .chip-free { background: #ecfdf5; color: #047857; border-radius: 999px; padding: 2px 8px; font-size: 11px; font-weight: 700; }
    .calc-total { font-family: ui-monospace, Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; font-size: 32px; font-weight: 800; color: #7c3aed; }
    .calc-line { display: flex; justify-content: space-between; font-family: ui-monospace, Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; font-size: 13px; padding: 6px 0; }
</style>
<div class="pricing-page">
    <h1 style="font-size:28px;font-weight:800;margin:0 0 8px;">Simple, output-based pricing</h1>
    <p style="color:#6B6B6B;margin:0 0 24px;">Write, format, and generate an AI cover free. You pay once, at export, for the pages and extras you actually use.</p>
    <div class="pricing-grid">
        <div class="price-card">
            <h2 style="margin:0 0 16px;font-size:18px;">Rate card</h2>
            @foreach (var r in rules)
            {
                <div class="price-row" data-key="@r.Key" data-amount="@Amt(r.UnitAmount)" data-free="@r.FreeAllowance">
                    <div>
                        <div style="font-weight:700;">@r.DisplayName</div>
                        <div style="font-size:12px;color:#64748b;">@r.Key @if (r.FreeAllowance > 0) { <span class="chip-free">@r.FreeAllowance free pages</span> }</div>
                    </div>
                    <div class="price-amt">$@Amt(r.UnitAmount)</div>
                </div>
            }
            <div class="price-row">
                <div><div style="font-weight:700;">eBook (EPUB/PDF)</div><div style="font-size:12px;color:#64748b;">Always included</div></div>
                <div class="price-amt"><span class="chip-free">Free</span></div>
            </div>
        </div>
        <div class="calc-card" style="position:sticky;top:24px;">
            <h2 style="margin:0 0 12px;font-size:18px;">Live cost calculator</h2>
            <label style="font-size:13px;color:#64748b;">Page count: <strong id="calcPagesLabel">200</strong></label>
            <input id="calcPages" type="range" min="1" max="400" value="200" style="width:100%;margin:8px 0 16px;" />
            <label style="display:block;margin:6px 0;"><input type="checkbox" id="calcCover" checked> Custom image cover</label>
            <label style="display:block;margin:6px 0;"><input type="checkbox" id="calcFmt" checked> Premium formatting</label>
            <label style="display:block;margin:6px 0;"><input type="checkbox" id="calcPb" checked> Paperback package</label>
            <label style="display:block;margin:6px 0;"><input type="checkbox" id="calcHc"> Hardcover package</label>
            <div id="calcLines" style="margin-top:16px;border-top:1px solid #f3f4f6;padding-top:8px;"></div>
            <div class="calc-total" id="calcTotal">$0.00</div>
            <p style="font-size:13px;color:#6B6B6B;margin-top:12px;">A full 200-page book is about $123 here versus $300 to $1,000 elsewhere.</p>
        </div>
    </div>
</div>
<script>
(function () {
    var rows = {};
    document.querySelectorAll('.price-row[data-key]').forEach(function (el) {
        rows[el.getAttribute('data-key')] = { amount: parseFloat(el.getAttribute('data-amount')), free: parseInt(el.getAttribute('data-free') || '0', 10) };
    });
    function money(n) { return '$' + n.toFixed(2); }
    function recalc() {
        var pages = parseInt(document.getElementById('calcPages').value, 10);
        document.getElementById('calcPagesLabel').textContent = String(pages);
        var w = rows['writing.per_page'] || { amount: 0, free: 0 };
        var billable = Math.max(0, pages - w.free);
        var lines = [{ k: 'Writing', t: billable * w.amount }];
        if (document.getElementById('calcCover').checked) lines.push({ k: 'Custom cover', t: (rows['cover.custom_image'] || { amount: 0 }).amount });
        if (document.getElementById('calcFmt').checked) lines.push({ k: 'Premium formatting', t: (rows['formatting.premium'] || { amount: 0 }).amount });
        if (document.getElementById('calcPb').checked) lines.push({ k: 'Paperback', t: (rows['export.paperback'] || { amount: 0 }).amount });
        if (document.getElementById('calcHc').checked) lines.push({ k: 'Hardcover', t: (rows['export.hardcover'] || { amount: 0 }).amount });
        lines.push({ k: 'eBook', t: 0 });
        var total = lines.reduce(function (s, l) { return s + l.t; }, 0);
        document.getElementById('calcLines').innerHTML = lines.map(function (l) {
            return '<div class="calc-line"><span>' + l.k + '</span><span>' + money(l.t) + '</span></div>';
        }).join('');
        document.getElementById('calcTotal').textContent = money(total);
    }
    ['calcPages','calcCover','calcFmt','calcPb','calcHc'].forEach(function (id) {
        document.getElementById(id).addEventListener('input', recalc);
        document.getElementById(id).addEventListener('change', recalc);
    });
    recalc();
})();
</script>
