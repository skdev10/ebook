@model EBookDashboard.Models.ViewModels.OrdersPageViewModel
@{
    ViewData["Title"] = "Orders";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var page = Model ?? new EBookDashboard.Models.ViewModels.OrdersPageViewModel();
    var open = page.OpenBills ?? new List<EBookDashboard.Models.ViewModels.OpenBookBillRow>();
    var receipts = page.Receipts ?? new List<Order>();
    var paidReceipts = receipts.Where(o => o.Status == OrderStatus.Paid).ToList();
    var openDue = open.Sum(r => r.AmountDue);
    var hasAnything = open.Count > 0 || receipts.Count > 0;
}
<div class="orders-page orders-studio">
    <header class="orders-studio__hero">
        <p class="pricing-studio__kicker">Billing</p>
        <h1>Orders and receipts</h1>
        <p>Each book you write has a live bill here. Paid exports show as receipts. You are charged only when you export above the free tier.</p>
    </header>

    @if (!hasAnything)
    {
        <div class="orders-empty">
            <h2>No books yet</h2>
            <p>Start a manuscript. Your live bill and later receipts will show up on this page.</p>
            <a href="/Books/AIGenerateBook">Open AI Writer</a>
            <span> · </span>
            <a href="/pricing">See pricing</a>
        </div>
    }
    else
    {
        <div class="orders-summary" aria-label="Billing overview">
            <div><strong>@open.Count</strong><span>@(open.Count == 1 ? "open book" : "open books")</span></div>
            <div><strong class="orders-money">$@openDue.ToString("0.00")</strong><span>estimated due</span></div>
            <div><strong>@paidReceipts.Count</strong><span>@(paidReceipts.Count == 1 ? "paid receipt" : "paid receipts")</span></div>
        </div>

        @if (open.Count > 0)
        {
            <section class="orders-section">
                <h2>Open books</h2>
                <p class="orders-section__hint">Estimate from your manuscript. Pay at checkout when you export.</p>
                <div class="orders-open-list">
                    @foreach (var row in open)
                    {
                        var freeUsed = row.FreeAllowance > 0 ? Math.Min(row.PageCount, row.FreeAllowance) : 0;
                        <article class="orders-open-card">
                            <div class="orders-open-card__main">
                                <h3>@row.Title</h3>
                                <p>
                                    @row.PageCount @(row.PageCount == 1 ? "page" : "pages")
                                    @if (row.FreeAllowance > 0)
                                    {
                                        <text> · @freeUsed of @row.FreeAllowance free</text>
                                    }
                                    @if (row.PaidPages > 0)
                                    {
                                        <text> · @row.PaidPages extra</text>
                                    }
                                </p>
                            </div>
                            <div class="orders-open-card__due">
                                <strong class="orders-money">$@row.AmountDue.ToString("0.00")</strong>
                                <span>@(row.AmountDue > 0 ? "due at export" : "nothing due")</span>
                            </div>
                            <div class="orders-open-card__actions">
                                <a href="/Books/AIGenerateBook?bookId=@row.BookId">Continue writing</a>
                                <a class="orders-open-card__bill" href="/checkout/@row.BookId">View bill</a>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        <section class="orders-section">
            <h2>Receipts</h2>
            @if (receipts.Count == 0)
            {
                <p class="orders-section__hint">No paid exports yet. When you check out, the receipt lands here.</p>
            }
            else
            {
                foreach (var o in receipts)
                {
                    <details class="orders-card">
                        <summary>
                            <span>
                                <strong>#@o.Id · @o.Status</strong>
                                <div class="orders-card__meta">
                                    @o.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
                                    @if (o.BookId.HasValue)
                                    {
                                        <text>· book @o.BookId</text>
                                    }
                                </div>
                            </span>
                            <span class="orders-money">$@o.Total.ToString("0.00") @o.Currency</span>
                        </summary>
                        <div class="orders-body">
                            @if (o.Items == null || !o.Items.Any())
                            {
                                <div class="pricing-empty">No line items on this receipt.</div>
                            }
                            else
                            {
                                foreach (var item in o.Items)
                                {
                                    <div class="orders-line">
                                        <span>@item.Description</span>
                                        <span class="orders-money">$@item.LineTotal.ToString("0.00")</span>
                                    </div>
                                }
                            }
                        </div>
                    </details>
                }
            }
        </section>
    }
</div>
